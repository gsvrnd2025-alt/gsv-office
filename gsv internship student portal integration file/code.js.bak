              : `<p>Dear ${studentData.FullName},</p><p>Please find attached your official Consolidated Internship Attendance Record (Form-4).</p>`;

            sendEmail(studentData.GmailID, attSubject, '', grandAttHtml, [file.getAs(MimeType.PDF)]);

          } catch (e) {

            Logger.log("Error emailing Form-4 attendance: " + e);

          }

        }

        return res;

      }

      return res || { status: 'error', message: 'Failed to generate attendance document.' };

    }



