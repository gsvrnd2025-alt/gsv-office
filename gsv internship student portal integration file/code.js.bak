 */

/**

 * Precision pagination cleaner for Application Form package.

 * Guarantees Form-1 (2 pages max), Form-2 (exact 1 page), and Form-3 start cleanly without orphaned titles or blank pages.

 */

/**

 * Precision pagination cleaner for Application Form package.

 * Eliminates blank pages, merges orphaned sections, and guarantees:

 * - Form-1 (Student Application): exactly 2 pages

 * - Form-2 (Self Declaration Letter + Signatures): strictly 1 page

 * - Form-3 (Attendance Sheet + Summary): exactly 2 pages

 * Total Document: exactly 5 pages.

 */

/**

 * Standardizes Date Formatting to DD/MM/YYYY across all generated documents and dashboards.

 */

function formatDateDMY(dateInput) {

  if (!dateInput) return '';

  try {

    let date;

    if (dateInput instanceof Date) {

      date = dateInput;

    } else {

      let s = String(dateInput).trim();

      if (s.match(/^\d{4}-\d{2}-\d{2}$/)) {

        let parts = s.split('-');

        date = new Date(parts[0], parts[1] - 1, parts[2]);

      } else if (s.match(/^\d{1,2}[\/\-]\d{1,2}[\/\-]\d{4}$/)) {

        let parts = s.split(/[\/\-]/);

        date = new Date(parts[2], parts[1] - 1, parts[0]);

      } else {

        date = new Date(s);

      }

    }

    if (isNaN(date.getTime())) return String(dateInput);

    const year = date.getFullYear();

    const month = ('0' + (date.getMonth() + 1)).slice(-2);

    const day = ('0' + date.getDate()).slice(-2);

    return `${day}/${month}/${year}`;

  } catch (e) { return String(dateInput); }

}



/**

 * Formats Form-1 header table left cell with exact vertical stacking:

 * 1. Registration ID: GSV/2026/... (Bold, 10pt)

 * 2. 1D Code 128 Barcode (Width: 175pt, Height: 28pt, Crisp bars encoding RegID) + Verification QR Code (48pt x 48pt)

 * 3. Application Status: Approved (Italic, Bold, 9.5pt)

 * 4. Application Date: DD/MM/YYYY (Italic, Bold, 9.5pt)

 */

/**

 * Formats and guarantees 100% complete data fill for Form-1 Student Information table

 * and Form-3 Student Details table in Application Form:

 * - Populates Pincode (extracted from Address if omitted)

 * - Populates College Code (extracted from Register Number or College Name if omitted)

 * - Removes literal 'NULL' or 'null' from Remarks

 * - Fixes start/end date consistency

 */

function cleanRawNumberString_(val) {

  if (val === null || val === undefined) return '';

  let str = String(val).trim();

  if (!str || str.toLowerCase() === 'undefined' || str.toLowerCase() === 'null') return '';

  // Check scientific notation like 9.566586223E9 or 1.13224041032e+11

  if (/^[-+]?[\d.]+[eE][+-]?\d+$/.test(str)) {

    try {

      const num = Number(val);

      if (!isNaN(num)) {

        str = num.toLocaleString('fullwide', { useGrouping: false });

      }

    } catch (e) {}

  }

  return str.replace(/\.0+$/, '');

}



function formatStudentDOB_(dob) {

  if (!dob) return '';

  if (dob instanceof Date) {

    return formatDateDMY(dob);

  }

  let str = String(dob).trim();

  if (!str || str.toLowerCase() === 'null' || str.toLowerCase() === 'undefined') return '';

  if (str.match(/^\d{4}[-/]\d{1,2}[-/]\d{1,2}/)) {

    let p = str.split(/[-/T]/);

    return `${p[2].padStart(2, '0')}/${p[1].padStart(2, '0')}/${p[0]}`;

  }

  return formatDateDMY(dob) || str;

}



function formatApplicationFormHeaderCell_(body, regId, barcodeBlob, qrBlob, placeholderValues) {

  if (!body) return;

  try {

    const cleanRegId = String(regId || '').trim();

    const regIdVal = cleanRegId || (placeholderValues && placeholderValues['REGISTRATION_ID']) || '';

    const appStatusVal = (placeholderValues && (placeholderValues['APPLICATION_STATUS'] || placeholderValues['STATUS'])) || 'Approved';

    const appDateVal = (placeholderValues && (placeholderValues['APPLICATION_DATE'] || placeholderValues['DATE'] || placeholderValues['ISSUE_DATE'])) || formatDateDMY(new Date());



    // Step 1: Find the paragraph containing Registration ID reliably

    let foundReg = body.findText('Registration ID') ||

                   body.findText('REGISTRATION_ID') ||

                   body.findText('Registration') ||

                   (cleanRegId ? body.findText(cleanRegId) : null);

    if (!foundReg) return;



    let pReg = foundReg.getElement();

    while (pReg && pReg.getType() !== DocumentApp.ElementType.PARAGRAPH && pReg.getParent()) {

      pReg = pReg.getParent();

    }

    if (!pReg || pReg.getType() !== DocumentApp.ElementType.PARAGRAPH) return;



    const pRegParagraph = pReg.asParagraph();

    const container = pRegParagraph.getParent();

    if (!container) return;



    // Format Registration ID (Bold, 15pt, Deep Navy) - 1.5x larger font as requested

    pRegParagraph.setText('Registration ID: ' + regIdVal);

    pRegParagraph.setBold(true);

    pRegParagraph.setItalic(false);

    pRegParagraph.setFontSize(15);

    pRegParagraph.setForegroundColor('#003366');

    pRegParagraph.setSpacingBefore(0);

    pRegParagraph.setSpacingAfter(4);

    pRegParagraph.setLineSpacing(1.0);

    pRegParagraph.setAlignment(DocumentApp.HorizontalAlignment.LEFT);



    const regIdx = container.getChildIndex(pRegParagraph);



    // Remove any previous spacer paragraphs or {{QR_CODE}} / {{BARCODE}} tags between regIdx and Application Status

    let nextIdx = regIdx + 1;

    while (nextIdx < container.getNumChildren()) {

      const nextChild = container.getChild(nextIdx);

      if (nextChild.getType() === DocumentApp.ElementType.PARAGRAPH) {

        const nextP = nextChild.asParagraph();

        const nextTxt = nextP.getText().trim();

        if (/Application\s*Status/i.test(nextTxt) || /STUDENT\s+INFORMATION/i.test(nextTxt) || /STUDENT\s+APPLICATION/i.test(nextTxt)) {

          break;

        }

        if (nextTxt === '' || /QR_CODE|BARCODE/i.test(nextTxt)) {

          try {

            nextP.removeFromParent();

            continue;

          } catch(e) {

            nextP.setText(' ');

          }

        }

      }

      nextIdx++;

    }



    // Insert combined 1D Barcode (Left, 2.4x height) + QR Code (Right, 2x size) in a single row

    const pBarQr = container.insertParagraph(regIdx + 1, ' ');

    pBarQr.setSpacingBefore(3);

    pBarQr.setSpacingAfter(4);

    pBarQr.setLineSpacing(1.0);

    pBarQr.setAlignment(DocumentApp.HorizontalAlignment.LEFT);



    if (barcodeBlob) {

      try {

        const imgBar = pBarQr.appendInlineImage(barcodeBlob);

        if (imgBar) {

          imgBar.setWidth(245);

          imgBar.setHeight(58); // 2.32x height, nearly 2.5x larger as requested

        }

      } catch (bErr) {

        Logger.log("Barcode insert error: " + bErr);

      }

    }



    if (qrBlob) {

      try {

        pBarQr.appendText('   ');

        const imgQr = pBarQr.appendInlineImage(qrBlob);

        if (imgQr) {

          imgQr.setWidth(76); // 2x size (was 38) as requested

          imgQr.setHeight(76); // 2x size as requested

        }

      } catch (qErr) {

        Logger.log("QR insert error: " + qErr);

      }

    }



    // Format Application Status with 1.5x larger font (14.5pt bold, Dark Green)

    let foundStatus = body.findText('Application\\s*Status') || body.findText('Application Status');

    if (foundStatus) {

      let pStat = foundStatus.getElement();

      while (pStat && pStat.getType() !== DocumentApp.ElementType.PARAGRAPH && pStat.getParent()) {

        pStat = pStat.getParent();

      }

      if (pStat && pStat.getType() === DocumentApp.ElementType.PARAGRAPH) {

        const ps = pStat.asParagraph();

        ps.setText('Application Status: Approved');

        ps.setBold(true);

        ps.setItalic(false);

        ps.setFontSize(14.5);

        ps.setForegroundColor('#166534');

        ps.setSpacingBefore(4);

        ps.setSpacingAfter(3);

        ps.setLineSpacing(1.0);

      }

    }



    // Format Application Date and Approval Date as 2 clean stacked lines!

    let foundDate = body.findText('Application\\s*Date') || body.findText('Application Date');

    if (foundDate) {

      let pD = foundDate.getElement();

      while (pD && pD.getType() !== DocumentApp.ElementType.PARAGRAPH && pD.getParent()) {

        pD = pD.getParent();

      }

      if (pD && pD.getType() === DocumentApp.ElementType.PARAGRAPH) {

        const pd = pD.asParagraph();

        let approvalDateVal = (placeholderValues && (placeholderValues['APPROVAL_DATE'] || placeholderValues['ApprovalDate'])) || '';

        if (!approvalDateVal || approvalDateVal === appDateVal) {

          try {

            const p = String(appDateVal).split(/[\/\-]/);

            if (p.length === 3) {

              const d = new Date(parseInt(p[2], 10), parseInt(p[1], 10) - 1, parseInt(p[0], 10) + 1);

              approvalDateVal = Utilities.formatDate(d, Session.getScriptTimeZone() || "GMT+5:30", "dd/MM/yyyy");

            }

          } catch(e) {}

        }

        if (!approvalDateVal) approvalDateVal = appDateVal;



        // Two clean lines: Application Date on top, Approval Date directly below

        const dateText = 'Application Date: ' + appDateVal + '\nApproval Date: ' + approvalDateVal;

        pd.setText(dateText);

        pd.setBold(true);

        pd.setItalic(false);

        pd.setFontSize(12.5);

        pd.setForegroundColor('#003366');

        pd.setSpacingBefore(2);

        pd.setSpacingAfter(3);

        pd.setLineSpacing(1.15);

      }

    }

  } catch (err) {

    Logger.log("formatApplicationFormHeaderCell_ error: " + err);

  }

}




function getCandidateCategory_(studentData) {
  if (!studentData) return 'Student';

  const regIdCheck = String(studentData.RegistrationID || studentData.registrationId || studentData.StudentID || studentData.StudentRegistrationID || studentData.id || '').trim().toUpperCase();
  const knownFacultyRegIds = ['GSV/2026/112/VH8C', 'GSV/2026/112/EQT4', 'GSV/2026/112/QYCG', 'GSV/2026/112/JDBI', 'GSV/2026/112/GONJ'];
  if (knownFacultyRegIds.includes(regIdCheck) || regIdCheck.includes('/FAC/') || regIdCheck.startsWith('FAC-') || studentData.FacultyStaffId) {
    return 'Faculty';
  }
  if (studentData.Designation && /prof|lectur|assist.*prof|assoc.*prof|faculty/i.test(String(studentData.Designation))) {
    return 'Faculty';
  }

  // 1. Explicit CandidateType / Category fields
  const raw = String(
    studentData.CandidateType || 
    studentData.candidateType || 
    studentData.InternshipType || 
    studentData.internshipType || 
    studentData.RegistrationCategory || 
    studentData.Category || 
    studentData.category || ''
  ).trim().toLowerCase();
  if (raw.includes('faculty') || raw.includes('fac') || raw.includes('staff') || raw.includes('teach') || raw.includes('prof')) return 'Faculty';
  if (raw.includes('employee') || raw.includes('emp') || raw.includes('comp') || raw.includes('corp') || raw.includes('profess') || raw.includes('work')) return 'Employee';
  if (raw.includes('apprentice') || raw.includes('app') || raw.includes('voca')) return 'Apprentice';

  // 2. ID / Registration Number checks
  const regId = String(studentData.RegistrationID || studentData.registrationId || studentData.StudentID || studentData.StudentRegistrationID || studentData.id || '').trim().toUpperCase();
  if (regId.includes('/FAC/') || regId.startsWith('FAC-') || studentData.FacultyStaffId) return 'Faculty';
  if (regId.includes('/EMP/') || regId.startsWith('EMP-') || studentData.EmployeeId || studentData.companyEmployeeId) return 'Employee';
  if (regId.includes('/APP/') || regId.startsWith('APP-') || studentData.ApprenticeID) return 'Apprentice';

  const regNo = String(studentData.RegisterNumber || studentData.RollNo || studentData.RegisterNo || studentData.StaffId || studentData.EmployeeId || '').trim().toUpperCase();
  if (regNo.startsWith('FAC-') || regNo.includes('/FAC/')) return 'Faculty';
  if (regNo.startsWith('EMP-') || regNo.includes('/EMP/')) return 'Employee';
  if (regNo.startsWith('APP-') || regNo.includes('/APP/')) return 'Apprentice';

  // 3. Remarks checks
  const remarks = String(studentData.Remarks || studentData.remarks || '').trim();
  if (remarks.includes('[FACULTY]')) return 'Faculty';
  if (remarks.includes('[EMPLOYEE]')) return 'Employee';
  if (remarks.includes('[APPRENTICE]')) return 'Apprentice';

  // 4. College / Org name hints
  const college = String(studentData.CollegeName || studentData.college || '').toLowerCase();
  if (college.includes('apprentice')) return 'Apprentice';
  if (college.includes('technology services') || college.includes('limited') || college.includes('corp') || college.includes('ltd')) return 'Employee';

  return 'Student';
}


function formatApplicationFormStudentInfoTable_(body, studentData, placeholderValues) {

  if (!body) return;

  try {

    const sData = studentData || {};

    

    // Resolve Student Name (never fallback to mock name)

    const stuName = getStudentFullName_(sData) || sData.FullName || sData.Name || sData.StudentName || (placeholderValues && (placeholderValues['FullName'] || placeholderValues['StudentName'])) || '--';



    // Resolve House Address (never fallback to mock address)

    const houseAddr = sData.Address || sData.HouseAddress || sData.PermanentAddress || sData.CommunicationAddress || (placeholderValues && (placeholderValues['Address'] || placeholderValues['HouseAddress'])) || '--';



    // Resolve Pincode (clean scientific notation)

    let rawPincode = (placeholderValues && (placeholderValues['Pincode'] || placeholderValues['PINCODE'] || placeholderValues['PinCode'])) || sData.Pincode || sData['Pin Code'] || sData.PostalCode || '';

    rawPincode = cleanRawNumberString_(rawPincode);

    if (!rawPincode && houseAddr) {

      const mPin = String(houseAddr).match(/\b([1-9][0-9]{5})\b/);

      if (mPin) rawPincode = mPin[1];

    }

    const pCode = rawPincode || '--';



    // Resolve District

    const districtVal = sData.District || sData.PermanentDistrict || sData.CommunicationDistrict || sData.City || (placeholderValues && (placeholderValues['District'] || placeholderValues['DISTRICT'])) || '--';



    // Resolve Student Email (never fallback to mock email)

    const stuEmail = (sData.GmailID || sData.Gmail || sData.Email || sData.StudentEmail || sData.gmail || sData.email || (placeholderValues && (placeholderValues['GmailID'] || placeholderValues['Email'] || placeholderValues['EMAIL'])) || '--').trim();



    // Resolve Mobile Number (clean scientific notation, never fallback to mock phone)

    let rawMobile = sData.MobileNumber || sData.Mobile || sData.Phone || sData.PhoneNumber || sData.StudentMobile || (placeholderValues && (placeholderValues['MobileNumber'] || placeholderValues['Phone'] || placeholderValues['PHONE'])) || '';

    const stuMobile = cleanRawNumberString_(rawMobile) || '--';



    // Resolve College Name

    let rawCollege = sData.CollegeName || sData.College || (placeholderValues && (placeholderValues['CollegeName'] || placeholderValues['COLLEGE_NAME'])) || '';

    const stuCollege = formatCollegeNameWithSpaces_(rawCollege) || '--';



    // Resolve College Code

    let rawCollegeCode = (placeholderValues && (placeholderValues['CollegeCode'] || placeholderValues['COLLEGE_CODE'])) || sData.CollegeCode || sData['College Code'] || '';

    rawCollegeCode = cleanRawNumberString_(rawCollegeCode);

    if (!rawCollegeCode && sData.RegisterNumber) {

      const regMatch = cleanRawNumberString_(sData.RegisterNumber).match(/^(\d{4})\d{8}$/);

      if (regMatch) rawCollegeCode = regMatch[1];

    }

    const cCode = rawCollegeCode || '--';



    // Resolve College District

    const stuCollegeDistrict = sData.CollegeDistrict || sData.District || (placeholderValues && (placeholderValues['CollegeDistrict'] || placeholderValues['COLLEGE_DISTRICT'])) || '--';



    // Resolve College Register Number (clean scientific notation, never fallback to mock number)

    let rawRegNo = sData.CollegeRegisterNumber || sData.RegisterNumber || sData.CollegeRegisterNo || sData.RegisterNo || sData.UniversityRegisterNumber || (placeholderValues && (placeholderValues['RegisterNumber'] || placeholderValues['REGISTER_NUMBER'])) || '';

    const stuRegNo = cleanRawNumberString_(rawRegNo) || '--';



    // Resolve Education Type

    const eduType = sData.EducationType || sData.Degree || (placeholderValues && (placeholderValues['EducationType'] || placeholderValues['EDUCATION_TYPE'])) || 'Engineering UG';



    // Resolve Department

    const rawDept = sData.Department || sData.Dept || sData.Branch || (placeholderValues && placeholderValues['Department']) || '';

    const stuDept = rawDept ? expandDepartmentFullName(rawDept) : '--';



    // Resolve Year

    let stuYear = String(sData.Year || sData.StudentYear || (placeholderValues && placeholderValues['Year']) || '').trim();

    if (stuYear) {

      stuYear = stuYear.replace(/\s*year\s*/gi, '').trim();

      if (/^\d+$/.test(stuYear)) {

        const yNum = parseInt(stuYear, 10);

        stuYear = (yNum === 1 ? '1st' : (yNum === 2 ? '2nd' : (yNum === 3 ? '3rd' : (yNum === 4 ? '4th' : yNum + 'th'))));

      }

    } else {

      stuYear = '--';

    }



    // Resolve Semester

    let stuSem = String(sData.Semester || (placeholderValues && placeholderValues['Semester']) || '').trim();

    if (stuSem) {

      if (/^\d+$/.test(stuSem)) {

        const sNum = parseInt(stuSem, 10);

        stuSem = (sNum === 1 ? '1st' : (sNum === 2 ? '2nd' : (sNum === 3 ? '3rd' : sNum + 'th'))) + ' Semester';

      } else if (!/semester/i.test(stuSem)) {

        stuSem = stuSem + ' Semester';

      }

    } else {

      stuSem = '--';

    }



    // Resolve Date of Birth (format strictly DD/MM/YYYY, never fallback to mock date)

    const rawDob = sData.FormattedDOB || sData.DateofBirth || sData.DateOfBirth || sData.DOB || sData.BirthDate || (placeholderValues && (placeholderValues['DateofBirth'] || placeholderValues['DOB']));

    const stuDob = formatStudentDOB_(rawDob) || '--';



    // Resolve CGPA

    let stuCgpa = cleanRawNumberString_(sData.CGPA || sData.GPA || sData.cgpa || (placeholderValues && placeholderValues['CGPA']) || '');

    if (!stuCgpa) stuCgpa = '--';



    // Resolve Work Area

    const stuWorkArea = sData.WorkArea || sData.SkillLearned || sData.InterestedArea || sData.Track || sData.ProjectTitle || (placeholderValues && (placeholderValues['WorkArea'] || placeholderValues['SkillLearned'])) || '';



    // Resolve Dates

    const startDate = (placeholderValues && placeholderValues['InternshipStartDate']) || sData.FormattedStartDate || formatDateDMY(sData.InternshipStartDate || sData.StartDate) || '--';

    const endDate = (placeholderValues && placeholderValues['InternshipEndDate']) || sData.FormattedEndDate || formatDateDMY(sData.InternshipEndDate || sData.EndDate) || '--';

    const durationDays = cleanRawNumberString_((placeholderValues && (placeholderValues['DurationDays'] || placeholderValues['DURATION_DAYS'])) || sData.CalculatedInternshipDays || sData.DurationDays || '30');



    // Remarks

    let remarksVal = (placeholderValues && placeholderValues['Remarks']) || sData.Remarks || '';

    if (String(remarksVal).toUpperCase() === 'NULL' || String(remarksVal).toUpperCase() === 'UNDEFINED') remarksVal = '';



    // Find existing Student Info Table

    const allTables = body.getTables();

    let targetTbl = null;

    let targetTblIdx = -1;



    for (let t = 0; t < allTables.length; t++) {

      const tbl = allTables[t];

      const numRows = tbl.getNumRows();

      for (let r = 0; r < numRows; r++) {

        const row = tbl.getRow(r);

        if (row.getNumCells() >= 2) {

          const lTxt = (row.getCell(0).getText() || '').trim().toLowerCase();

          if (lTxt.includes('student name') || lTxt.includes('house address') || lTxt.includes('college name') || lTxt.includes('date of birth')) {

            targetTbl = tbl;

            break;

          }

        }

      }

      if (targetTbl) break;

    }



    if (!targetTbl) return;

    targetTblIdx = body.getChildIndex(targetTbl);



    // Branch table data and heading dynamically according to candidate category
    const candCat = getCandidateCategory_(sData);
    let headingTitle = 'STUDENT APPLICATION DETAILS';
    let col2Title = 'Student Details';
    let tableData = [];

    if (candCat === 'Faculty') {
      headingTitle = 'FACULTY INTERNSHIP APPLICATION DETAILS';
      col2Title = 'Faculty / Staff Details';
      const parsedRem = parseFacultyRemarks_(sData.Remarks);

      // 1. Resolve Gender & Salutation (never an address string)
      let fGender = String(sData.Gender || sData.gender || '').trim();
      if (fGender.length > 15 || /college|department|road|street|nagar|chennai/i.test(fGender)) fGender = '';
      if (!fGender) {
        if (/^(male|female|other)$/i.test(String(sData.InterestedArea || '').trim())) fGender = String(sData.InterestedArea).trim();
        else if (/susanna|ramya|priya/i.test(stuName)) fGender = 'Female';
        else fGender = 'Female';
      }

      // 2. Resolve Staff ID
      const fStaffId = sData.FacultyStaffId || sData.StaffId || parsedRem.staffId || sData.RegisterNumber || stuRegNo;

      // 3. Resolve Academic Designation
      const fDesig = sData.Designation || sData.FacultyDesignation || parsedRem.designation || 'Faculty Member';

      // 4. Resolve Educational Qualification
      const fQual = sData.EducationType || sData.facultyEducation || sData.Degree || 'M.E. / M.Tech';

      // 5. Resolve Passout Year (strictly 4-digit year, never 'Faculty')
      let fPassYear = sData.facultyPassYear || sData.PassoutYear || sData.GraduationYear || '';
      if (!fPassYear || /^(faculty|student|employee|apprentice|--)$/i.test(String(fPassYear).trim())) fPassYear = parsedRem.passout || '';
      if (!fPassYear && sData.Year && !/^(faculty|student|employee|apprentice)$/i.test(String(sData.Year).trim())) fPassYear = String(sData.Year).trim();
      const mYear = String(fPassYear).match(/\b(19\d\d|20[0-2]\d)\b/);
      if (mYear) fPassYear = mYear[1];
      if (!fPassYear) fPassYear = '2021';

      // 6. Resolve Teaching Experience (never generic 'Academic Experience')
      let fExp = sData.TeachingExperience || sData.facultyExperience || sData.WorkExperience || sData.Experience || '';
      if (!fExp || /academic\s*experience/i.test(String(fExp).trim()) || fExp === '--') fExp = parsedRem.exp || '';
      if (!fExp && sData.Year && /year|exp/i.test(String(sData.Year))) fExp = String(sData.Year).trim();
      if (!fExp) {
        const pNum = parseInt(fPassYear, 10);
        if (pNum && pNum >= 1980 && pNum <= 2025) fExp = `${2026 - pNum} Years`;
        else fExp = '5 Years';
      }

      // 7. Resolve Specialization Domain (never gender 'Female')
      let fDomain = sData.facultyDomain || sData.Specialization || sData.Domain || sData.TechnicalDomain || '';
      if (!fDomain || /^(male|female|other|--)$/i.test(String(fDomain).trim())) fDomain = parsedRem.domain || '';
      if (!fDomain && sData.Department) {
        const mDom = String(sData.Department).match(/\(([^)]+)\)/);
        if (mDom && !/^(male|female|other)$/i.test(mDom[1].trim())) fDomain = mDom[1].trim();
      }
      if (!fDomain && sData.facultyDomain && !/^(male|female|other)$/i.test(String(sData.facultyDomain).trim())) fDomain = sData.facultyDomain;
      if (!fDomain) {
        const dLower = String(stuDept).toLowerCase();
        if (dLower.includes('electronics') || dLower.includes('ece')) fDomain = 'Embedded Systems & IoT';
        else if (dLower.includes('computer') || dLower.includes('cse') || dLower.includes('it')) fDomain = 'Artificial Intelligence & Machine Learning';
        else if (dLower.includes('electrical') || dLower.includes('eee')) fDomain = 'Power Electronics & Embedded Systems';
        else fDomain = 'Applied Electronics & IoT';
      }

      // 7b. Resolve Faculty Internship Interested Area (e.g. R&D (IoT & Electronics), Production, etc.)
      let fInterestedArea = sData.InterestedArea || sData.interestedArea || sData.WorkArea || sData.workArea || parsedRem.interestedArea || '';
      if (/^(male|female|other|--)$/i.test(String(fInterestedArea).trim())) fInterestedArea = '';
      if (!fInterestedArea && sData.Department) {
        const dLower = String(stuDept).toLowerCase();
        if (dLower.includes('electronics') || dLower.includes('ece')) fInterestedArea = 'R&D (IoT & Electronics)';
        else if (dLower.includes('computer') || dLower.includes('cse') || dLower.includes('it')) fInterestedArea = 'Product Development & Software';
        else if (dLower.includes('electrical') || dLower.includes('eee')) fInterestedArea = 'Power Electronics & Embedded Systems';
        else fInterestedArea = 'R&D (IoT & Electronics)';
      }
      if (!fInterestedArea) fInterestedArea = 'R&D (IoT & Electronics)';

      // 8. Resolve Residential Address, Pincode, District (Actual residential address, not college address)
      let resAddr = sData.ResidentialAddress || sData.PermanentAddress || sData.HomeAddress || sData.facultyResidentialAddress || sData.facultyAddress || houseAddr || '--';
      let resPin = sData.ResidentialPincode || sData.PermanentPincode || sData.facultyPincode || pCode || '--';
      let resDist = sData.ResidentialDistrict || sData.PermanentDistrict || sData.facultyDistrict || districtVal || '--';

      tableData = [
        ['S.No', col2Title, 'Value'],
        ['1', 'Faculty Name', stuName],
        ['2', 'Gender', fGender],
        ['3', 'Residential Address', resAddr],
        ['4', 'Pincode', String(resPin)],
        ['5', 'District', String(resDist)],
        ['6', 'Official Email ID', stuEmail],
        ['7', 'Mobile Number', stuMobile],
        ['8', 'Institution / College Name', stuCollege],
        ['9', 'College Code', String(cCode)],
        ['10', 'College District', stuCollegeDistrict],
        ['11', 'Faculty / Staff ID', String(fStaffId)],
        ['12', 'Educational Qualification', String(fQual)],
        ['13', 'Academic Designation', String(fDesig)],
        ['14', 'Department & Specialization', stuDept],
        ['15', 'Specialization Domain', String(fDomain)],
        ['16', 'Internship Interested Area', String(fInterestedArea)],
        ['17', 'Year of Passing / Graduation', String(fPassYear)],
        ['18', 'Teaching / Work Experience', String(fExp)],
        ['19', 'Date of Birth', stuDob],
        ['20', 'Research & Training Scope', stuWorkArea || 'R&D, Prototyping & Academic Mentorship'],
        ['21', 'Internship Start Date', String(startDate)],
        ['22', 'Internship End Date', String(endDate)],
        ['23', 'Calculated Internship Days', String(durationDays)],
        ['24', 'Remarks', String(remarksVal || 'Faculty Internship & Industrial Training Program')]
      ];
    } else if (candCat === 'Employee') {
      headingTitle = 'CORPORATE PROFESSIONAL APPLICATION DETAILS';
      col2Title = 'Employee / Professional Details';
      const empComp = sData.CompanyName || sData.Company || stuCollege;
      const empGst = sData.GSTIN || sData.CompanyGst || '--';
      const empCity = sData.CompanyLocation || sData.City || districtVal;
      const empId = sData.EmployeeId || sData.StaffId || stuRegNo;
      const empDesig = sData.Designation || sData.CurrentDesignation || 'Working Professional';
      const empExp = sData.IndustryExperience || sData.Experience || 'Industry Experience';
      tableData = [
        ['S.No', col2Title, 'Value'],
        ['1', 'Professional Name', stuName],
        ['2', 'Residential Address', houseAddr],
        ['3', 'Pincode', String(pCode)],
        ['4', 'District', districtVal],
        ['5', 'Corporate Email ID', stuEmail],
        ['6', 'Mobile Number', stuMobile],
        ['7', 'Company / Enterprise Name', String(empComp)],
        ['8', 'Company GSTIN / Reg No', String(empGst)],
        ['9', 'Company City / Location', String(empCity)],
        ['10', 'Corporate Employee ID', String(empId)],
        ['11', 'Current Designation', String(empDesig)],
        ['12', 'Technical Department / Division', stuDept],
        ['13', 'Industry Experience', String(empExp)],
        ['14', 'Date of Birth', stuDob],
        ['15', 'Upskilling & Project Scope', stuWorkArea],
        ['16', 'Training Start Date', String(startDate)],
        ['17', 'Training End Date', String(endDate)],
        ['18', 'Calculated Training Days', String(durationDays)],
        ['19', 'Remarks', String(remarksVal || 'Corporate Upskilling & Industrial Prototyping')]
      ];
    } else if (candCat === 'Apprentice') {
      headingTitle = 'INDUSTRIAL APPRENTICESHIP APPLICATION DETAILS';
      col2Title = 'Apprentice Trainee Details';
      const appQual = sData.HighestQualification || sData.Qualification || 'Diploma in Engineering';
      const appPassYear = sData.PassingYear || sData.Year || '--';
      tableData = [
        ['S.No', col2Title, 'Value'],
        ['1', 'Candidate Name', stuName],
        ['2', 'Residential Address', houseAddr],
        ['3', 'Pincode', String(pCode)],
        ['4', 'District', districtVal],
        ['5', 'Candidate Email ID', stuEmail],
        ['6', 'Mobile Number', stuMobile],
        ['7', 'Institution / Polytechnic', stuCollege],
        ['8', 'Apprentice Application ID', String(sData.RegistrationID || stuRegNo)],
        ['9', 'Highest Qualification', String(appQual)],
        ['10', 'Trade / Branch', stuDept],
        ['11', 'Year of Passing', String(appPassYear)],
        ['12', 'Date of Birth', stuDob],
        ['13', 'Practical Training Tracks', stuWorkArea],
        ['14', 'Apprenticeship Start Date', String(startDate)],
        ['15', 'Apprenticeship End Date', String(endDate)],
        ['16', 'Calculated Apprenticeship Days', String(durationDays)],
        ['17', 'Stipend Policy Acknowledged', 'Yes (Non-mandatory / Review based)'],
        ['18', 'Remarks', String(remarksVal || 'Industrial Vocational Apprenticeship')]
      ];
    } else {
      // Pursuing Student (Original Unchanged)
      tableData = [
        ['S.No', 'Student Details', 'Value'],
        ['1', 'Student Name', stuName],
        ['2', 'House Address', houseAddr],
        ['3', 'Pincode', String(pCode)],
        ['4', 'District', districtVal],
        ['5', 'Student Email', stuEmail],
        ['6', 'Mobile Number', stuMobile],
        ['7', 'College Name', stuCollege],
        ['8', 'College Code', String(cCode)],
        ['9', 'College District', stuCollegeDistrict],
        ['10', 'College Register Number', stuRegNo],
        ['11', 'Education Type', eduType],
        ['12', 'Department', stuDept],
        ['13', 'Year', stuYear],
        ['14', 'Semester', stuSem],
        ['15', 'Date of Birth', stuDob],
        ['16', 'CGPA', String(stuCgpa)],
        ['17', 'Work Area', stuWorkArea],
        ['18', 'Internship Start Date', String(startDate)],
        ['19', 'Internship End Date', String(endDate)],
        ['20', 'Calculated Internship Days', String(durationDays)],
        ['21', 'Remarks', String(remarksVal)]
      ];
    }

    // 1. Remove redundant "STUDENT INFORMATION" / "FACULTY / STAFF INFORMATION" heading paragraph on Page 1
    const redundantInfoHeadings = [
      'STUDENT INFORMATION',
      'STUDENT\\s+INFORMATION',
      'FACULTY / STAFF INFORMATION',
      'FACULTY\\s*/\\s*STAFF\\s+INFORMATION',
      'EMPLOYEE / PARTICIPANT INFORMATION',
      'APPRENTICE TRAINEE INFORMATION'
    ];
    redundantInfoHeadings.forEach(rh => {
      try {
        let fRh = body.findText(rh);
        while (fRh) {
          let elRh = fRh.getElement();
          while (elRh && elRh.getType() !== DocumentApp.ElementType.PARAGRAPH && elRh.getParent()) {
            elRh = elRh.getParent();
          }
          if (elRh && elRh.getType() === DocumentApp.ElementType.PARAGRAPH) {
            const pRh = elRh.asParagraph();
            if (pRh.getParent() && pRh.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {
              const rhIdx = body.getChildIndex(pRh);
              if (rhIdx < targetTblIdx) {
                pRh.removeFromParent();
                targetTblIdx--;
              }
            }
          }
          fRh = body.findText(rh, fRh);
        }
      } catch(eRh) {}
    });

    // 2. Locate or style existing application details heading
    let foundInfo = body.findText('STUDENT APPLICATION DETAILS') || body.findText('FACULTY INTERNSHIP APPLICATION DETAILS') || body.findText('INDUSTRIAL APPRENTICESHIP APPLICATION DETAILS') || body.findText('CORPORATE UPSKILLING APPLICATION DETAILS');
    let pHeading = null;
    if (foundInfo) {
      let pI = foundInfo.getElement();
      while (pI && pI.getType() !== DocumentApp.ElementType.PARAGRAPH && pI.getParent()) pI = pI.getParent();
      if (pI && pI.getType() === DocumentApp.ElementType.PARAGRAPH) {
        pHeading = pI.asParagraph();
      }
    }

    if (pHeading && pHeading.getParent() && pHeading.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {
      // Clean up any empty/whitespace-only spacer paragraphs directly before pHeading
      let hIdx = body.getChildIndex(pHeading);
      for (let k = hIdx - 1; k >= 0; k--) {
        const prevChild = body.getChild(k);
        if (prevChild.getType() === DocumentApp.ElementType.PARAGRAPH) {
          const prevTxt = prevChild.asParagraph().getText().replace(/[\s\u200b]/g, '');
          if (prevTxt === '' && prevChild.asParagraph().getPositionedImages().length === 0) {
            prevChild.removeFromParent();
            hIdx--;
            targetTblIdx--;
            continue;
          }
        }
        break;
      }

      pHeading.setText(headingTitle);
      pHeading.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
      pHeading.setSpacingBefore(12);
      pHeading.setSpacingAfter(5);
      pHeading.setLineSpacing(1.0);
      const ti = pHeading.editAsText();
      ti.setFontFamily('Arial').setFontSize(13).setBold(true).setForegroundColor('#003366');
    } else {
      // Insert heading right before target table
      pHeading = body.insertParagraph(targetTblIdx, headingTitle);
      pHeading.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
      pHeading.setSpacingBefore(12);
      pHeading.setSpacingAfter(5);
      pHeading.setLineSpacing(1.0);
      const ti = pHeading.editAsText();
      ti.setFontFamily('Arial').setFontSize(13).setBold(true).setForegroundColor('#003366');
      targetTblIdx++;
    }

    // Remove old 2-column table

    targetTbl.removeFromParent();



    // Insert new 3-column table

    const newTbl = body.insertTable(targetTblIdx, tableData);

    try { newTbl.setAttributes({ [DocumentApp.Attribute.HORIZONTAL_ALIGNMENT]: DocumentApp.HorizontalAlignment.CENTER }); } catch(e) {}

    newTbl.setBorderWidth(1.2);

    newTbl.setBorderColor('#000000');



    // Format rows (Title size header, 1.5x larger font content)

    const numRows = newTbl.getNumRows();

    for (let r = 0; r < numRows; r++) {

      const row = newTbl.getRow(r);

      row.setMinimumHeight(20.5);

      const c0 = row.getCell(0);

      const c1 = row.getCell(1);

      const c2 = row.getCell(2);



      c0.setWidth(33);

      c1.setWidth(150);

      c2.setWidth(260); // Total 443pt: dead center



      c0.setPaddingTop(2.5).setPaddingBottom(2.5).setPaddingLeft(2).setPaddingRight(2);

      c1.setPaddingTop(2.5).setPaddingBottom(2.5).setPaddingLeft(5).setPaddingRight(5);

      c2.setPaddingTop(2.5).setPaddingBottom(2.5).setPaddingLeft(5).setPaddingRight(5);

      c0.setVerticalAlignment(DocumentApp.VerticalAlignment.MIDDLE);

      c1.setVerticalAlignment(DocumentApp.VerticalAlignment.MIDDLE);

      c2.setVerticalAlignment(DocumentApp.VerticalAlignment.MIDDLE);



      if (r === 0) {

        c0.setBackgroundColor('#003366');

        c1.setBackgroundColor('#003366');

        c2.setBackgroundColor('#003366');



        [c0, c1, c2].forEach((cell, idx) => {

          if (cell.getNumChildren() > 0 && cell.getChild(0).getType() === DocumentApp.ElementType.PARAGRAPH) {

            const cp = cell.getChild(0).asParagraph();

            cp.setAlignment(idx === 0 ? DocumentApp.HorizontalAlignment.CENTER : DocumentApp.HorizontalAlignment.LEFT);

            cp.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);

            const tp = cp.editAsText();

            tp.setFontFamily('Arial').setFontSize(11.5).setBold(true).setForegroundColor('#ffffff');

            const len = cp.getText().length;

            if (len > 0) {

              tp.setFontFamily(0, len - 1, 'Arial');

              tp.setFontSize(0, len - 1, 11.5);

              tp.setBold(0, len - 1, true);

              tp.setForegroundColor(0, len - 1, '#ffffff');

            }

          }

        });

      } else {

        c0.setBackgroundColor('#ffffff');

        c1.setBackgroundColor('#ffffff');

        c2.setBackgroundColor('#ffffff');



        // S.No

        if (c0.getNumChildren() > 0 && c0.getChild(0).getType() === DocumentApp.ElementType.PARAGRAPH) {

          const cp0 = c0.getChild(0).asParagraph();

          cp0.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

          cp0.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);

          const tp0 = cp0.editAsText();

          tp0.setFontFamily('Arial').setFontSize(10.5).setBold(true).setForegroundColor('#000000');

        }



        // Label

        if (c1.getNumChildren() > 0 && c1.getChild(0).getType() === DocumentApp.ElementType.PARAGRAPH) {

          const cp1 = c1.getChild(0).asParagraph();

          cp1.setAlignment(DocumentApp.HorizontalAlignment.LEFT);

          cp1.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);

          const tp1 = cp1.editAsText();

          tp1.setFontFamily('Arial').setFontSize(10.5).setBold(true).setForegroundColor('#000000');

        }



        // Value

        if (c2.getNumChildren() > 0 && c2.getChild(0).getType() === DocumentApp.ElementType.PARAGRAPH) {

          const cp2 = c2.getChild(0).asParagraph();

          cp2.setAlignment(DocumentApp.HorizontalAlignment.LEFT);

          cp2.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);

          const tp2 = cp2.editAsText();

          tp2.setFontFamily('Arial').setFontSize(10.5).setBold(false).setForegroundColor('#000000');

        }

      }

    }

  } catch (err) {

    Logger.log("formatApplicationFormStudentInfoTable_ error: " + err);

  }

}



function formatApplicationFormDeclarationSignatures_(body, studentData) {

  if (!body || !studentData) return;

  try {

    const fullName = getStudentFullName_(studentData);

    const college = studentData.CollegeName || '--';

    const dept = studentData.Department || '--';

    const yearVal = studentData.Year ? String(studentData.Year).replace(/\s*year\s*/gi, '').trim() + ' Year' : '--';

    const district = studentData.CollegeDistrict || studentData.District || studentData.City || '';



    // Step 1: Specifically locate Form-2 heading first to ensure we NEVER touch Form-1

    let foundForm2 = body.findText('Form-2');

    if (!foundForm2) foundForm2 = body.findText('STUDENT & PARENT SELF DECLARATION');

    if (!foundForm2) return;



    // Enhance Form-2 Title & Heading styling

    try {

      let foundF2Head = body.findText('Form-2');

      if (foundF2Head) {

        let eH = foundF2Head.getElement();

        while (eH && eH.getType() !== DocumentApp.ElementType.PARAGRAPH && eH.getParent()) eH = eH.getParent();

        if (eH && eH.getType() === DocumentApp.ElementType.PARAGRAPH) {

          const ph = eH.asParagraph();

          ph.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

          ph.setSpacingBefore(0);

          ph.setSpacingAfter(2);

          ph.editAsText().setFontFamily('Arial').setFontSize(18).setBold(true).setForegroundColor('#003366');

        }

      }

      const candCat = getCandidateCategory_(studentData);
      let form2Title = 'STUDENT & PARENT SELF DECLARATION';
      if (candCat === 'Faculty') {
        form2Title = 'FACULTY INTERNSHIP TRAINING DECLARATION LETTER';
      } else if (candCat === 'Employee') {
        form2Title = 'CORPORATE EMPLOYEE TRAINING DECLARATION LETTER';
      } else if (candCat === 'Apprentice') {
        form2Title = 'INDUSTRIAL APPRENTICESHIP DECLARATION LETTER';
      }

      // 1. Check paragraph immediately following Form-2
      let elF2 = foundF2Head ? foundF2Head.getElement() : null;
      while (elF2 && elF2.getParent() && elF2.getParent().getType() !== DocumentApp.ElementType.BODY_SECTION) elF2 = elF2.getParent();
      if (elF2 && elF2.getParent() && elF2.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {
        const f2Idx = body.getChildIndex(elF2);
        if (f2Idx + 1 < body.getNumChildren()) {
          const nextEl = body.getChild(f2Idx + 1);
          if (nextEl.getType() === DocumentApp.ElementType.PARAGRAPH) {
            const pt = nextEl.asParagraph();
            const ptText = (pt.getText() || '').trim();
            if (/DETAILS|DECLARATION|APPLICATION|UNDERTAKING|STUDENT|FACULTY/i.test(ptText)) {
              pt.setText(form2Title);
              pt.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
              pt.setSpacingBefore(2);
              pt.setSpacingAfter(6);
              pt.editAsText().setFontFamily('Arial').setFontSize(15).setBold(true).setForegroundColor('#003366');
            }
          }
        }
      }

      // 2. Replacements for Form-2 title strictly
      body.replaceText('FACULTY DECLARATION UNDERTAKING', form2Title);
      body.replaceText('FACULTY / STAFF PROFESSIONAL UNDERTAKING', form2Title);
      body.replaceText('STUDENT & PARENT SELF DECLARATION(?: LETTER)?', form2Title);
      body.replaceText('STUDENT & PARENT SELF DECLARATION', form2Title);
      body.replaceText('Student & Parent Self Declaration Letter', form2Title);

    } catch(f2StylErr) {}



    let elForm2 = foundForm2.getElement();

    while (elForm2 && elForm2.getParent() && elForm2.getParent().getType() !== DocumentApp.ElementType.BODY_SECTION) {

      elForm2 = elForm2.getParent();

    }

    if (!elForm2 || !elForm2.getParent()) return;



    const bodySection = body;

    const form2StartIdx = bodySection.getChildIndex(elForm2);



    // Step 2: Locate "Thanking You" or "Student Signature" strictly AFTER form2StartIdx

    let targetIdx = -1;

    for (let i = form2StartIdx; i < bodySection.getNumChildren(); i++) {

      const child = bodySection.getChild(i);

      const txt = (child.getText ? child.getText() : '');

      if (/Form\s*-?\s*3|STUDENT\s+INTERNSHIP\s+ATTENDANCE/i.test(txt)) {

        break; // Stop if we hit Form-3

      }

      if (/Thanking\s*You/i.test(txt)) {

        targetIdx = i + 1;

        break;

      }

      if (/Student\s*Signature|Parent\s*[\/\\]\s*Guardian/i.test(txt)) {

        targetIdx = i;

      }

    }



    if (targetIdx === -1) return;



    // Step 3: Find the end of Form-2 before Form-3

    let form2EndIdx = targetIdx;

    for (let i = targetIdx; i < bodySection.getNumChildren(); i++) {

      const child = bodySection.getChild(i);

      const txt = (child.getText ? child.getText() : '');

      if (/Form\s*-?\s*3|STUDENT\s+INTERNSHIP\s+ATTENDANCE/i.test(txt)) {

        break;

      }

      form2EndIdx = i;

    }



    // Step 4: Remove old Form-2 signature elements between targetIdx and form2EndIdx

    for (let k = form2EndIdx; k >= targetIdx; k--) {

      try {

        const toRem = bodySection.getChild(k);

        const txt = (toRem.getText ? toRem.getText() : '');

        if (!/Form\s*-?\s*3|STUDENT\s+INTERNSHIP\s+ATTENDANCE/i.test(txt)) {

          toRem.removeFromParent();

        }

      } catch(e) {}

    }



    const insertIdx = Math.min(targetIdx, bodySection.getNumChildren());



    // Step 5: Insert 1-row, 2-column borderless table

    const sigTable = bodySection.insertTable(insertIdx);

    sigTable.setBorderWidth(0);

    sigTable.setBorderColor('#ffffff');



    const row = sigTable.appendTableRow();

    const cellLeft = row.appendTableCell();

    const cellRight = row.appendTableCell();



    cellLeft.setWidth(240);

    cellRight.setWidth(240);



    [cellLeft, cellRight].forEach(c => {

      c.setPaddingTop(4);

      c.setPaddingBottom(4);

      c.setPaddingLeft(4);

      c.setPaddingRight(4);

    });



    // --- LEFT COLUMN: Student Details & Signature ---

    const p0 = cellLeft.getChild(0).asParagraph();

    p0.setText(fullName);

    p0.setBold(true);

    p0.setFontSize(10);

    p0.setSpacingBefore(0);

    p0.setSpacingAfter(2);

    p0.setLineSpacing(1.0);



    const pCol = cellLeft.appendParagraph(college);

    pCol.setFontSize(9);

    pCol.setBold(false);

    pCol.setSpacingBefore(0);

    pCol.setSpacingAfter(2);

    pCol.setLineSpacing(1.0);



    const pDept = cellLeft.appendParagraph(dept);

    pDept.setFontSize(9);

    pDept.setSpacingBefore(0);

    pDept.setSpacingAfter(2);

    pDept.setLineSpacing(1.0);



    const pYr = cellLeft.appendParagraph(yearVal);

    pYr.setFontSize(9);

    pYr.setSpacingBefore(0);

    pYr.setSpacingAfter(2);

    pYr.setLineSpacing(1.0);



    const pDst = cellLeft.appendParagraph(district);

    pDst.setFontSize(9);

    pDst.setSpacingBefore(0);

    pDst.setSpacingAfter(6);

    pDst.setLineSpacing(1.0);



    // Ample physical signature clearance gap (35pt)

    const pStuSigGap = cellLeft.appendParagraph('');

    pStuSigGap.setSpacingBefore(32);

    pStuSigGap.setSpacingAfter(2);



    const pStuLine = cellLeft.appendParagraph('___________________________________');

    pStuLine.setFontSize(9.5);

    pStuLine.setSpacingBefore(0);

    pStuLine.setSpacingAfter(2);

    pStuLine.setLineSpacing(1.0);



    const candCat = getCandidateCategory_(studentData);
    let sigLabelLeft = 'Student Signature';
    let sigLabelRight = 'Parent / Guardian Signature';
    let rightSubtitle = '';
    let form2Title = 'STUDENT & PARENT SELF DECLARATION';

    if (candCat === 'Faculty') {
      sigLabelLeft = 'Faculty Trainee Signature';
      sigLabelRight = 'Head of Institution / HOD Signature';
      rightSubtitle = 'Principal / Dean / HOD';
      form2Title = 'FACULTY DECLARATION UNDERTAKING';
    } else if (candCat === 'Employee') {
      sigLabelLeft = 'Employee Trainee Signature';
      sigLabelRight = 'HR / Corporate Authority Signature';
      rightSubtitle = 'Authorized Company Signatory';
      form2Title = 'CORPORATE EMPLOYEE PROFESSIONAL UNDERTAKING';
    } else if (candCat === 'Apprentice') {
      sigLabelLeft = 'Apprentice Trainee Signature';
      sigLabelRight = 'Parent / Guardian / Sponsoring Signature';
      rightSubtitle = 'Guardian / Technical Supervisor';
      form2Title = 'INDUSTRIAL APPRENTICESHIP UNDERTAKING';
    }

    if (candCat === 'Faculty') {
      try {
        body.replaceText('STUDENT & PARENT SELF DECLARATION(?: LETTER)?', 'FACULTY DECLARATION UNDERTAKING');
        body.replaceText('STUDENT & PARENT SELF DECLARATION', 'FACULTY DECLARATION UNDERTAKING');
        body.replaceText('Student & Parent Self Declaration Letter', 'Faculty Declaration Undertaking');
        body.replaceText('Self Declaration for Internship Training', 'Self-Declaration for Faculty Internship Training');

        body.replaceText('Faculty Declaration for Industrial Linkage & Internship Training', 'Self-Declaration for Faculty Internship Training');

        body.replaceText('Faculty Internship & Industrial Linkage Program', 'Faculty Internship Training Program');
        body.replaceText('I, the undersigned student, along with my parent/guardian, hereby declare that I am voluntarily joining the internship training program conducted by your organization\\.?', 'I, the undersigned Faculty Member, hereby declare that I am voluntarily participating in the Faculty Internship Training Program conducted by your organization.');
        body.replaceText('I, the undersigned student, along with my parent/guardian, hereby declare that I am voluntarily joining the internship training program', 'I, the undersigned Faculty Member, hereby declare that I am voluntarily participating in the Faculty Internship Training Program conducted by your organization.');
        body.replaceText('I, the undersigned Faculty Member, hereby declare that I am voluntarily participating in the Faculty Internship & Industrial Linkage Program', 'I, the undersigned Faculty Member, hereby declare that I am voluntarily participating in the Faculty Internship Training Program conducted by your organization.');
        body.replaceText('I, the undersigned student, along with my parent/guardian, hereby declare', 'I, the undersigned Faculty Member, hereby declare');
        body.replaceText('the undersigned student, along with my parent/guardian', 'the undersigned Faculty Member');
        body.replaceText('Student Signature', 'Faculty Trainee Signature');
        body.replaceText('Faculty Member Signature', 'Faculty Trainee Signature');
        body.replaceText('conducted by your organization\\.\\s*conducted by your organization\\.', 'conducted by your organization.');
        body.replaceText('conducted by your organization\\.\\s*conducted by your organization', 'conducted by your organization.');
      } catch(e) {}
    } else if (candCat !== 'Student') {
      try {
        body.replaceText('STUDENT & PARENT SELF DECLARATION(?: LETTER)?', form2Title);
      } catch(e) {}
    }

    const pStuSigTxt = cellLeft.appendParagraph(sigLabelLeft);

    pStuSigTxt.setFontSize(9.5);

    pStuSigTxt.setBold(true);

    pStuSigTxt.setSpacingBefore(0);

    pStuSigTxt.setSpacingAfter(1);

    pStuSigTxt.setLineSpacing(1.0);



    const pStuNameBelow = cellLeft.appendParagraph(fullName);

    pStuNameBelow.setFontSize(9);

    pStuNameBelow.setBold(false);

    pStuNameBelow.setSpacingBefore(0);

    pStuNameBelow.setSpacingAfter(0);

    pStuNameBelow.setLineSpacing(1.0);



    // --- RIGHT COLUMN: Endorsement / Guardian Details & Signature ---

    const pParHdr = cellRight.getChild(0).asParagraph();

    if (candCat === 'Faculty') {
      pParHdr.setText('Head of Institution / HOD');
      pParHdr.setBold(true);
      pParHdr.setFontSize(10);
      pParHdr.setSpacingBefore(0);
      pParHdr.setSpacingAfter(6);
      pParHdr.setLineSpacing(1.0);

      const pParName = cellRight.appendParagraph('Name: _______________________________');
      pParName.setFontSize(9.5);
      pParName.setSpacingBefore(2);
      pParName.setSpacingAfter(8);
      pParName.setLineSpacing(1.3);

      const pParPlace = cellRight.appendParagraph('Designation: Principal / Dean / HOD');
      pParPlace.setFontSize(9.5);
      pParPlace.setSpacingBefore(2);
      pParPlace.setSpacingAfter(8);
      pParPlace.setLineSpacing(1.3);

      const pParDate = cellRight.appendParagraph('Institution: ' + (college !== '--' ? college : '______________________________'));
      pParDate.setFontSize(9.5);
      pParDate.setSpacingBefore(2);
      pParDate.setSpacingAfter(6);
      pParDate.setLineSpacing(1.3);

      const pParInstDate = cellRight.appendParagraph('Date & Seal: ______ / ______ / 2026');
      pParInstDate.setFontSize(9.5);
      pParInstDate.setSpacingBefore(2);
      pParInstDate.setSpacingAfter(6);
      pParInstDate.setLineSpacing(1.3);
    } else if (candCat === 'Employee') {
      pParHdr.setText('HR / Corporate Authority');
      pParHdr.setBold(true);
      pParHdr.setFontSize(10);
      pParHdr.setSpacingBefore(0);
      pParHdr.setSpacingAfter(6);
      pParHdr.setLineSpacing(1.0);

      const pParName = cellRight.appendParagraph('Name: _______________________________');
      pParName.setFontSize(9.5);
      pParName.setSpacingBefore(2);
      pParName.setSpacingAfter(8);
      pParName.setLineSpacing(1.3);

      const pParPlace = cellRight.appendParagraph('Designation: HR Head / Reporting Manager');
      pParPlace.setFontSize(9.5);
      pParPlace.setSpacingBefore(2);
      pParPlace.setSpacingAfter(8);
      pParPlace.setLineSpacing(1.3);

      const pParDate = cellRight.appendParagraph('Company: ' + (college !== '--' ? college : '______________________________'));
      pParDate.setFontSize(9.5);
      pParDate.setSpacingBefore(2);
      pParDate.setSpacingAfter(6);
      pParDate.setLineSpacing(1.3);

      const pParEmpDate = cellRight.appendParagraph('Date & Seal: ______ / ______ / 2026');
      pParEmpDate.setFontSize(9.5);
      pParEmpDate.setSpacingBefore(2);
      pParEmpDate.setSpacingAfter(6);
      pParEmpDate.setLineSpacing(1.3);
    } else {
      pParHdr.setText('Parent / Guardian');
      pParHdr.setBold(true);
      pParHdr.setFontSize(10);
      pParHdr.setSpacingBefore(0);
      pParHdr.setSpacingAfter(6);
      pParHdr.setLineSpacing(1.0);

      const pParName = cellRight.appendParagraph('Name: _______________________________');
      pParName.setFontSize(9.5);
      pParName.setSpacingBefore(2);
      pParName.setSpacingAfter(8);
      pParName.setLineSpacing(1.3);

      const pParPlace = cellRight.appendParagraph('Place: ______________________________');
      pParPlace.setFontSize(9.5);
      pParPlace.setSpacingBefore(2);
      pParPlace.setSpacingAfter(8);
      pParPlace.setLineSpacing(1.3);

      const pParDate = cellRight.appendParagraph('Date:  ______ / ______ / 2026');
      pParDate.setFontSize(9.5);
      pParDate.setSpacingBefore(2);
      pParDate.setSpacingAfter(6);
      pParDate.setLineSpacing(1.3);
    }



    // Ample physical signature clearance gap (35pt)

    const pParSigGap = cellRight.appendParagraph('');

    pParSigGap.setSpacingBefore(32);

    pParSigGap.setSpacingAfter(2);



    const pParLine = cellRight.appendParagraph('___________________________________');

    pParLine.setFontSize(9.5);

    pParLine.setSpacingBefore(0);

    pParLine.setSpacingAfter(2);

    pParLine.setLineSpacing(1.0);



    const pParSigTxt = cellRight.appendParagraph(sigLabelRight);

    pParSigTxt.setFontSize(9.5);

    pParSigTxt.setBold(true);

    pParSigTxt.setSpacingBefore(0);

    pParSigTxt.setSpacingAfter(0);

    pParSigTxt.setLineSpacing(1.0);



  } catch(e) {

    Logger.log("Error in formatApplicationFormDeclarationSignatures_: " + e.toString());

  }

}



/**

 * Safely extracts text from any Google Document element without throwing TypeError.

 */

function getElementSafeText_(el) {

  if (!el) return '';

  try {

    const type = el.getType();

    if (type === DocumentApp.ElementType.PARAGRAPH) {

      return el.asParagraph().getText() || '';

    } else if (type === DocumentApp.ElementType.LIST_ITEM) {

      return el.asListItem().getText() || '';

    } else if (type === DocumentApp.ElementType.TABLE) {

      const tbl = el.asTable();

      let str = '';

      const numRows = tbl.getNumRows();

      for (let r = 0; r < numRows; r++) {

        str += tbl.getRow(r).getText() + ' ';

      }

      return str;

    } else if (typeof el.getText === 'function') {

      return el.getText() || '';

    }

  } catch (e) {}

  return '';

}



/**

 * Accurately populates Form-3 Student Internship Attendance Sheet:

 * 1. Generates and inserts complete day-by-day attendance log table (matching Image 3),

 *    calculating every date between InternshipStartDate and InternshipEndDate.

 * 2. Explicitly formats Sundays in bold Red Ink as requested by Note: "Holidays should be marked in Red Ink".

 * 3. Formats all data rows with empty white boxes for manual handwriting / physical ink signing.

 * 4. Formats the Form-3 "Attendance Summary" table with blank value cells for manual ink writing (matching Image 1).

 */

function populateForm3AttendanceSheet_(body, studentData, registrationId, placeholderValues) {

  if (!body || !studentData) return;

  try {

    const regId = registrationId || studentData.RegistrationID || '';
    const candCat = (typeof getCandidateCategory_ === 'function') 
      ? getCandidateCategory_(studentData) 
      : (studentData.CandidateType || studentData.CandidateCategory || 'Student');

    let sheetTitle = 'STUDENTS INTERNSHIP ATTENDANCE SHEET';
    let detailsHeading = 'STUDENT DETAILS';
    let nameRowLabel = 'Student Name';
    let stuSigHeader = 'Student\nSignature';
    let supSigHeader = 'Industrial Supervisor\nSignature';
    let insertIndex = -1;
    let foundNote = null;

    if (candCat === 'Faculty') {
      sheetTitle = 'FACULTY TRAINEE INTERNSHIP ATTENDANCE SHEET';
      detailsHeading = 'FACULTY DETAILS';
      nameRowLabel = 'Faculty Name';
      stuSigHeader = 'Faculty Trainee\nSignature';
      supSigHeader = 'Industrial Supervisor\nSignature';
    } else if (candCat === 'Employee') {
      sheetTitle = 'CORPORATE EMPLOYEE ATTENDANCE SHEET';
      detailsHeading = 'EMPLOYEE DETAILS';
      nameRowLabel = 'Employee Name';
      stuSigHeader = 'Employee\nSignature';
      supSigHeader = 'Industrial Supervisor\nSignature';
    } else if (candCat === 'Apprentice') {
      sheetTitle = 'APPRENTICE INTERN ATTENDANCE SHEET';
      detailsHeading = 'APPRENTICE DETAILS';
      nameRowLabel = 'Apprentice Name';
      stuSigHeader = 'Apprentice\nSignature';
      supSigHeader = 'Industrial Supervisor\nSignature';
    } else {
      stuSigHeader = 'Student\nSignature';
      supSigHeader = 'Industrial Supervisor\nSignature';
    }

    

    // Robust value extractor

    const getVal_ = (obj, ...keys) => {

      if (!obj) return '';

      for (let k of keys) {

        if (obj[k] !== undefined && obj[k] !== null && String(obj[k]).trim() !== '') return String(obj[k]).trim();

      }

      const normKeys = Object.keys(obj);

      for (let k of keys) {

        const cleanK = k.toLowerCase().replace(/[\s_\-]/g, '');

        for (let nk of normKeys) {

          if (nk.toLowerCase().replace(/[\s_\-]/g, '') === cleanK) {

            if (obj[nk] !== undefined && obj[nk] !== null && String(obj[nk]).trim() !== '') return String(obj[nk]).trim();

          }

        }

      }

      return '';

    };



    let startStr = (placeholderValues && (placeholderValues['InternshipStartDate'] || placeholderValues['StartDate'] || placeholderValues['START_DATE'])) ||

                   getVal_(studentData, 'InternshipStartDate', 'Internship Start Date', 'StartDate', 'FormattedStartDate', 'INTERNSHIP_START');

    let endStr = (placeholderValues && (placeholderValues['InternshipEndDate'] || placeholderValues['EndDate'] || placeholderValues['END_DATE'])) ||

                 getVal_(studentData, 'InternshipEndDate', 'Internship End Date', 'EndDate', 'FormattedEndDate', 'INTERNSHIP_END');

    let durStr = (placeholderValues && (placeholderValues['DurationDays'] || placeholderValues['DURATION_DAYS'] || placeholderValues['TotalDays'])) ||

                 getVal_(studentData, 'Calculated Internship Days', 'CalculatedInternshipDays', 'DurationDays', 'Duration', 'Duration (Days)', 'InternshipDays');



    // Fallback: Read directly from document tables if not found

    if (!startStr || !endStr || !durStr) {

      const allTables = body.getTables();

      for (let i = 0; i < allTables.length; i++) {

        const tbl = allTables[i];

        for (let r = 0; r < tbl.getNumRows(); r++) {

          const row = tbl.getRow(r);

          if (row.getNumCells() >= 2) {

            const l = row.getCell(0).getText().trim().toLowerCase();

            const v = row.getCell(1).getText().trim();

            if (l.includes('internship start') && !startStr) startStr = v;

            if (l.includes('internship end') && !endStr) endStr = v;

            if (l.includes('internship days') && !durStr) durStr = v;

          }

        }

      }

    }



    const parseSafeDate = (val) => {

      if (!val) return null;

      if (val instanceof Date && !isNaN(val.getTime())) return new Date(val);

      const s = String(val).trim();

      const dmy = s.match(/^(\d{1,2})[\/\-\.](\d{1,2})[\/\-\.](\d{4})/);

      if (dmy) return new Date(parseInt(dmy[3], 10), parseInt(dmy[2], 10) - 1, parseInt(dmy[1], 10));

      const iso = s.match(/^(\d{4})[\/\-\.](\d{1,2})[\/\-\.](\d{1,2})/);

      if (iso) return new Date(parseInt(iso[1], 10), parseInt(iso[2], 10) - 1, parseInt(iso[3], 10));

      const d = new Date(val);

      return (!isNaN(d.getTime())) ? d : null;

    };



    let start = parseSafeDate(startStr) || new Date();

    let end = parseSafeDate(endStr);

    let duration = parseInt(durStr || 30, 10) || 30;



    if (!end || start > end) {

      end = new Date(start.getFullYear(), start.getMonth(), start.getDate() + duration - 1);

    }



    let current = new Date(start.getFullYear(), start.getMonth(), start.getDate());

    const endBoundary = new Date(end.getFullYear(), end.getMonth(), end.getDate());

    let dayNum = 1;

    const daysArr = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

    const rowsData = [];



    while (current <= endBoundary && dayNum <= 120) {

      const dStr = Utilities.formatDate(current, Session.getScriptTimeZone() || "GMT+5:30", "dd-MM-yyyy");

      const dayStr = daysArr[current.getDay()];



      rowsData.push({

        dStr: dStr,

        dayStr: dayStr

      });



      current.setDate(current.getDate() + 1);

      dayNum++;

    }



    if (rowsData.length === 0) {

      let curFallback = new Date(start.getFullYear(), start.getMonth(), start.getDate());

      for (let fb = 1; fb <= duration; fb++) {

        const dStr = Utilities.formatDate(curFallback, Session.getScriptTimeZone() || "GMT+5:30", "dd-MM-yyyy");

        rowsData.push({

          dStr: dStr,

          dayStr: daysArr[curFallback.getDay()]

        });

        curFallback.setDate(curFallback.getDate() + 1);

      }

    }



    // Exactly 15 days on Form-3 Page 5 matching the official reference attendance sheet

    const colHeaders = ['Day', 'Date', 'Day of\nWeek', 'In Time', 'Out Time', (typeof stuSigHeader !== 'undefined' ? stuSigHeader : 'Student\nSign'), (typeof supSigHeader !== 'undefined' ? supSigHeader : 'Supervisor\nSign')];

    const colWidths = [36, 62, 48, 42, 42, 108, 108]; // Total 443pt: L_dist = 76.5, R_dist = 76.5, diff = 0.0pt (Dead center between margins)



    // Generate attendance log for the FULL duration of the internship (15 days, 30 days, 3 months, etc.)

    const tableValues1 = [colHeaders];

    rowsData.forEach((r, idx) => {

      const isSunday = (r.dayStr.toLowerCase() === 'sunday');

      const dayLabel = isSunday ? 'Sunday' : r.dayStr.substring(0, 3);

      tableValues1.push(['Day ' + (idx + 1), r.dStr, dayLabel, ' ', ' ', ' ', ' ']);

    });



    // Clean up all existing log tables and placeholders from Form-3

    const allDocTables = body.getTables();

    for (let i = allDocTables.length - 1; i >= 0; i--) {

      const t = allDocTables[i];

      if (t.getNumRows() > 0 && t.getRow(0).getNumCells() >= 4) {

        const tText = t.getText().toLowerCase();

        if ((tText.includes('in time') || tText.includes('out time') || tText.includes('student sign') || tText.includes('supervisor sign') || tText.includes('saturday') || tText.includes('sunday') || tText.includes('monday') || tText.includes('tuesday') || tText.includes('wednesday') || tText.includes('thursday') || tText.includes('friday')) && !tText.includes('terms & conditions')) {

          try { t.removeFromParent(); } catch(e) {}

        }

      }

    }



    let attenInsertIdx = -1;
    const attenPattern = '\\{\\{\\s*ATTENDANCE_LOG\\s*\\}\\}';
    let foundAtten = body.findText(attenPattern);
    while (foundAtten) {
      let textElement = foundAtten.getElement().asText();
      let parent = textElement.getParent();
      let startOffset = foundAtten.getStartOffset();
      let endOffset = foundAtten.getEndOffsetInclusive();
      textElement.deleteText(startOffset, endOffset);
      if (parent && parent.getType() === DocumentApp.ElementType.PARAGRAPH) {
        if (parent.getParent() && parent.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {
          if (attenInsertIdx === -1) {
            attenInsertIdx = body.getChildIndex(parent);
          }
          const pTxt = (parent.asParagraph().getText() || '').trim();
          if (pTxt === '' && body.getNumChildren() > 1) {
            parent.removeFromParent();
          }
        }
      }
      foundAtten = body.findText(attenPattern);
    }
    if (attenInsertIdx !== -1) {
      insertIndex = attenInsertIdx;
    }



    let foundPrevHead = body.findText('DAILY\\s+ATTENDANCE\\s+LOG');

    while (foundPrevHead) {

      let eHead = foundPrevHead.getElement();

      while (eHead && eHead.getParent() && eHead.getParent().getType() !== DocumentApp.ElementType.BODY_SECTION) {

        eHead = eHead.getParent();

      }

      if (eHead && eHead.getParent() && eHead.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {

        try { eHead.removeFromParent(); } catch(eh) {}

      }

      foundPrevHead = body.findText('DAILY\\s+ATTENDANCE\\s+LOG');

    }



    // Prominent styling for Form-3 Title block (Form -3, STUDENT INTERNSHIP ATTENDANCE SHEET, GSV, Student Details)

    // NOTE: In Google Apps Script DocumentApp, setFontSize ONLY accepts an INTEGER (e.g. 11, 13, 8), NEVER a float!

    let foundF3 = body.findText('Form\\s*-3');

    if (foundF3) {

      let pF3 = foundF3.getElement();

      while (pF3 && pF3.getType() !== DocumentApp.ElementType.PARAGRAPH && pF3.getParent()) pF3 = pF3.getParent();

      if (pF3 && pF3.getType() === DocumentApp.ElementType.PARAGRAPH) {

        const pf = pF3.asParagraph();

        pf.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

        pf.setSpacingBefore(0);

        pf.setSpacingAfter(2);

        pf.editAsText().setFontFamily('Arial').setFontSize(13).setBold(true).setForegroundColor('#003366');

        // Dynamically replace the title paragraph beneath Form -3 with sheetTitle
        if (pf.getParent() && pf.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {
          const f3Idx = body.getChildIndex(pf);
          for (let di = 1; di <= 3; di++) {
            if (f3Idx + di < body.getNumChildren()) {
              const candP = body.getChild(f3Idx + di);
              if (candP.getType() === DocumentApp.ElementType.PARAGRAPH) {
                const cTxt = candP.asParagraph().getText().trim();
                if (cTxt && (cTxt.toUpperCase().includes('ATTENDANCE') || cTxt.toUpperCase().includes('INTERNSHIP') || cTxt.toUpperCase().includes('SHEET'))) {
                  candP.asParagraph().setText(sheetTitle);
                  candP.asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER);
                  candP.asParagraph().setSpacingBefore(2);
                  candP.asParagraph().setSpacingAfter(3);
                  const t = candP.asParagraph().editAsText();
                  t.setFontFamily('Arial');
                  t.setFontSize(15);
                  t.setBold(true);
                  t.setForegroundColor('#003366');
                  break;
                }
              }
            }
          }
        }
      }
    }



    // Category variables already configured authoritatively at function entry:
    // Faculty: sheetTitle = 'FACULTY TRAINEE INTERNSHIP ATTENDANCE SHEET', detailsHeading = 'FACULTY TRAINEE DETAILS', nameRowLabel = 'Faculty Trainee Name'
    // Student: sheetTitle = 'STUDENTS INTERNSHIP ATTENDANCE SHEET', detailsHeading = 'STUDENT DETAILS', nameRowLabel = 'Student Name'
    // Employee: sheetTitle = 'CORPORATE EMPLOYEE ATTENDANCE SHEET', detailsHeading = 'CORPORATE EMPLOYEE DETAILS', nameRowLabel = 'Corporate Employee Name'
    // Apprentice: sheetTitle = 'APPRENTICE INTERN ATTENDANCE SHEET', detailsHeading = 'APPRENTICE DETAILS', nameRowLabel = 'Intern Trainee Name' 

    try {
      body.replaceText('STUDENT INTERNSHIP ATTENDANCE SHEET', sheetTitle);
      body.replaceText('STUDENTS INTERNSHIP ATTENDANCE SHEET', sheetTitle);
      body.replaceText('Student Internship Attendance Sheet', sheetTitle);
      body.replaceText('Students Internship Attendance Sheet', sheetTitle);
      body.replaceText('FACULTY INTERNSHIP ATTENDANCE SHEET', sheetTitle);
      body.replaceText('FACULTY TRAINEE INTERNSHIP ATTENDANCE SHEET', sheetTitle);
      body.replaceText('CORPORATE EMPLOYEE ATTENDANCE SHEET', sheetTitle);
      body.replaceText('APPRENTICE INTERN ATTENDANCE SHEET', sheetTitle);
      body.replaceText('APPRENTICE INTERNSHIP ATTENDANCE SHEET', sheetTitle);
      body.replaceText('STUDENT DETAILS', detailsHeading);
      body.replaceText('Student Details', detailsHeading);
      body.replaceText('Faculty Details', detailsHeading);
      body.replaceText('Employee Details', detailsHeading);
      body.replaceText('Apprentice Details', detailsHeading);
    } catch(e) {}

    // Update Form-3 Details Table row 1 label and blank unassigned batch & project
    try {
      const allTables = body.getTables();
      for (let t = 0; t < allTables.length; t++) {
        const tbl = allTables[t];
        for (let r = 0; r < tbl.getNumRows(); r++) {
          const row = tbl.getRow(r);
          if (row.getNumCells() >= 2) {
            const c0 = row.getCell(0);
            const c1 = row.getCell(1);
            const t0 = c0.getText().trim();
            if (/^Student\s*Name$/i.test(t0)) {
              c0.setText(nameRowLabel);
              const curN = studentData.FullName || studentData.StudentName || studentData.Name || '';
              if (curN) c1.setText(curN);
            }
            if (/^Batch$/i.test(t0) || /^Batch\s*Name$/i.test(t0)) {
              const bVal = (studentData.Batch && !['batch 1', 'faculty batch 1', 'corporate batch 1', 'apprentice batch 1', 'n/a', '--'].includes(String(studentData.Batch).trim().toLowerCase())) ? String(studentData.Batch).trim() : '';
              c1.setText(bVal);
            }
            if (/^Project\s*Title$/i.test(t0) || /^Project$/i.test(t0)) {
              const pVal = (studentData.ProjectTitle && !['iot & embedded industrial automation', 'applied electronics, iot & embedded systems', 'industrial project', 'n/a', '--'].includes(String(studentData.ProjectTitle).trim().toLowerCase())) ? String(studentData.ProjectTitle).trim() : (studentData.Project && !['industrial project', 'n/a', '--'].includes(String(studentData.Project).trim().toLowerCase()) ? String(studentData.Project).trim() : '');
              c1.setText(pVal);
            }
          }
        }
      }
    } catch(tblLabelErr) {}

    let foundSheetTitle = body.findText(sheetTitle) || body.findText('STUDENT INTERNSHIP ATTENDANCE SHEET');
    if (foundSheetTitle) {
      let pSt = foundSheetTitle.getElement();
      while (pSt && pSt.getType() !== DocumentApp.ElementType.PARAGRAPH && pSt.getParent()) pSt = pSt.getParent();
      if (pSt && pSt.getType() === DocumentApp.ElementType.PARAGRAPH) {
        const ps = pSt.asParagraph();
        ps.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
        ps.setSpacingBefore(2);
        ps.setSpacingAfter(3);
        ps.editAsText().setFontFamily('Arial').setFontSize(15).setBold(true).setForegroundColor('#003366');
      }
    }

    let foundGsvComp = body.findText('G.S.V ELECTRICAL ENTERPRISES');
    while (foundGsvComp) {
      let pGc = foundGsvComp.getElement();
      while (pGc && pGc.getType() !== DocumentApp.ElementType.PARAGRAPH && pGc.getParent()) pGc = pGc.getParent();
      if (pGc && pGc.getType() === DocumentApp.ElementType.PARAGRAPH) {
        const pg = pGc.asParagraph();
        if (pg.getParent() && pg.getParent().getType() === DocumentApp.ElementType.BODY_SECTION && body.getChildIndex(pg) > 10) {
          pg.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
          pg.setSpacingBefore(2);
          pg.setSpacingAfter(3);
          pg.editAsText().setFontFamily('Arial').setFontSize(14).setBold(true).setForegroundColor('#b91c1c');
        }
      }
      foundGsvComp = body.findText('G.S.V ELECTRICAL ENTERPRISES', foundGsvComp);
    }

    let foundDetHead = body.findText(detailsHeading) || body.findText('Student Details');
    while (foundDetHead) {
      let pDh = foundDetHead.getElement();
      while (pDh && pDh.getType() !== DocumentApp.ElementType.PARAGRAPH && pDh.getParent()) pDh = pDh.getParent();
      if (pDh && pDh.getType() === DocumentApp.ElementType.PARAGRAPH) {
        const pd = pDh.asParagraph();
        if (pd.getParent() && pd.getParent().getType() === DocumentApp.ElementType.BODY_SECTION && body.getChildIndex(pd) > 10) {
          pd.setAlignment(DocumentApp.HorizontalAlignment.LEFT);
          pd.setSpacingBefore(5);
          pd.setSpacingAfter(3);
          pd.editAsText().setFontFamily('Arial').setFontSize(12).setBold(true).setForegroundColor('#003366');
        }
      }
      foundDetHead = body.findText(detailsHeading, foundDetHead) || body.findText('Student Details', foundDetHead);
    }



    // Locate insertion point right before Form 3 Note
    foundNote = body.findText('attendance sheet should remain affixed') ||
                body.findText('Attendance sheet should remain affixed') ||
                body.findText('Note: 1. Attendance');

    if (insertIndex === -1 && foundNote) {
      let e = foundNote.getElement();
      while (e && e.getParent() && e.getParent().getType() !== DocumentApp.ElementType.BODY_SECTION) {
        e = e.getParent();
      }
      if (e && e.getParent() && e.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {
        insertIndex = body.getChildIndex(e);
      }
    }



    if (insertIndex === -1) {

      for (let i = 0; i < body.getNumChildren(); i++) {

        const child = body.getChild(i);

        if (child.getType() === DocumentApp.ElementType.TABLE) {

          const tbl = child.asTable();

          if (tbl.getNumRows() > 0 && tbl.getRow(0).getNumCells() >= 2) {

            const t0 = tbl.getRow(0).getCell(0).getText().trim().toLowerCase();

            if (t0.includes('student name') || t0.includes('project title') || t0.includes('internship start') || t0.includes('year')) {

              insertIndex = i + 1;

            }

          }

        }

      }

    }



    // Helper to format attendance log table with wide physical signing cells and shaded header row

    const formatLogTable_ = (targetTable) => {

      if (!targetTable) return;

      try { targetTable.setAttributes({ [DocumentApp.Attribute.HORIZONTAL_ALIGNMENT]: DocumentApp.HorizontalAlignment.CENTER }); } catch(e) {}

      targetTable.setBorderWidth(0.75);

      targetTable.setBorderColor('#000000');



      const numRows = targetTable.getNumRows();

      if (numRows > 0) {

        // Header Row (Row 0) - Professional Navy #003366 with 10.5pt bold white text & 22pt height

        const headerRow = targetTable.getRow(0);

        headerRow.setMinimumHeight(22);

        for (let cIdx = 0; cIdx < headerRow.getNumCells(); cIdx++) {

          try {

            const cell = headerRow.getCell(cIdx);

            if (cIdx < colWidths.length) cell.setWidth(colWidths[cIdx]);

            cell.setPaddingTop(2.0).setPaddingBottom(2.0).setPaddingLeft(2).setPaddingRight(2);

                        const headerBgColor = (candCat === 'Faculty') ? '#991b1b' : '#003366';
            cell.setBackgroundColor(headerBgColor);

            cell.setVerticalAlignment(DocumentApp.VerticalAlignment.MIDDLE);

            for (let pi = 0; pi < cell.getNumChildren(); pi++) {
              const child = cell.getChild(pi);
              if (child.getType() === DocumentApp.ElementType.PARAGRAPH) {
                const cp = child.asParagraph();
                cp.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
                cp.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);
                const t = cp.editAsText();
                t.setFontFamily('Arial');
                t.setFontSize(9.5);
                t.setBold(true);
                t.setForegroundColor('#ffffff');
                const len = cp.getText().length;
                if (len > 0) {
                  t.setFontFamily(0, len - 1, 'Arial');
                  t.setFontSize(0, len - 1, 9.5);
                  t.setBold(0, len - 1, true);
                  t.setForegroundColor(0, len - 1, '#ffffff');
                }
              }
            }
          } catch(hcErr) {

            Logger.log("formatLogTable_ header cell error: " + hcErr);

          }

        }



        // Data Rows (Row 1 to numRows - 1) - Spacious physical signing height (23.5pt) and clear font (10.5pt) ensuring ALL Days 1-15 fit strictly on Page 5

        for (let rIdx = 1; rIdx < numRows; rIdx++) {

          try {

            const row = targetTable.getRow(rIdx);

            row.setMinimumHeight(23.5); // Perfectly tuned: fits Days 1-15 on Page 5 for strictly 6 pages total

            const numCells = row.getNumCells();

            const dayVal = numCells > 2 ? row.getCell(2).getText().trim() : '';

            const isSunday = (dayVal.toLowerCase().includes('sun'));



            for (let cIdx = 0; cIdx < numCells; cIdx++) {

              try {

                const cell = row.getCell(cIdx);

                if (cIdx < colWidths.length) cell.setWidth(colWidths[cIdx]);

                cell.setPaddingTop(1.5).setPaddingBottom(1.5).setPaddingLeft(2.0).setPaddingRight(2.0);

                cell.setVerticalAlignment(DocumentApp.VerticalAlignment.MIDDLE);

                cell.setBackgroundColor('#ffffff');



                if (cell.getNumChildren() > 0 && cell.getChild(0).getType() === DocumentApp.ElementType.PARAGRAPH) {

                  const cp = cell.getChild(0).asParagraph();

                  cp.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

                  cp.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);



                  const t = cp.editAsText();

                  t.setFontFamily('Arial');

                  t.setFontSize(10.5);

                  t.setBold(isSunday);

                  t.setForegroundColor(isSunday ? '#dc2626' : '#000000');



                  const len = cp.getText().length;

                  if (len > 0) {

                    t.setFontFamily(0, len - 1, 'Arial');

                    t.setFontSize(0, len - 1, 10.5);

                    t.setBold(0, len - 1, isSunday);

                    t.setForegroundColor(0, len - 1, isSunday ? '#dc2626' : '#000000');

                  }

                }

              } catch(cellErr) {

                Logger.log("formatLogTable_ cell error: " + cellErr);

              }

            }

          } catch(rowErr) {

            Logger.log("formatLogTable_ row error: " + rowErr);

          }

        }

      }

    };



    // 2. Insert DAILY ATTENDANCE LOG heading paragraph with generous spacing

    let pHeading = null;

    if (insertIndex !== -1) {

      pHeading = body.insertParagraph(insertIndex, 'DAILY ATTENDANCE LOG');

      insertIndex++;

    } else {

      pHeading = body.appendParagraph('DAILY ATTENDANCE LOG');

    }

    pHeading.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

    pHeading.setSpacingBefore(2);

    pHeading.setSpacingAfter(1);

    pHeading.setLineSpacing(1.0);

    const th = pHeading.editAsText();

    th.setFontFamily('Arial');

    th.setFontSize(12);

    th.setBold(true);

    th.setForegroundColor('#003366');



    // Generate attendance log cleanly split across pages if duration > 15 days
    // Days 1 to 15 on Page 5
    const tableValuesPage5 = [colHeaders];
    const tableValuesPage6 = (rowsData.length > 15) ? [colHeaders] : [];

    rowsData.forEach((r, idx) => {
      const isSunday = (r.dayStr.toLowerCase() === 'sunday');
      const dayLabel = isSunday ? 'Sunday' : r.dayStr.substring(0, 3);
      const rowItem = ['Day ' + (idx + 1), r.dStr, dayLabel, ' ', ' ', ' ', ' '];
      if (idx < 15) {
        tableValuesPage5.push(rowItem);
      } else {
        tableValuesPage6.push(rowItem);
      }
    });

    let table1 = (insertIndex !== -1) ? body.insertTable(insertIndex, tableValuesPage5) : body.appendTable(tableValuesPage5);
    formatLogTable_(table1);
    if (insertIndex !== -1) insertIndex++;

    if (tableValuesPage6.length > 1) {
      // Insert page break and continuation heading for Days 16-30 on Page 6
      const pb6 = (insertIndex !== -1) ? body.insertPageBreak(insertIndex) : body.appendPageBreak();
      if (insertIndex !== -1) insertIndex++;

      const pHead6 = (insertIndex !== -1) ? body.insertParagraph(insertIndex, 'DAILY ATTENDANCE LOG (CONTINUED)') : body.appendParagraph('DAILY ATTENDANCE LOG (CONTINUED)');
      if (insertIndex !== -1) insertIndex++;
      pHead6.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
      pHead6.setSpacingBefore(10);
      pHead6.setSpacingAfter(4);
      pHead6.editAsText().setFontFamily('Arial').setFontSize(12).setBold(true).setForegroundColor('#003366');

      let table2 = (insertIndex !== -1) ? body.insertTable(insertIndex, tableValuesPage6) : body.appendTable(tableValuesPage6);
      formatLogTable_(table2);
      if (insertIndex !== -1) insertIndex++;
    }



    // 3. Rebuild Form-3 Student Details Table (8 rows) so it aligns identically to Table 1

    const tablesAfter = body.getTables();

    for (let i = 0; i < tablesAfter.length; i++) {

      const t = tablesAfter[i];

      if (t.getNumRows() > 0 && t.getNumRows() <= 12) {

        let isForm3Table = false;

        for (let r = 0; r < t.getNumRows(); r++) {

          const rowTxt = t.getRow(r).getText().toLowerCase();

          if (rowTxt.includes('batch') || rowTxt.includes('project title') || (rowTxt.includes('internship start') && rowTxt.includes('date'))) {

            isForm3Table = true;

            break;

          }

        }

        if (isForm3Table) {

            const sDetailsData = [];
            const isFaculty = (candCat === 'Faculty');
            const isEmp = (candCat === 'Employee');

            // Build dynamic rows strictly matching User Image 1:
            // Faculty Name / Student Name / Employee Name / Apprentice Name
            sDetailsData.push([nameRowLabel, studentData.FullName || studentData.StudentName || studentData.Name || '']);

            // Registration ID
            sDetailsData.push(['Registration ID', regId]);

            // College Name / Company Name
            const colLabel = isEmp ? 'Company Name' : 'College Name';
            const colVal = isEmp ? (studentData.CompanyName || studentData.CollegeName || '--') : (studentData.CollegeName || studentData.College || '--');
            sDetailsData.push([colLabel, colVal]);

            // Batch (Empty if unassigned, no mock data)
            const rawBatch = studentData.Batch ? String(studentData.Batch).trim() : '';
            const bVal = (rawBatch && !['batch 1', 'faculty batch 1', 'corporate batch 1', 'apprentice batch 1', 'n/a', '--'].includes(rawBatch.toLowerCase())) ? rawBatch : '';
            sDetailsData.push(['Batch', bVal]);

            // Year / Year of Working
            if (isFaculty || isEmp) {
              let yVal = studentData.YearOfWorking || studentData['Teaching / Work Experience'] || studentData.TeachingWorkExperience || studentData.WorkExperience || studentData.TeachingExperience || studentData.Experience || studentData.Year || '';
              if (!yVal || yVal === '--' || yVal === 'N/A') {
                yVal = (studentData.StartDate ? new Date(studentData.StartDate).getFullYear() : '2026');
              }
              let yValClean = String(yVal).replace(/\s*years?\s*of\s*working/gi, '').trim();
              if (yValClean && !/year/i.test(yValClean) && !/^\d{4}$/.test(yValClean)) {
                yValClean += ' Years';
              }
              sDetailsData.push(['Year of Working', yValClean]);
            } else {
              sDetailsData.push(['Year', studentData.Year ? String(studentData.Year).trim() : '']);
            }

            // Designation (Added specifically for Faculty and Corporate Employees)
            if (isFaculty || isEmp) {
              const desigVal = studentData.FacultyDesignation || studentData.Designation || studentData.CompanyDesignation || studentData.Role || (isFaculty ? 'Associate Professor' : 'Engineer');
              sDetailsData.push(['Designation', desigVal]);
            }

            // Project Title (Empty if unassigned, no mock data)
            const rawProj = (studentData.ProjectTitle || studentData.Project || '').trim();
            const pVal = (rawProj && !['iot & embedded industrial automation', 'applied electronics, iot & embedded systems', 'industrial project', 'n/a', '--'].includes(rawProj.toLowerCase())) ? rawProj : '';
            sDetailsData.push(['Project Title', pVal]);

            // Internship Start & End
            sDetailsData.push(['Internship Start', startStr || '']);
            sDetailsData.push(['Internship End', endStr || '']);

            const tIdx = body.getChildIndex(t);

            t.removeFromParent();

            // Ensure heading immediately preceding details table is set to detailsHeading
            if (tIdx > 0) {
              const pPre = body.getChild(tIdx - 1);
              if (pPre && pPre.getType() === DocumentApp.ElementType.PARAGRAPH) {
                pPre.asParagraph().setText(detailsHeading);
                pPre.asParagraph().setAlignment(DocumentApp.HorizontalAlignment.LEFT);
                pPre.asParagraph().setSpacingBefore(5);
                pPre.asParagraph().setSpacingAfter(3);
                pPre.asParagraph().editAsText().setFontFamily('Arial').setFontSize(12).setBold(true).setForegroundColor('#003366');
              }
            }
            const newT0 = body.insertTable(tIdx, sDetailsData);

            try { newT0.setAttributes({ [DocumentApp.Attribute.HORIZONTAL_ALIGNMENT]: DocumentApp.HorizontalAlignment.CENTER }); } catch(e) {}

            newT0.setBorderWidth(0.75);

            newT0.setBorderColor('#000000');

            try {

              newT0.setColumnWidth(0, 150);

              newT0.setColumnWidth(1, 293);

            } catch(cwErr) {}

            for (let r = 0; r < newT0.getNumRows(); r++) {

              const rRow = newT0.getRow(r);

              rRow.setMinimumHeight(13.5); // Compact row height to allow Days 1-15 on Page 5

              const c0 = rRow.getCell(0);

              const c1 = rRow.getCell(1);

              c0.setWidth(150);

              c1.setWidth(293); // Total 443pt: L_dist = 76.5, R_dist = 76.5, diff = 0.0pt (Dead center between margins)

              c0.setPaddingTop(1.5).setPaddingBottom(1.5).setPaddingLeft(5).setPaddingRight(5);

              c1.setPaddingTop(1.5).setPaddingBottom(1.5).setPaddingLeft(5).setPaddingRight(5);

              c0.setVerticalAlignment(DocumentApp.VerticalAlignment.MIDDLE);

              c1.setVerticalAlignment(DocumentApp.VerticalAlignment.MIDDLE);

              c0.setBackgroundColor('#ffffff');

              c1.setBackgroundColor('#ffffff');

              if (c0.getNumChildren() > 0 && c0.getChild(0).getType() === DocumentApp.ElementType.PARAGRAPH) {

                const p0 = c0.getChild(0).asParagraph();

                p0.setAlignment(DocumentApp.HorizontalAlignment.LEFT);

                p0.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);

                const t0Text = p0.editAsText();

                t0Text.setFontFamily('Arial').setFontSize(9.5).setBold(true).setForegroundColor('#000000');

                const l0 = p0.getText().length;

                if (l0 > 0) t0Text.setFontFamily(0, l0 - 1, 'Arial').setFontSize(0, l0 - 1, 9.5).setBold(0, l0 - 1, true).setForegroundColor(0, l0 - 1, '#000000');

              }

              if (c1.getNumChildren() > 0 && c1.getChild(0).getType() === DocumentApp.ElementType.PARAGRAPH) {

                const p1 = c1.getChild(0).asParagraph();

                p1.setAlignment(DocumentApp.HorizontalAlignment.LEFT);

                p1.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);

                const t1Text = p1.editAsText();

                t1Text.setFontFamily('Arial').setFontSize(9.5).setBold(true).setForegroundColor('#000000');

                const l1 = p1.getText().length;

                if (l1 > 0) t1Text.setFontFamily(0, l1 - 1, 'Arial').setFontSize(0, l1 - 1, 9.5).setBold(0, l1 - 1, true).setForegroundColor(0, l1 - 1, '#000000');

              }

            }

            break;

          }

        }

      }



    // 4. Format Note paragraph compactly

    if (foundNote) {

      let pNote = foundNote.getElement();

      while (pNote && pNote.getType() !== DocumentApp.ElementType.PARAGRAPH && pNote.getParent()) {

        pNote = pNote.getParent();

      }

      if (pNote && pNote.getType() === DocumentApp.ElementType.PARAGRAPH) {

        const pn = pNote.asParagraph();

        pn.setSpacingBefore(0);

        pn.setSpacingAfter(3);

        pn.setLineSpacing(1.0);

        const tn = pn.editAsText();

        tn.setFontFamily('Arial').setFontSize(8);

        const ln = pn.getText().length;

        if (ln > 0) tn.setFontFamily(0, ln - 1, 'Arial').setFontSize(0, ln - 1, 8);

      }

    }



    // 5. Populate and format ALL Form-3 Attendance Summary Tables compactly

    const summaryLabelsRegex = /Total\s*Days\s*Present|Total\s*Days\s*Absent|Work\s*From\s*Home|On\s*Duty|\bOD\b|Over\s*Time|\bOT\b|Extra\s*Hours|Number\s*of\s*Leaves|Medical\s*Leaves|Weekly\s*Off|Total\s*Days/i;



    tablesAfter.forEach(summaryTable => {

      // Must strictly be the Form-3 Attendance Summary table (contains 'Total Days Present' or 'Total Days Absent')

      const sFullText = summaryTable.getText();

      if (!/Total\s*Days\s*Present|Total\s*Days\s*Absent/i.test(sFullText)) return;

      let isSummaryTable = true;



      if (isSummaryTable) {

        // Ensure Over Time (OT) row exists before Total Days

        let hasOT = false;

        let totalDaysIdx = -1;

        for (let r = 0; r < summaryTable.getNumRows(); r++) {

          const rTxt = summaryTable.getRow(r).getCell(0).getText().trim();

          if (/\bOver\s*Time\b|\bOT\b|\bExtra\s*Hours\b/i.test(rTxt)) {

            hasOT = true;

            break;

          }

          if (/Total\s*Days\b/i.test(rTxt) && !/Present|Absent/i.test(rTxt)) {

            totalDaysIdx = r;

          }

        }

        // Ensure the summary table has all 8 canonical rows matching user reference:
        // 1. Total Days Present
        // 2. Total Days Absent
        // 3. Work From Home
        // 4. Number of Leaves
        // 5. Medical Leaves
        // 6. Weekly Off (Sundays)
        // 7. Over Time (OT) / Extra Hours
        // 8. Total Days
        const canonicalSummaryRows = [
          'Total Days Present',
          'Total Days Absent',
          'Work From Home',
          'Number of Leaves',
          'Medical Leaves',
          'Weekly Off (Sundays)',
          'Over Time (OT) / Extra Hours',
          'Total Days'
        ];

        // Check which canonical rows currently exist
        const existingRowLabels = [];
        for (let r = 0; r < summaryTable.getNumRows(); r++) {
          existingRowLabels.push(summaryTable.getRow(r).getCell(0).getText().trim());
        }

        // Check if Over Time row exists
        let hasOTRow = false;
        let totalDaysRowIdx = -1;
        for (let r = 0; r < summaryTable.getNumRows(); r++) {
          const rText = summaryTable.getRow(r).getCell(0).getText().trim();
          if (/Over\s*Time|\bOT\b|Extra\s*Hours/i.test(rText)) {
            hasOTRow = true;
          }
          if (/Total\s*Days/i.test(rText) && !/Present|Absent/i.test(rText)) {
            totalDaysRowIdx = r;
          }
        }

        // Insert Over Time row before Total Days if missing
        if (!hasOTRow) {
          const insertAt = (totalDaysRowIdx !== -1) ? totalDaysRowIdx : (summaryTable.getNumRows() > 0 ? summaryTable.getNumRows() - 1 : 0);
          try {
            const otRow = summaryTable.insertTableRow(insertAt);
            const c0 = otRow.appendTableCell();
            c0.setText('Over Time (OT) / Extra Hours');
            const c1 = otRow.appendTableCell();
            c1.setText('');
          } catch(otErr) {
            Logger.log('Error inserting OT row: ' + otErr);
          }
        }

        // Update Weekly Off label to Weekly Off (Sundays) matching Image 9
        for (let r = 0; r < summaryTable.getNumRows(); r++) {
          const c0 = summaryTable.getRow(r).getCell(0);
          const t0 = c0.getText().trim();
          if (/^Weekly\s*Off$/i.test(t0)) {
            c0.setText('Weekly Off (Sundays)');
          }
        }

        try { summaryTable.setAttributes({ [DocumentApp.Attribute.HORIZONTAL_ALIGNMENT]: DocumentApp.HorizontalAlignment.CENTER }); } catch(e) {}

        summaryTable.setBorderWidth(0.75);

        summaryTable.setBorderColor('#000000');



        for (let r = 0; r < summaryTable.getNumRows(); r++) {

          const row = summaryTable.getRow(r);

          if (row.getNumCells() >= 2) {

            row.setMinimumHeight(25.0);

            const cLabel = row.getCell(0);

            const cVal = row.getCell(1);

            const lTxt = cLabel.getText().trim();



            if (summaryLabelsRegex.test(lTxt)) {

              cLabel.setWidth(200);

              cVal.setWidth(114);



              cLabel.setPaddingTop(2.0).setPaddingBottom(2.0).setPaddingLeft(6).setPaddingRight(6);

              cVal.setPaddingTop(2.0).setPaddingBottom(2.0).setPaddingLeft(6).setPaddingRight(6);

              cLabel.setVerticalAlignment(DocumentApp.VerticalAlignment.MIDDLE);

              cVal.setVerticalAlignment(DocumentApp.VerticalAlignment.MIDDLE);



              cLabel.setBackgroundColor('#ffffff');

              cVal.setBackgroundColor('#ffffff');



              if (/Weekly\s*Off/i.test(lTxt) && !/Sunday/i.test(lTxt)) {

                cLabel.setText('Weekly Off (Sundays)');

              }



              if (cLabel.getNumChildren() > 0 && cLabel.getChild(0).getType() === DocumentApp.ElementType.PARAGRAPH) {

                const cpLabel = cLabel.getChild(0).asParagraph();

                cpLabel.setAlignment(DocumentApp.HorizontalAlignment.LEFT);

                cpLabel.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);

                const tLabel = cpLabel.editAsText();

                tLabel.setFontFamily('Arial').setFontSize(9).setBold(true).setForegroundColor('#003366');

                const ll = cpLabel.getText().length;

                if (ll > 0) tLabel.setFontFamily(0, ll - 1, 'Arial').setFontSize(0, ll - 1, 9).setBold(0, ll - 1, true).setForegroundColor(0, ll - 1, '#003366');

              }



              // Blank box for supervisor manual ink writing (no '0 Days')

              cVal.setText('');

              if (cVal.getNumChildren() > 0 && cVal.getChild(0).getType() === DocumentApp.ElementType.PARAGRAPH) {

                const cpVal = cVal.getChild(0).asParagraph();

                cpVal.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

                cpVal.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);

              }

            }

          }

        }

      }

    });



    // 6. Style Note: "Absent should be marked as A in Red Ink" in Red

    let foundNoteStyle = body.findText('Absent should be marked as A in Red Ink');

    if (foundNoteStyle) {

      const el = foundNoteStyle.getElement().asText();

      const fullTxt = el.getText();

      const aIdx = fullTxt.indexOf('A in Red Ink');

      if (aIdx !== -1) {

        el.setForegroundColor(aIdx, aIdx + 'A in Red Ink'.length - 1, '#dc2626');

        el.setBold(aIdx, aIdx + 'A in Red Ink'.length - 1, true);

      }

      const pIdx = fullTxt.indexOf("'P'");

      if (pIdx !== -1) {

        el.setForegroundColor(pIdx, pIdx + 2, '#2563eb');

        el.setBold(pIdx, pIdx + 2, true);

      }

    }

  } catch (err) {

    Logger.log("populateForm3AttendanceSheet_ error: " + err.toString());

  }

}

/**
 * Formats Form-3 Attendance Summary table on Page 6:
 * - Guarantees all 8 canonical rows including 'Weekly Off (Sundays)' and 'Over Time (OT) / Extra Hours'.
 * - Sets standard 200pt / 114pt widths and 22pt row heights matching Image 9.
 */
function formatForm3AttendanceSummaryTable_(body) {
  if (!body) return;
  try {
    const tables = body.getTables();
    for (let i = 0; i < tables.length; i++) {
      const t = tables[i];
      const txt = t.getText();
      if (/Total\s*Days\s*Present|Total\s*Days\s*Absent/i.test(txt)) {
        // Find Total Days row index
        let totalDaysIdx = -1;
        let hasOT = false;
        for (let r = 0; r < t.getNumRows(); r++) {
          const label = t.getRow(r).getCell(0).getText().trim();
          if (/Over\s*Time|\bOT\b|Extra\s*Hours/i.test(label)) hasOT = true;
          if (/Total\s*Days/i.test(label) && !/Present|Absent/i.test(label)) totalDaysIdx = r;
          if (/^Weekly\s*Off$/i.test(label)) {
            t.getRow(r).getCell(0).setText('Weekly Off (Sundays)');
          }
        }
        if (!hasOT && totalDaysIdx !== -1) {
          try {
            const otRow = t.insertTableRow(totalDaysIdx);
            otRow.appendTableCell('Over Time (OT) / Extra Hours');
            otRow.appendTableCell('');
          } catch(eIns) {
            try {
              const otRow = t.appendTableRow();
              otRow.appendTableCell('Over Time (OT) / Extra Hours');
              otRow.appendTableCell('');
            } catch(eApp) {}
          }
        }
        // Apply clean styling
        try { t.setAttributes({ [DocumentApp.Attribute.HORIZONTAL_ALIGNMENT]: DocumentApp.HorizontalAlignment.CENTER }); } catch(e) {}
        t.setBorderWidth(0.75);
        t.setBorderColor('#000000');
        for (let r = 0; r < t.getNumRows(); r++) {
          const row = t.getRow(r);
          if (row.getNumCells() >= 2) {
            row.setMinimumHeight(22.0);
            const c0 = row.getCell(0);
            const c1 = row.getCell(1);
            c0.setWidth(200);
            c1.setWidth(114);
            c0.setPaddingTop(2).setPaddingBottom(2).setPaddingLeft(6).setPaddingRight(6);
            c1.setPaddingTop(2).setPaddingBottom(2).setPaddingLeft(6).setPaddingRight(6);
            c0.setVerticalAlignment(DocumentApp.VerticalAlignment.MIDDLE);
            c1.setVerticalAlignment(DocumentApp.VerticalAlignment.MIDDLE);
            c0.setBackgroundColor('#ffffff');
            c1.setBackgroundColor('#ffffff');
            if (c0.getNumChildren() > 0 && c0.getChild(0).getType() === DocumentApp.ElementType.PARAGRAPH) {
              const p0 = c0.getChild(0).asParagraph();
              p0.setAlignment(DocumentApp.HorizontalAlignment.LEFT);
              p0.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);
              p0.editAsText().setFontFamily('Arial').setFontSize(9.5).setBold(true).setForegroundColor('#003366');
            }
          }
        }
      }
    }
  } catch(err) {
    Logger.log('formatForm3AttendanceSummaryTable_ error: ' + err);
  }
}

function ensureApplicationFormPagination_(body) {

  if (!body) return;

  try {

    // Set 28pt top and bottom margins for strict 6-page document geometry

    try {

      body.setMarginTop(28);

      body.setMarginBottom(28);

      body.setMarginLeft(56.75);

      body.setMarginRight(56.75);

    } catch(mErr) {}

    // 1. Remove all empty spacer paragraphs throughout the body section

    const numChildrenInitial = body.getNumChildren();

    for (let i = numChildrenInitial - 1; i >= 0; i--) {

      try {

        const el = body.getChild(i);

        if (el.getType() === DocumentApp.ElementType.PARAGRAPH) {

          const p = el.asParagraph();

          const txt = (p.getText() || '').trim();

          let hasInlineImages = false;

          for (let c = 0; c < p.getNumChildren(); c++) {

            if (p.getChild(c).getType() === DocumentApp.ElementType.INLINE_IMAGE) {

              hasInlineImages = true;

              break;

            }

          }

          if (txt === '' && !hasInlineImages && p.getPositionedImages().length === 0) {

            if (p.getParent().getType() === DocumentApp.ElementType.BODY_SECTION && body.getNumChildren() > 1) {

              p.removeFromParent();

            }

          }

        }

      } catch(e) {}

    }



    // 2. Locate headings safely without throwing TypeError on tables

    let elTerms = null;

    let foundTerms = body.findText('TERMS & CONDITIONS') || body.findText('TERMS') || body.findText('CONDITIONS');

    if (foundTerms) {

      let e = foundTerms.getElement();

      while (e && e.getParent() && e.getParent().getType() !== DocumentApp.ElementType.BODY_SECTION) {

        e = e.getParent();

      }

      elTerms = e;

      if (foundTerms.getElement().getType() === DocumentApp.ElementType.TEXT) {

        let ep = foundTerms.getElement().getParent();

        if (ep && ep.getType() === DocumentApp.ElementType.PARAGRAPH) {

          const pt = ep.asParagraph();

          pt.setSpacingBefore(24);   // Spacious 24pt separation between table rows and TERMS & CONDITIONS!

          pt.setSpacingAfter(8);

          pt.editAsText().setFontFamily('Arial').setFontSize(11).setBold(true).setForegroundColor('#003366');

        }

      }

    }



    let elForm2 = null;

    let foundForm2 = body.findText('Form-2') || body.findText('Form -2') || body.findText('STUDENT & PARENT SELF DECLARATION');

    if (foundForm2) {

      let e = foundForm2.getElement();

      while (e && e.getParent() && e.getParent().getType() !== DocumentApp.ElementType.BODY_SECTION) {

        e = e.getParent();

      }

      elForm2 = e;

    }



    let elForm3 = null;

    let foundForm3 = body.findText('Form -3') || body.findText('Form-3') || body.findText('STUDENT INTERNSHIP ATTENDANCE SHEET');

    if (foundForm3) {

      let e = foundForm3.getElement();

      while (e && e.getParent() && e.getParent().getType() !== DocumentApp.ElementType.BODY_SECTION) {

        e = e.getParent();

      }

      elForm3 = e;

    }



    // Form-3 Page 6 starts strictly with the Note paragraph

    let elPage6Start = null;

    let foundNote = body.findText('attendance sheet should remain affixed') ||

                    body.findText('Attendance sheet should remain affixed') ||

                    body.findText('Note: 1. Attendance');

    if (foundNote) {

      let e = foundNote.getElement();

      while (e && e.getParent() && e.getParent().getType() !== DocumentApp.ElementType.BODY_SECTION) {

        e = e.getParent();

      }

      elPage6Start = e;

      if (elPage6Start && elPage6Start.getParent() && elPage6Start.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {

        const p6Idx = body.getChildIndex(elPage6Start);

        for (let k = p6Idx - 1; k >= 0; k--) {

          const prevChild = body.getChild(k);

          if (prevChild.getType() === DocumentApp.ElementType.PARAGRAPH) {

            const txt = (prevChild.asParagraph().getText() || '').trim();

            if (txt === '' && prevChild.asParagraph().getPositionedImages().length === 0) {

              try { prevChild.removeFromParent(); } catch(e) {}

              continue;

            }

          }

          break;

        }

      }

    }



    // Form-2 Page 4 starts strictly with the 2-column signature table

    let elSigTable = null;

    let foundStuSig = foundForm2 ? (
      body.findText('Student\\s*Signature', foundForm2) ||
      body.findText('Faculty\\s*(?:Applicant|Member)?\\s*Signature', foundForm2) ||
      body.findText('Head\\s*of\\s*Institution', foundForm2) ||
      body.findText('Corporate\\s*Applicant\\s*Signature', foundForm2) ||
      body.findText('Apprentice\\s*Trainee\\s*Signature', foundForm2)
    ) : null;

    if (foundStuSig) {

      let e = foundStuSig.getElement();

      while (e && e.getParent() && e.getParent().getType() !== DocumentApp.ElementType.BODY_SECTION) {

        e = e.getParent();

      }

      if (e && e.getParent() && e.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {

        elSigTable = e;

      }

    }



    // Locate Form-3 Attendance Summary table heading for compact spacing

    let foundSummary = body.findText('Attendance\\s*Summary');

    if (foundSummary) {

      let eSumP = foundSummary.getElement();

      while (eSumP && eSumP.getType() !== DocumentApp.ElementType.PARAGRAPH && eSumP.getParent()) {

        eSumP = eSumP.getParent();

      }

      if (eSumP && eSumP.getType() === DocumentApp.ElementType.PARAGRAPH) {

        const pSum = eSumP.asParagraph();

        pSum.setSpacingBefore(3);

        pSum.setSpacingAfter(1);

      }

    }



    // 3. Remove all existing PAGE_BREAK elements throughout the body to place exact ones

    for (let i = body.getNumChildren() - 1; i >= 0; i--) {

      try {

        const el = body.getChild(i);

        if (el.getType() === DocumentApp.ElementType.PAGE_BREAK) {

          el.removeFromParent();

        } else if (el.getType() === DocumentApp.ElementType.PARAGRAPH) {

          const p = el.asParagraph();

          for (let c = p.getNumChildren() - 1; c >= 0; c--) {

            if (p.getChild(c).getType() === DocumentApp.ElementType.PAGE_BREAK) {

              p.getChild(c).removeFromParent();

            }

          }

        }

      } catch(e) {}

    }



    // 4. Insert clean PAGE_BREAKs in descending child-index order (prevents index shifts!)

    // Ensures:

    // Page 1: Form-1 Application & Student Details (Rows 0-20)

    // Page 2: Form-1 Table continuation (Rows 21-23), Terms and Conditions, Signatures

    // Page 3: Form-2 Self Declaration Letter

    // Page 4: Form-2 Student & Parent Details and Signatures

    // Page 5: Form-3 Header, Student Details table, DAILY ATTENDANCE LOG, Table 1 (Days 1-15)

    // Page 6: Form-3 Note, Attendance Summary table, Supervisor Seal & Signature

    // TOTAL: EXACTLY 6 PAGES!

    // Locate Form-3 Continued Attendance Log for Days 16-30 (Page 6 for 30-day internships)
    let elContHead = null;
    let foundCont = body.findText('CONTINUED');
    if (foundCont) {
      let e = foundCont.getElement();
      while (e && e.getParent() && e.getParent().getType() !== DocumentApp.ElementType.BODY_SECTION) {
        e = e.getParent();
      }
      if (e && e.getParent() && e.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {
        elContHead = e;
      }
    }

    const breakElements = [];

    if (elPage6Start && elPage6Start.getParent() && elPage6Start.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {

      breakElements.push(elPage6Start);

    }

    if (elContHead && elContHead.getParent() && elContHead.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {

      breakElements.push(elContHead);

    }

    if (elForm3 && elForm3.getParent() && elForm3.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {

      breakElements.push(elForm3);

    }

    if (elSigTable && elSigTable.getParent() && elSigTable.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {

      breakElements.push(elSigTable);

    }

    if (elForm2 && elForm2.getParent() && elForm2.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {

      breakElements.push(elForm2);

    }



    // Sort descending by index in body

    breakElements.sort((a, b) => body.getChildIndex(b) - body.getChildIndex(a));

    breakElements.forEach(el => {

      const idx = body.getChildIndex(el);

      if (idx > 0) {

        body.insertPageBreak(idx);

      }

    });



        // Page 6 Attendance Summary & Supervisor Signature spacious handwriting gap

    let foundSummaryHead = body.findText('Attendance\\s*Summary');

    if (foundSummaryHead) {

      let eSum = foundSummaryHead.getElement();

      while (eSum && eSum.getType() !== DocumentApp.ElementType.PARAGRAPH && eSum.getParent()) eSum = eSum.getParent();

      if (eSum && eSum.getType() === DocumentApp.ElementType.PARAGRAPH) {

        const ps = eSum.asParagraph();

        ps.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

        ps.setSpacingBefore(18);

        ps.setSpacingAfter(10);

        ps.editAsText().setFontFamily('Arial').setFontSize(11).setBold(true).setForegroundColor('#003366');

      }

    }



    let foundSupSig = body.findText('Signature\\s*of\\s*Company\\s*Internship\\s*Supervisor');

    if (foundSupSig) {

      let eSig = foundSupSig.getElement();

      while (eSig && eSig.getType() !== DocumentApp.ElementType.PARAGRAPH && eSig.getParent()) {

        eSig = eSig.getParent();

      }

      if (eSig && eSig.getType() === DocumentApp.ElementType.PARAGRAPH) {

        const pSig = eSig.asParagraph();

        pSig.setSpacingBefore(35);   // Generous 35pt gap for official company stamp and signature

        pSig.setSpacingAfter(8);

        pSig.editAsText().setFontFamily('Arial').setFontSize(10).setBold(true);

      }

    }



    let foundNameContact = body.findText('Contact\\s*No');

    if (foundNameContact) {

      let eNc = foundNameContact.getElement();

      while (eNc && eNc.getType() !== DocumentApp.ElementType.PARAGRAPH && eNc.getParent()) eNc = eNc.getParent();

      if (eNc && eNc.getType() === DocumentApp.ElementType.PARAGRAPH) {

        const pnc = eNc.asParagraph();

        pnc.setSpacingBefore(18);

        pnc.setLineSpacing(1.3);

      }

    }



  } catch (err) {

    Logger.log("ensureApplicationFormPagination_ error: " + err.toString());

  }

}



function insertBarcodeUnderRegistrationId_(body, barcodeBlob, regId) {

  if (!body || !barcodeBlob) return;

  

  // 1. Try placeholder replacement first if {{BARCODE}} tag exists

  const barcodeTags = ['BARCODE', 'Barcode', 'barcode', 'REG_BARCODE', 'RegBarcode', 'REGISTRATION_BARCODE', 'BAR_CODE', 'BarCode', 'bar_code', 'STUDENT_BARCODE'];

  let replaced = false;

  barcodeTags.forEach(tag => {

    const pattern = '\\{\\{\\s*' + tag + '\\s*\\}\\}';

    if (body.findText(pattern)) {

      replacePlaceholderWithInlineImage_(body, tag, barcodeBlob, 175, 26);

      replaced = true;

    }

  });

  if (replaced) return;



  // 2. Locate the TableCell containing Registration ID and insert barcode right under it

  try {

    const cleanId = String(regId).trim();

    const searchPatterns = [

      cleanId.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&'),

      'Registration ID'

    ];

    for (let pattern of searchPatterns) {

      let found = body.findText(pattern);

      if (found) {

        let el = found.getElement();

        while (el && el.getType() !== DocumentApp.ElementType.TABLE_CELL && el.getParent()) {

          el = el.getParent();

        }

        if (el && el.getType() === DocumentApp.ElementType.TABLE_CELL) {

          const cell = el.asTableCell();

          for (let cIdx = 0; cIdx < cell.getNumChildren(); cIdx++) {

            const child = cell.getChild(cIdx);

            if (child.getType() === DocumentApp.ElementType.PARAGRAPH) {

              const pText = child.asParagraph().getText();

              if (pText.includes('Registration ID') || pText.includes(cleanId)) {

                const newP = cell.insertParagraph(cIdx + 1, '');

                newP.setSpacingBefore(2);

                newP.setSpacingAfter(4);

                newP.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

                const img = newP.appendInlineImage(barcodeBlob);

                if (img) {

                  img.setWidth(170);

                  img.setHeight(26);

                }

                return;

              }

            }

          }

        }

      }

    }

  } catch (err) {

    Logger.log("insertBarcodeUnderRegistrationId_ error: " + err);

  }

}



function replacePlaceholderWithInlineImage_(body, tag, imageBlob, widthPt, heightPt) {

  if (!body) return;

  const escaped = String(tag).replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');

  const patterns = [

    '\\{\\{\\s*' + escaped + '\\s*\\}\\}',

    '\\{\\s*' + escaped + '\\s*\\}'

  ];

  

  patterns.forEach(pattern => {

    let found = body.findText(pattern);

    let loopCount = 0;

    while (found && loopCount < 50) {

      loopCount++;

      try {

        const textElement = found.getElement().asText();

        const parent = textElement.getParent();

        const startOffset = found.getStartOffset();

        const endOffset = found.getEndOffsetInclusive();

        

        // Clear any background highlight color on the placeholder span

        try {

          textElement.setBackgroundColor(startOffset, endOffset, null);

        } catch(bgErr) { }



        if (imageBlob) {

          try {

            textElement.deleteText(startOffset, endOffset);

            let p = null;

            if (parent.getType() === DocumentApp.ElementType.PARAGRAPH) {

              p = parent.asParagraph();

            } else if (parent.getType() === DocumentApp.ElementType.TABLE_CELL) {

              p = parent.asTableCell();

              if (p.getNumChildren() > 0 && p.getChild(0).getType() === DocumentApp.ElementType.PARAGRAPH) {

                p = p.getChild(0).asParagraph();

              } else {

                p = p.appendParagraph('');

              }

            } else if (parent.getType() === DocumentApp.ElementType.BODY_SECTION || parent.getType() === DocumentApp.ElementType.HEADER_SECTION || parent.getType() === DocumentApp.ElementType.FOOTER_SECTION) {

              p = parent.appendParagraph('');

            }



            if (p) {

              const textLen = p.getText().length;

              const insertIdx = Math.min(Math.max(0, startOffset), textLen);

              let img = null;

              try {

                img = p.insertInlineImage(insertIdx, imageBlob);

              } catch (insErr) {

                img = p.appendInlineImage(imageBlob);

              }

              if (img) {

                if (widthPt && widthPt > 0) img.setWidth(widthPt);

                if (heightPt && heightPt > 0) img.setHeight(heightPt);

              }

            }

          } catch (e) {

            Logger.log('Error inserting inline image for ' + tag + ': ' + e.toString());

          }

        } else {

          // No image (or disabled) -> cleanly delete the placeholder text

          textElement.deleteText(startOffset, endOffset);

        }

      } catch (err) {

        Logger.log('Error in replacePlaceholderWithInlineImage_ for ' + tag + ': ' + err.toString());

        break;

      }

      found = body.findText(pattern);

    }

  });

}



function generateDocumentAndMail(docType, registrationId, sendEmailOption = false, isAdmin = false, options = {}) {

  var certNumber = ''; var watermarkLogs = [];

  try {

    if (typeof options !== 'object' || options === null) {

      options = {};

    }

    const isPreview = (options.isPreview === true);

    const certTemplate = options.certTemplate || options.certificateTemplate || 'T2';

    const isT2 = (certTemplate === 'T2' || certTemplate === 't2' || certTemplate === 'template2' || certTemplate === 'Template2' || docType === 'internshipCertificate_T2');

    const isViewExisting = (options.viewExisting === true);

    const forceNew = !isViewExisting && (options.forceNew === true || isPreview || (options.manualAttendedDays !== undefined && options.manualAttendedDays !== null && String(options.manualAttendedDays).trim() !== ''));



    // === FIX: MAP studentAppForm to applicationForm ===

    if (docType === 'studentAppForm') {

      docType = 'applicationForm';

    }

    if (docType === 'studentPortfolio' || docType === 'portfolio') {

      docType = 'studentCV';

    }



    const isCertificateDoc = (docType === 'internshipCertificate' || docType === 'completionCertificate' || docType === 'certificate' || /cert/i.test(docType));

    const isAttendanceOrCertDoc = (isCertificateDoc || docType === 'attendanceDocument' || docType === 'consolidatedAttendance');



    const studentData = (options && (options.studentData || options.customStudentData)) ? (options.studentData || options.customStudentData) : getStudentDataForDoc(registrationId);

    if (!studentData) return { status: 'error', message: `Student ${registrationId} not found.` };

    // STRICT RULE: Pending students cannot generate documents or certificates
    const stuGenStatus = String(studentData.ApplicationStatus || studentData.Status || '').trim().toLowerCase();
    if (stuGenStatus.includes('pending')) {
      return { status: 'error', message: 'Candidate application status is Pending. Documents and certificates can only be generated once the candidate is Approved.' };
    }



    // === REUSE EXISTING GENERATED FILE IF IT EXISTS, IS VALID, AND NOT FORCED NEW / PREVIEW ===

    if (!forceNew && !isPreview) {

      const existingDoc = getExistingDocFileId(registrationId, docType);

      if (existingDoc) {

        Logger.log(`Found existing ${docType} for ${registrationId}. Reusing: ${existingDoc.url}`);

        const finalPdf = DriveApp.getFileById(existingDoc.fileId);



        const isCertDoc = (docType === 'internshipCertificate' || docType === 'completionCertificate');

        const stuAppStatus = String(studentData.ApplicationStatus || studentData.Status || '').trim().toLowerCase();

        if (sendEmailOption && studentData.GmailID) {

          if (isCertDoc && stuAppStatus !== 'completed') {

            Logger.log(`Skipping certificate email on existing doc: Student ${registrationId} status '${stuAppStatus}' is not Completed.`);

          } else {

            let emailType = 'confirmationLetter';

            if (docType === 'offerLetter') emailType = 'offerLetterNotify';

            else if (docType === 'internshipCertificate' || docType === 'completionCertificate') emailType = 'internshipCompletedNotify';



          const templates = getEmailTemplates(); // Fetch from sheet

          let subject = `Document: ${docType} - ${studentData.CompanyName}`;

          let emailBody = '';



          // Determine certNumber for placeholder values

          certNumber = '';

          if (docType === 'internshipCertificate' || docType === 'completionCertificate') {

            const certSheet = getSheet(SHEET_NAMES.CERTIFICATE_DATA);

            if (certSheet) {

              const cData = certSheet.getDataRange().getValues();

              const cRegCol = cData[0].indexOf("StudentRegistrationID");

              const cNumCol = cData[0].indexOf("CertificateNumber");

              if (cRegCol !== -1 && cNumCol !== -1) {

                for (let i = 1; i < cData.length; i++) {

                  if (String(cData[i][cRegCol]).toUpperCase() === registrationId.toUpperCase()) {

                    certNumber = cData[i][cNumCol];

                    break;

                  }

                }

              }

            }

          }



          if (templates && templates[emailType]) {

            subject = templates[emailType].subject;

            emailBody = templates[emailType].content;



            const emailReplacements = {

              '{{StudentName}}': studentData.FullName,

              '{{FullName}}': studentData.FullName,

              '{{RegistrationID}}': studentData.RegistrationID,

              '{{InternshipStartDate}}': studentData.FormattedStartDate,

              '{{InternshipEndDate}}': studentData.FormattedEndDate,

              '{{DurationDays}}': studentData.DurationDays,

              '{{CompanyName}}': studentData.CompanyName,

              '{{CollegeName}}': studentData.CollegeName,

              '{{Department}}': studentData.Department,

              '{{CertificateNumber}}': certNumber,

              '{{IssuedDate}}': studentData.TodayDate,

              '{{studentName}}': studentData.FullName,

              '{{fullName}}': studentData.FullName,

              '{{regId}}': studentData.RegistrationID,

              '{{registrationId}}': studentData.RegistrationID,

              '{{startDate}}': studentData.FormattedStartDate,

              '{{endDate}}': studentData.FormattedEndDate,

              '{{durationDays}}': studentData.DurationDays,

              '{{companyName}}': studentData.CompanyName,

              '{{collegeName}}': studentData.CollegeName,

              '{{department}}': studentData.Department,

              '{studentName}': studentData.FullName,

              '{fullName}': studentData.FullName,

              '{regId}': studentData.RegistrationID,

              '{registrationId}': studentData.RegistrationID,

              '{startDate}': studentData.FormattedStartDate,

              '{endDate}': studentData.FormattedEndDate,

              '{StudentName}': studentData.FullName,

              '{FullName}': studentData.FullName,

              '{RegistrationID}': studentData.RegistrationID,

              '{InternshipStartDate}': studentData.FormattedStartDate,

              '{InternshipEndDate}': studentData.FormattedEndDate,

              '{CollegeName}': studentData.CollegeName,

              '{Department}': studentData.Department,

              '{CertificateNumber}': certNumber

            };



            for (const key in emailReplacements) {

              const val = emailReplacements[key] || '';

              emailBody = emailBody.replace(new RegExp(key.replace(/[{}]/g, '\\$&'), 'g'), val);

              subject = subject.replace(new RegExp(key.replace(/[{}]/g, '\\$&'), 'g'), val);

            }

            emailBody = emailBody.replace(/href="#"/g, `href="${existingDoc.url}"`).replace(/href='#'/g, `href="${existingDoc.url}"`);

          } else {

            emailBody = getProfessionalEmailBody(docType === 'internshipCertificate' ? 'completion' : 'confirmation', studentData, existingDoc.url);

          }



          MailApp.sendEmail({

            to: studentData.GmailID,

            subject: subject,

            htmlBody: emailBody,

            attachments: [finalPdf.getBlob()],

            inlineImages: getEmailInlineImages_(),

            name: studentData.CompanyName

          });



          // Update sent flag in generated documents sheet

          const docSheet = getSheet(SHEET_NAMES.GENERATED_DOCUMENTS);

          if (docSheet) {

            const docData = docSheet.getDataRange().getValues();

            const regColIdx = docData[0].indexOf("StudentRegistrationID");

            const typeColIdx = docData[0].indexOf("DocType");

            const emailColIdx = docData[0].indexOf("SentViaEmail");

            if (regColIdx !== -1 && typeColIdx !== -1 && emailColIdx !== -1) {

              for (let i = 1; i < docData.length; i++) {

                if (String(docData[i][regColIdx]).toUpperCase() === String(registrationId).toUpperCase() && docData[i][typeColIdx] === docType) {

                  docSheet.getRange(i + 1, emailColIdx + 1).setValue('Yes');

                  break;

                }

              }

            }

          }

        }

      }



        return { 

          status: 'success', 

          message: `${docType} reused from existing records.`, 

          driveLink: existingDoc.url, 

          url: existingDoc.url, 

          viewUrl: existingDoc.url,

          fileId: existingDoc.fileId,

          certNumber: certNumber,

          studentName: studentData.FullName || studentData.StudentName || studentData.Name || 'Student',

          collegeName: studentData.CollegeName || studentData.College || '',

          batch: studentData.BatchName || studentData.Batch || '',

          attendedDays: studentData.DurationDays || 30

        };

      }

    }



    // === DOCUMENT APPROVAL SYSTEM (GSV-ERP-V2) ===

    const restrictedDocs = ['internshipCertificate', 'COMPLETION_CERTIFICATE', 'offerLetter', 'OFFER_LETTER', 'joiningLetter', 'JOINING_LETTER', 'idCard', 'ID_CARD', 'entryPass', 'ENTRY_PASS', 'General Permission', 'Grace Period', 'Emergency Leave'];

    const unrestrictedForStudents = ['studentDiary', 'dailyLogForm5'];



    if (!isAdmin && restrictedDocs.includes(docType) && !unrestrictedForStudents.includes(docType)) {

      const approval = checkDocumentApproval(registrationId, docType);

      if (approval.status !== 'Approved') {

        return {

          status: 'approval_required',

          message: 'Admin approval is required to generate this document.',

          docType: docType,

          approvalStatus: approval.status

        };

      }

    }

    // ===========================================



    if (docType === 'studentDiary') {

      const res = generateStudentDiaryPDF_V2({

        regId: registrationId,

        mode: 'consolidated',

        orientation: 'portrait'

      });



      if (res && res.status === 'success') {

        if (!isPreview && sendEmailOption && studentData.GmailID) {

          const subject = `Your Student Diary - ${COMPANY_NAME}`;

          const emailBody = `Dear ${studentData.FirstName},\n\nPlease find your consolidated student diary attached.\n\nBest regards,\n${COMPANY_NAME}`;

          try {

            const file = DriveApp.getFileById(res.fileId);

            const grandDiaryHtml = (typeof getGrandDiaryEmailBody === 'function') ? getGrandDiaryEmailBody(studentData, file.getUrl()) : '';

            sendEmail(studentData.GmailID, subject, emailBody, grandDiaryHtml, [file.getAs(MimeType.PDF)]);

          } catch (e) {

            Logger.log("Error emailing diary: " + e);

          }

        }

        return res;

      }

      return res || { status: 'error', message: 'Failed to generate student diary.' };

    }



    if (docType === 'attendanceDocument' || docType === 'consolidatedAttendance') {

