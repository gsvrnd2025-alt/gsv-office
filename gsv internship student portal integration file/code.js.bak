      </div>

      <!-- ATTENDANCE STATS HIGHLIGHT -->
      <div style="background: linear-gradient(135deg, #ecfeff 0%, #e0f2fe 100%); border-radius: 12px; padding: 18px 22px; margin-bottom: 24px; border: 1.5px solid #a5f3fc;">
        <table style="width: 100%; border-collapse: collapse; font-size: 13.5px;">
          <tr style="border-bottom: 1px solid #cffafe;">
            <td style="padding: 7px 0; color: #64748b; font-weight: 600;">📅 Verified Attended Days</td>
