    portalBtnText = '🚀 Access Faculty Portal';
  } else if (candType === 'Employee' || String(candType).includes('employee')) {
    badgeText = '📊 Official Corporate Attendance Record (Form-4)';
    roleGreeting = `Dear Corporate Professional <strong style="color: #0891b2; font-size: 20px;">${studentName}</strong>,`;
    portalBtnText = '🚀 Access Corporate Portal';
  } else if (candType === 'Apprentice' || String(candType).includes('apprentice')) {
    badgeText = '📊 Official Apprenticeship Attendance Record (Form-4)';
    roleGreeting = `Dear Apprentice Trainee <strong style="color: #0891b2; font-size: 20px;">${studentName}</strong>,`;
    portalBtnText = '🚀 Access Apprentice Portal';
  }

  return `
  <div style="font-family: 'Segoe UI', Arial, sans-serif; max-width: 680px; margin: 0 auto; background: #ffffff; border-radius: 18px; overflow: hidden; box-shadow: 0 12px 40px rgba(0,0,0,0.12); border: 1px solid #cffafe;">
    <!-- CYAN / TEAL HEADER -->
