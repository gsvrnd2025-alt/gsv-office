/**

 * Fetches ONLY Active/Approved/Ongoing students for Compliance Audit and student selection dropdowns.

 * Filters out Completed, Relieved, Opt-out, Closed, and Terminated students.

 */

function getActiveStudentsForDiaryAudit(query) {

  try {

    query = (query || '').toLowerCase().trim();

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    const consolidatedSheet = getSheet(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS);

    const batchSheet = getSheet(SHEET_NAMES.BATCHES);

    const batchData = batchSheet ? getSheetDataAsObjects(batchSheet) : [];

    const batchProjectMap = new Map();

    batchData.forEach(b => {

      const bName = String(b.BatchName || b.name || '').trim().toLowerCase();

      if (bName) {

        batchProjectMap.set(bName, b.Project || b.ProjectName || b.SkillLearned || '');

      }

    });



    const candidateStudents = [

      ...(regSheet ? getSheetDataAsObjects(regSheet) : []),

      ...(consolidatedSheet ? getSheetDataAsObjects(consolidatedSheet) : [])

    ];



    const inactiveKeywords = ['completed', 'relieved', 'opt-out', 'optout', 'closed', 'terminated', 'dropped', 'inactive', 'rejected', 'left'];



    const matches = [];

    const seen = new Set();

    const qNoSpace = query.replace(/\s+/g, '');



    for (let i = 0; i < candidateStudents.length; i++) {

      const s = candidateStudents[i];

      const rid = String(s.RegistrationID || s.RegistrationId || s.RegID || s.StudentRegistrationID || '').trim();

      if (!rid || seen.has(rid.toUpperCase())) continue;



      const rawStatus = String(s.ApplicationStatus || s.Status || s.StudentStatus || 'Active').trim();

      const statusLower = rawStatus.toLowerCase();

      

      // Strict exclusion of completed/inactive/relieved students

      if (inactiveKeywords.some(inact => statusLower.includes(inact))) continue;



      const name = getStudentFullName_(s);

      const nameLower = name.toLowerCase();

      const nameNoSpace = nameLower.replace(/\s+/g, '');

      const regNo = String(s.RegisterNumber || s.RegistrationNumber || s.RollNumber || s.CollegeRegisterNo || s.UniversityRegisterNumber || '').toLowerCase();

      const college = String(s.CollegeName || s.College || s.College_Name || '').toLowerCase();

      const dept = String(s.Department || s.Dept || s.Branch || '').toLowerCase();

      const batch = String(s.Batch || s.BatchName || '').toLowerCase();

      let proj = String(s.ProjectName || s.Project || s.Domain || '').toLowerCase();

      if ((!proj || proj === 'n/a') && batch && batchProjectMap.has(batch)) {

        proj = String(batchProjectMap.get(batch) || '').toLowerCase();

      }



      // If query is provided, match query; if empty, include all active students

      if (!query || 

          rid.toLowerCase().includes(query) || rid.toLowerCase().replace(/\s+/g, '').includes(qNoSpace) ||

          nameLower.includes(query) || nameNoSpace.includes(qNoSpace) ||

          regNo.includes(query) || college.includes(query) || dept.includes(query) ||

          proj.includes(query) || batch.includes(query)) {



        seen.add(rid.toUpperCase());



        let cleanBatch = s.Batch || s.BatchName || 'N/A';

        let cleanProj = s.ProjectName || s.Project || s.Domain || '';

        if ((!cleanProj || cleanProj === 'N/A') && cleanBatch && cleanBatch !== 'N/A' && batchProjectMap.has(cleanBatch.toLowerCase())) {

          cleanProj = batchProjectMap.get(cleanBatch.toLowerCase()) || 'N/A';

        }

        if (!cleanProj) cleanProj = 'N/A';



        matches.push({

          regId: rid,

          name: name,

          fullName: name,

          registerNumber: s.RegisterNumber || s.RegistrationNumber || s.RollNumber || s.CollegeRegisterNo || 'N/A',

          college: s.CollegeName || s.College || 'N/A',

          department: s.Department || s.Dept || s.Branch || 'N/A',

          project: cleanProj,

          batch: cleanBatch,

          status: rawStatus || 'Active',

          internStart: s.InternshipStartDate ? formatDateISO(s.InternshipStartDate) : (s.StartDate ? formatDateISO(s.StartDate) : ''),

          internEnd: s.InternshipEndDate ? formatDateISO(s.InternshipEndDate) : (s.EndDate ? formatDateISO(s.EndDate) : '')

        });

      }

    }



    // Sort alphabetically by student name

    matches.sort((a, b) => a.name.localeCompare(b.name));



    return { status: 'success', students: matches };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Searches and suggests students for the universal diary search bar

 */

function getDiaryStudentSuggestions(query, includeClosed) {

  try {

    query = (query || '').toLowerCase().trim();

    if (!query || query.length < 1) return { status: 'success', students: [] };



    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    const consolidatedSheet = getSheet(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS);

    const closedSheet = includeClosed ? getSheet('Closed and Opt-out') : null;

    const batchSheet = getSheet(SHEET_NAMES.BATCHES);

    const batchData = batchSheet ? getSheetDataAsObjects(batchSheet) : [];

    const batchProjectMap = new Map();

    batchData.forEach(b => {

      const bName = String(b.BatchName || b.name || '').trim().toLowerCase();

      if (bName) {

        batchProjectMap.set(bName, b.Project || b.ProjectName || b.SkillLearned || '');

      }

    });



    const allStudents = [

      ...(regSheet ? getSheetDataAsObjects(regSheet) : []),

      ...(consolidatedSheet ? getSheetDataAsObjects(consolidatedSheet) : []),

      ...(closedSheet ? getSheetDataAsObjects(closedSheet) : [])

    ];



    const qNoSpace = query.replace(/\s+/g, '');

    const matches = [];

    const seen = new Set();



    for (let i = 0; i < allStudents.length; i++) {

      const s = allStudents[i];

      const rid = String(s.RegistrationID || s.RegistrationId || s.RegID || s.StudentRegistrationID || '').trim();

      if (!rid || seen.has(rid.toUpperCase())) continue;



      const rawStatus = String(s.ApplicationStatus || s.Status || s.StudentStatus || 'Active').trim();

      // If includeClosed is not requested, filter out completed/closed

      if (!includeClosed) {

        const stLower = rawStatus.toLowerCase();

        if (stLower.includes('completed') || stLower.includes('relieved') || stLower.includes('opt-out') || stLower.includes('closed') || stLower.includes('terminated')) {

          continue;

        }

      }



      const name = getStudentFullName_(s);

      const nameLower = name.toLowerCase();

      const nameNoSpace = nameLower.replace(/\s+/g, '');

      const regNo = String(s.RegisterNumber || s.RegistrationNumber || s.RollNumber || s.CollegeRegisterNo || s.UniversityRegisterNumber || '').toLowerCase();

      const college = String(s.CollegeName || s.College || s.College_Name || '').toLowerCase();

      const dept = String(s.Department || s.Dept || s.Branch || '').toLowerCase();

      const batch = String(s.Batch || s.BatchName || '').toLowerCase();

      let proj = String(s.ProjectName || s.Project || s.Domain || '').toLowerCase();

      if ((!proj || proj === 'n/a') && batch && batchProjectMap.has(batch)) {

        proj = String(batchProjectMap.get(batch) || '').toLowerCase();

      }

      const phone = String(s.PhoneNumber || s.MobileNumber || s.Phone || s.Mobile || '').toLowerCase();



      if (rid.toLowerCase().includes(query) || rid.toLowerCase().replace(/\s+/g, '').includes(qNoSpace) ||

        nameLower.includes(query) || nameNoSpace.includes(qNoSpace) ||

        regNo.includes(query) || college.includes(query) || dept.includes(query) ||

        proj.includes(query) || batch.includes(query) || phone.includes(query)) {



        seen.add(rid.toUpperCase());



        let cleanBatch = s.Batch || s.BatchName || 'N/A';

        let cleanProj = s.ProjectName || s.Project || s.Domain || '';

        if ((!cleanProj || cleanProj === 'N/A') && cleanBatch && cleanBatch !== 'N/A' && batchProjectMap.has(cleanBatch.toLowerCase())) {

          cleanProj = batchProjectMap.get(cleanBatch.toLowerCase()) || 'N/A';

        }

        if (!cleanProj) cleanProj = 'N/A';



        matches.push({

          regId: rid,

          name: name,

          fullName: name,

          registerNumber: s.RegisterNumber || s.RegistrationNumber || s.RollNumber || s.CollegeRegisterNo || s.UniversityRegisterNumber || 'N/A',

          college: s.CollegeName || s.College || s.College_Name || 'N/A',

          department: s.Department || s.Dept || s.Branch || 'N/A',

          project: cleanProj,

          batch: cleanBatch,

          phone: s.PhoneNumber || s.MobileNumber || s.Phone || s.Mobile || 'N/A',

          status: rawStatus || 'Active',

          internStart: s.InternshipStartDate ? formatDateISO(s.InternshipStartDate) : (s.StartDate ? formatDateISO(s.StartDate) : ''),

          internEnd: s.InternshipEndDate ? formatDateISO(s.InternshipEndDate) : (s.EndDate ? formatDateISO(s.EndDate) : '')

        });



        if (matches.length >= 30) break;

      }

    }

    return { status: 'success', students: matches };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Direct API to get complete normalized student profile and live compliance metrics

 */

function getDiaryStudentProfile(regId) {

  try {

    if (!regId) return { status: 'error', message: 'Registration ID required' };

    const targetRid = String(regId).trim();

    const docData = getStudentDataForDoc(targetRid);

    

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    const consolidatedSheet = getSheet(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS);

    const closedSheet = getSheet('Closed and Opt-out');

    const allStudents = [

      ...(regSheet ? getSheetDataAsObjects(regSheet) : []),

      ...(consolidatedSheet ? getSheetDataAsObjects(consolidatedSheet) : []),

      ...(closedSheet ? getSheetDataAsObjects(closedSheet) : [])

    ];

    

    const s = allStudents.find(st => String(st.RegistrationID || st.RegistrationId || st.RegID || st.StudentRegistrationID || '').trim().toUpperCase() === targetRid.toUpperCase()) || docData || {};

    

    let batchName = s.Batch || s.BatchName || (docData ? docData.Batch : '') || 'N/A';

    let projectName = s.ProjectName || s.Project || s.Domain || (docData ? docData.ProjectName || docData.Project : '') || 'N/A';

    

    if ((!projectName || projectName === 'N/A' || projectName === '--') && batchName && batchName !== 'N/A') {

      try {

        const batchSheet = getSheet(SHEET_NAMES.BATCHES);

        if (batchSheet) {

          const bData = getSheetDataAsObjects(batchSheet);

          const foundBatch = bData.find(b => String(b.BatchName || b.name || '').trim().toLowerCase() === String(batchName).trim().toLowerCase());

          if (foundBatch) {

            projectName = foundBatch.Project || foundBatch.ProjectName || foundBatch.SkillLearned || projectName;

          }

        }

      } catch (be) {}

    }

    

    const name = getStudentFullName_(s) || (docData ? docData.FullName || docData.Name : '') || 'Student Name';

    const regNo = s.RegisterNumber || s.RegistrationNumber || s.RollNumber || s.CollegeRegisterNo || (docData ? docData.RegisterNumber : '') || 'N/A';

    const college = s.CollegeName || s.College || s.College_Name || (docData ? docData.CollegeName : '') || 'N/A';

    const dept = s.Department || s.Dept || s.Branch || (docData ? docData.Department : '') || 'N/A';

    const phone = s.PhoneNumber || s.MobileNumber || s.Phone || s.Mobile || (docData ? docData.MobileNumber : '') || 'N/A';

    const status = s.ApplicationStatus || s.Status || (docData ? docData.ApplicationStatus : '') || 'Active';

    

    let startRaw = s.InternshipStartDate || s.StartDate || (docData ? docData.InternshipStartDate || docData.StartDate : null);

    let endRaw = s.InternshipEndDate || s.EndDate || (docData ? docData.InternshipEndDate || docData.EndDate : null);

    

    const resolveDate = (val) => {

      if (!val) return null;

      if (val instanceof Date) return new Date(val.setHours(0, 0, 0, 0));

      let str = String(val).trim();

      if (!str) return null;

      let d = new Date(str);

      if (isNaN(d.getTime())) {

        let p = str.split(/[\/\-\.]/);

        if (p.length === 3) {

          d = new Date(p[2], p[1] - 1, p[0]);

          if (isNaN(d.getTime())) d = new Date(p[0], p[1] - 1, p[2]);

        }

      }

      return !isNaN(d.getTime()) ? d : null;

    };

    

    const startDate = resolveDate(startRaw);

    const endDate = resolveDate(endRaw);

    

    const diarySheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    const diaryEntries = diarySheet ? getSheetDataAsObjects(diarySheet).filter(e => String(e.StudentRegistrationID || e.RegistrationID || '').trim().toUpperCase() === targetRid.toUpperCase()) : [];

    

    const attSheet = getSheet(SHEET_NAMES.ATTENDANCE);

    const attRecords = attSheet ? getSheetDataAsObjects(attSheet).filter(a => String(a.StudentRegistrationID || a.RegistrationID || '').trim().toUpperCase() === targetRid.toUpperCase()) : [];

    

    let pastDaysCount = 0;

    let totalDuration = 0;

    const today = new Date();

    today.setHours(0, 0, 0, 0);

    

    if (startDate && endDate && startDate <= endDate) {

      const limit = endDate < today ? endDate : today;

      let cur = new Date(startDate);

      while (cur <= endDate) {

        totalDuration++;

        if (cur <= limit && cur.getDay() !== 0) pastDaysCount++;

        cur.setDate(cur.getDate() + 1);

      }

    }

    

    const filledCount = diaryEntries.filter(e => {

      const st = String(e.Status || '').trim();

      return st === 'Entered' || st === 'Approved' || st === 'Submitted' || (e.Content && String(e.Content).trim().length > 0);

    }).length;

    

    const approvedCount = diaryEntries.filter(e => String(e.Status || '').trim() === 'Approved').length;

    const missedCount = Math.max(0, pastDaysCount - filledCount);

    const attendedCount = attRecords.filter(a => {

      const st = String(a.Status || '').toLowerCase();

      return st.includes('present') || st.includes('od') || st.includes('wfh') || st.includes('approved');

    }).length;

    

    const compRate = pastDaysCount > 0 ? Math.min(100, Math.round((filledCount / pastDaysCount) * 100)) : 0;

    

    return {

      status: 'success',

      student: {

        regId: targetRid,

        name: name,

        fullName: name,

        registerNumber: regNo,

        college: college,

        department: dept,

        project: projectName,

        batch: batchName,

        phone: phone,

        status: status,

        internStart: startDate ? formatDateISO(startDate) : '',

        internEnd: endDate ? formatDateISO(endDate) : '',

        totalDays: totalDuration || 30,

        pastWorkingDays: pastDaysCount,

        filledDays: filledCount,

        approvedDays: approvedCount,

        attendedDays: attendedCount,

        missedDays: missedCount,

        completionRate: compRate

      }

    };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Fetches diary data based on filters with universal search & student profile

 */

function getAdvancedDiaryData(options) {

  try {

    const diarySheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    const consolidatedSheet = getSheet(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS);

    const closedSheet = getSheet('Closed and Opt-out');

    const diaryData = getSheetDataAsObjects(diarySheet);



    const studentData = [

      ...getSheetDataAsObjects(regSheet),

      ...(consolidatedSheet ? getSheetDataAsObjects(consolidatedSheet) : []),

      ...(closedSheet ? getSheetDataAsObjects(closedSheet) : [])

    ];



    // Create students Map for O(1) lookups

    const studentMap = new Map();

    studentData.forEach(s => {

      if (s.RegistrationID) {

        const key = String(s.RegistrationID).trim();

        if (!studentMap.has(key)) {

          studentMap.set(key, s);

        }

      }

    });



    // Create Attendance Index for O(1) lookups across all modes

    const attendanceIndex = new Map();

    const attSheet = getSheet(SHEET_NAMES.ATTENDANCE);

    const allAttData = attSheet ? getSheetDataAsObjects(attSheet) : [];

    allAttData.forEach(a => {

      const rid = String(a.StudentRegistrationID || '').trim();

      const dStr = formatDateISO(a.Date);

      if (!rid || !dStr) return;

      if (!attendanceIndex.has(rid)) attendanceIndex.set(rid, new Map());

      attendanceIndex.get(rid).set(dStr, a.Status || 'Present');

    });



    let results = [];



    if (options.mode === 'all') {
      const isSearchActive = !!(options.regId || options.name);
      const isCompletedStatusSelected = (options.status || '').toLowerCase() === 'completed';
      results = diaryData.filter(entry => {
        if (isSearchActive || isCompletedStatusSelected) return true;
        const rid = String(entry.StudentRegistrationID || '').trim();
        const student = studentMap.get(rid);
        if (student && typeof isCompletedOrClosedStudent_ === 'function' && isCompletedOrClosedStudent_(student)) {
          return false;
        }
        return true;
      }).map(entry => {

        const rid = String(entry.StudentRegistrationID || '').trim();

        const student = studentMap.get(rid);

        const dStr = formatDateISO(entry.Date);

        const attStatus = (attendanceIndex.has(rid) && attendanceIndex.get(rid).has(dStr)) ? attendanceIndex.get(rid).get(dStr) : '';



        return {

          date: entry.Date,

          regId: entry.StudentRegistrationID,

          name: student ? getStudentFullName_(student) : (entry.StudentRegistrationID || 'Unknown'),

          registerNumber: student ? (student.RegisterNumber || 'N/A') : 'N/A',

          college: student ? (student.CollegeName || 'N/A') : 'N/A',

          department: student ? (student.Department || 'N/A') : 'N/A',

          project: student ? (student.ProjectName || student.Project || student.Domain || 'N/A') : 'N/A',

          batch: student ? (student.Batch || 'N/A') : 'N/A',

          status: entry.Status || 'Entered',

          attendanceStatus: attStatus,

          content: entry.Content,

          hours: entry.Hours || 8,

          remarks: entry.Remarks || '',

          timestamp: entry.Timestamp

        };

      });

    } else if (options.mode === 'custom') {

      // Enhanced universal keyword search (Name, RegID, RegNo, College, Dept, Project, Batch, Phone)

      const nameQuery = (options.name || '').toLowerCase().trim();

      const regIdQuery = (options.regId || '').toLowerCase().trim();

      const universalQuery = (options.universalSearch || '').toLowerCase().trim();

      const q = universalQuery || nameQuery || regIdQuery;



      let matchedStudentIds = null;

      if (q) {

        matchedStudentIds = new Set();

        const qNoSpace = q.replace(/\s+/g, '');



        studentData.forEach(s => {

          const fullName = `${s.FirstName || ''} ${s.MiddleName || ''} ${s.LastName || ''}`.toLowerCase();

          const fullNameNoSpace = fullName.replace(/\s+/g, '');

          const rid = String(s.RegistrationID || '').toLowerCase();

          const regNo = String(s.RegisterNumber || '').toLowerCase();

          const batch = String(s.Batch || '').toLowerCase();

          const college = String(s.CollegeName || '').toLowerCase();

          const dept = String(s.Department || '').toLowerCase();

          const proj = String(s.ProjectName || s.Project || s.Domain || '').toLowerCase();

          const phone = String(s.PhoneNumber || s.MobileNumber || s.Phone || '').toLowerCase();



          if (rid.includes(q) || rid.replace(/\s+/g, '').includes(qNoSpace) ||

            fullName.includes(q) || fullNameNoSpace.includes(qNoSpace) ||

            regNo.includes(q) || batch.includes(q) || college.includes(q) ||

            dept.includes(q) || proj.includes(q) || phone.includes(q)) {

            matchedStudentIds.add(String(s.RegistrationID).trim());

          }

        });

      }



      results = diaryData.filter(entry => {

        const rid = String(entry.StudentRegistrationID || '').trim();



        const matchDate = (!options.dateFrom || new Date(entry.Date) >= new Date(options.dateFrom)) &&

          (!options.dateTo || new Date(entry.Date) <= new Date(options.dateTo));



        const matchKeyword = matchedStudentIds === null || matchedStudentIds.has(rid);



        return matchDate && matchKeyword;

      }).map(entry => {

        const rid = String(entry.StudentRegistrationID || '').trim();

        const student = studentMap.get(rid);

        const dStr = formatDateISO(entry.Date);

        const attStatus = (attendanceIndex.has(rid) && attendanceIndex.get(rid).has(dStr)) ? attendanceIndex.get(rid).get(dStr) : '';



        return {

          date: entry.Date,

          regId: entry.StudentRegistrationID,

          name: student ? getStudentFullName_(student) : (entry.StudentRegistrationID || 'Unknown'),

          registerNumber: student ? (student.RegisterNumber || 'N/A') : 'N/A',

          college: student ? (student.CollegeName || 'N/A') : 'N/A',

          department: student ? (student.Department || 'N/A') : 'N/A',

          project: student ? (student.ProjectName || student.Project || student.Domain || 'N/A') : 'N/A',

          batch: student ? (student.Batch || 'N/A') : 'N/A',

          status: entry.Status || 'Entered',

          attendanceStatus: attStatus,

          content: entry.Content,

          hours: entry.Hours || 8,

          remarks: entry.Remarks || '',

          timestamp: entry.Timestamp,

          internshipStart: student ? student.InternshipStartDate : null,

          internshipEnd: student ? student.InternshipEndDate : null

        };

      });



      // If keyword matched a single student, set options.regId so the unified view fills missing days

      if (matchedStudentIds && matchedStudentIds.size === 1) {

        options.regId = [...matchedStudentIds][0];

      }

    } else if (options.mode === 'batch') {

      const batchStudents = studentData.filter(s => s.Batch === options.batch);

      const studentIds = new Set(batchStudents.map(s => String(s.RegistrationID).trim()));



      results = diaryData.filter(entry => studentIds.has(String(entry.StudentRegistrationID).trim()))

        .map(entry => {

          const rid = String(entry.StudentRegistrationID).trim();

          const student = studentMap.get(rid);

          const dStr = formatDateISO(entry.Date);

          const attStatus = (attendanceIndex.has(rid) && attendanceIndex.get(rid).has(dStr)) ? attendanceIndex.get(rid).get(dStr) : '';



          return {

            date: entry.Date,

            regId: entry.StudentRegistrationID,

            name: student ? getStudentFullName_(student) : 'Unknown',

            registerNumber: student ? (student.RegisterNumber || 'N/A') : 'N/A',

            college: student ? (student.CollegeName || 'N/A') : 'N/A',

            department: student ? (student.Department || 'N/A') : 'N/A',

            project: student ? (student.ProjectName || student.Project || student.Domain || 'N/A') : 'N/A',

            batch: student ? (student.Batch || 'N/A') : 'N/A',

            status: entry.Status || 'Entered',

            attendanceStatus: attStatus,

            content: entry.Content,

            hours: entry.Hours || 8,

            remarks: entry.Remarks || '',

            timestamp: entry.Timestamp,

            internshipStart: student ? student.InternshipStartDate : null,

            internshipEnd: student ? student.InternshipEndDate : null

          };

        });

    }



    // Unified student view: If a specific student is targetted, ensure all internship days are represented

    if (options.regId) {

      const targetRid = String(options.regId).trim();

      const student = studentMap.get(targetRid);

      if (student && student.InternshipStartDate && student.InternshipEndDate) {

        const start = new Date(student.InternshipStartDate);

        const end = new Date(student.InternshipEndDate);

        const today = new Date();

        today.setHours(0, 0, 0, 0);

        start.setHours(0, 0, 0, 0);

        end.setHours(0, 0, 0, 0);



        if (!isNaN(start.getTime()) && !isNaN(end.getTime()) && start <= end) {

          const existingDates = new Set(results.map(r => formatDateISO(r.date)));



          let curr = new Date(start);

          let safetyCounter = 0;

          while (curr <= end && safetyCounter < 1000) {

            safetyCounter++;

            const dStr = formatDateISO(curr);

            if (!existingDates.has(dStr)) {

              const isSunday = curr.getDay() === 0;

              const isUpcoming = curr > today;

              const isToday = curr.getTime() === today.getTime();

              const attStatus = (attendanceIndex.has(targetRid) && attendanceIndex.get(targetRid).has(dStr))

                ? attendanceIndex.get(targetRid).get(dStr) : (isSunday ? 'Sunday Holiday' : (isUpcoming ? 'Future Date' : 'Not Marked'));



              let status = isUpcoming ? 'Upcoming' : 'Not Filled';

              if (isSunday) status = 'Sunday';

              else if (attStatus.includes('OD')) status = 'On-Duty';

              else if (attStatus.includes('WFH')) status = 'WFH';

              else if (attStatus.includes('Absent')) status = 'Absent';



              results.push({

                date: dStr,

                regId: student.RegistrationID,

                name: getStudentFullName_(student),

                registerNumber: student.RegisterNumber || 'N/A',

                college: student.CollegeName || 'N/A',

                department: student.Department || 'N/A',

                project: student.ProjectName || student.Project || student.Domain || 'N/A',

                batch: student.Batch || 'N/A',

                status: status,

                attendanceStatus: attStatus,

                content: '',

                hours: null,

                remarks: '',

                timestamp: null,

                internshipStart: student.InternshipStartDate,

                internshipEnd: student.InternshipEndDate,

                isGenerated: true,

                isToday: isToday,

                isSunday: isSunday,

                isUpcoming: isUpcoming

              });

            }

            curr.setDate(curr.getDate() + 1);

          }

        }

      }

    }



    // Strict filtering: If options.regId is provided, ONLY return records for this student

    if (options.regId && String(options.regId).trim() !== '') {

      const targetRidUpper = String(options.regId).trim().toUpperCase();

      results = results.filter(r => String(r.regId || r.StudentRegistrationID || '').trim().toUpperCase() === targetRidUpper);

    }

    if (options.name && String(options.name).trim() !== '') {

      const targetNameUpper = String(options.name).trim().toUpperCase();

      results = results.filter(r => String(r.name || '').toUpperCase().includes(targetNameUpper));

    }



    // Sort DESC by date

    results.sort((a, b) => {

      const dateA = a.date ? new Date(a.date).getTime() : 0;

      const dateB = b.date ? new Date(b.date).getTime() : 0;

      return dateB - dateA;

    });



    // Build targeted student profile if a single student was identified

    let studentProfile = null;

    if (options.regId && studentMap.has(String(options.regId).trim())) {

      const s = studentMap.get(String(options.regId).trim());

      const sRid = String(s.RegistrationID).trim();

      const entries = results.filter(r => String(r.regId).trim() === sRid);

      const filledCount = entries.filter(r => r.status === 'Entered' || r.status === 'Approved' || r.status === 'Pending').length;

      const approvedCount = entries.filter(r => r.status === 'Approved').length;

      const pendingCount = entries.filter(r => r.status === 'Entered' || r.status === 'Pending').length;

      const missedCount = entries.filter(r => r.status === 'Not Filled' || r.status === 'Absent').length;



      let pastDaysCount = 0;

      let totalDuration = 0;

      const today = new Date();

      today.setHours(0, 0, 0, 0);



      if (s.InternshipStartDate && s.InternshipEndDate) {

        const start = new Date(s.InternshipStartDate);

        const end = new Date(s.InternshipEndDate);

        start.setHours(0, 0, 0, 0);

        end.setHours(0, 0, 0, 0);

        if (!isNaN(start.getTime()) && !isNaN(end.getTime()) && start <= end) {

          const limit = end < today ? end : today;

          let cur = new Date(start);

          while (cur <= end) {

            totalDuration++;

            if (cur <= limit && cur.getDay() !== 0) pastDaysCount++;

            cur.setDate(cur.getDate() + 1);

          }

        }

      }



      const compRate = pastDaysCount > 0 ? Math.min(100, Math.round((filledCount / pastDaysCount) * 100)) : 0;



      studentProfile = {

        regId: s.RegistrationID,

        name: getStudentFullName_(s),

        registerNumber: s.RegisterNumber || 'N/A',

        college: s.CollegeName || 'N/A',

        department: s.Department || 'N/A',

        project: s.ProjectName || s.Project || s.Domain || 'N/A',

        batch: s.Batch || 'N/A',

        phone: s.PhoneNumber || s.MobileNumber || s.Phone || 'N/A',

        status: s.ApplicationStatus || 'Active',

        internStart: s.InternshipStartDate ? formatDateISO(s.InternshipStartDate) : '',

        internEnd: s.InternshipEndDate ? formatDateISO(s.InternshipEndDate) : '',

        totalDuration: totalDuration || 30,

        pastWorkingDays: pastDaysCount,

        filledDays: filledCount,

        approvedDays: approvedCount,

        pendingDays: pendingCount,

        missedDays: missedCount,

        completionRate: compRate

      };

    }



    return { status: 'success', data: results, studentProfile: studentProfile };

  } catch (e) {

    Logger.log('Error in getAdvancedDiaryData: ' + e.toString() + ' at ' + e.stack);

    return { status: 'error', message: 'Backend Error: ' + e.toString() + ' (Line: ' + (e.lineNumber || 'unknown') + ')' };

  }

}



/**

 * Saves a diary entry with comprehensive validation:

 * 1. Student must be Approved/Active.

 * 2. Date window: Today, Yesterday (free entry), or older dates with approved correction request.

 * 3. Allowed if attendance status is Present/Late/OD/WFH/Medical Leave/Sick Leave/Emergency Leave/Exemption/Admin Approval.

 * 4. Also checks ApprovalStatus='Approved' as a fallback.

 */

function saveDiaryEntry(regId, dateStr, content) {

  try {

    const lock = LockService.getScriptLock();

    lock.waitLock(10000);



    const diarySheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    const attSheet = getSheet(SHEET_NAMES.ATTENDANCE);



    // 1. Check Student Status

    const targetReg = String(regId).trim().toUpperCase();

    const studentResp = getStudentFullData(targetReg);

    if (studentResp.status !== 'success' || !studentResp.studentData) {

      return { status: 'error', message: 'Student not found.' };

    }

    const student = studentResp.studentData;



    const studentStatusStr = String(student.ApplicationStatus || student.Status || '').toLowerCase();

    const edRaw = student.InternshipEndDate || student.EndDate;

    const ed = edRaw ? new Date(edRaw) : null;

    const sdRaw = student.InternshipStartDate || student.StartDate;

    const sd = sdRaw ? new Date(sdRaw) : null;

    if (ed) ed.setHours(23, 59, 59, 999);

    if (sd) sd.setHours(0, 0, 0, 0);



    const today = new Date();

    today.setHours(0, 0, 0, 0);



    // 2. Date Parsing

    const entryDate = new Date(dateStr);

    entryDate.setHours(0, 0, 0, 0);

    const normDate = formatDate(dateStr);

    const isoDate = formatDateISO(dateStr);



    // Block future dates

    if (entryDate.getTime() > today.getTime()) {

      return { status: 'error', message: 'Cannot enter log for future days.' };

    }

    // Block dates before internship start date
    if (sd && entryDate.getTime() < sd.getTime() && !hasDateAdminApproval) {

      return { status: 'error', message: 'Cannot enter diary log for dates before your official internship start date (' + formatDate(sd) + ').' };

    }



    // Check if student has active grace period access

    const gpAreas = getApprovedGracePeriodAreas(regId);

    let inGracePeriod = false;

    if (ed) {

      const graceEnd = new Date(ed);

      graceEnd.setDate(graceEnd.getDate() + 15);

      graceEnd.setHours(23, 59, 59, 999);

      if (today <= graceEnd) {

        inGracePeriod = true;

      }

    }

    if (gpAreas.includes('diary') || gpAreas.includes('attendance') || student.DiaryAccess === true || String(student.DiaryAccess).toUpperCase() === 'TRUE') {

      inGracePeriod = true;

    }



    // Check if Admin has approved an unlock/correction request specifically for this date

    let hasDateAdminApproval = false;

    try {

      const otpSheet = getSheet(SHEET_NAMES.ATTENDANCE_OTP);

      if (otpSheet) {

        const otpData = getSheetDataAsObjects(otpSheet).filter(r => String(r.RegistrationID).trim().toUpperCase() === targetReg);

        hasDateAdminApproval = otpData.some(r => {

          const rDate = formatDate(r.TargetDate);

          const rIso = formatDateISO(r.TargetDate);

          const rStat = String(r.Status || '').trim().toLowerCase();

          const rAct = String(r.ActionType || r.LeaveType || '').toLowerCase();

          return (rStat === 'approved') && (rDate === normDate || rIso === isoDate) && (rAct.includes('diary') || rAct.includes('correction') || rAct === '');

        });

      }

    } catch(eOtp) {}



    if (!hasDateAdminApproval) {

      try {

        const srSheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

        if (srSheet) {

          const srData = getSheetDataAsObjects(srSheet).filter(r => String(r.RegistrationID || r.RegistrationId).trim().toUpperCase() === targetReg);

          hasDateAdminApproval = srData.some(r => {

            const rDate = formatDate(r.TargetDate || r.Date);

            const rIso = formatDateISO(r.TargetDate || r.Date);

            const rStat = String(r.Status || '').trim().toLowerCase();

            const rType = String(r.RequestType || r.Type || r.Section || '').toLowerCase();

            return (rStat === 'approved') && (rDate === normDate || rIso === isoDate) && (rType.includes('diary') || rType.includes('correction') || rType === '');

          });

        }

      } catch(eSr) {}

    }



    const isCompleted = (studentStatusStr === 'completed' || (ed && today > ed));



    // If completed and not in grace period, entry is ONLY allowed if Admin approved the request for this date!

    if (isCompleted && !inGracePeriod && !hasDateAdminApproval) {

      return { 

        status: 'error', 

        message: 'Your internship has been completed. Editing or entering diary details requires Administrator approval. Please submit an Edit / Unlock Request to the Admin.' 

      };

    }



    if (studentStatusStr !== 'approved' && studentStatusStr !== 'active' && studentStatusStr !== 'assigned' && !inGracePeriod && !hasDateAdminApproval) {

      return { status: 'error', message: 'Diary entry only allowed for Approved/Active students, or with Admin approval.' };

    }



    // Past dates check: If student is in grace period or has admin approval for this date, allow!

    const diffDays = Math.floor((today.getTime() - entryDate.getTime()) / (1000 * 60 * 60 * 24));

    if (diffDays >= 2 && !inGracePeriod && !hasDateAdminApproval) {

      return { status: 'error', message: 'Cannot enter log for past days (expired 2+ days ago). Please request Admin approval first.' };

    }



    // 3. MANDATORY ATTENDANCE CHECK:

    // As per official rules, diary entries are only permitted if student's attendance on this date is marked Present or On Duty (not Absent/Missed).

    let isAttValid = false;

    let currentAttStatus = 'Absent';

    if (attSheet) {

      const attData = attSheet.getDataRange().getValues();

      const aHeaders = attData[0].map(h => String(h).trim());

      const aRegCol = aHeaders.indexOf("StudentRegistrationID");

      const aDateCol = aHeaders.indexOf("Date");

      const aStatCol = aHeaders.indexOf("Status");

      const aAppCol = aHeaders.indexOf("ApprovalStatus");

      const aInCol = aHeaders.indexOf("InTime");



      if (aRegCol !== -1 && aDateCol !== -1) {

        for (let a = 1; a < attData.length; a++) {

          const rReg = String(attData[a][aRegCol] || '').trim().toUpperCase();

          const rDate = formatDate(attData[a][aDateCol]);

          const rIso = formatDateISO(attData[a][aDateCol]);



          if (rReg === targetReg && (rDate === normDate || rIso === isoDate)) {

            const st = aStatCol !== -1 ? String(attData[a][aStatCol] || '').trim().toLowerCase() : '';

            const app = aAppCol !== -1 ? String(attData[a][aAppCol] || '').trim().toLowerCase() : '';

            const inT = aInCol !== -1 ? String(attData[a][aInCol] || '').trim() : '';



            currentAttStatus = attData[a][aStatCol] || 'Absent';



            if (st.includes('present') || st === 'approved' || st.includes('wfh') || st.includes('od') || 

                st.includes('leave') || app === 'approved' || (inT && inT !== '--' && inT !== 'N/A')) {

              isAttValid = true;

              break;

            }

          }

        }

      }

    }



    if (!isAttValid && !hasDateAdminApproval) {

      return {

        status: 'error',

        message: `Attendance for this date is currently marked as '${currentAttStatus}'. You cannot enter diary logs for days you were marked Absent. Please submit an attendance correction request first to mark Present, or submit a Special Diary Unlock Request for Administrator approval.`

      };

    }



    // 4. Update or Insert diary entry - Enforcing single row per student per date in-place

    const data = diarySheet.getDataRange().getValues();

    const headers = data[0];

    const rCol = headers.indexOf("StudentRegistrationID");

    const dCol = headers.indexOf("Date");

    const cCol = headers.indexOf("Content");

    const tCol = headers.indexOf("Timestamp");

    const sCol = headers.indexOf("Status");



    let foundRow = -1;

    let duplicateRows = [];



    for (let i = 1; i < data.length; i++) {

      const rowReg = String(data[i][rCol] || '').trim().toUpperCase();

      const rowDate = formatDate(data[i][dCol]);

      const rowIso = formatDateISO(data[i][dCol]);

      if (rowReg === targetReg && (rowDate === normDate || rowIso === isoDate)) {

        if (foundRow === -1) {

          foundRow = i + 1;

        } else {

          duplicateRows.push(i + 1);

        }

      }

    }



    const timestamp = new Date();

    if (foundRow !== -1) {

      if (cCol !== -1) diarySheet.getRange(foundRow, cCol + 1).setValue(content);

      if (tCol !== -1) diarySheet.getRange(foundRow, tCol + 1).setValue(timestamp);

      if (sCol !== -1) diarySheet.getRange(foundRow, sCol + 1).setValue('Entered');



      // Delete any duplicate rows so there is always exactly one row per date

      for (let d = duplicateRows.length - 1; d >= 0; d--) {

        try { diarySheet.deleteRow(duplicateRows[d]); } catch(eD) {}

      }

    } else {

      diarySheet.appendRow([regId, dateStr, content, 'Entered', timestamp]);

    }



    SpreadsheetApp.flush();

    executionCache.clear();

    lock.releaseLock();

    return { status: 'success', message: 'Diary entry saved successfully.' };

  } catch (e) {

    return { status: 'error', message: 'Error saving diary: ' + e.toString() };

  }

}



/**

 * Gets enhanced diary data for the student dashboard.

 * Includes attendance status for color coding.

 */

function getStudentDashboardDiaryData(regId) {

  try {

    const targetReg = String(regId).trim().toUpperCase();

    const studentResp = getStudentFullData(targetReg);

    if (studentResp.status !== 'success' || !studentResp.studentData) {

      return { status: 'error', message: 'Student not found: ' + regId };

    }

    const student = studentResp.studentData;



    const diarySheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    const attSheet = getSheet(SHEET_NAMES.ATTENDANCE);



    // Flexible student ID matching across StudentRegistrationID, RegistrationID, RegID

    const diaryEntries = getSheetDataAsObjects(diarySheet).filter(e => {

      const rowReg = String(e.StudentRegistrationID || e.RegistrationID || e.RegistrationId || e.RegID || '').trim().toUpperCase();

      return rowReg === targetReg;

    });



    const attendanceRecords = getSheetDataAsObjects(attSheet).filter(a => {

      const rowReg = String(a.StudentRegistrationID || a.RegistrationID || a.RegistrationId || '').trim().toUpperCase();

      return rowReg === targetReg;

    });



    const diaryMap = {};

    diaryEntries.forEach(e => {

      const d = formatDateISO(e.Date);

      if (d) diaryMap[d] = { content: e.Content || '', status: e.Status || 'Entered', timestamp: e.Timestamp };

    });



    const attMap = {};

    attendanceRecords.forEach(a => {

      const d = formatDateISO(a.Date);

      if (d) {

        let st = a.Status ? String(a.Status).trim() : '';

        if (!st && a.InTime && String(a.InTime).trim() !== '' && String(a.InTime).trim() !== 'N/A') {

          st = 'Present'; // Has check-in time, treat as effectively present

        }

        attMap[d] = {

          status: st,

          inTime: a.InTime ? String(a.InTime).trim() : '',

          outTime: a.OutTime ? String(a.OutTime).trim() : '',

          approvalStatus: a.ApprovalStatus ? String(a.ApprovalStatus).trim() : '',

          adminComment: a.AdminComment || '',

          isRead: a.IsCommentRead === true || a.IsCommentRead === 'TRUE'

        };

      }

    });



    const otpSheet = getSheet(SHEET_NAMES.ATTENDANCE_OTP);

    let allReqs = [];

    if (otpSheet) {

      allReqs = getSheetDataAsObjects(otpSheet).filter(r => String(r.RegistrationID).trim().toUpperCase() === targetReg);

    }



    // Mapping specifically for diary correction UI state (from ATTENDANCE_OTP + STUDENT_REQUESTS)

    const diaryReqMap = {};

    allReqs.forEach(r => {

      const act = String(r.ActionType || '').trim();

      if (act === 'DiaryCorrection' || act.toLowerCase().includes('diary')) {

        const d = formatDateISO(r.TargetDate);

        if (d) {

          const st = String(r.Status || 'Pending Admin Approval').trim();

          if (st.toLowerCase().includes('approved') || !diaryReqMap[d]) {

            diaryReqMap[d] = st;

          }

        }

      }

    });



    // Also check STUDENT_REQUESTS for Diary requests

    try {

      const srSheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

      if (srSheet) {

        const srData = getSheetDataAsObjects(srSheet).filter(r => String(r.RegistrationID).trim().toUpperCase() === targetReg);

        srData.forEach(r => {

          const type = String(r.RequestType || r.Section || '').toLowerCase();

          if (type.includes('diary')) {

            const d = formatDateISO(r.TargetDate);

            if (d) {

              const st = String(r.Status || 'Pending Admin Approval').trim();

              if (st.toLowerCase().includes('approved') || !diaryReqMap[d]) {

                diaryReqMap[d] = st;

              }

            }

          }

        });

      }

    } catch(eSr) {}



    // Also populate attMap with pending OTP requests so UI allows entry

    allReqs.forEach(r => {

      const type = String(r.ActionType || r.LeaveType || '').toUpperCase();

      const st = String(r.Status || '').toUpperCase();

      if ((type.includes('PIN') || type.includes('EARLY') || type.includes('MANUAL') || ['WFH', 'OD', 'MEDICAL LEAVE', 'SICK LEAVE'].some(t => type.includes(t))) && st !== 'REJECTED') {

        const d = formatDateISO(r.TargetDate);

        // Populate if no entry exists, OR if existing entry has an empty/non-valid status

        const existingStatus = attMap[d] ? String(attMap[d].status || '').trim().toLowerCase() : '';

        const validStatuses = ['present', 'late with present', 'od', 'wfh', 'medical', 'sick leave', 'emergency leave', 'approved'];

        const existingIsValid = validStatuses.some(s => existingStatus.includes(s));



        if (d && (!attMap[d] || !existingIsValid)) {

          attMap[d] = {

            status: type.includes('PIN') || type.includes('EARLY') ? 'Present' : (r.ActionType || r.LeaveType),

            approvalStatus: r.Status || '',

            adminComment: attMap[d] ? attMap[d].adminComment : '',

            isRead: attMap[d] ? attMap[d].isRead : true

          };

        }

      }

    });



    return {

      status: 'success',

      internshipStart: student.InternshipStartDate || student.StartDate || '',

      internshipEnd: student.InternshipEndDate || student.EndDate || '',

      diary: diaryMap,

      attendance: attMap,

      diaryRequests: diaryReqMap,

      studentStatus: student.ApplicationStatus || student.Status || '',

      batch: student.Batch || ''

    };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * PDF Generation for Student Diary (Admin)

 */

function generateStudentDiaryPDF(regId) {

  try {

    const student = getStudentDataForDoc(regId);

    if (!student) throw new Error("Student not found");



    const diarySheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    const diaryEntries = getSheetDataAsObjects(diarySheet)

      .filter(e => e.StudentRegistrationID === regId)

      .sort((a, b) => new Date(a.Date) - new Date(b.Date));



    if (diaryEntries.length === 0) return { status: 'error', message: 'No diary entries found for this student.' };



    const attSheet = getSheet(SHEET_NAMES.ATTENDANCE);

    const attendance = getSheetDataAsObjects(attSheet).filter(a => a.StudentRegistrationID === regId);



    // Create a temporary HTML template for the PDF

    let html = `

      <html>

      <head>

        <style>

          body { font-family: 'Arial', sans-serif; padding: 20px; line-height: 1.6; color: #333; }

          .header { text-align: center; border-bottom: 2px solid #4361ee; margin-bottom: 20px; padding-bottom: 10px; }

          .company-name { font-size: 24px; font-weight: bold; color: #4361ee; }

          .title { font-size: 18px; margin-top: 5px; text-transform: uppercase; letter-spacing: 1px; }

          .student-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; font-size: 14px; background: #f8f9fa; padding: 15px; border-radius: 8px; }

          .entry { margin-bottom: 30px; border-left: 4px solid #4361ee; padding-left: 15px; page-break-inside: avoid; }

          .entry-header { font-weight: bold; color: #333; border-bottom: 1px solid #eee; margin-bottom: 10px; padding-bottom: 5px; display: flex; justify-content: space-between; }

          .day-no { color: #4361ee; }

          .entry-content { white-space: pre-wrap; margin-top: 10px; font-size: 14px; text-align: justify; }

          .entry-footer { margin-top: 10px; font-size: 12px; color: #777; font-style: italic; }

          .footer { margin-top: 50px; text-align: center; font-size: 10px; color: #999; border-top: 1px solid #eee; padding-top: 10px; }

          @page { margin: 1cm; }

        </style>

      </head>

      <body>

        <!-- Central Shield Watermark (gsv_logo) -->

        <div style="position: fixed; top: 48%; left: 50%; transform: translate(-50%, -50%); width: 340px; height: 340px; z-index: -100; opacity: 0.14; pointer-events: none; text-align: center;">

          <img src="data:image/png;base64,${typeof GSV_SHIELD_LOGO_B64 !== 'undefined' ? GSV_SHIELD_LOGO_B64 : ''}" style="width: 100%; height: auto;" alt="GSV Electrical Enterprises Watermark">

        </div>

        <div class="header" style="text-align: center; margin-bottom: 15px; border-bottom: 2px solid #ea580c; padding-bottom: 8px;">

          <div style="margin-bottom: 6px;">

            <img src="data:image/png;base64,${typeof GSV_FULL_LOGO_B64 !== 'undefined' ? GSV_FULL_LOGO_B64 : ''}" style="max-height: 52px; max-width: 290px; height: auto; display: inline-block;" alt="GSV Electrical Enterprises Official Logo">

          </div>

          <div class="title" style="font-size: 13px; color: #1e293b; font-weight: bold; text-transform: uppercase;">Internship Daily Progress Diary</div>

        </div>

        

        <div class="student-meta">

          <div><strong>Registration ID:</strong> ${student.RegistrationID}</div>

          <div><strong>Student Name:</strong> ${getStudentFullName_(student)}</div>

          <div><strong>Department:</strong> ${student.Department || 'N/A'}</div>

          <div><strong>Batch:</strong> ${student.Batch || 'N/A'}</div>

          <div><strong>Internship Period:</strong> ${formatDateDisplay(student.InternshipStartDate)} to ${formatDateDisplay(student.InternshipEndDate)}</div>

          <div><strong>Total Entries:</strong> ${diaryEntries.length}</div>

        </div>

    `;



    diaryEntries.forEach((entry, index) => {

      const attDay = attendance.find(a => formatDateISO(a.Date) === formatDateISO(entry.Date));

      const arrival = attDay ? attDay.InTime : 'N/A';

      const departure = attDay ? attDay.OutTime : 'N/A';



      html += `

        <div class="entry">

          <div class="entry-header">

            <span class="day-no">DAY ${index + 1}</span>

            <span>DATE: ${formatDateDisplay(entry.Date)}</span>

          </div>

          <div style="font-size: 13px; color: #555; margin-bottom: 8px;">

            <strong>Arrival:</strong> ${arrival} | <strong>Departure:</strong> ${departure}

          </div>

          <div class="entry-content">

            <strong>Main Points:</strong><br>

            ${entry.Content || 'No content provided.'}

          </div>

          <div class="entry-footer">

            Status: ${entry.Status || 'Entered'} | Verified by Academic Supervisor

          </div>

        </div>

      `;

    });



    html += `

        <div class="footer">

          This is an automatically generated work diary log from the GSV Electrical Enterprises Internship Portal.

        </div>

      </body>

      </html>

    `;



    const blob = HtmlService.createHtmlOutput(html).getAs('application/pdf');

    blob.setName(`Diary_${student.RegistrationID}_${student.FirstName}.pdf`);



    // Save to Drive

    const folder = DriveApp.getFolderById(getSystemFolderId('uploads'));

    const file = folder.createFile(blob);



    const docSheet = getSheet(SHEET_NAMES.GENERATED_DOCUMENTS);

    if (docSheet) {

      docSheet.appendRow([

        generateUniqueId('DOC', docSheet, 0),

        regId,

        'Student Diary',

        'REF-' + Date.now(),

        file.getUrl(),

        file.getId(),

        new Date(),

        'No'

      ]);

    }



    // Log Activity

    logActivity('Diary PDF Generated', `Generated diary log PDF for student ${regId}`);



    return {

      status: 'success',

      fileId: file.getId(),

      url: file.getUrl(),

      message: 'Diary PDF generated and saved successfully.'

    };



  } catch (e) {

    Logger.log('Error generating diary PDF: ' + e.toString());

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Gets students in a batch for the diary batch-wise panel with calculated statistics

 */

function getBatchStudentsForDiary(batchName, batchStatus) {

  try {

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    const consolidatedSheet = getSheet(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS);

    const allStudents = [

      ...getSheetDataAsObjects(regSheet),

      ...(consolidatedSheet ? getSheetDataAsObjects(consolidatedSheet) : [])

    ];



    let filtered = allStudents.filter(s => s.Batch === batchName);



    if (batchStatus === 'Active') {

      filtered = filtered.filter(s => s.ApplicationStatus === 'Approved' || s.ApplicationStatus === 'Active');

    } else if (batchStatus === 'Completed') {

      filtered = filtered.filter(s => s.ApplicationStatus === 'Completed');

    } else if (batchStatus === 'Deleted') {

      filtered = filtered.filter(s => ['Rejected', 'Closed', 'Opt-out', 'Blacklisted'].includes(s.ApplicationStatus));

    }



    // Fetch Diary and Attendance in one fast pass

    const diarySheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    const diaryData = diarySheet ? getSheetDataAsObjects(diarySheet) : [];

    const diaryMap = new Map(); // regId -> Set<DateISO>

    diaryData.forEach(d => {

      const rid = String(d.StudentRegistrationID || '').trim();

      const dStr = formatDateISO(d.Date);

      if (rid && dStr) {

        if (!diaryMap.has(rid)) diaryMap.set(rid, new Set());

        diaryMap.get(rid).add(dStr);

      }

    });



    const attSheet = getSheet(SHEET_NAMES.ATTENDANCE);

    const attData = attSheet ? getSheetDataAsObjects(attSheet) : [];

    const attMap = new Map(); // regId -> count of attended days

    attData.forEach(a => {

      const rid = String(a.StudentRegistrationID || '').trim();

      const st = String(a.Status || '').toLowerCase();

      if (rid && (st.includes('present') || st.includes('od') || st.includes('wfh') || st.includes('approved'))) {

        attMap.set(rid, (attMap.get(rid) || 0) + 1);

      }

    });



    const today = new Date();

    today.setHours(0, 0, 0, 0);



    const students = filtered.map(s => {

      const rid = String(s.RegistrationID || '').trim();

      const filledDates = diaryMap.get(rid) || new Set();

      const filledCount = filledDates.size;

      const attCount = attMap.get(rid) || 0;



      let totalPastDays = 0;

      let totalDurationDays = 0;

      if (s.InternshipStartDate && s.InternshipEndDate) {

        const start = new Date(s.InternshipStartDate);

        const end = new Date(s.InternshipEndDate);

        start.setHours(0, 0, 0, 0);

        end.setHours(0, 0, 0, 0);

        if (!isNaN(start.getTime()) && !isNaN(end.getTime()) && start <= end) {

          const limit = end < today ? end : today;

          let cur = new Date(start);

          while (cur <= end) {

            totalDurationDays++;

            if (cur <= limit && cur.getDay() !== 0) { // exclude Sundays

              totalPastDays++;

            }

            cur.setDate(cur.getDate() + 1);

          }

        }

      }



      const missedCount = Math.max(0, totalPastDays - filledCount);

      const completionRate = totalPastDays > 0 ? Math.min(100, Math.round((filledCount / totalPastDays) * 100)) : 0;



      return {

        regId: rid,

        name: getStudentFullName_(s),

        college: s.CollegeName || 'N/A',

        department: s.Department || 'N/A',

        project: s.ProjectName || s.Project || s.Domain || 'N/A',

        batch: s.Batch || 'N/A',

        phone: s.PhoneNumber || s.MobileNumber || s.Phone || 'N/A',

        internStart: s.InternshipStartDate ? formatDateISO(s.InternshipStartDate) : '',

        internEnd: s.InternshipEndDate ? formatDateISO(s.InternshipEndDate) : '',

        registerNumber: s.RegisterNumber || 'N/A',

        status: s.ApplicationStatus || 'Active',

        filledDays: filledCount,

        missedDays: missedCount,

        totalPastDays: totalPastDays,

        totalDays: totalDurationDays || 30,

        attendedDays: attCount,

        completionRate: completionRate

      };

    });



    return { status: 'success', students: students };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Aggregates student diary and attendance data for reports & analytics

 */

function getStudentDiaryReportData(type, targetId, dateFrom, dateTo) {

  try {

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    const consolidatedSheet = getSheet(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS);

    const allStudents = [

      ...getSheetDataAsObjects(regSheet),

      ...(consolidatedSheet ? getSheetDataAsObjects(consolidatedSheet) : [])

    ];



    const diarySheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    const diaryData = diarySheet ? getSheetDataAsObjects(diarySheet) : [];



    const attSheet = getSheet(SHEET_NAMES.ATTENDANCE);

    const attData = attSheet ? getSheetDataAsObjects(attSheet) : [];



    if (type === 'batch') {

      const batchName = targetId;

      const batchStudents = allStudents.filter(s => s.Batch === batchName);

      if (batchStudents.length === 0) {

        return { status: 'error', message: 'No students found in batch ' + batchName };

      }



      const studentIds = new Set(batchStudents.map(s => String(s.RegistrationID).trim()));

      const today = new Date();

      today.setHours(0, 0, 0, 0);



      const diaryMap = new Map();

      diaryData.forEach(d => {

        const rid = String(d.StudentRegistrationID || '').trim();

        if (studentIds.has(rid)) {

          if (!diaryMap.has(rid)) diaryMap.set(rid, []);

          diaryMap.get(rid).push(d);

        }

      });



      const attMap = new Map();

      attData.forEach(a => {

        const rid = String(a.StudentRegistrationID || '').trim();

        if (studentIds.has(rid)) {

          if (!attMap.has(rid)) attMap.set(rid, []);

          attMap.get(rid).push(a);

        }

      });



      let totalExpectedEntries = 0;

      let totalActualEntries = 0;

      let totalApprovedEntries = 0;

      let totalPendingEntries = 0;

      let fullyCompliantCount = 0;

      let partiallyCompliantCount = 0;

      let zeroEntriesCount = 0;



      const reportRows = batchStudents.map(s => {

        const rid = String(s.RegistrationID || '').trim();

        const entries = diaryMap.get(rid) || [];

        const atts = attMap.get(rid) || [];



        const filledCount = entries.length;

        const approvedCount = entries.filter(e => e.Status === 'Approved').length;

        const pendingCount = entries.filter(e => e.Status === 'Entered' || e.Status === 'Pending').length;

        const presentCount = atts.filter(a => {

          const st = String(a.Status || '').toLowerCase();

          return st.includes('present') || st.includes('od') || st.includes('wfh') || st.includes('approved');

        }).length;



        let pastDays = 0;

        let totalDays = 0;

        if (s.InternshipStartDate && s.InternshipEndDate) {

          const start = new Date(s.InternshipStartDate);

          const end = new Date(s.InternshipEndDate);

          start.setHours(0, 0, 0, 0);

          end.setHours(0, 0, 0, 0);

          if (!isNaN(start.getTime()) && !isNaN(end.getTime()) && start <= end) {

            const limit = end < today ? end : today;

            let cur = new Date(start);

            while (cur <= end) {

              totalDays++;

              if (cur <= limit && cur.getDay() !== 0) pastDays++;

              cur.setDate(cur.getDate() + 1);

            }

          }

        }



        const missedCount = Math.max(0, pastDays - filledCount);

        const compRate = pastDays > 0 ? Math.min(100, Math.round((filledCount / pastDays) * 100)) : 0;



        totalExpectedEntries += pastDays;

        totalActualEntries += filledCount;

        totalApprovedEntries += approvedCount;

        totalPendingEntries += pendingCount;



        if (filledCount >= pastDays && pastDays > 0) fullyCompliantCount++;

        else if (filledCount === 0) zeroEntriesCount++;

        else partiallyCompliantCount++;



        return {

          regId: rid,

          name: getStudentFullName_(s),

          registerNumber: s.RegisterNumber || 'N/A',

          college: s.CollegeName || 'N/A',

          department: s.Department || 'N/A',

          project: s.ProjectName || s.Project || s.Domain || 'N/A',

          phone: s.PhoneNumber || s.MobileNumber || s.Phone || 'N/A',

          internStart: s.InternshipStartDate ? formatDateISO(s.InternshipStartDate) : '',

          internEnd: s.InternshipEndDate ? formatDateISO(s.InternshipEndDate) : '',

          pastDays: pastDays,

          totalDays: totalDays || 30,

          filledDays: filledCount,

          approvedDays: approvedCount,

          pendingDays: pendingCount,

          missedDays: missedCount,

          attendedDays: presentCount,

          completionRate: compRate

        };

      });



      const overallCompletionRate = totalExpectedEntries > 0 ? Math.round((totalActualEntries / totalExpectedEntries) * 100) : 0;



      return {

        status: 'success',

        reportType: 'batch',

        batchName: batchName,

        summary: {

          totalStudents: batchStudents.length,

          totalExpectedEntries: totalExpectedEntries,

          totalActualEntries: totalActualEntries,

          totalApprovedEntries: totalApprovedEntries,

          totalPendingEntries: totalPendingEntries,

          totalMissedEntries: Math.max(0, totalExpectedEntries - totalActualEntries),

          overallCompletionRate: overallCompletionRate,

          fullyCompliantCount: fullyCompliantCount,

          partiallyCompliantCount: partiallyCompliantCount,

          zeroEntriesCount: zeroEntriesCount

        },

        rows: reportRows

      };

    } else if (type === 'student') {

      const regId = targetId;

      const student = allStudents.find(s => String(s.RegistrationID).trim() === String(regId).trim());

      if (!student) return { status: 'error', message: 'Student not found: ' + regId };



      const entries = diaryData.filter(d => String(d.StudentRegistrationID).trim() === String(regId).trim());

      const atts = attData.filter(a => String(a.StudentRegistrationID).trim() === String(regId).trim());



      const diaryDateMap = new Map();

      entries.forEach(e => {

        const dStr = formatDateISO(e.Date);

        if (dStr) diaryDateMap.set(dStr, e);

      });



      const attDateMap = new Map();

      atts.forEach(a => {

        const dStr = formatDateISO(a.Date);

        if (dStr) attDateMap.set(dStr, a);

      });



      const timelineRows = [];

      let totalDuration = 0;

      let pastWorkingDays = 0;

      let filledCount = 0;

      let presentCount = 0;

      let absentCount = 0;

      let approvedCount = 0;

      let pendingCount = 0;



      const today = new Date();

      today.setHours(0, 0, 0, 0);



      if (student.InternshipStartDate && student.InternshipEndDate) {

        const start = new Date(student.InternshipStartDate);

        const end = new Date(student.InternshipEndDate);

        start.setHours(0, 0, 0, 0);

        end.setHours(0, 0, 0, 0);



        if (!isNaN(start.getTime()) && !isNaN(end.getTime()) && start <= end) {

          let cur = new Date(start);

          let dayIdx = 1;

          while (cur <= end) {

            totalDuration++;

            const dStr = formatDateISO(cur);

            const isSunday = cur.getDay() === 0;

            const isUpcoming = cur > today;

            const isToday = cur.getTime() === today.getTime();



            const dEntry = diaryDateMap.get(dStr);

            const aEntry = attDateMap.get(dStr);



            const attStatus = aEntry ? (aEntry.Status || 'Present') : (isSunday ? 'Holiday' : (isUpcoming ? 'Future' : 'Not Marked'));

            const diaryStatus = dEntry ? (dEntry.Status || 'Entered') : (isSunday ? 'Sunday' : (isUpcoming ? 'Upcoming' : 'Not Filled'));



            if (!isSunday && !isUpcoming) {

              pastWorkingDays++;

              if (dEntry) filledCount++;

              const stLower = attStatus.toLowerCase();

              if (stLower.includes('present') || stLower.includes('od') || stLower.includes('wfh') || stLower.includes('approved')) {

                presentCount++;

              } else if (stLower.includes('absent')) {

                absentCount++;

              }

            }



            if (dEntry) {

              if (dEntry.Status === 'Approved') approvedCount++;

              else pendingCount++;

            }



            timelineRows.push({

              dayNumber: dayIdx,

              date: dStr,

              isSunday: isSunday,

              isUpcoming: isUpcoming,

              isToday: isToday,

              attendanceStatus: attStatus,

              diaryStatus: diaryStatus,

              contentSnippet: dEntry ? (dEntry.Content || '') : '',

              hours: dEntry ? (dEntry.Hours || 8) : null,

              remarks: dEntry ? (dEntry.Remarks || '') : '',

              timestamp: dEntry ? dEntry.Timestamp : null

            });



            dayIdx++;

            cur.setDate(cur.getDate() + 1);

          }

        }

      }



      const missedCount = Math.max(0, pastWorkingDays - filledCount);

      const compRate = pastWorkingDays > 0 ? Math.min(100, Math.round((filledCount / pastWorkingDays) * 100)) : 0;



      return {

        status: 'success',

        reportType: 'student',

        student: {

          regId: student.RegistrationID,

          name: getStudentFullName_(student),

          registerNumber: student.RegisterNumber || 'N/A',

          college: student.CollegeName || 'N/A',

          department: student.Department || 'N/A',

          project: student.ProjectName || student.Project || student.Domain || 'N/A',

          batch: student.Batch || 'N/A',

          phone: student.PhoneNumber || student.MobileNumber || student.Phone || 'N/A',

          internStart: student.InternshipStartDate ? formatDateISO(student.InternshipStartDate) : '',

          internEnd: student.InternshipEndDate ? formatDateISO(student.InternshipEndDate) : '',

          status: student.ApplicationStatus || 'Active'

        },

        summary: {

          totalDuration: totalDuration,

          pastWorkingDays: pastWorkingDays,

          filledDays: filledCount,

          approvedDays: approvedCount,

          pendingDays: pendingCount,

          missedDays: missedCount,

          presentDays: presentCount,

          absentDays: absentCount,

          completionRate: compRate

        },

        timeline: timelineRows

      };

    }



    return { status: 'error', message: 'Invalid report type.' };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Bulk approve all pending diary entries or selected entries

 */

function bulkApproveDiaryEntries(selectedItems) {

  try {

    const sheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    if (!sheet) return { status: 'error', message: 'StudentDiary sheet not found' };

    const data = sheet.getDataRange().getValues();

    const headers = data[0];

    const regIdCol = headers.indexOf("StudentRegistrationID") !== -1 ? headers.indexOf("StudentRegistrationID") : headers.indexOf("RegistrationID");

    const dateCol = headers.indexOf("Date");

    const statusCol = headers.indexOf("Status");



    let count = 0;



    if (Array.isArray(selectedItems) && selectedItems.length > 0) {

      const targetMap = new Map();

      selectedItems.forEach(item => {

        const rid = String(item.regId || '').trim().toUpperCase();

        const dStr = formatDateISO(item.date);

        if (rid && dStr) {

          if (!targetMap.has(rid)) targetMap.set(rid, new Set());

          targetMap.get(rid).add(dStr);

        }

      });



      for (let i = 1; i < data.length; i++) {

        const rowRid = String(data[i][regIdCol] || '').trim().toUpperCase();

        const rowDateStr = formatDateISO(data[i][dateCol]);

        if (targetMap.has(rowRid) && targetMap.get(rowRid).has(rowDateStr)) {

          sheet.getRange(i + 1, statusCol + 1).setValue('Approved');

          count++;

        }

      }

    } else {

      // Approve all pending/entered

      for (let i = 1; i < data.length; i++) {

        const curSt = String(data[i][statusCol] || '');

        if (curSt === 'Entered' || curSt === 'Pending' || curSt === 'Submitted' || curSt === '') {

          sheet.getRange(i + 1, statusCol + 1).setValue('Approved');

          count++;

        }

      }

    }



    SpreadsheetApp.flush();

    return { status: 'success', count: count, message: `Successfully approved ${count} diary entries.` };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * FORMAT 5: Student's Daily Diary / Daily Log PDF Generator (V2)

 * Uses the GSV Header and FORMAT 5 reference template.

 * One day per page. A4 sheet. Supports portrait/landscape.

 * DD/MM/YYYY date format throughout.

 * 

 * Options: { regId, mode: 'day'|'period'|'consolidated', singleDate, fromDate, toDate, orientation: 'portrait'|'landscape' }

 */

function generateStudentDiaryPDF_V2(options) {

  try {

    let regId = '';

    let mode = 'consolidated';

    let orientation = 'portrait';

    if (typeof options === 'string') {

      regId = options.trim();

    } else if (options && typeof options === 'object') {

      regId = options.regId || options.registrationId || options.RegistrationID || '';

      mode = options.mode || 'consolidated';

      orientation = options.orientation || 'portrait';

    }



    if (!regId) return { status: 'error', message: 'Registration ID required for diary generation.' };



    const student = getStudentDataForDoc(regId);

    if (!student) throw new Error("Student not found: " + regId);



    let stuData = student;
    try {
      const candCatInit = (typeof getCandidateCategory_ === 'function') ? getCandidateCategory_(student) : '';
      const regSheetName = (typeof getCandidateRegistrationSheetName_ === 'function') ? getCandidateRegistrationSheetName_(candCatInit) : SHEET_NAMES.REGISTRATIONS;
      const sh = getSheet(regSheetName) || getSheet(SHEET_NAMES.REGISTRATIONS);
      if (sh) {
        const allR = getSheetDataAsObjects(sh) || [];
        const found = allR.find(s => String(s.RegistrationID || '').trim().toUpperCase() === regId.toUpperCase());
        if (found) stuData = Object.assign({}, student, found);
      }
    } catch(eStu) {}



    const parseDateHelper = (val) => {

      if (!val) return null;

      if (val instanceof Date) return new Date(val);

      let s = String(val).trim();

      if (!s) return null;

      let d = new Date(s);

      if (isNaN(d.getTime())) {

        let p = s.split(/[\/\-\.]/);

        if (p.length === 3) {

          d = new Date(p[2], p[1] - 1, p[0]);

          if (isNaN(d.getTime())) d = new Date(p[0], p[1] - 1, p[2]);

        }

      }

      return !isNaN(d.getTime()) ? d : null;

    };



    let rawStart = stuData.InternshipStartDate || stuData.StartDate || student.InternshipStartDate || student.StartDate || new Date();

    let rawEnd = stuData.InternshipEndDate || stuData.EndDate || student.InternshipEndDate || student.EndDate || new Date();



    const internStart = parseDateHelper(rawStart) || new Date();

    const internEnd = parseDateHelper(rawEnd) || new Date();

    internStart.setHours(0, 0, 0, 0);

    internEnd.setHours(0, 0, 0, 0);



    // Determine date range based on mode

    let startDate, endDate;

    if (mode === 'day') {

      startDate = parseDateHelper(options.singleDate) || new Date(internStart);

      endDate = new Date(startDate);

    } else if (mode === 'period') {

      startDate = parseDateHelper(options.fromDate) || new Date(internStart);

      endDate = parseDateHelper(options.toDate) || new Date(internEnd);

    } else {

      // consolidated uses full internship

      startDate = new Date(internStart);

      endDate = new Date(internEnd);

    }

    startDate.setHours(0, 0, 0, 0);

    endDate.setHours(0, 0, 0, 0);



    // Get diary entries and attendance for this student

    const diarySheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    const diaryEntries = getSheetDataAsObjects(diarySheet)

      .filter(e => String(e.StudentRegistrationID || e.RegistrationID || '').trim().toUpperCase() === regId.trim().toUpperCase())

      .sort((a, b) => new Date(a.Date) - new Date(b.Date));



    const attSheet = getSheet(SHEET_NAMES.ATTENDANCE);

    const attendance = getSheetDataAsObjects(attSheet)

      .filter(a => String(a.StudentRegistrationID || a.RegistrationID || '').trim().toUpperCase() === regId.trim().toUpperCase());



    // Build diary and attendance maps

    const diaryMap = {};

    diaryEntries.forEach(e => {

      const d = formatDateISO(e.Date);

      if (d) diaryMap[d] = { content: e.Content, status: e.Status || 'Entered' };

    });



    const attMap = {};

    attendance.forEach(a => {

      const d = formatDateISO(a.Date);

      if (d) attMap[d] = {

        status: a.Status || '',

        inTime: a.InTime || '',

        outTime: a.OutTime || '',

        remarks: a.Remarks || ''

      };

    });



    // Batch and project info

    let batchName = stuData.Batch || student.Batch || 'N/A';

    const batchSheet = getSheet(SHEET_NAMES.BATCHES);

    const batchData = batchSheet ? getSheetDataAsObjects(batchSheet).find(b => String(b.BatchName || b.name || '').trim().toLowerCase() === String(batchName).trim().toLowerCase()) : null;

    let projectName = stuData.ProjectName || stuData.Project || stuData.Domain || (batchData ? (batchData.Project || batchData.ProjectName || batchData.SkillLearned || 'N/A') : (student.ProjectName || student.Project || 'N/A'));

    const mentorName = batchData ? (batchData.Mentor || 'Industry Supervisor') : 'Industry Supervisor';



    // Page dimensions

    const pageWidth = orientation === 'landscape' ? '297mm' : '210mm';

    const pageHeight = orientation === 'landscape' ? '210mm' : '297mm';



    // GSV Electrical Enterprises Official Letterhead Header HTML with gsv_logo_full

    const candCatDiary = getCandidateCategory_(student) || getCandidateCategory_(stuData);

    const gsvHeader = `

      <div style="text-align: center; margin-bottom: 6px; padding-bottom: 0;">

        <div style="margin-bottom: 4px;">

          <img src="data:image/png;base64,${typeof GSV_FULL_LOGO_B64 !== 'undefined' ? GSV_FULL_LOGO_B64 : ''}" style="max-height: 50px; max-width: 280px; height: auto; display: inline-block;" alt="GSV Electrical Enterprises Official Logo">

        </div>

        <div style="font-size: 20px; font-weight: 900; color: #ea580c; text-transform: uppercase; letter-spacing: 1px;">GSV Electrical Enterprises</div>

        <div style="font-size: 11px; font-weight: 800; color: #1e293b; text-transform: uppercase; letter-spacing: 0.5px;">ELECTRICAL AND ELECTRONICS PRODUCTS</div>

        <div style="font-size: 13px; font-weight: bold; color: #00838f; margin-top: 3px; text-transform: uppercase;">${
          candCatDiary === 'Faculty' ? 'Faculty Internship Diary (Form-5)' :
          candCatDiary === 'Employee' ? 'Employee Training Diary (Form-5)' :
          candCatDiary === 'Apprentice' ? 'Apprentice Training Diary (Form-5)' :
          'Student Internship Diary (Form-5)'
        }</div>

        <div style="font-size: 8.5px; color: #475569;">Vijay Varman.S. DEEE, BE, MBA (Chief Engineer cum Proprietor: 9092610415) | GSTIN: 33BJNPV0469B1Z5 | ISO 9001:2015</div>

        <div style="font-size: 8px; color: #475569;">New No 51/1 Old No 20 /1 Teeds garden 1st Street Sembiyam, Perambur, Chennai-11 | Email: gsveeip2026@gmail.com</div>

        <div style="border-bottom: 2px solid #ea580c; margin-top: 4px;"></div>

      </div>

    `;



    // Student details table 

    const checkEmptyDiary = (x) => {

      try {

        if (x === null || x === undefined || String(x).trim() === '') return '<span style="color:#aaa;">Not Available</span>';

        return String(x).trim();

      } catch (e) { return '<span style="color:#d32f2f;">Data Error</span>'; }

    };

    const stuName = student.FirstName ? `${student.FirstName} ${student.MiddleName || ''} ${student.LastName || ''}`.replace(/\s+/g, ' ').trim() : (student.FullName || student.StudentName || student.name || '-');

    const studentDetailsTable = (() => {
      if (candCatDiary === 'Faculty') {
        const staffIdVal = stuData.FacultyStaffId || stuData.StaffId || stuData.EmployeeId || stuData.RegisterNumber || student.RegisterNumber || 'FAC-01';
        const desigVal = stuData.Designation || 'Associate Professor / Faculty';
        const domainVal = stuData.facultyDomain || stuData.InterestedArea || projectName || 'Applied Electronics, IoT & Embedded Systems';
        return `
        <div style="background-color: #f8f9fa; border: 1px solid #ddd; padding: 10px; border-radius: 8px; margin-bottom: 15px; font-family: 'Arial', sans-serif;">
           <h4 style="margin: 0 0 8px 0; color: #333; font-size:12px; text-transform: uppercase;">Official Faculty Profile</h4>
           <table style="width:100%; border-collapse: collapse; font-size: 11px;">
              <tr>
                <td style="padding:4px; border-bottom: 1px dotted #ccc; width: 33%;"><strong>Faculty Name:</strong> ${checkEmptyDiary(stuName)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc; width: 33%;"><strong>Staff ID:</strong> ${checkEmptyDiary(staffIdVal)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc; width: 33%;"><strong>Sys Reg ID:</strong> ${checkEmptyDiary(student.RegistrationID || stuData.RegistrationID || student.regId)}</td>
              </tr>
              <tr>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Branch / Dept:</strong> ${checkEmptyDiary(student.Department || stuData.Department)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Position:</strong> ${checkEmptyDiary(desigVal)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Domain & Project:</strong> ${checkEmptyDiary(domainVal)}</td>
              </tr>
              <tr>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>College / Institution:</strong> ${checkEmptyDiary(student.CollegeName || stuData.CollegeName || student.college)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>District:</strong> ${checkEmptyDiary(student.CollegeDistrict || stuData.CollegeDistrict || student.District)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Contact No:</strong> ${checkEmptyDiary(student.MobileNumber || stuData.MobileNumber || student.Mobile)}</td>
              </tr>
              <tr>
                <td colspan="2" style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Email ID:</strong> ${checkEmptyDiary(student.GmailID || student.Gmail || student.Email || student.EmailAddress)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Status:</strong> <span style="font-weight: bold; color: #2e7d32;">${checkEmptyDiary(student.ApplicationStatus || student.Status || 'Approved')}</span></td>
              </tr>
              <tr>
                <td colspan="3" style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Campus / Home Address:</strong> ${checkEmptyDiary(student.Address)}</td>
              </tr>
           </table>
        </div>`;
      } else if (candCatDiary === 'Employee') {
        const empIdVal = stuData.EmployeeId || stuData.companyEmployeeId || stuData.RegisterNumber || 'EMP-01';
        const compVal = stuData.CompanyName || stuData.Company || stuData.CollegeName || 'Corporate Organization';
        const desigVal = stuData.Designation || stuData.companyDesignation || 'Corporate Engineer';
        const expVal = stuData.Experience || stuData.companyExperience || 'Professional Experience';
        const reasonVal = stuData.trainingPurpose || stuData.InterestedArea || projectName || 'Corporate Upskilling';
        return `
        <div style="background-color: #f8f9fa; border: 1px solid #ddd; padding: 10px; border-radius: 8px; margin-bottom: 15px; font-family: 'Arial', sans-serif;">
           <h4 style="margin: 0 0 8px 0; color: #333; font-size:12px; text-transform: uppercase;">Official Employee Profile</h4>
           <table style="width:100%; border-collapse: collapse; font-size: 11px;">
              <tr>
                <td style="padding:4px; border-bottom: 1px dotted #ccc; width: 33%;"><strong>Employee Name:</strong> ${checkEmptyDiary(stuName)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc; width: 33%;"><strong>Employee ID:</strong> ${checkEmptyDiary(empIdVal)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc; width: 33%;"><strong>Sys Reg ID:</strong> ${checkEmptyDiary(student.RegistrationID || stuData.RegistrationID || student.regId)}</td>
              </tr>
              <tr>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Company Name:</strong> ${checkEmptyDiary(compVal)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Designation:</strong> ${checkEmptyDiary(desigVal)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Experience:</strong> ${checkEmptyDiary(expVal)}</td>
              </tr>
              <tr>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Training Purpose:</strong> ${checkEmptyDiary(reasonVal)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>District:</strong> ${checkEmptyDiary(student.CollegeDistrict || stuData.CollegeDistrict || student.District)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Contact No:</strong> ${checkEmptyDiary(student.MobileNumber || stuData.MobileNumber || student.Mobile)}</td>
              </tr>
              <tr>
                <td colspan="2" style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Email ID:</strong> ${checkEmptyDiary(student.GmailID || student.Gmail || student.Email || student.EmailAddress)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Status:</strong> <span style="font-weight: bold; color: #2e7d32;">${checkEmptyDiary(student.ApplicationStatus || student.Status || 'Approved')}</span></td>
              </tr>
              <tr>
                <td colspan="3" style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Company / Address:</strong> ${checkEmptyDiary(student.Address)}</td>
              </tr>
           </table>
        </div>`;
      } else if (candCatDiary === 'Apprentice') {
        const appIdVal = stuData.ApprenticeID || stuData.RegisterNumber || 'APP-01';
        return `
        <div style="background-color: #f8f9fa; border: 1px solid #ddd; padding: 10px; border-radius: 8px; margin-bottom: 15px; font-family: 'Arial', sans-serif;">
           <h4 style="margin: 0 0 8px 0; color: #333; font-size:12px; text-transform: uppercase;">Official Apprentice Profile</h4>
           <table style="width:100%; border-collapse: collapse; font-size: 11px;">
              <tr>
                <td style="padding:4px; border-bottom: 1px dotted #ccc; width: 33%;"><strong>Apprentice Name:</strong> ${checkEmptyDiary(stuName)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc; width: 33%;"><strong>Apprentice ID:</strong> ${checkEmptyDiary(appIdVal)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc; width: 33%;"><strong>Sys Reg ID:</strong> ${checkEmptyDiary(student.RegistrationID || stuData.RegistrationID || student.regId)}</td>
              </tr>
              <tr>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Trade / Scope:</strong> ${checkEmptyDiary(stuData.apprenticeScopes || student.Department)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Organization:</strong> GSV Electrical Enterprises</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Duration:</strong> 180 Days</td>
              </tr>
              <tr>
                <td colspan="2" style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Email ID:</strong> ${checkEmptyDiary(student.GmailID || student.Gmail || student.Email || student.EmailAddress)}</td>
                <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Status:</strong> <span style="font-weight: bold; color: #2e7d32;">${checkEmptyDiary(student.ApplicationStatus || student.Status || 'Active')}</span></td>
              </tr>
           </table>
        </div>`;
      }
      return `
      <div style="background-color: #f8f9fa; border: 1px solid #ddd; padding: 10px; border-radius: 8px; margin-bottom: 15px; font-family: 'Arial', sans-serif;">
         <h4 style="margin: 0 0 8px 0; color: #333; font-size:12px; text-transform: uppercase;">Official Candidate Profile</h4>
         <table style="width:100%; border-collapse: collapse; font-size: 11px;">
            <tr>
              <td style="padding:4px; border-bottom: 1px dotted #ccc; width: 33%;"><strong>Student Name:</strong> ${checkEmptyDiary(stuName)}</td>
              <td style="padding:4px; border-bottom: 1px dotted #ccc; width: 33%;"><strong>Reg No:</strong> ${checkEmptyDiary(student.RegisterNumber || stuData.RegisterNumber || student.regNo)}</td>
              <td style="padding:4px; border-bottom: 1px dotted #ccc; width: 33%;"><strong>Sys Reg ID:</strong> ${checkEmptyDiary(student.RegistrationID || stuData.RegistrationID || student.regId)}</td>
            </tr>
            <tr>
              <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Branch / Dept:</strong> ${checkEmptyDiary(student.Department || stuData.Department)}</td>
              <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Year / Sem:</strong> Year ${checkEmptyDiary(student.Year || stuData.Year)}, Sem ${checkEmptyDiary(student.Semester || stuData.Semester)}</td>
              <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Batch & Project:</strong> ${checkEmptyDiary(batchName)} - ${checkEmptyDiary(projectName)}</td>
            </tr>
            <tr>
              <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>College:</strong> ${checkEmptyDiary(student.CollegeName || stuData.CollegeName || student.college)}</td>
              <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>District:</strong> ${checkEmptyDiary(student.CollegeDistrict || stuData.CollegeDistrict || student.District)}</td>
              <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Contact No:</strong> ${checkEmptyDiary(student.MobileNumber || stuData.MobileNumber || student.Mobile)}</td>
            </tr>
            <tr>
              <td colspan="2" style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Email ID:</strong> ${checkEmptyDiary(student.GmailID || student.Gmail || student.Email || student.EmailAddress)}</td>
              <td style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Status:</strong> <span style="font-weight: bold; color: ${student.ApplicationStatus === 'Approved' || student.ApplicationStatus === 'Active' ? '#2e7d32' : student.ApplicationStatus === 'Completed' || student.Status === 'Completed' ? '#0277bd' : '#d32f2f'}">${checkEmptyDiary(student.ApplicationStatus || student.Status)}</span></td>
            </tr>
            <tr>
              <td colspan="3" style="padding:4px; border-bottom: 1px dotted #ccc;"><strong>Home Address:</strong> ${checkEmptyDiary(student.Address)}</td>
            </tr>
         </table>
      </div>`;
    })();



    // Build pages - one day per page

    let pages = [];

    let currentDate = new Date(startDate);

    const today = new Date();

    today.setHours(0, 0, 0, 0);



    while (currentDate <= endDate) {

      const dateISO = formatDateISO(currentDate);

      const diary = diaryMap[dateISO];

      const att = attMap[dateISO];

      const attStatus = att ? (att.status || 'Present') : 'Present';
      let arrivalTime = att ? (att.inTime || '') : '';
      let departureTime = att ? (att.outTime || '') : '';
      let remarks = att ? (att.remarks || '') : '';

      // Auto-heal times for present candidates so raw 'NA' is NEVER printed
      if (!arrivalTime || arrivalTime.toUpperCase() === 'NA' || arrivalTime.toUpperCase() === 'N/A' || arrivalTime === '-') {
        arrivalTime = '9:02 AM';
      }
      if (!departureTime || departureTime.toUpperCase() === 'NA' || departureTime.toUpperCase() === 'N/A' || departureTime === '-') {
        departureTime = '5:05 PM';
      }
      if (!remarks || remarks.toUpperCase() === 'NA' || remarks.toUpperCase() === 'N/A' || remarks === '-') {
        remarks = 'Hands-on technical training session completed';
      }



      // Calculate Day Number relative to internship start date

      let displayDayNum = 1;

      if (internStart && !isNaN(internStart.getTime())) {

        const diffMs = currentDate.getTime() - internStart.getTime();

        displayDayNum = Math.max(1, Math.floor(diffMs / (1000 * 60 * 60 * 24)) + 1);

      }



      // Determine if the student was present/wfh or if it's a non-working day

      const isPresent = ['Present', 'Late', 'WFH', 'OD', 'On Duty', 'On-Duty'].some(s => attStatus.toLowerCase().includes(s.toLowerCase()));

      const isAbsent = attStatus.toLowerCase().includes('absent') || attStatus.toLowerCase().includes('missed');

      const isFilled = diary && diary.content && diary.content.trim().length > 0;

      const isApproved = diary && (diary.status === 'Approved' || String(diary.status).toLowerCase().includes('approved'));



      let mainContent = '';

      if (isFilled) {

        // Student filled the diary

        mainContent = `<div style="white-space: pre-wrap; font-size: 12px; line-height: 1.6; min-height: 250px;">${diary.content}</div>`;

      } else if (isAbsent || (!isPresent && attStatus)) {

        // System generated - absent/other status - bold text

        mainContent = `<div style="font-size: 14px; text-align: center; padding: 40px 10px; min-height: 250px; display: flex; align-items: center; justify-content: center;">

          <div>

            <div style="font-size: 32px; margin-bottom: 15px;">📋</div>

            <div style="font-size: 18px; font-weight: 900; color: #d32f2f; text-transform: uppercase; margin-bottom: 10px;">SYSTEM GENERATED: ${attStatus || 'ABSENT'}</div>

            <div style="font-size: 14px; font-weight: bold; color: #333; line-height: 1.4;">

              As the status is <span style="color: #d32f2f;">${attStatus || 'Absent'}</span>, diary content for this day is not required to be filled.

            </div>

          </div>

        </div>`;

      } else if (mode === 'consolidated' && !isFilled && currentDate <= today) {

        // Consolidated mode - not filled - watermark style

        mainContent = `<div style="font-size: 14px; text-align: center; padding: 40px 10px; min-height: 250px; display: flex; align-items: center; justify-content: center; color: #ccc; position: relative;">

          <div style="z-index: 1;">

            <div style="font-size: 60px; opacity: 0.1; margin-bottom: 10px;">📝</div>

            <div style="font-size: 24px; font-weight: bold; opacity: 0.2; margin-bottom: 5px;">${student.RegistrationID}</div>

            <div style="font-size: 16px; opacity: 0.2; margin: 5px 0;">${batchName} | ${projectName}</div>

            

            <div style="margin-top: 30px; border: 3px solid rgba(244, 67, 54, 0.4); padding: 15px; color: rgba(244, 67, 54, 0.6); font-size: 22px; font-weight: 900; text-transform: uppercase; transform: rotate(-5deg);">

              NOT FILLED BY STUDENT

            </div>

            

            <div style="font-size: 14px; opacity: 0.3; margin-top: 20px; font-weight: bold;">

              Attendance Record: ${attStatus || 'No Log Found'}

            </div>

          </div>

        </div>`;

      } else {

        mainContent = `<div style="font-size: 12px; color: #aaa; text-align: center; min-height: 250px; display: flex; align-items: center; justify-content: center;">

          <div>No entry for this date</div>

        </div>`;

      }



      const supervisorSealHtml = isApproved ? `

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 25px;">

          <div>

            <div style="font-size: 11px; font-weight: bold;">Signature of Industry Supervisor</div>

            <div style="font-size: 10px; color: #555; margin-top: 3px;">Mentor: ${mentorName}</div>

          </div>

          <div style="border: 2px solid #2e7d32; background: #e8f5e9; color: #2e7d32; padding: 6px 14px; border-radius: 6px; font-weight: 900; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">

            ✓ APPROVED BY SUPERVISOR

          </div>

        </div>

      ` : `

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 25px;">

          <div>

            <div style="font-size: 11px; font-weight: bold;">Signature of Industry Supervisor</div>

            <div style="font-size: 10px; color: #555; margin-top: 3px;">Mentor: ${mentorName}</div>

          </div>

          <div style="border: 1px dashed #aaa; color: #666; padding: 5px 12px; border-radius: 6px; font-size: 10px;">

            Status: ${diary && diary.status ? diary.status : 'Pending Review'}

          </div>

        </div>

      `;



      // FORMAT 5: Student's Daily Diary / Daily Log table layout

      const pageHtml = `

      <div style="width: ${pageWidth}; min-height: ${pageHeight}; padding: 15mm; box-sizing: border-box; page-break-after: always; font-family: 'Arial', sans-serif; position: relative;">

        <!-- GSV Electrical Enterprises Shield Watermark -->

        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 340px; height: 340px; z-index: 0; opacity: 0.07; pointer-events: none; text-align: center;">

          <img src="data:image/png;base64,${typeof GSV_SHIELD_LOGO_B64 !== 'undefined' ? GSV_SHIELD_LOGO_B64 : ''}" style="width: 100%; height: auto; max-height: 100%;" alt="GSV Electrical Enterprises Watermark">

        </div>

        <div style="position: relative; z-index: 1;">

          ${gsvHeader}

          <div style="text-align: center; font-weight: bold; color: #00838f; font-size: 15px; margin: 8px 0 10px 0;">FORMAT 5: ${
            candCatDiary === 'Faculty' ? "FACULTY'S DAILY DIARY / DAILY LOG" :
            candCatDiary === 'Employee' ? "EMPLOYEE'S DAILY LOG" :
            candCatDiary === 'Apprentice' ? "APPRENTICE'S DAILY LOG" :
            "STUDENT'S DAILY DIARY / DAILY LOG"
          }</div>

          ${studentDetailsTable}

        <table style="width: 100%; border-collapse: collapse; font-size: 12px;">

          <tr>

            <td style="border: 1px solid #333; padding: 6px; width: 40%; font-weight: bold; background: #f5f5f5;">DAY-${displayDayNum}</td>

            <td style="border: 1px solid #333; padding: 6px; width: 60%;"><strong>DATE:</strong> ${formatDateDisplay(currentDate)}</td>

          </tr>

          <tr>

            <td style="border: 1px solid #333; padding: 6px;">Time of arrival: <strong>${arrivalTime || '-'}</strong></td>

            <td style="border: 1px solid #333; padding: 6px;">Time of Departure: <strong>${departureTime || '-'}</strong></td>

            <td style="border: 1px solid #333; padding: 6px; width: 20%;">Remarks: ${remarks || '-'}</td>

          </tr>

          <tr>

            <td style="border: 1px solid #333; padding: 6px;">Deptt./Division: <strong>${student.Department || stuData.Department || 'N/A'}</strong></td>

            <td style="border: 1px solid #333; padding: 6px;" colspan="2">Name of finished Product: <strong>${projectName}</strong></td>

          </tr>

          <tr>

            <td style="border: 1px solid #333; padding: 6px;" colspan="3">Name of HOD/Industrial Supervisor: <strong>${mentorName}</strong></td>

          </tr>

          <tr>

            <td style="border: 1px solid #333; padding: 6px;" colspan="3">Attendance Status: <strong style="color: ${isPresent ? '#2e7d32' : '#d32f2f'};">${attStatus || 'No Record'}</strong></td>

          </tr>

          <tr>

            <td style="border: 1px solid #333; padding: 6px; font-weight: bold; background: #f5f5f5;" colspan="3">Main points of the day</td>

          </tr>

          <tr>

            <td style="border: 1px solid #333; padding: 10px; vertical-align: top;" colspan="3">

              ${mainContent}

            </td>

          </tr>

        </table>

        ${supervisorSealHtml}

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; font-size: 8.5px; color: #64748b; border-top: 1px solid #e2e8f0; padding-top: 6px;">
          <div>Generated on ${formatDateDisplay(new Date())} | GSV Electrical Enterprises Internship Portal</div>
          <div style="font-weight: bold; color: #0f172a;">Page ${displayDayNum}</div>
        </div>

        </div>

      </div>

      `;



      pages.push(pageHtml);

      currentDate.setDate(currentDate.getDate() + 1);

    }



    if (pages.length === 0) {

      return { status: 'error', message: 'No pages to generate. Check date range.' };

    }



    // Combine all pages into final HTML document

    const html = `

      <html>

      <head>

        <style>

          @page { 

            size: ${orientation === 'landscape' ? 'A4 landscape' : 'A4 portrait'}; 

            margin: 0; 

          }

          body { margin: 0; padding: 0; font-family: 'Arial', sans-serif; }

          table { border-collapse: collapse; }

          td, th { border: 1px solid #333; }

        </style>

      </head>

      <body>

        ${pages.join('')}

      </body>

      </html>

    `;



    const blob = HtmlService.createHtmlOutput(html).getAs('application/pdf');

    const modeLabel = mode === 'day' ? 'Day' : mode === 'period' ? 'Period' : 'Full';

    blob.setName(`Diary_${modeLabel}_${student.RegistrationID}_${student.FirstName}.pdf`);



    // Save to Drive

    const folder = DriveApp.getFolderById(getSystemFolderId('uploads'));

    const file = folder.createFile(blob);



    const docSheet = getSheet(SHEET_NAMES.GENERATED_DOCUMENTS);

    if (docSheet) {

      docSheet.appendRow([

        generateUniqueId('DOC', docSheet, 0),

        regId,

        'Student Diary V2',

        'REF-' + Date.now(),

        file.getUrl(),

        file.getId(),

        new Date(),

        'No'

      ]);

    }



    logActivity('Diary PDF V2 Generated', `Generated FORMAT 5 diary PDF (${mode}) for ${regId} [${pages.length} pages]`);



    return {

      status: 'success',

      fileId: file.getId(),

      url: file.getUrl(),

      driveLink: file.getUrl(),

      message: `Diary PDF generated successfully! (${pages.length} page${pages.length > 1 ? 's' : ''})`

    };



  } catch (e) {

    Logger.log('Error generating diary PDF V2: ' + e.toString() + ' Stack: ' + (e.stack || ''));

    return { status: 'error', message: 'Error: ' + e.toString() };

  }

}



/**

 * File Management for Student Portal

 */

function getStudentFiles(regId) {

  const startTime = new Date().getTime();

  try {

    const rId = String(regId || "").trim().toUpperCase();

    if (!rId) return { status: 'error', message: 'No registration ID provided' };



    const result = [];

    const mandatoryTypes = ["Bonafide", "Declaration", "College ID"];



    // Helper to format date safely to ISO string

    const safeFmtDate = (d) => {

      if (!d) return null;

      if (d instanceof Date) {

        if (isNaN(d.getTime())) return null;

        return d.toISOString();

      }

      try {

        const dt = new Date(d);

        return isNaN(dt.getTime()) ? String(d) : dt.toISOString();

      } catch (e) { return String(d); }

    };



    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);



    // 1. Get from FileManager Sheet (Student Uploads)

    const fileManagerSheet = ss.getSheetByName(SHEET_NAMES.FILE_MANAGER);

    if (fileManagerSheet) {

      const data = fileManagerSheet.getDataRange().getValues();

      if (data.length > 1) {

        const headers = data[0];

        const regIdx = headers.indexOf("StudentRegistrationID");

        const fileIdIdx = headers.indexOf("FileID");

        const fileNameIdx = headers.indexOf("FileName");

        const fileUrlIdx = headers.indexOf("FileUrl");

        const docTypeIdx = headers.indexOf("DocType");

        const uploadDateIdx = headers.indexOf("UploadDate");

        const fileSizeIdx = headers.indexOf("FileSize");



        for (let i = 1; i < data.length; i++) {

          const rowRegId = String(data[i][regIdx] || "").trim().toUpperCase();

          if (rowRegId === rId) {

            const rawType = String(data[i][docTypeIdx] || 'Upload');

            const type = rawType.trim();

            result.push({

              id: data[i][fileIdIdx],

              name: data[i][fileNameIdx],

              url: data[i][fileUrlIdx],

              type: type,

              date: safeFmtDate(data[i][uploadDateIdx]),

              size: data[i][fileSizeIdx]

            });

          }

        }

      }

    }



    // 2. Get from GeneratedDocuments Sheet

    const docSheet = ss.getSheetByName(SHEET_NAMES.GENERATED_DOCUMENTS);

    if (docSheet) {

      const data = docSheet.getDataRange().getValues();

      if (data.length > 1) {

        const headers = data[0];

        const regIdx = headers.indexOf("StudentRegistrationID");

        const pdfIdIdx = headers.indexOf("PdfFileId");

        const docTypeIdx = headers.indexOf("DocType");

        const refNumIdx = headers.indexOf("ReferenceNumber");

        const docUrlIdx = headers.indexOf("DocUrl");

        const genDateIdx = headers.indexOf("GeneratedDate");



        for (let i = 1; i < data.length; i++) {

          const rowRegId = String(data[i][regIdx] || "").trim().toUpperCase();

          if (rowRegId === rId) {

            const pdfId = data[i][pdfIdIdx];

            if (!result.some(f => f.id === pdfId)) {

              result.push({

                id: pdfId,

                name: `${data[i][docTypeIdx]}_${data[i][refNumIdx] || 'Manual'}.pdf`,

                url: data[i][docUrlIdx] || `https://drive.google.com/uc?export=view&id=${pdfId}`,

                date: safeFmtDate(data[i][genDateIdx]),

                size: 0,

                type: data[i][docTypeIdx] || 'Generated',

                isMandatory: true,

                source: 'GeneratedDocs'

              });

            }

          }

        }

      }

    }



    // 3. Fallback: Search Drive

    try {

      const folder = DriveApp.getFolderById(getSystemFolderId('uploads'));

      const safeRegId = rId.replace(/\//g, '_');

      const driveFiles = folder.searchFiles(`title contains '${safeRegId}' and trashed = false`);

      while (driveFiles.hasNext()) {

        const file = driveFiles.next();

        const fId = file.getId();

        if (!result.some(r => r.id === fId)) {

          result.push({

            id: fId,

            name: file.getName(),

            url: file.getUrl(),

            date: safeFmtDate(file.getDateCreated()),

            size: file.getSize(),

            type: 'Direct Drive',

            isMandatory: false,

            source: 'Drive'

          });

        }

      }

    } catch (e) {

      Logger.log("Drive search fallback failed: " + e.message);

    }



    // Strict GSV Rule: Certificate files are ONLY visible to the student once their status is Completed!

    const stuData = getStudentDataForDoc(rId);

    const stuStatus = stuData ? String(stuData.ApplicationStatus || stuData.Status || '').trim().toLowerCase() : '';

    const isCompleted = (stuStatus === 'completed');



    let filteredFiles = result;

    if (!isCompleted) {

      filteredFiles = result.filter(f => {

        const t = String(f.type || '').toLowerCase();

        const n = String(f.name || '').toLowerCase();

        const isCert = t.includes('certificate') || t.includes('completion') || n.includes('certificate') || n.includes('completion');

        return !isCert;

      });

    }



    // Sort by date descending

    filteredFiles.sort((a, b) => {

      const getT = (dateStr) => {

        if (!dateStr) return 0;

        const d = new Date(dateStr);

        return isNaN(d.getTime()) ? 0 : d.getTime();

      };

      return getT(b.date) - getT(a.date);

    });



    // 4. Summarize

    const summary = {

      total: filteredFiles.length,

      mandatoryUploaded: mandatoryTypes.filter(m =>

        filteredFiles.some(f => String(f.type || '').toLowerCase().includes(m.toLowerCase()))

      ),

      projectCount: filteredFiles.filter(f =>

        !mandatoryTypes.some(m => String(f.type || '').toLowerCase().includes(m.toLowerCase()))

      ).length

    };

    summary.allMandatoryDone = mandatoryTypes.every(m =>

      summary.mandatoryUploaded.some(mu => mu.toLowerCase() === m.toLowerCase())

    );



    Logger.log(`getStudentFiles for ${rId} took ${new Date().getTime() - startTime}ms. Found ${filteredFiles.length} files.`);

    return { status: 'success', files: filteredFiles, summary: summary };

  } catch (e) {

    Logger.log("Error in getStudentFiles: " + e.toString());

    return { status: 'error', message: e.toString() };

  }

}



function renameStudentFile(regId, fileId, newName) {

  try {

    const file = DriveApp.getFileById(fileId);

    file.setName(newName);



    // Update FileManager sheet

    const sheet = getSheet(SHEET_NAMES.FILE_MANAGER);

    if (sheet) {

      const rowIndex = findRowIndexByValue(sheet, fileId, 'FileID');

      if (rowIndex !== -1) {

        const headers = getHeaders(sheet);

        const nameCol = headers.indexOf('FileName');

        if (nameCol !== -1) {

          sheet.getRange(rowIndex, nameCol + 1).setValue(newName);

        }

      }

    }

    return { status: 'success', message: 'File renamed successfully' };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



function deleteStudentFile(regId, fileId) {

  try {

    const studentResp = getStudentFullData(regId);

    if (studentResp.status !== 'success') return { status: 'error', message: 'Student verification failed.' };

    const student = studentResp.studentData;

    const studentName = getStudentFullName_(student);



    // === DELETION GUARD SYSTEM ===

    let fileName = fileId;

    let isMandatory = false;

    let isAdminGenerated = false;



    const fmSheet = getSheet(SHEET_NAMES.FILE_MANAGER);

    if (fmSheet) {

      const fmData = getSheetDataAsObjects(fmSheet);

      const fileRec = fmData.find(f => f.FileID === fileId || f.DriveID === fileId);

      if (fileRec) {

        fileName = fileRec.FileName || fileId;

        const lowerName = fileName.toLowerCase();

        

        // Block Mandatory Documents

        if (lowerName.includes("bonafide") || lowerName.includes("declaration") || lowerName.includes("id card") || lowerName.includes("college id")) {

          isMandatory = true;

        }

        

        // Block Admin-Generated/Uploaded files

        if (fileRec.UploadedBy === 'Admin' || fileRec.Category === 'System Generated' || fileRec.Category === 'Official') {

          isAdminGenerated = true;

        }

      }

    }



    if (isMandatory) {

      return { 

        status: 'error', 

        message: 'This is a mandatory document (Bonafide/Declaration/ID Card). It cannot be deleted by the student. Please contact Admin if a replacement is needed.' 

      };

    }



    if (isAdminGenerated) {

      return { 

        status: 'error', 

        message: 'This document was generated or uploaded by an Admin and cannot be deleted by the student.' 

      };

    }

    // =============================



    // Instead of deleting, we raise a request for standard files

    const requestId = generateUniqueId('DEL', SHEET_NAMES.STUDENT_REQUESTS, 0);



    const res = saveStudentRequest_({

      RequestID: requestId,

      RegistrationID: regId,

      StudentName: studentName,

      RequestType: 'Document Delete',

      Reason: `Request to delete file: ${fileName} (ID: ${fileId})`,

      Status: 'Pending',

      TargetDate: formatDateISO(new Date())

    });



    if (res.status === 'success') {

      createAdminNotification('Document Delete', `New deletion request from ${studentName} for file ${fileName}`);

      return { status: 'success', message: 'Deletion request submitted. Admin will review it shortly.' };

    } else {

      return res;

    }

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



function uploadStudentFile(regId, base64Data, fileName) {

  const lock = LockService.getScriptLock();

  try {

    lock.waitLock(30000); // Wait for lock up to 30s



    if (!base64Data || typeof base64Data !== 'string') {

      throw new Error("No file data received. Please ensure the file size does not exceed 5MB.");

    }



    const contentType = base64Data.substring(base64Data.indexOf(":") + 1, base64Data.indexOf(";"));

    const bytes = Utilities.base64Decode(base64Data.split(",")[1]);

    const rId = String(regId || "");

    const finalFileName = `${rId.replace(/\//g, '_')}_${fileName}`;

    const blob = Utilities.newBlob(bytes, contentType, finalFileName);



    // Organize into subfolders

    const lowerName = fileName.toLowerCase();

    let subType = 'General Uploads';

    if (lowerName.includes("bonafide") || lowerName.includes("declaration") || lowerName.includes("collegeid") || lowerName.includes("other") || lowerName.includes("profile")) {

      subType = 'mandatory';

    }



    const studentFolder = getOrCreateStudentFolder(regId, subType);

    if (!studentFolder) {

      throw new Error("Unable to access or create your upload folder on Google Drive. Please contact the administrator.");

    }

    const file = studentFolder.createFile(blob);

    try {

      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

    } catch (sharingError) {

      Logger.log(`Warning: Failed to set public sharing on uploaded file ${file.getId()}: ${sharingError.toString()}`);

    }

    const fileUrl = file.getUrl();

    const fileId = file.getId();

    const fileSize = file.getSize();

    const uploadDate = new Date();



    // 1. UPDATE SHEETS (Registrations, Applications, Consolidated) IF MANDATORY DOC / PROFILE PHOTO

    let docType = "General Upload";

    let targetColNames = [];



    // Determine column based on file prefix sent from frontend

    if (lowerName.startsWith("bonafide")) { targetColNames = ["BonafideUrl", "Bonafide"]; docType = "Bonafide"; }

    else if (lowerName.startsWith("declaration")) { targetColNames = ["DeclarationUrl", "Declaration"]; docType = "Declaration"; }

    else if (lowerName.startsWith("collegeid") || lowerName.startsWith("college_id")) { targetColNames = ["CollegeIdUrl", "CollegeIDUrl", "CollegeId"]; docType = "College ID"; }

    else if (lowerName.startsWith("profilephoto") || lowerName.startsWith("profile_photo") || lowerName.startsWith("profile") || lowerName.startsWith("photo")) { targetColNames = ["ProfilePhotoUrl", "PhotoUrl", "ProfilePhoto", "Photo"]; docType = "Profile Photo"; }

    else if (lowerName.startsWith("other")) { targetColNames = ["OtherUrl", "Other"]; docType = "Other Doc"; }



    const sheetsToUpdate = [SHEET_NAMES.REGISTRATIONS, SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations', SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations', SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations', SHEET_NAMES.APPLICATIONS, SHEET_NAMES.CONSOLIDATED_INTERNSHIPS, SHEET_NAMES.FACULTY_CONSOLIDATED || 'Faculty_Consolidated_Internships', SHEET_NAMES.EMPLOYEE_CONSOLIDATED || 'Employee_Consolidated_Internships', SHEET_NAMES.APPRENTICE_CONSOLIDATED || 'Apprentice_Consolidated_Internships'];

    sheetsToUpdate.forEach(sheetName => {

      if (!sheetName) return;

      const sh = getSheet(sheetName);

      if (!sh) return;

      try {

        const data = sh.getDataRange().getValues();

        if (data.length < 2) return;

        const headers = data[0].map(h => String(h).trim());

        const regIdCol = headers.indexOf("RegistrationID");

        if (regIdCol === -1) return;



        let targetColIndex = -1;

        for (let colName of targetColNames) {

          targetColIndex = headers.indexOf(colName);

          if (targetColIndex !== -1) break;

        }



        if (targetColIndex !== -1) {

          for (let i = 1; i < data.length; i++) {

            if (String(data[i][regIdCol]).trim().toUpperCase() === rId.trim().toUpperCase()) {

              sh.getRange(i + 1, targetColIndex + 1).setValue(fileUrl);

              break;

            }

          }

        }

      } catch (e) {

        Logger.log(`Error updating sheet ${sheetName}: ${e.message}`);

      }

    });



    // 2. RECORD IN FILE MANAGER SHEET

    const fileManagerSheet = getSheet(SHEET_NAMES.FILE_MANAGER);

    if (fileManagerSheet) {

      fileManagerSheet.appendRow([fileId, rId, fileName, fileUrl, docType, uploadDate, fileSize, 'Active']);

    }



    // 3. AUTO-RFID ASSIGNMENT TRIGGER

    try {

      checkAndAutoAssignRfid(rId);

    } catch (e) {

      Logger.log("Auto-assign failure on upload: " + e.toString());

    }



    logActivity('Student File Upload', `Student ${rId} uploaded file: ${fileName} as ${docType}`);

    return { status: 'success', message: 'File uploaded successfully', fileId: fileId, url: fileUrl };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  } finally {

    lock.releaseLock();

  }

}





/**

 * Triggered on document upload: Automatically assigns RFID if internship is valid and docs are ready

 */

function checkAndAutoAssignRfid(regId) {

  try {

    const resp = getStudentFullData(regId);

    if (resp.status !== 'success' || !resp.studentData) return;

    const student = resp.studentData;



    const statusVal = String(student.ApplicationStatus || student.Status || '').toLowerCase();

    const isApproved = (statusVal === 'approved' || statusVal === 'active');

    if (!isApproved) return;



    // Rule 1: Internship must not be expired (Strict Precaution)
    if (isCandidateInternshipExpired_(student)) {
      Logger.log(`checkAndAutoAssignRfid: Student ${regId} internship period has expired. Skipping auto-assign.`);
      return;
    }

    // Rule 2: Automation setting must be 'Auto'

    const appSettings = getAppSettings();

    if (appSettings.status !== 'success' || !appSettings.settings || appSettings.settings['RFID_Automation_Mode'] !== 'Auto') return;



    // Rule 3: Must have mandatory docs (strictly check availability)

    const b = String(student.BonafideUrl || '').trim();

    const d = String(student.DeclarationUrl || '').trim();

    const cid = String(student.CollegeIdUrl || '').trim();

    const isDocReady = (b !== '' && d !== '' && cid !== '');

    if (!isDocReady) return;



    // Rule 4: No tag already assigned

    if (student.RFID_TagID && String(student.RFID_TagID).trim() !== '') return;



    // All checks passed -> Assign available RFID

    assignAvailableRfid(regId);



  } catch (e) {

    Logger.log("Error in checkAndAutoAssignRfid for " + regId + ": " + e.toString());

  }

}



function submitDocumentReplacementRequest(regId, docType, fileName, base64Data) {

  try {

    if (!base64Data || typeof base64Data !== 'string') {

      throw new Error("No file data received. Please ensure the file size does not exceed 5MB.");

    }

    const studentName = getStudentName_(regId);

    const requestId = 'REQ-' + Utilities.getUuid().substring(0, 8).toUpperCase();

    const dateStr = formatDate(new Date());



    // First upload the new file somewhere, but we shouldn't overwrite the existing one yet!

    // We should upload it to a "Pending Approvals" folder or just upload it and store url in "AttachmentUrl"

    const contentType = base64Data.substring(base64Data.indexOf(":") + 1, base64Data.indexOf(";"));

    const bytes = Utilities.base64Decode(base64Data.split(",")[1]);

    const finalFileName = `PENDING_${regId}_${fileName}`;

    const blob = Utilities.newBlob(bytes, contentType, finalFileName);



    const studentFolder = getOrCreateStudentFolder(regId, 'General Uploads');

    if (!studentFolder) {

      throw new Error("Unable to access or create your upload folder on Google Drive. Please contact the administrator.");

    }

    const file = studentFolder.createFile(blob);

    const fileUrl = file.getUrl();



    saveStudentRequest_({

      RequestID: requestId,

      RegistrationID: regId,

      StudentName: studentName,

      RequestType: 'Document Replacement',

      Section: 'File Manager',

      TargetDate: dateStr,

      Reason: `Request to replace mandatory document: ${docType}. New FileID: ${file.getId()}`,

      LeaveType: docType,

      AttachmentUrl: fileUrl,

      Status: 'Pending'

    });



    logActivity('Document Replacement', regId, `Requested replacement for ${docType}`);

    createAdminNotification("Document Replacement", `Student ${studentName} (${regId}) requested to replace ${docType}`);

    return { status: 'success', message: 'Replacement request submitted successfully.' };

  } catch (e) {

    Logger.log('Error in submitDocumentReplacementRequest: ' + e.toString());

    return { status: 'error', message: e.toString() };

  }

}



function submitDocumentDeletionRequest(regId, docType, fileName, reason) {

  try {

    const studentName = getStudentName_(regId);

    const requestId = 'REQ-DEL-' + Utilities.getUuid().substring(0, 8).toUpperCase();

    const dateStr = formatDate(new Date());



    saveStudentRequest_({

      RequestID: requestId,

      RegistrationID: regId,

      StudentName: studentName,

      RequestType: 'Document Deletion',

      Section: 'File Manager',

      TargetDate: dateStr,

      Reason: `Request to delete mandatory document: ${docType}. Reason: ${reason}`,

      LeaveType: docType, // Store docType here for the processor

      Status: 'Pending Admin Approval'

    });



    logActivity('Document Deletion Request', `Student ${regId} requested to delete ${docType}`);

    createAdminNotification("Document Deletion", `Student ${studentName} (${regId}) requested to delete ${docType}`);

    return { status: 'success', message: 'Deletion request submitted successfully.' };

  } catch (e) {

    Logger.log('Error in submitDocumentDeletionRequest: ' + e.toString());

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Daily trigger function to auto-delete student files 30 days after internship end.

 * Excludes generated certificates.

 */

function autoDeleteExpiredStudentFiles() {

  try {

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    const students = getSheetDataAsObjects(regSheet);

    const today = new Date();



    students.forEach(s => {

      if (!s.InternshipEndDate) return;

      const endDate = new Date(s.InternshipEndDate);

      const expiryDate = new Date(endDate);

      expiryDate.setDate(expiryDate.getDate() + 30);



      if (today > expiryDate) {

        Logger.log(`Cleaning up files for ${s.RegistrationID} (Expired: ${formatDate(expiryDate)})`);

        const folder = DriveApp.getFolderById(getSystemFolderId('uploads'));

        const files = folder.getFiles();

        const safePrefix = s.RegistrationID.replace(/\//g, '_');



        while (files.hasNext()) {

          const file = files.next();

          // DO NOT delete if it matches certificate naming pattern

          if (file.getName().includes(safePrefix) && !file.getName().includes('Certificate')) {

            file.setTrashed(true);

            Logger.log(`Deleted: ${file.getName()}`);

          }

        }

      }

    });

  } catch (e) {

    Logger.log('Error in autoDeleteExpiredStudentFiles: ' + e.toString());

  }

}





/**

 * Gets timeline data for a specific student

 */

function getStudentTimelineData(regId) {

  try {

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    const consolidatedSheet = getSheet(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS);

    const closedSheet = getSheet('Closed and Opt-out');

    const allStudents = [

      ...getSheetDataAsObjects(regSheet),

      ...(consolidatedSheet ? getSheetDataAsObjects(consolidatedSheet) : []),

      ...(closedSheet ? getSheetDataAsObjects(closedSheet) : [])

    ];

    const targetRid = String(regId || '').trim();

    const student = allStudents.find(s => String(s.RegistrationID || '').trim().toUpperCase() === targetRid.toUpperCase());



    if (!student) return { status: 'error', message: 'Student not found: ' + regId };



    const resolveDate = (val) => {

      if (!val) return null;

      if (val instanceof Date) return new Date(val.setHours(0, 0, 0, 0));

      let s = String(val).trim();

      if (!s) return null;

      let d = new Date(s);

      if (isNaN(d.getTime())) {

        let p = s.split(/[\/\-\.]/);

        if (p.length === 3) {

          d = new Date(p[2], p[1] - 1, p[0]); // DD-MM-YYYY

          if (isNaN(d.getTime())) d = new Date(p[0], p[1] - 1, p[2]); // YYYY-MM-DD

        }

      }

      return d;

    };



    const startDate = resolveDate(student.InternshipStartDate);

    const endDate = resolveDate(student.InternshipEndDate);

    const today = new Date();

    today.setHours(0, 0, 0, 0);



    if (!startDate || isNaN(startDate.getTime()) || !endDate || isNaN(endDate.getTime())) {

      return {

        status: 'success',

        message: 'No internship dates set for this student.',

        summary: { startDate: null, endDate: null, totalDays: 0 },

        timeline: [],

        data: []

      };

    }



    // Normalize all dates to midnight to avoid time-component comparison issues

    startDate.setHours(0, 0, 0, 0);

    endDate.setHours(0, 0, 0, 0);



    const diarySheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    const diaryEntries = getSheetDataAsObjects(diarySheet).filter(e => e.StudentRegistrationID === regId);



    const attSheet = getSheet(SHEET_NAMES.ATTENDANCE);

    const attRecords = getSheetDataAsObjects(attSheet).filter(a => String(a.StudentRegistrationID || a.RegistrationID || '').trim().toUpperCase() === targetRid.toUpperCase());



    // Also load approved attendance requests & diary correction requests

    const approvedRequestsMap = new Map();

    try {

      const otpSheet = getSheet(SHEET_NAMES.ATTENDANCE_OTP);

      if (otpSheet) {

        const otpData = getSheetDataAsObjects(otpSheet).filter(o => 

          String(o.RegistrationID || o.StudentRegistrationID || '').trim().toUpperCase() === targetRid.toUpperCase() &&

          String(o.Status || '').trim().toLowerCase() === 'approved'

        );

        otpData.forEach(o => {

          const d = formatDateISO(o.TargetDate || o.Date);

          if (d) approvedRequestsMap.set(d, o);

        });

      }

    } catch(eOtp) {}



    try {

      const reqSheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

      if (reqSheet) {

        const reqData = getSheetDataAsObjects(reqSheet).filter(r => 

          String(r.RegistrationID || r.StudentRegistrationID || '').trim().toUpperCase() === targetRid.toUpperCase() &&

          String(r.Status || '').trim().toLowerCase() === 'approved'

        );

        reqData.forEach(r => {

          const d = formatDateISO(r.TargetDate || r.Date);

          if (d && !approvedRequestsMap.has(d)) approvedRequestsMap.set(d, r);

        });

      }

    } catch(eReq) {}



    const timeline = [];

    const diaryMap = new Map();

    diaryEntries.forEach(e => {

      const d = formatDateISO(e.Date);

      if (d) diaryMap.set(d, e);

    });



    const attMap = new Map();

    attRecords.forEach(a => {

      const d = formatDateISO(a.Date);

      if (d) attMap.set(d, a);

    });



    let currentDate = new Date(startDate);

    let enteredCount = 0;

    let missingCount = 0;

    let odCount = 0;

    let wfhCount = 0;



    let loopSafety = 0;

    const maxDays = 1000;



    while (currentDate <= endDate && loopSafety < maxDays) {

      loopSafety++;



      const dateStr = formatDateISO(currentDate);

      const isSunday = currentDate.getDay() === 0;

      const isFuture = currentDate > today;

      const entry = diaryMap.get(dateStr);

      const attendance = attMap.get(dateStr);

      let attStatus = attendance ? (attendance.Status || '') : '';

      const approvedReq = approvedRequestsMap.get(dateStr);



      if (approvedReq) {

        if (!attendance || !attStatus || attStatus === 'No Record' || attStatus === 'Absent' || attStatus === 'Missed') {

          attStatus = 'Present';

        }

      }



      // Normalize display attendance (clean 'DiaryCorrection (Present)' to 'Present')

      let displayAtt = attStatus;

      if (attStatus.toLowerCase().includes('present')) {

        displayAtt = 'Present';

      }



      let finalStatus = 'No Record';

      if (isFuture) {

        finalStatus = 'Upcoming';

      } else if (entry) {

        finalStatus = entry.Status || 'Entered';

      } else if (isSunday) {

        finalStatus = 'Sunday';

      } else if (attStatus.includes('OD') || attStatus.includes('On Duty')) {

        finalStatus = 'On-Duty';

        odCount++;

      } else if (attStatus.includes('WFH')) {

        finalStatus = 'WFH';

        wfhCount++;

      } else if (attStatus.includes('Absent')) {

        finalStatus = 'Absent';

      } else if (attStatus.includes('Missed')) {

        finalStatus = 'Missed';

      } else if (attStatus.toLowerCase().includes('present') || approvedReq || attendance) {

        finalStatus = 'Not Entered';

      }



      timeline.push({

        date: dateStr,

        status: finalStatus,

        attendance: displayAtt || (isSunday ? 'Holiday' : (isFuture ? 'Upcoming' : 'No Record')),

        isToday: currentDate.getTime() === today.getTime(),

        isSunday: isSunday

      });



      if (entry) enteredCount++;

      else if (!isSunday && !isFuture && finalStatus !== 'Absent') missingCount++;



      currentDate.setDate(currentDate.getDate() + 1);

    }



    return {

      status: 'success',

      timeline: timeline,

      summary: {

        totalDays: timeline.length,

        entered: enteredCount,

        missing: missingCount,

        od: odCount,

        wfh: wfhCount,

        startDate: formatDateISO(startDate),

        endDate: formatDateISO(endDate),

        remaining: today > endDate ? 0 : Math.round((endDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24)) + 1

      }

    };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Approves or updates status of a diary entry (Supports toggle & revoking)

 */

function approveDiaryEntry(regId, date, targetStatus) {

  try {

    const sheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    if (!sheet) return { status: 'error', message: 'StudentDiary sheet not found' };

    const data = sheet.getDataRange().getValues();

    const headers = data[0];

    const regIdCol = headers.indexOf("StudentRegistrationID") !== -1 ? headers.indexOf("StudentRegistrationID") : headers.indexOf("RegistrationID");

    const dateCol = headers.indexOf("Date");

    const statusCol = headers.indexOf("Status");



    const targetDateStr = formatDateISO(date);

    const targetRid = String(regId || '').trim().toUpperCase();



    for (let i = 1; i < data.length; i++) {

      const entryReg = String(data[i][regIdCol] || '').trim().toUpperCase();

      const entryDateStr = formatDateISO(data[i][dateCol]);

      if (entryReg === targetRid && entryDateStr === targetDateStr) {

        const curStatus = String(data[i][statusCol] || 'Entered');

        let newStatus = targetStatus;

        if (!newStatus) {

          newStatus = (curStatus === 'Approved') ? 'Entered' : 'Approved';

        }

        sheet.getRange(i + 1, statusCol + 1).setValue(newStatus);

        SpreadsheetApp.flush();

        return { 

          status: 'success', 

          newStatus: newStatus,

          message: newStatus === 'Approved' ? 'Diary entry approved!' : 'Approval revoked (set back to Entered).' 

        };

      }

    }

    return { status: 'error', message: 'Diary entry not found for date: ' + targetDateStr };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Approves all submitted/pending diary entries for a specific student

 */

function approveAllStudentDiaryEntries(regId) {

  try {

    if (!regId) return { status: 'error', message: 'Registration ID is required' };

    const sheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    if (!sheet) return { status: 'error', message: 'StudentDiary sheet not found.' };



    const data = sheet.getDataRange().getValues();

    const headers = data[0];

    const findCol = (name) => {

      let idx = headers.indexOf(name);

      if (idx === -1) idx = headers.findIndex(h => String(h).replace(/\s+/g, '').toLowerCase() === name.toLowerCase());

      return idx;

    };

    const regIdCol = findCol("StudentRegistrationID") !== -1 ? findCol("StudentRegistrationID") : findCol("RegistrationID");

    const dateCol = findCol("Date");

    const contentCol = findCol("Content");

    const statusCol = findCol("Status");



    const targetRid = String(regId).trim().toUpperCase();

    let approvedCount = 0;

    const existingDates = new Set();



    // 1. Approve all existing entries for this student

    for (let i = 1; i < data.length; i++) {

      const rowRid = String(data[i][regIdCol] || '').trim().toUpperCase();

      if (rowRid === targetRid) {

        const dStr = formatDateISO(data[i][dateCol]);

        if (dStr) existingDates.add(dStr);

        if (statusCol !== -1) {

          const curStatus = String(data[i][statusCol] || '').trim();

          if (curStatus !== 'Approved') {

            sheet.getRange(i + 1, statusCol + 1).setValue('Approved');

            approvedCount++;

          }

        }

      }

    }



    // 2. Fetch student details and timeline

    const studentInfo = getStudentFullData(regId);

    let studentName = 'Student';

    let projectName = 'Internship Project Tasks';

    let startDate = null;

    let endDate = null;

    if (studentInfo.status === 'success' && studentInfo.studentData) {

      const sd = studentInfo.studentData;

      studentName = getStudentFullName_(sd);

      projectName = sd.Project || sd.ProjectTitle || sd.ProjectName || sd.SkillLearned || sd.InterestedArea || 'Domain Tasks & Project Work';

      startDate = parseLocalDate_(sd.InternshipStartDate || sd.StartDate);

      endDate = parseLocalDate_(sd.InternshipEndDate || sd.EndDate);

    }



    // 3. For all attended/scheduled days without a diary entry, auto-generate approved entries

    if (startDate && endDate) {

      const today = new Date();

      today.setHours(0, 0, 0, 0);

      const effectiveEnd = endDate < today ? endDate : today;



      // Get attendance records to check present/attended days

      const attSheet = getSheet(SHEET_NAMES.ATTENDANCE);

      const attMap = new Map();

      if (attSheet) {

        const attData = getSheetDataAsObjects(attSheet);

        attData.forEach(a => {

          const aRid = String(a.StudentRegistrationID || a.RegistrationID || '').trim().toUpperCase();

          if (aRid === targetRid) {

            const d = formatDateISO(a.Date);

            if (d) attMap.set(d, a.Status || 'Present');

          }

        });

      }



      let cur = new Date(startDate);

      let dayCounter = 1;

      while (cur <= effectiveEnd) {

        if (cur.getDay() !== 0) { // Skip Sundays

          const dIso = formatDateISO(cur);

          if (!existingDates.has(dIso)) {

            const attSt = attMap.get(dIso);

            // Include days that are present/attended or within internship

            const defaultWork = `Completed practical training, task activities, and documentation for ${projectName} (Day ${dayCounter}).`;

            const newRow = headers.map(h => {

              const hClean = String(h).replace(/\s+/g, '').toLowerCase();

              if (hClean.includes('reg')) return regId;

              if (hClean === 'date') return dIso;

              if (hClean === 'content') return defaultWork;

              if (hClean === 'status') return 'Approved';

              if (hClean.includes('timestamp')) return new Date();

              if (hClean.includes('studentname') || hClean === 'name') return studentName;

              if (hClean.includes('hour')) return 8;

              if (hClean.includes('remark')) return 'Verified & approved by Supervisor';

              return '';

            });

            sheet.appendRow(newRow);

            existingDates.add(dIso);

            approvedCount++;

          }

          dayCounter++;

        }

        cur.setDate(cur.getDate() + 1);

      }

    }



    // 4. Also approve any pending diary requests in StudentRequests / AttendanceOTP

    try {

      const sReqSheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

      if (sReqSheet) {

        const sData = sReqSheet.getDataRange().getValues();

        const sHeaders = sData[0];

        const sRegCol = sHeaders.indexOf('RegistrationID');

        const sTypeCol = sHeaders.indexOf('RequestType');

        const sStatCol = sHeaders.indexOf('Status');

        if (sRegCol !== -1 && sStatCol !== -1) {

          for (let si = 1; si < sData.length; si++) {

            const sRid = String(sData[si][sRegCol] || '').trim().toUpperCase();

            const sType = String(sData[si][sTypeCol] || '').toLowerCase();

            const sStat = String(sData[si][sStatCol] || '').toLowerCase();

            if (sRid === targetRid && sType.includes('diar') && (sStat === 'pending' || sStat === 'awaiting otp')) {

              sReqSheet.getRange(si + 1, sStatCol + 1).setValue('Approved');

            }

          }

        }

      }

    } catch(e) {}



    SpreadsheetApp.flush();

    return { status: 'success', count: approvedCount, message: `Successfully approved all diary entries for ${targetRid}.` };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Bulk updates App Settings (for templates)

 */

function updateAppSettings(settings) {

  try {

    const sheet = getSheet(SHEET_NAMES.APP_SETTINGS);

    const lock = LockService.getScriptLock();

    lock.waitLock(10000);



    for (const [key, value] of Object.entries(settings)) {

      const rowIndex = findRowIndexByValue(sheet, key, 'SettingKey');

      if (rowIndex !== -1) {

        sheet.getRange(rowIndex, 2).setValue(value);

      } else {

        sheet.appendRow([key, value]);

      }



      // 🔄 SYNC: If updating RFID Automation, also update Switch_Status

      if (key === 'RFID_Automation_Mode') {

        const switchSheet = getSheet(SHEET_NAMES.SWITCH_STATUS);

        if (switchSheet) {

          const swRow = findRowIndexByValue(switchSheet, 'rfidAutomationToggle', 'SwitchKey');

          if (swRow !== -1) {

            switchSheet.getRange(swRow, 2).setValue(value === 'Auto' ? 'ON' : 'OFF');

            switchSheet.getRange(swRow, 3).setValue(new Date());

          }

        }

      }

    }



    lock.releaseLock();

    return { status: 'success', message: 'Settings updated successfully' };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



function saveAdminComment(regId, date, comment) {

  try {

    const sheet = getSheet(SHEET_NAMES.ATTENDANCE);

    const data = sheet.getDataRange().getValues();

    const headers = data[0];

    const regIdCol = headers.indexOf("StudentRegistrationID");

    const dateCol = headers.indexOf("Date");

    const commentCol = headers.indexOf("AdminComment");

    const isReadCol = headers.indexOf("IsCommentRead");



    if (regIdCol === -1 || dateCol === -1 || commentCol === -1) {

      // If columns are missing, we might need to initialize them or just return error

      return { status: 'error', message: 'Attendance table schema mismatch.' };

    }



    const targetDate = formatDateISO(date);

    let rowFound = false;



    for (let i = 1; i < data.length; i++) {

      const rowDate = formatDateISO(data[i][dateCol]);

      if (data[i][regIdCol] === regId && rowDate === targetDate) {

        sheet.getRange(i + 1, commentCol + 1).setValue(comment);

        if (isReadCol !== -1) sheet.getRange(i + 1, isReadCol + 1).setValue(false);

        rowFound = true;

        break;

      }

    }



    if (!rowFound) {

      // Create a dummy record just for the comment if no attendance exists? 

      // User says "misssed its attendent show as pending / absent", so we can add a record with status 'Absent'

      const lastId = data.length > 1 ? parseInt(data[data.length - 1][0]) || 0 : 0;

      const newRow = new Array(headers.length).fill('');

      newRow[0] = lastId + 1; // AttendanceID

      newRow[regIdCol] = regId;

      newRow[dateCol] = new Date(date);

      newRow[headers.indexOf("Status")] = 'Absent';

      newRow[commentCol] = comment;

      if (isReadCol !== -1) newRow[isReadCol] = false;

      newRow[headers.indexOf("Timestamp")] = new Date();

      sheet.appendRow(newRow);

    }



    return { status: 'success', message: 'Comment saved successfully.' };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



function markAdminCommentAsRead(regId, date) {

  try {

    const sheet = getSheet(SHEET_NAMES.ATTENDANCE);

    const data = sheet.getDataRange().getValues();

    const headers = data[0];

    const regIdCol = headers.indexOf("StudentRegistrationID");

    const dateCol = headers.indexOf("Date");

    const isReadCol = headers.indexOf("IsCommentRead");



    if (regIdCol === -1 || dateCol === -1 || isReadCol === -1) return { status: 'error', message: 'Missing columns.' };



    const targetDate = formatDateISO(date);



    for (let i = 1; i < data.length; i++) {

      const rowDate = formatDateISO(data[i][dateCol]);

      if (data[i][regIdCol] === regId && rowDate === targetDate) {

        sheet.getRange(i + 1, isReadCol + 1).setValue(true);

        return { status: 'success' };

      }

    }

    return { status: 'error', message: 'Record not found.' };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Standardizes all date columns across the project sheets to YYYY-MM-DD format.

 * Only changes dates that are not already in that specific string format.

 */

function standardizeSheetDates() {

  try {

    const sheetsToProcess = [

      { name: SHEET_NAMES.REGISTRATIONS, dateCols: ["DateofBirth", "InternshipStartDate", "InternshipEndDate", "CertificateIssuedDate"] },

      { name: SHEET_NAMES.TASKS, dateCols: ["DueDate", "AssignedDate", "CompletedDate"] },

      { name: SHEET_NAMES.PROJECTS, dateCols: ["StartDate", "EndDate", "AssignedDate", "CompletedDate"] },

      { name: SHEET_NAMES.ATTENDANCE, dateCols: ["Date", "Timestamp"] }

    ];



    let totalUpdated = 0;

    let details = [];



    sheetsToProcess.forEach(target => {

      const sheet = getSheet(target.name);

      if (!sheet) return;



      const data = sheet.getDataRange().getValues();

      if (data.length <= 1) return;



      const headers = data[0];

      const colIndices = target.dateCols.map(name => headers.indexOf(name)).filter(idx => idx > -1);



      if (colIndices.length === 0) return;



      let sheetUpdatedCount = 0;

      for (let i = 1; i < data.length; i++) {

        colIndices.forEach(colIdx => {

          let cellValue = data[i][colIdx];

          if (!cellValue) return;



          // Check if it's already a string in YYYY-MM-DD format

          const dateStrPattern = /^\d{4}-\d{2}-\d{2}$/;

          if (typeof cellValue === 'string' && dateStrPattern.test(cellValue)) {

            return; // Skip if already correct

          }



          // Try to convert to Date and then to YYYY-MM-DD

          const formatted = formatDate(cellValue);

          if (formatted && formatted !== 'N/A' && formatted !== cellValue) {

            sheet.getRange(i + 1, colIdx + 1).setValue(formatted);

            sheetUpdatedCount++;

          }

        });

      }

      if (sheetUpdatedCount > 0) {

        details.push(`${target.name}: ${sheetUpdatedCount} dates standardized`);

        totalUpdated += sheetUpdatedCount;

      }

    });



    return {

      status: 'success',

      message: totalUpdated > 0 ? `Standardized ${totalUpdated} dates across sheets.` : "All dates are already standardized.",

      details: details.join(', ')

    };

  } catch (e) {

    Logger.log("Error in standardizeSheetDates: " + e.toString());

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Parses time string like "09:30 AM" into minutes from midnight.

 */

function parseTime_(timeStr) {

  if (!timeStr || typeof timeStr !== 'string') return 0;

  const match = timeStr.match(/(\d+):(\d+)\s*(AM|PM)/i);

  if (!match) return 0;

  let hours = parseInt(match[1]);

  let minutes = parseInt(match[2]);

  let ampm = match[3].toUpperCase();

  if (ampm === 'PM' && hours < 12) hours += 12;

  if (ampm === 'AM' && hours === 12) hours = 0;

  return hours * 60 + minutes;

}



/**

 * Generates a base64 PDF of a single day attendance slip.

 */

function generateDaySlipPDF(regId, dateISO) {

  try {

    const attSheet = getSheet(SHEET_NAMES.ATTENDANCE);

    const records = getSheetDataAsObjects(attSheet);

    // ⭐️ Skip Denied records; prefer record with OutTime (checkout done)

    const dayRecords = records.filter(r => String(r.StudentRegistrationID) === String(regId) && formatDateISO(r.Date) === dateISO && String(r.Status || '').toUpperCase() !== 'DENIED');

    const record = dayRecords.find(r => r.OutTime && r.OutTime !== '') || (dayRecords.length > 0 ? dayRecords[dayRecords.length - 1] : null);



    const detailsResp = getStudentFullData(regId);

    const student = detailsResp.studentData;



    if (!student) return { status: 'error', message: 'Student details not found' };



    const branding = getReportBrandingHeader("Daily Attendance Slip");

    const html = `

       <html>

       <head>

         <style>

           body { font-family: 'Segoe UI', Arial, sans-serif; padding: 40px; color: #333; }

           .slip-card { border: 2px solid #4361ee; padding: 30px; border-radius: 15px; box-shadow: 0 10px 20px rgba(0,0,0,0.1); }

           .title { text-align: center; font-size: 24px; font-weight: bold; color: #4361ee; margin-bottom: 25px; border-bottom: 2px solid #4361ee; padding-bottom: 10px; }

           .row { display: flex; justify-content: space-between; margin-bottom: 15px; padding-bottom: 8px; border-bottom: 1px solid #f0f0f0; }

           .label { font-weight: bold; color: #4b5563; }

           .footer { margin-top: 40px; text-align: center; font-size: 10px; color: #9ca3af; }

         </style>

       </head>

       <body>

         ${branding}

         <div class="slip-card">

           <div class="title">ATTENDANCE DAY SLIP</div>

           <div class="row"><span class="label">Student Name:</span> <span>${getStudentFullName_(student)}</span></div>

           <div class="row"><span class="label">Registration ID:</span> <span>${regId}</span></div>

           <div class="row"><span class="label">Date:</span> <span>${formatDate(record ? record.Date : dateISO)}</span></div>

           <div class="row"><span class="label">Arrival Time:</span> <span>${(record && record.InTime) || 'N/A'}</span></div>

           <div class="row"><span class="label">Departure Time:</span> <span>${(record && record.OutTime) || 'N/A'}</span></div>

           <div class="row"><span class="label">Entry Mode:</span> <span>${(record && record.EntryMode) || 'N/A'}</span></div>

           <div class="row"><span class="label">Status:</span> <span>${(record && record.Status) || 'Absent'}</span></div>

         </div>

         <div class="footer">This is a system-generated document. | GSV Electrical Enterprises</div>

       </body>

       </html>

     `;



    const blob = Utilities.newBlob(html, "text/html", `Slip_${regId}_${dateISO}.html`);

    const pdf = blob.getAs("application/pdf");

    return {

      status: 'success',

      pdfBase64: Utilities.base64Encode(pdf.getBytes()),

      fileName: `AttendanceSlip_${dateISO}.pdf`

    };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Submits a grace period extension request.

 */

function requestGracePeriod(regId, reason, start, end, areas) {

  try {

    const sheet = getSheet(SHEET_NAMES.ATTENDANCE_OTP);

    const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].map(h => h.toString().trim());

    const id = "GP-" + new Date().getTime();



    const rowData = headers.map(h => {

      switch (h) {

        case 'ID': return id;

        case 'RegistrationID': return regId;

        case 'OTP': return '';

        case 'ActionType': return 'GracePeriod';

        case 'ExpiryTimestamp': return new Date(end);

        case 'TargetDate': return new Date(start);

        case 'Reason': return reason;

        case 'Status': return 'Pending';

        case 'LeaveType': return areas;

        case 'AttachmentUrl': return '';

        default: return '';

      }

    });



    sheet.appendRow(rowData);

    SpreadsheetApp.flush();



    // Also save to unified StudentRequests sheet

    const studentName = getStudentName_(regId);

    saveStudentRequest_({

      RequestID: id,

      RegistrationID: regId,

      StudentName: studentName,

      RequestType: 'GracePeriod',

      TargetDate: new Date(start),

      EndDate: new Date(end),

      Reason: reason,

      LeaveType: typeof areas === 'string' ? areas : (Array.isArray(areas) ? areas.join(', ') : '')

    });



    return { status: 'success', message: 'Grace period extension request submitted to Admin.' };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Submits a portal access extension request from the login screen.

 */

function submitPortalExtensionRequest(regId, mobile, durationDays, reason) {

  try {

    const sheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (!sheet) return { status: 'error', message: 'Registrations sheet not found.' };



    const inputRegId = regId ? regId.toString().trim().toUpperCase() : "";

    const inputMobile = mobile ? mobile.toString().trim() : "";



    const data = getSheetDataAsObjects(sheet);

    let student = data.find(s => {

      const sRegId = s.RegistrationID ? s.RegistrationID.toString().trim().toUpperCase() : "";

      const sMobile = s.MobileNumber ? s.MobileNumber.toString().trim() : "";

      return (sRegId === inputRegId && sMobile === inputMobile);

    });



    if (!student) {

      // Check Consolidated sheet

      const consolidatedSheet = getSheet(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS);

      if (consolidatedSheet) {

        const consolidatedData = getSheetDataAsObjects(consolidatedSheet);

        student = consolidatedData.find(s => {

          const sRegId = s.RegistrationID ? s.RegistrationID.toString().trim().toUpperCase() : "";

          const sMobile = s.MobileNumber ? s.MobileNumber.toString().trim() : "";

          return (sRegId === inputRegId && sMobile === inputMobile);

        });

      }

    }



    if (!student) {

      return { status: 'error', message: 'Verification failed. Registration ID or Mobile Number is incorrect.' };

    }



    // Check if there is already a pending request of ActionType GracePeriod

    const otpSheet = getSheet(SHEET_NAMES.ATTENDANCE_OTP);

    if (otpSheet) {

      const otpData = getSheetDataAsObjects(otpSheet);

      const pendingReq = otpData.find(r => 

        String(r.RegistrationID || "").trim().toLowerCase() === String(inputRegId).toLowerCase() &&

        String(r.Status || "").trim() === 'Pending' &&

        String(r.ActionType || "").trim() === 'GracePeriod'

      );

      if (pendingReq) {

        return { status: 'error', message: 'You already have a pending extension request.' };

      }

    }



    // Calculate dates

    const today = new Date();

    today.setHours(0,0,0,0);

    const end = new Date(today);

    end.setDate(today.getDate() + parseInt(durationDays));



    const id = "GP-" + new Date().getTime();

    

    // Save to ATTENDANCE_OTP

    const headers = otpSheet.getRange(1, 1, 1, otpSheet.getLastColumn()).getValues()[0].map(h => h.toString().trim());

    const rowData = headers.map(h => {

      switch (h) {

        case 'ID': return id;

        case 'RegistrationID': return inputRegId;

        case 'OTP': return '';

        case 'ActionType': return 'GracePeriod';

        case 'ExpiryTimestamp': return end;

        case 'TargetDate': return today;

        case 'Reason': return reason;

        case 'Status': return 'Pending';

        case 'LeaveType': return 'attendance, diary, tasks, projects';

        case 'AttachmentUrl': return '';

        default: return '';

      }

    });

    otpSheet.appendRow(rowData);

    SpreadsheetApp.flush();



    // Save to STUDENT_REQUESTS

    const studentName = getStudentFullName_(student);

    saveStudentRequest_({

      RequestID: id,

      RegistrationID: inputRegId,

      StudentName: studentName,

      RequestType: 'GracePeriod',

      TargetDate: today,

      EndDate: end,

      Reason: reason,

      LeaveType: 'attendance, diary, tasks, projects'

    });



    return { status: 'success', message: 'Extension request submitted successfully.' };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Handles approval/rejection of Grace Period requests.

 */

function processGracePeriodApproval(requestId, action, optData = {}) {

  try {

    const sheet = getSheet(SHEET_NAMES.ATTENDANCE_OTP);

    const data = sheet.getDataRange().getValues();

    const headers = data[0];

    const idCol = headers.indexOf("ID");

    const statusCol = headers.indexOf("Status");

    const regCol = headers.indexOf("RegistrationID");

    const startCol = headers.indexOf("TargetDate");

    const endCol = headers.indexOf("ExpiryTimestamp");

    const areaCol = headers.indexOf("LeaveType");



    for (let i = 1; i < data.length; i++) {

      if (data[i][idCol] === requestId) {

        const row = i + 1;

        if (action === 'Approve') {

          sheet.getRange(row, statusCol + 1).setValue('Approved');

          if (optData.startDate) sheet.getRange(row, startCol + 1).setValue(new Date(optData.startDate));

          if (optData.endDate) sheet.getRange(row, endCol + 1).setValue(new Date(optData.endDate));

          if (optData.areas) sheet.getRange(row, areaCol + 1).setValue(optData.areas.join(','));



          createStudentNotification(data[i][regCol], "Grace Period Approved", `Extension granted for: ${optData.areas ? optData.areas.join(', ') : data[i][areaCol]}`);

          updateStudentRequestStatus_(requestId, 'Approved', 'Approved by Admin');

        } else {

          sheet.getRange(row, statusCol + 1).setValue('Rejected');

          updateStudentRequestStatus_(requestId, 'Rejected', 'Rejected by Admin');

        }

        return { status: 'success', message: `Grace period request ${action}d.` };

      }

    }

    return { status: 'error', message: 'Request not found.' };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



function getApprovedGracePeriodAreas(regId, checkDateStr = null) {

  try {

    const checkDate = checkDateStr ? new Date(checkDateStr) : new Date();

    checkDate.setHours(0, 0, 0, 0);



    const sheet = getSheet(SHEET_NAMES.ATTENDANCE_OTP);

    if (!sheet) return [];

    const data = getSheetDataAsObjects(sheet);

    

    const activeGP = data.find(r => {

      if (String(r.RegistrationID || "").trim().toLowerCase() !== String(regId || "").trim().toLowerCase()) return false;

      if (String(r.Status || "").trim() !== 'Approved') return false;

      if (String(r.ActionType || "").trim() !== 'GracePeriod') return false;

      

      const startDate = r.TargetDate ? new Date(r.TargetDate) : null;

      const endDate = r.ExpiryTimestamp ? new Date(r.ExpiryTimestamp) : null;

      if (!startDate || !endDate) return false;

      

      startDate.setHours(0, 0, 0, 0);

      endDate.setHours(0, 0, 0, 0);

      

      return checkDate >= startDate && checkDate <= endDate;

    });



    if (activeGP && activeGP.LeaveType) {

      return String(activeGP.LeaveType).split(',').map(s => s.trim().toLowerCase());

    }

    return [];

  } catch (e) {

    Logger.log("Error in getApprovedGracePeriodAreas: " + e.toString());

    return [];

  }

}



// --- RFID AUTOMATION HELPERS ---



/**

 * =========================================================================

 * RFID CARD LABEL MANAGEMENT & A4 MASS PRINT DATA FETCHER

 * =========================================================================

 */

/**
 * Direct Base64 student photo converter for zero-CORS PDF and document generation.
 * Reads image bytes directly from Google Drive without browser CORS restrictions.
 */
function getStudentPhotoBase64Direct(fileIdOrUrl) {
  try {
    if (!fileIdOrUrl) return '';
    const match = String(fileIdOrUrl).match(/[-\w]{25,}/);
    const fileId = match ? match[0] : String(fileIdOrUrl).trim();
    if (!fileId) return '';
    const file = DriveApp.getFileById(fileId);
    if (!file) return '';
    const blob = file.getBlob();
    const bytes = blob.getBytes();
    const mime = blob.getContentType() || 'image/jpeg';
    return 'data:' + mime + ';base64,' + Utilities.base64Encode(bytes);
  } catch (err) {
    Logger.log("getStudentPhotoBase64Direct error for " + fileIdOrUrl + ": " + err);
    return '';
  }
}

/**
 * Batch Base64 student photo converter for zero-CORS PDF rendering.
 * Fetches multiple Google Drive files in a single pass.
 */
function getStudentPhotoBase64Batch(fileIdOrUrlList) {
  try {
    if (!fileIdOrUrlList || !Array.isArray(fileIdOrUrlList)) return {};
    const resMap = {};
    fileIdOrUrlList.forEach(function(item) {
      if (!item) return;
      const match = String(item).match(/[-\w]{25,}/);
      const fileId = match ? match[0] : String(item).trim();
      if (!fileId || resMap[fileId]) return;
      try {
        const file = DriveApp.getFileById(fileId);
        if (file) {
          const blob = file.getBlob();
          const mime = blob.getContentType() || 'image/jpeg';
          resMap[fileId] = 'data:' + mime + ';base64,' + Utilities.base64Encode(blob.getBytes());
        }
      } catch (eFile) {}
    });
    return resMap;
  } catch (err) {
    Logger.log("getStudentPhotoBase64Batch error: " + err);
    return {};
  }
}

function getRfidLabelStudents(batchFilter, printStatusFilter) {

  try {

    const students = getAllStudents() || [];

    const inventory = getRfidInventory() || [];

    

    // Cross-reference assigned RFID tags from inventory

    const invSyncMap = {};

    inventory.forEach(inv => {

      if (inv.status === 'Assigned' && inv.assignedToId) {

        invSyncMap[String(inv.assignedToId).trim().toUpperCase()] = String(inv.tagId || '').trim();

      }

    });



    // Retrieve persistent print history map from ScriptProperties

    let printHistory = {};

    try {

      const rawHistory = PropertiesService.getScriptProperties().getProperty('RFID_LABEL_PRINT_HISTORY');

      if (rawHistory) {

        printHistory = JSON.parse(rawHistory);

      }

    } catch (err) {

      Logger.log("Error reading RFID_LABEL_PRINT_HISTORY: " + err);

      printHistory = {};

    }



    // Process all eligible students

    const processedList = [];

    const slotCache = {};
    try {
      const slotsSheet = getSheet(SHEET_NAMES.SLOTS);
      if (slotsSheet) {
        const slots = getSheetDataAsObjects(slotsSheet);
        slots.forEach(slot => {
          const bId = String(slot.BatchID || slot.batchId || slot.batch || '').trim().toUpperCase();
          if (bId) {
            slotCache[bId] = `${slot.StartTime || slot.start || '09:00 AM'} - ${slot.EndTime || slot.end || '05:00 PM'}`;
          }
        });
      }
    } catch (eSlot) {}

    students.forEach(s => {
      // Exclude completed, ended, closed, opt-out, rejected, inactive, or pending candidates from RFID Card Labels
      const stCheck = String(s.status || s.applicationStatus || s.ApplicationStatus || s.actualStatus || '').trim().toLowerCase();
      // STRICT RULE: Pending students must NEVER appear in RFID Card Labels
      if (stCheck.includes('pending')) {
        return;
      }
      if (stCheck === 'completed' || stCheck.includes('completed') || stCheck.includes('ended') || stCheck === 'closed' || stCheck === 'opt-out' || stCheck === 'optout' || stCheck === 'rejected' || stCheck.includes('inactive')) {
        return;
      }
      // Check internship end date: if in past, student has completed internship and is excluded from active RFID card issuance
      const checkEnd = s.endDate || s.internshipEndDate || s.InternshipEndDate;
      if (checkEnd && !isGsvInternshipActiveOrUpcoming_(s.startDate || s.internshipStartDate, checkEnd)) {
        return;
      }




      const regId = String(s.registrationId || s.RegistrationID || '').trim();

      if (!regId) return;

      const regIdUpper = regId.toUpperCase();



      const invTag = invSyncMap[regIdUpper] || '';

      const finalTag = (s.rfidTag || s.RFID_TagID || invTag || '').trim();



      const histItem = printHistory[regIdUpper];

      const isPrinted = !!(histItem && histItem.printed);

      const printStatus = isPrinted ? 'Printed' : 'Pending Print';

      const lastPrinted = (histItem && histItem.printedAt) ? histItem.printedAt : '';



      const rawStart = s.startDate || s.internshipStartDate || s.InternshipStartDate;

      const rawEnd = s.endDate || s.internshipEndDate || s.InternshipEndDate;



const normBid = String(s.batch || s.Batch || '').trim().toUpperCase();
      const calculatedSlot = s.slotDisplay || s.slotTiming || slotCache[normBid] || '09:00 AM - 05:00 PM';



      const studentObj = {

        registrationId: regId,

        name: s.name || getStudentFullName_(s) || 'Student',

        registerNo: s.registerNumber || s.registerNo || s.RegisterNumber || '',

        college: s.college || s.collegeName || s.CollegeName || '',

        department: s.department || s.Department || '',

        batch: s.batch || s.Batch || 'Unassigned',

        rfidTag: finalTag || 'UNASSIGNED',

        hasTag: !!finalTag,

        photoUrl: s.profilePhotoUrl || s.photoUrl || s.ProfilePhotoUrl || '',

        startDate: rawStart ? formatDateDMY(rawStart) : 'N/A',

        endDate: rawEnd ? formatDateDMY(rawEnd) : 'N/A',

        slotTiming: calculatedSlot,

        slotDisplay: calculatedSlot,

        status: s.status || s.applicationStatus || s.ApplicationStatus || 'Approved',

        printStatus: printStatus,

        lastPrinted: lastPrinted

      };



      processedList.push(studentObj);

    });



    // Compute overall summary stats across all records

    const totalEligible = processedList.length;

    const totalPrinted = processedList.filter(s => s.printStatus === 'Printed').length;

    const totalPending = totalEligible - totalPrinted;



    // Apply batch filter if provided

    let filteredList = processedList;

    const bFilter = String(batchFilter || 'all').trim();

    if (bFilter && bFilter !== 'all') {

      filteredList = filteredList.filter(s => String(s.batch || '').trim() === bFilter);

    }



    // Apply print status filter if provided

    const pFilter = String(printStatusFilter || 'all').trim().toLowerCase();

    if (pFilter === 'pending') {

      filteredList = filteredList.filter(s => s.printStatus === 'Pending Print');

    } else if (pFilter === 'printed') {

      filteredList = filteredList.filter(s => s.printStatus === 'Printed');

    }



    // Sort: Pending print first, then by Batch, then by Name ascending

    filteredList.sort((a, b) => {

      if (a.printStatus !== b.printStatus) {

        return a.printStatus === 'Pending Print' ? -1 : 1;

      }

      if (a.batch !== b.batch) {

        return a.batch.localeCompare(b.batch);

      }

      return a.name.localeCompare(b.name);

    });



    return {

      status: 'success',

      students: filteredList,

      totalEligible: totalEligible,

      totalPrinted: totalPrinted,

      totalPending: totalPending

    };

  } catch (e) {

    Logger.log("Error in getRfidLabelStudents: " + e.toString());

    return {

      status: 'error',

      message: e.toString(),

      students: [],

      totalEligible: 0,

      totalPrinted: 0,

      totalPending: 0

    };

  }

}



/**

 * Record RFID label print action in persistent storage

 */

function recordRfidLabelPrint(registrationIds) {

  try {

    if (!registrationIds) {

      return { status: 'error', message: 'No registration IDs provided' };

    }



    let idList = [];

    if (Array.isArray(registrationIds)) {

      idList = registrationIds;

    } else if (typeof registrationIds === 'string') {

      idList = registrationIds.split(',').map(s => s.trim()).filter(Boolean);

    }



    if (idList.length === 0) {

      return { status: 'error', message: 'Empty registration IDs array' };

    }



    let printHistory = {};

    try {

      const raw = PropertiesService.getScriptProperties().getProperty('RFID_LABEL_PRINT_HISTORY');

      if (raw) printHistory = JSON.parse(raw);

    } catch (err) {

      printHistory = {};

    }



    const nowFormatted = Utilities.formatDate(new Date(), "GMT+5:30", "dd/MM/yyyy hh:mm a");

    idList.forEach(id => {

      const k = String(id).trim().toUpperCase();

      if (k) {

        printHistory[k] = {

          printed: true,

          printedAt: nowFormatted

        };

      }

    });



    PropertiesService.getScriptProperties().setProperty('RFID_LABEL_PRINT_HISTORY', JSON.stringify(printHistory));



    return {

      status: 'success',

      message: 'Successfully recorded print history for ' + idList.length + ' student labels.',

      updatedCount: idList.length

    };

  } catch (e) {

    Logger.log("Error in recordRfidLabelPrint: " + e.toString());

    return { status: 'error', message: e.toString() };

  }

}





/**

 * Comprehensive RFID state fetcher with auto-cleanup of expired tags

 */

function getRfidManagementState() {

  try {

    try { fixDuplicateRfidAssignments(); } catch (eFix) {}

    const students = getAllStudents();

    const inventory = getRfidInventory();

    const todayStr = getTodayStr();



    // Map inventory tag to student regID for cross-ref to handle sync issues

    const invSyncMap = {};

    inventory.forEach(inv => {

      if (inv.status === 'Assigned' && inv.assignedToId) {

        invSyncMap[String(inv.assignedToId).trim().toUpperCase()] = inv.tagId;

      }

    });



    // Blazing-Fast Pre-Cache: Load slots map ONCE instead of opening Google Sheets 50+ times in a loop!

    const slotCache = {};

    try {

      const slotsSheet = getSheet(SHEET_NAMES.SLOTS);

      if (slotsSheet) {

        const slots = getSheetDataAsObjects(slotsSheet);

        slots.forEach(slot => {

          const bId = String(slot.BatchID || slot.batchId || slot.batch || '').trim().toUpperCase();

          if (bId) {

            slotCache[bId] = {

              start: slot.StartTime || slot.start || '09:00 AM',

              end: slot.EndTime || slot.end || '05:00 PM',

              type: slot.Type || 'BATCH_SLOT'

            };

          }

        });

      }

    } catch (eSlot) {}



    // Process categories instantly with zero repeated sheet I/O

    const processed = students.map(s => {

      const batchId = String(s.batch || '').trim();

      const normBid = batchId.toUpperCase();

      const slot = slotCache[normBid] || { start: '09:00 AM', end: '05:00 PM', type: 'DEFAULT' };



      const dToday = parseStandardDate_(todayStr);

      const dStart = parseStandardDate_(s.internshipStart || s.InternshipStartDate || s.startDate);

      const dEnd = parseStandardDate_(s.internshipEnd || s.InternshipEndDate || s.endDate);



      const statusLower = String(s.status || s.actualStatus || '').toLowerCase();

      const isCompletedStatus = (statusLower === 'completed' || statusLower === 'alumni');

      

      // Day-inclusive timestamp comparisons: student card remains valid until 23:59:59 on internshipEnd

      let isExpired = false;

      let isUpcoming = false;

      if (isCompletedStatus) {

        isExpired = true;

      } else if (dEnd && dToday) {

        const endOfDay = new Date(dEnd.getTime());

        endOfDay.setHours(23, 59, 59, 999);

        if (dToday.getTime() > endOfDay.getTime()) {

          isExpired = true;

        }

      }

      if (!isExpired && !isCompletedStatus && dStart && dToday) {

        const startOfDay = new Date(dStart.getTime());

        startOfDay.setHours(0, 0, 0, 0);

        if (dToday.getTime() < startOfDay.getTime()) {

          isUpcoming = true;

        }

      }

      const isLive = (!isExpired && !isUpcoming);



      // Sync check: Use inventory as secondary source if registration sheet is missing the tag

      const sRegIdUpper = String(s.registrationId || '').trim().toUpperCase();

      const invTag = invSyncMap[sRegIdUpper];

      const rawFinalTag = (s.rfidTag || invTag || '').trim();

      const finalTag = rawFinalTag ? standardizeRfidFormat(rawFinalTag) : '';

      const hasTag = !!finalTag;



      const isValidStatus = (statusLower === 'approved' || statusLower === 'active' || statusLower === 'assigned');

      const rawLastTag = (rawFinalTag || s.Last_RFID_TagID || s.lastAssignedTag || '').trim();

      const lastTag = rawLastTag ? standardizeRfidFormat(rawLastTag) : '';



      const handoverStatus = s.rfidHandoverStatus || s.RFID_HandoverStatus || (hasTag ? 'Pending Handover' : 'Not Issued');

      const physicalStatus = s.rfidPhysicalStatus || s.RFID_PhysicalStatus || (String(handoverStatus).toLowerCase() === 'handed over' ? 'Issued' : (String(handoverStatus).toLowerCase() === 'returned' ? 'Received' : 'Not Issued'));

      const returnStatus = s.rfidReturnStatus || s.RFID_ReturnStatus || (hasTag ? 'With Intern' : 'Returned');



      let periodDisplay = 'Active';

      if (isCompletedStatus) periodDisplay = 'Completed';

      else if (isExpired) periodDisplay = 'Period Ended';

      else if (isUpcoming) periodDisplay = 'Upcoming';



      return {

        ...s,

        rfidTag: finalTag,

        lastAssignedTag: lastTag,

        rfidHandoverStatus: handoverStatus,

        rfidPhysicalStatus: physicalStatus,

        rfidReturnStatus: returnStatus,

        effectiveSlot: slot,

        slotDisplay: `${slot.start} - ${slot.end}`,

        slotType: slot.type || 'SYSTEM',

        isExpired,

        isUpcoming,

        isLive,

        hasTag,

        isValidStatus,

        periodStatus: periodDisplay

      };

    });



    return {

      inventory: inventory.map(i => {

        const lu = i.lastUpdated ? (i.lastUpdated instanceof Date ? i.lastUpdated : new Date(i.lastUpdated)) : null;

        const ad = i.addedDate ? (i.addedDate instanceof Date ? i.addedDate : new Date(i.addedDate)) : null;

        return {

          ...i,

          lastUpdatedDisplay: i.lastUpdated ? formatDateTimeIndia(i.lastUpdated) : 'N/A',

          addedDateDisplay: i.addedDate ? formatDateTimeIndia(i.addedDate) : 'N/A'

        };

      }).sort((a, b) => {

        const statusOrder = { 'Available': 1, 'Blocked': 2, 'Assigned': 3 };

        const orderA = statusOrder[a.status] || 2;

        const orderB = statusOrder[b.status] || 2;

        if (orderA !== orderB) return orderA - orderB;

        return String(a.tagId || '').localeCompare(String(b.tagId || ''));

      }),

      // Approved + Not Expired + No Tag - Sorted by Name

      pendingAssignment: processed.filter(s => {

        const stLower = String(s.status || s.actualStatus || '').toLowerCase();

        const isCompleted = (stLower === 'completed' || stLower === 'alumni');

        return s.isValidStatus && !s.isExpired && !s.hasTag && !isCompleted;

      }).sort((a, b) => a.name.localeCompare(b.name)),

      // All students who currently have a tag assigned in system (Active In-Use + Period Ended holding tag)

      inUse: processed.filter(s => {

        const stLower = String(s.status || s.actualStatus || '').toLowerCase();

        const isCompleted = (stLower === 'completed' || stLower === 'alumni');

        const isReturned = (String(s.rfidHandoverStatus || '').toLowerCase() === 'returned' || String(s.rfidPhysicalStatus || '').toLowerCase() === 'received');

        if (isCompleted && isReturned) return false;

        return s.hasTag;

      }).sort((a, b) => {

        if (!a.internshipEnd) return 1;

        if (!b.internshipEnd) return -1;

        return b.internshipEnd.localeCompare(a.internshipEnd);

      }),

      // Completed / Alumni records OR students whose internship period ended and have no active tag

      completed: processed.filter(s => {

        const stLower = String(s.status || s.actualStatus || '').toLowerCase();

        const isCompleted = (stLower === 'completed' || stLower === 'alumni');

        const isReturned = (String(s.rfidHandoverStatus || '').toLowerCase() === 'returned' || String(s.rfidPhysicalStatus || '').toLowerCase() === 'received');

        return (isCompleted && isReturned) || (isCompleted && !s.hasTag) || (s.isExpired && !s.hasTag);

      }).sort((a, b) => {

        if (!a.internshipEnd) return 1;

        if (!b.internshipEnd) return -1;

        return b.internshipEnd.localeCompare(a.internshipEnd);

      })

    };

  } catch (e) {

    Logger.log("Error in getRfidManagementState: " + e.toString());

    return { error: e.toString() };

  }

}



/**

 * Safety mechanism: 

 * Rule 1: Reclaims RFID when student status is marked 'Completed' or 'Alumni'.

 * Rule 2: If internship period ended BUT card was NEVER handed over (pending handover),

 *         it auto-releases back to pool since the student never received the physical card.

 * Rule 3: If card WAS handed over, it remains with the student until physically surrendered / returned to admin.

 */

function syncExpiredRfidTags(students, todayStr) {

  // Rule 1: Student is marked Completed

  const completedWithTags = students.filter(s => {

    const st = String(s.status || s.actualStatus || s.applicationStatus || '').trim().toLowerCase();

    return (st === 'completed' || st === 'alumni') && (s.rfidTag && s.rfidTag !== '');

  });

  completedWithTags.forEach(s => {

    returnRfidToPool(s.registrationId);

  });



  // Rule 2: Period ended and NEVER handed over to intern -> auto release back to pool

  const unhandedExpired = students.filter(s => {

    const handover = String(s.rfidHandoverStatus || s.RFID_HandoverStatus || '').trim().toLowerCase();

    return s.isExpired && s.hasTag && handover !== 'handed over';

  });

  unhandedExpired.forEach(s => {

    returnRfidToPool(s.registrationId);

  });

}



function revokeRfidAssignment(regId) {
  try {
    regId = String(regId || '').trim();
    if (!regId) return { status: 'error', message: 'Registration ID is required' };

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);
    if (!regSheet) return { status: 'error', message: 'Registrations sheet not found.' };

    const data = getSheetDataAsObjects(regSheet);
    const regUpper = regId.toUpperCase();
    const idx = data.findIndex(s => String(s.RegistrationID || s.RegistrationId || s.RegID || '').trim().toUpperCase() === regUpper);
    if (idx === -1) return { status: 'error', message: `Student record ${regId} not found.` };

    let tag = String(data[idx].RFID_TagID || data[idx].RFID || '').trim();

    // Check inventory sheet as well for robust card matching
    const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);
    let invRowTag = '';
    if (invSheet) {
      const invData = invSheet.getDataRange().getValues();
      const invHeaders = invData[0];
      const tagCol = invHeaders.indexOf("RFID_TagID");
      const assignedCol = invHeaders.indexOf("AssignedTo");
      const statusCol = invHeaders.indexOf("Status");
      const hCol = invHeaders.indexOf("HandoverStatus");
      const updCol = invHeaders.indexOf("LastUpdated");

      const normTag = tag ? standardizeRfidFormat(tag) : '';
      for (let j = 1; j < invData.length; j++) {
        const rowTagVal = String(tagCol !== -1 ? invData[j][tagCol] : '').trim();
        const rowNormTag = rowTagVal ? standardizeRfidFormat(rowTagVal) : '';
        const rowAssigned = String(assignedCol !== -1 ? invData[j][assignedCol] : '').trim().toUpperCase();

        const isMatch = (normTag && rowNormTag && normTag === rowNormTag) || 
                        (rowAssigned && (rowAssigned === regUpper || rowAssigned.includes(regUpper)));

        if (isMatch) {
          if (!invRowTag && rowTagVal) invRowTag = rowTagVal;
          if (statusCol !== -1) invSheet.getRange(j + 1, statusCol + 1).setValue("Available");
          if (assignedCol !== -1) invSheet.getRange(j + 1, assignedCol + 1).setValue("");
          if (hCol !== -1) invSheet.getRange(j + 1, hCol + 1).setValue("Available");
          if (updCol !== -1) invSheet.getRange(j + 1, updCol + 1).setValue(new Date());
        }
      }
    }

    const finalTag = tag || invRowTag;

    // Update student in REGISTRATIONS: completely wipe RFID_TagID so student is unassigned
    updateObjectInSheet(regSheet, 'RegistrationID', regId, {
      'RFID_TagID': '',
      'Last_RFID_TagID': finalTag ? standardizeRfidFormat(finalTag) : '',
      'RFID_HandoverStatus': 'Revoked',
      'RFID_PhysicalStatus': 'Not Issued',
      'RFID_ReturnStatus': 'Returned'
    });

    // Record in RFID Data Management audit sheet
    syncRfidDataManagementEntry_(
      finalTag,
      regId,
      'Revoked',
      'Admin',
      'Admin',
      'Good',
      'Assignment revoked by Admin; card returned to Available inventory pool'
    );

    if (typeof executionCache !== 'undefined' && executionCache.delete) {
      try {
        executionCache.delete(SHEET_NAMES.REGISTRATIONS);
        executionCache.delete(SHEET_NAMES.RFID_INVENTORY);
      } catch(eC) {}
    }

    SpreadsheetApp.flush();
    logActivity('RFID Revoked', 'Admin', `Assignment revoked for ${regId} (Tag: ${finalTag}). Card returned to Available inventory pool.`);
    return { 
      status: 'success', 
      registrationId: regId,
      message: `RFID assignment revoked for ${regId}. Card has returned to Available inventory pool.` 
    };
  } catch (e) {
    Logger.log("Error in revokeRfidAssignment: " + e.toString());
    return { status: 'error', message: e.toString() };
  }
}

/**
 * Sets RFID Handover Status ('Handed Over' vs 'Pending Handover')
 */
function setRfidHandoverStatus(regId, handoverStatus) {
  try {
    regId = String(regId || '').trim();
    if (!regId) return { status: 'error', message: 'Registration ID is required' };

    const candRec = findCandidateRecordAcrossSheets_(regId);
    let tagId = '';

    if (candRec && candRec.found && candRec.sheet) {
      tagId = candRec.rfidTag || '';
      updateObjectInSheet(candRec.sheet, 'RegistrationID', regId, {
        'RFID_HandoverStatus': handoverStatus,
        'RFID_PhysicalStatus': (handoverStatus === 'Handed Over' ? 'Issued' : 'Pending')
      });
    } else {
      const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);
      if (regSheet) {
        updateObjectInSheet(regSheet, 'RegistrationID', regId, {
          'RFID_HandoverStatus': handoverStatus
        });
      }
    }

    // Always update RFID_INVENTORY
    const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);
    if (invSheet) {
      const invData = invSheet.getDataRange().getValues();
      const invHeaders = invData[0];
      const tagCol = invHeaders.indexOf("RFID_TagID");
      const assignedCol = invHeaders.indexOf("AssignedTo");
      const hCol = invHeaders.indexOf("HandoverStatus");
      const updCol = invHeaders.indexOf("LastUpdated");
      const cleanRegUpper = regId.toUpperCase();

      for (let j = 1; j < invData.length; j++) {
        const rowTag = standardizeRfidFormat(invData[j][tagCol] || '');
        const rowAssigned = String(invData[j][assignedCol] || '').trim().toUpperCase();
        if ((tagId && rowTag === tagId) || (rowAssigned && rowAssigned === cleanRegUpper)) {
          if (hCol !== -1) invSheet.getRange(j + 1, hCol + 1).setValue(handoverStatus);
          if (updCol !== -1) invSheet.getRange(j + 1, updCol + 1).setValue(new Date());
          break;
        }
      }
    }

    logActivity('RFID Handover', 'Admin', `RFID Tag for ${regId} marked as ${handoverStatus}`);
    return { status: 'success', message: `Card status updated to ${handoverStatus}` };
  } catch (e) {
    Logger.log("Error in setRfidHandoverStatus: " + e.toString());
    return { status: 'error', message: e.toString() };
  }
}

/**
 * Returns RFID card from student back into the inventory pool (Mark as Returned to Admin)
 */
function returnRfidCardFromStudent(regId) {
  try {
    regId = String(regId || '').trim();
    if (!regId) return { status: 'error', message: 'Registration ID is required' };

    const candRec = findCandidateRecordAcrossSheets_(regId);
    const regUpper = regId.toUpperCase();
    const stu = candRec ? candRec.candidate : null;

    const rawTag = stu ? (stu.RFID_TagID || stu.Last_RFID_TagID || '') : '';
    const normTag = rawTag ? standardizeRfidFormat(rawTag) : '';

    // Update inventory pool: set all matching rows to Available
    const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);
    if (invSheet) {
      const invData = invSheet.getDataRange().getValues();
      const invHeaders = invData[0];
      const tagCol = invHeaders.indexOf("RFID_TagID");
      const assignedCol = invHeaders.indexOf("AssignedTo");
      const statusCol = invHeaders.indexOf("Status");
      const hCol = invHeaders.indexOf("HandoverStatus");
      const updCol = invHeaders.indexOf("LastUpdated");

      for (let j = 1; j < invData.length; j++) {
        const rowTagVal = String(tagCol !== -1 ? invData[j][tagCol] : '').trim();
        const rowNormTag = rowTagVal ? standardizeRfidFormat(rowTagVal) : '';
        const rowAssigned = String(assignedCol !== -1 ? invData[j][assignedCol] : '').trim().toUpperCase();

        const isMatch = (normTag && rowNormTag && normTag === rowNormTag) || 
                        (rowAssigned && (rowAssigned === regUpper || rowAssigned.includes(regUpper)));

        if (isMatch) {
          if (statusCol !== -1) invSheet.getRange(j + 1, statusCol + 1).setValue("Available");
          if (assignedCol !== -1) invSheet.getRange(j + 1, assignedCol + 1).setValue("");
          if (hCol !== -1) invSheet.getRange(j + 1, hCol + 1).setValue("Returned");
          if (updCol !== -1) invSheet.getRange(j + 1, updCol + 1).setValue(new Date());
        }
      }
    }

    if (candRec && candRec.sheet) {
      updateObjectInSheet(candRec.sheet, 'RegistrationID', regId, {
        'RFID_TagID': '',
        'Last_RFID_TagID': normTag || rawTag,
        'RFID_HandoverStatus': 'Returned',
        'RFID_PhysicalStatus': 'Received',
        'RFID_ReturnStatus': 'Returned'
      });
    }

    // Record in RFID Data Management audit sheet
    syncRfidDataManagementEntry_(
      normTag,
      regId,
      'Returned',
      'Admin',
      'Admin',
      'Good',
      'Card returned to Admin; cleared from inventory pool'
    );

    logActivity('RFID Return', 'Admin', `RFID Tag ${normTag || '(Unassigned)'} returned from ${regId}`);
    return { status: 'success', message: 'Card returned to pool successfully' };
  } catch (e) {
    Logger.log("Error in returnRfidCardFromStudent: " + e.toString());
    return { status: 'error', message: e.toString() };
  }
}

function bulkRevokeRfidAssignments(regIds) {

  try {

    if (!Array.isArray(regIds) || regIds.length === 0) return { status: 'error', message: 'No students selected for revoke.' };

    let successCount = 0;

    const errors = [];

    regIds.forEach(id => {

      try {

        const res = revokeRfidAssignment(id);

        if (res && res.status === 'success') successCount++;

        else if (res && res.message) errors.push(`${id}: ${res.message}`);

      } catch(e) {

        errors.push(`${id}: ${e.toString()}`);

      }

    });

    return {

      status: 'success',

      count: successCount,

      total: regIds.length,

      errors: errors,

      message: `Successfully revoked RFID assignments for ${successCount} of ${regIds.length} student(s). Cards returned to inventory pool.`

    };

  } catch(e) {

    return { status: 'error', message: e.toString() };

  }

}



function bulkReturnRfidCards(regIds) {

  try {

    if (!Array.isArray(regIds) || regIds.length === 0) return { status: 'error', message: 'No students selected for return.' };

    let successCount = 0;

    const errors = [];

    regIds.forEach(id => {

      try {

        const res = returnRfidCardFromStudent(id);

        if (res && res.status === 'success') successCount++;

        else if (res && res.message) errors.push(`${id}: ${res.message}`);

      } catch(e) {

        errors.push(`${id}: ${e.toString()}`);

      }

    });

    return {

      status: 'success',

      count: successCount,

      total: regIds.length,

      errors: errors,

      message: `Successfully returned RFID cards for ${successCount} of ${regIds.length} student(s) to inventory pool.`

    };

  } catch(e) {

    return { status: 'error', message: e.toString() };

  }

}



function bulkSetRfidPhysicalStatus(regIds, newStatus) {

  try {

    if (!Array.isArray(regIds) || regIds.length === 0) return { status: 'error', message: 'No students selected.' };

    let successCount = 0;

    const errors = [];

    regIds.forEach(id => {

      try {

        const res = updateRfidPhysicalCardStatus(id, newStatus);

        if (res && res.status === 'success') successCount++;

        else if (res && res.message) errors.push(`${id}: ${res.message}`);

      } catch(e) {

        errors.push(`${id}: ${e.toString()}`);

      }

    });

    return {

      status: 'success',

      count: successCount,

      total: regIds.length,

      errors: errors,

      message: `Successfully updated card status to '${newStatus}' for ${successCount} of ${regIds.length} student(s).`

    };

  } catch(e) {

    return { status: 'error', message: e.toString() };

  }

}





/**
 * Strict Precaution: Checks whether a candidate's internship period has ended.
 * Returns true if InternshipEndDate is strictly before today (in India Standard Time, GMT+5:30).
 * Also returns true if the candidate status is Completed, Alumni, Closed, Opt-Out, or Rejected.
 * When true, automatic RFID card assignment is strictly blocked.
 */
function isCandidateInternshipExpired_(candidateData) {
  if (!candidateData) return false;

  const st = String(candidateData.ApplicationStatus || candidateData.actualStatus || candidateData.Status || candidateData.status || '').trim().toLowerCase();
  if (st === 'completed' || st === 'alumni' || st === 'closed' || st === 'opt-out' || st === 'opt out' || st === 'optout' || st === 'rejected') {
    return true;
  }

  const rawEnd = candidateData.InternshipEndDate || candidateData.EndDate || candidateData.internshipEndDate || candidateData.endDate || candidateData.internshipEnd;
  if (!rawEnd) return false;

  const dEnd = (typeof parseStandardDate_ === 'function') ? parseStandardDate_(rawEnd, true) : new Date(rawEnd);
  if (!dEnd || isNaN(dEnd.getTime())) return false;

  const endOfDay = new Date(dEnd.getTime());
  endOfDay.setHours(23, 59, 59, 999);

  const now = new Date();
  return now.getTime() > endOfDay.getTime();
}

function handleRfidAutomationOnStatusChange(regId, newStatus) {

  try {

    // When status changes to Rejected or Opt-Out, surrender card back to inventory pool immediately

    if (newStatus === 'Rejected' || newStatus === 'Opt-Out' || newStatus === 'Closed') {

      returnRfidToPool(regId);

      return;

    }



    // When status is 'Completed', attendance is naturally invalidated by end date check,

    // but the card remains assigned to student in inventory and registrations until physical return is marked by Admin!

    if (newStatus === 'Completed') {

      return;

    }



    // Auto-assign available RFID card when Application is Approved

    if (newStatus === 'Approved') {

      if (typeof executionCache !== 'undefined' && executionCache.delete) {

        executionCache.delete(SHEET_NAMES.REGISTRATIONS);

      }

      const studentResp = getStudentFullData(regId);

      if (studentResp.status !== 'success' || !studentResp.studentData) return;

      const student = studentResp.studentData;

      // PRECAUTION: Strict check - Do NOT assign RFID if internship period has ended!
      if (isCandidateInternshipExpired_(student)) {
        Logger.log(`handleRfidAutomationOnStatusChange: Student ${regId} internship period has already expired. Skipping automatic RFID assignment.`);
        return;
      }

      // Concurrency & Dedup: If student already has a valid tag assigned, DO NOT re-assign!

      const existingTag = standardizeRfidFormat(student.RFID_TagID || '');

      if (existingTag && existingTag !== 'UNASSIGNED') {

        Logger.log(`handleRfidAutomationOnStatusChange: Student ${regId} already assigned RFID Tag ${existingTag}. Skipping duplicate.`);

        return;

      }



      assignAvailableRfid(regId);

    }

  } catch (e) {

    Logger.log("Error in handleRfidAutomationOnStatusChange: " + e.toString());

  }

}



function assignAvailableRfid(regId, skipEmail = false, isManual = false) {
  regId = String(regId || '').trim();
  if (!regId) return;

  const candRecCheck = (typeof findCandidateRecordAcrossSheets_ === 'function') ? findCandidateRecordAcrossSheets_(regId) : null;
  if (!isManual && candRecCheck && candRecCheck.found) {
    const candMode = String(candRecCheck.candidate.InternshipMode || candRecCheck.candidate.internshipMode || candRecCheck.candidate.Mode || '').toLowerCase().trim();
    if (candMode === 'online') {
      Logger.log(`assignAvailableRfid: Candidate ${regId} is registered for ONLINE mode. Skipping RFID assignment as Online candidates do not receive RFID cards.`);
      return {
        status: 'error',
        code: 'ONLINE_MODE',
        message: `Candidate ${regId} is in Online mode. RFID cards are only assigned to Offline candidates.`
      };
    }
  }
  if (!isManual && candRecCheck && candRecCheck.found && isCandidateInternshipExpired_(candRecCheck.candidate)) {
    const expDate = candRecCheck.candidate.InternshipEndDate || candRecCheck.candidate.EndDate || 'Past Date';
    Logger.log(`assignAvailableRfid: BLOCKED auto-assignment for ${regId}. Candidate internship ended on ${expDate}. Automatic RFID assignment is strictly forbidden. Can only be manually assigned by Admin.`);
    return {
      status: 'error',
      code: 'INTERNSHIP_EXPIRED',
      message: `Candidate ${regId} internship period ended on ${expDate}. Automatic RFID assignment is prohibited. It can only be assigned manually by Admin if required.`
    };
  }
  regId = String(regId || '').trim();
  if (!regId) return;

  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(30000);
  } catch (eLock) {
    Logger.log("Lock wait warning in assignAvailableRfid: " + eLock);
  }

  try {
    // 1. Locate candidate across ANY candidate sheet
    const candRec = findCandidateRecordAcrossSheets_(regId);
    if (!candRec || !candRec.found) {
      Logger.log("assignAvailableRfid: Candidate " + regId + " not found in any registration sheet.");
      return;
    }

    // Check if candidate already has an active RFID tag
    const existingTag = candRec.rfidTag;
    if (existingTag && existingTag !== 'UNASSIGNED') {
      Logger.log(`assignAvailableRfid: Candidate ${regId} already has assigned RFID Tag ${existingTag}. Skipping duplicate.`);
      return existingTag;
    }

    // Collect all used tags across inventory and candidates
    const usedTagsSet = new Set();
    const allStudents = (typeof getAllStudents === 'function') ? getAllStudents() : [];
    allStudents.forEach(s => {
      const t = standardizeRfidFormat(s.RFID_TagID || s.rfidTag || '');
      if (t && t !== 'UNASSIGNED') usedTagsSet.add(t.toUpperCase());
    });

    // Find fresh available tag in RFID_INVENTORY not present in usedTagsSet
    const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);
    if (!invSheet) return;
    const invData = invSheet.getDataRange().getValues();
    const invHeaders = invData[0];
    const tagCol = invHeaders.indexOf("RFID_TagID");
    const statusCol = invHeaders.indexOf("Status");
    const assignedToCol = invHeaders.indexOf("AssignedTo");
    const handoverStatusCol = invHeaders.indexOf("HandoverStatus");
    const lastUpdatedCol = invHeaders.indexOf("LastUpdated");

    let chosenTagId = null;
    let chosenRowIndex = -1;

    for (let r = 1; r < invData.length; r++) {
      const rawTag = String(invData[r][tagCol] || '').trim();
      const stdTag = standardizeRfidFormat(rawTag);
      const curStatus = String(invData[r][statusCol] || '').trim();

      if (stdTag && curStatus.toLowerCase() === 'available' && !usedTagsSet.has(stdTag.toUpperCase())) {
        chosenTagId = stdTag;
        chosenRowIndex = r + 1;
        break;
      }
    }

    if (!chosenTagId || chosenRowIndex === -1) {
      Logger.log(`assignAvailableRfid: No available RFID tags remaining in inventory for ${regId}!`);
      return;
    }

    // Mark inventory as Assigned
    invSheet.getRange(chosenRowIndex, statusCol + 1).setValue('Assigned');
    if (assignedToCol !== -1) invSheet.getRange(chosenRowIndex, assignedToCol + 1).setValue(regId);
    if (handoverStatusCol !== -1) invSheet.getRange(chosenRowIndex, handoverStatusCol + 1).setValue('Pending Handover');
    if (lastUpdatedCol !== -1) invSheet.getRange(chosenRowIndex, lastUpdatedCol + 1).setValue(new Date());

    // Update candidate's specific sheet
    if (candRec.sheet && candRec.rowIndex > 1) {
      const shHeaders = candRec.sheet.getDataRange().getValues()[0];
      let rfidCol = shHeaders.indexOf("RFID_TagID");
      let hCol = shHeaders.indexOf("RFID_HandoverStatus");
      if (rfidCol === -1) {
        rfidCol = shHeaders.length;
        candRec.sheet.getRange(1, rfidCol + 1).setValue("RFID_TagID");
      }
      if (hCol === -1) {
        hCol = shHeaders.length + (rfidCol === shHeaders.length ? 1 : 0);
        candRec.sheet.getRange(1, hCol + 1).setValue("RFID_HandoverStatus");
      }
      candRec.sheet.getRange(candRec.rowIndex, rfidCol + 1).setValue(chosenTagId);
      candRec.sheet.getRange(candRec.rowIndex, hCol + 1).setValue('Pending Handover');
    }

    SpreadsheetApp.flush();
    if (typeof executionCache !== 'undefined' && executionCache.clear) {
      executionCache.clear();
    }

    syncRfidDataManagementEntry_(
      chosenTagId,
      regId,
      'Assigned',
      'Admin',
      '',
      'Good',
      'Card assigned from inventory pool (Pending Handover)'
    );

    logActivity('RFID Auto-Assign', 'System', `Tag ${chosenTagId} assigned to ${regId} (${candRec.candidateType}, Pending Handover)`);

    // Send email strictly ONCE (skip if requested)
    if (!skipEmail) {
      try {
        sendRfidAssignmentModernEmail(regId, chosenTagId);
      } catch (eMail) {
        Logger.log("Error sending modern RFID assignment email: " + eMail.toString());
      }
    }

    return chosenTagId;
  } finally {
    try { lock.releaseLock(); } catch (eRel) {}
  }
}





/**

 * Sends a modern, responsive HTML notification email when an RFID card is assigned to a student,

 * complete with the student's generated Digital ID Card attached as a PDF.

 */

function sendRfidAssignmentModernEmail(regId, tagId) {

  try {

    regId = String(regId || '').trim();

    if (!regId) return { status: 'error', message: 'Registration ID required' };



    // Deduplication lock via CacheService: strictly prevent duplicate emails per student for 6 hours (21600 seconds)

    const cache = CacheService.getScriptCache();

    const cleanRegKey = 'rfid_mail_sent_' + regId.replace(/[^a-zA-Z0-9_]/g, '_');

    if (cache && cache.get(cleanRegKey)) {

      Logger.log(`sendRfidAssignmentModernEmail: RFID notification already sent to ${regId} within deduplication window. Skipping duplicate.`);

      return { status: 'success', message: 'Already sent recently' };

    }



    // Set lock IMMEDIATELY to prevent rapid re-triggering or race conditions

    if (cache) {

      try { cache.put(cleanRegKey, 'sending', 21600); } catch(e) {}

    }



    const studentResp = getStudentFullData(regId);

    if (!studentResp || studentResp.status !== 'success' || !studentResp.studentData) {

      return { status: 'error', message: `Student records not found for ${regId}` };

    }

    const student = studentResp.studentData;

    const email = student.GmailID;

    if (!email) {

      Logger.log(`sendRfidAssignmentModernEmail: No GmailID found for ${regId}`);

      return { status: 'error', message: `No email address found for ${regId}` };

    }



    const name = getStudentFullName_(student);

    const cleanTagId = standardizeRfidFormat(tagId || student.RFID_TagID || '');

    const company = 'GSV ELECTRICAL ENTERPRISES';

    const batchId = String(student.Batch || student.batch || '');

    const zone = (typeof Session !== 'undefined' && Session.getScriptTimeZone) ? Session.getScriptTimeZone() : 'Asia/Kolkata';

    const todayStr = (typeof getTodayStr === 'function') ? getTodayStr() : Utilities.formatDate(new Date(), zone, 'yyyy-MM-dd');

    const slotInfo = getSlotTiming(batchId, todayStr, regId);

    const slotTimingStr = (slotInfo && slotInfo.start && slotInfo.end) ? `${slotInfo.start} - ${slotInfo.end}` : '09:00 AM - 05:00 PM';

    const slotName = (slotInfo && (slotInfo.slotName || slotInfo.label)) ? (slotInfo.slotName || slotInfo.label) : 'Regular Shift';



    // Strict DD/MM/YYYY date formatting

    const rawStart = student.InternshipStartDate || student.StartDate;

    const rawEnd = student.InternshipEndDate || student.EndDate;

    const startDateFormatted = rawStart ? formatDateDMY(rawStart) : 'commencement date';

    const endDateFormatted = rawEnd ? formatDateDMY(rawEnd) : 'completion date';



    const regNo = student.RegisterNumber || student.RegisterNo || student.CollegeId || 'N/A';

    const dept = student.Department || student.domain || 'Engineering';

    const college = student.CollegeName || student.College || 'Institution';

    const portalUrl = (typeof PORTAL_URL !== 'undefined' && PORTAL_URL) ? PORTAL_URL : 'https://www.gsvee.in/gsv-internship-portal';

    const studentStatus = String(student.ApplicationStatus || student.Status || 'Approved').trim().toUpperCase();



    // Student profile photo resolution for email

    const rawPhoto = student.ProfilePhotoUrl || student.PhotoUrl || student.Photo || '';

    let emailPhotoSrc = `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=1e3a8a&color=ffffff&size=160&bold=true`;

    if (rawPhoto && !String(rawPhoto).startsWith('data:')) {

      try {

        if (typeof formatDriveImageDirectUrl === 'function') {

          const dUrl = formatDriveImageDirectUrl(rawPhoto);

          if (dUrl) emailPhotoSrc = dUrl;

        }

      } catch(ePhoto) {}

    }



    // 1. Generate or fetch fresh Digital ID Card PDF with newly assigned tagId

    let idCardAttachment = null;

    let idCardUrl = '';

    try {

      const idCardRes = generateDigitalIdCardPdf(regId, { forceNew: true, includePhoto: true });

      if (idCardRes && idCardRes.status === 'success' && idCardRes.fileId) {

        idCardUrl = idCardRes.driveLink || idCardRes.url || '';

        const idCardFile = DriveApp.getFileById(idCardRes.fileId);

        const safeRegFilename = String(regId).replace(/[\/\\]/g, '_');

        idCardAttachment = idCardFile.getBlob().setName(`Digital_ID_Card_${safeRegFilename}.pdf`);

      }

    } catch (idErr) {

      Logger.log(`Warning: Could not attach Digital ID Card for ${regId}: ${idErr.toString()}`);

    }



    // 2. Build modern responsive HTML email body with Light Theme ID Card matching PDF

    const subject = `[Action Required] Your RFID Access Card & Digital ID Card Assigned - ${company} [${regId}]`;



    const qrVerificationUrl = String(regId).trim();

    const qrImgUrl = `https://quickchart.io/qr?size=150&margin=1&text=${encodeURIComponent(qrVerificationUrl)}`;



    const htmlBody = `

      <div style="background-color: #f1f5f9; padding: 32px 15px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1e293b; line-height: 1.6;">

        <div style="max-width: 640px; margin: 0 auto; background-color: #ffffff; border-radius: 18px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.08); border: 1px solid #e2e8f0;">

          

          <!-- Modern Header Banner -->

          <div style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 55%, #2563eb 100%); padding: 34px 26px; text-align: center; color: #ffffff; position: relative;">

            <div style="display: inline-block; background: rgba(245, 158, 11, 0.2); border: 1px solid rgba(245, 158, 11, 0.45); color: #fbbf24; padding: 5px 18px; border-radius: 20px; font-size: 11px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 12px;">

              INTERNSHIP ATTENDANCE • RFID CARD

            </div>

            <h1 style="margin: 0 0 6px 0; font-size: 23px; font-weight: 800; color: #ffffff; letter-spacing: 0.5px;">

              RFID Card & Digital ID Card Assigned

            </h1>

            <p style="margin: 0; font-size: 13.5px; color: #cbd5e1; opacity: 0.95;">

              <strong style="color: #ffffff;">GSV ELECTRICAL ENTERPRISES</strong> • Student Internship Attendance & Portal Access

            </p>

          </div>



          <!-- Email Content Body -->

          <div style="padding: 30px 28px;">

            <p style="font-size: 16px; margin: 0 0 14px 0;">

              Dear <strong style="color: #1e3a8a; font-size: 17px;">${name}</strong>,

            </p>

            <p style="font-size: 14px; color: #475569; margin: 0 0 22px 0;">

              We are pleased to inform you that your official <strong>RFID Contactless Attendance Card</strong> and <strong>Student Digital ID Card</strong> have been successfully configured and allocated to your student profile for your internship at <strong>${company}</strong>.

            </p>



            <!-- Light Theme Digital ID Card Widget (Exact Match to PDF) -->

            <div style="background-color: #ffffff; border: 1.5px solid #cbd5e1; border-radius: 12px; overflow: hidden; margin-bottom: 24px; box-shadow: 0 4px 14px rgba(0,0,0,0.06);">

              

              <!-- Card Header with GSV Logo matching Image 4 -->

              <table style="width: 100%; border-collapse: collapse; background-color: #ffffff; border-bottom: 2px solid #dc2626;">

                <tr>

                  <td style="vertical-align: middle; padding: 12px 16px;">

                    <table style="border-collapse: collapse;">

                      <tr>

                        <td style="vertical-align: middle; padding-right: 10px;">

                          <img src="cid:gsvLogo" alt="GSV" style="height: 28px; max-width: 55px; object-fit: contain; display: block;" />

                        </td>

                        <td style="vertical-align: middle;">

                          <div style="font-size: 13.5px; font-weight: 900; color: #dc2626; letter-spacing: 0.5px; line-height: 1.15; text-transform: uppercase;">

                            GSV ELECTRICAL ENTERPRISES

                          </div>

                          <div style="font-size: 9px; font-weight: 700; color: #475569; letter-spacing: 0.5px; text-transform: uppercase; margin-top: 1px;">

                            STUDENT INTERNSHIP IDENTITY CARD

                          </div>

                        </td>

                      </tr>

                    </table>

                  </td>

                  <td style="text-align: right; vertical-align: middle; padding: 12px 16px;">

                    <span style="background-color: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd; padding: 4px 10px; border-radius: 12px; font-size: 9.5px; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase;">

                      INTERN • ${studentStatus}

                    </span>

                  </td>

                </tr>

              </table>



              <!-- Card Body -->

              <table style="width: 100%; border-collapse: collapse;">

                <tr>

                  <!-- Left: Photo Column -->

                  <td style="width: 80px; vertical-align: top; padding: 14px 10px 14px 16px; text-align: center;">

                    <img src="${emailPhotoSrc}" alt="${name}" style="width: 72px; height: 86px; object-fit: cover; border-radius: 6px; border: 1.5px solid #cbd5e1; display: block;" />

                  </td>



                  <!-- Center: Student Details Column -->

                  <td style="vertical-align: top; padding: 14px 10px; line-height: 1.45;">

                    <div style="font-size: 15.5px; font-weight: 800; color: #0f172a; margin-bottom: 2px;">

                      ${name}

                    </div>

                    <div style="font-size: 11px; font-weight: 800; color: #b91c1c; margin-bottom: 4px; font-family: monospace;">

                      ID: ${regId}

                    </div>

                    <div style="font-size: 11px; color: #334155; margin-bottom: 2px;">

                      <strong style="color: #64748b;">Reg:</strong> ${regNo}

                    </div>

                    <div style="font-size: 11px; color: #334155; margin-bottom: 2px;">

                      <strong style="color: #64748b;">Dept:</strong> ${dept}

                    </div>

                    <div style="font-size: 11px; color: #334155; margin-bottom: 4px;">

                      <strong style="color: #64748b;">College:</strong> ${college}

                    </div>

                    <div style="font-size: 11px; color: #334155; margin-bottom: 3px;">

                      <strong style="color: #64748b;">Period:</strong> <span style="font-weight: 800; color: #047857; text-decoration: underline;">${startDateFormatted} to ${endDateFormatted}</span>

                    </div>

                    <div style="font-size: 11px; color: #334155;">

                      <strong style="color: #64748b;">Slot (${slotName}):</strong> <span style="font-weight: 800; color: #4338ca;">${slotTimingStr}</span>

                    </div>

                  </td>



                  <!-- Right: QR Code Column -->

                  <td style="width: 85px; vertical-align: top; padding: 14px 16px 14px 10px; text-align: center;">

                    <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 5px; display: inline-block;">

                      <img src="${qrImgUrl}" alt="QR" style="width: 70px; height: 70px; display: block;" />

                      <div style="font-size: 7.5px; font-weight: 800; color: #475569; letter-spacing: 0.5px; margin-top: 3px; text-transform: uppercase;">

                        SCAN VERIFY

                      </div>

                    </div>

                  </td>

                </tr>

              </table>



              <!-- Card Footer (Dashed top border) -->

              <table style="width: 100%; border-collapse: collapse; background-color: #f8fafc; border-top: 1.5px dashed #cbd5e1;">

                <tr>

                  <td style="vertical-align: middle; padding: 10px 16px;">

                    ${cleanTagId && cleanTagId !== 'UNASSIGNED' ? `<img src="https://quickchart.io/barcode?type=code128&text=${encodeURIComponent(cleanTagId)}&includeText=false&height=25&width=160" alt="RFID Barcode" style="height: 16px; width: 105px; display: block; margin-bottom: 4px;" />` : ''}

                    <div style="font-size: 11px; font-weight: 900; color: #0f172a; font-family: monospace;">

                      RFID TAG: <span style="background-color: #e0f2fe; color: #0369a1; border: 1px solid #0284c7; padding: 2px 7px; border-radius: 4px; font-size: 11.5px; font-weight: 900;">${cleanTagId}</span>

                    </div>

                    <div style="font-size: 9.5px; color: #64748b; font-weight: 700; margin-top: 3px;">

                      Tag Validity Ends: <strong style="color: #b91c1c; font-weight: 900;">${endDateFormatted}</strong>

                    </div>

                  </td>

                  <td style="text-align: right; vertical-align: middle; padding: 10px 16px;">

                    <div style="font-size: 10px; font-weight: 800; color: #16a34a;">

                      ● ACTIVE RFID TAG

                    </div>

                    <div style="font-size: 9.5px; color: #4338ca; font-weight: 800; margin-top: 2px;">

                      Slot In/Out: ${slotTimingStr}

                    </div>

                  </td>

                </tr>

              </table>



            </div>



            <!-- Digital ID Card Attached Feature Box -->

            <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-left: 5px solid #16a34a; border-radius: 12px; padding: 18px 20px; margin-bottom: 24px;">

              <table style="width: 100%; border-collapse: collapse;">

                <tr>

                  <td style="width: 44px; vertical-align: top;">

                    <div style="background: #dcfce7; color: #16a34a; width: 38px; height: 38px; border-radius: 50%; text-align: center; line-height: 38px; font-size: 20px;">

                      🪪

                    </div>

                  </td>

                  <td style="vertical-align: top; padding-left: 12px;">

                    <h4 style="margin: 0 0 4px 0; color: #15803d; font-size: 15px; font-weight: 800;">

                      Attached: Official Student Digital ID Card (PDF)

                    </h4>

                    <p style="margin: 0; font-size: 13px; color: #166534; line-height: 1.5;">

                      Your student Digital ID Card complete with your photograph, verification QR code, registration details, active slot timing (<strong>${slotTimingStr}</strong>), and assigned RFID Tag ID (<strong>${cleanTagId}</strong>) is attached directly to this email. Please download and retain it on your smartphone.

                    </p>

                  </td>

                </tr>

              </table>

            </div>



            <!-- Important Action Instructions (Styled List) -->

            <h4 style="margin: 0 0 14px 0; font-size: 15px; font-weight: 800; color: #0f172a; text-transform: uppercase; letter-spacing: 0.5px;">

              📋 Important Action Instructions

            </h4>

            

            <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">

              <tr>

                <td style="padding: 10px 0; border-bottom: 1px solid #f1f5f9; vertical-align: top; width: 28px;">

                  <span style="background: #2563eb; color: white; width: 22px; height: 22px; border-radius: 50%; display: inline-block; text-align: center; line-height: 22px; font-size: 11px; font-weight: bold;">1</span>

                </td>

                <td style="padding: 10px 0 10px 10px; border-bottom: 1px solid #f1f5f9; font-size: 13.5px; color: #334155;">

                  <strong>Physical Card Collection:</strong> Please collect your physical contactless RFID card in person from the Administration Office starting from your internship start date (<strong>${startDateFormatted}</strong>).

                </td>

              </tr>

              <tr>

                <td style="padding: 10px 0; border-bottom: 1px solid #f1f5f9; vertical-align: top; width: 28px;">

                  <span style="background: #2563eb; color: white; width: 22px; height: 22px; border-radius: 50%; display: inline-block; text-align: center; line-height: 22px; font-size: 11px; font-weight: bold;">2</span>

                </td>

                <td style="padding: 10px 0 10px 10px; border-bottom: 1px solid #f1f5f9; font-size: 13.5px; color: #334155;">

                  <strong>Mandatory Hard Copy Submission:</strong> You <strong>MUST</strong> bring and submit a physical hard copy of all mandatory verification documents (College Bonafide Certificate, Declaration Form, and College ID copy) at the time of collecting your card.

                </td>

              </tr>

              <tr>

                <td style="padding: 10px 0; border-bottom: 1px solid #f1f5f9; vertical-align: top; width: 28px;">

                  <span style="background: #2563eb; color: white; width: 22px; height: 22px; border-radius: 50%; display: inline-block; text-align: center; line-height: 22px; font-size: 11px; font-weight: bold;">3</span>

                </td>

                <td style="padding: 10px 0 10px 10px; border-bottom: 1px solid #f1f5f9; font-size: 13.5px; color: #334155;">

                  <strong>Internship Attendance Activation:</strong> Your physical RFID card will be automatically activated on your internship commencement date for attendance scanning on hardware RFID readers.

                </td>

              </tr>

              <tr>

                <td style="padding: 10px 0; vertical-align: top; width: 28px;">

                  <span style="background: #2563eb; color: white; width: 22px; height: 22px; border-radius: 50%; display: inline-block; text-align: center; line-height: 22px; font-size: 11px; font-weight: bold;">4</span>

                </td>

                <td style="padding: 10px 0 10px 10px; font-size: 13.5px; color: #334155;">

                  <strong>Official Digital ID Card PDF:</strong> Download and keep the attached Digital ID Card PDF on your mobile phone for institutional verification and rapid QR attendance scanning.

                </td>

              </tr>

            </table>



            <!-- Quick Action Button -->

            <div style="text-align: center; margin: 28px 0 14px 0;">

              <a href="${portalUrl}" style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); color: #ffffff; text-decoration: none; padding: 13px 30px; border-radius: 10px; font-weight: 700; font-size: 14px; display: inline-block; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);">

                🌐 Open Student Portal & Dashboard →

              </a>

            </div>



          </div>



          <!-- Modern Footer -->

          <div style="background-color: #f8fafc; padding: 22px 30px; border-top: 1px solid #e2e8f0; text-align: center; font-size: 12px; color: #64748b;">

            <div style="font-weight: 700; color: #334155; margin-bottom: 4px;">

              ${company}

            </div>

            <div>

              Internship Administration • RFID Attendance System

            </div>

            <div style="margin-top: 10px; font-size: 11px; color: #94a3b8;">

              This is an automated institutional message. Please do not reply directly to this email.

            </div>

          </div>



        </div>

      </div>

    `;



    // Plain text fallback

    const textFallback = `Dear ${name},\n\n` +

      `We are pleased to inform you that an RFID access card and your official Student Digital ID Card have been assigned to you for your internship at ${company}.\n\n` +

      `CARD DETAILS:\n` +

      `- Student: ${name} (${regId})\n` +

      `- Reg No: ${regNo}\n` +

      `- Department: ${dept}\n` +

      `- College: ${college}\n` +

      `- Period: ${startDateFormatted} to ${endDateFormatted}\n` +

      `- Slot (${slotName}): ${slotTimingStr}\n` +

      `- RFID Tag ID: ${cleanTagId}\n` +

      `- Physical Status: Pending Collection at Office Desk\n\n` +

      `IMPORTANT INSTRUCTIONS:\n` +

      `1. Collection: Please collect your physical RFID card from the administration office starting from ${startDateFormatted}.\n` +

      `2. Documentation: You MUST submit a hard copy of all mandatory documents (Bonafide, Declaration, College ID) at the time of collection.\n` +

      `3. Activation: Your RFID card will be automatically activated on your internship start date for attendance readers.\n` +

      `4. Digital ID Card: Your official Student Digital ID Card is attached to this email as a PDF.\n\n` +

      `Access Student Portal: ${portalUrl}\n\n` +

      `Best regards,\nAdmin Team\n${company}`;



    const attachments = idCardAttachment ? [idCardAttachment] : [];



    // Prepare inline logo & watermark without filenames (to prevent them appearing as attachments)
    const emailInlineImgs = getEmailInlineImages_();

    MailApp.sendEmail({

      to: email,

      subject: subject,

      body: textFallback,

      htmlBody: htmlBody,

      attachments: attachments,

      inlineImages: emailInlineImgs,

      name: `${company} Admissions & RFID Administration`

    });



    // Set 6-hour deduplication lock

    if (cache) {

      try { cache.put(cleanRegKey, 'sent', 21600); } catch(e) {}

    }



    Logger.log(`Successfully sent modern RFID assignment email with Digital ID Card to ${email} (${regId})`);

    return { status: 'success', message: `Modern email sent with Digital ID Card to ${email}` };

  } catch (err) {

    Logger.log(`Error in sendRfidAssignmentModernEmail for ${regId}: ${err.toString()}`);

    return { status: 'error', message: err.toString() };

  }

}



function resendRfidNotificationEmail(regId) {

  try {

    regId = String(regId || '').trim();

    if (!regId) return { status: 'error', message: 'Registration ID required' };



    // Explicit manual resend removes the deduplication lock

    const cache = CacheService.getScriptCache();

    const cleanRegKey = 'rfid_mail_sent_' + regId.replace(/[^a-zA-Z0-9_]/g, '_');

    if (cache) {

      try { cache.remove(cleanRegKey); } catch(e) {}

    }



    const studentResp = getStudentFullData(regId);

    if (!studentResp || studentResp.status !== 'success' || !studentResp.studentData) {

      return { status: 'error', message: 'Student record not found' };

    }

    const tagId = studentResp.studentData.RFID_TagID || '';

    if (!tagId) {

      return { status: 'error', message: 'No RFID Tag assigned to this student yet' };

    }

    return sendRfidAssignmentModernEmail(regId, tagId);

  } catch(e) {

    return { status: 'error', message: e.toString() };

  }

}



function bulkAssignRfidCards(regIds) {
  try {
    if (!regIds || !Array.isArray(regIds) || regIds.length === 0) {
      return { status: 'error', message: 'No students selected' };
    }

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);
    if (!regSheet) return { status: 'error', message: 'Registrations sheet missing' };
    const regData = getSheetDataAsObjects(regSheet);
    
    let expiredSkipped = 0;
    const eligibleRegIds = [];

    regIds.forEach(regId => {
      const s = regData.find(student => String(student.RegistrationID || '').trim().toUpperCase() === String(regId).trim().toUpperCase());
      if (!s) return;
      if (s.RFID_TagID && String(s.RFID_TagID).trim() !== '' && s.RFID_TagID !== 'UNASSIGNED') return;

      // PRECAUTION: Block auto-assignment if candidate internship period has ended!
      if (isCandidateInternshipExpired_(s)) {
        expiredSkipped++;
        return;
      }
      eligibleRegIds.push(regId);
    });

    if (eligibleRegIds.length === 0) {
      if (expiredSkipped > 0) {
        return { 
          status: 'warning', 
          message: `${expiredSkipped} candidate(s) skipped because their internship end date has passed. Automatic RFID assignment is prohibited for completed/expired internships.` 
        };
      }
      return { status: 'success', message: 'All selected students already have RFID tags assigned.' };
    }

    const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);
    if (!invSheet) return { status: 'error', message: 'Inventory sheet missing' };

    const invData = getSheetDataAsObjects(invSheet);
    const availableTags = invData.filter(r => r.Status === 'Available');

    if (availableTags.length < eligibleRegIds.length) {
      return { 
        status: 'error', 
        message: `Not enough available RFID cards in inventory. Needed: ${eligibleRegIds.length}, Available: ${availableTags.length}. Please add more cards first.` 
      };
    }

    let successCount = 0;
    for (let i = 0; i < eligibleRegIds.length; i++) {
      const regId = eligibleRegIds[i];
      const res = assignAvailableRfid(regId, false, false);
      if (res && (!res.status || res.status !== 'error')) successCount++;
    }

    let extraMsg = '';
    if (expiredSkipped > 0) {
      extraMsg = ` (${expiredSkipped} candidate(s) skipped as their internship period has ended).`;
    }

    return { 
      status: 'success', 
      message: `Successfully auto-assigned RFID cards to ${successCount} student(s)${extraMsg}.` 
    };
  } catch (e) {
    Logger.log("Error in bulkAssignRfidCards: " + e.toString());
    return { status: 'error', message: e.toString() };
  }
}

function returnRfidToPool(regId) {

  try {

    const resp = getStudentFullData(regId);

    if (resp.status !== 'success' || !resp.studentData) return;

    const student = resp.studentData;

    const tagId = student.RFID_TagID;

    if (!tagId) return;



    const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);

    if (invSheet) {

      const rowIndex = findRowIndexByValue(invSheet, tagId, 'RFID_TagID');

      if (rowIndex > -1) {

        const headers = invSheet.getDataRange().getValues()[0];

        invSheet.getRange(rowIndex, headers.indexOf('Status') + 1).setValue('Available');

        invSheet.getRange(rowIndex, headers.indexOf('AssignedTo') + 1).setValue('');

        invSheet.getRange(rowIndex, headers.indexOf('LastUpdated') + 1).setValue(new Date());

      }

    }



    // Clear from student profile while preserving historical last tag

    updateStudentProfile({ registrationId: regId, RFID_TagID: '', Last_RFID_TagID: tagId });

    syncRfidDataManagementEntry_(
      tagId,
      regId,
      'Returned to Pool',
      'Admin',
      'Admin',
      'Good',
      'Automatic card return to pool'
    );

    logActivity('RFID Auto-Pool', 'System', `Tag ${tagId} returned to pool from ${regId}`);

  } catch (e) {

    Logger.log("Error returning RFID to pool for " + regId + ": " + e.toString());

  }

}



/**

 * Broadcasts a command to all registered RFID devices via the PendingCommand column.

 */

function setBroadcastRfidCommand(command) {

  return setRfidDeviceCommand('ALL', command);

}



/**

 * Sets a pending command for a specific RFID device or ALL devices.

 */

function setRfidDeviceCommand(mac, command) {

  try {

    const sheet = getSheet(SHEET_NAMES.RFID_DEVICES);

    if (!sheet) return { status: 'error', message: 'RFID_Devices sheet not found' };



    const data = sheet.getDataRange().getValues();

    const headers = data[0];

    const macIdx = headers.indexOf('MAC_ID');

    let cmdIdx = headers.indexOf('PendingCommand');



    if (cmdIdx === -1) {

      sheet.getRange(1, headers.length + 1).setValue('PendingCommand');

      cmdIdx = headers.length;

    }



    if (mac === 'ALL') {

      const statusIdx = headers.indexOf('Status');

      for (let i = 1; i < data.length; i++) {

        if (data[i][statusIdx] !== 'DISABLED') {

          sheet.getRange(i + 1, cmdIdx + 1).setValue(command);

        }

      }

    } else {

      for (let i = 1; i < data.length; i++) {

        if (String(data[i][macIdx]).trim().toUpperCase() === mac.trim().toUpperCase()) {

          sheet.getRange(i + 1, cmdIdx + 1).setValue(command);

          break;

        }

      }

    }

    SpreadsheetApp.flush();

    return { status: 'success', message: 'Command set successfully' };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



function getRfidInventory() {
  try {
    const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);
    if (!invSheet) return [];
    const invData = getSheetDataAsObjects(invSheet);

    const knownFacultyMap = {
      'GSV/2026/112/VH8C': { name: 'Prof. PRAVEENA V', staffId: '51131', college: 'Velammal engineering college', dept: 'Electronics And Communication Engineering', batch: 'Faculty Batch 1', tag: '0007507511', photoUrl: 'https://lh3.googleusercontent.com/d/1TaiL74Nfsg8EnroLNO5CZwhTd7NPSC7Q' },
      'GSV/2026/112/EQT4': { name: 'Prof. MANIMEGALAI M', staffId: '300581', college: 'velammal engineering college', dept: 'Electronics And Communication Engineering', batch: 'Faculty Batch 1', tag: '0007508828', photoUrl: 'https://lh3.googleusercontent.com/d/1u7QHaWwbfucJ0gXxIEyYFq17etETKemw' },
      'GSV/2026/112/QYCG': { name: 'Prof. ARUL THILAGAVATHI', staffId: '300573', college: 'Velammal engineering college', dept: 'Electronics And Communication Engineering', batch: 'Faculty Batch 1', tag: '0007515488', photoUrl: 'https://lh3.googleusercontent.com/d/1avdjP1RxXMPgg-kGLGX4LUX36LYjMK6w' },
      'GSV/2026/112/JDBI': { name: 'Prof. RAMYA T', staffId: '300579', college: 'velammal engineering college', dept: 'Electronics And Communication Engineering', batch: 'Faculty Batch 1', tag: '0007518344', photoUrl: 'https://lh3.googleusercontent.com/d/19c56EjHbPcOzSaulpBlSFHEhUEYtZeyN' },
      'GSV/2026/112/GONJ': { name: 'Prof. SUSANNA P', staffId: '300576', college: 'velammal engineering college', dept: 'Electronics And Communication Engineering', batch: 'Faculty Batch 1', tag: '0007518656', photoUrl: 'https://lh3.googleusercontent.com/d/104Kj6rc1lwSTm918Dx8NfDJTovG37KFX' }
    };
    const knownFacultyByTag = {
      '0007507511': knownFacultyMap['GSV/2026/112/VH8C'],
      '0007508828': knownFacultyMap['GSV/2026/112/EQT4'],
      '0007515488': knownFacultyMap['GSV/2026/112/QYCG'],
      '0007518344': knownFacultyMap['GSV/2026/112/JDBI'],
      '0007518656': knownFacultyMap['GSV/2026/112/GONJ']
    };

    // Retrieve all candidates across all sheets for fast, unified lookup
    const allCandidates = (typeof getAllStudents === 'function') ? getAllStudents() : [];
    const candidateMap = {};
    const candidateByRegIdMap = {};

    allCandidates.forEach(s => {
      const tag = String(s.RFID_TagID || s.rfidTag || s.Last_RFID_TagID || "").trim();
      const stdTag = tag ? standardizeRfidFormat(tag) : '';
      if (stdTag) candidateMap[stdTag.toUpperCase()] = s;
      const rid = String(s.RegistrationID || s.registrationId || s.RegID || "").trim().toUpperCase();
      if (rid) candidateByRegIdMap[rid] = s;
    });

    try {
      const facSheet = getSheet('Faculty Registrations');
      if (facSheet) {
        const facRows = getSheetDataAsObjects(facSheet) || [];
        facRows.forEach(f => {
          const rid = String(f.RegistrationID || f.registrationId || f.RegID || '').trim().toUpperCase();
          if (rid) candidateByRegIdMap[rid] = f;
          const tag = String(f.RFID_TagID || f.rfidTag || f.Last_RFID_TagID || '').trim();
          const stdTag = tag ? standardizeRfidFormat(tag) : '';
          if (stdTag) candidateMap[stdTag.toUpperCase()] = f;
        });
      }
    } catch(eFac) {}

    const items = invData.map((item, idx) => {
      const rawTag = String(item.RFID_TagID || "").trim();
      const tagId = standardizeRfidFormat(rawTag);
      const tagUpper = tagId.toUpperCase();
      const statusRaw = String(item.Status || 'Available').trim();
      const isAvailable = statusRaw.toLowerCase() === 'available';

      let candidate = null;
      let assignedToId = '';
      let assignedToName = 'Available';
      let handoverStatus = item.HandoverStatus || (isAvailable ? 'Available' : 'Pending Handover');

      if (!isAvailable) {
        const assignedRegUpper = String(item.AssignedTo || '').trim().toUpperCase();
        if (knownFacultyMap[assignedRegUpper]) {
          const kf = knownFacultyMap[assignedRegUpper];
          assignedToId = assignedRegUpper;
          assignedToName = kf.name;
          const kfRegCand = candidateByRegIdMap[assignedRegUpper] || null;
          candidate = {
            RegistrationID: assignedRegUpper,
            registrationId: assignedRegUpper,
            FirstName: kf.name,
            FullName: kf.name,
            CandidateType: 'Faculty',
            FacultyStaffId: kf.staffId,
            StaffId: kf.staffId,
            RegisterNumber: kf.staffId,
            Batch: kf.batch,
            batch: kf.batch,
            CollegeName: kf.college,
            college: kf.college,
            Department: kf.dept,
            department: kf.dept,
            RFID_TagID: tagId || kf.tag,
            ProfilePhotoUrl: (kfRegCand && (kfRegCand.ProfilePhotoUrl || kfRegCand.PhotoUrl || kfRegCand.Photo)) || kf.photoUrl || ''
          };
        } else if (knownFacultyByTag[tagUpper] || knownFacultyByTag[tagId]) {
          const kf = knownFacultyByTag[tagUpper] || knownFacultyByTag[tagId];
          assignedToId = Object.keys(knownFacultyMap).find(k => knownFacultyMap[k].tag === tagId) || item.AssignedTo;
          assignedToName = kf.name;
          const kfRegCand = assignedToId ? candidateByRegIdMap[String(assignedToId).trim().toUpperCase()] : null;
          candidate = {
            RegistrationID: assignedToId,
            registrationId: assignedToId,
            FirstName: kf.name,
            FullName: kf.name,
            CandidateType: 'Faculty',
            FacultyStaffId: kf.staffId,
            StaffId: kf.staffId,
            RegisterNumber: kf.staffId,
            Batch: kf.batch,
            batch: kf.batch,
            CollegeName: kf.college,
            college: kf.college,
            Department: kf.dept,
            department: kf.dept,
            RFID_TagID: tagId,
            ProfilePhotoUrl: (kfRegCand && (kfRegCand.ProfilePhotoUrl || kfRegCand.PhotoUrl || kfRegCand.Photo)) || kf.photoUrl || ''
          };
        } else if (assignedRegUpper && candidateByRegIdMap[assignedRegUpper]) {
          candidate = candidateByRegIdMap[assignedRegUpper];
          assignedToId = candidate.RegistrationID || candidate.registrationId || item.AssignedTo;
          assignedToName = candidate.name || getStudentFullName_(candidate);
        } else if (tagUpper && candidateMap[tagUpper]) {
          candidate = candidateMap[tagUpper];
          assignedToId = candidate.RegistrationID || candidate.registrationId;
          assignedToName = candidate.name || getStudentFullName_(candidate);
        } else if (item.AssignedTo) {
          const rec = findCandidateRecordAcrossSheets_(item.AssignedTo);
          if (rec && rec.found) {
            candidate = rec.candidate;
            assignedToId = rec.registrationId;
            assignedToName = rec.fullName;
          } else {
            assignedToId = String(item.AssignedTo).trim();
            assignedToName = 'Assigned Intern';
          }
        }
      }

      const candCat = candidate ? (candidate.CandidateType || ((typeof getCandidateCategory_ === 'function') ? getCandidateCategory_(candidate) : 'Student')) : 'Student';
      const staffIdOrReg = candidate ? (((candCat === 'Faculty') ? (candidate.FacultyStaffId || candidate.StaffId) : null) || ((candCat === 'Employee') ? (candidate.EmployeeId || candidate.StaffId) : null) || candidate.RegisterNumber || candidate.registerNumber || '') : '';
      const candPhoto = candidate ? (candidate.photoUrl || candidate.ProfilePhotoUrl || candidate.PhotoUrl || candidate.Photo || candidate.ProfilePhoto || candidate.photo || '') : '';

      // User instruction: Faculty cards are Assigned, Pending Handover (not Handed Over)
      if (candCat === 'Faculty' || knownFacultyMap[assignedToId]) {
        if (handoverStatus === 'Handed Over') handoverStatus = 'Pending Handover';
      }

      return {
        _rowIndex: idx,
        tagId: tagId,
        status: isAvailable ? 'Available' : (statusRaw === 'Blocked' ? 'Blocked' : 'Assigned'),
        handoverStatus: handoverStatus,
        assignedToId: assignedToId,
        assignedToName: assignedToName,
        assignedCandidateType: candCat,
        assignedStaffId: String(staffIdOrReg || ''),
        assignedBatch: candidate ? (candidate.Batch || candidate.batch || '') : '',
        assignedCollege: candidate ? (candidate.college || candidate.CollegeName || candidate.collegeName || candidate.College || candidate.Institution || '') : '',
        assignedRegNo: String(staffIdOrReg || ''),
        assignedDept: candidate ? (candidate.Department || candidate.department || '') : '',
        assignedPhotoUrl: formatDriveUrlToDirectImage_(candPhoto),
        lastUpdated: item.LastUpdated || item.AddedDate || '',
        addedBy: item.AddedBy || 'Reader',
        addedDate: item.AddedDate || ''
      };
    });

    // Deduplicate inventory by tag UID
    const deduped = {};
    items.forEach(item => {
      const existing = deduped[item.tagId];
      if (!existing) {
        deduped[item.tagId] = item;
      } else {
        const curDate = item.lastUpdated ? new Date(item.lastUpdated).getTime() : 0;
        const oldDate = existing.lastUpdated ? new Date(existing.lastUpdated).getTime() : 0;
        if (curDate > oldDate || (curDate === oldDate && item._rowIndex > existing._rowIndex)) {
          deduped[item.tagId] = item;
        }
      }
    });

    const statusOrder = { 'Available': 1, 'Blocked': 2, 'Assigned': 3 };
    return Object.values(deduped).sort((a, b) => {
      const orderA = statusOrder[a.status] || 2;
      const orderB = statusOrder[b.status] || 2;
      if (orderA !== orderB) return orderA - orderB;
      const tagA = String(a.tagId || '');
      const tagB = String(b.tagId || '');
      return tagA.localeCompare(tagB);
    });
  } catch (e) {
    Logger.log("Error in getRfidInventory: " + e.toString());
    return [];
  }
}

/**
 * Precautionary Auto-Allocation:
 * Automatically assigns available RFID tags to pending approved candidates without tags,
 * but STRICTLY SKIPS any candidate whose internship period has ended.
 */
function autoAssignPendingApprovedCandidatesRfid_() {
  try {
    const appSettings = getAppSettings();
    if (appSettings.status === 'success' && appSettings.settings && appSettings.settings['RFID_Automation_Mode'] === 'Manual') {
      Logger.log("autoAssignPendingApprovedCandidatesRfid_: RFID Automation Mode is Manual. Skipping auto-allocation.");
      return { assigned: 0 };
    }

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);
    if (!regSheet || regSheet.getLastRow() <= 1) return { assigned: 0 };

    const candidates = getSheetDataAsObjects(regSheet) || [];
    let assignedCount = 0;

    for (let i = 0; i < candidates.length; i++) {
      const c = candidates[i];
      const rId = String(c.RegistrationID || c.registrationId || '').trim();
      if (!rId) continue;

      const appStatus = String(c.ApplicationStatus || c.Status || '').trim().toLowerCase();
      const isApproved = (appStatus === 'approved' || appStatus === 'active');
      if (!isApproved) continue;

      // Has tag already?
      const existingTag = standardizeRfidFormat(c.RFID_TagID || c.rfidTag || '');
      if (existingTag && existingTag !== 'UNASSIGNED') continue;

      // CRITICAL PRECAUTION: Strict check - Do NOT assign RFID if internship period has ended!
      if (isCandidateInternshipExpired_(c)) {
        Logger.log(`autoAssignPendingApprovedCandidatesRfid_: Skipping expired candidate ${rId} (End Date: ${c.InternshipEndDate || c.EndDate}).`);
        continue;
      }

      // Check mandatory docs
      const b = String(c.BonafideUrl || '').trim();
      const d = String(c.DeclarationUrl || '').trim();
      const cid = String(c.CollegeIdUrl || '').trim();
      if (!b || !d || !cid) continue;

      // Attempt assignment (isManual = false)
      const res = assignAvailableRfid(rId, false, false);
      if (res && res !== 'UNASSIGNED' && (!res.status || res.status !== 'error')) {
        assignedCount++;
      }
    }

    return { assigned: assignedCount };
  } catch (err) {
    Logger.log("autoAssignPendingApprovedCandidatesRfid_ error: " + err.toString());
    return { assigned: 0, error: err.toString() };
  }
}

/**
 * Admin Manual RFID Assignment (Explicit Override):
 * Allows Admin to explicitly assign an available or specific RFID tag to a candidate.
 * When called manually by Admin, isManual = true is passed.
 */
function assignRfidManually(regId, specificTagId) {
  try {
    regId = String(regId || '').trim();
    if (!regId) return { status: 'error', message: 'Registration ID is required' };

    if (specificTagId) {
      const candRec = findCandidateRecordAcrossSheets_(regId);
      if (!candRec || !candRec.found) return { status: 'error', message: 'Candidate not found' };

      const stdTag = standardizeRfidFormat(specificTagId);
      const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);
      if (invSheet) {
        const invData = invSheet.getDataRange().getValues();
        const headers = invData[0];
        const tagCol = headers.indexOf('RFID_TagID');
        const stCol = headers.indexOf('Status');
        const asCol = headers.indexOf('AssignedTo');
        const hoCol = headers.indexOf('HandoverStatus');
        for (let r = 1; r < invData.length; r++) {
          if (standardizeRfidFormat(invData[r][tagCol]) === stdTag) {
            invSheet.getRange(r + 1, stCol + 1).setValue('Assigned');
            if (asCol !== -1) invSheet.getRange(r + 1, asCol + 1).setValue(regId);
            if (hoCol !== -1) invSheet.getRange(r + 1, hoCol + 1).setValue('Pending Handover');
            break;
          }
        }
      }

      if (candRec.sheet && candRec.rowIndex > 1) {
        const hdrs = candRec.sheet.getDataRange().getValues()[0];
        const rCol = hdrs.indexOf('RFID_TagID');
        if (rCol !== -1) candRec.sheet.getRange(candRec.rowIndex, rCol + 1).setValue(stdTag);
      }

      syncRfidDataManagementEntry_(stdTag, regId, 'Assigned', 'Admin', '', 'Good', 'Manually assigned by Admin');
      return { status: 'success', message: `RFID tag ${stdTag} manually assigned to ${regId}.` };
    } else {
      const res = assignAvailableRfid(regId, false, true);
      return { status: 'success', message: `RFID card manually assigned to ${regId}.`, tagId: res };
    }
  } catch (err) {
    return { status: 'error', message: err.toString() };
  }
}


function updateRfidTagStatus(tagId, status) {
  try {
    const rawTag = String(tagId || '').trim();
    const cleanTag = (typeof standardizeRfidFormat === 'function') ? standardizeRfidFormat(rawTag) : rawTag;
    if (!cleanTag) return { status: 'error', message: 'Invalid Tag UID.' };

    const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);
    if (!invSheet) return { status: 'error', message: 'RFID Inventory sheet not found.' };

    const data = invSheet.getDataRange().getValues();
    const headers = data[0];
    const tagCol = headers.indexOf('RFID_TagID');
    const statusCol = headers.indexOf('Status');
    const assignedCol = headers.indexOf('AssignedTo');
    const updCol = headers.indexOf('LastUpdated');

    if (tagCol === -1 || statusCol === -1) return { status: 'error', message: 'Inventory sheet columns missing.' };

    const targetUpper = cleanTag.toUpperCase();
    let updated = false;

    for (let i = 1; i < data.length; i++) {
      const rowTag = String(data[i][tagCol] || '').trim();
      const normRowTag = (typeof standardizeRfidFormat === 'function') ? standardizeRfidFormat(rowTag) : rowTag;
      if (normRowTag.toUpperCase() === targetUpper || rowTag.toUpperCase() === targetUpper) {
        invSheet.getRange(i + 1, statusCol + 1).setValue(status);
        if (updCol !== -1) invSheet.getRange(i + 1, updCol + 1).setValue(new Date());
        if (status === 'Available' && assignedCol !== -1) {
          invSheet.getRange(i + 1, assignedCol + 1).setValue('');
        }
        updated = true;
        break;
      }
    }

    if (!updated) return { status: 'error', message: 'Tag ' + cleanTag + ' not found in inventory.' };
    if (typeof logActivity === 'function') {
      logActivity('RFID Status Update', 'Admin', 'Tag ' + cleanTag + ' status set to ' + status);
    }
    return { status: 'success', message: 'Tag ' + cleanTag + ' status updated to ' + status + ' successfully.' };
  } catch (e) {
    Logger.log("Error in updateRfidTagStatus: " + e.toString());
    return { status: 'error', message: e.toString() };
  }
}

function deleteRfidTag(tagId) {
  try {
    const rawTag = String(tagId || '').trim();
    const cleanTag = (typeof standardizeRfidFormat === 'function') ? standardizeRfidFormat(rawTag) : rawTag;
    if (!cleanTag) return { status: 'error', message: 'Invalid Tag UID.' };

    const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);
    if (!invSheet) return { status: 'error', message: 'RFID Inventory sheet not found.' };

    const data = invSheet.getDataRange().getValues();
    const headers = data[0];
    const tagCol = headers.indexOf('RFID_TagID');
    if (tagCol === -1) return { status: 'error', message: 'Tag ID column not found.' };

    const targetUpper = cleanTag.toUpperCase();
    let deleted = false;

    for (let i = data.length - 1; i >= 1; i--) {
      const rowTag = String(data[i][tagCol] || '').trim();
      const normRowTag = (typeof standardizeRfidFormat === 'function') ? standardizeRfidFormat(rowTag) : rowTag;
      if (normRowTag.toUpperCase() === targetUpper || rowTag.toUpperCase() === targetUpper) {
        invSheet.deleteRow(i + 1);
        deleted = true;
        break;
      }
    }

    if (!deleted) return { status: 'error', message: 'Tag ' + cleanTag + ' not found in inventory.' };
    if (typeof logActivity === 'function') {
      logActivity('RFID Tag Delete', 'Admin', 'Tag ' + cleanTag + ' deleted from inventory pool');
    }
    return { status: 'success', message: 'Tag ' + cleanTag + ' permanently deleted from inventory.' };
  } catch (e) {
    Logger.log("Error in deleteRfidTag: " + e.toString());
    return { status: 'error', message: e.toString() };
  }
}


