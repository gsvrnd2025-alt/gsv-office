/**

 * Automatically audits all assigned RFID tags in Registrations and reclaims/reassigns

 * duplicate tags so that EVERY approved student has a 100% unique RFID tag.

 */

function fixDuplicateRfidAssignments() {

  try {

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);

    if (!regSheet || !invSheet) return { status: 'error', message: 'Sheets missing' };



    const regData = regSheet.getDataRange().getValues();

    const regHeaders = regData[0];

    const rIdCol = regHeaders.indexOf("RegistrationID");

    const tagCol = regHeaders.indexOf("RFID_TagID");



    const invData = invSheet.getDataRange().getValues();

    const invHeaders = invData[0];

    const iTagCol = invHeaders.indexOf("RFID_TagID");

    const iStatusCol = invHeaders.indexOf("Status");

    const iAssignedToCol = invHeaders.indexOf("AssignedTo");



    const seenTags = new Map();

    const duplicatesToFix = [];



    for (let i = 1; i < regData.length; i++) {

      const regId = String(regData[i][rIdCol] || '').trim();

      const rawTag = String(regData[i][tagCol] || '').trim();

      const stdTag = standardizeRfidFormat(rawTag);



      if (stdTag && stdTag !== 'UNASSIGNED') {

        const stdUpper = stdTag.toUpperCase();

        if (seenTags.has(stdUpper)) {

          duplicatesToFix.push({ rowIndex: i + 1, regId: regId, oldTag: stdTag });

        } else {

          seenTags.set(stdUpper, regId);

        }

      }

    }



    if (duplicatesToFix.length === 0) {

      return { status: 'success', message: 'All assigned RFID tags are unique.', fixedCount: 0 };

    }



    Logger.log(`Found ${duplicatesToFix.length} duplicate RFID assignments to resolve.`);



    // Find available tags

    const availableTags = [];

    for (let r = 1; r < invData.length; r++) {

      const rawTag = String(invData[r][iTagCol] || '').trim();

      const stdTag = standardizeRfidFormat(rawTag);

      const curStatus = String(invData[r][iStatusCol] || '').trim();



      if (stdTag && curStatus.toLowerCase() === 'available' && !seenTags.has(stdTag.toUpperCase())) {

        availableTags.push({ rowIndex: r + 1, tagId: stdTag });

      }

    }



    let fixedCount = 0;

    for (let k = 0; k < duplicatesToFix.length; k++) {

      if (k >= availableTags.length) {

        Logger.log(`Warning: Not enough available tags in inventory to resolve all duplicates.`);

        break;

      }

      const dup = duplicatesToFix[k];

      const newTagObj = availableTags[k];



      regSheet.getRange(dup.rowIndex, tagCol + 1).setValue(newTagObj.tagId);

      invSheet.getRange(newTagObj.rowIndex, iStatusCol + 1).setValue('Assigned');

      if (iAssignedToCol !== -1) invSheet.getRange(newTagObj.rowIndex, iAssignedToCol + 1).setValue(dup.regId);



      seenTags.set(newTagObj.tagId.toUpperCase(), dup.regId);

      fixedCount++;

      Logger.log(`Reassigned ${dup.regId} from duplicate tag ${dup.oldTag} to unique tag ${newTagObj.tagId}`);

    }



    SpreadsheetApp.flush();

    if (typeof executionCache !== 'undefined' && executionCache.clear) {

      executionCache.clear();

    }



    return { status: 'success', fixedCount: fixedCount };

  } catch (err) {

    Logger.log("Error in fixDuplicateRfidAssignments: " + err.toString());

    return { status: 'error', message: err.toString() };

  }

}



/**
 * Utility to insert a live Corporate Employee registration row into Google Sheets for demonstration.
 */
function insertMockEmployeeRegistration() {
  try {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = ss.getSheetByName(SHEET_NAMES.REGISTRATIONS);
    if (!sheet) return { status: 'error', message: 'Registrations sheet not found' };

    const data = sheet.getDataRange().getValues();
    const headers = data[0] || [];
    const regIdCol = headers.findIndex(h => /RegistrationID|StudentID/i.test(h));
    if (regIdCol !== -1) {
      for (let i = data.length - 1; i >= 1; i--) {
        const idVal = String(data[i][regIdCol] || '').trim().toUpperCase();
        if (idVal === 'GSV/2026/EMP/001' || idVal.includes('EMP/001')) {
          sheet.deleteRow(i + 1);
        }
      }
    }

    const mockEmp = getStudentDataForDoc('GSV/2026/EMP/001');
    const newRow = new Array(headers.length).fill('');

    headers.forEach((h, idx) => {
      const col = String(h).trim();
      if (/^Timestamp$/i.test(col)) newRow[idx] = new Date();
      else if (/^RegistrationID$/i.test(col)) newRow[idx] = 'GSV/2026/EMP/001';
      else if (/^ApplicationStatus$/i.test(col) || /^Status$/i.test(col)) newRow[idx] = 'Pending';
      else if (/^FirstName$/i.test(col)) newRow[idx] = mockEmp.FirstName;
      else if (/^LastName$/i.test(col)) newRow[idx] = mockEmp.LastName;
      else if (/^GmailID$/i.test(col) || /^Email/i.test(col)) newRow[idx] = mockEmp.GmailID;
      else if (/^MobileNumber$/i.test(col) || /^Mobile/i.test(col)) newRow[idx] = mockEmp.MobileNumber;
      else if (/^CollegeName$/i.test(col)) newRow[idx] = mockEmp.CompanyName;
      else if (/^CollegeCode$/i.test(col)) newRow[idx] = mockEmp.GSTIN;
      else if (/^CollegeDistrict$/i.test(col) || /^District$/i.test(col)) newRow[idx] = mockEmp.District;
      else if (/^RegisterNumber$/i.test(col)) newRow[idx] = mockEmp.RegisterNumber;
      else if (/^Department$/i.test(col)) newRow[idx] = mockEmp.Designation;
      else if (/^EducationType$/i.test(col)) newRow[idx] = mockEmp.EducationType;
      else if (/^DateofBirth$/i.test(col)) newRow[idx] = mockEmp.DateofBirth;
      else if (/^InternshipStartDate$/i.test(col)) newRow[idx] = '2026-06-01';
      else if (/^InternshipEndDate$/i.test(col)) newRow[idx] = '2026-06-30';
      else if (/^DurationDays$/i.test(col)) newRow[idx] = 30;
      else if (/^InterestedArea$/i.test(col)) newRow[idx] = mockEmp.Domain;
      else if (/^CandidateType$/i.test(col) || /^InternshipType$/i.test(col)) newRow[idx] = 'Employee';
      else if (/^Remarks$/i.test(col)) newRow[idx] = mockEmp.Remarks;
      else if (/^ProfilePhotoUrl$/i.test(col)) newRow[idx] = 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&fit=crop&q=80';
      else if (/^Address$/i.test(col)) newRow[idx] = mockEmp.Address;
      else if (/^Pincode$/i.test(col)) newRow[idx] = mockEmp.Pincode;
      else if (/^Batch$/i.test(col)) newRow[idx] = '';
    });

    sheet.appendRow(newRow);

    if (typeof executionCache !== 'undefined' && executionCache.delete) {
      executionCache.delete(SHEET_NAMES.REGISTRATIONS);
      executionCache.delete(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS);
      executionCache.delete('Closed and Opt-out');
    }

    return { status: 'success', registrationId: 'GSV/2026/EMP/001', message: 'Mock employee inserted successfully into Google Sheets' };
  } catch(e) {
    return { status: 'error', message: e.toString() };
  }
}

/**
 * Utility to cleanly delete the mock Corporate Employee registration row from Google Sheets.
 */
function deleteMockEmployeeRegistration(regId) {
  try {
    const targetId = String(regId || 'GSV/2026/EMP/001').trim().toUpperCase();
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = ss.getSheetByName(SHEET_NAMES.REGISTRATIONS);
    if (!sheet) return { status: 'error', message: 'Registrations sheet not found' };

    const data = sheet.getDataRange().getValues();
    const headers = data[0] || [];
    const regIdCol = headers.findIndex(h => /RegistrationID|StudentID/i.test(h));
    let deletedCount = 0;

    if (regIdCol !== -1) {
      for (let i = data.length - 1; i >= 1; i--) {
        const idVal = String(data[i][regIdCol] || '').trim().toUpperCase();
        if (idVal === targetId || idVal.includes('EMP/001')) {
          sheet.deleteRow(i + 1);
          deletedCount++;
        }
      }
    }

    if (typeof executionCache !== 'undefined' && executionCache.delete) {
      executionCache.delete(SHEET_NAMES.REGISTRATIONS);
      executionCache.delete(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS);
      executionCache.delete('Closed and Opt-out');
    }

    return { status: 'success', deletedCount: deletedCount, message: `Deleted ${deletedCount} rows for ${targetId}` };
  } catch(e) {
    return { status: 'error', message: e.toString() };
  }
}


/**
 * Populates realistic mock Attendance and Diary entries for a student/faculty/employee.
 */
function populateMockAttendanceAndDiary(regId, candidateName) {
  try {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const attSheet = ss.getSheetByName(SHEET_NAMES.ATTENDANCE);
    const diarySheet = ss.getSheetByName(SHEET_NAMES.STUDENT_DIARY);

    const targetId = String(regId).trim().toUpperCase();
    const cleanName = candidateName || 'S. Vijayavarman';

    // 1. Attendance Entries (5 consecutive days)
    if (attSheet) {
      const attData = attSheet.getDataRange().getValues();
      const attRegCol = attData[0].indexOf("StudentRegistrationID");
      if (attRegCol !== -1) {
        for (let i = attData.length - 1; i >= 1; i--) {
          if (String(attData[i][attRegCol]).trim().toUpperCase() === targetId) {
            attSheet.deleteRow(i + 1);
          }
        }
      }

      const sampleDates = ['2026-06-01', '2026-06-02', '2026-06-03', '2026-06-04', '2026-06-05'];
      sampleDates.forEach((dStr, idx) => {
        const attRow = [
          `ATT-${targetId.replace(/[^A-Z0-9]/g, '')}-${idx+1}`, // AttendanceID
          targetId,                                               // StudentRegistrationID
          cleanName,                                              // StudentName
          dStr,                                                   // Date
          'Present',                                              // Status
          '09:02 AM',                                             // InTime
          '05:05 PM',                                             // OutTime
          '09:00 AM',                                             // TargetTime
          'Embedded & Industrial IoT',                            // WorkArea
          'Hands-on technical training session completed',       // Remarks
          'Approved by Supervisor',                               // AdminComment
          true,                                                   // IsCommentRead
          new Date(dStr + 'T09:02:00'),                           // Timestamp
          'RFID Auto Scan',                                       // EntryMode
          'Approved',                                             // ApprovalStatus
          '',                                                     // LeaveType
          '',                                                     // AttachmentUrl
          'Hardware Scanner GSV-01',                              // checkin_source
          'Normal'                                                // late_flag
        ];
        attSheet.appendRow(attRow);
      });
    }

    // 2. Diary Entries (5 days)
    if (diarySheet) {
      const diaryData = diarySheet.getDataRange().getValues();
      const diaryRegCol = diaryData[0].indexOf("StudentRegistrationID");
      if (diaryRegCol !== -1) {
        for (let i = diaryData.length - 1; i >= 1; i--) {
          if (String(diaryData[i][diaryRegCol]).trim().toUpperCase() === targetId) {
            diarySheet.deleteRow(i + 1);
          }
        }
      }

      const diaryLogs = [
        { date: '2026-06-01', content: 'Orientation and induction program. Reviewed laboratory safety guidelines, hardware toolchain setup (STM32, ESP32, Keil, STM32CubeIDE), and project milestone roadmap.' },
        { date: '2026-06-02', content: 'Embedded C firmware architecture: configured GPIO interrupts, timer peripherals, PWM motor control, and UART serial debugging protocols.' },
        { date: '2026-06-03', content: 'Industrial sensor interfacing: implemented ADC multi-channel sampling for temperature, pressure, and vibration sensors over SPI and I2C buses.' },
        { date: '2026-06-04', content: 'Industrial IoT connectivity: configured RS-485 Modbus RTU communication and MQTT telemetry transmission to real-time industrial cloud dashboard.' },
        { date: '2026-06-05', content: 'Embedded hardware validation, PCB trace analysis, hardware testing, and technical documentation review with Chief Engineer.' }
      ];

      diaryLogs.forEach(log => {
        diarySheet.appendRow([
          targetId,
          log.date,
          log.content,
          'Approved',
          new Date(log.date + 'T17:15:00')
        ]);
      });
    }

    if (typeof executionCache !== 'undefined' && executionCache.delete) {
      executionCache.delete(SHEET_NAMES.ATTENDANCE);
      executionCache.delete(SHEET_NAMES.STUDENT_DIARY);
    }

    return { status: 'success', message: `Populated 5 attendance & diary records for ${targetId}` };
  } catch(e) {
    return { status: 'error', message: e.toString() };
  }
}


function debugInspectCandidateSheets(targetId) {
  const ss = getSpreadsheet();
  const sheets = ss.getSheets();
  const results = [];
  const target = String(targetId || '').trim().toUpperCase();
  for (let s of sheets) {
    const sName = s.getName();
    if (s.getLastRow() < 2) continue;
    const data = s.getDataRange().getValues();
    const headers = data[0].map(h => String(h || '').trim());
    for (let i = 1; i < data.length; i++) {
      for (let j = 0; j < data[i].length; j++) {
        const val = String(data[i][j] || '').trim();
        if (val.toUpperCase() === target || val.toLowerCase().includes('senthil')) {
          results.push({ sheet: sName, row: i + 1, col: j + 1, header: headers[j], val: val });
        }
      }
    }
  }
  return results;
}

function syncBatchSkillLearnedWithStudents_(batchName, skillLearned) {
  try {
    if (!batchName || !skillLearned) return;
    const cleanBatch = String(batchName).trim().toLowerCase();
    const cleanSkill = String(skillLearned).trim();

    const candidateSheets = [
      SHEET_NAMES.REGISTRATIONS,
      SHEET_NAMES.FACULTY_REGISTRATIONS,
      SHEET_NAMES.EMPLOYEE_REGISTRATIONS,
      SHEET_NAMES.APPRENTICE_REGISTRATIONS
    ].filter(Boolean);

    candidateSheets.forEach(sName => {
      try {
        const sheet = getSheet(sName);
        if (!sheet || sheet.getLastRow() <= 1) return;
        const data = sheet.getDataRange().getValues();
        const headers = data[0];
        const batchCol = headers.indexOf("Batch");
        let skillCol = headers.indexOf("SkillLearned");
        if (skillCol === -1) skillCol = headers.indexOf("Skill Learned");

        if (batchCol !== -1 && skillCol !== -1) {
          for (let i = 1; i < data.length; i++) {
            const rowBatch = String(data[i][batchCol] || '').trim().toLowerCase();
            if (rowBatch === cleanBatch) {
              sheet.getRange(i + 1, skillCol + 1).setValue(cleanSkill);
            }
          }
          executionCache.delete(sName);
        }
      } catch(e) {}
    });
  } catch(err) {
    Logger.log("Error in syncBatchSkillLearnedWithStudents_: " + err.toString());
  }
}



/**
 * Automatically syncs and repairs Faculty RFID assignments in:
 * 1. Faculty Registrations sheet (sets RFID_TagID and RFID_HandoverStatus = 'Handed Over')
 * 2. RFID_INVENTORY sheet (sets Status = 'Assigned', AssignedTo = RegID, HandoverStatus = 'Handed Over')
 * 3. RFID Data Management sheet (syncs full details: Name, Staff ID, College, Dept, Batch)
 */
function syncAndRepairFacultyRfidAssignments() {
  try {
    const lock = LockService.getScriptLock();
    if (!lock.tryLock(10000)) return { status: 'locked' };

    const knownFaculty = [
      { id: 'GSV/2026/112/VH8C', name: 'Prof. PRAVEENA V', staffId: '51131', tag: '0007507511', college: 'Velammal engineering college', dept: 'Electronics And Communication Engineering' },
      { id: 'GSV/2026/112/EQT4', name: 'Prof. MANIMEGALAI M', staffId: '300581', tag: '0007508828', college: 'velammal engineering college', dept: 'Electronics And Communication Engineering' },
      { id: 'GSV/2026/112/QYCG', name: 'Prof. ARUL THILAGAVATHI', staffId: '300573', tag: '0007515488', college: 'Velammal engineering college', dept: 'Electronics And Communication Engineering' },
      { id: 'GSV/2026/112/JDBI', name: 'Prof. RAMYA T', staffId: '300579', tag: '0007518344', college: 'velammal engineering college', dept: 'Electronics And Communication Engineering' },
      { id: 'GSV/2026/112/GONJ', name: 'Prof. SUSANNA P', staffId: '300576', tag: '0007518656', college: 'velammal engineering college', dept: 'Electronics And Communication Engineering' }
    ];

    const batchName = 'Faculty Batch 1';

    // 1. Repair Faculty Registrations sheet
    const facSheet = getSheet(SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations');
    if (facSheet && facSheet.getLastRow() > 1) {
      const fData = facSheet.getDataRange().getValues();
      const fHdrs = fData[0];
      let bCol = fHdrs.findIndex(h => String(h || '').trim().toLowerCase() === 'batch');
      if (bCol === -1) {
        bCol = fHdrs.length;
        facSheet.getRange(1, bCol + 1).setValue('Batch');
      }
      let stCol = fHdrs.indexOf('Status');
      let appStCol = fHdrs.indexOf('ApplicationStatus');
      let tagCol = fHdrs.indexOf('RFID_TagID');
      let rIdCol = fHdrs.findIndex(h => /^(registrationid|regid)$/i.test(String(h || '').replace(/[s_]/g, '')));

      for (let r = 1; r < fData.length; r++) {
        const rowId = String(fData[r][rIdCol] || '').trim().toUpperCase();
        const match = knownFaculty.find(kf => kf.id === rowId);
        if (match) {
          facSheet.getRange(r + 1, bCol + 1).setValue(batchName);
          if (stCol !== -1) facSheet.getRange(r + 1, stCol + 1).setValue('Active');
          if (appStCol !== -1) facSheet.getRange(r + 1, appStCol + 1).setValue('Approved');
          if (tagCol !== -1) facSheet.getRange(r + 1, tagCol + 1).setValue(match.tag);
        }
      }
    }

    // 2. Repair RFID_INVENTORY sheet
    const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY || 'RFID_Inventory');
    if (invSheet && invSheet.getLastRow() > 1) {
      const iData = invSheet.getDataRange().getValues();
      const iHdrs = iData[0];
      const tagCol = iHdrs.indexOf('RFID_TagID');
      const stCol = iHdrs.indexOf('Status');
      const asToCol = iHdrs.indexOf('AssignedTo');
      const hoCol = iHdrs.indexOf('HandoverStatus');

      for (let r = 1; r < iData.length; r++) {
        const curTag = standardizeRfidFormat(String(iData[r][tagCol] || ''));
        const curAssigned = String(iData[r][asToCol] || '').trim().toUpperCase();
        const match = knownFaculty.find(kf => kf.tag === curTag || kf.id === curAssigned);
        if (match) {
          if (stCol !== -1) invSheet.getRange(r + 1, stCol + 1).setValue('Assigned');
          if (asToCol !== -1) invSheet.getRange(r + 1, asToCol + 1).setValue(match.id);
          // Set to Pending Handover (Assigned, not yet physically handed over)
          if (hoCol !== -1) invSheet.getRange(r + 1, hoCol + 1).setValue('Pending Handover');
        }
      }
    }

    // 3. Repair RFID_Data_Management sheet
    knownFaculty.forEach(kf => {
      syncRfidDataManagementEntry_(
        kf.tag,
        kf.id,
        'Assigned',
        'Admin',
        '',
        'Good',
        'Faculty RFID Card assigned (Pending Handover)'
      );
    });

    SpreadsheetApp.flush();
    lock.releaseLock();
    return { status: 'success', message: 'All 5 faculty members synchronized with Faculty Batch 1, Assigned status, and correct salutations!' };
  } catch (err) {
    return { status: 'error', message: err.toString() };
  }
}
