    ];



    let addedCount = 0;

    defaultTemplates.forEach(tpl => {

      if (!existingTypes.has(tpl.type)) {

        const newId = generateUniqueId('TMP', sheet, 0);

        appendRow(SHEET_NAMES.EMAIL_TEMPLATES, [newId, tpl.type, tpl.subject, tpl.body, '']);

        addedCount++;

      }

    });



    return { status: 'success', message: addedCount > 0 ? `${addedCount} new templates added successfully.` : 'All templates already exist.' };

  } catch (e) {

    return { status: 'error', message: e.message };

  }

}



function sendAdminEmail(arg1, arg2, arg3) {

  let recipientRegId, subject, body;



  if (typeof arg1 === 'object' && arg1 !== null) {

    recipientRegId = arg1.recipientRegId;

    subject = arg1.customSubject || arg1.subject;

    body = arg1.customBody || arg1.body;

  } else {

    recipientRegId = arg1;

    subject = arg2;

    body = arg3;

  }



  try {

    if (!subject || !body) return { status: 'error', message: 'Subject and Email Body are required.' };



    let recipients = [];

    if (recipientRegId) {

      if (recipientRegId.includes('@')) {

        // Direct email

        recipients.push({ email: recipientRegId, name: 'Student', fullData: {} });

      } else {

        // Reg ID

        const student = getStudentDataForDoc(recipientRegId);

        if (student && student.GmailID) {

          recipients.push({ email: student.GmailID, name: student.FirstName, fullData: student });

        } else {

          return { status: 'error', message: 'Student ' + recipientRegId + ' not found or has no email.' };

        }

      }

    } else {

      // Bulk email to Approved/Active

      const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

      const data = getSheetDataAsObjects(regSheet);

      recipients = data.filter(s => {

        const sStatus = String(s.ApplicationStatus || '').toLowerCase();

        return sStatus === 'approved' || sStatus === 'active' || sStatus === 'assigned';

      }).map(s => ({

        email: s.GmailID,

        name: s.FirstName,

        fullData: {

          ...s,

          FullName: getStudentFullName_(s),

          FormattedStartDate: formatDateDisplay(s.InternshipStartDate),

          FormattedEndDate: formatDateDisplay(s.InternshipEndDate),

          CompanyName: COMPANY_NAME

        }

      }));

    }



    let emailsSentCount = 0;

    recipients.forEach(recipient => {

      let personalizedBodyText = body;

      let personalizedSubject = subject;



      personalizedBodyText = personalizedBodyText.replace(/{{StudentName}}/gi, recipient.name || 'Student');

      personalizedSubject = personalizedSubject.replace(/{{StudentName}}/gi, recipient.name || 'Student');



      if (recipient.fullData) {

        Object.keys(recipient.fullData).forEach(key => {

          const val = recipient.fullData[key];

          if (val !== undefined && val !== null) {

            const regexDouble = new RegExp('\\{\\{' + key + '\\}\\}', 'g');

            personalizedBodyText = personalizedBodyText.replace(regexDouble, val);

            personalizedSubject = personalizedSubject.replace(regexDouble, val);

            const regexSingle = new RegExp('\\{' + key + '\\}', 'g');

            personalizedBodyText = personalizedBodyText.replace(regexSingle, val);

            personalizedSubject = personalizedSubject.replace(regexSingle, val);

          }

        });

      }



      // Auto-detect email type from subject for professional template styling

      const subLower = personalizedSubject.toLowerCase();

      let emailType = 'custom';

      if (subLower.includes('confirm') || subLower.includes('approved')) emailType = 'confirmation';

      else if (subLower.includes('complet') || subLower.includes('congratulat')) emailType = 'completion';

      else if (subLower.includes('welcome') || subLower.includes('future')) emailType = 'welcome';

      else if (subLower.includes('reject')) emailType = 'rejected';

      else if (subLower.includes('offer letter')) emailType = 'offerLetter';

      else if (subLower.includes('joining')) emailType = 'joiningLetter';

      else if (subLower.includes('certificate')) emailType = 'certificate';

      else if (subLower.includes('attendance') || subLower.includes('reminder')) emailType = 'attendance';

      else if (subLower.includes('diary')) emailType = 'diary';

      else if (subLower.includes('task')) emailType = 'task';

      else if (subLower.includes('rfid')) emailType = 'rfid';

      else if (subLower.includes('opt-out') || subLower.includes('optout')) emailType = 'optout';

      else if (subLower.includes('document') || subLower.includes('upload')) emailType = 'documentReminder';

      else if (subLower.includes('pending')) emailType = 'pending';

      else if (subLower.includes('password') || subLower.includes('forgot')) emailType = 'forgotPassword';

      else if (subLower.includes('project') && subLower.includes('delay')) emailType = 'projectDelay';



      // Build professional HTML body using template

      const emailData = {

        FullName: recipient.fullData.FullName || recipient.name || 'Student',

        Body: personalizedBodyText,

        DurationDays: recipient.fullData.DurationDays || '',

        RegistrationID: recipient.fullData.RegistrationID || '',

        Department: recipient.fullData.Department || '',

        CollegeName: recipient.fullData.CollegeName || ''

      };

      const htmlBody = getProfessionalEmailBody(emailType, emailData, '');



      if (sendEmail(recipient.email, personalizedSubject, personalizedBodyText, htmlBody)) {

        emailsSentCount++;

      }

    });



    logActivity('Emails Sent', `Custom email: ${subject} sent to ${emailsSentCount} recipient(s)`);

    return { status: 'success', message: 'Email sent to ' + emailsSentCount + ' recipient(s).' };

  } catch (error) {

    return { status: 'error', message: 'Error sending custom email: ' + error.message };

  }

}



/**

 * Generates an HTML preview for the email template before sending.

 */

function getEmailPreviewHtml(subject, body, studentName, additionalParams = {}) {

  try {

    const subLower = (subject || '').toLowerCase();

    let emailType = 'custom';

    if (subLower.includes('confirm') || subLower.includes('approved')) emailType = 'confirmation';

    else if (subLower.includes('complet') || subLower.includes('congratulat')) emailType = 'completion';

    else if (subLower.includes('welcome') || subLower.includes('future')) emailType = 'welcome';

    else if (subLower.includes('reject')) emailType = 'rejected';

    else if (subLower.includes('offer letter')) emailType = 'offerLetter';

    else if (subLower.includes('joining')) emailType = 'joiningLetter';

    else if (subLower.includes('certificate')) emailType = 'certificate';

    else if (subLower.includes('attendance') || subLower.includes('reminder')) emailType = 'attendance';

    else if (subLower.includes('diary')) emailType = 'diary';

    else if (subLower.includes('task')) emailType = 'task';

    else if (subLower.includes('rfid')) emailType = 'rfid';

    else if (subLower.includes('opt-out') || subLower.includes('optout')) emailType = 'optout';

    else if (subLower.includes('document') || subLower.includes('upload')) emailType = 'documentReminder';

    else if (subLower.includes('pending')) emailType = 'pending';

    else if (subLower.includes('password') || subLower.includes('forgot')) emailType = 'forgotPassword';

    else if (subLower.includes('project') && subLower.includes('delay')) emailType = 'projectDelay';



    const p = additionalParams || {};

    const emailData = {

      FullName: studentName || '{{StudentName}}',

      Body: body || '',

      DurationDays: p.DurationDays || '{{DurationDays}}',

      RegistrationID: p.RegistrationID || '{{RegistrationID}}',

      Department: p.Department || '{{Department}}',

      CollegeName: p.CollegeName || '{{CollegeName}}'

    };



    return getProfessionalEmailBody(emailType, emailData, '');

  } catch (e) {

    return `<div style="padding: 20px; color: red;">Error generating preview: ${e.message}</div>`;

  }

}



// DOC GENERATION

/**

 * Programmatically builds a default professional Google Doc template.

 */

function createDefaultDocTemplate(docType, name) {

  const doc = DocumentApp.create(name);

  const body = doc.getBody();

  

  const titleStyle = {};

  titleStyle[DocumentApp.Attribute.FONT_FAMILY] = 'Arial';

  titleStyle[DocumentApp.Attribute.FONT_SIZE] = 18;

  titleStyle[DocumentApp.Attribute.BOLD] = true;

  titleStyle[DocumentApp.Attribute.FOREGROUND_COLOR] = '#1a73e8';

  titleStyle[DocumentApp.Attribute.HORIZONTAL_ALIGNMENT] = DocumentApp.HorizontalAlignment.CENTER;

  

  const heading = body.appendParagraph(typeof COMPANY_NAME !== 'undefined' ? COMPANY_NAME : "GSV Electrical Enterprises");

  heading.setAttributes(titleStyle);

  

  const subTitleStyle = {};

  subTitleStyle[DocumentApp.Attribute.FONT_FAMILY] = 'Arial';

  subTitleStyle[DocumentApp.Attribute.FONT_SIZE] = 14;

  subTitleStyle[DocumentApp.Attribute.BOLD] = true;

  subTitleStyle[DocumentApp.Attribute.FOREGROUND_COLOR] = '#4361ee';

  subTitleStyle[DocumentApp.Attribute.HORIZONTAL_ALIGNMENT] = DocumentApp.HorizontalAlignment.CENTER;

  

  let subTitleText = "";

  let contentText = "";

  

  if (docType === 'applicationForm') {

    subTitleText = "Internship Application Form";

    contentText = "\nRegistration ID: {{RegistrationID}}\n" +

                  "Student Name: {{FullName}}\n" +

                  "College Roll No: {{RegisterNumber}}\n" +

                  "College Name: {{CollegeName}}\n" +

                  "Department: {{Department}}\n" +

                  "Year/Semester: Year {{Year}}, Sem {{Semester}}\n" +

                  "Internship Period: {{InternshipStartDate}} to {{InternshipEndDate}}\n" +

                  "Duration: {{DurationDays}} Days\n" +

                  "Date of Birth: {{DateofBirth}}\n" +

                  "Contact Number: {{MobileNumber}}\n" +

                  "Gmail ID: {{GmailID}}\n" +

                  "Address: {{Address}}\n\n" +

                  "I hereby declare that all details provided are correct.";

  } else if (docType === 'offerLetter') {

    subTitleText = "Internship Offer Letter";

    contentText = "\nDate: {{TodayDate}}\n\n" +

                  "To,\n" +

                  "{{FullName}}\n" +

                  "Registration ID: {{RegistrationID}}\n\n" +

                  "Dear {{FullName}},\n\n" +

                  "We are pleased to offer you an internship at GSV Electrical Enterprises (Electrical and Electronics Products). " +

                  "Your internship is scheduled from {{InternshipStartDate}} to {{InternshipEndDate}} for a duration of {{DurationDays}} Days.\n\n" +

                  "We look forward to a mutually beneficial association.\n\n" +

                  "Best regards,\n" +

                  (typeof COMPANY_CHIEF_ENGINEER !== 'undefined' ? COMPANY_CHIEF_ENGINEER : "Chief Engineer") + "\n" +

                  (typeof COMPANY_CHIEF_TITLE !== 'undefined' ? COMPANY_CHIEF_TITLE : "Chief Engineer cum Proprietor");

  } else if (docType === 'joiningLetter') {

    subTitleText = "Internship Joining Letter";

    contentText = "\nDate: {{TodayDate}}\n\n" +

                  "To,\n" +

                  "{{FullName}}\n" +

                  "Registration ID: {{RegistrationID}}\n\n" +

                  "Dear {{FullName}},\n\n" +

                  "This letter confirms your joining at GSV Electrical Enterprises (Electrical and Electronics Products) for your internship starting {{InternshipStartDate}}.\n\n" +

                  "Please report to our office at the scheduled slot.\n\n" +

                  "Best regards,\n" +

                  (typeof COMPANY_CHIEF_ENGINEER !== 'undefined' ? COMPANY_CHIEF_ENGINEER : "Chief Engineer") + "\n" +

                  (typeof COMPANY_CHIEF_TITLE !== 'undefined' ? COMPANY_CHIEF_TITLE : "Chief Engineer cum Proprietor");

  } else if (docType === 'idCard') {

    subTitleText = "Intern ID Card";

    contentText = "\n----------------------------------------\n" +

                  "GSV ELECTRICAL ENTERPRISES\n" +

                  "----------------------------------------\n" +

                  "Name: {{FullName}}\n" +

                  "Reg ID: {{RegistrationID}}\n" +

                  "Batch: {{Batch}}\n" +

                  "----------------------------------------";

  } else if (docType === 'entryPass') {

    subTitleText = "Internship Entry Pass";

    contentText = "\nName: {{FullName}}\n" +

                  "Registration ID: {{RegistrationID}}\n" +

                  "Internship Period: {{InternshipStartDate}} to {{InternshipEndDate}}\n" +

                  "Batch Slot: {{Batch}}";

  } else if (docType === 'internshipCertificate') {

    subTitleText = "Certificate of Completion";

    contentText = "\nCertificate Serial No: {{CertificateNumber}}\n" +

                  "Date of Issue: {{IssuedDate}}\n\n" +

                  "This is to certify that {{FullName}} (Reg No: {{RegisterNumber}}), " +

                  "a student of {{CollegeName}}, Department of {{Department}}, " +

                  "has successfully completed their internship training at GSV Electrical Enterprises (Electrical and Electronics Products) " +

                  "from {{InternshipStartDate}} to {{InternshipEndDate}}.\n\n" +

                  "During this period, their performance was found to be satisfactory.\n\n" +

                  "Best regards,\n" +

                  (typeof COMPANY_CHIEF_ENGINEER !== 'undefined' ? COMPANY_CHIEF_ENGINEER : "Chief Engineer") + "\n" +

                  (typeof COMPANY_CHIEF_TITLE !== 'undefined' ? COMPANY_CHIEF_TITLE : "Chief Engineer cum Proprietor");

  } else {

    subTitleText = "System Template";

    contentText = "\nTemplate for {{FullName}}\nReg ID: {{RegistrationID}}";

  }

  

  const sub = body.appendParagraph(subTitleText);

  sub.setAttributes(subTitleStyle);

  

  const bodyStyle = {};

  bodyStyle[DocumentApp.Attribute.FONT_FAMILY] = 'Arial';

  bodyStyle[DocumentApp.Attribute.FONT_SIZE] = 11;

  bodyStyle[DocumentApp.Attribute.BOLD] = false;

  bodyStyle[DocumentApp.Attribute.FOREGROUND_COLOR] = '#333333';

  bodyStyle[DocumentApp.Attribute.HORIZONTAL_ALIGNMENT] = DocumentApp.HorizontalAlignment.LEFT;

  

  const content = body.appendParagraph(contentText);

  content.setAttributes(bodyStyle);

  

  doc.saveAndClose();

  return doc.getId();

}



/**

 * Resolves a verified, accessible Document Template.

 * Self-healing: if the template does not exist or access is denied,

 * it searches Drive for a file with the default name. If still not found, it programmatically

 * creates a new Google Doc template and updates settings.

 */

function getTemplateIdForDocType(docType, certTemplate) {

  const isT2 = (certTemplate === 'T2' || certTemplate === 't2' || certTemplate === 'template2' || certTemplate === 'Template2' || docType === 'internshipCertificate_T2');

  const mapping = {

    'internshipCertificate': isT2 ? 'TPL_CERTIFICATE_T2' : 'TPL_CERTIFICATE',

    'completionCertificate': isT2 ? 'TPL_CERTIFICATE_T2' : 'TPL_CERTIFICATE',

    'offerLetter': 'TPL_OFFER_LETTER',

    'confirmationLetter': 'TPL_CONFIRMATION_LETTER',

    'joiningLetter': 'TPL_JOINING_LETTER',

    'entryPass': 'TPL_ENTRY_PASS',

    'idCard': 'TPL_ID_CARD',

    'applicationForm': 'TPL_APPLICATION_FORM'

  };

  const templateNames = {

    'internshipCertificate': isT2 ? 'GSV_Internship_Certificate_Template_T2' : 'GSV_Internship_Certificate_Template',

    'completionCertificate': isT2 ? 'GSV_Internship_Certificate_Template_T2' : 'GSV_Internship_Certificate_Template',

    'offerLetter': 'GSV_Offer_Letter_Template',

    'confirmationLetter': 'GSV_Confirmation_Letter_Template',

    'joiningLetter': 'GSV_Joining_Letter_Template',

    'entryPass': 'GSV_Entry_Pass_Template',

    'idCard': 'GSV_ID_Card_Template',

    'applicationForm': 'GSV_Application_Form_Template'

  };



  const settingKey = mapping[docType] || (isT2 ? 'TPL_CERTIFICATE_T2' : 'TPL_CERTIFICATE');

  

  // 1. Try hardcoded constants in code.js (TEMPLATE_IDS) first!

  const tplIds = (typeof TEMPLATE_IDS !== 'undefined' && TEMPLATE_IDS) ? TEMPLATE_IDS : {

    OFFER_LETTER: '1Jph612tzuUoxc1k9kjU5TVPltm_Z8KGeHszYSgEiirk',

    CONFIRMATION_LETTER: '1Jph612tzuUoxc1k9kjU5TVPltm_Z8KGeHszYSgEiirk',

    JOINING_LETTER: '1Jph612tzuUoxc1k9kjU5TVPltm_Z8KGeHszYSgEiirk',

    ID_CARD: '1Jph612tzuUoxc1k9kjU5TVPltm_Z8KGeHszYSgEiirk',

    ENTRY_PASS: '1Jph612tzuUoxc1k9kjU5TVPltm_Z8KGeHszYSgEiirk',

    INTERNSHIP_CERTIFICATE: '1VD8xC3OFZ6FvDmGifDt7my4bvaUUgAyKxxj9h7yJlZY',

    INTERNSHIP_CERTIFICATE_T2: '1CttkNmYwOGWIhXo61i_oquqxBEf7ZtXdBg7YeCza55E',

    APPLICATION_FORM: '1kzbHGvqITge2s4cqIIq4TyWbPPCM9I8RhCwQnOU27Sk'

  };



  const defaults = {

    'internshipCertificate': isT2 ? tplIds.INTERNSHIP_CERTIFICATE_T2 : tplIds.INTERNSHIP_CERTIFICATE,

    'completionCertificate': isT2 ? tplIds.INTERNSHIP_CERTIFICATE_T2 : tplIds.INTERNSHIP_CERTIFICATE,

    'offerLetter': tplIds.OFFER_LETTER,

    'confirmationLetter': tplIds.CONFIRMATION_LETTER,

    'joiningLetter': tplIds.JOINING_LETTER,

    'entryPass': tplIds.ENTRY_PASS,

    'idCard': tplIds.ID_CARD,

    'applicationForm': tplIds.APPLICATION_FORM

  };

  

  let templateId = defaults[docType];

  

  if (templateId && templateId.toString().trim() !== '') {

    try {

      const file = DriveApp.getFileById(templateId.toString().trim());

      file.getName(); // Access check

      Logger.log(`Using primary template ID from code.js for ${docType} (T2=${isT2}): ${templateId}`);

      if (settingKey) {

        saveAppSettings({ [settingKey]: templateId.toString().trim() });

      }

      return templateId.toString().trim();

    } catch (e) {

      Logger.log(`Access check for primary template ${templateId} (${docType}) failed: ${e.toString()}. Checking verified fallbacks.`);

    }

  }



  // Check verified public fallback template if primary has restricted permissions

  const publicFallbacks = {

    'applicationForm': '1kzbHGvqITge2s4cqIIq4TyWbPPCM9I8RhCwQnOU27Sk',

    'internshipCertificate': isT2 ? '1CttkNmYwOGWIhXo61i_oquqxBEf7ZtXdBg7YeCza55E' : '1VD8xC3OFZ6FvDmGifDt7my4bvaUUgAyKxxj9h7yJlZY',

    'completionCertificate': isT2 ? '1CttkNmYwOGWIhXo61i_oquqxBEf7ZtXdBg7YeCza55E' : '1VD8xC3OFZ6FvDmGifDt7my4bvaUUgAyKxxj9h7yJlZY',

    'offerLetter': '1Jph612tzuUoxc1k9kjU5TVPltm_Z8KGeHszYSgEiirk',

    'confirmationLetter': '1Jph612tzuUoxc1k9kjU5TVPltm_Z8KGeHszYSgEiirk',

    'joiningLetter': '1Jph612tzuUoxc1k9kjU5TVPltm_Z8KGeHszYSgEiirk'

  };

  const verifiedFb = publicFallbacks[docType];

  if (verifiedFb && verifiedFb !== templateId) {

    try {

      const fbFile = DriveApp.getFileById(verifiedFb);

      fbFile.getName();

      Logger.log(`Using verified accessible fallback template ID for ${docType}: ${verifiedFb}`);

      return verifiedFb;

    } catch(fbErr) {

      Logger.log(`Fallback template access failed for ${docType}: ${fbErr.toString()}`);

    }

  }



  // 2. Fall back to settings sheet if hardcoded constant is empty/invalid

  const settingsResult = getAppSettings();

  const appSettings = (settingsResult && settingsResult.status === 'success') ? settingsResult.settings : {};

  let settingsId = settingKey ? appSettings[settingKey] : null;

  if (settingsId && settingsId.toString().trim() !== '') {

    try {

      const file = DriveApp.getFileById(settingsId.toString().trim());

      file.getName(); // Access check

      return settingsId.toString().trim();

    } catch (e) {

      Logger.log(`Access to settings template ID ${settingsId} for '${docType}' failed: ${e.toString()}`);

    }

  }



  // 3. Search Drive by name

  const name = templateNames[docType] || `GSV_${docType}_Template`;

  try {

    const files = DriveApp.getFilesByName(name);

    if (files.hasNext()) {

      const file = files.next();

      const newId = file.getId();

      if (settingKey) {

        saveAppSettings({ [settingKey]: newId });

      }

      Logger.log(`Found existing template file '${name}' with ID: ${newId}. Re-assigned in settings.`);

      return newId;

    }

  } catch (e) {

    Logger.log(`Search for template file '${name}' failed: ${e.toString()}`);

  }



  // 4. Create new default template only if everything else failed

  try {

    const newId = createDefaultDocTemplate(docType, name);

    if (settingKey) {

      saveAppSettings({ [settingKey]: newId });

    }

    Logger.log(`Created new template Google Doc '${name}' with ID: ${newId}. Saved to settings.`);

    return newId;

  } catch (e) {

    Logger.log(`Critical: Failed to create default template '${name}': ${e.toString()}`);

    return null;

  }

}



function getStudentDataForDoc(registrationId) {
  if (!registrationId || isCandidateDeleted(registrationId)) return null;

  const targetId = String(registrationId).trim().toUpperCase();

  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);

  const candidateSheets = [
    getSheet(SHEET_NAMES.REGISTRATIONS),
    getSheet(SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations'),
    getSheet(SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations'),
    getSheet(SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations'),
    getSheet('Closed and Opt-out'),
    getSheet('Closed and Opt-Out'),
    getSheet('Closed'),
    getSheet('Archived'),
    getSheet(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS),
    getSheet(SHEET_NAMES.FACULTY_CONSOLIDATED || 'Faculty_Consolidated_Internships'),
    getSheet(SHEET_NAMES.EMPLOYEE_CONSOLIDATED || 'Employee_Consolidated_Internships'),
    getSheet(SHEET_NAMES.APPRENTICE_CONSOLIDATED || 'Apprentice_Consolidated_Internships')
  ].filter(Boolean);

  

  for (let s = 0; s < candidateSheets.length; s++) {

    const regSheet = candidateSheets[s];

    const data = regSheet.getDataRange().getValues();

    if (data.length < 2) continue;

    const header = data[0];



    const normalizedHeaderMap = {};

    header.forEach((colName, index) => {

      if (colName) {

        normalizedHeaderMap[colName.toString().trim().toLowerCase().replace(/[\s_]/g, '')] = index;

      }

    });



    const regIdCol = normalizedHeaderMap['registrationid'] !== undefined ? normalizedHeaderMap['registrationid'] :

                     (normalizedHeaderMap['regid'] !== undefined ? normalizedHeaderMap['regid'] :

                     (normalizedHeaderMap['studentregistrationid'] !== undefined ? normalizedHeaderMap['studentregistrationid'] : undefined));

    const regNoCol = normalizedHeaderMap['registernumber'] !== undefined ? normalizedHeaderMap['registernumber'] : normalizedHeaderMap['registerno'];

    if (regIdCol === undefined && regNoCol === undefined) continue;



    for (let i = 1; i < data.length; i++) {

      const rowId = (regIdCol !== undefined) ? String(data[i][regIdCol] || '').trim().toUpperCase() : '';

      const rowRegNo = (regNoCol !== undefined) ? String(data[i][regNoCol] || '').trim().toUpperCase() : '';

      if ((rowId && rowId === targetId) || (rowRegNo && rowRegNo === targetId)) {

        const studentRow = data[i];

        const studentInfo = {};



        header.forEach((colName, index) => {

          const trimmedColName = colName ? colName.toString().trim() : '';

          if (trimmedColName) {

            studentInfo[trimmedColName] = studentRow[index];

          }

        });



        const constructedName = [studentInfo.FirstName, studentInfo.MiddleName, studentInfo.LastName].filter(Boolean).join(' ').trim();
        
        // Sanitize and resolve faculty fields early if candidate is Faculty
        const isFacultyCandidate = (typeof getCandidateCategory_ === 'function' && getCandidateCategory_(studentInfo) === 'Faculty') ||
                                   String(studentInfo.CandidateType || '').toLowerCase() === 'faculty' ||
                                   String(studentInfo.InternshipType || '').toLowerCase() === 'faculty' ||
                                   String(studentInfo.Remarks || '').startsWith('[FACULTY]');
        if (isFacultyCandidate) {
          studentInfo.CandidateType = 'Faculty';
          studentInfo.InternshipType = 'Faculty';
          const facRem = parseFacultyRemarks_(studentInfo.Remarks);
          
          let fG = String(studentInfo.Gender || studentInfo.gender || '').trim();
          if (fG.length > 15 || /college|department|road|street/i.test(fG)) fG = '';
          if (!fG) {
            if (/^(male|female|other)$/i.test(String(studentInfo.InterestedArea || '').trim())) fG = String(studentInfo.InterestedArea).trim();
            else if (/susanna|ramya|priya/i.test(constructedName || studentInfo.FullName || '')) fG = 'Female';
            else fG = 'Female';
          }
          studentInfo.Gender = fG;
          studentInfo.gender = fG;

          // Domain
          let fD = String(studentInfo.facultyDomain || studentInfo.Specialization || studentInfo.Domain || '').trim();
          if (!fD || /^(male|female|other|--)$/i.test(fD)) fD = facRem.domain || '';
          if (!fD && studentInfo.Department) {
            const mD = String(studentInfo.Department).match(/\(([^)]+)\)/);
            if (mD && !/^(male|female|other)$/i.test(mD[1].trim())) fD = mD[1].trim();
          }
          if (!fD) fD = 'Embedded Systems & IoT';
          studentInfo.facultyDomain = fD;
          let fIntA = String(studentInfo.InterestedArea || studentInfo.interestedArea || studentInfo.WorkArea || '').trim();
          if (!fIntA || /^(male|female|other|--)$/i.test(fIntA)) {
            fIntA = facRem.interestedArea || '';
          }
          if (!fIntA && studentInfo.Department) {
            const dLow = String(studentInfo.Department).toLowerCase();
            if (dLow.includes('electronics') || dLow.includes('ece')) fIntA = 'R&D (IoT & Electronics)';
            else if (dLow.includes('computer') || dLow.includes('cse') || dLow.includes('it')) fIntA = 'Product Development & Software';
            else if (dLow.includes('electrical') || dLow.includes('eee')) fIntA = 'Power Electronics & Embedded Systems';
            else fIntA = 'R&D (IoT & Electronics)';
          }
          if (!fIntA) fIntA = 'R&D (IoT & Electronics)';
          studentInfo.InterestedArea = fIntA;

          // Passout Year
          let fP = String(studentInfo.facultyPassYear || studentInfo.PassoutYear || studentInfo.GraduationYear || '').trim();
          if (!fP || /^(faculty|student|employee|apprentice|--)$/i.test(fP)) fP = facRem.passout || '';
          if (!fP && studentInfo.Year && !/^(faculty|student|employee|apprentice)$/i.test(String(studentInfo.Year).trim())) fP = String(studentInfo.Year).trim();
          const mY = String(fP).match(/\b(19\d\d|20[0-2]\d)\b/);
          if (mY) fP = mY[1];
          if (!fP) fP = '2021';
          studentInfo.facultyPassYear = fP;
          studentInfo.Year = fP;

          // Teaching Experience
          let fE = String(studentInfo.TeachingExperience || studentInfo.facultyExperience || studentInfo.WorkExperience || '').trim();
          if (!fE || /academic\s*experience/i.test(fE) || fE === '--') fE = facRem.exp || '';
          if (!fE) {
            const pN = parseInt(fP, 10);
            if (pN && pN >= 1980 && pN <= 2025) fE = `${2026 - pN} Years`;
            else fE = '5 Years';
          }
          studentInfo.TeachingExperience = fE;
          studentInfo.facultyExperience = fE;

          if (facRem.staffId && (!studentInfo.FacultyStaffId || studentInfo.FacultyStaffId === 'N/A')) studentInfo.FacultyStaffId = facRem.staffId;
          if (facRem.designation && (!studentInfo.Designation || studentInfo.Designation === 'Faculty Member')) studentInfo.Designation = facRem.designation;
        }

        const candSal = getCandidateSalutation_(studentInfo);
        studentInfo.Salutation = candSal;
        let baseRawName = (studentInfo.FullName || studentInfo.Name || constructedName || studentInfo.StudentName || 'Student').replace(/^(dr\.|mr\.|ms\.|mrs\.|dr|mr|ms|mrs)\s+/i, '').trim();
        studentInfo.FullName = `${candSal} ${baseRawName}`;
        studentInfo.Name = studentInfo.FullName;
        studentInfo.StudentName = studentInfo.FullName;
        studentInfo.RawNameWithoutSalutation = baseRawName;

        studentInfo.RegistrationID = studentInfo.RegistrationID || studentInfo.RegistrationId || registrationId;

        studentInfo.Department = expandDepartmentFullName(studentInfo.Department || studentInfo.Dept || studentInfo.Branch || '--');

        studentInfo.CollegeName = studentInfo.CollegeName || studentInfo.College || studentInfo.College_Name || '--';

        studentInfo.CollegeDistrict = studentInfo.CollegeDistrict || studentInfo.District || studentInfo.College_District || studentInfo.DistrictName || '';

        studentInfo.RegisterNumber = studentInfo.RegisterNumber || studentInfo.RegistrationNumber || studentInfo.RollNumber || studentInfo.CollegeRegisterNo || studentInfo.UniversityRegisterNumber || 'N/A';

        studentInfo.Year = studentInfo.Year || studentInfo.Semester || '--';



        // Resolve Pincode (with fallback 6-digit Indian PIN extraction from Address)

        let resolvedPincode = String(studentInfo.Pincode || studentInfo['Pin Code'] || studentInfo['PIN Code'] || studentInfo.Pin || studentInfo.PostalCode || studentInfo.ZipCode || '').trim();

        if (!resolvedPincode || resolvedPincode === 'N/A' || resolvedPincode.toUpperCase() === 'NULL') {

          const mPin = String(studentInfo.Address || studentInfo.HouseAddress || '').match(/\b([1-9][0-9]{5})\b/);

          if (mPin) resolvedPincode = mPin[1];

        }

        studentInfo.Pincode = resolvedPincode || '';



        // Resolve CollegeCode (with fallback extraction from RegisterNumber & CollegeName)

        let resolvedCollegeCode = String(studentInfo.CollegeCode || studentInfo['College Code'] || studentInfo.collegeCode || '').trim();

        if (!resolvedCollegeCode || resolvedCollegeCode === 'N/A' || resolvedCollegeCode.toUpperCase() === 'NULL' || resolvedCollegeCode === '000') {

          const regNo = String(studentInfo.RegisterNumber || studentInfo.CollegeRegisterNo || studentInfo.UniversityRegisterNumber || '').trim();

          const regMatch = regNo.match(/^(\d{4})\d{8}$/);

          if (regMatch) {

            resolvedCollegeCode = regMatch[1];

          }

        }

        if (!resolvedCollegeCode || resolvedCollegeCode === 'N/A' || resolvedCollegeCode.toUpperCase() === 'NULL' || resolvedCollegeCode === '000') {

          const cName = String(studentInfo.CollegeName || studentInfo.College || '').toLowerCase().replace(/[^a-z0-9]/g, '');

          if (cName.includes('velammalengineering')) resolvedCollegeCode = '1132';

          else if (cName.includes('velammalinstitute')) resolvedCollegeCode = '1133';

          else if (cName.includes('rmkengineering')) resolvedCollegeCode = '1113';

          else if (cName.includes('rmdengineering')) resolvedCollegeCode = '1114';

          else if (cName.includes('srivenkateswara')) resolvedCollegeCode = '2727';

          else if (cName.includes('stjoseph')) resolvedCollegeCode = '1317';

          else if (cName.includes('panimalar')) resolvedCollegeCode = '2114';

          else if (cName.includes('meenakshi')) resolvedCollegeCode = '1315';

          else if (cName.includes('rajalakshmi')) resolvedCollegeCode = '2116';

          else if (cName.includes('loyola') || cName.includes('licet')) resolvedCollegeCode = '1128';

          else if (cName.includes('easwari')) resolvedCollegeCode = '3106';

          else if (cName.includes('guindy') || cName.includes('ceg')) resolvedCollegeCode = '1001';

          else if (cName.includes('madrasinstitute') || cName.includes('mit')) resolvedCollegeCode = '1002';

          else if (cName.includes('saveetha')) resolvedCollegeCode = '2122';

          else if (cName.includes('prathyusha')) resolvedCollegeCode = '1115';

        }

        studentInfo.CollegeCode = resolvedCollegeCode || '';



        // Clean Remarks (remove literal 'NULL')

        let cleanRemarks = String(studentInfo.Remarks || '').trim();

        if (cleanRemarks.toUpperCase() === 'NULL' || cleanRemarks.toUpperCase() === 'UNDEFINED') cleanRemarks = '';

        studentInfo.Remarks = cleanRemarks;



        // Query Batch's SkillLearned from BATCHES sheet as highest priority

        let batchSkillLearned = '';

        if (studentInfo.Batch && String(studentInfo.Batch).trim() !== '' && String(studentInfo.Batch).toLowerCase() !== 'unassigned') {

          try {

            const batchSheet = getSheet(SHEET_NAMES.BATCHES);

            if (batchSheet) {

              const bData = getSheetDataAsObjects(batchSheet);

              const foundBatch = bData.find(b => String(b.BatchName || b.BatchID || '').trim().toLowerCase() === String(studentInfo.Batch).trim().toLowerCase());

              if (foundBatch) {

                batchSkillLearned = foundBatch.SkillLearned || foundBatch['Skill Learned'] || foundBatch.BatchTitle || foundBatch.Project || '';

              }

            }

            if (!batchSkillLearned) {

              batchSkillLearned = getCertificateContentForBatch(studentInfo.Batch) || '';

            }

          } catch (e) {

            Logger.log("Error querying batch skill learned: " + e.toString());

          }

        }



        studentInfo.SkillLearned = batchSkillLearned || studentInfo.SkillLearned || studentInfo.InterestedArea || studentInfo.Track || studentInfo.Skills || '';

        let resolvedPhoto = studentInfo.ProfilePhotoUrl || studentInfo.PhotoUrl || studentInfo.Photo || studentInfo.photoUrl || 

                            studentInfo.profilePhotoUrl || studentInfo.Photo_Url || studentInfo.ProfilePhoto || studentInfo.StudentPhoto || 

                            studentInfo.PhotoFileId || studentInfo.photo || studentInfo.croppedPhotoUrl || studentInfo.CroppedPhoto || 

                            studentInfo['Profile Photo'] || studentInfo['Passport Photo'] || studentInfo['Profile Photo URL'] || 

                            studentInfo['Photo URL'] || studentInfo['Student Photo'] || '';

        

        if (!resolvedPhoto) {

          for (const k in studentInfo) {

            if (/photo|passport/i.test(k) && studentInfo[k] && String(studentInfo[k]).trim() !== '') {

              resolvedPhoto = String(studentInfo[k]).trim();

              break;

            }

          }

        }



        if (!resolvedPhoto) {

          try {

            const fullResp = getStudentFullData(registrationId);

            if (fullResp && fullResp.status === 'success' && fullResp.studentData) {

              const fs = fullResp.studentData;

              resolvedPhoto = fs.ProfilePhotoUrl || fs.PhotoUrl || fs.Photo || fs.photoUrl || fs.profilePhotoUrl || 

                              fs.PassportPhoto || fs['Profile Photo'] || fs['Passport Photo'] || fs['Profile Photo URL'] || 

                              fs['Photo URL'] || fs['Student Photo'] || fs.photo || '';

              if (!resolvedPhoto) {

                for (const fk in fs) {

                  if (/photo|passport/i.test(fk) && fs[fk] && String(fs[fk]).trim() !== '') {

                    resolvedPhoto = String(fs[fk]).trim();

                    break;

                  }

                }

              }

            }

          } catch (ePhoto) {

            Logger.log("Error falling back to getStudentFullData for photo: " + ePhoto);

          }

        }



        if (!resolvedPhoto) {

          try {

            const reqSheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

            if (reqSheet) {

              const reqData = getSheetDataAsObjects(reqSheet) || [];

              const pReq = reqData.reverse().find(r => {

                const rReg = String(r.RegistrationID || r.StudentRegistrationID || '').trim().toUpperCase();

                const rType = String(r.RequestType || r.Type || '').toLowerCase();

                const rStat = String(r.Status || '').toLowerCase();

                return rReg === targetId && (rType.includes('photo') || rType.includes('picture')) && rStat === 'approved' && (r.AttachmentUrl || r.PhotoUrl);

              });

              if (pReq) {

                resolvedPhoto = String(pReq.AttachmentUrl || pReq.PhotoUrl).trim();

              }

            }

          } catch(eReq) {

            Logger.log("Error querying STUDENT_REQUESTS for doc photo: " + eReq);

          }

        }

        studentInfo.ProfilePhotoUrl = resolvedPhoto;

        studentInfo.Gender = studentInfo.Gender || studentInfo.gender || '';

        studentInfo.CollegeName = formatCollegeNameWithSpaces_(studentInfo.CollegeName || studentInfo.College || '');

        studentInfo.CompanyName = (typeof COMPANY_NAME !== 'undefined' && COMPANY_NAME) ? COMPANY_NAME : 'GSV Electrical Enterprises';

        studentInfo.TodayDate = formatDateDMY(new Date());

        studentInfo.FormattedStartDate = formatDateDMY(studentInfo.InternshipStartDate || studentInfo.StartDate);

        studentInfo.FormattedEndDate = formatDateDMY(studentInfo.InternshipEndDate || studentInfo.EndDate);

        studentInfo.FormattedDOB = formatDateDMY(studentInfo.DateofBirth || studentInfo.DOB || studentInfo.DateOfBirth);



        // Auto-heal start and end dates if start > end (e.g. Start 01/12/2026 and End 15/11/2026)

        try {

          const parseD = (s) => {

            if (!s) return null;

            const p = String(s).trim().split(/[\/\-]/);

            if (p.length === 3) return new Date(parseInt(p[2], 10), parseInt(p[1], 10) - 1, parseInt(p[0], 10));

            return null;

          };

          const pS = parseD(studentInfo.FormattedStartDate);

          const pE = parseD(studentInfo.FormattedEndDate);

          if (pS && pE && pS > pE) {

            const dur = parseInt(studentInfo.DurationDays || 30, 10) || 30;

            const testS = new Date(pS);

            testS.setMonth(pE.getMonth());

            testS.setFullYear(pE.getFullYear());

            if (testS <= pE) {

              studentInfo.FormattedStartDate = formatDateDMY(testS);

            } else {

              const testE = new Date(pS.getFullYear(), pS.getMonth(), pS.getDate() + dur - 1);

              studentInfo.FormattedEndDate = formatDateDMY(testE);

            }

          }

        } catch(eDate) {}



        // Persist resolved Pincode and CollegeCode back to Registrations sheet if they were empty

        try {

          if (regSheet && normalizedHeaderMap) {

            const pinIdx = normalizedHeaderMap['pincode'];

            const cCodeIdx = normalizedHeaderMap['collegecode'];

            if (pinIdx !== undefined && (!studentRow[pinIdx] || String(studentRow[pinIdx]).trim() === '') && studentInfo.Pincode) {

              regSheet.getRange(i + 1, pinIdx + 1).setValue(studentInfo.Pincode);

            }

            if (cCodeIdx !== undefined && (!studentRow[cCodeIdx] || String(studentRow[cCodeIdx]).trim() === '') && studentInfo.CollegeCode) {

              regSheet.getRange(i + 1, cCodeIdx + 1).setValue(studentInfo.CollegeCode);

            }

          }

        } catch(ePersist) {}



        return studentInfo;

      }

    }

  }



  // Fallback Mock Records if candidate not present in live sheets
