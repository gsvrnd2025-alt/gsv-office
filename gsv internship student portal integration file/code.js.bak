          body.replaceText('(?i)Faculty\\s+Member\\s+of\\s*(?:Year|year)?,?\\s*of\\s*', 'Faculty Member of ');
          body.replaceText('(?i)the\\s+Faculty\\s+of\\s*(?:Year|year)?,?\\s*of\\s*', 'Faculty Member of ');
          body.replaceText('(?i)\\bof\\s*(?:\\d{4})?\\s*(?:Year|year)?,?\\s*of\\s*', 'of ');
          body.replaceText('(?i)\\bof\\s*(?:\\d{4})?\\s*(?:Year|year)\\b', '');
          body.replaceText('(?i)pursuing\\s+Student\\s+of', 'Faculty Member of ');
          body.replaceText('(?i)pursuing\\s+student\\s+of', 'Faculty Member of ');
          body.replaceText('pursuing\\s+Student', 'Faculty Member');
          body.replaceText('pursuing\\s+student', 'Faculty Member');
          body.replaceText('(?i)\\ba\\s+Faculty\\s+Member\\b', 'Faculty Member');
          body.replaceText('(?:Register\\s*Number(?:\\s*:)?|Register\\s*Number)\\s*', 'Staff ID : ');
          body.replaceText('REGISTER\\s*NUMBER\\s*:', 'STAFF ID : ');
          body.replaceText(',\\s*Faculty\\s+Member', ', Faculty Member');
          body.replaceText('Self-Declaration\\s+Letter\\s+duly\\s+signed\\s+by\\s+(?:your\\s+)?Parent/Guardian', 'Self-Declaration Letter duly signed by the Faculty Member');
          body.replaceText('Self-Declaration\\s+Letter\\s+duly\\s+signed\\s+by\\s+Parent/Guardian', 'Self-Declaration Letter duly signed by the Faculty Member');
        } else if (candCat === 'Employee') {
          body.replaceText('Internship\\s+Confirmation\\s+Letter', 'Professional Training Joining Order');
          body.replaceText('INTERNSHIP\\s+CONFIRMATION\\s+LETTER', 'PROFESSIONAL TRAINING JOINING ORDER');
          body.replaceText('Internship\\s+Joining\\s+Letter', 'Professional Training Joining Order');
          body.replaceText('INTERNSHIP\\s+JOINING\\s+LETTER', 'PROFESSIONAL TRAINING JOINING ORDER');
          body.replaceText('confirming your joining as a student intern', 'confirming your official joining for the Corporate Professional Internship & Upskilling Program');
          body.replaceText('as a student intern', 'as a Corporate Professional Participant');
          body.replaceText('Student Intern', 'Corporate Professional Participant');

          // Match full sentence candidate segment for Employee
          body.replaceText('(?i),?\\s*(?:a\\s+)?(?:the\\s+)?(?:Corporate\\s+Professional|Employee)\\s+of\\s*(?:\\d{4})?\\s*(?:Year|year)?,?\\s*of\\s*', ', Corporate Professional of ');
          body.replaceText('(?i)(?:a\\s+)?(?:pursuing\\s+)?[Ss]tudent\\s+of(?:\\s*\\{\\{\\s*[Yy]ear\\s*\\}\\})?(?:\\s*\\d+(?:st|nd|rd|th)?)?\\s*(?:Year|year)?,?\\s*of\\s*', 'Corporate Professional of ');
          body.replaceText('(?i)(?:a\\s+)?pursuing\\s+Student\\s+of\\s*(?:Year|year)?,?\\s*of\\s*', 'Corporate Professional of ');
          body.replaceText('(?i)(?:the\\s+)?Corporate\\s+Professional\\s+of\\s*(?:Year|year)?,?\\s*of\\s*', 'Corporate Professional of ');
          body.replaceText('(?i)(?:the\\s+)?Employee\\s+of\\s*(?:Year|year)?,?\\s*of\\s*', 'Corporate Professional of ');
          body.replaceText('(?i)\\bof\\s*(?:\\d{4})?\\s*(?:Year|year)?,?\\s*of\\s*', 'of ');
          body.replaceText('(?i)\\bof\\s*(?:\\d{4})?\\s*(?:Year|year)\\b', '');
          body.replaceText('(?i)pursuing\\s+Student\\s+of', 'Corporate Professional of ');
          body.replaceText('(?i)pursuing\\s+student\\s+of', 'Corporate Professional of ');
          body.replaceText('pursuing\\s+Student', 'Corporate Professional');
          body.replaceText('pursuing\\s+student', 'Corporate Professional');
          body.replaceText('(?i)\\ba\\s+Corporate\\s+Professional\\b', 'Corporate Professional');
          body.replaceText('(?:Register\\s*Number(?:\\s*:)?|Register\\s*Number)\\s*', 'Employee ID : ');
          body.replaceText('REGISTER\\s*NUMBER\\s*:', 'EMPLOYEE ID : ');
          body.replaceText('Staff\\s*ID\\s*:', 'Employee ID : ');
          body.replaceText('STAFF\\s*ID\\s*:', 'EMPLOYEE ID : ');
          body.replaceText(',\\s*Corporate\\s+Professional', ', Corporate Professional');
          body.replaceText('Self-Declaration\\s+Letter\\s+duly\\s+signed\\s+by\\s+(?:your\\s+)?Parent/Guardian', 'Self-Declaration Letter duly signed by the Corporate Professional');
          body.replaceText('Self-Declaration\\s+Letter\\s+duly\\s+signed\\s+by\\s+Parent/Guardian', 'Self-Declaration Letter duly signed by the Corporate Professional');
        } else if (candCat === 'Apprentice') {
          body.replaceText('Internship\\s+Confirmation\\s+Letter', 'Apprentice Joining Order & Induction Schedule');
          body.replaceText('INTERNSHIP\\s+CONFIRMATION\\s+LETTER', 'APPRENTICE JOINING ORDER & INDUCTION SCHEDULE');
          body.replaceText('Internship\\s+Joining\\s+Letter', 'Apprentice Joining Order & Induction Schedule');
          body.replaceText('INTERNSHIP\\s+JOINING\\s+LETTER', 'APPRENTICE JOINING ORDER & INDUCTION SCHEDULE');
          body.replaceText('confirming your joining as a student intern', 'confirming your induction and joining for the Industrial Apprenticeship Training Program');
          body.replaceText('as a student intern', 'as an Apprentice Trainee');
          body.replaceText('Student Intern', 'Apprentice Trainee');
          body.replaceText('(?i)(?:a\\s+)?(?:pursuing\\s+)?[Ss]tudent\\s+of(?:\\s*\\{\\{\\s*[Yy]ear\\s*\\}\\})?(?:\\s*\\d+(?:st|nd|rd|th)?)?\\s*(?:Year|year)?,?\\s*of\\s*', 'the Apprentice Trainee of ');
          body.replaceText('a\\s+pursuing\\s+Student\\s+of\\s*(?:year)?', 'the Apprentice Trainee of');
          body.replaceText('a\\s+student\\s+of\\s*(?:year)?', 'the Apprentice Trainee of');
          body.replaceText('pursuing\\s+Student\\s+of', 'Apprentice Trainee of');
          body.replaceText('pursuing\\s+student\\s+of', 'Apprentice Trainee of');
          body.replaceText('pursuing\\s+Student', 'Apprentice Trainee');
          body.replaceText('pursuing\\s+student', 'Apprentice Trainee');
          body.replaceText('Pursuing\\s+Student', 'Apprentice Trainee');
          body.replaceText('Register\\s*Number\\s*:', 'Apprentice ID : ');
          body.replaceText('REGISTER\\s*NUMBER\\s*:', 'APPRENTICE ID : ');
        } else {
          body.replaceText('Internship\\s+Confirmation\\s+Letter', 'Internship Joining Letter');
          body.replaceText('INTERNSHIP\\s+CONFIRMATION\\s+LETTER', 'INTERNSHIP JOINING LETTER');
        }
      } catch(e) {}
    } else if (isCertificateDoc) {
      try {
        if (candCat === 'Faculty') {
          body.replaceText('Register\\s*Number\\s*:', 'Staff ID : ');
          body.replaceText('REGISTER\\s*NUMBER\\s*:', 'EMPLOYEE ID : ');
          body.replaceText('Register\\s*No\\s*:', 'Staff ID : ');
          body.replaceText('a\\s+pursuing\\s+Student\\s+of\\s*(?:\\{\\{\\s*YEAR\\s*\\}\\}|[1-4](?:st|nd|rd|th)?\\s*(?:Year)?)?\\s*(?:year)?', 'the Faculty of');
          body.replaceText('a\\s+pursuing\\s+Student\\s+of\\s*(?:year)?', 'the Faculty of');
          body.replaceText('a\\s+student\\s+of\\s*(?:year)?', 'the Faculty of');
          body.replaceText('the\\s+Faculty\\s+of\\s+year\\b', 'the Faculty of');
          body.replaceText('Employee\\s*ID\\s*:\\s*', 'Staff ID : ');
          body.replaceText('Internship\\s+Training', 'Faculty Internship Training');
          body.replaceText('INTERNSHIP\\s+TRAINING', 'FACULTY INTERNSHIP TRAINING');
          body.replaceText('student\\s+intern', 'faculty participant');
          body.replaceText('Student\\s+Intern', 'Faculty Participant');
        } else if (candCat === 'Employee') {
          body.replaceText('Register\\s*Number\\s*:', 'Employee ID :');
          body.replaceText('REGISTER\\s*NUMBER\\s*:', 'EMPLOYEE ID :');
          body.replaceText('a\\s+pursuing\\s+Student\\s+of\\s*(?:\\{\\{\\s*YEAR\\s*\\}\\}|[1-4](?:st|nd|rd|th)?\\s*(?:Year)?)?', 'the Employee of');
          body.replaceText('a\\s+pursuing\\s+Student\\s+of', 'the Employee of');
          body.replaceText('a\\s+student\\s+of', 'the Employee of');
          body.replaceText('Internship\\s+Training', 'Professional Training');
          body.replaceText('INTERNSHIP\\s+TRAINING', 'PROFESSIONAL TRAINING');
          body.replaceText('student\\s+intern', 'corporate participant');
          body.replaceText('Student\\s+Intern', 'Corporate Participant');
        } else if (candCat === 'Apprentice') {
          body.replaceText('a\\s+pursuing\\s+Student\\s+of\\s*(?:\\{\\{\\s*YEAR\\s*\\}\\}|[1-4](?:st|nd|rd|th)?\\s*(?:Year)?)?', 'the Apprentice Trainee of');
          body.replaceText('a\\s+pursuing\\s+Student\\s+of', 'the Apprentice Trainee of');
          body.replaceText('a\\s+student\\s+of', 'the Apprentice Trainee of');
          body.replaceText('Internship\\s+Training', 'Industrial Apprenticeship Training');
          body.replaceText('INTERNSHIP\\s+TRAINING', 'INDUSTRIAL APPRENTICESHIP TRAINING');
          body.replaceText('student\\s+intern', 'apprentice trainee');
          body.replaceText('Student\\s+Intern', 'Apprentice Trainee');
        }
      } catch(e) {}
    } else if (docType === 'applicationForm') {
      try {
        const appTitle = (candCat === 'Faculty') ? 'FACULTY INTERNSHIP APPLICATION' : ((candCat === 'Employee') ? 'EMPLOYEE INTERNSHIP APPLICATION' : ((candCat === 'Apprentice') ? 'APPRENTICE INTERNSHIP APPLICATION' : 'STUDENT INTERNSHIP APPLICATION'));
        const form1TblTitle = (candCat === 'Faculty') ? 'FACULTY INTERNSHIP APPLICATION DETAILS' : ((candCat === 'Employee') ? 'EMPLOYEE INTERNSHIP APPLICATION DETAILS' : ((candCat === 'Apprentice') ? 'APPRENTICE INTERNSHIP APPLICATION DETAILS' : 'STUDENT APPLICATION DETAILS'));
        if (candCat !== 'Student') {
          body.replaceText('STUDENT INTERNSHIP APPLICATION', appTitle);
          body.replaceText('STUDENT\\s+INTERNSHIP\\s+APPLICATION', appTitle);
          body.replaceText('Student Internship Application', appTitle);
          body.replaceText('Student\\s+Internship\\s+Application', appTitle);
          body.replaceText('STUDENT APPLICATION FORM', appTitle);
          body.replaceText('STUDENT\\s+APPLICATION\\s+FORM', appTitle);
          body.replaceText('STUDENT APPLICATION DETAILS', form1TblTitle);
          body.replaceText('STUDENT\\s+APPLICATION\\s+DETAILS', form1TblTitle);
          body.replaceText('STUDENT INFORMATION', '');
          body.replaceText('STUDENT\\s+INFORMATION', '');
        }
      } catch(e) {}
    }



    // ══════════════════════════════════════════════════════════════════════

    // PURGE SAMPLE SIGNATURE, SEAL & QR POSITIONED IMAGES IN CERTIFICATE

    // In Template 2, sample signature (para 4), sample seal (para 5),

    // and sample QR (para 8) are positioned images attached to body paragraphs.

    // ══════════════════════════════════════════════════════════════════════

    if (docType === 'internshipCertificate' || docType === 'completionCertificate' || docType === 'certificate') {

      try {

        const allParas = body.getParagraphs();

        for (let pi = 0; pi < allParas.length; pi++) {

          const p = allParas[pi];

          try {

            const pImgs = p.getPositionedImages();

            for (let pj = pImgs.length - 1; pj >= 0; pj--) {

              const pId = pImgs[pj].getId();

              Logger.log("Purging sample positioned image " + pId + " from para " + pi);

              try { p.removePositionedImage(pId); } catch(remErr) { Logger.log("remErr: " + remErr); }

            }

          } catch(e) {

            Logger.log("Error getting positioned images for para " + pi + ": " + e);

          }

          

          // Also remove any residual inline images in the signature paragraph

          const pText = p.getText() || '';

          if (/Authorized\s*Signatory|Signature|Seal|Sign/i.test(pText)) {

            for (let ii = p.getNumChildren() - 1; ii >= 0; ii--) {

              try {

                const c = p.getChild(ii);

                if (c.getType() === DocumentApp.ElementType.INLINE_IMAGE) {

                  c.removeFromParent();

                }

              } catch(e) {}

            }

          }

        }

      } catch(e) {

        Logger.log("Error purging sample positioned images: " + e);

      }

    }



    // === STRIP ANY DARK BACKGROUND HIGHLIGHTS / COLORS (CRITICAL FOR TEMPLATE 2) ===

    cleanDocFormattingRecursively_(body);



// Application form pagination moved to end of assembly



    // Form-3 Student Internship Attendance Sheet Population (Day-by-Day Table & Summary Table)

    if (docType === 'applicationForm') {

      try {

        body.setMarginTop(28);

        body.setMarginBottom(28);

        body.setMarginLeft(56.75);

        body.setMarginRight(56.75);

      } catch(mErr) {}

      try {

        populateForm3AttendanceSheet_(body, studentData, registrationId, placeholderValues);

      } catch (f3Err) {

        Logger.log("Error in populateForm3AttendanceSheet_: " + f3Err);

      }

    }



    // ══════════════════════════════════════════════════════════════════════

    // DYNAMIC 1D CODE 128 BARCODE (STRICTLY ENCODES REGISTRATION ID)

    // ══════════════════════════════════════════════════════════════════════

    let barcodeBlob = null;

    if (docType === 'applicationForm') {

      try {

        const cleanRegId = String(registrationId).trim();

        const barcodeUrls = [

          `https://quickchart.io/barcode?type=code128&text=${encodeURIComponent(cleanRegId)}&includeText=false&height=40&width=300`,

          `https://bwipjs-api.metafloor.com/?bcid=code128&text=${encodeURIComponent(cleanRegId)}&scale=3&height=12&includetext=false`,

          `https://barcode.tec-it.com/barcode.ashx?data=${encodeURIComponent(cleanRegId)}&code=Code128&translate-esc=on&unit=Fit&dpi=150`

        ];

        for (let bUrl of barcodeUrls) {

          try {

            const resp = UrlFetchApp.fetch(bUrl, { muteHttpExceptions: true });

            if (resp.getResponseCode() === 200) {

              barcodeBlob = resp.getBlob().setName('barcode.png');

              break;

            }

          } catch (bErr) {}

        }

      } catch (e) {

        Logger.log("Error fetching Barcode: " + e.toString());

      }

    }



    // ══════════════════════════════════════════════════════════════════════

    // DYNAMIC QR CODE (FOR APPLICATION FORM & COMPLETION CERTIFICATES ONLY)

    // ══════════════════════════════════════════════════════════════════════

    let qrBlob = null;

    if (docType === 'applicationForm' || isCertificateDoc) {

      try {

        const qrTargetText = (docType === 'applicationForm')
          ? String(registrationId).trim()
          : ("https://www.gsvee.in/gsv-internship-portal?verify=" + encodeURIComponent(registrationId));

        const qrEndpoints = [

          "https://quickchart.io/qr?size=300&margin=1&text=" + encodeURIComponent(qrTargetText),

          "https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=" + encodeURIComponent(qrTargetText)

        ];

        for (let ep of qrEndpoints) {

          try {

            const resp = UrlFetchApp.fetch(ep, { muteHttpExceptions: true });

            if (resp.getResponseCode() === 200) {

              qrBlob = resp.getBlob();

              break;

            }

          } catch(err) {

            Logger.log("QR fetch attempt failed for " + ep + ": " + err);

          }

        }

      } catch (e) {

        Logger.log("Error fetching QR Code: " + e.toString());

      }

    }



    // DOCUMENT-SPECIFIC ASSET REPLACEMENT & STRICT LAYOUT INTEGRITY

    const includePhysicalSealSig = (options && options.includePhysicalSealSig !== undefined) ? (options.includePhysicalSealSig === true || options.includePhysicalSealSig === 'true') : false;

    const includePhysicalSeal = (options && options.includePhysicalSeal !== undefined) 

      ? (options.includePhysicalSeal === true || options.includePhysicalSeal === 'true') 

      : ((options && options.seal === 'with_seal') ? true : ((options && options.seal === 'no_seal') ? false : ((options && options.includeSeal !== undefined) ? (options.includeSeal === true || options.includeSeal === 'true') : includePhysicalSealSig)));

    const includePhysicalSig = (options && options.includePhysicalSig !== undefined) 

      ? (options.includePhysicalSig === true || options.includePhysicalSig === 'true') 

      : ((options && options.signature === 'physical') ? true : ((options && (options.signature === 'none' || options.signature === 'digital')) ? false : ((options && options.includePhysicalSignature !== undefined) ? (options.includePhysicalSignature === true || options.includePhysicalSignature === 'true') : includePhysicalSealSig)));

    const includeDigitalSign = (options && options.includeDigitalSign !== undefined) 

      ? (options.includeDigitalSign === true || options.includeDigitalSign === 'true') 

      : ((options && options.signature === 'none') ? false : true);

    const addVerificationWatermark = (options && options.addVerificationWatermark !== undefined) 

      ? (options.addVerificationWatermark === true || options.addVerificationWatermark === 'true') 

      : ((options && options.includeNote !== undefined) ? (options.includeNote === true || options.includeNote === 'true') : false);

    const includeVerificationQR = (options && options.includeVerificationQR !== undefined) 

      ? (options.includeVerificationQR === true || options.includeVerificationQR === 'true') 

      : true;



    if (docType === 'applicationForm') {

      formatApplicationFormHeaderCell_(body, registrationId, barcodeBlob, qrBlob, placeholderValues);

    } else if (isCertificateDoc) {

      // ══════════════════════════════════════════════════════════════════════

      // CLEAN UP ANY INLINE SAMPLE IMAGES IN BODY

      // Positioned images already removed via Docs API batchUpdate above.

      // Here we only clean any residual InlineImages (e.g. in table cells).

      // ══════════════════════════════════════════════════════════════════════

      try {

        // Remove all InlineImages from EVERY element in body

        const numChildren = body.getNumChildren();

        for (let ci = 0; ci < numChildren; ci++) {

          const child = body.getChild(ci);

          const childType = child.getType();

          if (childType === DocumentApp.ElementType.TABLE) {

            // Recurse into table rows & cells

            try {

              const tbl = child.asTable();

              for (let ri = 0; ri < tbl.getNumRows(); ri++) {

                const row = tbl.getRow(ri);

                for (let ki = 0; ki < row.getNumCells(); ki++) {

                  const cell = row.getCell(ki);

                  for (let pi2 = 0; pi2 < cell.getNumChildren(); pi2++) {

                    try {

                      const cellChild = cell.getChild(pi2);

                      if (cellChild.getType() === DocumentApp.ElementType.PARAGRAPH) {

                        const cellPara = cellChild.asParagraph();

                        for (let ii = cellPara.getNumChildren() - 1; ii >= 0; ii--) {

                          try {

                            const inlineEl = cellPara.getChild(ii);

                            if (inlineEl.getType() === DocumentApp.ElementType.INLINE_IMAGE) {

                              inlineEl.removeFromParent();

                            }

                          } catch(e) {}

                        }

                      }

                    } catch(e) {}

                  }

                }

              }

            } catch(e) {}

          } else if (childType === DocumentApp.ElementType.PARAGRAPH) {

            const para = child.asParagraph();

            for (let ii = para.getNumChildren() - 1; ii >= 0; ii--) {

              try {

                const inlineChild = para.getChild(ii);

                if (inlineChild.getType() === DocumentApp.ElementType.INLINE_IMAGE) {

                  inlineChild.removeFromParent();

                }

              } catch(e) {}

            }

          }

        }

      } catch(imgCleanErr) {

        Logger.log("Error cleaning inline sample images: " + imgCleanErr);

      }



      // Handle Certificate Footer (3-Column Layout: Left Signature/Digital, Center Seal, Right QR)

      const hasAuthSignatory = (body.findText('Authorized Signatory') !== null);

      if (hasAuthSignatory && isCertificateDoc) {

        const hasPhysicalSig = includePhysicalSig;

        const hasPhysicalSeal = includePhysicalSeal;



        const sigBlob = hasPhysicalSig ? getCompanySignatureBlob_() : null;

        const sealBlob = hasPhysicalSeal ? getCompanySealBlob_() : null;

        const adminNameVal = (options && options.adminName) || 'Vijay Varman.S';

        formatCertificateT2Footer_(

          body,

          includeDigitalSign,

          adminNameVal,

          issuedDateFormatted,

          includeVerificationQR ? qrBlob : null,

          sigBlob,

          sealBlob,

          registrationId,

          options

        );

      } else {

        // Fallback for templates with inline tags

        if (includeVerificationQR && qrBlob) {

          const qrTags = ['QR_CODE', 'QRCode', 'QRCODE', 'qrcode', 'qr_code', 'SCAN_VERIFY', 'ScanVerify', 'SCAN_QR', 'ScanQR'];

          qrTags.forEach(tag => {

            replacePlaceholderWithInlineImage_(body, tag, qrBlob, 65, 65);

          });

        } else {

          const qrTags = ['QR_CODE', 'QRCode', 'QRCODE', 'qrcode', 'qr_code', 'SCAN_VERIFY', 'ScanVerify', 'SCAN_QR', 'ScanQR'];

          qrTags.forEach(tag => {

            replacePlaceholderWithInlineImage_(body, tag, null, 0, 0);

          });

        }



        if (includePhysicalSeal || includePhysicalSig) {

          const sigBlob = includePhysicalSig ? getCompanySignatureBlob_() : null;

          const sealBlob = includePhysicalSeal ? getCompanySealBlob_() : null;

          const sigTags = ['SIGNATURE', 'Signature', 'signature', 'AuthorizedSignatory', 'AUTHORIZED_SIGNATORY', 'SIGN', 'Sign', 'sign'];

          sigTags.forEach(tag => {

            replacePlaceholderWithInlineImage_(body, tag, sigBlob, 110, 48);

          });

          const sealTags = ['SEAL', 'Seal', 'seal', 'CompanySeal', 'COMPANY_SEAL', 'STAMP', 'Stamp', 'stamp'];

          if (docType === 'applicationForm') {
            // Corner seal is already permanently stamped on photo canvas, eliminate duplicate lower seal
            sealTags.forEach(tag => {
              replacePlaceholderWithInlineImage_(body, tag, null, 0, 0);
            });
          } else {
            sealTags.forEach(tag => {
              replacePlaceholderWithInlineImage_(body, tag, sealBlob, 72, 72);
            });
          }

        } else if (includeDigitalSign) {

          const adminNameVal = (options && options.adminName) || 'Vijay Varman.S';

          const adminSignText = `Digitally Signed and Generated on the Portal of GSV Electrical Enterprises (Internship Portal)\n(Admin: ${adminNameVal})\non ${issuedDateFormatted}`;

          try {

            body.replaceText('\\{\\{\\s*SIGNATURE\\s*\\}\\}', adminSignText);

            body.replaceText('\\{\\s*SIGNATURE\\s*\\}', adminSignText);

            body.replaceText('\\{\\{\\s*Signature\\s*\\}\\}', adminSignText);

            body.replaceText('\\{\\s*Signature\\s*\\}', adminSignText);

          } catch(e) {}

          const sealTags = ['SEAL', 'Seal', 'seal', 'CompanySeal', 'COMPANY_SEAL', 'STAMP', 'Stamp', 'stamp'];

          sealTags.forEach(tag => {

            replacePlaceholderWithInlineImage_(body, tag, null, 0, 0);

          });

        } else {

          try {

            body.replaceText('\\{\\{\\s*SIGNATURE\\s*\\}\\}', '');

            body.replaceText('\\{\\s*SIGNATURE\\s*\\}', '');

            body.replaceText('\\{\\{\\s*Signature\\s*\\}\\}', '');

            body.replaceText('\\{\\s*Signature\\s*\\}', '');

          } catch(e) {}

          const sealTags = ['SEAL', 'Seal', 'seal', 'CompanySeal', 'COMPANY_SEAL', 'STAMP', 'Stamp', 'stamp'];

          sealTags.forEach(tag => {

            replacePlaceholderWithInlineImage_(body, tag, null, 0, 0);

          });

        }

      }



      // Handle Verification Copy Note / Watermark (Handled with exact geometry in formatCertificateT2Footer_ for all certificate documents)

      if (addVerificationWatermark && !isCertificateDoc) {

        const watermarkNote = "Note: This is a provisional soft copy issued for temporary / emergency verification purposes only. Physical hard copy verification is mandatory for official validity. In the absence of the verified physical hard copy, this soft copy document becomes invalid. Verify at: https://www.gsvee.in/gsv-internship-portal";

        const pNote = body.appendParagraph(watermarkNote);

        pNote.setFontFamily('Times New Roman');

        pNote.setFontSize(7.5);

        pNote.setItalic(true);

        pNote.setBold(true);

        pNote.setForegroundColor('#dc2626'); // VIBRANT RED WARNING COLOR

        pNote.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

        pNote.setSpacingBefore(3);

        pNote.setSpacingAfter(0);

        pNote.setLineSpacing(1.0);

      }



      replacePlaceholderWithInlineImage_(body, 'BARCODE', null, 0, 0);

    } else {

      // Offer Letter, Joining Letter, Diary, Attendance, etc. -> NO BARCODE, NO QR (Clean template alignment)

      replacePlaceholderWithInlineImage_(body, 'BARCODE', null, 0, 0);

      const qrTags = ['QR_CODE', 'QRCode', 'QRCODE', 'qrcode', 'qr_code', 'SCAN_VERIFY', 'ScanVerify', 'SCAN_QR', 'ScanQR'];

      qrTags.forEach(tag => {

        replacePlaceholderWithInlineImage_(body, tag, null, 0, 0);

      });

    }

    // ══════════════════════════════════════════════════════════════════════

    // STUDENT PHOTO PLACEHOLDER (APPLICATION FORM: 3x3 cm, CERTIFICATE T2: 3.0x3.5 cm)

    // ══════════════════════════════════════════════════════════════════════

    try {

      let includePhoto = false;

      if (docType === 'applicationForm') {

        if (options && options.includePhotoInAppForm !== undefined) {

          includePhoto = (options.includePhotoInAppForm === true || options.includePhotoInAppForm === 'true' || options.includePhotoInAppForm === 'ON');

        } else if (options && options.includePhoto !== undefined) {

          includePhoto = (options.includePhoto === true || options.includePhoto === 'true' || options.includePhoto === 'ON');

        } else {

          const rawPhotoCheck = studentData.ProfilePhotoUrl || studentData.PhotoUrl || studentData.Photo || studentData.photoUrl || studentData.profilePhotoUrl || '';

          includePhoto = rawPhotoCheck ? true : isSwitchOn('settingIncludePhotoInAppForm');

        }

      } else if (isCertificateDoc) {

        if (options && options.includePhotoInCertificate !== undefined) {

          includePhoto = (options.includePhotoInCertificate === true || options.includePhotoInCertificate === 'true' || options.includePhotoInCertificate === 'ON');

        } else if (options && options.includePhoto !== undefined) {

          includePhoto = (options.includePhoto === true || options.includePhoto === 'true' || options.includePhoto === 'ON');

        } else {

          includePhoto = isSwitchOn('settingIncludePhotoInCertificate');

        }

      } else {

        if (options && options.includePhoto !== undefined) {

          includePhoto = (options.includePhoto === true || options.includePhoto === 'true' || options.includePhoto === 'ON');

        }

      }



      let rawPhoto = studentData.ProfilePhotoUrl || studentData.PhotoUrl || studentData.Photo || studentData.photoUrl || studentData.profilePhotoUrl || studentData['Profile Photo'] || studentData['Passport Photo'] || '';

      if (!rawPhoto) {

        for (const k in studentData) {

          if (/photo|passport/i.test(k) && studentData[k] && String(studentData[k]).trim() !== '') {

            rawPhoto = String(studentData[k]).trim();

            break;

          }

        }

      }

      if (!rawPhoto) {

        try {

          const fullDataResp = getStudentFullData(registrationId);

          if (fullDataResp && fullDataResp.status === 'success' && fullDataResp.studentData) {

            const fs = fullDataResp.studentData;

            rawPhoto = fs.ProfilePhotoUrl || fs.PhotoUrl || fs.Photo || fs.photoUrl || fs.profilePhotoUrl || fs.PassportPhoto || fs['Profile Photo'] || fs['Passport Photo'] || '';

            if (!rawPhoto) {

              for (const fk in fs) {

                if (/photo|passport/i.test(fk) && fs[fk] && String(fs[fk]).trim() !== '') {

                  rawPhoto = String(fs[fk]).trim();

                  break;

                }

              }

            }

          }

        } catch(e) {}

      }

      if (!rawPhoto && options && (options.photoUrl || options.ProfilePhotoUrl || options.customPhotoUrl)) {

        rawPhoto = options.photoUrl || options.ProfilePhotoUrl || options.customPhotoUrl;

        includePhoto = true;

      }

      let photoBlob = null;

      if (rawPhoto) {

        try {

          photoBlob = getStudentPhotoBlob_(rawPhoto, { rawBlob: (docType === 'applicationForm') });

        } catch(photoLoadErr) {

          Logger.log('Error loading photoBlob from rawPhoto: ' + photoLoadErr);

        }

      }

      if (photoBlob) {

        includePhoto = true;

      }

      if (false) {

        photoBlob = getStudentPhotoBlob_(rawPhoto, { rawBlob: (docType === 'applicationForm') });

      }

      if (!photoBlob && (includePhoto || docType === 'applicationForm' || isCertificateDoc)) {
        try {
          const candCatPhoto = (typeof getCandidateCategory_ === 'function') ? getCandidateCategory_(studentData) : '';
          const fbB64 = (candCatPhoto === 'Faculty' || candCatPhoto === 'Employee') ? FACULTY_SAMPLE_PHOTO_B64 : STUDENT_SAMPLE_PHOTO_B64;
          if (fbB64) {
            photoBlob = Utilities.newBlob(Utilities.base64Decode(fbB64), 'image/jpeg', 'sample_photo.jpg');
            includePhoto = true;
          }
        } catch(fbErr) {
          Logger.log("Fallback photo load in generateDocumentAndMail error: " + fbErr);
        }
      }



      if (docType === 'applicationForm') {

        formatApplicationFormPhotoBox_(body, photoBlob, includePhoto);

      } else if (isCertificateDoc && isT2) {

        formatCertificateTemplate2Photo_(body, photoBlob, includePhoto, certNumber, issuedDateFormatted, studentData, options);

      } else if (isCertificateDoc && !isT2) {

        // Template 1: User requested exact as-is template formatting with Arial Black CN/Date (flush right),

        // uniform standard paragraph indent across all 3 paras, default seal and signature, and optional QR code.

        const hasPhysicalSig = (options && options.includeSignature !== undefined) 

          ? (options.includeSignature === true || options.includeSignature === 'true')

          : (options.includePhysicalSealSig !== undefined ? options.includePhysicalSealSig : true);

        const hasPhysicalSeal = (options && options.includeSeal !== undefined)

          ? (options.includeSeal === true || options.includeSeal === 'true')

          : (options.includePhysicalSealSig !== undefined ? options.includePhysicalSealSig : true);



        const sigBlobT1 = hasPhysicalSig ? getCompanySignatureBlob_() : null;

        const sealBlobT1 = hasPhysicalSeal ? getCompanySealBlob_() : null;

        const qrBlobT1 = (includeVerificationQR && qrBlob) ? qrBlob : null;



        formatCertificateTemplate1_(body, studentData, options, certNumber, issuedDateFormatted, sigBlobT1, sealBlobT1, qrBlobT1);

      } else {

        const photoTags = ['PHOTO', 'Photo', 'photo', 'StudentPhoto', 'studentphoto', 'PROFILE_PHOTO', 'ProfilePhoto', 'profile_photo', 'STUDENT_PHOTO', 'student_photo', 'PASSPORT_PHOTO', 'PassportPhoto'];

        photoTags.forEach(tag => {

          if (includePhoto && photoBlob) {

            replacePlaceholderWithInlineImage_(body, tag, photoBlob, 71, 85);

          } else {

            replacePlaceholderWithInlineImage_(body, tag, null, 0, 0);

          }

        });

      }

    } catch (e) {

      Logger.log("Error handling student photo placeholder: " + e.toString());

    }



    // ══════════════════════════════════════════════════════════════════════

    // COMPANY SEAL & AUTHORIZED SIGNATURE PLACEHOLDERS (FOR NON-CERTIFICATE DOCUMENTS)

    // ══════════════════════════════════════════════════════════════════════

    if (!isCertificateDoc) {

      try {

        const includeSeal = (options && options.includeSeal !== undefined) ? options.includeSeal : true;

        const includeSignature = (options && options.includeSignature !== undefined) ? options.includeSignature : true;



        // Handle Seal

        let sealBlob = null;

        if (includeSeal) {

          sealBlob = getCompanySealBlob_();

        }

        const sealTags = ['SEAL', 'Seal', 'seal', 'CompanySeal', 'COMPANY_SEAL', 'SEAL_SIGNATURE', 'Seal_Signature', 'Company_Seal', 'PHYSICAL_SEAL', 'PhysicalSeal', 'OFFICIAL_SEAL', 'OfficialSeal', 'STAMP', 'Stamp', 'stamp'];

        sealTags.forEach(tag => {
          if (docType === 'applicationForm') {
            // Application Form already has official corner seal on the photo; remove inline template tag to avoid duplicate lower seal
            replacePlaceholderWithInlineImage_(body, tag, null, 0, 0);
          } else {
            replacePlaceholderWithInlineImage_(body, tag, sealBlob, 78, 78);
          }
        });



        // Handle Signature

        let sigBlob = null;

        if (includeSignature) {

          sigBlob = getCompanySignatureBlob_();

        }

        const sigTags = ['SIGNATURE', 'Signature', 'signature', 'AuthorizedSignatory', 'AUTHORIZED_SIGNATORY', 'SIGN', 'Sign', 'sign', 'AuthSignature', 'AUTH_SIGNATURE', 'Signature_Seal', 'CHIEF_SIGNATURE', 'ChiefSignature', 'CHIEF_ENGINEER_SIGNATURE', 'ChiefEngineerSignature'];

        sigTags.forEach(tag => {

          replacePlaceholderWithInlineImage_(body, tag, sigBlob, 95, 48);

        });

      } catch (e) {

        Logger.log("Error handling seal and signature placeholders: " + e.toString());

      }

    }

    

    // ══════════════════════════════════════════════════════════════════════

    // REPLACE GENDER & TEXT PLACEHOLDERS ACROSS ALL SECTIONS (BODY, HEADER, FOOTER)

    // ══════════════════════════════════════════════════════════════════════

    const docSections = [body];
    try {
      const root = body.getParent();
      for (let i = 0; i < root.getNumChildren(); i++) {
        const child = root.getChild(i);
        const cType = child.getType();
        if (cType === DocumentApp.ElementType.HEADER_SECTION || cType === DocumentApp.ElementType.FOOTER_SECTION) {
          docSections.push(child);
        }
      }
    } catch(rErr) {
      try {
        const docHeader = doc.getHeader();
        if (docHeader) docSections.push(docHeader);
      } catch(hErr) {}
      try {
        const docFooter = doc.getFooter();
        if (docFooter) docSections.push(docFooter);
      } catch(fErr) {}
    }



    // DEDICATED BULLETPROOF APPLICATION FORM HEADER & TITLE REPLACEMENTS
    if (docType === 'applicationForm' && candCat !== 'Student') {
      const appTitle = (candCat === 'Faculty') ? 'FACULTY INTERNSHIP APPLICATION' : ((candCat === 'Employee') ? 'EMPLOYEE INTERNSHIP APPLICATION' : 'APPRENTICE INTERNSHIP APPLICATION');
      const form1TableTitle = (candCat === 'Faculty') ? 'FACULTY INTERNSHIP APPLICATION DETAILS' : ((candCat === 'Employee') ? 'EMPLOYEE INTERNSHIP APPLICATION DETAILS' : 'APPRENTICE INTERNSHIP APPLICATION DETAILS');
      const form2Title = (candCat === 'Faculty') ? 'FACULTY INTERNSHIP TRAINING DECLARATION LETTER' : ((candCat === 'Employee') ? 'CORPORATE EMPLOYEE TRAINING DECLARATION LETTER' : 'INDUSTRIAL APPRENTICESHIP DECLARATION LETTER');

      docSections.forEach(sec => {
        try { sec.replaceText('STUDENT INTERNSHIP APPLICATION', appTitle); } catch(e) {}
        try { sec.replaceText('STUDENT\\s+INTERNSHIP\\s+APPLICATION', appTitle); } catch(e) {}
        try { sec.replaceText('Student Internship Application', appTitle); } catch(e) {}
        try { sec.replaceText('Student\\s+Internship\\s+Application', appTitle); } catch(e) {}
        try { sec.replaceText('STUDENT APPLICATION FORM', appTitle); } catch(e) {}
        try { sec.replaceText('STUDENT\\s+APPLICATION\\s+FORM', appTitle); } catch(e) {}
        try { sec.replaceText('STUDENT APPLICATION DETAILS', form1TableTitle); } catch(e) {}
        try { sec.replaceText('STUDENT\\s+APPLICATION\\s+DETAILS', form1TableTitle); } catch(e) {}
        try { sec.replaceText('STUDENT INFORMATION', ''); } catch(e) {}
        try { sec.replaceText('STUDENT\\s+INFORMATION', ''); } catch(e) {}
        try { sec.replaceText('STUDENT & PARENT SELF DECLARATION', form2Title); } catch(e) {}
        try { sec.replaceText('STUDENT & PARENT SELF DECLARATION(?: LETTER)?', form2Title); } catch(e) {}
        try { sec.replaceText('Student & Parent Self Declaration Letter', form2Title);
              sec.replaceText('STUDENTS?\\s+INTERNSHIP\\s+ATTENDANCE\\s+SHEET', form3Title);
              sec.replaceText('Students?\\s+Internship\\s+Attendance\\s+Sheet', form3Title);
              sec.replaceText('STUDENT\\s+DETAILS', form3DetHeading);
              sec.replaceText('Student\\s+Details', form3DetHeading); } catch(e) {}
      });
    }

    docSections.forEach(sec => {

      // 1. Gender Pronoun Replacement

      try {

        let rawGender = (studentData.Gender || studentData.gender || studentData.GENDER ||

                         studentData.Sex || studentData.sex || studentData.SEX ||

                         studentData['Student Gender'] || studentData['Applicant Gender'] || '').toString().trim().toLowerCase();

        if (!rawGender && studentData.Salutation) {

          const sal = studentData.Salutation.toString().toLowerCase();

          if (sal.includes('ms') || sal.includes('mrs') || sal.includes('miss')) rawGender = 'female';

          else if (sal.includes('mr')) rawGender = 'male';

        }

        const isFemale = (rawGender === 'female' || rawGender === 'f' || rawGender === 'woman' || rawGender === 'girl');



        const subjLower = isFemale ? 'she' : 'he';

        const possLower = isFemale ? 'her' : 'his';

        const objLower = isFemale ? 'her' : 'him';



        // Replace bracketed placeholders FIRST (case-insensitive) so single-word replacement does not mangle tag brackets

        const genderTags = [

          { pat: '\\{\\{\\s*he/she\\s*\\}\\}', val: subjLower },

          { pat: '\\{\\s*he/she\\s*\\}', val: subjLower },

          { pat: '\\{\\{\\s*she/she\\s*\\}\\}', val: subjLower },

          { pat: '\\{\\{\\s*he\\s*/\\s*she\\s*\\}\\}', val: subjLower },

          { pat: '\\{\\{\\s*she/he\\s*\\}\\}', val: subjLower },

          { pat: '\\{\\{\\s*his/her\\s*\\}\\}', val: possLower },

          { pat: '\\{\\s*his/her\\s*\\}', val: possLower },

          { pat: '\\{\\{\\s*his\\s*/\\s*her\\s*\\}\\}', val: possLower },

          { pat: '\\{\\{\\s*her/his\\s*\\}\\}', val: possLower },

          { pat: '\\{\\{\\s*him/her\\s*\\}\\}', val: objLower },

          { pat: '\\{\\s*him/her\\s*\\}', val: objLower },

          { pat: '\\{\\{\\s*him\\s*/\\s*her\\s*\\}\\}', val: objLower },

          { pat: '\\{\\{\\s*her/him\\s*\\}\\}', val: objLower },

          { pat: '\\{\\{\\s*gender\\s*\\}\\}', val: isFemale ? 'Female' : 'Male' },

          { pat: '\\{\\s*gender\\s*\\}', val: isFemale ? 'Female' : 'Male' }

        ];

        genderTags.forEach(g => {

          try { sec.replaceText(g.pat, g.val); } catch(e) {}

        });



        // Natural text replacements for female students

        if (isFemale) {

          sec.replaceText('\\bhis\\s+Internship\\b', 'her Internship');

          sec.replaceText('\\bhis\\s+internship\\b', 'her internship');

          sec.replaceText('\\bhis\\s+training\\b', 'her training');

          sec.replaceText('\\bHis\\s+training\\b', 'Her training');

          sec.replaceText('\\bHis\\s+performance\\b', 'Her performance');

          sec.replaceText('\\bhis\\s+performance\\b', 'her performance');

          sec.replaceText('\\bperformance\\s+and\\s+conduct\\b', 'Her performance and conduct');

          sec.replaceText('\\bhis\\b', 'her');

          sec.replaceText('\\bHis\\b', 'Her');

          sec.replaceText('\\bhe\\b', 'she');

          sec.replaceText('\\bHe\\b', 'She');

          sec.replaceText('\\bhim\\b', 'her');

          sec.replaceText('\\bHim\\b', 'Her');

        } else {

          sec.replaceText('\\bperformance\\s+and\\s+conduct\\b', 'His performance and conduct');

          sec.replaceText('\\bHer\\s+training\\b', 'His training');

          sec.replaceText('\\bher\\s+training\\b', 'his training');

          sec.replaceText('\\bHer\\s+performance\\b', 'His performance');

          sec.replaceText('\\bher\\s+performance\\b', 'his performance');

        }

      } catch (e) {

        Logger.log("Gender pronoun replacement error: " + e.toString());

      }



      // 2. Safe Text Placeholder Replacements (Both {{Tag}} and {Tag})

      for (const placeholderName in placeholderValues) {

        const value = String(placeholderValues[placeholderName] !== undefined && placeholderValues[placeholderName] !== null ? placeholderValues[placeholderName] : '');

        const escapedName = placeholderName.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');

        const patternDouble = '\\{\\{\\s*' + escapedName + '\\s*\\}\\}';

        const patternSingle = '\\{\\s*' + escapedName + '\\s*\\}';

        try {

          sec.replaceText(patternDouble, value);

          sec.replaceText(patternSingle, value);

        } catch (e) {

          Logger.log('Error replacing placeholder ' + placeholderName + ': ' + e.toString());

        }

      }

    });



    // Ensure unreplaced {{Staff ID }} and grammar issues in Offer/Joining letters are resolved
    try {
      const resolvedStaffVal = (candCat === 'Faculty' ? (studentData.FacultyStaffId || studentData.StaffId || studentData.RegisterNumber || 'FAC-VIJAY-01') : (candCat === 'Employee' ? (studentData.EmployeeId || studentData.companyEmployeeId || studentData.StaffId || studentData.RegisterNumber || 'EMP-TS-8842') : (studentData.RegisterNumber || 'N/A')));
      docSections.forEach(sec => {
        try {
          sec.replaceText('\\{\\{\\s*(?:Staff\\s*ID|StaffId|Staff_ID|Faculty\\s*Staff\\s*ID|Employee\\s*ID|EmployeeId|Register\\s*Number|RegisterNumber)(?:\\s*:\\s*)?\\s*\\}\\}', resolvedStaffVal);
          sec.replaceText('\\{\\s*(?:Staff\\s*ID|StaffId|Staff_ID|Faculty\\s*Staff\\s*ID|Employee\\s*ID|EmployeeId|Register\\s*Number|RegisterNumber)(?:\\s*:\\s*)?\\s*\\}', resolvedStaffVal);
          
          // Salutation & Title Duplication Normalization (prevents 'Mr. Mr.', 'Mr./Ms. Dr.', etc.)
          sec.replaceText('(?:Mr\\.?/\\s*Ms\\.?\\s*)+Dr\\.', 'Dr.');
          sec.replaceText('(?:Mr\\.?/\\s*Ms\\.?\\s*)+Prof\\.', 'Prof.');
          sec.replaceText('(?:Mr\\.?/\\s*Ms\\.?\\s*)+Er\\.', 'Er.');
          sec.replaceText('(?:Mr\\.?/\\s*Ms\\.?\\s*)+Mr\\.', 'Mr.');
          sec.replaceText('(?:Mr\\.?/\\s*Ms\\.?\\s*)+Ms\\.', 'Ms.');
          sec.replaceText('Mr\\.\\s+Dr\\.', 'Dr.');
          sec.replaceText('Mr\\.\\s+Prof\\.', 'Prof.');
          sec.replaceText('Mr\\.\\s+Er\\.', 'Er.');
          sec.replaceText('Mr\\.\\s+Mr\\.', 'Mr.');
          sec.replaceText('Ms\\.\\s+Ms\\.', 'Ms.');
          sec.replaceText('Mr\\.\\s+Ms\\.', 'Ms.');
          sec.replaceText('Ms\\.\\s+Mr\\.', 'Mr.');

          if (candCat === 'Faculty' || (studentData.FullName && /^(?:dr\.|prof\.|er\.)/i.test(studentData.FullName))) {
            sec.replaceText('Mr\\.?/\\s*Ms\\.?\\s*', '');
          } else if (studentData.Gender && /female/i.test(studentData.Gender)) {
            sec.replaceText('Mr\\.?/\\s*Ms\\.?\\s*', 'Ms. ');
          } else {
            sec.replaceText('Mr\\.?/\\s*Ms\\.?\\s*', 'Mr. ');
          }

          // Clean duplicate titles again after salutation resolution
          sec.replaceText('Mr\\.\\s+Mr\\.', 'Mr.');
          sec.replaceText('Ms\\.\\s+Ms\\.', 'Ms.');

          if (candCat === 'Faculty') {
            sec.replaceText('Register\\s*Number\\s+(?=[A-Za-z0-9_-]+)', 'Staff ID : ');
            sec.replaceText('(?:Register\\s*Number(?:\\s*:)?|Register\\s*Number)\\s*', 'Staff ID : ');
            sec.replaceText('REGISTER\\s*NUMBER\\s*:', 'STAFF ID : ');

            // Clean up any remaining "of Year, of", "Faculty Member of Year, of", "a Faculty Member of Year, of", etc.
            sec.replaceText('(?i),?\\s*(?:a\\s+)?(?:the\\s+)?Faculty\\s+Member\\s+of\\s*(?:\\d{4})?\\s*(?:Year|year)?,?\\s*of\\s*', ', Faculty Member of ');
            sec.replaceText('(?i)(?:a\\s+)?(?:the\\s+)?Faculty\\s+Member\\s+of\\s*(?:\\d{4})?\\s*(?:Year|year)?,?\\s*of\\s*', 'Faculty Member of ');
            sec.replaceText('(?i),?\\s*(?:a\\s+)?(?:the\\s+)?Faculty\\s+of(?:\\s*Year)?,?\\s*of\\s*', ', Faculty Member of ');
            sec.replaceText('(?i)(?:a\\s+)?(?:the\\s+)?Faculty\\s+of\\s*(?:\\d{4})?\\s*(?:Year|year)?,?\\s*of\\s*', 'Faculty Member of ');
            sec.replaceText('(?i)(?:a\\s+)?Faculty\\s+Member\\b', 'Faculty Member');
            sec.replaceText('(?i)\\bof\\s*(?:\\d{4})?\\s*(?:Year|year)?,?\\s*of\\s*', 'of ');
            sec.replaceText('(?i)\\bof\\s*(?:\\d{4})?\\s*(?:Year|year)\\b', '');

            // Ensure proper comma spacing
            sec.replaceText(',Faculty', ', Faculty');
            sec.replaceText(',\\s*Faculty\\s+Member', ', Faculty Member');

            sec.replaceText('Self-Declaration\\s+Letter\\s+duly\\s+signed\\s+by\\s+(?:your\\s+)?Parent\\s*/\\s*Guardian', 'Self-Declaration Letter duly signed by the Faculty Member');
            sec.replaceText('duly\\s+signed\\s+by\\s+(?:your\\s+)?Parent\\s*/\\s*Guardian', 'duly signed by the Faculty Member');
          } else if (candCat === 'Employee') {
            sec.replaceText('Register\\s*Number\\s+(?=[A-Za-z0-9_-]+)', 'Employee ID : ');
            sec.replaceText('(?:Register\\s*Number(?:\\s*:)?|Register\\s*Number)\\s*', 'Employee ID : ');
            sec.replaceText('REGISTER\\s*NUMBER\\s*:', 'EMPLOYEE ID : ');
            sec.replaceText('Staff\\s*ID\\s*:', 'Employee ID : ');
            sec.replaceText('STAFF\\s*ID\\s*:', 'EMPLOYEE ID : ');

            // Clean up any remaining "of Year, of", "Corporate Professional of Year, of", etc.
            sec.replaceText('(?i),?\\s*(?:a\\s+)?(?:the\\s+)?(?:Corporate\\s+Professional|Employee)\\s+of\\s*(?:\\d{4})?\\s*(?:Year|year)?,?\\s*of\\s*', ', Corporate Professional of ');
            sec.replaceText('(?i)(?:a\\s+)?(?:the\\s+)?(?:Corporate\\s+Professional|Employee)\\s+of\\s*(?:\\d{4})?\\s*(?:Year|year)?,?\\s*of\\s*', 'Corporate Professional of ');
            sec.replaceText('(?i)(?:a\\s+)?Corporate\\s+Professional\\b', 'Corporate Professional');
            sec.replaceText('(?i)\\bof\\s*(?:\\d{4})?\\s*(?:Year|year)?,?\\s*of\\s*', 'of ');
            sec.replaceText('(?i)\\bof\\s*(?:\\d{4})?\\s*(?:Year|year)\\b', '');

            // Ensure proper comma spacing
            sec.replaceText(',Corporate', ', Corporate');
            sec.replaceText(',Employee', ', Corporate Professional');
            sec.replaceText(',\\s*Corporate\\s+Professional', ', Corporate Professional');

            sec.replaceText('Self-Declaration\\s+Letter\\s+duly\\s+signed\\s+by\\s+(?:your\\s+)?Parent\\s*/\\s*Guardian', 'Self-Declaration Letter duly signed by the Corporate Professional');
            sec.replaceText('duly\\s+signed\\s+by\\s+(?:your\\s+)?Parent\\s*/\\s*Guardian', 'duly signed by the Corporate Professional');
          } else {
            // Student cleanups
            sec.replaceText(',\\s*a\\s+pursuing', ', a pursuing');
            sec.replaceText('1stYear', '1st Year');
            sec.replaceText('2ndYear', '2nd Year');
            sec.replaceText('3rdYear', '3rd Year');
            sec.replaceText('4thYear', '4th Year');
            sec.replaceText('1styear', '1st Year');
            sec.replaceText('2ndyear', '2nd Year');
            sec.replaceText('3rdyear', '3rd Year');
            sec.replaceText('4thyear', '4th Year');
          }

          // Common cleanups for all categories
          sec.replaceText(',the\\s+', ', the ');
          sec.replaceText('\\s{2,}', ' ');

          // Application Form & Form-2 dynamic header replacements
          if (docType === 'applicationForm') {
            const appTitle = (candCat === 'Faculty') ? 'FACULTY INTERNSHIP APPLICATION' : ((candCat === 'Employee') ? 'EMPLOYEE INTERNSHIP APPLICATION' : ((candCat === 'Apprentice') ? 'APPRENTICE INTERNSHIP APPLICATION' : 'STUDENT INTERNSHIP APPLICATION'));
            const form1TableTitle = (candCat === 'Faculty') ? 'FACULTY INTERNSHIP APPLICATION DETAILS' : ((candCat === 'Employee') ? 'EMPLOYEE INTERNSHIP APPLICATION DETAILS' : ((candCat === 'Apprentice') ? 'APPRENTICE INTERNSHIP APPLICATION DETAILS' : 'STUDENT APPLICATION DETAILS'));
            const form2Title = (candCat === 'Faculty') ? 'FACULTY INTERNSHIP TRAINING DECLARATION LETTER' : ((candCat === 'Employee') ? 'CORPORATE EMPLOYEE TRAINING DECLARATION LETTER' : ((candCat === 'Apprentice') ? 'INDUSTRIAL APPRENTICESHIP DECLARATION LETTER' : 'STUDENT & PARENT SELF DECLARATION'));

            if (candCat !== 'Student') {
              sec.replaceText('STUDENT\\s+INTERNSHIP\\s+APPLICATION', appTitle);
              sec.replaceText('Student\\s+Internship\\s+Application', appTitle);
              sec.replaceText('STUDENT\\s+APPLICATION\\s+FORM', appTitle);
              sec.replaceText('Student\\s+Application\\s+Form', appTitle);
              sec.replaceText('STUDENT\\s+APPLICATION\\s+DETAILS', form1TableTitle);
              sec.replaceText('STUDENT & PARENT SELF DECLARATION(?: LETTER)?', form2Title);
              sec.replaceText('STUDENT & PARENT SELF DECLARATION', form2Title);
              sec.replaceText('Student & Parent Self Declaration Letter', form2Title);
            }
          }
        } catch(eWild) {}
      });
    } catch(eWildAll) {}

    // Safety check: ensure concatenated college names are separated

    try {

      body.replaceText('VELAMMALINSTITUTEOFTECHNOLOGY', 'VELAMMAL INSTITUTE OF TECHNOLOGY');

      body.replaceText('VELAMMALENGINEERINGCOLLEGE', 'VELAMMAL ENGINEERING COLLEGE');

      body.replaceText('SAVETHAENGINEERINGCOLLEGE', 'SAVETHA ENGINEERING COLLEGE');

      body.replaceText('PANIMALARENGINEERINGCOLLEGE', 'PANIMALAR ENGINEERING COLLEGE');

      body.replaceText('RAJALAKSHMIENGINEERINGCOLLEGE', 'RAJALAKSHMI ENGINEERING COLLEGE');

      body.replaceText('SRIVENKATESWARACOLLEGEOFENGINEERING', 'SRI VENKATESWARA COLLEGE OF ENGINEERING');

    } catch(e) {}



    // === FINAL POST-ASSEMBLY PAGINATION & FORMATTING CLEANUP ===

    if (docType === 'applicationForm') {

      // Complete eradication of old legacy names

      try {

        body.replaceText('V-VARAMA', 'GSV ELECTRICAL ENTERPRISES');

        body.replaceText('V-VARMA', 'GSV ELECTRICAL ENTERPRISES');

        body.replaceText('vvarma', 'gsvee');

        

        const hSection = doc.getHeader();

        if (hSection) {

          hSection.replaceText('V-VARAMA', 'GSV ELECTRICAL ENTERPRISES');

          hSection.replaceText('V-VARMA', 'GSV ELECTRICAL ENTERPRISES');

        }

        const fSection = doc.getFooter();

        if (fSection) {

          fSection.replaceText('V-VARAMA', 'GSV ELECTRICAL ENTERPRISES');

          fSection.replaceText('V-VARMA', 'GSV ELECTRICAL ENTERPRISES');

        }

      } catch(eLegacy) {

        Logger.log("Legacy company name replacement error: " + eLegacy);

      }



      // Set symmetric margins (56.75pt left & right) so that 482pt tables are dead-center aligned on the 595.5pt page!

      try {

        body.setMarginLeft(56.75);

        body.setMarginRight(56.75);

      } catch(mErr) {

        Logger.log("Margin set error: " + mErr);

      }

      formatApplicationFormStudentInfoTable_(body, studentData, placeholderValues);

      formatApplicationFormDeclarationSignatures_(body, studentData);

      ensureApplicationFormPagination_(body);
      formatForm3AttendanceSummaryTable_(body);

      // Explicitly enforce distinct titles for Form-1, Form-2, Form-3 so no global replace can overwrite them
      try {
        const candCatFinal = getCandidateCategory_(studentData);
        const f2TitleFinal = (candCatFinal === 'Faculty') ? 'FACULTY INTERNSHIP TRAINING DECLARATION LETTER' : ((candCatFinal === 'Employee') ? 'CORPORATE EMPLOYEE TRAINING DECLARATION LETTER' : ((candCatFinal === 'Apprentice') ? 'INDUSTRIAL APPRENTICESHIP DECLARATION LETTER' : 'STUDENT & PARENT SELF DECLARATION'));
        const f3TitleFinal = (candCatFinal === 'Faculty') ? 'FACULTY TRAINEE INTERNSHIP ATTENDANCE SHEET' : ((candCatFinal === 'Employee') ? 'CORPORATE EMPLOYEE ATTENDANCE SHEET' : ((candCatFinal === 'Apprentice') ? 'APPRENTICE INTERN ATTENDANCE SHEET' : 'STUDENTS INTERNSHIP ATTENDANCE SHEET'));

        // Under Form-2: Scan forward for the title paragraph
        const pF2H = body.findText('Form-2') || body.findText('Form -2');
        if (pF2H) {
          let el = pF2H.getElement();
          while (el && el.getParent() && el.getParent().getType() !== DocumentApp.ElementType.BODY_SECTION) el = el.getParent();
          if (el && el.getParent() && el.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {
            const idx = body.getChildIndex(el);
            for (let off = 1; off <= 4 && (idx + off) < body.getNumChildren(); off++) {
              const candEl = body.getChild(idx + off);
              if (candEl.getType() === DocumentApp.ElementType.PARAGRAPH) {
                const cTxt = candEl.asParagraph().getText().trim();
                if (cTxt.length > 0) {
                  if (/To\s*$/i.test(cTxt) || /^\d{2}\/\d{2}\/\d{4}/.test(cTxt) || /The Proprietor/i.test(cTxt)) break;
                  candEl.asParagraph().setText(f2TitleFinal);
                  candEl.asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER);
                  candEl.asParagraph().setSpacingBefore(2);
                  candEl.asParagraph().setSpacingAfter(6);
                  candEl.asParagraph().editAsText().setFontFamily('Arial').setFontSize(15).setBold(true).setForegroundColor('#003366');
                  break;
                }
              }
            }
          }
        }

        // Under Form-3: Scan forward for the title paragraph
        const pF3H = body.findText('Form -3') || body.findText('Form-3');
        if (pF3H) {
          let el = pF3H.getElement();
          while (el && el.getParent() && el.getParent().getType() !== DocumentApp.ElementType.BODY_SECTION) el = el.getParent();
          if (el && el.getParent() && el.getParent().getType() === DocumentApp.ElementType.BODY_SECTION) {
            const idx = body.getChildIndex(el);
            for (let off = 1; off <= 4 && (idx + off) < body.getNumChildren(); off++) {
              const candEl = body.getChild(idx + off);
              if (candEl.getType() === DocumentApp.ElementType.PARAGRAPH) {
                const cTxt = candEl.asParagraph().getText().trim();
                if (cTxt.length > 0) {
                  if (/G\.S\.V/i.test(cTxt) || /Details/i.test(cTxt)) break;
                  candEl.asParagraph().setText(f3TitleFinal);
                  candEl.asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER);
                  candEl.asParagraph().setSpacingBefore(2);
                  candEl.asParagraph().setSpacingAfter(4);
                  candEl.asParagraph().editAsText().setFontFamily('Arial').setFontSize(15).setBold(true).setForegroundColor('#003366');
                  break;
                }
              }
            }
          }
        }
      } catch(eTitles) {}

      watermarkLogs = [];
      applyApplicationFormWatermark_(doc, body, watermarkLogs);

    }

    if (isCertificateDoc) {

      // Re-assert deep black, Arial Black, and bold on CN & DATE table after placeholder replacement

      try {

        const tables = body.getTables();

        if (tables.length > 0) {

          const t0 = tables[0];

          if (t0.getNumRows() > 0 && t0.getRow(0).getNumCells() === 2) {

            const r = t0.getRow(0);

            const c0 = r.getCell(0);

            const c1 = r.getCell(1);

            if (c0.getNumChildren() > 0 && /CN\s*:/i.test(c0.getChild(0).getText())) {

              const p0 = c0.getChild(0).asParagraph();

              const l0 = p0.getText().length;

              if (l0 > 0) {

                p0.editAsText().setFontFamily(0, l0 - 1, 'Arial Black');

                p0.editAsText().setFontSize(0, l0 - 1, 13.5);

                p0.editAsText().setBold(0, l0 - 1, true);

                p0.editAsText().setForegroundColor(0, l0 - 1, '#000000');

              }

            }

            if (c1.getNumChildren() > 0 && /DATE/i.test(c1.getChild(0).getText())) {

              const p1 = c1.getChild(0).asParagraph();

              const l1 = p1.getText().length;

              if (l1 > 0) {

                p1.editAsText().setFontFamily(0, l1 - 1, 'Arial Black');

                p1.editAsText().setFontSize(0, l1 - 1, 13.5);

                p1.editAsText().setBold(0, l1 - 1, true);

                p1.editAsText().setForegroundColor(0, l1 - 1, '#000000');

              }

            }

          }

        }

      } catch(boldErr) {

        Logger.log('Post-replacement bold error: ' + boldErr);

      }

      // Ensure any concatenated college names like VELAMMALINSTITUTEOFTECHNOLOGY have proper word spacing

      try {

        body.replaceText('VELAMMALINSTITUTEOFTECHNOLOGY', 'VELAMMAL INSTITUTE OF TECHNOLOGY');

        body.replaceText('VELAMMALENGINEERINGCOLLEGE', 'VELAMMAL ENGINEERING COLLEGE');

        body.replaceText('SAVETHAENGINEERINGCOLLEGE', 'SAVETHA ENGINEERING COLLEGE');

        body.replaceText('PANIMALARENGINEERINGCOLLEGE', 'PANIMALAR ENGINEERING COLLEGE');

        body.replaceText('RAJALAKSHMIENGINEERINGCOLLEGE', 'RAJALAKSHMI ENGINEERING COLLEGE');

        body.replaceText('SRIVENKATESWARACOLLEGEOFENGINEERING', 'SRI VENKATESWARA COLLEGE OF ENGINEERING');

      } catch(ePoly) {}

      ensureCertificateSinglePage_(body, studentData, options);

      // Re-apply exact body paragraph styling directly post-replacement to guarantee 100% final font, bolding & alignment

      if (candCat === 'Faculty') {
        body.replaceText('a\\s+pursuing\\s+student\\s+of(?:\\s+the)?(?:\\s+faculty\\s+of)?', 'the Faculty of');
        body.replaceText('a\\s+pursuing\\s+student\\s+of(?:\\s*\\d+(?:st|nd|rd|th)?(?:\\s*year)?)?', 'the Faculty of');
        body.replaceText('pursuing\\s+student\\s+of', 'Faculty of');
        body.replaceText('pursuing\\s+student', 'Faculty Member');
        body.replaceText('the\\s+Faculty\\s+of\\s+(?:faculty|year)\\b', 'the Faculty of');
        body.replaceText('the\\s+Faculty\\s+of\\s+the\\s+Faculty\\s+of', 'the Faculty of');
        body.replaceText('Employee\\s*ID\\s*:\\s*', 'Staff ID : ');
      } else if (candCat === 'Employee') {
        body.replaceText('a\\s+pursuing\\s+student\\s+of(?:\\s+the)?(?:\\s+employee\\s+of)?', 'the Employee of');
        body.replaceText('a\\s+pursuing\\s+student\\s+of(?:\\s*\\d+(?:st|nd|rd|th)?(?:\\s*year)?)?', 'the Employee of');
        body.replaceText('pursuing\\s+student\\s+of', 'Employee of');
        body.replaceText('pursuing\\s+student', 'Corporate Professional');
        body.replaceText('the\\s+Employee\\s+of\\s+(?:professional|year)\\b', 'the Employee of');
        body.replaceText('the\\s+Employee\\s+of\\s+the\\s+Employee\\s+of', 'the Employee of');
      } else if (candCat === 'Apprentice') {
        body.replaceText('a\\s+pursuing\\s+student\\s+of(?:\\s+the)?(?:\\s+apprentice\\s+trainee\\s+of)?', 'the Apprentice Trainee of');
        body.replaceText('a\\s+pursuing\\s+student\\s+of(?:\\s*\\d+(?:st|nd|rd|th)?(?:\\s*year)?)?', 'the Apprentice Trainee of');
        body.replaceText('pursuing\\s+student\\s+of', 'Apprentice Trainee of');
        body.replaceText('pursuing\\s+student', 'Apprentice Trainee');
        body.replaceText('the\\s+Apprentice\\s+Trainee\\s+of\\s+(?:apprentice|year)\\b', 'the Apprentice Trainee of');
        body.replaceText('the\\s+Apprentice\\s+Trainee\\s+of\\s+the\\s+Apprentice\\s+Trainee\\s+of', 'the Apprentice Trainee of');
      }
      formatCertificateBodyExact_(body, studentData, options);

      cleanDocFormattingRecursively_(body);

    }



    doc.saveAndClose();

    // Allow Google Docs backend to flush symmetric margins, layout & graphics before Drive PDF export

    Utilities.sleep(2000);



    // === PREVIEW MODE: DO NOT SAVE IN GDRIVE / AUTO-DELETE PREVIEW FILE ===

    if (isPreview) {

      const previewBlob = tempCopy.getAs(MimeType.PDF);

      previewBlob.setName(`PREVIEW_${newDocName}`);



      // Auto-trash the temporary Google Doc copy immediately

      try { tempCopy.setTrashed(true); } catch(trErr) {}



      // Clean up any stale preview files in targetFolder

      try {

        cleanStalePreviewFiles_(targetFolder, registrationId);

      } catch(cleanErr) {}



      // Generate base64 for client-side direct in-memory rendering (0 Drive storage needed)

      let previewBase64 = '';

      try {

        previewBase64 = Utilities.base64Encode(previewBlob.getBytes());

      } catch(bErr) {

        Logger.log("base64 encoding failed for preview: " + bErr);

      }



      // Store strictly inside dedicated Preview folder to avoid polluting main storage
      let previewPdf = null;
      try {
        const previewFolder = getOrCreatePreviewFolder();
        previewPdf = previewFolder ? previewFolder.createFile(previewBlob) : targetFolder.createFile(previewBlob);
      } catch(createErr) {
        Logger.log("Preview folder createFile error: " + createErr);
        try {
          previewPdf = targetFolder.createFile(previewBlob);
        } catch(e) {
          previewPdf = DriveApp.getRootFolder().createFile(previewBlob);
        }
      }

      // Log preview metadata to Preview_Documents sheet
      if (previewPdf) {
        try {
          logPreviewDocumentRecord(registrationId, docType, studentData.FullName || studentData.StudentName || '', previewPdf.getId(), previewPdf.getUrl(), certNumber || '');
        } catch(logErr) {}
      }

      

      const previewUrl = previewPdf ? previewPdf.getUrl() : '';

      const previewFileId = previewPdf ? previewPdf.getId() : '';



      return {

        status: 'success',

        message: 'Preview generated successfully.',

        driveLink: previewUrl,

        url: previewUrl,

        viewUrl: previewUrl,

        fileId: previewFileId,

        pdfBase64: previewBase64,

        certNumber: certNumber,

        attendedDays: calculatedAttendedDays,

        isExistingCert: isExistingCert,

        isPreview: true,

        studentName: studentData.FullName || studentData.StudentName || '',

        collegeName: studentData.CollegeName || studentData.College || '',

        batch: studentData.Batch || studentData.BatchNo || studentData.BatchName || ''

      };

    }



    // === OFFICIAL GENERATION MODE ===

    const generatedFile = tempCopy.getAs(MimeType.PDF);

    generatedFile.setName(newDocName);

    const finalPdf = targetFolder.createFile(generatedFile);

    tempCopy.setTrashed(true);

    const driveLink = finalPdf.getUrl();

    const newFileId = finalPdf.getId();



    // ══════════════════════════════════════════════════════════════════════

    // DELETE OLD PDF FILE(S) FROM GOOGLE DRIVE (CLEAN OVERWRITE)

    // ══════════════════════════════════════════════════════════════════════

    const oldFileIdsToDelete = new Set();

    const targetRegUpper = String(registrationId).trim().toUpperCase();



    // 1. From CERTIFICATE_DATA sheet

    if (isCertificateDoc) {

      try {

        const cSheet = getSheet(SHEET_NAMES.CERTIFICATE_DATA);

        if (cSheet) {

          const cData = cSheet.getDataRange().getValues();

          const cRegCol = cData[0].indexOf("StudentRegistrationID");

          const cPdfCol = cData[0].indexOf("CertificatePdfId");

          if (cRegCol !== -1 && cPdfCol !== -1) {

            for (let i = 1; i < cData.length; i++) {

              if (String(cData[i][cRegCol] || '').trim().toUpperCase() === targetRegUpper) {

                const oldId = String(cData[i][cPdfCol] || '').trim();

                if (oldId && oldId !== newFileId) oldFileIdsToDelete.add(oldId);

              }

            }

          }

        }

      } catch(e) {}

    }



    // 2. From REGISTRATIONS sheet

    try {

      const rSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

      if (rSheet) {

        const rData = rSheet.getDataRange().getValues();

        const rHeaders = rData[0].map(h => String(h).trim().toLowerCase());

        const rRegCol = rHeaders.indexOf("registrationid");

        if (rRegCol !== -1) {

          for (let i = 1; i < rData.length; i++) {

            if (String(rData[i][rRegCol] || '').trim().toUpperCase() === targetRegUpper) {

              if (isCertificateDoc) {

                const cLinkCol = rHeaders.indexOf("certificatelink");

                if (cLinkCol !== -1) {

                  const m = String(rData[i][cLinkCol] || '').match(/[-\w]{25,}/);

                  if (m && m[0] !== newFileId) oldFileIdsToDelete.add(m[0]);

                }

              } else if (docType === 'applicationForm') {

                const aPdfCol = rHeaders.indexOf("applicationpdfid");

                if (aPdfCol !== -1) {

                  const oldId = String(rData[i][aPdfCol] || '').trim();

                  if (oldId && oldId !== newFileId) oldFileIdsToDelete.add(oldId);

                }

              } else if (docType === 'offerLetter') {

                const oPdfCol = rHeaders.indexOf("offerletterpdfid");

                if (oPdfCol !== -1) {

                  const oldId = String(rData[i][oPdfCol] || '').trim();

                  if (oldId && oldId !== newFileId) oldFileIdsToDelete.add(oldId);

                }

              } else if (docType === 'joiningLetter') {

                const jPdfCol = rHeaders.indexOf("joiningletterpdfid");

                if (jPdfCol !== -1) {

                  const oldId = String(rData[i][jPdfCol] || '').trim();

                  if (oldId && oldId !== newFileId) oldFileIdsToDelete.add(oldId);

                }

              }

              break;

            }

          }

        }

      }

    } catch(e) {}



    // 3. From GENERATED_DOCUMENTS sheet

    try {

      const gSheet = getSheet(SHEET_NAMES.GENERATED_DOCUMENTS);

      if (gSheet) {

        const gData = gSheet.getDataRange().getValues();

        const gHeaders = gData[0].map(h => String(h).trim().toLowerCase());

        let gRegCol = gHeaders.indexOf("studentregistrationid");

        if (gRegCol === -1) gRegCol = gHeaders.indexOf("registrationid");

        let gTypeCol = gHeaders.indexOf("doctype");

        let gPdfCol = gHeaders.indexOf("pdffileid");

        if (gPdfCol === -1) gPdfCol = gHeaders.indexOf("fileid");

        let gUrlCol = gHeaders.indexOf("docurl");

        if (gUrlCol === -1) gUrlCol = gHeaders.indexOf("url");



        if (gRegCol !== -1 && gTypeCol !== -1) {

          for (let i = 1; i < gData.length; i++) {

            const rowReg = String(gData[i][gRegCol] || '').trim().toUpperCase();

            const rowType = String(gData[i][gTypeCol] || '').trim().toLowerCase();

            const typeMatches = (rowType === String(docType).toLowerCase()) ||

              (isCertificateDoc && (rowType.includes('cert') || rowType.includes('completion')));

            if (rowReg === targetRegUpper && typeMatches) {

              const oldId = gPdfCol !== -1 ? String(gData[i][gPdfCol] || '').trim() : '';

              if (oldId && oldId !== newFileId && !oldId.startsWith('DOC-')) {

                oldFileIdsToDelete.add(oldId);

              } else if (gUrlCol !== -1) {

                const m = String(gData[i][gUrlCol] || '').match(/[-\w]{25,}/);

                if (m && m[0] !== newFileId) oldFileIdsToDelete.add(m[0]);

              }

            }

          }

        }

      }

    } catch(e) {}



    // 4. From FILE_MANAGER sheet

    try {

      const fmSheet = getSheet(SHEET_NAMES.FILE_MANAGER);

      if (fmSheet) {

        const fmData = fmSheet.getDataRange().getValues();

        if (fmData.length > 1) {

          for (let i = 1; i < fmData.length; i++) {

            const rowId = String(fmData[i][0] || '').trim();

            const rowReg = String(fmData[i][1] || '').trim().toUpperCase();

            const rowType = String(fmData[i][4] || '').trim().toLowerCase();

            const typeMatches = (rowType === String(docType).toLowerCase()) ||

              (isCertificateDoc && (rowType.includes('cert') || rowType.includes('completion')));

            if (rowReg === targetRegUpper && typeMatches && rowId && rowId !== newFileId) {

              oldFileIdsToDelete.add(rowId);

              fmSheet.getRange(i + 1, 8).setValue('Replaced');

            }

          }

        }

      }

    } catch(e) {}



    // Trash all old files from Drive

    oldFileIdsToDelete.forEach(oldId => {

      try {

        const oldFile = DriveApp.getFileById(oldId);

        if (oldFile && !oldFile.isTrashed()) {

          oldFile.setTrashed(true);

          Logger.log(`Successfully trashed old ${docType} PDF: ${oldId} for ${registrationId}`);

        }

      } catch(trErr) {

        Logger.log(`Could not trash old file ${oldId}: ${trErr.toString()}`);

      }

    });



    // Clean up any stale preview files as well

    try {

      cleanStalePreviewFiles_(targetFolder, registrationId);

    } catch(cleanErr) {}



    // ══════════════════════════════════════════════════════════════════════

    // UPDATE SHEETS (ZERO DUPLICATES - UPDATE BASED ON SAME NO)

    // ══════════════════════════════════════════════════════════════════════

    if (docType === 'internshipCertificate' || docType === 'completionCertificate') {

      const certSheet = getSheet(SHEET_NAMES.CERTIFICATE_DATA);

      if (certSheet) {

        const certData = certSheet.getDataRange().getValues();

        const cHeaders = certData[0].map(h => String(h).trim().toLowerCase());

        let regIdx = cHeaders.indexOf("studentregistrationid");

        if (regIdx === -1) regIdx = cHeaders.indexOf("registrationid");

        let numIdx = cHeaders.indexOf("certificatenumber");

        let pdfIdx = cHeaders.indexOf("certificatepdfid");

        let dateIdx = cHeaders.indexOf("issueddate");

        let durIdx = cHeaders.indexOf("durationdays");

        let statIdx = cHeaders.indexOf("status");

        let nameIdx = cHeaders.indexOf("studentname");

        let deptIdx = cHeaders.indexOf("department");



        let existingRows = [];

        if (regIdx !== -1) {

          for (let i = 1; i < certData.length; i++) {

            if (String(certData[i][regIdx] || '').trim().toUpperCase() === targetRegUpper) {

              existingRows.push(i + 1);

            }

          }

        }



        if (existingRows.length > 0) {

          const primaryRow = existingRows[0];

          if (numIdx !== -1 && certNumber) certSheet.getRange(primaryRow, numIdx + 1).setValue(certNumber);

          if (pdfIdx !== -1) certSheet.getRange(primaryRow, pdfIdx + 1).setValue(newFileId);

          if (dateIdx !== -1) certSheet.getRange(primaryRow, dateIdx + 1).setValue(new Date());

          if (durIdx !== -1 && calculatedAttendedDays) certSheet.getRange(primaryRow, durIdx + 1).setValue(calculatedAttendedDays);

          if (statIdx !== -1) certSheet.getRange(primaryRow, statIdx + 1).setValue('Valid');

          if (nameIdx !== -1 && studentData.FullName) certSheet.getRange(primaryRow, nameIdx + 1).setValue(studentData.FullName);

          if (deptIdx !== -1 && studentData.Department) certSheet.getRange(primaryRow, deptIdx + 1).setValue(studentData.Department);



          // Delete any extra duplicate rows for this student

          for (let d = existingRows.length - 1; d >= 1; d--) {

            try { certSheet.deleteRow(existingRows[d]); } catch(eDel) {}

          }

        } else {

          const certHeader = certSheet.getRange("1:1").getValues()[0];

          const certRecord = {

            CertificateNumber: certNumber,

            StudentRegistrationID: registrationId,

            StudentName: studentData.FullName,

            Department: studentData.Department,

            DurationDays: calculatedAttendedDays,

            IssuedDate: new Date(),

            Status: 'Valid',

            CertificatePdfId: newFileId

          };

          const certRow = certHeader.map(col => certRecord[col] !== undefined ? certRecord[col] : '');

          appendRow(SHEET_NAMES.CERTIFICATE_DATA, certRow);
          try {
            if (candCat === 'Faculty') {
              appendRow(SHEET_NAMES.FACULTY_CERTIFICATE_DATA || 'Faculty_Certificate_Data', certRow);
            } else if (candCat === 'Employee') {
              appendRow(SHEET_NAMES.EMPLOYEE_CERTIFICATE_DATA || 'Employee_Certificate_Data', certRow);
            } else if (candCat === 'Apprentice') {
              appendRow(SHEET_NAMES.APPRENTICE_CERTIFICATE_DATA || 'Apprentice_Certificate_Data', certRow);
            }
          } catch(candCertErr) {}

        }

      }



      const candTargetRegSheet = (typeof getCandidateRegistrationSheetName_ === 'function') ? getCandidateRegistrationSheetName_(candCat) : SHEET_NAMES.REGISTRATIONS;
      const regSheetsToUpdate = [SHEET_NAMES.REGISTRATIONS];
      if (candTargetRegSheet && !regSheetsToUpdate.includes(candTargetRegSheet)) {
        regSheetsToUpdate.push(candTargetRegSheet);
      }

      regSheetsToUpdate.forEach(shName => {
        const regSheet = getSheet(shName);
        if (regSheet) {

        const regData = regSheet.getDataRange().getValues();

        const rHeaders = regData[0].map(h => String(h).trim().toLowerCase());

        const regIdIdx = rHeaders.indexOf("registrationid");

        const certLinkIdx = rHeaders.indexOf("certificatelink");

        const certDateIdx = rHeaders.indexOf("certificateissueddate");

        const certNumIdx = rHeaders.indexOf("certificatenumber");



        if (regIdIdx !== -1) {

          for (let i = 1; i < regData.length; i++) {

            if (String(regData[i][regIdIdx] || '').trim().toUpperCase() === targetRegUpper) {

              const rRow = i + 1;

              if (certLinkIdx !== -1) regSheet.getRange(rRow, certLinkIdx + 1).setValue(driveLink);

              if (certDateIdx !== -1) regSheet.getRange(rRow, certDateIdx + 1).setValue(new Date());

              if (certNumIdx !== -1 && certNumber) regSheet.getRange(rRow, certNumIdx + 1).setValue(certNumber);

              break;

            }

          }

        }

      }
      });

    } else {

      // Non-certificate documents: update registrations sheet columns

      const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

      if (regSheet) {

        const regData = regSheet.getDataRange().getValues();

        const rHeaders = regData[0].map(h => String(h).trim().toLowerCase());

        const regIdIdx = rHeaders.indexOf("registrationid");

        const appPdfIdx = rHeaders.indexOf("applicationpdfid");

        const offerPdfIdx = rHeaders.indexOf("offerletterpdfid");

        const joinPdfIdx = rHeaders.indexOf("joiningletterpdfid");



        if (regIdIdx !== -1) {

          for (let i = 1; i < regData.length; i++) {

            if (String(regData[i][regIdIdx] || '').trim().toUpperCase() === targetRegUpper) {

              const rRow = i + 1;

              if (docType === 'applicationForm' && appPdfIdx !== -1) regSheet.getRange(rRow, appPdfIdx + 1).setValue(newFileId);

              if (docType === 'offerLetter' && offerPdfIdx !== -1) regSheet.getRange(rRow, offerPdfIdx + 1).setValue(newFileId);

              if (docType === 'joiningLetter' && joinPdfIdx !== -1) regSheet.getRange(rRow, joinPdfIdx + 1).setValue(newFileId);

              break;

            }

          }

        }

      }

    }



    // Update GENERATED_DOCUMENTS sheet (avoid duplicate rows)

    const docSheet = getSheet(SHEET_NAMES.GENERATED_DOCUMENTS);

    if (docSheet) {

      const docData = docSheet.getDataRange().getValues();

      const docHeaders = docData[0].map(h => String(h).trim().toLowerCase());

      let regColIdx = docHeaders.indexOf("studentregistrationid");

      if (regColIdx === -1) regColIdx = docHeaders.indexOf("registrationid");

      let typeColIdx = docHeaders.indexOf("doctype");

      let uIdx = docHeaders.indexOf("docurl");

      if (uIdx === -1) uIdx = docHeaders.indexOf("url");

      let pIdx = docHeaders.indexOf("pdffileid");

      if (pIdx === -1) pIdx = docHeaders.indexOf("fileid");

      let dIdx = docHeaders.indexOf("generateddate");

      if (dIdx === -1) dIdx = docHeaders.indexOf("date");

      let eIdx = docHeaders.indexOf("sentviaemail");

      let rIdx = docHeaders.indexOf("referencenumber");

      if (rIdx === -1) rIdx = docHeaders.indexOf("certificatenumber");



      let existingDocRows = [];

      if (regColIdx !== -1 && typeColIdx !== -1) {

        for (let i = 1; i < docData.length; i++) {

          const rowReg = String(docData[i][regColIdx] || '').trim().toUpperCase();

          const rowType = String(docData[i][typeColIdx] || '').trim().toLowerCase();

          const typeMatches = (rowType === String(docType).toLowerCase()) ||

            (isCertificateDoc && (rowType.includes('cert') || rowType.includes('completion')));

          if (rowReg === targetRegUpper && typeMatches) {

            existingDocRows.push(i + 1);

          }

        }

      }



      const refVal = (isCertificateDoc && certNumber) ? certNumber : ('REF-' + Date.now());



      if (existingDocRows.length > 0) {

        const primaryRow = existingDocRows[0];

        if (uIdx !== -1) docSheet.getRange(primaryRow, uIdx + 1).setValue(driveLink);

        if (pIdx !== -1) docSheet.getRange(primaryRow, pIdx + 1).setValue(newFileId);

        if (dIdx !== -1) docSheet.getRange(primaryRow, dIdx + 1).setValue(new Date());

        if (eIdx !== -1) docSheet.getRange(primaryRow, eIdx + 1).setValue(sendEmailOption ? 'Yes' : 'No');

        if (rIdx !== -1) docSheet.getRange(primaryRow, rIdx + 1).setValue(refVal);



        for (let d = existingDocRows.length - 1; d >= 1; d--) {

          try { docSheet.deleteRow(existingDocRows[d]); } catch(eDel) {}

        }

      } else {

        const finalDocId = generateUniqueId('DOC', docSheet, 0);

        appendRow(SHEET_NAMES.GENERATED_DOCUMENTS, [finalDocId, registrationId, docType, refVal, driveLink, newFileId, new Date(), sendEmailOption ? 'Yes' : 'No']);

      }

    }



    // Log active file in FILE_MANAGER

    const fmSheet = getSheet(SHEET_NAMES.FILE_MANAGER);

    if (fmSheet) {

      appendRow(SHEET_NAMES.FILE_MANAGER, [newFileId, registrationId, newDocName, driveLink, docType, new Date(), finalPdf.getSize ? finalPdf.getSize() : 0, 'Active']);

    }



    if (sendEmailOption && studentData.GmailID) {

      const isCertificate = (docType === 'internshipCertificate' || docType === 'completionCertificate');

      const stuAppStatus = String(studentData.ApplicationStatus || studentData.Status || '').trim().toLowerCase();

      

      // Strict GSV Rule: Certificate email is NEVER dispatched unless student's internship status is Completed!

      if (isCertificate && stuAppStatus !== 'completed') {

        Logger.log(`Skipping certificate email: Student ${registrationId} status '${stuAppStatus}' is not Completed.`);

      } else {

        let subject = `Official Document: ${docType} - ${studentData.FullName} | ${studentData.CompanyName}`;

        let emailBody = '';

        

        if (isCertificate) {

          subject = `🎓 Official Internship Completion Certificate & Career Wishes - ${studentData.FullName} | ${studentData.CompanyName}`;

          emailBody = getGrandCertificateEmailBody(studentData, certNumber, driveLink, calculatedAttendedDays);

        } else if (docType === 'applicationForm') {

          subject = `📄 Official Internship Application Form & Onboarding Guidelines - ${studentData.FullName} | ${studentData.CompanyName}`;

          emailBody = getGrandApplicationFormEmailBody(studentData, driveLink, applicationDateFormatted);

        } else if (docType === 'offerLetter') {

          subject = `🎉 Official Internship Offer Letter - ${studentData.FullName} | ${studentData.CompanyName}`;

          emailBody = getGrandOfferLetterEmailBody(studentData, driveLink);

        } else if (docType === 'joiningLetter') {

          subject = `🏢 Official Internship Joining & Induction Letter - ${studentData.FullName} | ${studentData.CompanyName}`;

          emailBody = getGrandJoiningLetterEmailBody(studentData, driveLink);

        } else if (docType === 'attendanceDocument' || docType === 'consolidatedAttendance') {

          subject = `📋 Official Consolidated Attendance Record (Form-4) - ${studentData.FullName} | ${studentData.CompanyName}`;

          emailBody = getGrandAttendanceEmailBody(studentData, driveLink, { attendedDays: calculatedAttendedDays, durationDays: studentData.DurationDays });

        } else {

          emailBody = getProfessionalEmailBody('confirmation', studentData, driveLink);

        }



        MailApp.sendEmail({ to: studentData.GmailID, subject: subject, htmlBody: emailBody, attachments: [finalPdf.getBlob()], inlineImages: getEmailInlineImages_(), name: studentData.CompanyName });

      }

    }



    createAdminNotification('Document Generated', `${docType} for ${studentData.FullName} generated successfully.`, 'ALL');

    return { status: 'success', message: 'Document generated successfully.', driveLink: driveLink, url: driveLink, viewUrl: driveLink, fileId: finalPdf.getId(), certNumber: certNumber, watermarkLogs: watermarkLogs, attendedDays: calculatedAttendedDays, studentName: studentData.FullName || studentData.StudentName || '', collegeName: studentData.CollegeName || studentData.College || '', batch: studentData.Batch || studentData.BatchNo || studentData.BatchName || '' };

  } catch (e) {

    return { status: 'error', message: e.message };

  }

}



function getStudentDocuments(registrationId) {

  const sheet = getSheet(SHEET_NAMES.GENERATED_DOCUMENTS);

  if (!sheet) return [];

  const data = sheet.getDataRange().getValues();

  const docs = [];

  const studentData = getStudentDataForDoc(registrationId) || {};

  const stuAppStatus = String(studentData.ApplicationStatus || studentData.Status || '').trim().toLowerCase();

  const isCompleted = (stuAppStatus === 'completed');



  for (let i = 1; i < data.length; i++) {

    if (String(data[i][1]).trim().toUpperCase() === String(registrationId).trim().toUpperCase()) {

      const docType = String(data[i][2]);

      const normType = normalizeDocType_(docType);

      // Strictly prevent non-completed students from accessing completion certificates

      if (normType === 'internshipCertificate' && !isCompleted) {

        continue;

      }

      docs.push({ type: data[i][2], refNo: data[i][3], url: data[i][4], date: formatDate(data[i][6]) });

    }

  }

  return docs;

}



/**

 * Normalizes document type strings across various UI & backend identifiers.

 */

function normalizeDocType_(docType) {

  if (!docType) return '';

  const d = String(docType).trim().toLowerCase().replace(/[-_\s]/g, '');

  if (d.includes('notice') || d.includes('warn') || d.includes('certdelay')) return docType; // NEVER normalize notice letters to certificate!

  if (d === 'internshipcertificate' || d === 'completioncertificate' || d === 'completion' || d === 'certificate' || d === 'cert') return 'internshipCertificate';

  if (d.includes('app') || d.includes('form1') || d.includes('form2') || d.includes('form3')) return 'applicationForm';

  if (d.includes('offer')) return 'offerLetter';

  if (d.includes('join') || d.includes('induct')) return 'joiningLetter';

  if (d.includes('idcard') || d.includes('entrypass') || d.includes('pass') || d.includes('badge')) return 'idCard';

  if (d.includes('atten') || d.includes('form4')) return 'attendanceDocument';

  if (d.includes('diary') || d.includes('form5')) return 'studentDiary';

  if (d.includes('project')) return 'projectCompletion';

  if (d.includes('bundle') || d.includes('all')) return 'studentAllDocuments';

  return docType;

}



/**

 * Helper to retrieve existing document fileId and URL for a student.

 */

function getExistingDocFileId(registrationId, docType) {

  const rec = getExistingGeneratedDocRecord_(registrationId, docType);

  if (rec && rec.fileId) {

    return { fileId: rec.fileId, url: rec.url || rec.driveLink };

  }

  return null;

}



/**

 * Comprehensive multi-sheet lookup to retrieve an existing generated document record.

 * Accurately inspects GENERATED_DOCUMENTS, REGISTRATIONS, CERTIFICATE_DATA, and FILE_MANAGER sheets.

 */

function getExistingGeneratedDocRecord_(registrationId, docType) {

  try {

    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);

    const searchReg = String(registrationId).trim().toLowerCase();

    const searchType = String(docType).trim().toLowerCase();

    const normType = normalizeDocType_(docType).toLowerCase();



    // 1. Check GENERATED_DOCUMENTS sheet

    const genSheet = ss.getSheetByName(SHEET_NAMES.GENERATED_DOCUMENTS);

    if (genSheet) {

      const data = genSheet.getDataRange().getValues();

      if (data.length >= 2) {

        const headers = data[0].map(h => String(h).trim().toLowerCase());

        

        let regCol = headers.indexOf('studentregistrationid');

        if (regCol === -1) regCol = headers.indexOf('registrationid');

        if (regCol === -1) regCol = headers.findIndex(h => h.includes('registration') || h.includes('regid'));

        if (regCol === -1) regCol = 1;



        let typeCol = headers.indexOf('doctype');

        if (typeCol === -1) typeCol = headers.indexOf('documenttype');

        if (typeCol === -1) typeCol = headers.findIndex(h => (h.includes('type') && !h.includes('documentid')));

        if (typeCol === -1) typeCol = 2;



        let urlCol = headers.indexOf('docurl');

        if (urlCol === -1) urlCol = headers.indexOf('url');

        if (urlCol === -1) urlCol = headers.findIndex(h => h.includes('url') || h.includes('link'));

        if (urlCol === -1) urlCol = 4;



        let fileIdCol = headers.indexOf('pdffileid');

        if (fileIdCol === -1) fileIdCol = headers.indexOf('fileid');

        if (fileIdCol === -1) fileIdCol = headers.findIndex(h => (h.includes('fileid') || h.includes('pdffile')) && !h.includes('documentid'));

        if (fileIdCol === -1) fileIdCol = 5;



        let dateCol = headers.indexOf('generateddate');

        if (dateCol === -1) dateCol = headers.indexOf('date');

        if (dateCol === -1) dateCol = headers.findIndex(h => h.includes('date') || h.includes('timestamp'));

        if (dateCol === -1) dateCol = 6;



        let certCol = headers.indexOf('referencenumber');

        if (certCol === -1) certCol = headers.indexOf('certificatenumber');

        if (certCol === -1) certCol = headers.findIndex(h => h.includes('ref') || h.includes('cert'));

        if (certCol === -1) certCol = 3;



        for (let i = data.length - 1; i >= 1; i--) {

          const row = data[i];

          const rReg = String(row[regCol]).trim().toLowerCase();

          const rType = String(row[typeCol]).trim().toLowerCase();

          const rNormType = normalizeDocType_(rType).toLowerCase();

          

          // CRITICAL: NEVER match notice letters or warnings when searching for certificates or other student documents!

          if (rType.includes('notice') || rType.includes('warn') || rNormType.includes('notice') || rNormType.includes('warn')) {

            if (!searchType.includes('notice') && !searchType.includes('warn')) {

              continue;

            }

          }

          if (searchType.includes('notice') || searchType.includes('warn')) {

            if (!rType.includes('notice') && !rType.includes('warn')) {

              continue;

            }

          }



          const typeMatches = (rType === searchType) ||

            (rNormType === normType) ||

            (normType === 'internshipcertificate' && (rType === 'internshipcertificate' || rType === 'completioncertificate' || rType === 'certificate' || rNormType === 'internshipcertificate')) ||

            (normType === 'applicationform' && (rType.includes('app') || rNormType.includes('app'))) ||

            (normType === 'attendancedocument' && (rType.includes('atten') || rNormType.includes('atten'))) ||

            (normType === 'studentdiary' && (rType.includes('diary') || rNormType.includes('diary'))) ||

            (normType === 'offerletter' && (rType.includes('offer') || rNormType.includes('offer'))) ||

            (normType === 'joiningletter' && (rType.includes('join') || rNormType.includes('join'))) ||

            (normType === 'idcard' && (rType.includes('id') || rType.includes('pass') || rNormType.includes('id')));



          if (rReg === searchReg && typeMatches) {

            const rawFileUrl = String(row[urlCol] || '').trim();

            const rawFileId = String(row[fileIdCol] || '').trim();

            const dateGen = formatDateDMY(row[dateCol]);

            const certNum = String(row[certCol] || '').trim();



            let targetFileId = '';

            if (rawFileId && !rawFileId.startsWith('DOC-') && !rawFileId.startsWith('REF-') && !rawFileId.startsWith('WRN-')) {

              targetFileId = rawFileId;

            } else if (rawFileUrl) {

              const m = rawFileUrl.match(/[-\w]{25,}/);

              if (m) targetFileId = m[0];

            }



            if (targetFileId || rawFileUrl) {

              let verifiedUrl = rawFileUrl;

              if (targetFileId) {

                try {

                  const f = DriveApp.getFileById(targetFileId);

                  if (f && !f.isTrashed()) {

                    verifiedUrl = `https://drive.google.com/file/d/${targetFileId}/preview`;

                  }

                } catch (dErr) {}

              }

              return {

                status: 'success',

                driveLink: verifiedUrl,

                url: verifiedUrl,

                fileId: targetFileId || rawFileId,

                dateGenerated: dateGen || 'Official Record',

                issuedDate: dateGen || 'Official Record',

                certNumber: certNum,

                isExisting: true

              };

            }

          }

        }

      }

    }



    // 2. Check CERTIFICATE_DATA sheet for certificates

    if (normType.includes('cert')) {

      const certSheet = ss.getSheetByName(SHEET_NAMES.CERTIFICATE_DATA);

      if (certSheet) {

        const cData = certSheet.getDataRange().getValues();

        if (cData.length >= 2) {

          const cHeaders = cData[0].map(h => String(h).trim().toLowerCase());

          let cRegCol = cHeaders.indexOf('studentregistrationid');

          if (cRegCol === -1) cRegCol = cHeaders.findIndex(h => h.includes('registration') || h.includes('reg'));

          if (cRegCol === -1) cRegCol = 1;



          let cNumCol = cHeaders.indexOf('certificatenumber');

          if (cNumCol === -1) cNumCol = 0;



          let cIdCol = cHeaders.indexOf('certificatepdfid');

          if (cIdCol === -1) cIdCol = cHeaders.findIndex(h => h.includes('pdfid') || h.includes('fileid'));

          if (cIdCol === -1) cIdCol = 11;



          let cDateCol = cHeaders.indexOf('issueddate');

          if (cDateCol === -1) cDateCol = cHeaders.findIndex(h => h.includes('date'));

          if (cDateCol === -1) cDateCol = 8;



          for (let j = cData.length - 1; j >= 1; j--) {

            const cRow = cData[j];

            const cReg = String(cRow[cRegCol]).trim().toLowerCase();

            if (cReg === searchReg) {

              const cFileId = String(cRow[cIdCol] || '').trim();

              const cNum = String(cRow[cNumCol] || '').trim();

              const cDate = formatDateDMY(cRow[cDateCol]);

              if (cFileId) {

                try {

                  const f = DriveApp.getFileById(cFileId);

                  if (f && !f.isTrashed()) {

                    return {

                      status: 'success',

                      driveLink: `https://drive.google.com/file/d/${cFileId}/preview`,

                      url: `https://drive.google.com/file/d/${cFileId}/preview`,

                      fileId: cFileId,

                      dateGenerated: cDate || 'Official Record',

                      issuedDate: cDate || 'Official Record',

                      certNumber: cNum,

                      isExisting: true

                    };

                  }

                } catch (e) {}

              }

            }

          }

        }

      }

    }



    // 3. Check REGISTRATIONS sheet direct columns

    const regSheet = ss.getSheetByName(SHEET_NAMES.REGISTRATIONS);

    if (regSheet) {

      const rData = regSheet.getDataRange().getValues();

      if (rData.length >= 2) {

        const rHeaders = rData[0].map(h => String(h).trim().toLowerCase());

        const rRegCol = rHeaders.findIndex(h => h.includes('registrationid') || h.includes('reg id') || h === 'regid');

        const appPdfCol = rHeaders.findIndex(h => h.includes('applicationpdfid') || h.includes('applicationpdf'));

        const offerPdfCol = rHeaders.findIndex(h => h.includes('offerletterpdfid') || h.includes('offerletterpdf'));

        const joinPdfCol = rHeaders.findIndex(h => h.includes('joiningletterpdfid') || h.includes('joiningletterpdf'));

        const certLinkCol = rHeaders.findIndex(h => h.includes('certificatelink'));

        const certDateCol = rHeaders.findIndex(h => h.includes('certificateissueddate'));



        for (let k = rData.length - 1; k >= 1; k--) {

          const rowK = rData[k];

          const kReg = String(rowK[rRegCol >= 0 ? rRegCol : 1]).trim().toLowerCase();

          if (kReg === searchReg) {

            let targetFileId = '';

            let targetDate = '';

            if (normType === 'applicationform' && appPdfCol >= 0) targetFileId = String(rowK[appPdfCol] || '').trim();

            else if (normType === 'offerletter' && offerPdfCol >= 0) targetFileId = String(rowK[offerPdfCol] || '').trim();

            else if (normType === 'joiningletter' && joinPdfCol >= 0) targetFileId = String(rowK[joinPdfCol] || '').trim();

            else if (normType === 'internshipcertificate' && certLinkCol >= 0) {

              const cLink = String(rowK[certLinkCol] || '').trim();

              const match = cLink.match(/[-\w]{25,}/);

              if (match) targetFileId = match[0];

              if (certDateCol >= 0) targetDate = String(rowK[certDateCol]).trim();

            }



            if (targetFileId) {

              try {

                const f = DriveApp.getFileById(targetFileId);

                if (f && !f.isTrashed()) {

                  return {

                    status: 'success',

                    driveLink: `https://drive.google.com/file/d/${targetFileId}/preview`,

                    url: `https://drive.google.com/file/d/${targetFileId}/preview`,

                    fileId: targetFileId,

                    dateGenerated: targetDate || 'Official Record',

                    issuedDate: targetDate || 'Official Record',

                    isExisting: true

                  };

                }

              } catch (e) {}

            }

          }

        }

      }

    }

  } catch (e) {

    Logger.log("getExistingGeneratedDocRecord_ error: " + e);

  }

  return null;

}



/**

 * Backend API to check if an official document already exists for a student before triggering preview.

 * Allows admin to choose between viewing existing document or generating a fresh copy.

 */

function checkExistingDocumentStatus(registrationId, docType, certTemplate) {

  try {

    const studentData = getStudentDataForDoc(registrationId);

    if (!studentData) {

      return { exists: false, error: 'Student not found' };

    }

    const docTypeMeta = {

      'internshipCertificate': { title: 'Completion Certificate', icon: 'fas fa-award' },

      'completionCertificate': { title: 'Completion Certificate', icon: 'fas fa-award' },

      'applicationForm': { title: 'Application Form', icon: 'fas fa-file-alt' },

      'offerLetter': { title: 'Offer Letter', icon: 'fas fa-envelope-open-text' },

      'joiningLetter': { title: 'Joining Letter', icon: 'fas fa-file-signature' },

      'attendanceDocument': { title: 'Attendance (Form-4)', icon: 'fas fa-clipboard-check' },

      'consolidatedAttendance': { title: 'Attendance (Form-4)', icon: 'fas fa-clipboard-check' },

      'studentDiary': { title: 'Student Diary (Form-5)', icon: 'fas fa-book-open' },

      'studentAllDocuments': { title: 'Complete Bundle', icon: 'fas fa-folder-open' }

    };

    const meta = docTypeMeta[docType] || { title: docType };



    if (docType === 'studentAllDocuments') {

      return {

        exists: false,

        studentName: studentData.FullName,

        regId: registrationId,

        docTitle: meta.title

      };

    }



    const existing = getExistingGeneratedDocRecord_(registrationId, docType);

    if (existing && (existing.fileId || existing.driveLink)) {

      return {

        exists: true,

        fileId: existing.fileId,

        driveLink: existing.driveLink || existing.url,

        issuedDate: existing.dateGenerated || existing.issuedDate || 'Official Record',

        certNumber: existing.certNumber || '',

        studentName: studentData.FullName,

        regId: registrationId,

        docTitle: meta.title,

        fileName: `${meta.title}_${registrationId}.pdf`

      };

    }



    // Direct studentData check fallback for certificates and other documents

    if (docType === 'internshipCertificate' || docType === 'completionCertificate') {

      const cLink = studentData.CertificateLink || studentData.CertificatePdfId;

      if (cLink && String(cLink).trim() !== '' && String(cLink).trim().toUpperCase() !== 'N/A' && String(cLink).trim() !== '--') {

        return {

          exists: true,

          fileId: studentData.CertificatePdfId || '',

          driveLink: cLink,

          issuedDate: studentData.CertificateIssuedDate || studentData.IssuedDate || 'Official Record',

          certNumber: studentData.CertificateNo || studentData.CertificateNumber || '',

          studentName: studentData.FullName,

          regId: registrationId,

          docTitle: meta.title,

          fileName: `${meta.title}_${registrationId}.pdf`

        };

      }

    } else if (docType === 'applicationForm' && studentData.ApplicationPdfId) {

      return {

        exists: true,

        fileId: studentData.ApplicationPdfId,

        driveLink: `https://drive.google.com/file/d/${studentData.ApplicationPdfId}/preview`,

        issuedDate: studentData.ApplicationDate || studentData.Timestamp || 'Official Record',

        studentName: studentData.FullName,

        regId: registrationId,

        docTitle: meta.title,

        fileName: `${meta.title}_${registrationId}.pdf`

      };

    } else if (docType === 'offerLetter' && studentData.OfferLetterPdfId) {

      return {

        exists: true,

        fileId: studentData.OfferLetterPdfId,

        driveLink: `https://drive.google.com/file/d/${studentData.OfferLetterPdfId}/preview`,

        issuedDate: studentData.OfferDate || 'Official Record',

        studentName: studentData.FullName,

        regId: registrationId,

        docTitle: meta.title,

        fileName: `${meta.title}_${registrationId}.pdf`

      };

    } else if (docType === 'joiningLetter' && studentData.JoiningLetterPdfId) {

      return {

        exists: true,

        fileId: studentData.JoiningLetterPdfId,

        driveLink: `https://drive.google.com/file/d/${studentData.JoiningLetterPdfId}/preview`,

        issuedDate: studentData.JoiningDate || 'Official Record',

        studentName: studentData.FullName,

        regId: registrationId,

        docTitle: meta.title,

        fileName: `${meta.title}_${registrationId}.pdf`

      };

    }



    return {

      exists: false,

      studentName: studentData.FullName,

      regId: registrationId,

      docTitle: meta.title

    };

  } catch (err) {

    Logger.log("checkExistingDocumentStatus error: " + err);

    return { exists: false, error: err.toString() };

  }

}



/**

 * Automatically cleans up old or stale preview PDF files in Google Drive.

 * Prevents PREVIEW_ files from cluttering the Drive folder.

 */

function cleanStalePreviewFiles_(folder, registrationId) {

  try {

    if (!folder) return;

    const files = folder.getFiles();

    const now = Date.now();

    const maxAge = 10 * 60 * 1000; // 10 minutes

    const targetReg = registrationId ? String(registrationId).trim().toUpperCase() : '';



    while (files.hasNext()) {

      const file = files.next();

      const fname = file.getName();

      if (fname.startsWith('PREVIEW_') || fname.startsWith('preview_')) {

        const fileAge = now - file.getLastUpdated().getTime();

        if (fileAge > maxAge || (targetReg && fname.toUpperCase().includes(targetReg))) {

          try {

            file.setTrashed(true);

            Logger.log(`Auto-deleted stale preview file: ${file.getId()} (${fname})`);

          } catch(e) {}

        }

      }

    }

  } catch(err) {

    Logger.log('cleanStalePreviewFiles_ warning: ' + err.toString());

  }

}



/**

 * Server endpoint to auto-delete a temporary preview file in Google Drive

 * when the admin closes the preview modal or finishes reviewing.

 */


/**
 * Resolves or creates the dedicated Google Drive folder for temporary Preview documents.
 */
function getOrCreatePreviewFolder() {
  try {
    return getSystemFolder('preview');
  } catch(e) {
    Logger.log("getOrCreatePreviewFolder fallback: " + e.toString());
    const folders = DriveApp.getFoldersByName('GSV_Preview_Documents');
    if (folders.hasNext()) return folders.next();
    const nf = DriveApp.createFolder('GSV_Preview_Documents');
    try { nf.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch(err){}
    return nf;
  }
}

/**
 * Appends a preview record to the Preview_Documents sheet.
 */
function logPreviewDocumentRecord(regId, docType, candidateName, fileId, previewUrl, certNumber) {
  try {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    let pSheet = ss.getSheetByName(SHEET_NAMES.PREVIEW_DOCUMENTS);
    if (!pSheet) {
      pSheet = ss.insertSheet(SHEET_NAMES.PREVIEW_DOCUMENTS);
      pSheet.appendRow(["Timestamp", "RegistrationID", "DocType", "CandidateName", "FileID", "PreviewURL", "Status", "TemporaryCertNumber"]);
      pSheet.setFrozenRows(1);
    }
    pSheet.appendRow([new Date(), regId || '', docType || '', candidateName || '', fileId || '', previewUrl || '', 'Preview Active', certNumber || '']);
  } catch(e) {
    Logger.log("logPreviewDocumentRecord error: " + e.toString());
  }
}

/**
 * Completely wipes all files in the Preview folder and clears the Preview_Documents sheet.
 */
function cleanupAllPreviewData() {
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(20000);
    const pFolder = getOrCreatePreviewFolder();
    let fileCount = 0;
    if (pFolder) {
      const files = pFolder.getFiles();
      while (files.hasNext()) {
        const f = files.next();
        try {
          f.setTrashed(true);
          fileCount++;
        } catch(e) {
          Logger.log("Failed to trash preview file: " + e.toString());
        }
      }
    }

    // Clear Preview_Documents sheet
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const pSheet = ss.getSheetByName(SHEET_NAMES.PREVIEW_DOCUMENTS);
    if (pSheet && pSheet.getLastRow() > 1) {
      pSheet.getRange(2, 1, pSheet.getLastRow() - 1, pSheet.getLastColumn()).clearContent();
    }

    logActivity('Preview Data Purged', 'Admin', `Successfully purged ${fileCount} preview files from Drive and cleared preview logs.`);
    return { status: 'success', message: `Purged ${fileCount} preview document(s) from Drive and cleared all preview logs.` };
  } catch(err) {
    Logger.log('cleanupAllPreviewData error: ' + err.toString());
    return { status: 'error', message: err.toString() };
  } finally {
    lock.releaseLock();
  }
}

/**
 * Discards an individual preview document file and removes its log entry.
 */
function discardPreviewDocument(fileId, regId, docType) {
  try {
    let trashed = false;
    if (fileId) {
      try {
        const f = DriveApp.getFileById(fileId);
        if (f) {
          f.setTrashed(true);
          trashed = true;
        }
      } catch(e) {}
    }

    // Remove row from Preview_Documents sheet
    if (regId || fileId) {
      try {
        const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
        const pSheet = ss.getSheetByName(SHEET_NAMES.PREVIEW_DOCUMENTS);
        if (pSheet && pSheet.getLastRow() > 1) {
          const data = pSheet.getDataRange().getValues();
          for (let i = data.length - 1; i >= 1; i--) {
            const rowFileId = String(data[i][4] || '').trim();
            const rowRegId = String(data[i][1] || '').trim().toUpperCase();
            if ((fileId && rowFileId === String(fileId).trim()) || (regId && rowRegId === String(regId).trim().toUpperCase())) {
              pSheet.deleteRow(i + 1);
            }
          }
        }
      } catch(e) {}
    }

    return { status: 'success', message: 'Preview file discarded cleanly.' };
  } catch(err) {
    return { status: 'error', message: err.toString() };
  }
}


function deletePreviewFile(fileId) {

  try {

    if (!fileId) return { status: 'error', message: 'No fileId provided' };

    const f = DriveApp.getFileById(fileId);

    if (f) {

      const name = f.getName();

      // Safety check: ensure we only delete files starting with PREVIEW_

      if (name.startsWith('PREVIEW_') || name.startsWith('preview_')) {

        f.setTrashed(true);

        Logger.log(`Successfully trashed preview file: ${fileId} (${name})`);

        return { status: 'success', message: 'Preview file deleted.' };

      }

    }

  } catch(e) {

    Logger.log('deletePreviewFile error: ' + e.toString());

  }

  return { status: 'error', message: 'Could not delete preview file' };

}



/**

 * Generates an interactive document and email preview for admin verification before official dispatch.

 * Does not commit permanent files to FileManager/GeneratedDocuments, and does not send emails.

 */

function previewDocumentForAdmin(docType, registrationId, options) {

  try {

    options = options || {};

    options.isPreview = true;



    const studentData = getStudentDataForDoc(registrationId);

    if (!studentData) {

      return { status: 'error', message: `Student with ID ${registrationId} not found.` };

    }



    const docTypeMeta = {

      'attendanceDocument': { title: 'Attendance (Form-4)', icon: 'fas fa-clipboard-check', order: 1 },

      'consolidatedAttendance': { title: 'Attendance (Form-4)', icon: 'fas fa-clipboard-check', order: 1 },

      'studentDiary': { title: 'Student Diary (Form-5)', icon: 'fas fa-book-open', order: 2 },

      'internshipCertificate': { title: 'Completion Certificate (T1/T2)', icon: 'fas fa-award', order: 3 },

      'completionCertificate': { title: 'Completion Certificate (T1/T2)', icon: 'fas fa-award', order: 3 },

      'applicationForm': { title: 'Application Form', icon: 'fas fa-file-alt', order: 4 },

      'studentAppForm': { title: 'Application Form', icon: 'fas fa-file-alt', order: 4 },

      'projectCompletion': { title: 'Project Report', icon: 'fas fa-project-diagram', order: 5 },

      'studentCV': { title: 'Student Portfolio (CV)', icon: 'fas fa-id-card-alt', order: 6 },

      'studentPortfolio': { title: 'Student Portfolio (CV)', icon: 'fas fa-id-card-alt', order: 6 },

      'offerLetter': { title: 'Official Offer Letter', icon: 'fas fa-envelope-open-text', order: 7 },

      'joiningLetter': { title: 'Joining Letter', icon: 'fas fa-file-signature', order: 8 },

      'entryPass': { title: 'Internship Entry Pass', icon: 'fas fa-id-badge', order: 9 },

      'idCard': { title: 'Digital ID Card', icon: 'fas fa-address-card', order: 10 }

    };



    // Helper to generate preview for any single doc

    function generateSinglePreview(dType) {

      try {

        const isExistingRequested = (options.viewExisting === true) || (options.docVersions && options.docVersions[dType] === 'existing');

        if (isExistingRequested) {

          const existing = getExistingGeneratedDocRecord_(registrationId, dType);

          if (existing && (existing.driveLink || existing.fileId)) {

            existing.studentName = studentData.FullName;

            existing.regId = registrationId;

            existing.batch = studentData.Batch;

            existing.college = studentData.CollegeName;

            existing.docType = dType;

            existing.recipientEmail = studentData.GmailID;

            existing.emailSubject = `Official Document: ${dType} - ${studentData.FullName} | ${studentData.CompanyName}`;

            existing.emailBody = getProfessionalEmailBody(dType === 'internshipCertificate' ? 'completion' : 'confirmation', studentData, existing.driveLink);

            return existing;

          }

        }

        const docOpts = Object.assign({}, options);

        docOpts.forceNew = !isExistingRequested;

        if (dType === 'attendanceDocument' || dType === 'consolidatedAttendance') {

          return generateConsolidatedAttendancePDF(registrationId);

        } else if (dType === 'studentDiary') {

          return generateStudentDiaryPDF_V2({ regId: registrationId, mode: 'consolidated', orientation: 'portrait' });

        } else if (dType === 'idCard' || dType === 'digitalIdCard') {

          return generateDigitalIdCardPdf(registrationId, { isPreview: true });

        } else {

          return generateDocumentAndMail(dType, registrationId, false, true, docOpts);

        }

      } catch (err) {

        Logger.log(`Error generating preview for ${dType}: ${err}`);

        return { status: 'error', message: err.toString() };

      }

    }



    // MULTI-DOCUMENT BUNDLE PREVIEW

    if (docType === 'studentAllDocuments') {

      const selectedTypes = options.selectedBundleTypes || options.bundleTypes || ['attendanceDocument', 'studentDiary', 'internshipCertificate', 'applicationForm', 'projectCompletion', 'studentCV', 'offerLetter'];

      const documents = [];



      // Sort by defined standard bundle order (Attendance -> Diary -> Certificate -> Application -> Project -> Portfolio -> Offer)

      const sortedTypes = Array.from(new Set(selectedTypes)).sort((a, b) => {

        const orderA = docTypeMeta[a] ? docTypeMeta[a].order : 99;

        const orderB = docTypeMeta[b] ? docTypeMeta[b].order : 99;

        return orderA - orderB;

      });



      for (let i = 0; i < sortedTypes.length; i++) {

        const t = sortedTypes[i];

        const res = generateSinglePreview(t);

        const meta = docTypeMeta[t] || { title: t, icon: 'fas fa-file-alt' };

        if (res && res.status === 'success') {

          documents.push({

            type: t,

            title: meta.title,

            icon: meta.icon,

            url: res.driveLink || res.url,

            fileId: res.fileId || '',

            pdfBase64: res.pdfBase64 || '',

            isPreview: !res.isExisting,

            certNumber: res.certNumber || '',

            attendedDays: res.attendedDays || ''

          });

        } else {

          documents.push({

            type: t,

            title: meta.title,

            icon: meta.icon,

            url: '',

            error: res ? res.message : 'Generation failed',

            status: 'error'

          });

        }

      }



      const emailSubject = `🎓 Complete Internship Documents Bundle — ${studentData.FullName} | ${studentData.CompanyName || COMPANY_NAME}`;

      const emailBody = `

        <div style="font-family: 'Segoe UI', Arial, sans-serif; max-width: 680px; margin: 0 auto; background: #ffffff; border-radius: 14px; overflow: hidden; border: 1px solid #cbd5e1; box-shadow: 0 10px 30px rgba(0,0,0,0.08);">

          <div style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); padding: 30px 24px; text-align: center; color: #ffffff;">

            <div style="font-size: 40px; margin-bottom: 8px;">📦</div>

            <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: 0.5px;">Complete Internship Documents Bundle</h2>

            <p style="margin: 6px 0 0 0; font-size: 14px; opacity: 0.9;">Official Verified Student Records — ${studentData.CompanyName || COMPANY_NAME}</p>

          </div>

          <div style="padding: 28px 24px; color: #1e293b; line-height: 1.6;">

            <p style="font-size: 16px; margin: 0 0 14px 0;">Dear <strong>${studentData.FullName}</strong>,</p>

            <p style="font-size: 14px; color: #334155; margin-bottom: 18px;">

              We are pleased to provide your verified, official Internship Document Bundle for Registration ID <strong style="color: #2563eb;">${studentData.RegistrationID}</strong>. All requested documents have been generated and attached below.

            </p>

            <div style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 10px; padding: 16px; margin-bottom: 20px;">

              <div style="font-weight: 700; font-size: 13px; color: #0f172a; margin-bottom: 10px;">📋 Attached Document Checklist:</div>

              <ul style="margin: 0; padding-left: 20px; font-size: 13px; color: #334155; line-height: 1.8;">

                ${documents.map(d => `<li><strong>${d.title}</strong>${d.url ? ` — <a href="${d.url}" target="_blank" style="color:#2563eb; font-weight:600;">View Verified PDF</a>` : ''}</li>`).join('')}

              </ul>

            </div>

            <p style="font-size: 13px; color: #64748b; margin-bottom: 22px;">

              These documents are tamper-evident and can also be downloaded at any time directly through your Student Portal dashboard.

            </p>

            <div style="text-align: center; margin: 24px 0;">

              <a href="${typeof PORTAL_URL !== 'undefined' ? PORTAL_URL : 'https://script.google.com'}" style="display: inline-block; background: #2563eb; color: #ffffff; padding: 12px 28px; border-radius: 8px; font-weight: 700; text-decoration: none; font-size: 14px; box-shadow: 0 4px 12px rgba(37,99,235,0.25);">

                Access Student Portal ↗

              </a>

            </div>

          </div>

          <div style="background: #f1f5f9; padding: 14px 24px; text-align: center; font-size: 12px; color: #64748b; border-top: 1px solid #e2e8f0;">

            ${studentData.CompanyName || COMPANY_NAME} · Automated Academic Document Management System

          </div>

        </div>

      `;



      return {

        status: 'success',

        isBundle: true,

        documents: documents,

        activeDocumentIndex: 0,

        previewUrl: documents.length > 0 && documents[0].url ? documents[0].url : '',

        pdfBlobUrl: documents.length > 0 && documents[0].url ? documents[0].url : '',

        pdfBase64: documents.length > 0 && documents[0].pdfBase64 ? documents[0].pdfBase64 : '',

        recipientEmail: studentData.GmailID || '',

        studentName: studentData.FullName || '',

        regId: registrationId,

        batch: studentData.Batch || 'N/A',

        college: studentData.CollegeName || 'N/A',

        department: studentData.Department || 'N/A',

        docType: 'studentAllDocuments',

        emailSubject: emailSubject,

        emailBody: emailBody,

        options: options

      };

    }



    // SINGLE DOCUMENT PREVIEW

    const res = generateSinglePreview(docType);

    if (!res || res.status !== 'success') {

      return res || { status: 'error', message: `Failed to generate preview for ${docType}.` };

    }



    const meta = docTypeMeta[docType] || { title: docType, icon: 'fas fa-file-alt' };

    const singleDocs = [{

      type: docType,

      title: meta.title,

      icon: meta.icon,

      url: res.driveLink || res.url,

      fileId: res.fileId || '',

      pdfBase64: res.pdfBase64 || '',

      isPreview: !res.isExisting,

      certNumber: res.certNumber || '',

      attendedDays: res.attendedDays || ''

    }];



    let emailSubject = `Document: ${meta.title} - ${studentData.CompanyName || COMPANY_NAME}`;

    let emailBody = '';



    const isCertificate = (docType === 'internshipCertificate' || docType === 'completionCertificate');

    if (isCertificate) {

      emailSubject = `🎓 Official Internship Completion Certificate & Career Wishes - ${studentData.FullName} | ${studentData.CompanyName || COMPANY_NAME}`;

      emailBody = getGrandCertificateEmailBody(studentData, res.certNumber, res.driveLink || res.url, res.attendedDays);

    } else if (docType === 'applicationForm') {

      emailSubject = `📄 Official Internship Application Form & Onboarding Guidelines - ${studentData.FullName} | ${studentData.CompanyName || COMPANY_NAME}`;

      emailBody = getGrandApplicationFormEmailBody(studentData, res.driveLink || res.url, options.customDocDate);

    } else if (docType === 'offerLetter') {

      emailSubject = `🎉 Official Internship Offer Letter - ${studentData.FullName} | ${studentData.CompanyName || COMPANY_NAME}`;

      emailBody = getGrandOfferLetterEmailBody(studentData, res.driveLink || res.url);

    } else if (docType === 'joiningLetter') {

      emailSubject = `🏢 Official Internship Joining & Induction Letter - ${studentData.FullName} | ${studentData.CompanyName || COMPANY_NAME}`;

      emailBody = getGrandJoiningLetterEmailBody(studentData, res.driveLink || res.url);

    } else if (docType === 'attendanceDocument' || docType === 'consolidatedAttendance') {

      emailSubject = `📋 Official Consolidated Attendance Record (Form-4) - ${studentData.FullName} | ${studentData.CompanyName || COMPANY_NAME}`;

      emailBody = getGrandAttendanceEmailBody(studentData, res.driveLink || res.url, { attendedDays: res.attendedDays || studentData.DurationDays, durationDays: studentData.DurationDays });

    } else if (docType === 'studentDiary') {

      emailSubject = `📖 Official Internship Work Diary & Learning Log - ${studentData.FullName} | ${studentData.CompanyName || COMPANY_NAME}`;

      emailBody = getGrandDiaryEmailBody(studentData, res.driveLink || res.url);

    } else {

      let emailType = 'confirmationLetter';

      const templates = getEmailTemplates();

      if (templates && templates[emailType]) {

        emailSubject = templates[emailType].subject;

        emailBody = templates[emailType].content;

        const emailReplacements = {

          '{{StudentName}}': studentData.FullName,

          '{{FullName}}': studentData.FullName,

          '{{RegistrationID}}': studentData.RegistrationID,

          '{{InternshipStartDate}}': studentData.FormattedStartDate,

          '{{InternshipEndDate}}': studentData.FormattedEndDate,

          '{{DurationDays}}': studentData.DurationDays,

          '{{CompanyName}}': studentData.CompanyName,

          '{{CollegeName}}': studentData.CollegeName,

          '{{Department}}': studentData.Department,

          '{{CertificateNumber}}': res.certNumber || '',

          '{{IssuedDate}}': studentData.TodayDate,

          '{{AttendedDays}}': res.attendedDays || studentData.DurationDays,

          '{StudentName}': studentData.FullName,

          '{FullName}': studentData.FullName,

          '{RegistrationID}': studentData.RegistrationID,

          '{CertificateNumber}': res.certNumber || '',

          '{AttendedDays}': res.attendedDays || studentData.DurationDays

        };

        for (const key in emailReplacements) {

          const val = emailReplacements[key] || '';

          emailBody = emailBody.replace(new RegExp(key.replace(/[{}]/g, '\\$&'), 'g'), val);

          emailSubject = emailSubject.replace(new RegExp(key.replace(/[{}]/g, '\\$&'), 'g'), val);

        }

        emailBody = emailBody.replace(/href="#"/g, `href="${res.driveLink || res.url}"`).replace(/href='#'/g, `href="${res.driveLink || res.url}"`);

      } else {

        emailBody = getProfessionalEmailBody('confirmation', studentData, res.driveLink || res.url);

      }

    }



    const candCategoryVal = getCandidateCategory_(studentData);

    return {

      status: 'success',

      isBundle: false,

      documents: singleDocs,

      candidateCategory: candCategoryVal,

      candidateType: candCategoryVal,

      activeDocumentIndex: 0,

      previewUrl: res.driveLink || res.url,

      pdfBlobUrl: res.driveLink || res.url,

      pdfBase64: res.pdfBase64 || '',

      fileId: res.fileId,

      isPreview: !res.isExisting,

      emailSubject: emailSubject,

      emailBody: emailBody,

      recipientEmail: studentData.GmailID || '',

      studentName: studentData.FullName || '',

      regId: registrationId,

      batch: studentData.Batch || 'N/A',

      college: studentData.CollegeName || 'N/A',

      department: studentData.Department || 'N/A',

      docType: docType,

      certNumber: res.certNumber || '',

      attendedDays: res.attendedDays || '',

      isExisting: !!res.isExisting,

      existingGeneratedDate: res.dateGenerated || '',

      isExistingCert: !!res.isExistingCert,

      options: options

    };

  } catch (err) {

    Logger.log('previewDocumentForAdmin error: ' + err.toString());

    return { status: 'error', message: 'Preview generation error: ' + err.toString() };

  }

}



function getSecurePdfBase64(fileUrl) {

  try {

    const match = fileUrl.match(/[-\w]{25,}/);

    if (!match) return null;

    const fileId = match[0];

    const file = DriveApp.getFileById(fileId);

    const bytes = file.getBlob().getBytes();

    return Utilities.base64Encode(bytes);

  } catch (e) {

    return null;

  }

}



/**

 * Builds a standardized, elegant HTML table with full student & internship details.

 */

function buildStudentDetailsEmailTable_(studentData) {
  const regId = studentData.RegistrationID || studentData.registrationId || studentData.regId || 'N/A';
  const name = studentData.FullName || studentData.StudentName || studentData.name || 'Student';
  const mobile = studentData.MobileNumber || studentData.mobile || studentData.Phone || 'N/A';
  const email = studentData.GmailID || studentData.email || studentData.Email || 'N/A';
  const college = studentData.CollegeName || studentData.college || 'N/A';
  const dept = studentData.Department || studentData.department || 'N/A';
  const year = studentData.Year || studentData.year || studentData.Semester || 'Final Year';
  const rawRegisterNo = studentData.RegisterNumber || studentData.registerNo || studentData.CollegeRegisterNo || 'N/A';

  const candType = String(studentData.InternshipType || studentData.CandidateType || (college && String(college).toLowerCase().includes('apprentice') ? 'Apprentice' : (college && String(college).toLowerCase().includes('faculty') ? 'Faculty' : 'Student'))).toLowerCase();

  let recTitle = '📋 Official Student &amp; Internship Record';
  let nameLabel = '👤 Student Name';
  let orgLabel = '🏫 College / University';
  let idLabel = '🎓 University Register No';
  let deptLabel = '🏛️ Department &amp; Year';
  let orgVal = college;
  let idVal = rawRegisterNo;

  if (candType.includes('faculty')) {
    recTitle = '📋 Official Faculty &amp; Internship Record';
    nameLabel = '👤 Faculty Name';
    orgLabel = '🏛️ College / Institution';
    idLabel = '🎓 Faculty Staff ID';
    idVal = studentData.FacultyStaffId || studentData.StaffId || studentData.RegisterNumber || rawRegisterNo;
    deptLabel = '📚 Department &amp; Specialization';
  } else if (candType.includes('employee')) {
    recTitle = '🏢 Official Corporate Employee Record';
    nameLabel = '👤 Professional Name';
    orgLabel = '🏢 Company / Enterprise';
    orgVal = studentData.CompanyName || studentData.Company || college;
    idLabel = '🆔 Employee ID Number';
    idVal = studentData.EmployeeId || studentData.companyEmployeeId || rawRegisterNo;
    deptLabel = '💼 Designation &amp; Scope';
  } else if (candType.includes('apprentice')) {
    recTitle = '🔧 Official Apprenticeship Record';
    nameLabel = '👤 Apprentice Trainee Name';
    orgLabel = '🛠️ Training Program';
    orgVal = 'GSV Industrial Apprenticeship';
    idLabel = '🆔 Apprentice ID';
    idVal = studentData.ApprenticeID || studentData.apprenticeID || rawRegisterNo;
    deptLabel = '🔧 Practical Tracks';
  }

  const skill = studentData.SkillLearned || studentData.InterestedArea || studentData.Track || studentData.WorkArea || '';
  const duration = studentData.DurationDays || studentData.duration || 30;
  const startEnd = (studentData.FormattedStartDate && studentData.FormattedEndDate) 
    ? `${studentData.FormattedStartDate} to ${studentData.FormattedEndDate}` 
    : (studentData.InternshipStartDate ? `${formatDateDMY(studentData.InternshipStartDate)} to ${formatDateDMY(studentData.InternshipEndDate)}` : 'As per curriculum schedule');

  return `
  <div style="background: #f8fafc; border-radius: 12px; padding: 18px 20px; margin: 20px 0; border: 1.5px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
    <div style="font-weight: 800; font-size: 13.5px; color: #0f172a; margin-bottom: 12px; display: flex; align-items: center; gap: 6px; text-transform: uppercase; letter-spacing: 0.5px;">
      ${recTitle}
    </div>
    <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 6px 0; color: #64748b; font-weight: 600; width: 42%;">${nameLabel}</td>
        <td style="padding: 6px 0; color: #0f172a; font-weight: 700; text-align: right;">${name}</td>
      </tr>
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 6px 0; color: #64748b; font-weight: 600;">🆔 Registration ID</td>
        <td style="padding: 6px 0; color: #2563eb; font-weight: 700; text-align: right; font-family: monospace; font-size: 13.5px;">${regId}</td>
      </tr>
      ${idVal && idVal !== 'N/A' ? `
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 6px 0; color: #64748b; font-weight: 600;">${idLabel}</td>
        <td style="padding: 6px 0; color: #334155; font-weight: 600; text-align: right; font-family: monospace;">${idVal}</td>
      </tr>` : ''}
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 6px 0; color: #64748b; font-weight: 600;">${orgLabel}</td>
        <td style="padding: 6px 0; color: #334155; font-weight: 600; text-align: right;">${orgVal}</td>
      </tr>
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 6px 0; color: #64748b; font-weight: 600;">${deptLabel}</td>
        <td style="padding: 6px 0; color: #334155; font-weight: 600; text-align: right;">${dept} ${candType.includes('faculty') ? '' : `(${year})`}</td>
      </tr>
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 6px 0; color: #64748b; font-weight: 600;">💡 Project / Skill Domain</td>
        <td style="padding: 6px 0; color: #059669; font-weight: 700; text-align: right;">${skill}</td>
      </tr>
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 6px 0; color: #64748b; font-weight: 600;">📅 Internship Tenure</td>
        <td style="padding: 6px 0; color: #0f172a; font-weight: 600; text-align: right;">${duration} Days (${startEnd})</td>
      </tr>
      <tr style="border-bottom: 1px solid #e2e8f0;">
        <td style="padding: 6px 0; color: #64748b; font-weight: 600;">📞 Contact Mobile</td>
        <td style="padding: 6px 0; color: #334155; text-align: right;">${mobile}</td>
      </tr>
      <tr>
        <td style="padding: 6px 0; color: #64748b; font-weight: 600;">✉️ Email Address</td>
        <td style="padding: 6px 0; color: #2563eb; text-align: right;">${email}</td>
      </tr>
    </table>
  </div>`;
}

function getGrandApplicationFormEmailBody(studentData, driveLink, customDocDate) {
  const studentName = studentData.FullName || studentData.StudentName || studentData.name || 'Student';
  const portalUrl = 'https://www.gsvee.in/gsv-internship-portal';
  const candType = (typeof getCandidateCategory_ === 'function') 
    ? getCandidateCategory_(studentData)
    : String(studentData.InternshipType || studentData.CandidateType || '').toLowerCase();

  let badgeText = '📝 Official Internship Admission Approval';
  let roleGreeting = `Dear <strong style="color: #1d4ed8; font-size: 20px;">${studentName}</strong>,`;
  let portalBtnText = '🚀 Open Student Portal';
  let declarationInstruction = 'Paste your recent passport size color photograph in the designated photo box and place your signature along with your Parent/Guardian\'s signature on Form-2 (Self Declaration).';

  if (candType === 'Faculty' || String(candType).includes('faculty')) {
    badgeText = '🎓 Official Faculty Internship Admission';
    roleGreeting = `Dear Faculty Trainee <strong style="color: #1d4ed8; font-size: 20px;">${studentName}</strong>,`;
    portalBtnText = '🚀 Access Faculty Portal';
    declarationInstruction = 'Paste your recent passport size color photograph in the designated photo box and place your signature on Form-2 (Faculty Declaration Undertaking).';
  } else if (candType === 'Employee' || String(candType).includes('employee')) {
    badgeText = '💼 Official Corporate Upskilling Admission';
    roleGreeting = `Dear Corporate Professional <strong style="color: #1d4ed8; font-size: 20px;">${studentName}</strong>,`;
    portalBtnText = '🚀 Access Corporate Portal';
    declarationInstruction = 'Paste your recent passport size color photograph in the designated photo box and place your signature on Form-2 (Corporate Employee Professional Undertaking).';
  } else if (candType === 'Apprentice' || String(candType).includes('apprentice')) {
    badgeText = '🔧 Official Industrial Apprenticeship Admission';
    roleGreeting = `Dear Apprentice Trainee <strong style="color: #1d4ed8; font-size: 20px;">${studentName}</strong>,`;
    portalBtnText = '🚀 Access Apprentice Portal';
    declarationInstruction = 'Paste your recent passport size color photograph in the designated photo box and place your signature on Form-2 (Industrial Apprenticeship Undertaking).';
  }

  return `
  <div style="font-family: 'Segoe UI', Arial, sans-serif; max-width: 680px; margin: 0 auto; background: #ffffff; border-radius: 18px; overflow: hidden; box-shadow: 0 12px 40px rgba(0,0,0,0.12); border: 1px solid #bfdbfe;">
    <!-- BLUE / INDIGO HEADER -->
    <div style="background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 50%, #3b82f6 100%); padding: 34px 28px 26px 28px; text-align: center; color: #ffffff;">
      <div style="margin-bottom: 14px;">
        <img src="cid:gsvLogo" alt="${COMPANY_NAME}" style="max-height: 50px; max-width: 280px; height: auto; display: inline-block;" />
      </div>
      <div style="font-size: 42px; margin-bottom: 10px; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.25));">📄</div>
      <div style="display: inline-block; background: rgba(255,255,255,0.22); color: #ffffff; padding: 5px 18px; border-radius: 30px; font-size: 12px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 10px; border: 1px solid rgba(255,255,255,0.35);">
        ${badgeText}
      </div>
      <h1 style="color: #ffffff; font-size: 25px; font-weight: 800; margin: 0 0 6px 0; letter-spacing: 0.5px; font-family: 'Georgia', serif;">
        Application Approved &amp; Document Kit
      </h1>
      <div style="font-size: 14px; color: #bfdbfe; font-weight: 600;">
        ${COMPANY_NAME}
      </div>
    </div>

    <!-- MAIN BODY -->
    <div style="position: relative; padding: 36px 32px 28px 32px; background: #ffffff; color: #1e293b; line-height: 1.7;">
      <!-- Centered Faint Watermark embedded in UI -->
      <div style="height: 0; overflow: visible; text-align: center; opacity: 0.12; pointer-events: none;">
        <img src="cid:gsvWatermark" alt="" style="width: 270px; max-width: 75%; height: auto; display: inline-block; margin-top: 50px;" />
      </div>
      <div style="position: relative; z-index: 2;">
      <p style="font-size: 18px; margin: 0 0 16px 0; color: #0f172a;">
        ${roleGreeting}
      </p>

      <div style="background: #eff6ff; border-left: 5px solid #3b82f6; padding: 16px 20px; border-radius: 0 12px 12px 0; margin-bottom: 24px; font-size: 15px; color: #1e40af;">
        🎉 <strong>Your internship admission has been successfully processed and approved!</strong> Please review the complete official record below and follow the mandatory submission and onboarding guidelines.
      </div>

      <!-- CANDIDATE DETAILS CARD -->
      ${buildStudentDetailsEmailTable_(studentData)}

      <!-- MANDATORY ONBOARDING & SUBMISSION INSTRUCTIONS -->
      <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 12px; padding: 20px 22px; margin-bottom: 24px;">
        <h4 style="margin: 0 0 12px 0; font-size: 14.5px; color: #0f172a; text-transform: uppercase; letter-spacing: 0.6px; font-weight: 800;">
          📌 Mandatory Onboarding Checklist &amp; Submission Steps:
        </h4>
        <ol style="margin: 0; padding-left: 20px; font-size: 13.5px; color: #334155; line-height: 1.8;">
          <li><strong>Print Official Application Form (PDF):</strong> Download and print a clean hard copy of the attached official Application Form kit (Form-1 to Form-3).</li>
          <li><strong>Affix Photograph &amp; Sign:</strong> ${declarationInstruction}</li>
          <li><strong>Attach Required Documents:</strong> Carry self-attested photocopies of your <strong>Identity Card</strong> and <strong>Institutional Bonafide Certificate</strong>.</li>
          <li><strong>Pre-Internship Office Visit:</strong> Before commencing your internship tenure, you must visit the GSV Electrical Enterprises administrative office in person to familiarize yourself with the facility environment and complete physical record verification.</li>
        </ol>
      </div>

      <!-- STRICT DISCIPLINARY & ATTENDANCE POLICY (WARNING BOX) -->
      <div style="background: #fef2f2; border: 1.5px solid #fecaca; border-radius: 12px; padding: 18px 20px; margin-bottom: 24px; color: #991b1b;">
        <div style="font-weight: 800; font-size: 14px; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
          ⚠️ <strong>Strict Internship Disciplinary &amp; Attendance Policy:</strong>
        </div>
        <ul style="margin: 0; padding-left: 20px; font-size: 13px; line-height: 1.7;">
          <li><strong>Zero Break / Leave Policy:</strong> Once your internship training commences, no leaves or breaks will be entertained under any circumstances without an official recommendation letter signed by your College Principal / Head of Department.</li>
          <li><strong>Incomplete Work &amp; Inactive Status:</strong> Candidates failing to complete assigned tasks or exhibiting unexcused absence will be placed in <strong>'Inactive' status</strong>, leading to cancellation of training credits and withholding of completion credentials.</li>
          <li><strong>Discontinuation Penalty &amp; Blacklisting:</strong> Unauthorized discontinuation midway through the internship tenure is strictly prohibited. Violations will result in recovery of training expenses and blacklisting from future industrial placement drives.</li>
        </ul>
      </div>

      <!-- CTA BUTTONS -->
      <div style="text-align: center; margin: 28px 0 12px 0;">
        ${driveLink ? `
        <a href="${driveLink}" style="display: inline-block; background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%); color: #ffffff; padding: 14px 34px; text-decoration: none; border-radius: 50px; font-weight: 700; font-size: 15px; box-shadow: 0 4px 16px rgba(59, 130, 246, 0.35); margin-right: 10px; margin-bottom: 8px;">
          📥 Download Official Application Form (PDF)
        </a>` : ''}
        <a href="${portalUrl}" style="display: inline-block; background: #0f172a; color: #ffffff; padding: 14px 28px; text-decoration: none; border-radius: 50px; font-weight: 700; font-size: 14px; margin-bottom: 8px;">
          ${portalBtnText}
        </a>
      </div>
      </div>
    </div>

    <!-- FOOTER -->
    <div style="background: #1e3a8a; padding: 24px 30px; text-align: center; color: #bfdbfe;">
      <div style="font-size: 15px; font-weight: 800; color: #ffffff; margin-bottom: 4px;">⚡ ${COMPANY_NAME}</div>
      <div style="font-size: 12px; color: #93c5fd; margin-bottom: 12px;">Satisfaction is our Achievement</div>
      <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; font-size: 12px;">
        <span>📞 ${COMPANY_CONTACT}</span>
        <span>🌐 <a href="https://www.${COMPANY_WEBSITE}" style="color: #ffffff; text-decoration: underline;">${COMPANY_WEBSITE}</a></span>
        <span>📧 ${ADMIN_EMAIL_ID}</span>
      </div>
      <div style="margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.15); font-size: 11px; color: #93c5fd;">
        © ${new Date().getFullYear()} ${COMPANY_NAME}. All Rights Reserved. Official Digital Credential Notification.
      </div>
    </div>
  </div>`;
}

