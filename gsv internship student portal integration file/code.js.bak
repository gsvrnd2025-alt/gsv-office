// ══════════════════════════════════════════════════════════════════════

// OFFICIAL COMPANY SEAL & AUTHORIZED SIGNATURE (DEFAULT ASSETS & MANAGEMENT)

// ══════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════

// OFFICIAL GSV Electrical Enterprises LOGO ASSETS (FULL HORIZONTAL LOGO & SHIELD LOGO)

// ══════════════════════════════════════════════════════════════════════

const GSV_FULL_LOGO_B64 = "";

const GSV_SHIELD_LOGO_B64 = "";



/**

 * Returns the GSV Electrical Enterprises Full Logo (with title, tagline & GSV product credit) as Blob.

 * Used for Document headers, Reports, and Email branding.

 */


const STUDENT_SAMPLE_PHOTO_B64 = "";
const FACULTY_SAMPLE_PHOTO_B64 = STUDENT_SAMPLE_PHOTO_B64;

function getGsvFullLogoBlob() {

  try {

    const bytes = Utilities.base64Decode(GSV_FULL_LOGO_B64);

    return Utilities.newBlob(bytes, 'image/png', 'gsv_full_logo.png');

  } catch (e) {

    Logger.log("getGsvFullLogoBlob error: " + e.toString());

    return null;

  }

}



/**

 * Returns the GSV Electrical Enterprises Shield Logo as Blob.

 * Used strictly for Watermarks, compact badges, and official seals.

 */

const GSV_FAINT_WATERMARK_B64 = "";



function getGsvWatermarkBlob() {

  try {

    const bytes = Utilities.base64Decode(GSV_FAINT_WATERMARK_B64);

    return Utilities.newBlob(bytes, 'image/png', 'gsv_watermark.png');

  } catch (e) {

    Logger.log("getGsvWatermarkBlob error: " + e.toString());

    return null;

  }

}



function getGsvShieldWatermarkBlob() {

  return getGsvWatermarkBlob();

}



function applyApplicationFormWatermark_(doc, body, wLogs = []) {
  if (!doc || !body) { wLogs.push('no doc or body'); return; }
  try {
    const watermarkBlob = getGsvWatermarkBlob();
    if (!watermarkBlob) { wLogs.push('no watermark blob'); return; }

    // 1. Remove all existing positioned watermarks from all paragraphs except p0 (which holds photo and seal)
    const allParas = body.getParagraphs();
    for (let i = 0; i < allParas.length; i++) {
      if (i === 0) continue; // NEVER wipe p0 photo or seal!
      const p = allParas[i];
      try {
        const pImgs = p.getPositionedImages();
        for (let j = pImgs.length - 1; j >= 0; j--) {
          const img = pImgs[j];
          if (img.getWidth() === 340 && img.getHeight() === 187) {
            p.removePositionedImage(img.getId());
          }
        }
      } catch(e) {}
    }

    // Helper to add positioned watermark image centered on A4 page (340pt x 187pt)
    const addCenteredWatermark_ = (para, topOffset, label = '') => {
      if (!para) { wLogs.push(label + ': para is null'); return; }
      try {
        let pEl = para;
        if (pEl.getType() !== DocumentApp.ElementType.PARAGRAPH) {
          if (pEl.getType() === DocumentApp.ElementType.TABLE) {
            const tbl = pEl.asTable();
            if (tbl.getNumRows() > 0 && tbl.getRow(0).getNumCells() > 0 && tbl.getRow(0).getCell(0).getNumChildren() > 0) {
              pEl = tbl.getRow(0).getCell(0).getChild(0);
            }
          }
        }
        if (!pEl || pEl.getType() !== DocumentApp.ElementType.PARAGRAPH) {
          wLogs.push(label + ': pEl not paragraph, type=' + (pEl ? pEl.getType() : 'null'));
          return;
        }
        const p = pEl.asParagraph();

        // Remove any prior watermark on this paragraph
        try {
          const imgs = p.getPositionedImages();
          for (let k = imgs.length - 1; k >= 0; k--) {
            const img = imgs[k];
            if (img.getWidth() === 340 && img.getHeight() === 187) {
              p.removePositionedImage(img.getId());
            }
          }
        } catch(re) {}

        const pos = p.addPositionedImage(watermarkBlob);
        pos.setWidth(340);
        pos.setHeight(187);
        pos.setLeftOffset(88);
        pos.setTopOffset(topOffset !== undefined ? topOffset : 220);
        pos.setLayout(DocumentApp.PositionedLayout.ABOVE_TEXT);
        wLogs.push(label + ': SUCCESS, text=' + p.getText().substring(0, 25));
      } catch(wErr) {
        wLogs.push(label + ': ERROR: ' + wErr);
        Logger.log("addCenteredWatermark_ error: " + wErr);
      }
    };

    // Helper to find top paragraph by search string
    const findTopPara_ = (str) => {
      try {
        const found = body.findText(str);
        if (!found) return null;
        let el = found.getElement();
        while (el && el.getParent() && el.getParent().getType() !== DocumentApp.ElementType.BODY_SECTION) {
          el = el.getParent();
        }
        if (el && el.getType() === DocumentApp.ElementType.PARAGRAPH) return el.asParagraph();
        return null;
      } catch(e) { return null; }
    };

    // Page 1: Anchored to Form -1 Title
    const pPage1 = findTopPara_('Form -1') || findTopPara_('Form-1') || (body.getNumChildren() > 0 && body.getChild(0).getType() === DocumentApp.ElementType.PARAGRAPH ? body.getChild(0).asParagraph() : null);
    addCenteredWatermark_(pPage1, 220, 'Page1');

    // Page 2: Anchored to TERMS & CONDITIONS
    const pPage2 = findTopPara_('TERMS & CONDITIONS') || findTopPara_('TERMS') || findTopPara_('Academic Experience') || findTopPara_('Teaching / Work Experience');
    addCenteredWatermark_(pPage2, 220, 'Page2');

    // Page 3: Anchored to Form-2 Declaration Heading
    const pPage3 = findTopPara_('Form-2') || findTopPara_('Form -2') || findTopPara_('DECLARATION LETTER');
    addCenteredWatermark_(pPage3, 220, 'Page3');

    // Page 4: Anchored to Form-2 Signature Table on Page 4 (no extra page break needed)
    if (pPage3) {
      const idx3 = body.getChildIndex(pPage3);
      let foundSigTable = false;
      for (let k = idx3 + 1; k < body.getNumChildren(); k++) {
        const ch = body.getChild(k);
        if (ch.getType() === DocumentApp.ElementType.TABLE) {
          addCenteredWatermark_(ch, 180, 'Page4');
          foundSigTable = true;
          break;
        }
      }
      if (!foundSigTable) {
        wLogs.push('Page4: sigTable not found after idx3=' + idx3);
      }
    }

    // Page 5: Anchored to Form -3 Attendance Sheet Title
    const pPage5 = findTopPara_('Form -3') || findTopPara_('Form-3');
    addCenteredWatermark_(pPage5, 220, 'Page5');

    // Page 6: Anchored to DAILY ATTENDANCE LOG (CONTINUED)
    const pPage6 = findTopPara_('DAILY ATTENDANCE LOG (CONTINUED)') || 
                   findTopPara_('ATTENDANCE LOG (CONTINUED)');
    if (pPage6) {
      addCenteredWatermark_(pPage6, 220, 'Page6');
    } else {
      // Fallback: If 30-day table exists without heading, scan for table with Day 16
      const allTables = body.getTables();
      for (let t = 0; t < allTables.length; t++) {
        const tbl = allTables[t];
        if (tbl.getNumRows() > 0 && tbl.getRow(0).getNumCells() >= 4) {
          const tText = tbl.getText();
          if (tText.includes('Day 16') || tText.includes('Day 17')) {
            const tIdx = body.getChildIndex(tbl);
            const p6Anchor = body.insertParagraph(tIdx, ' ');
            p6Anchor.setSpacingBefore(0).setSpacingAfter(0).setLineSpacing(1.0);
            p6Anchor.editAsText().setFontSize(1);
            addCenteredWatermark_(p6Anchor, 220, 'Page6_fallback');
            break;
          }
        }
      }
    }

    // Page 7 (or Page 6 for 15-day): Anchored to Form-3 Note / Summary
    const pPageSummary = findTopPara_('attendance sheet should remain affixed') || findTopPara_('Attendance sheet should remain affixed') || findTopPara_('Attendance Summary');
    addCenteredWatermark_(pPageSummary, 220, 'Page7');

  } catch (err) {
    Logger.log("applyApplicationFormWatermark_ error: " + err);
  }
}

const DEFAULT_COMPANY_SEAL_B64 = "";

const DEFAULT_COMPANY_SIGNATURE_B64 = "";



/**

 * Retrieves the configured or default dimensions for document assets (Signature, Seal, QR, Barcode) in points (pt).

 */

function getAssetDimensions_(options) {

  options = options || {};

  try {

    const props = PropertiesService.getScriptProperties();

    let appSet = {};

    try {

      const sRes = getAppSettings();

      if (sRes && sRes.settings) appSet = sRes.settings;

    } catch(e) {}

    return {

      sigWidth: parseInt(options.sigWidth || props.getProperty('ASSET_SIG_WIDTH') || appSet['ASSET_SIG_WIDTH'] || '120', 10),

      sigHeight: parseInt(options.sigHeight || props.getProperty('ASSET_SIG_HEIGHT') || appSet['ASSET_SIG_HEIGHT'] || '52', 10),

      sealWidth: parseInt(options.sealWidth || props.getProperty('ASSET_SEAL_WIDTH') || appSet['ASSET_SEAL_WIDTH'] || '80', 10),

      sealHeight: parseInt(options.sealHeight || props.getProperty('ASSET_SEAL_HEIGHT') || appSet['ASSET_SEAL_HEIGHT'] || '80', 10),

      qrWidth: parseInt(options.qrWidth || props.getProperty('ASSET_QR_WIDTH') || appSet['ASSET_QR_WIDTH'] || '70', 10),

      qrHeight: parseInt(options.qrHeight || props.getProperty('ASSET_QR_HEIGHT') || appSet['ASSET_QR_HEIGHT'] || '70', 10),

      barcodeWidth: parseInt(options.barcodeWidth || props.getProperty('ASSET_BARCODE_WIDTH') || appSet['ASSET_BARCODE_WIDTH'] || '200', 10),

      barcodeHeight: parseInt(options.barcodeHeight || props.getProperty('ASSET_BARCODE_HEIGHT') || appSet['ASSET_BARCODE_HEIGHT'] || '35', 10)

    };

  } catch(e) {

    return { sigWidth: 120, sigHeight: 52, sealWidth: 80, sealHeight: 80, qrWidth: 70, qrHeight: 70, barcodeWidth: 200, barcodeHeight: 35 };

  }

}



/**

 * Helper: Gets or creates the official assets folder in Google Drive.

 */

function getAdminAssetsFolder_() {

  try {

    const folders = DriveApp.getFoldersByName('GSV_Official_Assets');

    if (folders.hasNext()) {

      return folders.next();

    }

    const folder = DriveApp.createFolder('GSV_Official_Assets');

    try {

      folder.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

    } catch(e) {}

    return folder;

  } catch(e) {

    try {

      return getFolder('uploads') || DriveApp.getRootFolder();

    } catch(err) {

      return DriveApp.getRootFolder();

    }

  }

}



/**

 * Retrieves the Company Seal as a Blob.

 * Prioritizes custom admin uploaded image stored in Google Drive (via CUSTOM_COMPANY_SEAL_FILE_ID),

 * then falls back to legacy Base64 property, and finally to the default built-in official asset.

 */

function getCompanySealBlob_() {

  try {

    const props = PropertiesService.getScriptProperties();

    // 1. Check Google Drive file ID (quota-safe)

    const sealFileId = props.getProperty('CUSTOM_COMPANY_SEAL_FILE_ID');

    if (sealFileId && sealFileId.trim() !== '') {

      try {

        const file = DriveApp.getFileById(sealFileId.trim());

        return file.getBlob().setName('company_seal.png');

      } catch(fErr) {

        Logger.log("getCompanySealBlob_ Drive file error: " + fErr);

      }

    }



    // 2. Fallback to legacy custom base64 property if present

    const customSeal = props.getProperty('CUSTOM_COMPANY_SEAL_B64');

    const b64 = (customSeal && customSeal.trim() !== '') ? customSeal.trim() : DEFAULT_COMPANY_SEAL_B64;

    if (b64) {

      const cleanB64 = b64.replace(/^data:image\/\w+;base64,/, '');

      const bytes = Utilities.base64Decode(cleanB64);

      return Utilities.newBlob(bytes, 'image/png', 'company_seal.png');

    }

  } catch (e) {

    Logger.log("getCompanySealBlob_ error: " + e.toString());

  }

  return null;

}



/**

 * Retrieves the Authorized Signatory Signature as a Blob.

 * Prioritizes custom admin uploaded image stored in Google Drive (via CUSTOM_COMPANY_SIGNATURE_FILE_ID),

 * then falls back to legacy Base64 property, and finally to the default built-in official asset.

 */

function getCompanySignatureBlob_() {

  try {

    const props = PropertiesService.getScriptProperties();

    // 1. Check Google Drive file ID (quota-safe)

    const sigFileId = props.getProperty('CUSTOM_COMPANY_SIGNATURE_FILE_ID');

    if (sigFileId && sigFileId.trim() !== '') {

      try {

        const file = DriveApp.getFileById(sigFileId.trim());

        return file.getBlob().setName('company_signature.png');

      } catch(fErr) {

        Logger.log("getCompanySignatureBlob_ Drive file error: " + fErr);

      }

    }



    // 2. Fallback to legacy custom base64 property if present

    const customSig = props.getProperty('CUSTOM_COMPANY_SIGNATURE_B64');

    let b64 = (customSig && customSig.trim() !== '') ? customSig.trim() : DEFAULT_COMPANY_SIGNATURE_B64;

    if (customSig && (customSig.length === 17388 || customSig.length > 12000)) {

      b64 = DEFAULT_COMPANY_SIGNATURE_B64;

    }

    if (b64) {

      const cleanB64 = b64.replace(/^data:image\/\w+;base64,/, '');

      const bytes = Utilities.base64Decode(cleanB64);

      return Utilities.newBlob(bytes, 'image/png', 'company_signature.png');

    }

  } catch (e) {

    Logger.log("getCompanySignatureBlob_ error: " + e.toString());

  }

  return null;

}



/**

 * Admin API: Fetches current Seal, Signature previews, custom upload flags, and asset dimensions.

 */

function getCompanySealSignatureAdmin() {

  try {

    const props = PropertiesService.getScriptProperties();

    let sealB64 = null;

    let isCustomSeal = false;

    const sealFileId = props.getProperty('CUSTOM_COMPANY_SEAL_FILE_ID');

    if (sealFileId && sealFileId.trim() !== '') {

      try {

        const file = DriveApp.getFileById(sealFileId.trim());

        const blob = file.getBlob();

        sealB64 = 'data:' + blob.getContentType() + ';base64,' + Utilities.base64Encode(blob.getBytes());

        isCustomSeal = true;

      } catch(e) {

        Logger.log("Error loading custom seal preview from Drive: " + e);

      }

    }

    if (!sealB64) {

      const customSeal = props.getProperty('CUSTOM_COMPANY_SEAL_B64');

      if (customSeal && customSeal.trim() !== '') {

        sealB64 = customSeal.trim();

        isCustomSeal = true;

      } else {

        sealB64 = DEFAULT_COMPANY_SEAL_B64;

      }

    }



    let sigB64 = null;

    let isCustomSig = false;

    const sigFileId = props.getProperty('CUSTOM_COMPANY_SIGNATURE_FILE_ID');

    if (sigFileId && sigFileId.trim() !== '') {

      try {

        const file = DriveApp.getFileById(sigFileId.trim());

        const blob = file.getBlob();

        sigB64 = 'data:' + blob.getContentType() + ';base64,' + Utilities.base64Encode(blob.getBytes());

        isCustomSig = true;

      } catch(e) {

        Logger.log("Error loading custom signature preview from Drive: " + e);

      }

    }

    if (!sigB64) {

      const customSig = props.getProperty('CUSTOM_COMPANY_SIGNATURE_B64');

      if (customSig && customSig.trim() !== '') {

        sigB64 = customSig.trim();

        isCustomSig = true;

      } else {

        sigB64 = DEFAULT_COMPANY_SIGNATURE_B64;

      }

    }



    const dimensions = getAssetDimensions_();



    let appSet = {};

    try {

      const sRes = getAppSettings();

      if (sRes && sRes.settings) appSet = sRes.settings;

    } catch(e) {}



    const isValTrue = (v, defaultVal) => {

      if (v === undefined || v === null || v === '') return defaultVal;

      const s = String(v).toLowerCase();

      return s === 'true' || s === '1' || s === 'yes' || s === 'on';

    };



    const toggles = {

      togglePhysicalSeal: isValTrue(props.getProperty('TOGGLE_PHYSICAL_SEAL') || appSet['TOGGLE_PHYSICAL_SEAL'], false),

      togglePhysicalSig: isValTrue(props.getProperty('TOGGLE_PHYSICAL_SIG') || appSet['TOGGLE_PHYSICAL_SIG'], false),

      toggleDigitalSign: isValTrue(props.getProperty('TOGGLE_DIGITAL_SIGN') || appSet['TOGGLE_DIGITAL_SIGN'], true),

      toggleVerifyQR: isValTrue(props.getProperty('TOGGLE_VERIFY_QR') || appSet['TOGGLE_VERIFY_QR'], true),

      toggleVerifyNote: isValTrue(props.getProperty('TOGGLE_VERIFY_NOTE') || appSet['TOGGLE_VERIFY_NOTE'], false),

      toggleStudentPhoto: isValTrue(props.getProperty('TOGGLE_STUDENT_PHOTO') || appSet['TOGGLE_STUDENT_PHOTO'], true)

    };



    return {

      status: 'success',

      sealBase64: (sealB64 && sealB64.startsWith('data:')) ? sealB64 : ('data:image/png;base64,' + (sealB64 || '')),

      signatureBase64: (sigB64 && sigB64.startsWith('data:')) ? sigB64 : ('data:image/png;base64,' + (sigB64 || '')),

      isCustomSeal: isCustomSeal,

      isCustomSig: isCustomSig,

      dimensions: dimensions,

      toggles: toggles

    };

  } catch (e) {

    return { status: 'error', message: e.message };

  }

}



function cleanScriptPropertiesQuota_() {

  try {

    const props = PropertiesService.getScriptProperties();

    const all = props.getProperties();

    for (const key in all) {

      if (all[key] && all[key].length > 4000) {

        Logger.log('Purging bloated property from ScriptProperties: ' + key + ' (length: ' + all[key].length + ')');

        props.deleteProperty(key);

      }

    }

  } catch(e) {

    Logger.log('cleanScriptPropertiesQuota_ error: ' + e);

  }

}



/**

 * Admin API: Saves custom uploaded Seal and/or Signature to Google Drive (storing lightweight File IDs in ScriptProperties)

 * and asset dimensions & document toggles. Syncs directly to AppSettings sheet so settings persist across sessions.

 */

function saveCompanySealSignatureAdmin(payload) {

  try {

    payload = payload || {};

    cleanScriptPropertiesQuota_();

    const props = PropertiesService.getScriptProperties();



    // Purge any oversized legacy Base64 properties that cause quota errors

    try {

      props.deleteProperty('CUSTOM_COMPANY_SEAL_B64');

      props.deleteProperty('CUSTOM_COMPANY_SIGNATURE_B64');

    } catch(delErr) {}



    // 1. Handle Seal upload

    if (payload.sealBase64 !== undefined) {

      if (payload.sealBase64 && payload.sealBase64.trim() !== '') {

        const rawB64 = payload.sealBase64.trim().replace(/^data:image\/\w+;base64,/, '');

        const bytes = Utilities.base64Decode(rawB64);

        const blob = Utilities.newBlob(bytes, 'image/png', 'official_company_seal.png');



        // Trash existing custom seal file if present

        const oldSealId = props.getProperty('CUSTOM_COMPANY_SEAL_FILE_ID');

        if (oldSealId) {

          try { DriveApp.getFileById(oldSealId).setTrashed(true); } catch(e) {}

        }



        const assetsFolder = getAdminAssetsFolder_();

        const file = assetsFolder.createFile(blob);

        try { file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch(e) {}

        props.setProperty('CUSTOM_COMPANY_SEAL_FILE_ID', file.getId());

      } else {

        const oldSealId = props.getProperty('CUSTOM_COMPANY_SEAL_FILE_ID');

        if (oldSealId) {

          try { DriveApp.getFileById(oldSealId).setTrashed(true); } catch(e) {}

        }

        props.deleteProperty('CUSTOM_COMPANY_SEAL_FILE_ID');

      }

    }



    // 2. Handle Signature upload

    if (payload.signatureBase64 !== undefined) {

      if (payload.signatureBase64 && payload.signatureBase64.trim() !== '') {

        const rawB64 = payload.signatureBase64.trim().replace(/^data:image\/\w+;base64,/, '');

        const bytes = Utilities.base64Decode(rawB64);

        const blob = Utilities.newBlob(bytes, 'image/png', 'official_company_signature.png');



        // Trash existing custom signature file if present

        const oldSigId = props.getProperty('CUSTOM_COMPANY_SIGNATURE_FILE_ID');

        if (oldSigId) {

          try { DriveApp.getFileById(oldSigId).setTrashed(true); } catch(e) {}

        }



        const assetsFolder = getAdminAssetsFolder_();

        const file = assetsFolder.createFile(blob);

        try { file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch(e) {}

        props.setProperty('CUSTOM_COMPANY_SIGNATURE_FILE_ID', file.getId());

      } else {

        const oldSigId = props.getProperty('CUSTOM_COMPANY_SIGNATURE_FILE_ID');

        if (oldSigId) {

          try { DriveApp.getFileById(oldSigId).setTrashed(true); } catch(e) {}

        }

        props.deleteProperty('CUSTOM_COMPANY_SIGNATURE_FILE_ID');

      }

    }



    // 3. Save dimensions (lightweight numbers, completely safe for ScriptProperties)

    const settingsToSheet = {};

    if (payload.sigWidth !== undefined) { props.setProperty('ASSET_SIG_WIDTH', String(payload.sigWidth)); settingsToSheet['ASSET_SIG_WIDTH'] = String(payload.sigWidth); }

    if (payload.sigHeight !== undefined) { props.setProperty('ASSET_SIG_HEIGHT', String(payload.sigHeight)); settingsToSheet['ASSET_SIG_HEIGHT'] = String(payload.sigHeight); }

    if (payload.sealWidth !== undefined) { props.setProperty('ASSET_SEAL_WIDTH', String(payload.sealWidth)); settingsToSheet['ASSET_SEAL_WIDTH'] = String(payload.sealWidth); }

    if (payload.sealHeight !== undefined) { props.setProperty('ASSET_SEAL_HEIGHT', String(payload.sealHeight)); settingsToSheet['ASSET_SEAL_HEIGHT'] = String(payload.sealHeight); }

    if (payload.qrWidth !== undefined) { props.setProperty('ASSET_QR_WIDTH', String(payload.qrWidth)); settingsToSheet['ASSET_QR_WIDTH'] = String(payload.qrWidth); }

    if (payload.qrHeight !== undefined) { props.setProperty('ASSET_QR_HEIGHT', String(payload.qrHeight)); settingsToSheet['ASSET_QR_HEIGHT'] = String(payload.qrHeight); }

    if (payload.barcodeWidth !== undefined) { props.setProperty('ASSET_BARCODE_WIDTH', String(payload.barcodeWidth)); settingsToSheet['ASSET_BARCODE_WIDTH'] = String(payload.barcodeWidth); }

    if (payload.barcodeHeight !== undefined) { props.setProperty('ASSET_BARCODE_HEIGHT', String(payload.barcodeHeight)); settingsToSheet['ASSET_BARCODE_HEIGHT'] = String(payload.barcodeHeight); }



    // 4. Save toggles to ScriptProperties and sync to AppSettings sheet

    if (payload.togglePhysicalSeal !== undefined) {

      const val = String(payload.togglePhysicalSeal);

      props.setProperty('TOGGLE_PHYSICAL_SEAL', val);

      settingsToSheet['TOGGLE_PHYSICAL_SEAL'] = val;

    }

    if (payload.togglePhysicalSig !== undefined) {

      const val = String(payload.togglePhysicalSig);

      props.setProperty('TOGGLE_PHYSICAL_SIG', val);

      settingsToSheet['TOGGLE_PHYSICAL_SIG'] = val;

    }

    if (payload.toggleDigitalSign !== undefined) {

      const val = String(payload.toggleDigitalSign);

      props.setProperty('TOGGLE_DIGITAL_SIGN', val);

      settingsToSheet['TOGGLE_DIGITAL_SIGN'] = val;

    }

    if (payload.toggleVerifyQR !== undefined) {

      const val = String(payload.toggleVerifyQR);

      props.setProperty('TOGGLE_VERIFY_QR', val);

      settingsToSheet['TOGGLE_VERIFY_QR'] = val;

    }

    if (payload.toggleVerifyNote !== undefined) {

      const val = String(payload.toggleVerifyNote);

      props.setProperty('TOGGLE_VERIFY_NOTE', val);

      settingsToSheet['TOGGLE_VERIFY_NOTE'] = val;

    }

    if (payload.toggleStudentPhoto !== undefined) {

      const val = String(payload.toggleStudentPhoto);

      props.setProperty('TOGGLE_STUDENT_PHOTO', val);

      settingsToSheet['TOGGLE_STUDENT_PHOTO'] = val;

    }



    try {

      if (Object.keys(settingsToSheet).length > 0) {

        saveAppSettings(settingsToSheet);

      }

    } catch(sheetErr) {

      Logger.log("Error syncing asset settings to AppSettings sheet: " + sheetErr);

    }



    return { status: 'success', message: 'Official Seal, Signature, Sizing & Document toggle settings saved successfully to system and Google Sheets!' };

  } catch (e) {

    return { status: 'error', message: e.message };

  }

}



/**

 * Admin API: Resets Seal and/or Signature back to default built-in official assets.

 */

function resetCompanySealSignatureAdmin(type) {

  try {

    const props = PropertiesService.getScriptProperties();

    if (type === 'seal' || type === 'all') {

      const oldSealId = props.getProperty('CUSTOM_COMPANY_SEAL_FILE_ID');

      if (oldSealId) {

        try { DriveApp.getFileById(oldSealId).setTrashed(true); } catch(e) {}

      }

      props.deleteProperty('CUSTOM_COMPANY_SEAL_FILE_ID');

      props.deleteProperty('CUSTOM_COMPANY_SEAL_B64');

      props.deleteProperty('ASSET_SEAL_WIDTH');

      props.deleteProperty('ASSET_SEAL_HEIGHT');

    }

    if (type === 'signature' || type === 'all') {

      const oldSigId = props.getProperty('CUSTOM_COMPANY_SIGNATURE_FILE_ID');

      if (oldSigId) {

        try { DriveApp.getFileById(oldSigId).setTrashed(true); } catch(e) {}

      }

      props.deleteProperty('CUSTOM_COMPANY_SIGNATURE_FILE_ID');

      props.deleteProperty('CUSTOM_COMPANY_SIGNATURE_B64');

      props.deleteProperty('ASSET_SIG_WIDTH');

      props.deleteProperty('ASSET_SIG_HEIGHT');

    }

    if (type === 'all') {

      props.deleteProperty('ASSET_QR_WIDTH');

      props.deleteProperty('ASSET_QR_HEIGHT');

      props.deleteProperty('ASSET_BARCODE_WIDTH');

      props.deleteProperty('ASSET_BARCODE_HEIGHT');

    }

    return { status: 'success', message: 'Reset ' + type + ' to default official assets and dimensions successfully.' };

  } catch (e) {

    return { status: 'error', message: e.message };

  }

}



/**

 * Ensures Certificate Template 2 remains strictly 1 single page by compacting

 * empty spacer paragraphs, tightening line spacing, and pruning redundant trailing line breaks

 * while strictly safeguarding Title and Body paragraphs with positioned photos against font/spacing crush.

 */

/**

 * Formats certificate body text to match the exact visual reference in Image 1 (Aswin Raj):

 * - 12pt Times New Roman throughout

 * - Left alignment, 48pt first-line indent, 1.18 line spacing, 4pt before/after

 * - Connecting text in Italic, deep black #000000

 * - Specific key entities in BOLD, deep black #000000:

 *   1) Student Full Name (e.g. ASWIN RAJ)

 *   2) College Name (e.g. VELAMMAL INSTITUTE OF TECHNOLOGY, THIRUVALLUR,)

 *   3) Company Name (e.g. G.S.V Electrical Enterprises, Chennai)

 *   4) Tenure (e.g. 30 days)

 *   5) Project Topic (e.g. IOT BASED Electrical Parameters and Protection of Motor Automation .)

 */

/**

 * Dynamic Certificate Layout Fitting Engine:

 * Calibrates typography and dynamic spacing to strictly match ground_truth_pdf_page.png

 * (18pt Times New Roman, 1.32 line spacing, 85pt spacer) for standard content (~560 chars),

 * and dynamically scales typography & spacers if content increases so that it NEVER exceeds

 * to a second page.

 *

 * Page Geometry:

 * - Body text starts at y = 301.2 pt

 * - Footer banner starts at y = 781.0 pt

 * - Available space = 479.8 pt

 * - Footer table height = 76.3 pt

 * - Available vertical space for (Body Text + Spacer) = ~378 pt.

 */

function isParagraphEffectivelyEmpty_(el) {

  if (!el || el.getType() !== DocumentApp.ElementType.PARAGRAPH) return false;

  const p = el.asParagraph();

  if (p.getPositionedImages().length > 0) return false;

  const clean = (p.getText() || '').replace(/[\s\u00A0\u200B\u200C\u200D\uFEFF]/g, '');

  return clean.length === 0;

}



function calculateCertificateFittedLayout_(totalChars, options) {

  options = options || {};



  // Precision typography auto-fit so center content never over-expands:

  let targetFontSize = 18.5;

  let targetLineSpacing = 1.18;

  let targetParaSpacing = 3.5;



  if (totalChars <= 540) {

    targetFontSize = 18.5;

    targetLineSpacing = 1.18;

    targetParaSpacing = 3.5;

  } else if (totalChars <= 680) {

    // For students with longer college/dept/project text (like Venu Kathirazhagan U)

    targetFontSize = 17.5;

    targetLineSpacing = 1.15;

    targetParaSpacing = 3.0;

  } else if (totalChars <= 800) {

    targetFontSize = 16.5;

    targetLineSpacing = 1.12;

    targetParaSpacing = 2.5;

  } else {

    targetFontSize = 15.0;

    targetLineSpacing = 1.10;

    targetParaSpacing = 2.0;

  }



  // Only honor custom user option if explicitly passed

  if (options.bodyFontSize && Number(options.bodyFontSize) > 0) {

    targetFontSize = Number(options.bodyFontSize);

  }

  if (options.lineSpacing && Number(options.lineSpacing) > 0) {

    targetLineSpacing = Number(options.lineSpacing);

  }



  // Fixed bottom-anchored spacer calculation:

  // Dynamically absorbs center content expansion so footer remains 100% fixed at the bottom:

  const hasNote = (options && (options.addVerificationWatermark === true || options.addVerificationWatermark === 'true' || options.includeNote === true || options.includeNote === 'true'));

  const hasDigitalSign = (options && (options.includeDigitalSign === true || options.includeDigitalSign === 'true' || options.digital === true || options.digital === 'true'));



  // Estimate text height accurately:

  const avgCharsPerLine = Math.round(500 / (targetFontSize * 0.46));

  const estLines = Math.ceil(Math.max(1, totalChars - 30) / avgCharsPerLine) + 3;

  const estTextHeight = (estLines * targetFontSize * targetLineSpacing) + (targetParaSpacing * 2);



  // Available height for spacer between body and footer table (Fixed ceiling = 310pt):

  // When note is present, reserve space for note (20pt):

  const maxAvailableSpacer = Math.floor(310 - estTextHeight - (hasNote ? 20.0 : 0));

  const baseSpacer = hasNote ? 24.0 : 38.0;

  const finalSpacer = Math.max(6.0, Math.min(baseSpacer, maxAvailableSpacer));



  return {

    fontSize: targetFontSize,

    lineSpacing: targetLineSpacing,

    paraSpacingAfter: targetParaSpacing,

    spacerBeforePts: finalSpacer

  };

}



function formatCertificateBodyExact_(body, studentData, options) {

  if (!body) return;

  try {

    options = options || {};

    let align = DocumentApp.HorizontalAlignment.JUSTIFY; // Must ALWAYS be JUSTIFY as commanded by user

    if (options.alignment === 'LEFT' || options.alignment === DocumentApp.HorizontalAlignment.LEFT) {

      align = DocumentApp.HorizontalAlignment.LEFT;

    }



    const paras = body.getParagraphs();

    let bodyPara = null;

    let duringPara = null;

    let perfPara = null;



    for (let i = 0; i < paras.length; i++) {

      const txt = paras[i].getText() || '';

      if (!bodyPara && /This is to certify/i.test(txt)) {

        bodyPara = paras[i];

      } else if (!duringPara && /^\s*During\s+(?:the\s+internship|the\s+Tenure|Tenure)/i.test(txt) && !/performance|conduct/i.test(txt)) {

        duringPara = paras[i];

      } else if (!perfPara && /conduct|performance/i.test(txt)) {

        perfPara = paras[i];

      }

    }



    // Paragraph Splitting: In Template 2, Para 1 ("This is to certify") and Para 2 ("During the...")

    // are joined in a single paragraph block separated by newlines.

    // We split them so that each paragraph is an independent element and receives identical first-line indent.

    if (bodyPara) {
      // Ensure clean grammar comma after student/faculty name before Employee ID / Register Number
      try {
        const sFName = (studentData && (studentData.FullName || studentData.StudentName || studentData.Name)) ? String(studentData.FullName || studentData.StudentName || studentData.Name).trim() : '';
        if (sFName) {
          const escFN = sFName.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
          bodyPara.replaceText('(' + escFN + ')(?!,)\\s+(Employee\\s*ID|Faculty\\s*/\\s*Staff\\s*ID|Staff\\s*ID|Register\\s*Number)', '$1, $2');
          bodyPara.replaceText('(' + escFN + ')\\s*,\\s*,', '$1,');
        }
      } catch(eComma) {}

      const bText = bodyPara.getText() || '';

      const mDuring = bText.match(/(?:[\r\n\u200B]+|\.\s+)\s*(During\s+(?:the\s+internship|the\s+Tenure|Tenure)[\s\S]*)/i);

      if (mDuring && mDuring.index !== undefined) {

        const splitIdx = mDuring.index;

        const duringText = (mDuring[1] || mDuring[0]).trim();

        try {

          bodyPara.editAsText().deleteText(splitIdx, bText.length - 1);

        } catch(delErr) {

          Logger.log('Error deleting during text from bodyPara: ' + delErr);

        }

        if (!duringPara) {

          const bIdx = body.getChildIndex(bodyPara);

          duringPara = body.insertParagraph(bIdx + 1, duringText);

        } else if (!duringPara.getText().trim()) {

          duringPara.setText(duringText);

        }

      }

    }



    // Check if duringPara has performance/conduct text merged inside it

    if (duringPara) {

      const dText = duringPara.getText() || '';

      const mPerf = dText.match(/(?:[\r\n\u200B]+|\.\s+)\s*((?:His|Her|Their|The)\s+performance[\s\S]*)/i);

      if (mPerf && mPerf.index !== undefined) {

        const splitIdx = mPerf.index;

        const perfText = (mPerf[1] || mPerf[0]).trim();

        try {

          duringPara.editAsText().deleteText(splitIdx, dText.length - 1);

        } catch(delErr2) {}

        if (!perfPara) {

          const dIdx = body.getChildIndex(duringPara);

          perfPara = body.insertParagraph(dIdx + 1, perfText);

        } else if (!perfPara.getText().trim()) {

          perfPara.setText(perfText);

        }

      }

    }



    // Check if bodyPara has performance/conduct text directly

    if (bodyPara) {

      const bText2 = bodyPara.getText() || '';

      const mPerf2 = bText2.match(/(?:[\r\n\u200B]+|\.\s+)\s*((?:His|Her|Their|The)\s+performance[\s\S]*)/i);

      if (mPerf2 && mPerf2.index !== undefined) {

        const splitIdx2 = mPerf2.index;

        const perfText2 = (mPerf2[1] || mPerf2[0]).trim();

        try {

          bodyPara.editAsText().deleteText(splitIdx2, bText2.length - 1);

        } catch(delErr3) {}

        if (!perfPara) {

          const bIdx2 = body.getChildIndex(bodyPara);

          perfPara = body.insertParagraph(bIdx2 + 1, perfText2);

        }

      }

    }



    // Trim any trailing whitespace, newlines, or zero-width spaces from all body paragraphs

    [bodyPara, duringPara, perfPara].forEach(function(p) {

      if (!p) return;

      try {

        let pTxt = p.getText() || '';

        while (pTxt.length > 0 && (pTxt.charCodeAt(pTxt.length - 1) <= 32 || pTxt.charCodeAt(pTxt.length - 1) === 0x200B || pTxt.charCodeAt(pTxt.length - 1) === 0x00A0)) {

          p.editAsText().deleteText(pTxt.length - 1, pTxt.length - 1);

          pTxt = p.getText() || '';

        }

      } catch(eTr) {}

    });



    // Auto-fit protection: Measure total characters across body paragraphs

    let totalChars = 0;

    if (bodyPara) totalChars += (bodyPara.getText() || '').length;

    if (duringPara) totalChars += (duringPara.getText() || '').length;

    if (perfPara) totalChars += (perfPara.getText() || '').length;



    // Dynamically calculate fitted typography & spacing (Large 17.5pt commanding font)

    const layout = calculateCertificateFittedLayout_(totalChars, options);

    const bodyFontSize = layout.fontSize; // 17.5pt

    const lineSpacing = layout.lineSpacing;

    const paraSpacingAfter = layout.paraSpacingAfter;



    // Clean, uniform indentation: All 3 paragraphs MUST start at the exact same position!

    // Dynamically calibrated to guarantee that the student's entire name fits on Line 1!

    // If the name is long, indent is reduced from standard 108pt so the name never wraps across lines.

    // All 3 paragraphs (Para 1, 2, 3) receive the exact same indent to stay 100% aligned!

    const DEFAULT_INDENT_PTS = 108.0; // Standard 3x indent (starts at 164.7 pt from page edge)

    const MIN_INDENT_PTS = 24.0;      // Minimum indent boundary

    const CONTENT_WIDTH = 499.58;     // Total printable width (595.28 - 56.7 - 39.0)



    let studentFullName = (studentData && (studentData.FullName || studentData.StudentName || studentData.Name)) 

      ? String(studentData.FullName || studentData.StudentName || studentData.Name).trim() 

      : '';

    if (!studentFullName && bodyPara) {

      const mN = (bodyPara.getText() || '').match(/This is to certify that\s+([A-Z\s.]+?)(?=\s+Register|\s+Registration|\s+:|\s+\()/i);

      if (mN && mN[1]) studentFullName = mN[1].trim();

    }



    let UNIFORM_INDENT_PTS = DEFAULT_INDENT_PTS;

    let effectiveBodyFontSize = bodyFontSize;



    if (studentFullName && studentFullName.length > 0) {

      const leadStr = "This is to certify that ";

      const estimateStrWidth = (str, sz, isBold) => {

        let w = 0;

        for (let ci = 0; ci < str.length; ci++) {

          const ch = str.charAt(ci);

          const cCode = str.charCodeAt(ci);

          if (cCode === 32 || cCode === 160) {

            w += 0.25;

          } else if (ch >= 'A' && ch <= 'Z') {

            w += (isBold ? 0.72 : 0.65);

          } else if (ch >= 'a' && ch <= 'z') {

            w += (isBold ? 0.50 : 0.45);

          } else if (ch >= '0' && ch <= '9') {

            w += (isBold ? 0.55 : 0.50);

          } else if (ch === '.' || ch === ',' || ch === ':' || ch === ';') {

            w += 0.28;

          } else {

            w += 0.50;

          }

        }

        return w * sz;

      };



      let leadW = estimateStrWidth(leadStr, effectiveBodyFontSize, false);

      let nameW = estimateStrWidth(studentFullName, effectiveBodyFontSize, true);

      let totalNeededLine1 = leadW + nameW + 10.0;



      let availableWithDefault = CONTENT_WIDTH - DEFAULT_INDENT_PTS;

      if (totalNeededLine1 > availableWithDefault) {

        let maxAllowedIndent = CONTENT_WIDTH - totalNeededLine1;

        if (maxAllowedIndent < MIN_INDENT_PTS) {

          while (effectiveBodyFontSize > 15.5) {

            effectiveBodyFontSize -= 0.5;

            leadW = estimateStrWidth(leadStr, effectiveBodyFontSize, false);

            nameW = estimateStrWidth(studentFullName, effectiveBodyFontSize, true);

            totalNeededLine1 = leadW + nameW + 8.0;

            maxAllowedIndent = CONTENT_WIDTH - totalNeededLine1;

            if (maxAllowedIndent >= MIN_INDENT_PTS) break;

          }

          UNIFORM_INDENT_PTS = Math.floor(Math.max(MIN_INDENT_PTS, maxAllowedIndent));

        } else {

          UNIFORM_INDENT_PTS = Math.floor(maxAllowedIndent);

        }

      }



      // Convert regular spaces inside student name in bodyPara to non-breaking spaces (\u00A0)

      // This prevents Google Docs layout engine from ever line-breaking inside the student's name!

      if (bodyPara && studentFullName.indexOf(' ') !== -1) {

        try {

          const nameNbsp = studentFullName.replace(/\s+/g, '\u00A0');

          bodyPara.replaceText(studentFullName.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&'), nameNbsp);

        } catch(eNbsp) {}

      }

    }



    const formatPara = (p) => {

      if (!p) return;

      try {

        p.setAlignment(align);

        p.setLineSpacing(lineSpacing);

        p.setSpacingBefore(0);

        p.setSpacingAfter(paraSpacingAfter);



        // 1. Strip ALL tab characters completely to avoid random multi-tab jumps

        try {

          p.replaceText('\t', '');

        } catch(e) {}



        // 2. Strip all zero-width characters and unusual whitespace

        try {

          p.replaceText('[\u200B\u200C\u200D\uFEFF]', '');

        } catch(e) {}



        // 3. Strip ALL messy leading whitespace, newlines, non-breaking spaces, zero-width spaces

        let pText = p.getText() || '';

        while (pText.length > 0 && (

          pText.charCodeAt(0) <= 32 || 

          pText.charCodeAt(0) === 160 || 

          pText.charCodeAt(0) === 8203 || 

          pText.charCodeAt(0) === 8194 || 

          pText.charCodeAt(0) === 8195 || 

          pText.charCodeAt(0) === 65279

        )) {

          try {

            p.editAsText().deleteText(0, 0);

            pText = p.getText() || '';

          } catch(delErr) {

            break;

          }

        }



        // 4. Clean up multi-spaces that cause awkward stretched gaps in justified text

        try {

          p.replaceText('\\s{2,}', ' ');

        } catch(e) {}



        // 5. Set exact uniform first-line indent across ALL paragraphs

        p.setIndentFirstLine(UNIFORM_INDENT_PTS);

        p.setIndentStart(0);

        p.setIndentEnd(0);



        // 6. Set base font across the ENTIRE paragraph: Times New Roman, deep black #000000, Italic, NOT bold

        const t = p.editAsText();

        const len = p.getText().length;

        if (len > 0) {

          t.setFontFamily(0, len - 1, 'Times New Roman');

          t.setFontSize(0, len - 1, effectiveBodyFontSize);

          t.setForegroundColor(0, len - 1, '#000000');

          t.setItalic(0, len - 1, true);

          t.setBold(0, len - 1, false);

        }

      } catch(err) {

        Logger.log('formatPara error: ' + err);

      }

    };



    if (bodyPara) formatPara(bodyPara);

    if (duringPara) formatPara(duringPara);

    if (perfPara) formatPara(perfPara);



    // Clean any stray empty paragraphs between bodyPara and duringPara

    if (bodyPara && duringPara) {

      let bIdx = body.getChildIndex(bodyPara);

      let dIdx = body.getChildIndex(duringPara);

      while (dIdx > bIdx + 1) {

        const midEl = body.getChild(bIdx + 1);

        if (isParagraphEffectivelyEmpty_(midEl)) {

          midEl.removeFromParent();

          dIdx = body.getChildIndex(duringPara);

        } else {

          break;

        }

      }

    }

    // Clean any stray empty paragraphs between duringPara and perfPara

    if (duringPara && perfPara) {

      let dIdx = body.getChildIndex(duringPara);

      let pIdx = body.getChildIndex(perfPara);

      while (pIdx > dIdx + 1) {

        const midEl = body.getChild(dIdx + 1);

        if (isParagraphEffectivelyEmpty_(midEl)) {

          midEl.removeFromParent();

          pIdx = body.getChildIndex(perfPara);

        } else {

          break;

        }

      }

    }



    // Apply precise BOLD & UPRIGHT formatting to key entities in bodyPara

    if (bodyPara) {

      try {

        const txt = bodyPara.getText() || '';

        const t = bodyPara.editAsText();

        const curLen = txt.length;



        const applyBoldSafe = (subStr) => {

          if (!subStr) return;

          const cleanSub = String(subStr).trim().replace(/\.+$/, '');

          if (!cleanSub || cleanSub.length === 0) return;

          try {

            const fresh = bodyPara.getText() || '';

            const fLen = fresh.length;

            const reg = new RegExp(cleanSub.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&').replace(/\s+/g, '[\\s\\u00A0]+'), 'i');

            const m = fresh.match(reg);

            if (m && m.index !== undefined) {

              const sPos = m.index;

              const ePos = Math.min(sPos + m[0].length - 1, fLen - 1);

              if (sPos >= 0 && ePos >= sPos) {

                t.setBold(sPos, ePos, true);

                t.setItalic(sPos, ePos, false);

                t.setForegroundColor(sPos, ePos, '#000000');

                t.setFontSize(sPos, ePos, effectiveBodyFontSize);

                t.setFontFamily(sPos, ePos, 'Times New Roman');

              }

            }

          } catch(eBold) {}

        };



        // 1. Student Full Name (Bold upright, #000000)

        if (studentData && (studentData.FullName || studentData.StudentName || studentData.Name)) {

          applyBoldSafe(studentData.FullName || studentData.StudentName || studentData.Name);

        }

        const mName = txt.match(/This is to certify that\s+([A-Z\s.]+?)(?=\s+Register|\s+Registration|\s+:)/i);

        if (mName && mName[1]) applyBoldSafe(mName[1]);



        // 2. Register Number / Employee ID (Bold upright, #000000)

        const rawStaffId = (studentData && (studentData.FacultyStaffId || studentData.StaffId || studentData.EmployeeId)) ? String(studentData.FacultyStaffId || studentData.StaffId || studentData.EmployeeId).trim() : '';

        const rawReg = (studentData && (studentData.RegisterNumber || studentData.RegisterNo || studentData.regNo || studentData.RegNo)) ? String(studentData.RegisterNumber || studentData.RegisterNo || studentData.regNo || studentData.RegNo).trim() : '';

        if (rawStaffId) {

          applyBoldSafe('(' + rawStaffId + ')');

          applyBoldSafe(rawStaffId);

        }

        if (rawReg) {

          applyBoldSafe('(' + rawReg + ')');

          applyBoldSafe(rawReg);

        }

        // Label 'Employee ID :' remains normal Times New Roman Italic (NO DARKNESS/BOLD)
        // ONLY the actual ID value itself (after the colon, e.g. FAC-VIJAY-01) is bold upright!

        const mReg = txt.match(/(?:Register\s*Number|Employee\s*ID|Faculty\s*ID|Staff\s*ID)\s*[:\s]*\(?([A-Za-z0-9_-]+)\)?/i);

        if (mReg && mReg[1]) {

          applyBoldSafe('(' + mReg[1] + ')');

          applyBoldSafe(mReg[1]);

        }

        const mDigits = txt.match(/\(([0-9]{6,})\)/);

        if (mDigits && mDigits[0]) {

          applyBoldSafe(mDigits[0]);

        }



        // 3. Company Name (ONLY "G.S.V Electrical Enterprises" - Bold upright, #000000)

        applyBoldSafe('G.S.V Electrical Enterprises');



        // 4. Tenure (e.g. "30 days" - Bold upright, #000000)

        const isT2 = (options && (options.isT2 || options.certTemplate === 'T2' || options.certTemplate === 't2' || options.certTemplate === 'template2' || options.certTemplate === 'Template2' || options.template === 'T2' || options.template === 't2')) || /during the period from|completing\s+\d+\s+days\s+of\s+training|\{\{\s*InternshipStartDate\s*\}\}/i.test(bodyPara.getText());

        if (isT2) {
          // --- TEMPLATE 2 BODY SENTENCE (Strictly matching User Image 1 & Image 4) ---
          // "This is to certify that {{StudentName}}, Register Number : {{RegisterNumber}}, a student pursuing {{YEAR}} Year {{Department}} at {{CollegeName}}, {{CollegeDistrict}}, has successfully completed the Internship Training Program at G.S.V Electrical Enterprises, Chennai, during the period from {{InternshipStartDate}} to {{InternshipEndDate}}, completing {{AttendedDays}} days of training."
          const sDateFormatted = (studentData && (studentData.FormattedStartDate || studentData.InternshipStartDate || studentData.StartDate)) ? formatDateDMY(studentData.FormattedStartDate || studentData.InternshipStartDate || studentData.StartDate) : (options.startDate || '');
          const eDateFormatted = (studentData && (studentData.FormattedEndDate || studentData.InternshipEndDate || studentData.EndDate)) ? formatDateDMY(studentData.FormattedEndDate || studentData.InternshipEndDate || studentData.EndDate) : (options.endDate || '');
          const attDaysFormatted = (options && options.manualAttendedDays) ? String(options.manualAttendedDays).trim() : (studentData && (studentData.AttendedDays || studentData.attendedDays || studentData.DurationDays || studentData.CalculatedInternshipDays) ? String(studentData.AttendedDays || studentData.attendedDays || studentData.DurationDays || studentData.CalculatedInternshipDays).trim() : '15');

          const candCatCur = (typeof getCandidateCategory_ === 'function') ? getCandidateCategory_(studentData) : (studentData && (studentData.CandidateType || studentData.candidateType));

          const nameVal = (studentData && (studentData.FullName || studentData.StudentName || studentData.Name)) ? String(studentData.FullName || studentData.StudentName || studentData.Name).trim() : '';
          const salVal = (studentData && studentData.Salutation) ? String(studentData.Salutation).trim() : '';
          const nameWithSal = (nameVal && !nameVal.toLowerCase().startsWith('mr') && !nameVal.toLowerCase().startsWith('ms') && !nameVal.toLowerCase().startsWith('dr')) ? ((salVal ? salVal + ' ' : (candCatCur === 'Faculty' ? 'Mr. ' : 'Mr. ')) + nameVal) : nameVal;

          const rawStaffId = (studentData && (studentData.FacultyStaffId || studentData.StaffId || studentData.EmployeeId)) ? String(studentData.FacultyStaffId || studentData.StaffId || studentData.EmployeeId).trim() : '';
          const rawReg = (studentData && (studentData.RegisterNumber || studentData.RegisterNo || studentData.regNo || studentData.RegNo)) ? String(studentData.RegisterNumber || studentData.RegisterNo || studentData.regNo || studentData.RegNo).trim() : '';
          const idVal = (candCatCur === 'Faculty' || candCatCur === 'Employee') ? (rawStaffId || rawReg) : (rawReg || rawStaffId);

          let yearVal = (studentData && studentData.Year) ? String(studentData.Year).trim() : '';
          if (yearVal && !/year/i.test(yearVal)) yearVal += ' Year';

          const deptVal = (studentData && (studentData.Department || studentData.Dept)) ? String(studentData.Department || studentData.Dept).trim() : '';
          const collegeVal = (studentData && (studentData.CollegeName || studentData.College || studentData.Institution)) ? String(studentData.CollegeName || studentData.College || studentData.Institution).trim() : '';
          const distVal = (studentData && (studentData.CollegeDistrict || studentData.District || studentData.City)) ? String(studentData.CollegeDistrict || studentData.District || studentData.City).trim() : '';
          const distClause = distVal ? `, ${distVal}` : '';

          let t2FullSentence = '';
          if (candCatCur === 'Faculty') {
            t2FullSentence = `This is to certify that ${nameWithSal}, Staff ID : ${idVal}, Faculty of ${deptVal} at ${collegeVal}${distClause}, has successfully completed the Faculty Internship Training Program at G.S.V Electrical Enterprises, Chennai, during the period from ${sDateFormatted} to ${eDateFormatted}, completing ${attDaysFormatted} days of training.`;
          } else if (candCatCur === 'Employee') {
            t2FullSentence = `This is to certify that ${nameWithSal}, Staff ID : ${idVal}, Corporate Professional of ${deptVal} at ${collegeVal}${distClause}, has successfully completed the Corporate Upskilling & Internship Training Program at G.S.V Electrical Enterprises, Chennai, during the period from ${sDateFormatted} to ${eDateFormatted}, completing ${attDaysFormatted} days of training.`;
          } else if (candCatCur === 'Apprentice') {
            t2FullSentence = `This is to certify that ${nameWithSal}, Apprentice ID : ${idVal}, Apprentice Trainee in ${deptVal}, has successfully completed the Industrial Apprenticeship Training Program at G.S.V Electrical Enterprises, Chennai, during the period from ${sDateFormatted} to ${eDateFormatted}, completing ${attDaysFormatted} days of training.`;
          } else {
            t2FullSentence = `This is to certify that ${nameWithSal}, Register Number : ${idVal}, a student pursuing ${yearVal}, ${deptVal} at ${collegeVal}${distClause}, has successfully completed the Internship Training Program at G.S.V Electrical Enterprises, Chennai, during the period from ${sDateFormatted} to ${eDateFormatted}, completing ${attDaysFormatted} days of training.`;
          }

          bodyPara.setText(t2FullSentence);

          // Reset base paragraph styling (Times New Roman, Italic, Not Bold)
          const tB = bodyPara.editAsText();
          const bLen = bodyPara.getText().length;
          if (bLen > 0) {
            tB.setFontFamily(0, bLen - 1, 'Times New Roman');
            tB.setFontSize(0, bLen - 1, effectiveBodyFontSize);
            tB.setForegroundColor(0, bLen - 1, '#000000');
            tB.setItalic(0, bLen - 1, true);
            tB.setBold(0, bLen - 1, false);
          }

          // Apply bolding to exact entities per Image 4
          if (nameWithSal) applyBoldSafe(nameWithSal);
          if (nameVal) applyBoldSafe(nameVal);
          if (idVal) applyBoldSafe(idVal);
          if (yearVal) applyBoldSafe(yearVal);
          if (deptVal) applyBoldSafe(deptVal);
          if (collegeVal) applyBoldSafe(collegeVal);
          applyBoldSafe('G.S.V Electrical Enterprises, Chennai,');
          applyBoldSafe('G.S.V Electrical Enterprises, Chennai');
          applyBoldSafe('G.S.V Electrical Enterprises');
          if (sDateFormatted) applyBoldSafe(sDateFormatted);
          if (eDateFormatted) applyBoldSafe(eDateFormatted);
          if (attDaysFormatted) applyBoldSafe(`${attDaysFormatted} days`);

          // Explicitly ensure 'of training' is normal italic Times New Roman, NOT bold:
          try {
            const freshB = bodyPara.getText() || '';
            const mOfTr = freshB.match(/of\s+training/i);
            if (mOfTr && mOfTr.index !== undefined) {
              const sP = mOfTr.index;
              const eP = sP + mOfTr[0].length - 1;
              tB.setBold(sP, eP, false);
              tB.setItalic(sP, eP, true);
              tB.setFontFamily(sP, eP, 'Times New Roman');
              tB.setForegroundColor(sP, eP, '#000000');
            }
          } catch(eTr) {}

          // Ensure 'Staff ID :' / 'Register Number :' labels are explicitly NOT bold
          const unboldLabel = (labelPattern) => {
            try {
              const fresh = bodyPara.getText() || '';
              const m = fresh.match(labelPattern);
              if (m && m.index !== undefined) {
                const sPos = m.index;
                const ePos = sPos + m[0].length - 1;
                tB.setBold(sPos, ePos, false);
                tB.setItalic(sPos, ePos, true);
                tB.setFontFamily(sPos, ePos, 'Times New Roman');
              }
            } catch(e) {}
          };
          unboldLabel(/Staff\s*ID\s*:\s*/i);
          unboldLabel(/Register\s*Number\s*:\s*/i);
          unboldLabel(/Employee\s*ID\s*:\s*/i);
          unboldLabel(/Apprentice\s*ID\s*:\s*/i);

          // During paragraph in Template 2
          if (duringPara) {
            const candGender = (studentData && (studentData.Gender || studentData.gender || '')) ? String(studentData.Gender || studentData.gender).toLowerCase() : '';
            const candSal = (studentData && (studentData.Salutation || '')) ? String(studentData.Salutation).toLowerCase() : '';
            const isFem = candGender.includes('fem') || candSal.includes('ms') || candSal.includes('mrs');
            const pronounSubj = isFem ? 'she' : 'he';
            const pronounPoss = isFem ? 'her' : 'his';
            const pronounPossCap = isFem ? 'Her' : 'His';

            let curSkill = (options && options.skillLearned) ? String(options.skillLearned).trim() : (studentData && (studentData.SkillLearned || studentData.InterestedArea || studentData.Track || studentData.ProjectTitle) ? String(studentData.SkillLearned || studentData.InterestedArea || studentData.Track || studentData.ProjectTitle).trim() : '');
            if (['applied electronics, iot & embedded systems', 'n/a', '--'].includes(curSkill.toLowerCase()) && !studentData.Batch && !options.skillLearned) {
              curSkill = '';
            }

            if (curSkill) {
              duringPara.setText(`During the internship, ${pronounSubj} gained practical knowledge and hands-on experience in ${curSkill} .`);
              const tD = duringPara.editAsText();
              const dLen = duringPara.getText().length;
              if (dLen > 0) {
                tD.setFontFamily(0, dLen - 1, 'Times New Roman');
                tD.setFontSize(0, dLen - 1, effectiveBodyFontSize);
                tD.setForegroundColor(0, dLen - 1, '#000000');
                tD.setItalic(0, dLen - 1, true);
                tD.setBold(0, dLen - 1, false);
              }
              // Bold the skillLearned per Image 3 ("Bold" circled in red)
              const sIdx = duringPara.getText().indexOf(curSkill);
              if (sIdx !== -1) {
                tD.setBold(sIdx, sIdx + curSkill.length - 1, true);
                tD.setItalic(sIdx, sIdx + curSkill.length - 1, false);
              }
            } else {
              duringPara.setText(`During the internship, ${pronounSubj} gained practical knowledge and hands-on experience.`);
              const tD = duringPara.editAsText();
              const dLen = duringPara.getText().length;
              if (dLen > 0) {
                tD.setFontFamily(0, dLen - 1, 'Times New Roman');
                tD.setFontSize(0, dLen - 1, effectiveBodyFontSize);
                tD.setForegroundColor(0, dLen - 1, '#000000');
                tD.setItalic(0, dLen - 1, true);
                tD.setBold(0, dLen - 1, false);
              }
            }

            if (perfPara) {
              perfPara.setText(`${pronounPossCap} performance and conduct during his training were punctual, inquisitive and hardworking with involvement.`);
              const tP = perfPara.editAsText();
              const pLen = perfPara.getText().length;
              if (pLen > 0) {
                tP.setFontFamily(0, pLen - 1, 'Times New Roman');
                tP.setFontSize(0, pLen - 1, effectiveBodyFontSize);
                tP.setForegroundColor(0, pLen - 1, '#000000');
                tP.setItalic(0, pLen - 1, true);
                tP.setBold(0, pLen - 1, false);
              }
            }
          }
        } else {
          // --- TEMPLATE 1 (AS-IS) ---
          const candCatCur = (typeof getCandidateCategory_ === 'function') ? getCandidateCategory_(studentData) : (studentData && studentData.CandidateType);
          if ((candCatCur === 'Faculty' || candCatCur === 'Employee') && /for a tenure of\s*9\s*days/i.test(bodyPara.getText())) {
            try {
              const durD = (studentData && studentData.DurationDays) ? String(studentData.DurationDays) : '30';
              bodyPara.replaceText('for\\s+a\\s+tenure\\s+of\\s*9\\s*days', 'for a tenure of ' + durD + ' days');
            } catch(eTen) {}
          }
          try {
            bodyPara.replaceText('for\\s+a\\s+tenure\\s+of\\s*', 'for a tenure of ');
            if (duringPara) duringPara.replaceText('During\\s+the\\s+Tenure\\s+of\\s*', 'During the Tenure of ');
          } catch(eSp) {}
          const mTenure = (bodyPara.getText() || '').match(/for a tenure of\s+(\d+\s*days?)/i);
          if (mTenure && mTenure[1]) {
            applyBoldSafe(mTenure[1]);
          }
          // Ensure Staff ID label is NOT bold in Template 1
          try {
            const fresh1 = bodyPara.getText() || '';
            const mId = fresh1.match(/(?:Staff\s*ID|Register\s*Number|Employee\s*ID|Apprentice\s*ID)\s*:\s*/i);
            if (mId && mId.index !== undefined) {
              t.setBold(mId.index, mId.index + mId[0].length - 1, false);
              t.setItalic(mId.index, mId.index + mId[0].length - 1, true);
            }
          } catch(eUnb) {}
        }



        // 5. Date Range: Times New Roman Italic, same bodyFontSize, deep black #000000, NOT bold

        const mDates = txt.match(/\(\d{2}\/\d{2}\/\d{4}\s*to\s*\d{2}\/\d{2}\/\d{4}\)/);

        if (mDates && mDates.index !== undefined) {

          const dIdx = mDates.index;

          const dEnd = Math.min(dIdx + mDates[0].length - 1, curLen - 1);

          if (dIdx >= 0 && dEnd >= dIdx) {

            t.setFontFamily(dIdx, dEnd, 'Times New Roman');

            t.setFontSize(dIdx, dEnd, effectiveBodyFontSize);

            t.setItalic(dIdx, dEnd, true);

            t.setBold(dIdx, dEnd, false);

            t.setForegroundColor(dIdx, dEnd, '#000000');

          }

        }



        const applyItalicSafe = (subStr) => {

          if (!subStr) return;

          const cleanSub = String(subStr).trim().replace(/^,\s*/, '').replace(/[,\s]+$/, '');

          if (!cleanSub || cleanSub.length === 0) return;

          try {

            const fresh = bodyPara.getText() || '';

            const fLen = fresh.length;

            const reg = new RegExp(cleanSub.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&').replace(/\s+/g, '[\\s\\u00A0]+'), 'i');

            const m = fresh.match(reg);

            if (m && m.index !== undefined) {

              const sPos = m.index;

              const ePos = Math.min(sPos + m[0].length - 1, fLen - 1);

              if (sPos >= 0 && ePos >= sPos) {

                t.setBold(sPos, ePos, false);

                t.setItalic(sPos, ePos, true);

                t.setForegroundColor(sPos, ePos, '#000000');

                t.setFontSize(sPos, ePos, effectiveBodyFontSize);

                t.setFontFamily(sPos, ePos, 'Times New Roman');

              }

            }

          } catch(eItal) {}

        };



        // 6. College Name: Times New Roman, BOLD, Non-Italic (Upright), deep black #000000, bodyFontSize

        //    College District: Times New Roman, ITALIC, NOT Bold, deep black #000000, bodyFontSize

        const candidateColleges = [

          studentData && studentData.CollegeName,

          studentData && studentData.College,

          studentData && studentData['College Name'],

          studentData && studentData['College'],

          studentData && studentData.College_Name,

          studentData && studentData.collegeName,

          studentData && studentData.college,

          options && options.collegeName,

          options && options.CollegeName,

          options && options.college,

          options && options.College

        ];

        candidateColleges.forEach(col => {

          if (!col) return;

          let cleanCol = String(col).trim().replace(/\.+$/, '');

          if (cleanCol.indexOf(',') !== -1) {

            const parts = cleanCol.split(',');

            cleanCol = parts[0].trim();

            const dPart = parts.slice(1).join(',').trim();

            if (dPart && dPart.length >= 2 && dPart.toUpperCase() !== 'N/A') {

              applyItalicSafe(dPart);

            }

          }

          if (cleanCol.length >= 3 && cleanCol.toUpperCase() !== 'N/A') {

            applyBoldSafe(cleanCol);

          }

        });



        // Fallback: Extract college and district from sentence structure "... at <COLLEGE_NAME>, <DISTRICT>, successfully completed ..."

        const freshBodyTxt = bodyPara.getText() || '';

        const mCollege = freshBodyTxt.match(/\bat\s+([A-Za-z0-9\s.&'\(\)-]+?)(?:,\s*([A-Za-z0-9\s.&'\(\)-]+?))?(?=[,\s]+successfully)/i);

        if (mCollege) {

          if (mCollege[1]) {

            const extractedCol = mCollege[1].trim().replace(/^,\s*/, '').replace(/[,\s]+$/, '').trim();

            if (extractedCol.length >= 3 && extractedCol.toUpperCase() !== 'N/A') {

              applyBoldSafe(extractedCol);

            }

          }

          if (mCollege[2]) {

            const extractedDist = mCollege[2].trim().replace(/^,\s*/, '').replace(/[,\s]+$/, '').trim();

            if (extractedDist.length >= 2 && extractedDist.toUpperCase() !== 'N/A') {

              applyItalicSafe(extractedDist);

            }

          }

        }



        // 7. Ensure College District from studentData / options is formatted as Italic (NOT bold)

        const candidateDistricts = [

