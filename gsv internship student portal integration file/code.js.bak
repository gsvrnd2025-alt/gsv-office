// ══════════════════════════════════════════════════════════════════════

// HELPER: Purge positioned images from a document using Docs REST API via UrlFetchApp

// Works directly using OAuth Bearer token with documents scope.

// ══════════════════════════════════════════════════════════════════════

function purgeAllPositionedImages_(docId, skipFirst) {

  try {

    const token = ScriptApp.getOAuthToken();

    const getUrl = 'https://docs.googleapis.com/v1/documents/' + docId;

    const response = UrlFetchApp.fetch(getUrl, {

      headers: { 'Authorization': 'Bearer ' + token },

      muteHttpExceptions: true

    });

    

    if (response.getResponseCode() !== 200) {

      Logger.log('purgeAllPositionedImages_ GET failed with code ' + response.getResponseCode() + ': ' + response.getContentText());

      return;

    }

    

    const docsData = JSON.parse(response.getContentText());

    if (!docsData || !docsData.positionedObjects) return;

    

    const objectIds = Object.keys(docsData.positionedObjects);

    Logger.log('purgeAllPositionedImages_: found ' + objectIds.length + ' positioned objects in doc ' + docId + ': ' + JSON.stringify(objectIds));

    

    if (objectIds.length === 0) return;

    

    // Determine which IDs to delete

    const toDelete = skipFirst ? objectIds.slice(1) : objectIds;

    if (toDelete.length === 0) return;

    

    // Build batch delete requests

    const requests = toDelete.map(id => ({

      deletePositionedObject: { objectId: id }

    }));

    

    const batchUrl = 'https://docs.googleapis.com/v1/documents/' + docId + ':batchUpdate';

    const batchResponse = UrlFetchApp.fetch(batchUrl, {

      method: 'post',

      contentType: 'application/json',

      headers: { 'Authorization': 'Bearer ' + token },

      payload: JSON.stringify({ requests: requests }),

      muteHttpExceptions: true

    });

    

    Logger.log('purgeAllPositionedImages_ batchUpdate response: ' + batchResponse.getResponseCode() + ' ' + batchResponse.getContentText());

  } catch(e) {

    Logger.log('purgeAllPositionedImages_ error: ' + e.toString());

  }

}



function getTemplateStructureDebug(templateId) {

  try {

    const tId = templateId || TEMPLATE_IDS.INTERNSHIP_CERTIFICATE_T2;

    const token = ScriptApp.getOAuthToken();

    const getUrl = 'https://docs.googleapis.com/v1/documents/' + tId;

    const response = UrlFetchApp.fetch(getUrl, {

      headers: { 'Authorization': 'Bearer ' + token },

      muteHttpExceptions: true

    });

    return {

      statusCode: response.getResponseCode(),

      data: JSON.parse(response.getContentText())

    };

  } catch(e) {

    return { error: e.toString() };

  }

}



