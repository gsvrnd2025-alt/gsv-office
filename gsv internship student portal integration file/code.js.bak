function manualGenerateCertificate(regId, options) {

  try {

    options = options || {};

    const sendEmail = options.sendEmail !== undefined ? options.sendEmail : true;

    const publishToStudent = (options.publishToStudent !== false && options.showToStudent !== false);

    options.publishToStudent = publishToStudent;

    const certificateResult = generateDocumentAndMail('internshipCertificate', regId, sendEmail, true, options);

    if (certificateResult.status === 'success') {

      return {

        status: 'success',

        message: 'Certificate generated and processed successfully.',

        certificateNo: certificateResult.certNumber,

        driveLink: certificateResult.driveLink || certificateResult.url,

        pdfUrl: certificateResult.driveLink || certificateResult.url,

        fileId: certificateResult.fileId,

        issuedDate: options.issuedDate || formatDate(new Date()),

        attendedDays: certificateResult.attendedDays

      };

    } else {

      return { status: 'error', message: 'Generation failed: ' + certificateResult.message };

    }

  } catch (e) {

    return { status: 'error', message: e.message };

  }

}



function getCertificateTriggerMode() {

  const settingsResult = getAppSettings();

  if (settingsResult.status === 'success' && settingsResult.settings) {

    return settingsResult.settings['CertificateTriggerMode'] || 'Auto';

  }

  return 'Auto';

}



function setCertificateTriggerMode(mode) {

  return saveAppSettings({ 'CertificateTriggerMode': mode });

}



// Replaces deleteStudentCompletely with Blacklist Logic


let _memDeletedCandidateSet = null;

function getDeletedCandidateSet_() {
  if (_memDeletedCandidateSet !== null) return _memDeletedCandidateSet;
  _memDeletedCandidateSet = new Set();
  try {
    const props = PropertiesService.getScriptProperties();
    const raw = props.getProperty('DELETED_CANDIDATE_IDS');
    if (raw) {
      const arr = JSON.parse(raw);
      if (Array.isArray(arr)) {
        arr.forEach(id => {
          const s = String(id || '').trim().toUpperCase();
          if (s) _memDeletedCandidateSet.add(s);
        });
      }
    }
  } catch(e) {
    Logger.log("getDeletedCandidateSet_ error: " + e.toString());
  }
  return _memDeletedCandidateSet;
}

function isCandidateDeleted(id) {
  if (!id) return false;
  try {
    const s = String(id).trim().toUpperCase();
    if (!s) return false;
    return getDeletedCandidateSet_().has(s);
  } catch(e) {
    return false;
  }
}

function markCandidateDeleted(id) {
  if (!id) return;
  try {
    const cleanId = String(id).trim().toUpperCase();
    if (!cleanId) return;
    const set = getDeletedCandidateSet_();
    if (!set.has(cleanId)) {
      set.add(cleanId);
      const props = PropertiesService.getScriptProperties();
      props.setProperty('DELETED_CANDIDATE_IDS', JSON.stringify(Array.from(set)));
    }
  } catch(e) {
    Logger.log("markCandidateDeleted error: " + e.toString());
  }
}

function clearDeletedCandidateMark(id) {
  if (!id) return;
  try {
    const props = PropertiesService.getScriptProperties();
    let deletedList = JSON.parse(props.getProperty('DELETED_CANDIDATE_IDS') || '[]');
    const cleanId = String(id).trim().toUpperCase();
    deletedList = deletedList.filter(x => x !== cleanId);
    props.setProperty('DELETED_CANDIDATE_IDS', JSON.stringify(deletedList));
  } catch(e) {}
}

function deleteStudentCompletely(identifier) {
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(35000);
    const targetIdUpper = String(identifier || '').trim().toUpperCase();
    if (!targetIdUpper) {
      return { status: 'error', message: 'No registration ID, phone, or register number provided.' };
    }

    // 1. Locate candidate across all registration sheets to discover canonical RegistrationID
    let canonicalRegId = "";
    let candidateName = "";
    let candidateMobile = "";
    let candidateUniReg = "";
    let candidateEmail = "";

    const candidateSheets = [
      SHEET_NAMES.REGISTRATIONS,
      SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations',
      SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations',
      SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations',
      SHEET_NAMES.FACULTY_CONSOLIDATED || 'Faculty_Consolidated_Internships',
      SHEET_NAMES.EMPLOYEE_CONSOLIDATED || 'Employee_Consolidated_Internships',
      SHEET_NAMES.APPRENTICE_CONSOLIDATED || 'Apprentice_Consolidated_Internships',
      SHEET_NAMES.CONSOLIDATED_INTERNSHIPS,
      'Closed and Opt-out'
    ];

    for (let sIdx = 0; sIdx < candidateSheets.length; sIdx++) {
      const sName = candidateSheets[sIdx];
      const sheet = getSheet(sName);
      if (!sheet || sheet.getLastRow() < 2) continue;
      const data = sheet.getDataRange().getValues();
      const headers = data[0].map(h => String(h || '').trim().toLowerCase().replace(/[\s_]/g, ''));
      const rIdCol = headers.findIndex(h => h === 'registrationid' || h === 'regid');
      const mobCol = headers.findIndex(h => h.includes('mobile') || h.includes('phone'));
      const uniCol = headers.findIndex(h => h === 'registernumber' || h === 'collegeregno' || h === 'staffid' || h === 'employeeid' || h === 'facultystaffid');
      const emailCol = headers.findIndex(h => h.includes('email') || h.includes('gmail'));
      const nameCol = headers.findIndex(h => h.includes('name'));

      for (let i = 1; i < data.length; i++) {
        const rowRId = rIdCol !== -1 ? String(data[i][rIdCol] || '').trim().toUpperCase() : '';
        const rowMob = mobCol !== -1 ? String(data[i][mobCol] || '').trim() : '';
        const rowUni = uniCol !== -1 ? String(data[i][uniCol] || '').trim().toUpperCase() : '';
        const rowEmail = emailCol !== -1 ? String(data[i][emailCol] || '').trim().toLowerCase() : '';

        if (rowRId === targetIdUpper || rowMob === targetIdUpper || rowUni === targetIdUpper || (rowEmail && rowEmail === targetIdUpper.toLowerCase())) {
          canonicalRegId = rowRId || targetIdUpper;
          candidateName = nameCol !== -1 ? String(data[i][nameCol] || '') : '';
          candidateMobile = rowMob;
          candidateUniReg = rowUni;
          candidateEmail = rowEmail;
          break;
        }
      }
      if (canonicalRegId) break;
    }

    if (!canonicalRegId) {
      canonicalRegId = targetIdUpper;
    }

    Logger.log(`[CASCADE DELETE] Commencing total wipe for candidate: ${canonicalRegId} (${candidateName})`);
    markCandidateDeleted(canonicalRegId);
    markCandidateDeleted(targetIdUpper);

    // 2. Collect all Drive files associated with candidate from FILE_MANAGER and GENERATED_DOCUMENTS
    const filesToTrash = new Set();
    const driveSheets = [
      { name: SHEET_NAMES.FILE_MANAGER, regColName: "StudentRegistrationID", fileIdColName: "FileID" },
      { name: SHEET_NAMES.GENERATED_DOCUMENTS, regColName: "StudentRegistrationID", fileIdColName: "PdfFileId" },
      { name: SHEET_NAMES.CERTIFICATE_DATA, regColName: "StudentRegistrationID", fileIdColName: "CertificatePdfId" },
      { name: SHEET_NAMES.PREVIEW_DOCUMENTS, regColName: "RegistrationID", fileIdColName: "FileID" }
    ];

    driveSheets.forEach(item => {
      try {
        const sh = getSheet(item.name);
        if (sh && sh.getLastRow() > 1) {
          const d = sh.getDataRange().getValues();
          const hdrs = d[0].map(h => String(h || '').trim().toLowerCase().replace(/[\s_]/g, ''));
          const rCol = hdrs.findIndex(h => h === item.regColName.toLowerCase().replace(/[\s_]/g, '') || h.includes('registration') || h === 'regid');
          const fCol = hdrs.findIndex(h => h === item.fileIdColName.toLowerCase().replace(/[\s_]/g, '') || h.includes('fileid') || h.includes('pdfid'));
          if (rCol !== -1 && fCol !== -1) {
            for (let i = 1; i < d.length; i++) {
              if (String(d[i][rCol] || '').trim().toUpperCase() === canonicalRegId && d[i][fCol]) {
                filesToTrash.add(String(d[i][fCol]).trim());
              }
            }
          }
        }
      } catch(e) {}
    });

    // 3. Trash all collected Drive files
    let trashedFilesCount = 0;
    filesToTrash.forEach(fId => {
      try {
        const file = DriveApp.getFileById(fId);
        if (file) {
          file.setTrashed(true);
          trashedFilesCount++;
        }
      } catch(fErr) {
        Logger.log(`Failed to trash file ${fId}: ${fErr.toString()}`);
      }
    });

    // 4. Trash the dedicated candidate folder in Drive
    try {
      const studentFolder = getOrCreateStudentFolder(canonicalRegId);
      if (studentFolder && studentFolder.getId() !== getSystemFolderId('uploads') && studentFolder.getId() !== DriveApp.getRootFolder().getId()) {
        const inFiles = studentFolder.getFiles();
        while (inFiles.hasNext()) {
          try {
            inFiles.next().setTrashed(true);
            trashedFilesCount++;
          } catch(e) {}
        }
        studentFolder.setTrashed(true);
        Logger.log(`Trashed candidate folder for ${canonicalRegId}`);
      }
    } catch(folderErr) {
      Logger.log(`Error trashing folder for ${canonicalRegId}: ${folderErr.toString()}`);
    }

    // 5. Cascade delete all rows matching candidate from ALL relevant sheets
    const sheetsToPurge = [
      // Registration Sheets
      { name: SHEET_NAMES.REGISTRATIONS, colKeywords: ['registrationid', 'regid', 'mobilenumber', 'registernumber'] },
      { name: SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations', colKeywords: ['registrationid', 'facultystaffid', 'staffid', 'mobilenumber'] },
      { name: SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations', colKeywords: ['registrationid', 'employeeid', 'mobilenumber'] },
      { name: SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations', colKeywords: ['registrationid', 'mobilenumber'] },
      { name: SHEET_NAMES.FACULTY_CONSOLIDATED || 'Faculty_Consolidated_Internships', colKeywords: ['registrationid', 'facultystaffid', 'staffid'] },
      { name: SHEET_NAMES.EMPLOYEE_CONSOLIDATED || 'Employee_Consolidated_Internships', colKeywords: ['registrationid', 'employeeid'] },
      { name: SHEET_NAMES.APPRENTICE_CONSOLIDATED || 'Apprentice_Consolidated_Internships', colKeywords: ['registrationid'] },
      { name: SHEET_NAMES.CONSOLIDATED_INTERNSHIPS, colKeywords: ['registrationid', 'regid', 'mobilenumber', 'registernumber'] },
      { name: 'Closed and Opt-out', colKeywords: ['registrationid', 'regid', 'mobilenumber', 'registernumber'] },
      { name: SHEET_NAMES.REJECTED_APPLICATIONS, colKeywords: ['registrationid', 'registernumber', 'mobile'] },

      // Operational & Records Sheets
      { name: SHEET_NAMES.CERTIFICATE_DATA, colKeywords: ['studentregistrationid', 'registrationid'] },
      { name: SHEET_NAMES.FACULTY_CERTIFICATE_DATA, colKeywords: ['studentregistrationid', 'registrationid', 'facultystaffid'] },
      { name: SHEET_NAMES.EMPLOYEE_CERTIFICATE_DATA, colKeywords: ['studentregistrationid', 'registrationid', 'employeeid'] },
      { name: SHEET_NAMES.APPRENTICE_CERTIFICATE_DATA, colKeywords: ['studentregistrationid', 'registrationid'] },
      { name: SHEET_NAMES.ATTENDANCE, colKeywords: ['studentregistrationid', 'registrationid'] },
      { name: SHEET_NAMES.ATTENDANCE_OTP, colKeywords: ['registrationid', 'studentid'] },
      { name: SHEET_NAMES.STUDENT_DIARY, colKeywords: ['studentregistrationid', 'registrationid'] },
      { name: SHEET_NAMES.TASKS, colKeywords: ['studentregistrationid', 'registrationid'] },
      { name: SHEET_NAMES.PROJECTS, colKeywords: ['studentregistrationid', 'registrationid'] },
      { name: SHEET_NAMES.FILE_MANAGER, colKeywords: ['studentregistrationid', 'registrationid'] },
      { name: SHEET_NAMES.GENERATED_DOCUMENTS, colKeywords: ['studentregistrationid', 'registrationid'] },
      { name: SHEET_NAMES.PREVIEW_DOCUMENTS, colKeywords: ['registrationid'] },
      { name: SHEET_NAMES.STUDENT_REQUESTS, colKeywords: ['registrationid', 'studentid'] },
      { name: SHEET_NAMES.ATTENDANCE_REQUESTS, colKeywords: ['registrationid', 'studentid'] },
      { name: SHEET_NAMES.ADMIN_NOTIFICATIONS, colKeywords: ['targetadminid', 'registrationid'] },
      { name: SHEET_NAMES.CHAT_MESSAGES, colKeywords: ['senderid', 'receiverid', 'registrationid'] },
      { name: 'RFID_Tags', colKeywords: ['registrationid', 'studentid'] },
      { name: 'User_Login', colKeywords: ['registrationid', 'userid', 'username'] }
    ];

    let totalRowsPurged = 0;
    sheetsToPurge.forEach(target => {
      try {
        const sh = getSheet(target.name);
        if (!sh || sh.getLastRow() < 2) return;
        const sData = sh.getDataRange().getValues();
        const sHdrs = sData[0].map(h => String(h || '').trim().toLowerCase().replace(/[\s_]/g, ''));

        // Find all matching column indices
        const matchingColIndices = [];
        target.colKeywords.forEach(kw => {
          const normKw = kw.toLowerCase().replace(/[\s_]/g, '');
          const idx = sHdrs.findIndex(h => h === normKw || h.includes(normKw));
          if (idx !== -1 && !matchingColIndices.includes(idx)) {
            matchingColIndices.push(idx);
          }
        });

        if (matchingColIndices.length === 0) return;

        // Traverse bottom to top and delete rows matching canonicalRegId, candidateMobile, candidateUniReg, or candidateEmail
        for (let r = sData.length - 1; r >= 1; r--) {
          let shouldDelete = false;
          for (let c = 0; c < matchingColIndices.length; c++) {
            const cellVal = String(sData[r][matchingColIndices[c]] || '').trim();
            const cellValUpper = cellVal.toUpperCase();
            if (cellValUpper === canonicalRegId || 
                (candidateMobile && cellVal === candidateMobile) || 
                (candidateUniReg && cellValUpper === candidateUniReg.toUpperCase()) ||
                (candidateEmail && cellVal.toLowerCase() === candidateEmail.toLowerCase())) {
              shouldDelete = true;
              break;
            }
          }
          if (shouldDelete) {
            sh.deleteRow(r + 1);
            totalRowsPurged++;
          }
        }
      } catch(shErr) {
        Logger.log(`Error purging sheet ${target.name}: ${shErr.toString()}`);
      }
    });

    // Unassign any RFID card held by candidate in RFID_Inventory
    try {
      const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY || 'RFID_Inventory');
      if (invSheet && invSheet.getLastRow() > 1) {
        const invData = invSheet.getDataRange().getValues();
        const invHdrs = invData[0].map(h => String(h || '').trim().toLowerCase().replace(/[\s_]/g, ''));
        const assignCol = invHdrs.findIndex(h => h === 'assignedto' || h === 'assignedtoid' || h === 'registrationid');
        const statCol = invHdrs.findIndex(h => h === 'status' || h === 'cardstatus');
        const dateCol = invHdrs.findIndex(h => h.includes('assigndate') || h.includes('assigneddate'));
        if (assignCol !== -1) {
          for (let i = 1; i < invData.length; i++) {
            const rowAssign = String(invData[i][assignCol] || '').trim().toUpperCase();
            if (rowAssign === canonicalRegId) {
              invSheet.getRange(i + 1, assignCol + 1).setValue('');
              if (statCol !== -1) invSheet.getRange(i + 1, statCol + 1).setValue('Available');
              if (dateCol !== -1) invSheet.getRange(i + 1, dateCol + 1).setValue('');
            }
          }
        }
      }
    } catch(invErr) {
      Logger.log(`Error clearing RFID inventory for ${canonicalRegId}: ${invErr.toString()}`);
    }

    if (typeof executionCache !== 'undefined' && executionCache.clear) {
      executionCache.clear();
    }
    try {
      const scriptCache = CacheService.getScriptCache();
      if (scriptCache) {
        scriptCache.removeAll([
          'app_data_all', 'app_data_pending', 'app_data_approved', 'app_data_completed',
          'student_' + canonicalRegId, 'dossier_' + canonicalRegId
        ]);
      }
    } catch(cErr) {}

    logActivity('Candidate Completely Erased', 'Admin', `Permanently deleted candidate ${canonicalRegId} (${candidateName || 'Candidate'}). Deleted ${totalRowsPurged} database rows and trashed ${trashedFilesCount} Google Drive files.`);

    return { 
      status: 'success', 
      message: `Candidate ${canonicalRegId} has been completely erased. All records (${totalRowsPurged} database rows, attendance, diary, certificates) and ${trashedFilesCount} Google Drive files have been permanently wiped.` 
    };
  } catch (e) {
    Logger.log("deleteStudentCompletely error: " + e.toString());
    return { status: 'error', message: 'Complete deletion failed: ' + e.message };
  } finally {
    lock.releaseLock();
  }
}

/**
 * Updates student profile data from Admin Edit Modal.

 * Finds row by RegistrationID.

 */

function updateStudentProfile(data) {

  if (!data.registrationId) return { status: 'error', message: 'Registration ID missing' };



  // 1. Check archive status & target status

  const isNewStatusOptOut = data.ApplicationStatus && (data.ApplicationStatus.toLowerCase() === 'opt-out' || data.ApplicationStatus.toLowerCase() === 'optout');

  if (isNewStatusOptOut) {

    const moveRes = updateApplicationStatus([data.registrationId], data.ApplicationStatus);

    return moveRes;

  }



  const isNewStatusArchived = data.ApplicationStatus && (data.ApplicationStatus.toLowerCase() === 'closed');

  

  const closedSheet = getSheet('Closed and Opt-out');

  let isCurrentlyArchived = false;

  let archivedRowIdx = -1;

  let archivedRowData = null;

  

  if (closedSheet) {

    const closedData = closedSheet.getDataRange().getValues();

    const closedHeaders = closedData[0];

    const closedRegIdCol = closedHeaders.indexOf("RegistrationID");

    if (closedRegIdCol !== -1) {

      for (let i = 1; i < closedData.length; i++) {

        if (String(closedData[i][closedRegIdCol]) === String(data.registrationId)) {

          isCurrentlyArchived = true;

          archivedRowIdx = i + 1;

          archivedRowData = closedData[i];

          break;

        }

      }

    }

  }



  // 2. Locate current student in main registrations or dedicated category sheets
  const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);
  let activeRegSheet = regSheet;
  let regData = regSheet ? regSheet.getDataRange().getValues() : [];
  let regHeaders = regData.length > 0 ? regData[0] : [];
  let regIdCol = regHeaders.indexOf('RegistrationID');
  let rowIndex = -1;

  if (regIdCol !== -1) {
    for (let i = 1; i < regData.length; i++) {
      if (String(regData[i][regIdCol]).trim().toUpperCase() === String(data.registrationId).trim().toUpperCase()) {
        rowIndex = i + 1;
        break;
      }
    }
  }

  // If not found in main Registrations sheet, check Faculty, Employee, Apprentice sheets
  if (rowIndex === -1 && !isCurrentlyArchived) {
    const moreSheets = [
      SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations',
      SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations',
      SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations'
    ];
    for (let sName of moreSheets) {
      const sh = getSheet(sName);
      if (sh) {
        const shData = sh.getDataRange().getValues();
        if (shData.length > 1) {
          const shHeaders = shData[0];
          const shRegCol = shHeaders.indexOf('RegistrationID');
          if (shRegCol !== -1) {
            for (let i = 1; i < shData.length; i++) {
              if (String(shData[i][shRegCol]).trim().toUpperCase() === String(data.registrationId).trim().toUpperCase()) {
                rowIndex = i + 1;
                activeRegSheet = sh;
                regData = shData;
                regHeaders = shHeaders;
                break;
              }
            }
          }
        }
      }
      if (rowIndex !== -1) break;
    }
  }

  // If not found in either, return error
  if (rowIndex === -1 && !isCurrentlyArchived) {
    return { status: 'error', message: 'Student not found' };
  }



  // 3. Handle Archiving/Recovery triggers

  if (isNewStatusArchived || isCurrentlyArchived) {

    // Determine the new status (fallback if undefined)

    let newStatus = data.ApplicationStatus;

    if (!newStatus) {

      if (isCurrentlyArchived) {

        const closedHeaders = closedSheet.getDataRange().getValues()[0];

        newStatus = archivedRowData[closedHeaders.indexOf('ApplicationStatus')] || 'Closed';

      } else {

        newStatus = regData[rowIndex - 1][regHeaders.indexOf('ApplicationStatus')] || 'Active';

      }

    }

    

    if (newStatus.toLowerCase() === 'opt-out' || newStatus.toLowerCase() === 'optout') {

      const moveRes = updateApplicationStatus([data.registrationId], newStatus);

      return moveRes;

    }

    

    // Call updateApplicationStatus to handle sheet move

    const moveRes = updateApplicationStatus([data.registrationId], newStatus);

    if (moveRes.status === 'error') {

      return moveRes;

    }

    

    // Determine target sheet and index

    let targetSheet;

    let targetRowIndex = -1;

    let targetHeaders;

    

    const targetIsArchivedNow = (newStatus.toLowerCase() === 'closed' || newStatus.toLowerCase() === 'opt-out' || newStatus.toLowerCase() === 'optout');

    

    if (targetIsArchivedNow) {

      targetSheet = getSheet('Closed and Opt-out');

      const targetData = targetSheet.getDataRange().getValues();

      targetHeaders = targetData[0];

      const targetRegIdCol = targetHeaders.indexOf('RegistrationID');

      for (let i = 1; i < targetData.length; i++) {

        if (String(targetData[i][targetRegIdCol]) === String(data.registrationId)) {

          targetRowIndex = i + 1;

          break;

        }

      }

    } else {

      targetSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

      const targetData = targetSheet.getDataRange().getValues();

      targetHeaders = targetData[0];

      const targetRegIdCol = targetHeaders.indexOf('RegistrationID');

      for (let i = 1; i < targetData.length; i++) {

        if (String(targetData[i][targetRegIdCol]) === String(data.registrationId)) {

          targetRowIndex = i + 1;

          break;

        }

      }

    }

    

    if (targetRowIndex === -1 || !targetSheet) {

      return { status: 'error', message: 'Failed to locate student after status move.' };

    }

    

    // Update other fields on the target sheet

    const keys = Object.keys(data);

    keys.forEach(key => {

      if (key === 'registrationId') return;

      const colIdx = targetHeaders.indexOf(key);

      if (colIdx !== -1) {

        let val = data[key];

        if (key === 'RFID_TagID' && val) {

          val = standardizeRfidFormat(val);

          if (val) val = "'" + val;

        }

        targetSheet.getRange(targetRowIndex, colIdx + 1).setValue(val);

      }

    });

    

    executionCache.delete(SHEET_NAMES.REGISTRATIONS);

    executionCache.delete('Closed and Opt-out');

    return { status: 'success', message: 'Profile updated successfully.' };

  }



  // 4. Standard Flow (student is not archived and not being archived)

  // Special handling for RFID Tag assignment

  if (data.RFID_TagID !== undefined) {

    const rawTag = String(data.RFID_TagID).trim();

    const newTag = standardizeRfidFormat(rawTag);

    const oldTag = standardizeRfidFormat(regData[rowIndex - 1][regHeaders.indexOf('RFID_TagID')] || "");



    // AUTO-UPDATE STATUS when RFID is assigned or cleared

    // Only update if the caller did not already provide ApplicationStatus/Status

    if (newTag !== oldTag && data.ApplicationStatus === undefined && data.Status === undefined) {

      const currentAppStatus = String(regData[rowIndex - 1][regHeaders.indexOf('ApplicationStatus')] || '').trim().toLowerCase();

      if (newTag) {

        // Card being assigned — do NOT change status to 'Assigned' anymore. Keep 'Approved' or 'Active'.

      } else {

        // Card being cleared — revert status from 'Assigned' back to 'Approved'

        if (currentAppStatus === 'assigned') {

          data.ApplicationStatus = 'Approved';

          data.Status = 'Approved';

        }

      }

    }



    if (newTag !== oldTag) {

      const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);

      const invHeaders = invSheet.getRange(1, 1, 1, invSheet.getLastColumn()).getValues()[0];

      const idColIdx = invHeaders.indexOf("RFID_TagID");

      const statusColIdx = invHeaders.indexOf("Status");

      const assignedColIdx = invHeaders.indexOf("AssignedTo");



      // 1. If there's a new tag, check if it's available or already assigned

      if (newTag) {

        // --- Expiry Validation Check ---

        const endDayIdx = regHeaders.indexOf('InternshipEndDate');

        const internEnd = regData[rowIndex - 1][endDayIdx];

        if (internEnd) {

          const ed = new Date(internEnd);

          ed.setHours(0, 0, 0, 0);

          const today = new Date();

          today.setHours(0, 0, 0, 0);

          if (today >= ed) {

            return { status: 'error', message: 'Assignment Denied: Internship period has ended for this student.' };

          }

        }

        // ------------------------------



        const invRowIdx = findRowIndexByValue(invSheet, newTag, 'RFID_TagID');

        if (invRowIdx !== -1) {

          const currentStatus = invSheet.getRange(invRowIdx, statusColIdx + 1).getValue();

          const currentHolder = invSheet.getRange(invRowIdx, assignedColIdx + 1).getValue();



          if (currentStatus === 'Assigned' && currentHolder && currentHolder !== data.registrationId) {

            return { status: 'error', message: `RFID Tag ${newTag} is already assigned to student ${currentHolder}. Duplicate assignments are not allowed.` };

          }

          if (currentStatus === 'Blocked') {

            return { status: 'error', message: `RFID Tag ${newTag} is currently BLOCKED and cannot be assigned.` };

          }



          // Mark as Assigned

          invSheet.getRange(invRowIdx, statusColIdx + 1).setValue('Assigned');

          invSheet.getRange(invRowIdx, assignedColIdx + 1).setValue(data.registrationId);

          invSheet.getRange(invRowIdx, invHeaders.indexOf("LastUpdated") + 1).setValue(new Date());
          syncRfidDataManagementEntry_(
            newTag,
            data.registrationId,
            'Assigned',
            'Admin',
            '',
            'Good',
            'Card assigned to student profile'
          );

        } else {

          // Unknown tags not in inventory cannot be assigned!

          return { status: 'error', message: `RFID Tag "${newTag}" does not exist in Inventory. Only registered inventory tags can be assigned.` };

        }

      }



      // 2. If there was an old tag, mark it as Available across all inventory rows
      if (oldTag) {
        const invAll = invSheet.getDataRange().getValues();
        const stdOldTag = standardizeRfidFormat(oldTag);
        for (let r = 1; r < invAll.length; r++) {
          const rTag = standardizeRfidFormat(invAll[r][idColIdx] || '');
          if (rTag === stdOldTag) {
            invSheet.getRange(r + 1, statusColIdx + 1).setValue('Available');
            invSheet.getRange(r + 1, assignedColIdx + 1).setValue('');
            if (invHeaders.indexOf("HandoverStatus") !== -1) {
              invSheet.getRange(r + 1, invHeaders.indexOf("HandoverStatus") + 1).setValue('Available');
            }
            invSheet.getRange(r + 1, invHeaders.indexOf("LastUpdated") + 1).setValue(new Date());
          }
        }
        if (!newTag) {
          syncRfidDataManagementEntry_(
            oldTag,
            data.registrationId,
            'Revoked',
            'Admin',
            'Admin',
            'Good',
            'Card unassigned from student profile; returned to pool'
          );
        }
      }
    }
  }

  // Update fields

  const keys = Object.keys(data);



  keys.forEach(key => {

    if (key === 'registrationId') return;

    const colIdx = regHeaders.indexOf(key);

    if (colIdx !== -1) {

      let val = data[key];

      // Force RFID Tag standardization and string storage

      if (key === 'RFID_TagID' && val) {

        val = standardizeRfidFormat(val);

        if (val) val = "'" + val;

      }

      regSheet.getRange(rowIndex, colIdx + 1).setValue(val);

    }

  });



  // If status was updated to Approved from Profile/Edit modal, trigger automated onboarding & document workflow

  if (data.ApplicationStatus && /^(?:approved)$/i.test(String(data.ApplicationStatus).trim())) {

    try {

      const currentAppStatus = String(regData[rowIndex - 1][regHeaders.indexOf('ApplicationStatus')] || '').trim().toLowerCase();

      if (currentAppStatus !== 'approved') {

        updateApplicationStatus([data.registrationId], 'Approved');

      }

    } catch(e) {

      Logger.log('Error triggering approved workflow in updateStudentProfile: ' + e);

    }

  }



  // If status was updated to Completed or Completion, trigger automated certificate generation workflow

  if (data.ApplicationStatus && /^(?:completed|completion)$/i.test(String(data.ApplicationStatus).trim())) {

    try {

      updateApplicationStatus([data.registrationId], data.ApplicationStatus);

    } catch(e) {

      Logger.log('Error triggering completed workflow in updateStudentProfile: ' + e);

    }

  }



  // Always invalidate cache when profile fields are updated in sheet

  if (typeof executionCache !== 'undefined' && executionCache.delete) {

    executionCache.delete(SHEET_NAMES.REGISTRATIONS);

    executionCache.delete(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS);

    executionCache.delete('Closed and Opt-out');

  }



  return { status: 'success', message: 'Profile updated successfully.' };

}

/**
 * Updates comprehensive student / faculty profile fields from Admin Dossier inline editor.
 * Guarantees Residential Address, Pincode, and District persist directly into Google Sheets.
 */
function updateStudentComprehensiveProfile(regId, updatedData) {
  try {
    if (!regId) return { status: 'error', message: 'Registration ID is missing.' };
    const payload = Object.assign({}, updatedData || {}, { registrationId: regId });
    if (payload.address) {
      payload.Address = payload.address;
      payload.ResidentialAddress = payload.address;
    }
    if (payload.pincode) {
      payload.Pincode = payload.pincode;
      payload.ResidentialPincode = payload.pincode;
    }
    if (payload.district) {
      payload.District = payload.district;
      payload.ResidentialDistrict = payload.district;
    }
    if (payload.department) payload.Department = payload.department;
    if (payload.college) payload.CollegeName = payload.college;
    if (payload.registerNumber) payload.RegisterNumber = payload.registerNumber;
    if (payload.batch) payload.Batch = payload.batch;
    if (payload.status) payload.ApplicationStatus = payload.status;
    return updateStudentProfile(payload);
  } catch(e) {
    Logger.log("updateStudentComprehensiveProfile error: " + e.toString());
    return { status: 'error', message: e.toString() };
  }
}



function deleteRowsByColumnValue(sheetName, colName, value) {

  const sheet = getSheet(sheetName);

  if (!sheet) return;



  const data = sheet.getDataRange().getValues();

  if (data.length < 1) return;



  let colIdx = data[0].indexOf(colName);



  // Fallback if header mismatch or StudentDiary variation

  if (colIdx === -1) {

    if (sheetName === SHEET_NAMES.STUDENT_DIARY) {

      colIdx = data[0].indexOf("RegID");

    }

  }



  if (colIdx === -1) return; // Column not found



  // iterating backwards to delete safely

  for (let i = data.length - 1; i >= 1; i--) {

    if (String(data[i][colIdx]) === String(value)) {

      sheet.deleteRow(i + 1);

    }

  }

}



/**

 * Generates certificate number in format: GSV/YY/TYPE/COLLEGE_CODE/SLNO

 * Uses MAX(SLNO) from existing data to ensure correct sequencing even if rows are deleted.

 */

function generateCertificateSerialNumber(studentData, certSheet) {

  const yearDigits = new Date().getFullYear().toString().slice(-2);



  let typeCode = 'C';

  const candCat = (typeof getCandidateCategory_ === 'function') 

    ? getCandidateCategory_(studentData) 

    : (studentData.CandidateType || studentData.InternshipType || '');

  const candCatStr = String(candCat || '').toLowerCase();

  const candTypeStr = String(studentData.CandidateType || studentData.InternshipType || '').toLowerCase();

  const eduType = (studentData.EducationType || studentData.Degree || '').toString().toLowerCase();

  if (candCatStr.includes('faculty') || candTypeStr.includes('fac')) {

    typeCode = 'CF';

  } else if (candCatStr.includes('employee') || candTypeStr.includes('emp')) {

    typeCode = 'E';

  } else if (candCatStr.includes('apprentice') || candTypeStr.includes('app')) {

    typeCode = 'A';

  } else if (eduType.includes('diploma')) {

    typeCode = 'D';

  } else if (eduType.includes('iti')) {

    typeCode = 'I';

  } else {

    typeCode = 'C';

  }

  const collegeCode = studentData.CollegeCode || '000';



  let nextNum = 1;

  if (certSheet) {

    // Robust Serial Numbering: Find Max(SlNo) in existing certificates

    const data = certSheet.getDataRange().getValues();

    const certNoCol = data[0].indexOf("CertificateNumber"); // Assuming header name



    let maxSlNo = 0;

    if (certNoCol !== -1 && data.length > 1) {

      for (let i = 1; i < data.length; i++) {

        const certNo = String(data[i][certNoCol]);

        // Format: GSV/YY/TYPE/CODE/SLNO

        // Split by '/' and take last part

        const parts = certNo.split('/');

        if (parts.length >= 5) {

          const slPart = parseInt(parts[parts.length - 1], 10);

          if (!isNaN(slPart) && slPart > maxSlNo) {

            maxSlNo = slPart;

          }

        }

      }

    }

    nextNum = maxSlNo + 1;

  }



  const slNo = String(nextNum).padStart(4, '0');



  return `GSV/${yearDigits}/${typeCode}/${collegeCode}/${slNo}`;

}



// Consolidated and cleaned up redundant updateApplicationStatus block.

// Functional logic moved to around line 3223.

















/**

 * Sends an email to a student or all students.

 * Renamed to sendAdminEmail to avoid conflicts.

 */

function sendAdminEmail(recipientRegId, subject, body) {

  Logger.log('sendAdminEmail CALLED_V3');

  try {

    if (!subject || !body) {

      return {

        status: 'error',

        message: 'Subject and Email Body are required.'

      };

    }

    let recipients = [];

    if (recipientRegId) {

      const student = getStudentDataForDoc(recipientRegId);

      if (student && student.GmailID) {

        recipients.push({

          email: student.GmailID,

          name: student.FirstName,

          fullName: student.FullName,

          registrationId: student.RegistrationID,

          startDate: student.FormattedStartDate,

          endDate: student.FormattedEndDate,

          collegeName: student.CollegeName,

          department: student.Department

        });

      } else {

        return {

          status: 'error',

          message: 'Student ' + recipientRegId + ' not found or has no email.'

        };

      }

    } else {

      const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

      const data = regSheet.getDataRange().getValues();

      const header = data[0];

      const gmailCol = header.indexOf('GmailID');

      const statusCol = header.indexOf('ApplicationStatus');

      const firstNameCol = header.indexOf('FirstName');

      const regIdCol = header.indexOf('RegistrationID');

      const startDateCol = header.indexOf('InternshipStartDate');

      const endDateCol = header.indexOf('InternshipEndDate');

      const collegeCol = header.indexOf('CollegeName');

      const deptCol = header.indexOf('Department');



      if ([gmailCol, statusCol, firstNameCol].includes(-1)) {

        Logger.log('Custom email column name mismatch in Registrations sheet. Headers: ' + JSON.stringify(header));

        return {

          status: 'error',

          message: 'Email sending config error (SCE_H_MM2).'

        };

      }



      for (let i = 1; i < data.length; i++) {

        if (data[i][gmailCol] && (data[i][statusCol] === 'Approved' || data[i][statusCol] === 'Active')) {

          recipients.push({

            email: data[i][gmailCol],

            name: data[i][firstNameCol],

            fullName: data[i][firstNameCol],

            registrationId: regIdCol !== -1 ? data[i][regIdCol] : 'N/A',

            startDate: startDateCol !== -1 ? formatDate(data[i][startDateCol]) : 'N/A',

            endDate: endDateCol !== -1 ? formatDate(data[i][endDateCol]) : 'N/A',

            collegeName: collegeCol !== -1 ? data[i][collegeCol] : 'N/A',

            department: deptCol !== -1 ? data[i][deptCol] : 'N/A'

          });

        }

      }

      if (recipients.length === 0) {

        return {

          status: 'info',

          message: 'No approved/active students found to send email to.'

        };

      }

    }



    let emailsSentCount = 0;

    recipients.forEach(recipient => {

      // Replace all placeholders with student data

      let personalizedBodyText = body;

      let personalizedSubject = subject;



      // Define all placeholder replacements (support both {{key}} and {key} formats)

      const replacements = {

        'studentName': recipient.fullName || recipient.name || 'Student',

        'StudentName': recipient.fullName || recipient.name || 'Student',

        'FullName': recipient.fullName || recipient.name || 'Student',

        'regId': recipient.registrationId || 'N/A',

        'RegId': recipient.registrationId || 'N/A',

        'RegistrationID': recipient.registrationId || 'N/A',

        'startDate': recipient.startDate || 'N/A',

        'StartDate': recipient.startDate || 'N/A',

        'InternshipStartDate': recipient.startDate || 'N/A',

        'endDate': recipient.endDate || 'N/A',

        'EndDate': recipient.endDate || 'N/A',

        'InternshipEndDate': recipient.endDate || 'N/A',

        'collegeName': recipient.collegeName || 'N/A',

        'CollegeName': recipient.collegeName || 'N/A',

        'department': recipient.department || 'N/A',

        'Department': recipient.department || 'N/A'

      };



      // Replace placeholders in both {{key}} and {key} formats

      for (const [key, value] of Object.entries(replacements)) {

        const doublePattern = new RegExp('\\{\\{' + key + '\\}\\}', 'gi');

        const singlePattern = new RegExp('\\{' + key + '\\}', 'gi');

        personalizedBodyText = personalizedBodyText.replace(doublePattern, value);

        personalizedBodyText = personalizedBodyText.replace(singlePattern, value);

        personalizedSubject = personalizedSubject.replace(doublePattern, value);

        personalizedSubject = personalizedSubject.replace(singlePattern, value);

      }



      const personalizedBodyHtml = personalizedBodyText.replace(/\n/g, '<br>');



      // Using the helper sendEmail function (which uses MailApp now)

      if (sendEmail(recipient.email, personalizedSubject, personalizedBodyText, personalizedBodyHtml)) {

        emailsSentCount++;

      }

    });



    logActivity('Custom Email Sent', 'Admin', 'Subject: ' + subject + '. Sent to ' + emailsSentCount + ' recipients.');

    createAdminNotification('Custom Email Dispatched', 'Email with subject ' + subject + ' sent to ' + emailsSentCount + ' students.');

    return {

      status: 'success',

      message: 'Email sent to ' + emailsSentCount + ' recipient(s).'

    };



  } catch (error) {

    Logger.log('Error in sendAdminEmail: ' + error.toString());

    return {

      status: 'error',

      message: 'Error sending custom email: ' + error.message

    };

  }

}



// =================================================================================

// DROPDOWN DATA HELPERS

// =================================================================================





// =================================================================================

// NOTIFICATIONS

// =================================================================================



function getAdminNotifications() {

  try {

    let merged = [];



    // 1. Fetch from 'Notifications'

    const sheet1 = getSheet(SHEET_NAMES.NOTIFICATIONS);

    if (sheet1) {

      const data1 = getSheetDataAsObjects(sheet1);

      merged = merged.concat(data1.map(row => ({

        NotificationID: row.ID,

        Title: row.Title || 'Notification',

        Message: row.Message || '',

        Timestamp: row.Timestamp,

        IsRead: row.IsRead === true || row.IsRead === "TRUE" || row.IsRead === "true"

      })));

    }



    // 2. Fetch from 'AdminNotifications'

    const sheet2 = getSheet(SHEET_NAMES.ADMIN_NOTIFICATIONS);

    if (sheet2) {

      const data2 = getSheetDataAsObjects(sheet2);

      merged = merged.concat(data2.map(row => ({

        NotificationID: row.NotificationID || row.ID,

        Title: row.Title || 'Admin Notification',

        Message: row.Message || '',

        Timestamp: row.Timestamp,

        IsRead: row.IsRead === true || row.IsRead === "TRUE" || row.IsRead === "true"

      })));

    }



    // Sort by timestamp desc

    merged.sort((a, b) => new Date(b.Timestamp || 0) - new Date(a.Timestamp || 0));



    // Return top 50

    return merged.slice(0, 50);

  } catch (e) {

    Logger.log("Error in getAdminNotifications: " + e.toString());

    return [];

  }

}



function markAllAdminNotificationsRead() {

  try {

    const sheetNames = [SHEET_NAMES.NOTIFICATIONS, SHEET_NAMES.ADMIN_NOTIFICATIONS];

    for (const sName of sheetNames) {

      const sheet = getSheet(sName);

      if (!sheet) continue;



      const data = sheet.getDataRange().getValues();

      const headers = data[0];

      const isReadIndex = headers.indexOf("IsRead");



      if (isReadIndex === -1) continue;



      let updated = false;

      for (let i = 1; i < data.length; i++) {

        if (data[i][isReadIndex] === false || String(data[i][isReadIndex]).toUpperCase() === 'FALSE') {

          sheet.getRange(i + 1, isReadIndex + 1).setValue(true);

          updated = true;

        }

      }

      if (updated) {

        executionCache.delete(sName); // Clear cache for the updated sheet

      }

    }

    SpreadsheetApp.flush();

    return { status: 'success' };

  } catch (e) {

    Logger.log("Error in markAllAdminNotificationsRead: " + e.toString());

    return { status: 'error', message: e.message };

  }

}



function deleteNotification(notificationId, regId) {

  try {

    const sId = String(notificationId);



    // Handle OTP notifications

    if (sId.startsWith('otp-')) {

      const otpKey = sId.replace('otp-', '');

      const sheet = getSheet(SHEET_NAMES.ATTENDANCE_OTP);

      if (sheet) {

        const data = sheet.getDataRange().getValues();

        const headers = data[0];

        const idCol = headers.indexOf("ID");

        const dateCol = headers.indexOf("TargetDate");

        const regCol = headers.indexOf("RegistrationID");

        let disCol = headers.indexOf("Dismissed");

        if (disCol === -1) {

          disCol = headers.length;

          sheet.getRange(1, disCol + 1).setValue("Dismissed");

        }

        for (let i = 1; i < data.length; i++) {

          const rowReg = String(data[i][regCol] || "").trim().toUpperCase();

          const rowId = String(data[i][idCol] || "");

          const rowDate = data[i][dateCol] instanceof Date ? formatDate(data[i][dateCol]) : String(data[i][dateCol] || "");

          if ((!regId || rowReg === String(regId).trim().toUpperCase()) && (rowId === otpKey || rowDate === otpKey)) {

            sheet.getRange(i + 1, disCol + 1).setValue(true);

            executionCache.delete(SHEET_NAMES.ATTENDANCE_OTP);

            SpreadsheetApp.flush();

            return { status: 'success', message: 'OTP Notification dismissed' };

          }

        }

      }

      return { status: 'success' };

    }



    // Handle Chat notifications (Private)

    if (sId.startsWith('chat-')) {

      const result = markNotificationRead(notificationId, regId); // Dismissing a chat notif = mark read

      executionCache.delete(SHEET_NAMES.CHAT_MESSAGES);

      SpreadsheetApp.flush();

      return result;

    }



    // Handle Batch notifications

    if (sId.startsWith('batch-')) {

      const result = markNotificationRead(notificationId, regId); // Dismissing a batch notif = update last check

      executionCache.delete(SHEET_NAMES.REGISTRATIONS);

      SpreadsheetApp.flush();

      return result;

    }



    const sheetNames = [SHEET_NAMES.ADMIN_NOTIFICATIONS, SHEET_NAMES.NOTIFICATIONS];

    for (const sName of sheetNames) {

      const sheet = getSheet(sName);

      if (!sheet) continue;



      const data = sheet.getDataRange().getValues();

      const headers = data[0];

      const idIndex = headers.indexOf("ID") !== -1 ? headers.indexOf("ID") : headers.indexOf("NotificationID");



      if (idIndex === -1) continue;



      for (let i = 1; i < data.length; i++) {
        if (String(data[i][idIndex]).trim() === String(notificationId).trim()) {
          const frozen = sheet.getFrozenRows() || 1;
          // Ensure at least one non-frozen row will always remain after deletion
          if (sheet.getMaxRows() <= frozen + 1) {
            sheet.insertRowAfter(sheet.getMaxRows());
          }
          sheet.deleteRow(i + 1);
          executionCache.delete(sName); // Clear cache for the updated sheet
          SpreadsheetApp.flush();
          return { status: 'success', message: 'Notification deleted' };
        }
      }

    }

    return { status: 'error', message: 'Notification not found' };

  } catch (e) {

    Logger.log("Error in deleteNotification: " + e.toString());

    return { status: 'error', message: e.message };

  }

}



function markAllStudentNotificationsRead(regId) {

  try {

    const studentId = String(regId || "").trim().toUpperCase();



    // 1. Mark AdminNotifications as read

    const sheet = getSheet(SHEET_NAMES.ADMIN_NOTIFICATIONS);

    if (sheet) {

      const data = sheet.getDataRange().getValues();

      const headers = data[0];

      const targetCol = headers.indexOf("TargetAdminID");

      const isReadCol = headers.indexOf("IsRead");



      if (targetCol !== -1 && isReadCol !== -1) {

        for (let i = 1; i < data.length; i++) {

          const tId = String(data[i][targetCol] || "").trim().toUpperCase();

          if (tId === studentId && (data[i][isReadCol] === false || String(data[i][isReadCol]).toUpperCase() === 'FALSE')) {

            sheet.getRange(i + 1, isReadCol + 1).setValue(true);

          }

        }

      }

    }



    // 2. Mark ChatMessages as read

    const chatSheet = getSheet(SHEET_NAMES.CHAT_MESSAGES);

    if (chatSheet) {

      const chatData = chatSheet.getDataRange().getValues();

      const receiverCol = chatData[0].indexOf("ReceiverID");

      const readCol = chatData[0].indexOf("IsReadByReceiver");



      if (receiverCol !== -1 && readCol !== -1) {

        for (let j = 1; j < chatData.length; j++) {

          const rId = String(chatData[j][receiverCol] || "").trim().toUpperCase();

          if (rId === studentId && (chatData[j][readCol] === false || String(chatData[j][readCol]).toUpperCase() === 'FALSE')) {

            chatSheet.getRange(j + 1, readCol + 1).setValue(true);

          }

        }

      }

    }



    // 3. Update LastChatCheck to clear Batch Notifications

    updateStudentLastChatCheck(regId, new Date().getTime());



    // 4. Mark Attendance OTP notifications as read

    const otpSheet = getSheet(SHEET_NAMES.ATTENDANCE_OTP);

    if (otpSheet) {

      const data = otpSheet.getDataRange().getValues();

      const headers = data[0];

      const regCol = headers.indexOf("RegistrationID");

      let readCol = headers.indexOf("IsRead");

      if (readCol === -1) {

        readCol = headers.length;

        otpSheet.getRange(1, readCol + 1).setValue("IsRead");

      }

      for (let i = 1; i < data.length; i++) {

        const rowReg = String(data[i][regCol] || "").trim().toUpperCase();

        if (rowReg === studentId) {

          otpSheet.getRange(i + 1, readCol + 1).setValue(true);

        }

      }

      executionCache.delete(SHEET_NAMES.ATTENDANCE_OTP);

    }



    SpreadsheetApp.flush();

    return { status: 'success', message: 'All notifications marked as read' };

  } catch (e) {

    return { status: 'error', message: e.message };

  }

}



function clearAllStudentNotifications(regId) {

  try {

    const studentId = String(regId || "").trim().toUpperCase();

    if (!studentId) return { status: 'error', message: 'Student ID required.' };



    // 1. Delete matching notifications from ADMIN_NOTIFICATIONS and NOTIFICATIONS

    const sheetNames = [SHEET_NAMES.ADMIN_NOTIFICATIONS, SHEET_NAMES.NOTIFICATIONS];

    sheetNames.forEach(sName => {

      const sheet = getSheet(sName);

      if (sheet && sheet.getLastRow() > 1) {

        const data = sheet.getDataRange().getValues();

        const headers = data[0];

        const targetCol = headers.indexOf("TargetAdminID") !== -1 ? headers.indexOf("TargetAdminID") : headers.indexOf("TargetID");

        if (targetCol !== -1) {

          // Delete from bottom up to preserve row indexes

          for (let i = data.length - 1; i >= 1; i--) {

            const tId = String(data[i][targetCol] || "").trim().toUpperCase();

            if (tId === studentId) {

              sheet.deleteRow(i + 1);

            }

          }

        }

        executionCache.delete(sName);

      }

    });



    // 2. Mark chat messages as read/dismissed

    const chatSheet = getSheet(SHEET_NAMES.CHAT_MESSAGES);

    if (chatSheet && chatSheet.getLastRow() > 1) {

      const chatData = chatSheet.getDataRange().getValues();

      const receiverCol = chatData[0].indexOf("ReceiverID");

      const readCol = chatData[0].indexOf("IsReadByReceiver");

      if (receiverCol !== -1 && readCol !== -1) {

        for (let j = 1; j < chatData.length; j++) {

          const rId = String(chatData[j][receiverCol] || "").trim().toUpperCase();

          if (rId === studentId) {

            chatSheet.getRange(j + 1, readCol + 1).setValue(true);

          }

        }

      }

      executionCache.delete(SHEET_NAMES.CHAT_MESSAGES);

    }



    // 3. Update LastChatCheck

    updateStudentLastChatCheck(regId, new Date().getTime());



    // 4. Dismiss all Attendance OTP notifications for this student

    const otpSheet = getSheet(SHEET_NAMES.ATTENDANCE_OTP);

    if (otpSheet) {

      const data = otpSheet.getDataRange().getValues();

      const headers = data[0];

      const regCol = headers.indexOf("RegistrationID");

      let disCol = headers.indexOf("Dismissed");

      if (disCol === -1) {

        disCol = headers.length;

        otpSheet.getRange(1, disCol + 1).setValue("Dismissed");

      }

      for (let i = 1; i < data.length; i++) {

        const rowReg = String(data[i][regCol] || "").trim().toUpperCase();

        if (rowReg === studentId) {

          otpSheet.getRange(i + 1, disCol + 1).setValue(true);

        }

      }

      executionCache.delete(SHEET_NAMES.ATTENDANCE_OTP);

    }



    SpreadsheetApp.flush();

    return { status: 'success', message: 'All notifications cleared successfully.' };

  } catch(e) {

    Logger.log("Error in clearAllStudentNotifications: " + e.toString());

    return { status: 'error', message: e.message };

  }

}



function deleteChatMessage(messageId, type) {

  try {

    const sheetName = type === 'batch' ? SHEET_NAMES.BATCH_CHAT : SHEET_NAMES.CHAT_MESSAGES;

    const sheet = getSheet(sheetName);

    if (!sheet) return { status: 'error', message: 'Sheet not found' };



    const data = sheet.getDataRange().getValues();

    const idIndex = data[0].indexOf("MessageID");



    if (idIndex === -1) return { status: 'error', message: 'ID column not found' };



    for (let i = 1; i < data.length; i++) {

      if (String(data[i][idIndex]) === String(messageId)) {

        sheet.deleteRow(i + 1);

        return { status: 'success', message: 'Message deleted' };

      }

    }

    return { status: 'error', message: 'Message not found' };

  } catch (e) {

    return { status: 'error', message: e.message };

  }

}



function clearAllNotifications() {
  try {
    const sheetNames = [SHEET_NAMES.NOTIFICATIONS, SHEET_NAMES.ADMIN_NOTIFICATIONS];
    for (const sName of sheetNames) {
      const sheet = getSheet(sName);
      if (!sheet) continue;

      const lastRow = sheet.getLastRow();
      if (lastRow > 1) {
        const lastCol = Math.max(1, sheet.getLastColumn());
        // Safe clear: clear contents without deleting physical rows,
        // preventing Google Sheets "Sorry, it is not possible to delete all non-frozen rows."
        sheet.getRange(2, 1, lastRow - 1, lastCol).clearContent();

        // Safely trim excess rows if sheet is very large, keeping frozen header + at least 1 non-frozen row
        const maxRows = sheet.getMaxRows();
        const frozen = sheet.getFrozenRows() || 1;
        const minRowsToKeep = Math.max(2, frozen + 1);
        if (maxRows > minRowsToKeep) {
          try {
            sheet.deleteRows(minRowsToKeep + 1, maxRows - minRowsToKeep);
          } catch(eDel) {}
        }
        executionCache.delete(sName); // Clear cache for the cleared sheet
      }
    }
    SpreadsheetApp.flush();
    return { status: 'success', message: 'All notifications cleared.' };
  } catch (e) {
    Logger.log("Error in clearAllNotifications: " + e.toString());
    return { status: 'error', message: e.message };
  }
}

function markNotificationRead(id, regId) {

  return markNotificationAsRead(id, regId);

}

