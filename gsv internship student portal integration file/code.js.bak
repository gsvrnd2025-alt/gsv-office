    ? getCandidateCategory_(studentData)
    : String(studentData.InternshipType || studentData.CandidateType || '').toLowerCase();

  const attended = (attStats && attStats.attendedDays !== undefined) ? attStats.attendedDays : (studentData.AttendedDays || studentData.DurationDays || 30);
  const total = (attStats && attStats.durationDays) ? attStats.durationDays : (studentData.DurationDays || 30);

  let badgeText = '📊 Official Attendance Record (Form-4)';
  let roleGreeting = `Dear <strong style="color: #0891b2; font-size: 20px;">${studentName}</strong>,`;
