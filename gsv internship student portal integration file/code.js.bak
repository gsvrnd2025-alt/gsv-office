function getGrandOfferLetterEmailBody(studentData, driveLink) {
  const studentName = studentData.FullName || studentData.StudentName || studentData.name || 'Student';
  const portalUrl = 'https://www.gsvee.in/gsv-internship-portal';

  const candType = String(studentData.InternshipType || studentData.CandidateType || (studentData.CollegeName && String(studentData.CollegeName).toLowerCase().includes('apprentice') ? 'Apprentice' : (studentData.CollegeName && String(studentData.CollegeName).toLowerCase().includes('faculty') ? 'Faculty' : 'Student'))).toLowerCase();

  let offerBadge = '📄 Official Internship Offer Letter';
  let roleGreeting = `Dear Student <strong style="color: #0f766e; font-size: 20px;">${studentName}</strong>,`;
  let introText = `🌟 We are pleased to formally offer you an internship position with <strong>${COMPANY_NAME}</strong>! Your technical profile and background have been shortlisted for our upcoming industrial training cohort.`;
  let portalBtnText = '🚀 Access Student Portal';

  if (candType.includes('faculty')) {
    offerBadge = '📄 Official Faculty Internship Offer Letter';
    roleGreeting = `Dear Faculty Member <strong style="color: #0f766e; font-size: 20px;">${studentName}</strong>,`;
    introText = `🌟 We are pleased to formally offer you a Faculty Internship &amp; Industrial Linkage immersion program with <strong>${COMPANY_NAME}</strong>!`;
    portalBtnText = '🚀 Access Faculty Portal';
  } else if (candType.includes('employee')) {
    offerBadge = '🏢 Official Corporate Training Offer Letter';
    roleGreeting = `Dear Professional <strong style="color: #0f766e; font-size: 20px;">${studentName}</strong>,`;
    introText = `🌟 We are pleased to confirm your Corporate Professional Internship &amp; Upskilling Program with <strong>${COMPANY_NAME}</strong>!`;
    portalBtnText = '🚀 Access Portal';
  } else if (candType.includes('apprentice')) {
    offerBadge = '🛠️ Official Apprenticeship Offer Letter';
    roleGreeting = `Dear Apprentice Trainee <strong style="color: #0f766e; font-size: 20px;">${studentName}</strong>,`;
    introText = `🌟 We are pleased to formally offer you an Industrial Apprenticeship placement with <strong>${COMPANY_NAME}</strong>!`;
    portalBtnText = '🚀 Access Trainee Portal';
  }

  return `
  <div style="font-family: 'Segoe UI', Arial, sans-serif; max-width: 680px; margin: 0 auto; background: #ffffff; border-radius: 18px; overflow: hidden; box-shadow: 0 12px 40px rgba(0,0,0,0.12); border: 1px solid #ccfbf1;">
    <!-- TEAL HEADER -->
    <div style="background: linear-gradient(135deg, #115e59 0%, #0f766e 50%, #14b8a6 100%); padding: 34px 28px 26px 28px; text-align: center; color: #ffffff;">
      <div style="margin-bottom: 14px;">
        <img src="cid:gsvLogo" alt="${COMPANY_NAME}" style="max-height: 50px; max-width: 280px; height: auto; display: inline-block;" />
      </div>
      <div style="font-size: 42px; margin-bottom: 10px; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.25));">🎉</div>
      <div style="display: inline-block; background: rgba(255,255,255,0.22); color: #ffffff; padding: 5px 18px; border-radius: 30px; font-size: 12px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 10px; border: 1px solid rgba(255,255,255,0.35);">
        ${offerBadge}
      </div>
      <h1 style="color: #ffffff; font-size: 25px; font-weight: 800; margin: 0 0 6px 0; letter-spacing: 0.5px; font-family: 'Georgia', serif;">
        Welcome to GSV Electrical Enterprises
      </h1>
      <div style="font-size: 14px; color: #ccfbf1; font-weight: 600;">
        ${COMPANY_NAME}
      </div>
    </div>

    <!-- MAIN BODY -->
    <div style="position: relative; padding: 36px 32px 28px 32px; background: #ffffff; color: #1e293b; line-height: 1.7;">
      <!-- Centered Faint Watermark embedded in UI -->
      <div style="height: 0; overflow: visible; text-align: center; opacity: 0.12; pointer-events: none;">
        <img src="cid:gsvWatermark" alt="" style="width: 270px; max-width: 75%; height: auto; display: inline-block; margin-top: 50px;" />
      </div>
      <div style="position: relative; z-index: 2;">
      <p style="font-size: 18px; margin: 0 0 16px 0; color: #0f172a;">
        ${roleGreeting}
      </p>

      <div style="background: #f0fdfa; border-left: 5px solid #14b8a6; padding: 16px 20px; border-radius: 0 12px 12px 0; margin-bottom: 24px; font-size: 15px; color: #134e4a;">
        ${introText}
      </div>

      <!-- CANDIDATE DETAILS CARD -->
      ${buildStudentDetailsEmailTable_(studentData)}

      <!-- CTA BUTTONS -->
      <div style="text-align: center; margin: 28px 0 12px 0;">
        ${driveLink ? `
        <a href="${driveLink}" style="display: inline-block; background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%); color: #ffffff; padding: 14px 34px; text-decoration: none; border-radius: 50px; font-weight: 700; font-size: 15px; box-shadow: 0 4px 16px rgba(20, 184, 166, 0.35); margin-right: 10px; margin-bottom: 8px;">
          📥 Download Offer Letter (PDF)
        </a>` : ''}
        <a href="${portalUrl}" style="display: inline-block; background: #0f172a; color: #ffffff; padding: 14px 28px; text-decoration: none; border-radius: 50px; font-weight: 700; font-size: 14px; margin-bottom: 8px;">
          ${portalBtnText}
        </a>
      </div>
      </div>
    </div>

    <!-- FOOTER -->
    <div style="background: #115e59; padding: 24px 30px; text-align: center; color: #ccfbf1;">
      <div style="font-size: 15px; font-weight: 800; color: #ffffff; margin-bottom: 4px;">⚡ ${COMPANY_NAME}</div>
      <div style="font-size: 12px; color: #a7f3d0; margin-bottom: 12px;">Satisfaction is our Achievement</div>
      <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; font-size: 12px;">
        <span>📞 ${COMPANY_CONTACT}</span>
        <span>🌐 <a href="https://www.${COMPANY_WEBSITE}" style="color: #ffffff; text-decoration: underline;">${COMPANY_WEBSITE}</a></span>
        <span>📧 ${ADMIN_EMAIL_ID}</span>
      </div>
      <div style="margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.15); font-size: 11px; color: #a7f3d0;">
        © ${new Date().getFullYear()} ${COMPANY_NAME}. All Rights Reserved. Official Digital Credential Notification.
      </div>
    </div>
  </div>`;
}

