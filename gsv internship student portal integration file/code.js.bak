          studentData && studentData.collegeDistrict,

          options && options.collegeDistrict,

          options && options.CollegeDistrict,

          options && options.district,

          options && options.District

        ];

        candidateDistricts.forEach(dist => {

          if (!dist) return;

          const cleanDist = String(dist).trim().replace(/^,\s*/, '').replace(/[,\s]+$/, '');

          if (cleanDist.length >= 2 && cleanDist.toUpperCase() !== 'N/A') {

            applyItalicSafe(cleanDist);

          }

        });

      } catch(boldErr1) {

        Logger.log('Error bolding entities in bodyPara: ' + boldErr1);

      }

    }



    // Apply precise BOLD & NON-ITALIC formatting to Skill Learned in duringPara (Para 2)

    if (duringPara) {

      try {
        if (isT2) {
          // --- TEMPLATE 2 (Image 1): Set Times New Roman Italic, bold curSkill upright if present ---
          const t2Text = duringPara.editAsText();
          const len2 = duringPara.getText().length;
          if (len2 > 0) {
            t2Text.setFontFamily(0, len2 - 1, 'Times New Roman');
            t2Text.setFontSize(0, len2 - 1, effectiveBodyFontSize);
            t2Text.setForegroundColor(0, len2 - 1, '#000000');
            t2Text.setItalic(0, len2 - 1, true);
            t2Text.setBold(0, len2 - 1, false);
          }
          let t2Skill = (options && options.skillLearned) ? String(options.skillLearned).trim() : (studentData && (studentData.SkillLearned || studentData.InterestedArea || studentData.Track || studentData.ProjectTitle) ? String(studentData.SkillLearned || studentData.InterestedArea || studentData.Track || studentData.ProjectTitle).trim() : '');
          if (['applied electronics, iot & embedded systems', 'iot based electrical parameters data acquisition', 'n/a', '--'].includes(t2Skill.toLowerCase()) && !studentData.Batch && !options.skillLearned) {
            t2Skill = '';
          }
          if (t2Skill) {
            const fresh2 = duringPara.getText() || '';
            const reg2 = new RegExp(t2Skill.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&'), 'i');
            const m2 = fresh2.match(reg2);
            if (m2 && m2.index !== undefined) {
              const sPos2 = m2.index;
              const ePos2 = sPos2 + m2[0].length - 1;
              t2Text.setBold(sPos2, ePos2, true);
              t2Text.setItalic(sPos2, ePos2, false);
            }
          }
          if (perfPara) {
            const t3Text = perfPara.editAsText();
            const len3 = perfPara.getText().length;
            if (len3 > 0) {
              t3Text.setFontFamily(0, len3 - 1, 'Times New Roman');
              t3Text.setFontSize(0, len3 - 1, effectiveBodyFontSize);
              t3Text.setForegroundColor(0, len3 - 1, '#000000');
              t3Text.setItalic(0, len3 - 1, true);
              t3Text.setBold(0, len3 - 1, false);
            }
          }
        } else {
          // --- TEMPLATE 1 (Image 2): Existing logic ---
        let skillLearnedVal = (options && (options.skillLearned || options.SkillLearned || options.skill_learned || options.SKILL_LEARNED)) ? String(options.skillLearned || options.SkillLearned || options.skill_learned || options.SKILL_LEARNED).trim() : '';

        if (!skillLearnedVal || skillLearnedVal.toUpperCase() === 'N/A') {

          skillLearnedVal = (studentData && (studentData.SkillLearned || studentData['Skill Learned'] || studentData.InterestedArea || studentData.Track || studentData.Skills || studentData.ProjectTitle)) || '';

        }

        if (!skillLearnedVal || skillLearnedVal.toUpperCase() === 'N/A') {

          skillLearnedVal = 'Applied Electronics, IoT & Embedded Systems';

        }



        // Ensure any residual placeholders in duringPara are populated with skillLearnedVal

        const skillPlaceholders = [

          'SkillLearned', 'skilllearned', 'SKILL_LEARNED', 'skill_learned',

          'Skill_Learned', 'Skill Learned', 'skill learned', 'SKILL LEARNED',

          'SkillLearn', 'skill_learn', 'SKILL_LEARN', 'Skill Learn', 'skill learn', 'SKILL LEARN',

          'Skill', 'skill', 'SKILL'

        ];

        skillPlaceholders.forEach(ph => {

          try {

            duringPara.replaceText('\\{\\{\\s*' + ph.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&') + '\\s*\\}\\}', skillLearnedVal);

            duringPara.replaceText('\\{\\s*' + ph.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&') + '\\s*\\}', skillLearnedVal);

          } catch(ePh) {}

        });



        const t2 = duringPara.editAsText();

        let boldApplied = false;



        // Grammar & Skill cleanup: replace "learned" with "[he/she] specialized in"
        try {
          const candGender = (studentData && (studentData.Gender || studentData.gender || '')) ? String(studentData.Gender || studentData.gender).toLowerCase() : '';
          const candSal = (studentData && (studentData.Salutation || '')) ? String(studentData.Salutation).toLowerCase() : '';
          const isFem = candGender.includes('fem') || candSal.includes('ms') || candSal.includes('mrs');
          const pronounSubj = isFem ? 'she' : 'he';
          duringPara.replaceText('learned\\s+R&D\\s*\\(IoT\\s*&\\s*Electronics\\)', `${pronounSubj} specialized in ${skillLearnedVal}`);
          duringPara.replaceText('learned\\s+', `${pronounSubj} specialized in `);
          duringPara.replaceText('R&D\\s*\\(IoT\\s*&\\s*Electronics\\)', skillLearnedVal);
          bodyPara.replaceText('in\\s+R&D\\s*\\(IoT\\s*&\\s*Electronics\\)', `in ${skillLearnedVal}`);
        } catch(eGrammar) {}

        // Candidate strings for Skill Learned
        const candidateSkills = [

          skillLearnedVal,

          options && options.skillLearned,

          options && options.SkillLearned,

          options && options.skill_learned,

          options && options.projectTitle,

          options && options.ProjectTitle,

          studentData && studentData.SkillLearned,

          studentData && studentData['Skill Learned'],

          studentData && studentData.ProjectTitle,

          studentData && studentData.Project,

          studentData && studentData.WorkArea,

          studentData && studentData.InterestedArea

        ];



        // 1. Primary: Exact match on candidate skill strings

        candidateSkills.forEach(cand => {

          if (!cand || boldApplied) return;

          const cleanSub = String(cand).trim().replace(/\.+$/, '');

          if (cleanSub.length < 3 || cleanSub.toUpperCase() === 'N/A') return;

          try {

            const freshTxt = duringPara.getText() || '';

            const fLen = freshTxt.length;

            const reg = new RegExp(cleanSub.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&').replace(/\s+/g, '[\\s\\u00A0]+'), 'i');

            const m = freshTxt.match(reg);

            if (m && m.index !== undefined) {

              const sPos = m.index;

              const ePos = Math.min(sPos + m[0].length - 1, fLen - 1);

              if (sPos >= 0 && ePos >= sPos) {

                t2.setBold(sPos, ePos, true);

                t2.setItalic(sPos, ePos, false);

                t2.setForegroundColor(sPos, ePos, '#000000');

                t2.setFontSize(sPos, ePos, effectiveBodyFontSize);

                t2.setFontFamily(sPos, ePos, 'Times New Roman');

                boldApplied = true;

              }

            }

          } catch(eCand) {}

        });



        // 2. Secondary fallback: Match whatever text appears after "learned " (or "underwent training on ", etc.)

        if (!boldApplied) {

          const freshTxt = duringPara.getText() || '';

          const mLearned = freshTxt.match(/\b(?:learned|underwent training on|worked on|training on|project titled|domain|specialization)\s+/i);

          if (mLearned && mLearned.index !== undefined) {

            const startIdx = mLearned.index + mLearned[0].length;

            let endIdx = freshTxt.length - 1;

            while (endIdx > startIdx && /[\s.]/.test(freshTxt.charAt(endIdx))) {

              endIdx--;

            }

            if (startIdx <= endIdx && startIdx >= 0 && endIdx < freshTxt.length) {

              try {

                t2.setBold(startIdx, endIdx, true);

                t2.setItalic(startIdx, endIdx, false);

                t2.setForegroundColor(startIdx, endIdx, '#000000');

                t2.setFontSize(startIdx, endIdx, effectiveBodyFontSize);

                t2.setFontFamily(startIdx, endIdx, 'Times New Roman');

                boldApplied = true;

              } catch(eBoldM) {}

            }

          }

        }

      }         }
      catch(boldErr2) {

        Logger.log('Error in duringPara formatting: ' + boldErr2);

      }

    }



    // Ensure perfPara has the exact same bodyFontSize (14pt), Times New Roman, deep black #000000, Italic, NOT bold

    if (perfPara) {

      try {

        const t3 = perfPara.editAsText();

        const len3 = perfPara.getText().length;

        if (len3 > 0) {

          t3.setFontFamily(0, len3 - 1, 'Times New Roman');

          t3.setFontSize(0, len3 - 1, bodyFontSize);

          t3.setForegroundColor(0, len3 - 1, '#000000');

          t3.setItalic(0, len3 - 1, true);

          t3.setBold(0, len3 - 1, false);

        }

      } catch(perfErr) {

        Logger.log('Error setting perfPara font: ' + perfErr);

      }

    }

  } catch(e) {

    Logger.log('formatCertificateBodyExact_ error: ' + e);

  }

}



function ensureCertificateSinglePage_(body, studentData, options) {

  try {

    if (!body) return;



    // 1. Maintain margins matching ground truth (left: 56.7pt, right: 39pt, top: 12pt, bottom: 8pt)

    try {

      body.setMarginTop(12);

      body.setMarginBottom(8);

      body.setMarginLeft(42);

      body.setMarginRight(42);

    } catch(mErr) {}



    // 2. Ensure Title, CN/Date retain full template styling with minimal spacing

    const numChildren = body.getNumChildren();

    for (let ci = 0; ci < numChildren; ci++) {

      const child = body.getChild(ci);

      if (child.getType() === DocumentApp.ElementType.PARAGRAPH) {

        const p = child.asParagraph();

        const text = p.getText() || '';



        if (/INTERNSHIP\s*TRAINING\s*CERTIFICATE|INTERNSHIP\s*CERTIFICATE|CERTIFICATE\s*OF\s*COMPLETION|COMPLETION\s*CERTIFICATE/i.test(text)) {

          p.setSpacingBefore(2);

          p.setSpacingAfter(4);

          p.setLineSpacing(1.0);

          try {

            const t = p.editAsText();

            t.setFontFamily('UnifrakturMaguntia');

            t.setFontSize(22);

            t.setBold(true);

            t.setUnderline(true);

            t.setForegroundColor('#000000');

          } catch(e) {}

        } else if (/CN\s*:/i.test(text) && /DATE/i.test(text)) {

          p.setSpacingBefore(2);

          p.setSpacingAfter(2);

          p.setLineSpacing(1.0);

        }

      }

    }



    // 3. Ensure body paragraphs strictly retain justified alignment and auto-fit scale

    formatCertificateBodyExact_(body, studentData, options);



    // 4. Locate Footer Table and dynamically calibrate the spacer above it so it ALWAYS fits on Page 1

    const tables = body.getTables();

    let footerTbl = null;

    for (let t = 0; t < tables.length; t++) {

      if (tables[t].getNumRows() >= 2 && tables[t].getRow(0).getNumCells() === 3) {

        footerTbl = tables[t];

        break;

      }

    }



    if (footerTbl) {

      const tblIdx = body.getChildIndex(footerTbl);



      // Measure total text length in body paragraphs

      let totalBodyChars = 0;

      body.getParagraphs().forEach(p => {

        const txt = (p.getText() || '').trim();

        if (/This is to certify|During the internship|During the Tenure|conduct|performance/i.test(txt)) {

          totalBodyChars += txt.length;

        }

      });



      // Calibrate dynamic spacer before table using unified auto-fit layout engine

      // so it sits right above the footer banner without ever overflowing to page 2

      const fittedLayout = calculateCertificateFittedLayout_(totalBodyChars, options);

      const dynamicSpacerPts = fittedLayout.spacerBeforePts;



      // Check if there is a paragraph immediately preceding the footer table

      if (tblIdx > 0) {

        const prevEl = body.getChild(tblIdx - 1);

        if (isParagraphEffectivelyEmpty_(prevEl)) {

          const spP = prevEl.asParagraph();

          spP.setFontSize(1);

          try { spP.editAsText().setFontSize(1); } catch(e){}

          spP.setLineSpacing(1.0);

          spP.setSpacingBefore(dynamicSpacerPts);

          spP.setSpacingAfter(0);

        }

      }



      // Remove any extraneous empty paragraphs after footerTable, and collapse trailing paragraph

      for (let ci = body.getNumChildren() - 1; ci > tblIdx; ci--) {

        const child = body.getChild(ci);

        if (isParagraphEffectivelyEmpty_(child)) {

          if (ci > tblIdx + 1) {

            child.removeFromParent();

          } else {

            const ep = child.asParagraph();

            ep.setFontSize(1);

            ep.setSpacingBefore(0);

            ep.setSpacingAfter(0);

            ep.setLineSpacing(1.0);

          }

        }

      }

    }



    // 5. Always collapse trailing paragraph to 1pt to strictly prevent Page 2 overflow

    const lastChild = body.getChild(body.getNumChildren() - 1);

    if (isParagraphEffectivelyEmpty_(lastChild)) {

      const lp = lastChild.asParagraph();

      lp.setFontSize(1);

      lp.setSpacingBefore(0);

      lp.setSpacingAfter(0);

      lp.setLineSpacing(1.0);

    }

  } catch(e) {

    Logger.log("Error in ensureCertificateSinglePage_: " + e);

  }

}



function formatCertificateT2Footer_(body, includeDigitalSign, adminName, issuedDateFormatted, qrBlob, sigBlob, sealBlob, registrationId, options) {

  try {

    const rawDim = getAssetDimensions_(options);

    const dim = {

      sigWidth: Math.min(Math.max(rawDim.sigWidth || 105, 30), 280),

      sigHeight: Math.min(Math.max(rawDim.sigHeight || 36, 15), 160),

      sealWidth: Math.min(Math.max(rawDim.sealWidth || 65, 30), 150),

      sealHeight: Math.min(Math.max(rawDim.sealHeight || 65, 30), 150),

      qrWidth: Math.min(Math.max(rawDim.qrWidth || 58, 30), 110),

      qrHeight: Math.min(Math.max(rawDim.qrHeight || 58, 30), 110)

    };



    // 1. Clean stray placeholder tags from paragraphs without removing content text

    const placeholderRegex = /\{\{\s*(SIGNATURE|SEAL|QR_CODE|QRCode|ScanVerify|Signature|Seal|COMPANY_SEAL|PHYSICAL_SEAL|AUTHORIZED_SIGNATORY|SIGN|STAMP)\s*\}\}/gi;

    for (let pi = body.getNumChildren() - 1; pi >= 0; pi--) {

      const el = body.getChild(pi);

      if (el.getType() === DocumentApp.ElementType.PARAGRAPH) {

        const p = el.asParagraph();

        const txt = p.getText() || '';

        if (placeholderRegex.test(txt)) {

          const cleanedText = txt.replace(placeholderRegex, '').trim();

          if (cleanedText === '') {

            p.removeFromParent();

          } else {

            p.replaceText('\\{\\{\\s*(SIGNATURE|SEAL|QR_CODE|QRCode|ScanVerify|Signature|Seal|COMPANY_SEAL|PHYSICAL_SEAL|AUTHORIZED_SIGNATORY|SIGN|STAMP)\\s*\\}\\}', '');

          }

        }

      }

    }



    // 2. Locate original "Authorized Signatory" paragraph

    let authPara = null;

    const numChildren = body.getNumChildren();

    for (let i = 0; i < numChildren; i++) {

      const child = body.getChild(i);

      if (child.getType() === DocumentApp.ElementType.PARAGRAPH) {

        const p = child.asParagraph();

        if (p.getText().indexOf('Authorized Signatory') !== -1) {

          authPara = p;

          break;

        }

      }

    }



    // 3. Prune all empty spacer paragraphs above original "Authorized Signatory"

    if (authPara) {

      const authIndex = body.getChildIndex(authPara);

      let checkIndex = authIndex - 1;

      while (checkIndex >= 0) {

        const prevEl = body.getChild(checkIndex);

        if (isParagraphEffectivelyEmpty_(prevEl)) {

          prevEl.removeFromParent();

          checkIndex--;

        } else {

          break;

        }

      }

    }



    // Also prune any trailing empty paragraphs between the last body paragraph and authPara

    const allP = body.getParagraphs();

    let lastBodyPara = null;

    for (let pi = 0; pi < allP.length; pi++) {

      const pTxt = (allP[pi].getText() || '').trim();

      if (/conduct|performance/i.test(pTxt)) {

        lastBodyPara = allP[pi];

        break;

      }

    }

    if (lastBodyPara) {

      let bIdx = body.getChildIndex(lastBodyPara);

      while (bIdx + 1 < body.getNumChildren()) {

        const nextEl = body.getChild(bIdx + 1);

        if (nextEl === authPara) break;

        if (isParagraphEffectivelyEmpty_(nextEl)) {

          nextEl.removeFromParent();

        } else {

          break;

        }

      }

    }



    // 4. Calculate dynamic spacer height using unified layout engine so the footer table sits FIXED right above the footer banner

    const allParas = body.getParagraphs();

    let bodyTextLength = 0;

    for (let pi = 0; pi < allParas.length; pi++) {

      const pTxt = (allParas[pi].getText() || '').trim();

      if (/This is to certify|During the internship|During the Tenure|conduct|performance/i.test(pTxt)) {

        bodyTextLength += pTxt.length;

      }

    }



    const fittedT2Layout = calculateCertificateFittedLayout_(bodyTextLength, options);

    const spacerBeforePts = fittedT2Layout.spacerBeforePts;



    const insertIdx = authPara ? body.getChildIndex(authPara) : body.getNumChildren();

    const pSpacer = body.insertParagraph(insertIdx, ' ');

    pSpacer.setFontSize(1);

    try { pSpacer.editAsText().setFontSize(1); } catch(e) {}

    pSpacer.setLineSpacing(1.0);

    pSpacer.setSpacingBefore(spacerBeforePts);

    pSpacer.setSpacingAfter(0);



    // 5. Insert 2-row, 3-column borderless table

    // Row 0: Assets (Left: Signature / Digital Text / Manual Sign Space; Center: Company Seal; Right: Verification QR Code)

    // Row 1: Labels (Left: "Authorized Signatory" text; Center: Empty; Right: "Scan Verify" Link)

    const tblIndex = body.getChildIndex(pSpacer) + 1;

    const tbl = body.insertTable(tblIndex);

    tbl.setBorderWidth(0);

    try { tbl.setBorderColor('#ffffff'); } catch(e) {}



    // --- ROW 0: ASSETS ---

    const row0 = (tbl.getNumRows() > 0) ? tbl.getRow(0) : tbl.appendTableRow();

    const cellLeft = (row0.getNumCells() > 0) ? row0.getCell(0) : row0.appendTableCell();

    const cellCenter = (row0.getNumCells() > 1) ? row0.getCell(1) : row0.appendTableCell();

    const cellRight = (row0.getNumCells() > 2) ? row0.getCell(2) : row0.appendTableCell();



    cellLeft.setWidth(210);

    cellCenter.setWidth(135);

    cellRight.setWidth(135);



    [cellLeft, cellCenter, cellRight].forEach(c => {

      c.setPaddingTop(0);

      c.setPaddingBottom(0);

      c.setPaddingLeft(2);

      c.setPaddingRight(2);

    });



    // Left Cell in Row 0

    const pLeft = (cellLeft.getNumChildren() > 0) ? cellLeft.getChild(0).asParagraph() : cellLeft.appendParagraph(' ');

    pLeft.setAlignment(DocumentApp.HorizontalAlignment.LEFT);

    pLeft.setLineSpacing(1.0);

    pLeft.setSpacingBefore(0);

    pLeft.setSpacingAfter(0);



    if (sigBlob) {

      try {

        const imgSig = pLeft.appendInlineImage(sigBlob);

        imgSig.setWidth(dim.sigWidth);

        imgSig.setHeight(dim.sigHeight);

      } catch (e) {

        Logger.log("Error inserting sigBlob in T2: " + e);

      }

      // If BOTH physical signature and digital signature are enabled:

      // Place the digital signature confirmation directly below the signature doodle image in cellLeft (ABOVE Authorized Signatory!)

      if (includeDigitalSign) {

        const pDigi = cellLeft.appendParagraph(`Digitally Verified: GSV Portal (${adminName || 'Vijay Varman.S'}) on ${issuedDateFormatted}`);

        pDigi.setAlignment(DocumentApp.HorizontalAlignment.LEFT);

        pDigi.setLineSpacing(1.0);

        pDigi.setSpacingBefore(1);

        pDigi.setSpacingAfter(0);

        const tDigi = pDigi.editAsText();

        tDigi.setFontFamily('Times New Roman');

        tDigi.setFontSize(7.0);

        tDigi.setBold(true);

        tDigi.setItalic(true);

        tDigi.setForegroundColor('#1e3a8a');

      }

    } else if (includeDigitalSign) {

      const digitalText = `Digitally Signed and Generated on the Portal of\nGSV Electrical Enterprises (Internship Portal)\n(Admin: ${adminName || 'Vijay Varman.S'})\non ${issuedDateFormatted}`;

      pLeft.setText(digitalText);

      const tLeft = pLeft.editAsText();

      tLeft.setFontFamily('Times New Roman');

      tLeft.setFontSize(8.5);

      tLeft.setBold(true);

      tLeft.setForegroundColor('#0f172a');

    } else {

      // Manual signature mode: Both physical signature and digital signature disabled

      pLeft.setText('\n\n');

      pLeft.setFontSize(14);

      pLeft.setLineSpacing(1.1);

    }



    // Center Cell in Row 0: Company Seal

    const pCenter = (cellCenter.getNumChildren() > 0) ? cellCenter.getChild(0).asParagraph() : cellCenter.appendParagraph(' ');

    pCenter.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

    pCenter.setLineSpacing(1.0);

    pCenter.setSpacingBefore(0);

    pCenter.setSpacingAfter(0);



    if (sealBlob) {

      try {

        const imgSeal = pCenter.appendInlineImage(sealBlob);

        imgSeal.setWidth(dim.sealWidth);

        imgSeal.setHeight(dim.sealHeight);

      } catch (e) {

        Logger.log("Error inserting sealBlob in T2: " + e);

      }

    } else {

      pCenter.setText(' ');

      pCenter.setFontSize(1);

    }



    // Right Cell in Row 0: Verification QR Code

    const pRight = (cellRight.getNumChildren() > 0) ? cellRight.getChild(0).asParagraph() : cellRight.appendParagraph(' ');

    pRight.setAlignment(DocumentApp.HorizontalAlignment.RIGHT);

    pRight.setLineSpacing(1.0);

    pRight.setSpacingBefore(0);

    pRight.setSpacingAfter(0);



    if (qrBlob) {

      try {

        const imgQr = pRight.appendInlineImage(qrBlob);

        imgQr.setWidth(dim.qrWidth);

        imgQr.setHeight(dim.qrHeight);

      } catch (e) {

        Logger.log("Error inserting qrBlob in T2: " + e);

      }

    } else {

      pRight.setText(' ');

      pRight.setFontSize(1);

    }



    // --- ROW 1: LABELS (Authorized Signatory & Scan Verify) ---

    const row1 = tbl.appendTableRow();

    const cellLblLeft = row1.appendTableCell();

    const cellLblCenter = row1.appendTableCell();

    const cellLblRight = row1.appendTableCell();



    cellLblLeft.setWidth(210);

    cellLblCenter.setWidth(135);

    cellLblRight.setWidth(135);



    [cellLblLeft, cellLblCenter, cellLblRight].forEach(c => {

      c.setPaddingTop(1);

      c.setPaddingBottom(1);

      c.setPaddingLeft(2);

      c.setPaddingRight(2);

    });



    // Authorized Signatory Label (Left)

    // CRITICAL: The signature image contains only the pure doodle/strokes without text.

    // "Authorized Signatory" is printed here as template text in standard Times New Roman bold italic.

    const pAuth = (cellLblLeft.getNumChildren() > 0) ? cellLblLeft.getChild(0).asParagraph() : cellLblLeft.appendParagraph(' ');

    const signatoryFontSize = (options && options.signatoryFontSize) ? Number(options.signatoryFontSize) : 13.0;

    

    pAuth.setText('Authorized Signatory');

    pAuth.setAlignment(DocumentApp.HorizontalAlignment.LEFT);

    pAuth.setLineSpacing(1.0);

    pAuth.setSpacingBefore(0);

    pAuth.setSpacingAfter(0);

    const tAuth = pAuth.editAsText();

    tAuth.setFontFamily('Times New Roman');

    tAuth.setFontSize(signatoryFontSize);

    tAuth.setBold(true);

    tAuth.setItalic(true);

    tAuth.setForegroundColor('#000000');



    // Center Label (Empty)

    const pCenterLbl = (cellLblCenter.getChild(0) ? cellLblCenter.getChild(0).asParagraph() : cellLblCenter.appendParagraph(' '));

    pCenterLbl.setText(' ');

    pCenterLbl.setFontSize(1);

    pCenterLbl.setSpacingBefore(0);

    pCenterLbl.setSpacingAfter(0);



    // Scan Verify Link (Right)

    const pRightLbl = (cellLblRight.getNumChildren() > 0) ? cellLblRight.getChild(0).asParagraph() : cellLblRight.appendParagraph(' ');

    pRightLbl.setAlignment(DocumentApp.HorizontalAlignment.RIGHT);

    pRightLbl.setLineSpacing(1.0);

    pRightLbl.setSpacingBefore(0);

    pRightLbl.setSpacingAfter(0);

    if (qrBlob) {

      pRightLbl.setText('Scan Verify');

      const tScan = pRightLbl.editAsText();

      tScan.setFontFamily('Times New Roman');

      tScan.setFontSize(10.0);

      tScan.setBold(true);

      tScan.setItalic(true);

      tScan.setForegroundColor('#2563eb');

      tScan.setUnderline(true);

      const verifyUrl = "https://www.gsvee.in/gsv-internship-portal?verify=" + encodeURIComponent(registrationId || '');

      tScan.setLinkUrl(verifyUrl);

    } else {

      pRightLbl.setText(' ');

      pRightLbl.setFontSize(1);

    }



    // 6. Remove original authPara and thoroughly clean any leftover "Authorized Signatory" paragraphs in document body

    if (authPara) {

      try {

        authPara.removeFromParent();

      } catch(eRem) {

        try {

          authPara.setText(' ');

          authPara.setFontSize(1);

          authPara.setSpacingBefore(0);

          authPara.setSpacingAfter(0);

        } catch(e) {}

      }

    }



    for (let pi = body.getNumChildren() - 1; pi >= 0; pi--) {

      const el = body.getChild(pi);

      if (el.getType() === DocumentApp.ElementType.PARAGRAPH) {

        const p = el.asParagraph();

        if (p.getText().indexOf('Authorized Signatory') !== -1 && p.getParent() === body) {

          try {

            p.removeFromParent();

          } catch(eRem2) {

            p.setText(' ');

            p.setFontSize(1);

            p.setSpacingBefore(0);

            p.setSpacingAfter(0);

          }

        }

      }

    }



    // 7. Clean up any existing Note paragraphs after tbl to prevent duplication

    const tblIdx = body.getChildIndex(tbl);

    for (let pi = body.getNumChildren() - 1; pi > tblIdx; pi--) {

      const el = body.getChild(pi);

      if (el.getType() === DocumentApp.ElementType.PARAGRAPH) {

        const p = el.asParagraph();

        const pTxt = (p.getText() || '').trim();

        if (pTxt.indexOf('Note:') !== -1 || pTxt === '') {

          try {

            p.removeFromParent();

          } catch(eRemP) {

            try {

              p.clear();

              p.setText(' ');

              p.setFontSize(1);

              p.setSpacingBefore(0);

              p.setSpacingAfter(0);

            } catch(eClear) {}

          }

        }

      }

    }



    // 8. Verification Copy Note / Disclaimer toggle check:

    const shouldIncludeNote = (options && (options.addVerificationWatermark === true || options.addVerificationWatermark === 'true' || options.includeNote === true || options.includeNote === 'true'));

    try {

      body.replaceText('Note:\\s*This is only for verification copy.*', '');

      body.replaceText('Note:\\s*This is a provisional soft copy issued for temporary.*', '');

    } catch(eNoteClean) {}



    if (shouldIncludeNote) {

      const officialNote = "Note: This is a provisional soft copy issued for temporary / emergency verification purposes only. Physical hard copy verification is mandatory for official validity. In the absence of the verified physical hard copy, this soft copy document becomes invalid. Verify at: https://www.gsvee.in/gsv-internship-portal";

      const pNote = body.appendParagraph(officialNote);

      pNote.setFontFamily('Times New Roman');

      pNote.setFontSize(7.0);

      pNote.setItalic(true);

      pNote.setBold(true);

      pNote.setForegroundColor('#dc2626'); // VIBRANT RED WARNING COLOR

      pNote.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

      pNote.setSpacingBefore(4);

      pNote.setSpacingAfter(0);

      pNote.setLineSpacing(1.0);

    }



    // 9. Collapse any trailing empty paragraphs to 1pt to strictly guarantee single page

    for (let pi = body.getNumChildren() - 1; pi >= 0; pi--) {

      const el = body.getChild(pi);

      if (el.getType() === DocumentApp.ElementType.PARAGRAPH) {

        const p = el.asParagraph();

        if ((p.getText() || '').trim() === '') {

          p.setFontSize(1);

          p.setSpacingBefore(0);

          p.setSpacingAfter(0);

          p.setLineSpacing(1.0);

        } else {

          break;

        }

      }

    }

  } catch(e) {

    Logger.log("Error in formatCertificateT2Footer_: " + e);

  }

}



/**

 * Normalizes college name to ensure proper spacing between words.

 * Prevents concatenated text like 'VELAMMALINSTITUTEOFTECHNOLOGY' which triggers Google Docs justification gaps.

 */

function formatCollegeNameWithSpaces_(collegeName) {

  if (!collegeName) return '';

  let str = String(collegeName).trim();

  const map = {

    'VELAMMALINSTITUTEOFTECHNOLOGY': 'VELAMMAL INSTITUTE OF TECHNOLOGY',

    'VELAMMALENGINEERINGCOLLEGE': 'VELAMMAL ENGINEERING COLLEGE',

    'SAVETHAENGINEERINGCOLLEGE': 'SAVETHA ENGINEERING COLLEGE',

    'PANIMALARENGINEERINGCOLLEGE': 'PANIMALAR ENGINEERING COLLEGE',

    'RAJALAKSHMIENGINEERINGCOLLEGE': 'RAJALAKSHMI ENGINEERING COLLEGE',

    'SRIVENKATESWARACOLLEGEOFENGINEERING': 'SRI VENKATESWARA COLLEGE OF ENGINEERING'

  };

  const upper = str.toUpperCase().replace(/[^A-Z]/g, '');

  if (map[upper]) return map[upper];



  if (!str.includes(' ') && str.length > 15) {

    let res = str;

    res = res.replace(/INSTITUTEOFTECHNOLOGY/gi, ' INSTITUTE OF TECHNOLOGY');

    res = res.replace(/COLLEGEOFENGINEERING/gi, ' COLLEGE OF ENGINEERING');

    res = res.replace(/COLLEGEOFTECHNOLOGY/gi, ' COLLEGE OF TECHNOLOGY');

    res = res.replace(/ENGINEERINGCOLLEGE/gi, ' ENGINEERING COLLEGE');

    res = res.replace(/POLYTECHNICCOLLEGE/gi, ' POLYTECHNIC COLLEGE');

    res = res.replace(/INSTITUTE/gi, ' INSTITUTE ');

    res = res.replace(/TECHNOLOGY/gi, ' TECHNOLOGY ');

    res = res.replace(/ENGINEERING/gi, ' ENGINEERING ');

    res = res.replace(/COLLEGE/gi, ' COLLEGE ');

    res = res.replace(/UNIVERSITY/gi, ' UNIVERSITY ');

    res = res.replace(/POLYTECHNIC/gi, ' POLYTECHNIC ');

    res = res.replace(/([a-z])([A-Z])/g, '$1 $2');

    return res.replace(/\s+/g, ' ').trim();

  }

  return str;

}





