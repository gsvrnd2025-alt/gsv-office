/**

 * Marks all issued components for a specific student as Returned (used for Certificate NIL Clearance Gate)

 * @param {string} registrationId

 * @return {Object}

 */

function clearStudentComponents(registrationId) {

    try {

        if (!registrationId) return { status: 'error', message: 'Registration ID required' };

        var compSheet = getOrCreateSheetByName_(SHEET_NAMES.COMPONENTS_ISSUED);

        var data = compSheet.getDataRange().getValues();

        if (data.length <= 1) return { status: 'success', message: 'No components on record', count: 0 };

        var headers = data[0];

        var idCol = headers.indexOf('InchargeStudentID');

        var statusCol = headers.indexOf('Status');

        var retDateCol = headers.indexOf('ReturnDate');

        if (idCol === -1 || statusCol === -1) return { status: 'error', message: 'Schema missing' };

        var today = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');

        var count = 0;

        for (var i = 1; i < data.length; i++) {

            if (String(data[i][idCol]).trim().toUpperCase() === String(registrationId).trim().toUpperCase()) {

                if (String(data[i][statusCol]).trim().toLowerCase() !== 'returned') {

                    compSheet.getRange(i + 1, statusCol + 1).setValue('Returned');

                    if (retDateCol !== -1) compSheet.getRange(i + 1, retDateCol + 1).setValue(today);

                    count++;

                }

            }

        }

        return { status: 'success', message: 'Successfully cleared ' + count + ' component item(s) to Returned', count: count };

    } catch (e) {

        return { status: 'error', message: e.message };

    }

}





















