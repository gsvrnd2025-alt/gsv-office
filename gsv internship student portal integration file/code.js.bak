function debugAppFormInspection(regId) {

  regId = regId || 'GSV/2026/77/5I88';

  const out = { templateChildren: [], barcode: null, qr: null, errors: [] };

  try {

    const doc = DocumentApp.openById('1kzbHGvqITge2s4cqIIq4TyWbPPCM9I8RhCwQnOU27Sk');

    const body = doc.getBody();
    out.docHeader = doc.getHeader() ? doc.getHeader().getText() : 'NULL';
    out.docFooter = doc.getFooter() ? doc.getFooter().getText() : 'NULL';
    try {
      const root = body.getParent();
      out.rootChildren = [];
      for (let i = 0; i < root.getNumChildren(); i++) {
        const c = root.getChild(i);
        out.rootChildren.push({ idx: i, type: c.getType().toString(), text: (c.getText ? c.getText() : '').substring(0, 80) });
      }
    } catch(rErr) { out.rootError = rErr.toString(); }

    for (let i = 0; i < Math.min(body.getNumChildren(), 20); i++) {

      const el = body.getChild(i);

      const type = el.getType().toString();

      let text = '';

      if (el.getType() === DocumentApp.ElementType.PARAGRAPH) {

        text = el.asParagraph().getText();

      } else if (el.getType() === DocumentApp.ElementType.TABLE) {

        const tbl = el.asTable();

        text = 'TABLE rows=' + tbl.getNumRows();

        if (tbl.getNumRows() > 0) {

          const r0 = tbl.getRow(0);

          text += ' c0=' + r0.getCell(0).getText().substring(0, 40).replace(/\n/g, ' ');

          if (r0.getNumCells() > 1) {

            text += ' c1=' + r0.getCell(1).getText().substring(0, 40).replace(/\n/g, ' ');

          }

        }

      }

      out.templateChildren.push({ index: i, type: type, text: text.substring(0, 100) });

    }

  } catch(e) {

    out.errors.push('Template open error: ' + e.toString());

  }



  const cleanRegId = String(regId).trim();

  const barcodeUrls = [

    'https://bwipjs-api.metafloor.com/?bcid=code128&text=' + encodeURIComponent(cleanRegId) + '&scale=3&height=12&includetext=false',

    'https://quickchart.io/barcode?type=code128&text=' + encodeURIComponent(cleanRegId) + '&includeText=false&height=40&width=300',

    'https://barcode.tec-it.com/barcode.ashx?data=' + encodeURIComponent(cleanRegId) + '&code=Code128&translate-esc=on&unit=Fit&dpi=150'

  ];

  for (let u of barcodeUrls) {

    try {

      const resp = UrlFetchApp.fetch(u, { muteHttpExceptions: true });

      out.barcode = { url: u.substring(0, 35), code: resp.getResponseCode(), len: resp.getBlob().getBytes().length };

      if (resp.getResponseCode() === 200) break;

    } catch(e) {

      out.errors.push('Barcode error for ' + u.substring(0, 35) + ': ' + e.toString());

    }

  }



  const qrTargetUrl = 'https://www.gsvee.in/gsv-internship-portal?verify=' + encodeURIComponent(cleanRegId);

  const qrEndpoints = [

    'https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=' + encodeURIComponent(qrTargetUrl),

    'https://quickchart.io/qr?size=300&margin=1&text=' + encodeURIComponent(qrTargetUrl),

    'https://chart.googleapis.com/chart?cht=qr&chs=300x300&chl=' + encodeURIComponent(qrTargetUrl)

  ];

  for (let u of qrEndpoints) {

    try {

      const resp = UrlFetchApp.fetch(u, { muteHttpExceptions: true });

      out.qr = { url: u.substring(0, 35), code: resp.getResponseCode(), len: resp.getBlob().getBytes().length };

      if (resp.getResponseCode() === 200) break;

    } catch(e) {

      out.errors.push('QR error for ' + u.substring(0, 35) + ': ' + e.toString());

    }

  }



  return out;

}





