function submitStudentCertificateRequest(registrationId) {

  try {

    if (!registrationId) return { status: 'error', message: 'Missing Registration ID' };

    const regId = String(registrationId).trim().toUpperCase();



    const studentData = getStudentDataForDoc(regId);

    if (!studentData) return { status: 'error', message: 'Student record not found.' };



    const reqSheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

    if (!reqSheet) return { status: 'error', message: 'Requests system temporarily unavailable.' };



    const data = reqSheet.getDataRange().getValues();

    const header = data[0];

    const regIdCol = header.indexOf("StudentRegistrationID") !== -1 ? header.indexOf("StudentRegistrationID") : header.indexOf("RegistrationID");

    const typeCol = header.indexOf("RequestType") !== -1 ? header.indexOf("RequestType") : header.indexOf("Type");

    const statusCol = header.indexOf("Status");



    // Check if pending certificate request already exists

    if (regIdCol !== -1 && typeCol !== -1 && statusCol !== -1) {

      for (let i = 1; i < data.length; i++) {

        if (String(data[i][regIdCol]).toUpperCase() === regId &&

            String(data[i][typeCol]).toLowerCase().includes('certificate') &&

            String(data[i][statusCol]).toLowerCase() === 'pending') {

          return { status: 'info', message: 'You already have an active Certificate Request pending Admin review.' };

        }

      }

    }



    const newReq = {

      Timestamp: new Date(),

      RequestID: 'REQ-CERT-' + new Date().getTime().toString().slice(-6),

      StudentRegistrationID: regId,

      StudentName: studentData.FullName || studentData.Name || 'Student',

      Department: expandDepartmentFullName(studentData.Department || ''),

      RegisterNumber: studentData.RegisterNumber || '',

      RequestType: 'Certificate Request',

      Reason: 'Student requested completion certificate generation via portal.',

      Status: 'Pending',

      AdminRemarks: ''

    };



    appendObjectToSheet(reqSheet, newReq);

    logActivity('Certificate Request', studentData.GmailID || regId, 'Student requested completion certificate.');



    return { status: 'success', message: 'Certificate request submitted successfully to Admin.' };

  } catch (err) {

    Logger.log("Error in submitStudentCertificateRequest: " + err.toString());

    return { status: 'error', message: err.toString() };

  }

}





// ============================================================================

// OFFICIAL GSV DEPARTMENT EXPANSION & STANDARDIZATION UTILITIES

// ============================================================================

function expandDepartmentFullName(dept) {

  if (!dept) return '';

  const d = String(dept).trim();

  const map = {

    'ECE': 'Electronics and Communication Engineering',

    'EEE': 'Electrical and Electronics Engineering',

    'CSE': 'Computer Science and Engineering',

    'IT': 'Information Technology',

    'MECH': 'Mechanical Engineering',

    'MECHANICAL': 'Mechanical Engineering',

    'CIVIL': 'Civil Engineering',

    'EIE': 'Electronics and Instrumentation Engineering',

    'AIDS': 'Artificial Intelligence and Data Science',

    'AI & DS': 'Artificial Intelligence and Data Science',

    'AI&DS': 'Artificial Intelligence and Data Science',

    'AIML': 'Artificial Intelligence and Machine Learning',

    'AI & ML': 'Artificial Intelligence and Machine Learning',

    'AI&ML': 'Artificial Intelligence and Machine Learning',

    'BME': 'Biomedical Engineering',

    'MCT': 'Mechatronics Engineering',

    'AUTO': 'Automobile Engineering',

    'AUTOMOBILE': 'Automobile Engineering',

    'CHEM': 'Chemical Engineering',

    'CHEMICAL': 'Chemical Engineering',

    'AERO': 'Aeronautical Engineering',

    'AERONAUTICAL': 'Aeronautical Engineering',

    'RA': 'Robotics and Automation',

    'ROBOTICS': 'Robotics and Automation'

  };



  const upper = d.toUpperCase();

  if (map[upper]) return map[upper];



  // If input is formatted like "Electronics and Communication Engineering (ECE)", strip trailing code

  const stripped = d.replace(/\s*\([A-Za-z0-9\s&\/+-]+\)\s*$/, '').trim();

  if (map[stripped.toUpperCase()]) return map[stripped.toUpperCase()];



  // Return proper title case capitalization for custom department names

  if (stripped.length > 0) {

    return stripped.replace(/\b([a-z])/g, function(char) { return char.toUpperCase(); });

  }

  return d;

}



function standardizeDepartmentNamesInSheets() {

  Logger.log("Starting standardizeDepartmentNamesInSheets()...");

  const sheetsToCheck = [

    SHEET_NAMES.REGISTRATIONS,

    SHEET_NAMES.CERTIFICATE_DATA,

    SHEET_NAMES.CONSOLIDATED_TEMPLATE,

    SHEET_NAMES.CONSOLIDATED_INTERNSHIPS,

    'Closed and Opt-out'

  ];



  let totalUpdated = 0;

  sheetsToCheck.forEach(sheetName => {

    try {

      const sheet = getSheet(sheetName);

      if (!sheet) return;

      const data = sheet.getDataRange().getValues();

      if (data.length < 2) return;

      const header = data[0];



      let deptColIdx = -1;

      for (let c = 0; c < header.length; c++) {

        const hName = String(header[c] || '').trim().toLowerCase();

        if (hName === 'department' || hName === 'dept' || hName === 'branch') {

          deptColIdx = c;

          break;

        }

      }



      if (deptColIdx === -1) return;



      for (let r = 1; r < data.length; r++) {

        const originalVal = String(data[r][deptColIdx] || '').trim();

        if (originalVal) {

          const expanded = expandDepartmentFullName(originalVal);

          if (expanded && expanded !== originalVal) {

            sheet.getRange(r + 1, deptColIdx + 1).setValue(expanded);

            totalUpdated++;

          }

        }

      }

    } catch (err) {

      Logger.log(`Error updating departments in ${sheetName}: ${err.toString()}`);

    }

  });



  Logger.log(`Finished standardizeDepartmentNamesInSheets. Total records updated: ${totalUpdated}`);

  return { status: 'success', updatedCount: totalUpdated };

}



// ============================================================================



/**

 * UNIFIED BULK ATTENDANCE ENGINE (Single Source of Truth)

 * Pre-indexes all attendance records and approved requests across all students once,

 * then accurately calculates real attended days, absent days, and attendance percentage

 * using the official calendar rules:

 * - Weekly Offs (Sundays) counted as Present

 * - Present, Late with Present, OD, WFH, Medical Leave (ML), Early Exit, Admin Approved counted as Present

 * - Absent, Unapproved Missed Logs, and Admin-Denied records marked as Absent

 */

function calculateBulkStudentAttendanceMap_() {

  try {

    const attSheet = getSheet(SHEET_NAMES.ATTENDANCE);

    const otpSheet = getSheet(SHEET_NAMES.ATTENDANCE_OTP);

    const reqSheet = getSheet(SHEET_NAMES.ATTENDANCE_REQUESTS);



    const toISODateStr_ = (val) => {

      if (!val) return null;

      if (val instanceof Date) return Utilities.formatDate(val, "GMT+5:30", "yyyy-MM-dd");

      let str = String(val).trim();

      if (/^\d{4}-\d{2}-\d{2}/.test(str)) return str.substring(0, 10);

      if (/^\d{1,2}[\/\-\.]\d{1,2}[\/\-\.]\d{4}/.test(str)) {

        let p = str.split(/[\/\-\.]/);

        return p[2] + '-' + p[1].padStart(2, '0') + '-' + p[0].padStart(2, '0');

      }

      let d = new Date(val);

      if (!isNaN(d.getTime())) return Utilities.formatDate(d, "GMT+5:30", "yyyy-MM-dd");

      return null;

    };



    const studentAttMap = {};

    if (attSheet) {

      const aData = getSheetDataAsObjects(attSheet);

      aData.forEach(r => {

        const rid = String(r.StudentRegistrationID || r.RegistrationID || r.RegID || '').trim().toUpperCase();

        if (rid) {

          if (!studentAttMap[rid]) studentAttMap[rid] = [];

          studentAttMap[rid].push(r);

        }

      });

    }



    const studentReqMap = {};

    if (otpSheet) {

      const rData = getSheetDataAsObjects(otpSheet);

      rData.forEach(r => {

        const rid = String(r.RegistrationID || r.StudentRegistrationID || r.RegID || '').trim().toUpperCase();

        const st = String(r.Status || '').trim().toLowerCase();

        if (rid && st === 'approved') {

          if (!studentReqMap[rid]) studentReqMap[rid] = [];

          studentReqMap[rid].push(r);

        }

      });

    }



    return {

      _calculateForStudent: function(studentData) {

        if (!studentData) return { totalWorkingDays: 0, durationDays: 0, attendedDays: 0, absentDays: 0, percentage: 100 };

        const rid = String(studentData.RegistrationID || studentData.RegistrationId || studentData.registrationId || studentData.RegID || '').trim().toUpperCase();

        const startISO = toISODateStr_(studentData.InternshipStartDate || studentData.StartDate || studentData.startDate);

        const endISO = toISODateStr_(studentData.InternshipEndDate || studentData.EndDate || studentData.endDate);

        const defDays = parseInt(studentData.DurationDays || studentData.Duration || studentData.durationDays || 30, 10);



        if (!startISO || !endISO) {

          return {

            totalWorkingDays: defDays,

            durationDays: defDays,

            attendedDays: defDays,

            absentDays: 0,

            percentage: 100

          };

        }



        let sParts = String(startISO).substring(0, 10).split('-');

        let current = new Date(parseInt(sParts[0], 10), parseInt(sParts[1], 10) - 1, parseInt(sParts[2], 10), 0, 0, 0, 0);

        let eParts = String(endISO).substring(0, 10).split('-');

        let end = new Date(parseInt(eParts[0], 10), parseInt(eParts[1], 10) - 1, parseInt(eParts[2], 10), 23, 59, 59, 999);



        let totalWorkingDays = 0;

        let attendedDays = 0;

        let absentDays = 0;

        let safety = 0;



        const myAttList = studentAttMap[rid] || [];

        const myReqList = studentReqMap[rid] || [];



        while (current <= end && safety < 500) {

          safety++;

          const dISO = toISODateStr_(current);

          const isSunday = (current.getDay() === 0);



          let dayAtt = myAttList.filter(r => toISODateStr_(r.Date) === dISO && String(r.Status || '').toUpperCase() !== 'DENIED' && String(r.ApprovalStatus || '').toUpperCase() !== 'DENIED');

          let attRecord = dayAtt.find(r => r.OutTime && r.OutTime !== '' && r.OutTime !== 'N/A') || dayAtt[0];

          let dayReq = myReqList.filter(r => toISODateStr_(r.TargetDate) === dISO);



          let isAttended = false;

          if (isSunday) {

            isAttended = true; // Weekly off (Sunday) counted as Present

          } else if (attRecord) {

            const sLower = String(attRecord.Status || '').trim().toLowerCase();

            if (sLower.includes('present') || sLower.includes('late') || sLower.includes('early') || sLower === 'od' || sLower === 'wfh' || sLower.includes('medical') || sLower.includes('ml')) {

              isAttended = true;

            } else {

              absentDays++;

            }

          } else if (dayReq.length > 0) {

            isAttended = true;

          } else {

            absentDays++;

          }



          if (isAttended) attendedDays++;

          totalWorkingDays++;



          current.setDate(current.getDate() + 1);

        }



        const pct = totalWorkingDays > 0 ? Math.round((attendedDays / totalWorkingDays) * 100) : 100;

        return {

          totalWorkingDays: totalWorkingDays,

          durationDays: totalWorkingDays,

          attendedDays: attendedDays,

          absentDays: absentDays,

          percentage: pct

        };

      }

    };

  } catch (err) {

    Logger.log("calculateBulkStudentAttendanceMap_ error: " + err);

    return {

      _calculateForStudent: function(s) {

        const d = parseInt((s && (s.DurationDays || s.durationDays)) || 30, 10);

        return { totalWorkingDays: d, durationDays: d, attendedDays: d, absentDays: 0, percentage: 100 };

      }

    };

  }

}



/**

 * Retrieves detailed hard copy submission checklist for a student.

 * 9 Checklist Items:

 * 1. form1 (Application Form 1)

 * 2. form2 (Application Form 2)

 * 3. form3 (Application Form 3)

 * 4. diary (Student Diary Hard Copy)

 * 5. attendance (Attendance Sheet Hard Copy)

 * 6. bonafide (College Bonafide Certificate)

 * 7. declaration (Declaration Letter)

 * 8. materials (Components / Hardware Materials Returned)

 * 9. rfidCard (Physical RFID Card Returned)

 */

function getStudentHardCopyChecklist(registrationId) {

  try {

    if (!registrationId) return { status: 'error', message: 'Missing Registration ID' };

    const regId = String(registrationId).trim().toUpperCase();

    ensureCandidateSheetsExist_();
    const targetSheetName = getCandidateRegistrationSheetName_(candType);
    const regSheet = getSheet(targetSheetName) || getSheet(SHEET_NAMES.REGISTRATIONS);

    if (!regSheet) return { status: 'error', message: 'Registrations sheet not found' };



    const rData = regSheet.getDataRange().getValues();

    const rHeader = rData[0];

    const rRegCol = rHeader.indexOf("RegistrationID");

    const hcDetailsCol = rHeader.indexOf("HardCopyDetails");

    const hcStatusCol = rHeader.indexOf("HardCopyStatus") !== -1 ? rHeader.indexOf("HardCopyStatus") : rHeader.indexOf("HardCopy");



    let studentRow = null;

    for (let i = 1; i < rData.length; i++) {

      if (String(rData[i][rRegCol] || '').trim().toUpperCase() === regId) {

        studentRow = rData[i];

        break;

      }

    }



    if (!studentRow) return { status: 'error', message: `Student ${regId} not found` };



    let details = {};

    if (hcDetailsCol !== -1 && studentRow[hcDetailsCol]) {

      try {

        details = JSON.parse(studentRow[hcDetailsCol]);

      } catch(e) {

        details = {};

      }

    }



    const rawStatus = (hcStatusCol !== -1 && studentRow[hcStatusCol]) ? String(studentRow[hcStatusCol]).trim() : 'Not Submitted';

    const isSubmittedOverall = (rawStatus.toLowerCase() === 'submitted');

    const defaultChecked = isSubmittedOverall;



    const collegeIdChecked = (details.collegeId !== undefined) ? Boolean(details.collegeId) : 

                             ((details.declaration !== undefined) ? Boolean(details.declaration) : defaultChecked);



    const checklist = {

      form1: details.form1 !== undefined ? Boolean(details.form1) : defaultChecked,

      form2: details.form2 !== undefined ? Boolean(details.form2) : defaultChecked,

      form3: details.form3 !== undefined ? Boolean(details.form3) : defaultChecked,

      diary: details.diary !== undefined ? Boolean(details.diary) : defaultChecked,

      attendance: details.attendance !== undefined ? Boolean(details.attendance) : defaultChecked,

      bonafide: details.bonafide !== undefined ? Boolean(details.bonafide) : defaultChecked,

      collegeId: collegeIdChecked,

      declaration: collegeIdChecked,

      materials: details.materials !== undefined ? Boolean(details.materials) : defaultChecked,

      rfidCard: details.rfidCard !== undefined ? Boolean(details.rfidCard) : defaultChecked,

      notes: details.notes || '',

      updatedAt: details.updatedAt || '',

      updatedBy: details.updatedBy || ''

    };



    const submittedCount = ['form1', 'form2', 'form3', 'diary', 'attendance', 'bonafide', 'collegeId', 'materials', 'rfidCard']

      .filter(k => checklist[k] === true).length;



    return {

      status: 'success',

      registrationId: regId,

      studentName: String(studentRow[rHeader.indexOf("FirstName")] || studentRow[rHeader.indexOf("Name")] || ''),

      batch: String(studentRow[rHeader.indexOf("Batch")] || ''),

      checklist: checklist,

      submittedCount: submittedCount,

      totalCount: 9,

      overallStatus: submittedCount === 9 ? 'Submitted' : (submittedCount > 0 ? 'Partially Submitted' : 'Not Submitted')

    };

  } catch (err) {

    return { status: 'error', message: err.toString() };

  }

}



/**

 * Saves hard copy checklist and synchronizes across all relevant sheets.

 */

function saveStudentHardCopyChecklist(registrationId, checklist, notes) {

  try {

    if (!registrationId) return { status: 'error', message: 'Missing Registration ID' };

    const regId = String(registrationId).trim().toUpperCase();

    checklist = checklist || {};



    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (!regSheet) return { status: 'error', message: 'Registrations sheet not found' };



    const rData = regSheet.getDataRange().getValues();

    const rHeader = rData[0];

    const rRegCol = rHeader.indexOf("RegistrationID");

    let hcDetailsCol = rHeader.indexOf("HardCopyDetails");

    if (hcDetailsCol === -1) {

      hcDetailsCol = rHeader.length;

      regSheet.getRange(1, hcDetailsCol + 1).setValue("HardCopyDetails");

    }

    let hcStatusCol = rHeader.indexOf("HardCopyStatus");

    if (hcStatusCol === -1) hcStatusCol = rHeader.indexOf("HardCopy");

    if (hcStatusCol === -1) {

      hcStatusCol = rHeader.length + (hcDetailsCol === rHeader.length ? 1 : 0);

      regSheet.getRange(1, hcStatusCol + 1).setValue("HardCopyStatus");

    }



    let rowIndex = -1;

    for (let i = 1; i < rData.length; i++) {

      if (String(rData[i][rRegCol] || '').trim().toUpperCase() === regId) {

        rowIndex = i + 1;

        break;

      }

    }



    if (rowIndex === -1) return { status: 'error', message: `Student ${regId} not found` };



    const items = ['form1', 'form2', 'form3', 'diary', 'attendance', 'bonafide', 'collegeId', 'materials', 'rfidCard'];

    const cleanChecklist = {};

    let checkedCount = 0;

    

    // Support College ID Card (replacing/aliasing Declaration Letter)

    const collegeIdVal = (checklist.collegeId !== undefined) ? Boolean(checklist.collegeId) : Boolean(checklist.declaration);

    cleanChecklist.collegeId = collegeIdVal;

    cleanChecklist.declaration = collegeIdVal;



    ['form1', 'form2', 'form3', 'diary', 'attendance', 'bonafide', 'materials', 'rfidCard'].forEach(k => {

      cleanChecklist[k] = Boolean(checklist[k]);

    });

    items.forEach(k => {

      if (cleanChecklist[k]) checkedCount++;

    });



    const nowStr = Utilities.formatDate(new Date(), "GMT+5:30", "dd/MM/yyyy HH:mm");

    cleanChecklist.notes = String(notes || checklist.notes || '').trim();

    cleanChecklist.updatedAt = nowStr;

    cleanChecklist.updatedBy = 'Admin';



    const overallStatus = checkedCount === 9 ? 'Submitted' : (checkedCount > 0 ? 'Partially Submitted' : 'Not Submitted');



    regSheet.getRange(rowIndex, hcDetailsCol + 1).setValue(JSON.stringify(cleanChecklist));

    regSheet.getRange(rowIndex, hcStatusCol + 1).setValue(overallStatus);



    // Synchronize RFID Card return if rfidCard is checked

    if (cleanChecklist.rfidCard) {

      try {

        updateRfidPhysicalCardStatus(regId, 'Received');

        syncRfidDataManagementEntry_(null, regId, 'Returned', '', 'Admin', 'Good', 'Surrendered during hard copy clearance');

      } catch(e) {}

    }



    // Synchronize Hardware Materials return if materials is checked

    if (cleanChecklist.materials) {

      try {

        const compSheet = getSheet(SHEET_NAMES.COMPONENTS_ISSUED);

        if (compSheet) {

          const cData = compSheet.getDataRange().getValues();

          const cHeader = cData[0];

          const cStudentCol = cHeader.indexOf("InchargeStudentID") !== -1 ? cHeader.indexOf("InchargeStudentID") : cHeader.indexOf("StudentID");

          const cStatusCol = cHeader.indexOf("Status");

          if (cStudentCol !== -1 && cStatusCol !== -1) {

            for (let j = 1; j < cData.length; j++) {

              if (String(cData[j][cStudentCol] || '').trim().toUpperCase() === regId) {

                compSheet.getRange(j + 1, cStatusCol + 1).setValue("Returned");

                const cReturnCol = cHeader.indexOf("ReturnDate");

                if (cReturnCol !== -1) compSheet.getRange(j + 1, cReturnCol + 1).setValue(nowStr);

              }

            }

          }

        }

      } catch(e) {}

    }



    // Synchronize HardCopyStatus to Certificate Data sheet if present

    try {

      const certSheet = getSheet(SHEET_NAMES.CERTIFICATE_DATA);

      if (certSheet) {

        const cData = certSheet.getDataRange().getValues();

        const cHeader = cData[0];

        const cRegCol = cHeader.indexOf("StudentRegistrationID") !== -1 ? cHeader.indexOf("StudentRegistrationID") : cHeader.indexOf("RegistrationID");

        let cHcCol = cHeader.indexOf("HardCopyStatus");

        if (cHcCol === -1) cHcCol = cHeader.indexOf("HardCopy");

        if (cRegCol !== -1 && cHcCol !== -1) {

          for (let k = 1; k < cData.length; k++) {

            if (String(cData[k][cRegCol] || '').trim().toUpperCase() === regId) {

              certSheet.getRange(k + 1, cHcCol + 1).setValue(overallStatus);

            }

          }

        }

      }

    } catch(eCertSync) {

      Logger.log("saveStudentHardCopyChecklist cert sync warning: " + eCertSync);

    }



    SpreadsheetApp.flush();



    return {

      status: 'success',

      registrationId: regId,

      checklist: cleanChecklist,

      submittedCount: checkedCount,

      totalCount: 9,

      overallStatus: overallStatus,

      message: `Hard copy checklist updated (${checkedCount}/9 items submitted)`

    };

  } catch (err) {

    return { status: 'error', message: err.toString() };

  }

}



/**

 * Updates physical RFID card status for a student.

 * Status values: 'Not Issued', 'Issued', 'Received' (Returned to Admin)

 */

function updateRfidPhysicalCardStatus(registrationId, status) {

  try {

    if (!registrationId) return { status: 'error', message: 'Missing Registration ID' };

    const regId = String(registrationId).trim().toUpperCase();

    const newStatus = String(status || 'Issued').trim();



    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (!regSheet) return { status: 'error', message: 'Registrations sheet not found' };



    const rData = regSheet.getDataRange().getValues();

    const rHeader = rData[0];

    const rRegCol = rHeader.indexOf("RegistrationID");

    const rRfidCol = rHeader.indexOf("RFID_TagID");

    let physicalCol = rHeader.indexOf("RFID_PhysicalStatus");

    if (physicalCol === -1) {

      physicalCol = rHeader.length;

      regSheet.getRange(1, physicalCol + 1).setValue("RFID_PhysicalStatus");

    }

    let handoverCol = rHeader.indexOf("RFID_HandoverStatus");

    if (handoverCol === -1) {

      handoverCol = rHeader.length + (physicalCol === rHeader.length ? 1 : 0);

      regSheet.getRange(1, handoverCol + 1).setValue("RFID_HandoverStatus");

    }

    let lastRfidCol = rHeader.indexOf("Last_RFID_TagID");

    if (lastRfidCol === -1) {

      lastRfidCol = rHeader.length;

      regSheet.getRange(1, lastRfidCol + 1).setValue("Last_RFID_TagID");

    }



    for (let i = 1; i < rData.length; i++) {

      if (String(rData[i][rRegCol] || '').trim().toUpperCase() === regId) {

        const currentTag = String(rRfidCol !== -1 ? rData[i][rRfidCol] : '').trim();



        regSheet.getRange(i + 1, physicalCol + 1).setValue(newStatus);

        const handoverVal = (newStatus.toLowerCase() === 'issued') ? 'Handed Over' :

                            (newStatus.toLowerCase() === 'received' ? 'Returned' : 'Pending Handover');

        regSheet.getRange(i + 1, handoverCol + 1).setValue(handoverVal);



        // Sync with RFID Inventory (all matching rows, both by tag and regId)
        const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);
        if (invSheet && currentTag) {
          const normCurrentTag = standardizeRfidFormat(currentTag);
          const invData = invSheet.getDataRange().getValues();
          const invHeaders = invData[0];
          const tagCol = invHeaders.indexOf("RFID_TagID");
          const statusCol = invHeaders.indexOf("Status");
          const assignedCol = invHeaders.indexOf("AssignedTo");
          const hCol = invHeaders.indexOf("HandoverStatus");
          const updCol = invHeaders.indexOf("LastUpdated");

          if (tagCol !== -1) {
            for (let j = 1; j < invData.length; j++) {
              const rowTagVal = String(invData[j][tagCol] || '').trim();
              const rowNormTag = rowTagVal ? standardizeRfidFormat(rowTagVal) : '';
              const rowAssigned = String(assignedCol !== -1 ? invData[j][assignedCol] : '').trim().toUpperCase();

              const isMatch = (normCurrentTag && rowNormTag && normCurrentTag === rowNormTag) || 
                              (rowAssigned && (rowAssigned === regId || rowAssigned.includes(regId)));

              if (isMatch) {
                if (newStatus.toLowerCase() === 'received') {
                  // Student handed over card back to admin: card is now AVAILABLE in inventory pool!
                  if (statusCol !== -1) invSheet.getRange(j + 1, statusCol + 1).setValue("Available");
                  if (assignedCol !== -1) invSheet.getRange(j + 1, assignedCol + 1).setValue("");
                  if (hCol !== -1) invSheet.getRange(j + 1, hCol + 1).setValue("Returned");
                } else if (newStatus.toLowerCase() === 'issued') {
                  // Admin handed card to student: card is ASSIGNED and HANDED OVER (active for attendance)
                  if (statusCol !== -1) invSheet.getRange(j + 1, statusCol + 1).setValue("Assigned");
                  if (assignedCol !== -1) invSheet.getRange(j + 1, assignedCol + 1).setValue(regId);
                  if (hCol !== -1) invSheet.getRange(j + 1, hCol + 1).setValue("Handed Over");
                }
                if (updCol !== -1) invSheet.getRange(j + 1, updCol + 1).setValue(new Date());
              }
            }
          }
        }

        // Sync lifecycle audit record in RFID_Data_Management
        if (newStatus.toLowerCase() === 'received') {
          syncRfidDataManagementEntry_(
            currentTag,
            regId,
            'Returned',
            'Admin',
            'Admin',
            'Good',
            'Card physically returned to Admin; hard copy clearance verified'
          );
        } else if (newStatus.toLowerCase() === 'issued') {
          syncRfidDataManagementEntry_(
            currentTag,
            regId,
            'Handed Over',
            'Admin',
            '',
            'Good',
            'Card physically handed over to student; card active for attendance'
          );
        }

        let hcDetailsCol = rHeader.indexOf("HardCopyDetails");

        if (hcDetailsCol === -1) {

          hcDetailsCol = rHeader.length;

          regSheet.getRange(1, hcDetailsCol + 1).setValue("HardCopyDetails");

        }

        let hcStatusCol = rHeader.indexOf("HardCopyStatus");

        if (hcStatusCol === -1) hcStatusCol = rHeader.indexOf("HardCopy");

        if (hcStatusCol === -1) {

          hcStatusCol = rHeader.length + (hcDetailsCol === rHeader.length ? 1 : 0);

          regSheet.getRange(1, hcStatusCol + 1).setValue("HardCopyStatus");

        }



        let fullChecklist = null;



        // If received (returned to admin), clear active tag from student profile but store in Last_RFID_TagID

        if (newStatus.toLowerCase() === 'received') {

          if (currentTag) {

            if (rRfidCol !== -1) regSheet.getRange(i + 1, rRfidCol + 1).setValue("");

            if (lastRfidCol !== -1) regSheet.getRange(i + 1, lastRfidCol + 1).setValue(currentTag);

          }



          // Automatically mark student hard copy clearance as Submitted with all 9 items checked

          const nowStr = Utilities.formatDate(new Date(), "GMT+5:30", "dd/MM/yyyy HH:mm");

          fullChecklist = {

            form1: true,

            form2: true,

            form3: true,

            diary: true,

            attendance: true,

            bonafide: true,

            declaration: true,

            collegeId: true,

            materials: true,

            rfidCard: true,

            notes: 'Full physical clearance verified upon RFID card return',

            updatedAt: nowStr,

            updatedBy: 'Admin'

          };

          regSheet.getRange(i + 1, hcDetailsCol + 1).setValue(JSON.stringify(fullChecklist));

          regSheet.getRange(i + 1, hcStatusCol + 1).setValue('Submitted');



          // Synchronize with Certificate Data sheet

          try {

            const certSheet = getSheet(SHEET_NAMES.CERTIFICATE_DATA);

            if (certSheet) {

              const cData = certSheet.getDataRange().getValues();

              const cHeader = cData[0];

              const cRegCol = cHeader.indexOf("StudentRegistrationID") !== -1 ? cHeader.indexOf("StudentRegistrationID") : cHeader.indexOf("RegistrationID");

              let cHcCol = cHeader.indexOf("HardCopyStatus") !== -1 ? cHeader.indexOf("HardCopyStatus") : cHeader.indexOf("HardCopy");

              if (cRegCol !== -1 && cHcCol !== -1) {

                for (let k = 1; k < cData.length; k++) {

                  if (String(cData[k][cRegCol] || '').trim().toUpperCase() === regId) {

                    certSheet.getRange(k + 1, cHcCol + 1).setValue('Submitted');

                  }

                }

              }

            }

          } catch (eCertSync) {

            Logger.log("updateRfidPhysicalCardStatus cert sync warning: " + eCertSync);

          }

        }



        SpreadsheetApp.flush();

        logActivity('RFID Handover', 'Admin', `RFID Card ${currentTag ? `(#${currentTag})` : ''} status updated to '${newStatus}' (${handoverVal}) for ${regId}`);



        return {

          status: 'success',

          registrationId: regId,

          physicalStatus: newStatus,

          handoverStatus: handoverVal,

          hardCopyStatus: (newStatus.toLowerCase() === 'received') ? 'Submitted' : undefined,

          hardCopyChecklist: fullChecklist,

          message: (newStatus.toLowerCase() === 'received') 

            ? `RFID Card received from ${regId} and hard copy marked as Submitted.`

            : `RFID Card handed over to ${regId}. Card is now ACTIVE for attendance.`

        };

      }

    }

    return { status: 'error', message: `Student ${regId} not found` };

  } catch (err) {

    return { status: 'error', message: err.toString() };

  }

}



// ============================================================================

// RFID DATA MANAGEMENT & LIFECYCLE AUDIT ENGINE

// ============================================================================

const RFID_DATA_MGMT_HEADERS = [
  'RFID_TagID',
  'Barcode',
  'StudentRegistrationID',
  'RegisterNumber',
  'StudentName',
  'Category',
  'Batch',
  'CollegeName',
  'Department',
  'PhoneNumber',
  'Address',
  'PhotoUrl',
  'InternshipStartDate',
  'InternshipEndDate',
  'Status',
  'AssignedDate',
  'HandoverDate',
  'HandedOverBy',
  'PhysicalReceivedDate',
  'ReturnedDate',
  'ReceivedBy',
  'CardCondition',
  'Remarks',
  'LastUpdated'
];

function initRfidDataManagementSheet_() {
  const ss = (typeof getSpreadsheet === "function") ? getSpreadsheet() : (SpreadsheetApp.getActiveSpreadsheet() || SpreadsheetApp.openById(SPREADSHEET_ID));
  let sheet = ss.getSheetByName(SHEET_NAMES.RFID_MANAGEMENT);
  if (!sheet) {
    sheet = ss.insertSheet(SHEET_NAMES.RFID_MANAGEMENT);
  }
  if (sheet.getLastRow() === 0) {
    sheet.getRange(1, 1, 1, RFID_DATA_MGMT_HEADERS.length)
      .setValues([RFID_DATA_MGMT_HEADERS])
      .setFontWeight("bold")
      .setBackground("#1e293b")
      .setFontColor("#ffffff");
    sheet.setFrozenRows(1);
  } else {
    // Intelligent header migration: add missing headers to row 1
    try {
      const curHeaders = sheet.getRange(1, 1, 1, Math.max(sheet.getLastColumn(), 1)).getValues()[0];
      const missingHeaders = RFID_DATA_MGMT_HEADERS.filter(h => curHeaders.indexOf(h) === -1);
      if (missingHeaders.length > 0) {
        const startCol = curHeaders.length + 1;
        sheet.getRange(1, startCol, 1, missingHeaders.length)
          .setValues([missingHeaders])
          .setFontWeight("bold")
          .setBackground("#1e293b")
          .setFontColor("#ffffff");
      }
    } catch (eMigrate) {
      Logger.log("initRfidDataManagementSheet_ migration notice: " + eMigrate);
    }
  }
  return sheet;
}

function syncRfidDataManagementEntry_(tagId, regId, status, handedOverBy, receivedBy, condition, remarks) {
  try {
    if (!regId && !tagId) return;
    const sheet = initRfidDataManagementSheet_();
    const data = sheet.getDataRange().getValues();
    const headers = data[0];
    
    const tagCol = headers.indexOf("RFID_TagID");
    const barcodeCol = headers.indexOf("Barcode");
    const regCol = headers.indexOf("StudentRegistrationID");
    const regNoCol = headers.indexOf("RegisterNumber");
    const nameCol = headers.indexOf("StudentName");
    const catCol = headers.indexOf("Category");
    const batchCol = headers.indexOf("Batch");
    const collegeCol = headers.indexOf("CollegeName");
    const deptCol = headers.indexOf("Department");
    const phoneCol = headers.indexOf("PhoneNumber");
    const addrCol = headers.indexOf("Address");
    const photoCol = headers.indexOf("PhotoUrl");
    const startCol = headers.indexOf("InternshipStartDate");
    const endCol = headers.indexOf("InternshipEndDate");
    const statusCol = headers.indexOf("Status");
    const assignDateCol = headers.indexOf("AssignedDate");
    const handoverCol = headers.indexOf("HandoverDate");
    const handedByCol = headers.indexOf("HandedOverBy");
    const recvDateCol = headers.indexOf("PhysicalReceivedDate");
    const returnDateCol = headers.indexOf("ReturnedDate");
    const recvByCol = headers.indexOf("ReceivedBy");
    const condCol = headers.indexOf("CardCondition");
    const remCol = headers.indexOf("Remarks");
    const updatedCol = headers.indexOf("LastUpdated");

    const cleanRegId = String(regId || "").trim().toUpperCase();
    const cleanTagId = tagId ? standardizeRfidFormat(tagId) : "";

    // Candidate profile lookup
    let sInfo = {};
    if (cleanRegId) {
      try {
        const fullResp = getStudentFullData(cleanRegId);
        if (fullResp && fullResp.status === "success" && fullResp.studentData) {
          sInfo = fullResp.studentData;
        }
      } catch (e) {}
    }

    const candCat = sInfo ? (sInfo.CandidateType || ((typeof getCandidateCategory_ === "function") ? getCandidateCategory_(sInfo) : "Student")) : "Student";
    const isFac = (candCat === "Faculty") || ["GSV/2026/112/VH8C","GSV/2026/112/EQT4","GSV/2026/112/QYCG","GSV/2026/112/JDBI","GSV/2026/112/GONJ"].includes(cleanRegId) || cleanRegId.includes("/FAC/");
    const staffIdOrReg = (isFac ? (sInfo.FacultyStaffId || sInfo.StaffId) : null) || (candCat === "Employee" ? (sInfo.EmployeeId || sInfo.StaffId) : null) || sInfo.RegisterNumber || sInfo.RegNo || "";
    let resolvedName = (typeof getStudentFullName_ === "function") ? getStudentFullName_(sInfo) : (sInfo.FirstName || "Candidate");
    if (isFac) {
      resolvedName = resolvedName.replace(/^(?:mr\.|ms\.|mrs\.|dr\.|prof\.|mr|ms|mrs|dr|prof)\s+/i, "").trim();
      if (!resolvedName.startsWith("Prof.") && !resolvedName.startsWith("Dr.")) resolvedName = "Prof. " + resolvedName;
    }
    const resolvedBatch = sInfo.Batch || sInfo.batch || (isFac ? "Faculty Batch 1" : "");
    const resolvedCollege = sInfo.CollegeName || sInfo.College || "";
    const resolvedDept = sInfo.Department || sInfo.Dept || "";
    const resolvedPhone = sInfo.MobileNumber || sInfo.Mobile || sInfo.PhoneNumber || sInfo.Phone || sInfo.ContactNumber || "";
    const resolvedAddr = sInfo.Address || sInfo.ResidentialAddress || "";
    const resolvedPhoto = sInfo.ProfilePhotoUrl || sInfo.PhotoUrl || sInfo.Photo || "";
    const resolvedStart = sInfo.InternshipStartDate ? formatDateDMY(sInfo.InternshipStartDate) : "";
    const resolvedEnd = sInfo.InternshipEndDate ? formatDateDMY(sInfo.InternshipEndDate) : "";

    const resolvedTag = cleanTagId || (sInfo.RFID_TagID ? standardizeRfidFormat(sInfo.RFID_TagID) : (sInfo.Last_RFID_TagID ? standardizeRfidFormat(sInfo.Last_RFID_TagID) : ""));
    const resolvedBarcode = resolvedTag || cleanRegId;
    const nowStr = Utilities.formatDate(new Date(), "GMT+5:30", "dd/MM/yyyy HH:mm");
    const todayDate = Utilities.formatDate(new Date(), "GMT+5:30", "dd/MM/yyyy");

    // Search existing row by RegID or TagID
    let targetRow = -1;
    for (let i = 1; i < data.length; i++) {
      const rowReg = String(data[i][regCol] || "").trim().toUpperCase();
      const rowTag = String(data[i][tagCol] || "").trim();
      const rowNormTag = rowTag ? standardizeRfidFormat(rowTag) : "";
      if ((cleanRegId && rowReg === cleanRegId) || (resolvedTag && rowNormTag === resolvedTag)) {
        targetRow = i + 1;
        break;
      }
    }

    let currentStatus = String(status || "In Use").trim();
    if (isFac && currentStatus.toLowerCase() === "handed over") {
      currentStatus = "Assigned";
    }
    const isReturnedStatus = currentStatus.toLowerCase().includes("return") || currentStatus.toLowerCase().includes("revoke") || currentStatus.toLowerCase().includes("pool");

    if (targetRow > -1) {
      if (resolvedTag && tagCol !== -1) sheet.getRange(targetRow, tagCol + 1).setValue(resolvedTag);
      if (resolvedBarcode && barcodeCol !== -1) sheet.getRange(targetRow, barcodeCol + 1).setValue(resolvedBarcode);
      if (cleanRegId && regCol !== -1) sheet.getRange(targetRow, regCol + 1).setValue(cleanRegId);
      if (resolvedName && nameCol !== -1) sheet.getRange(targetRow, nameCol + 1).setValue(resolvedName);
      if (staffIdOrReg && regNoCol !== -1) sheet.getRange(targetRow, regNoCol + 1).setValue(staffIdOrReg);
      if (candCat && catCol !== -1) sheet.getRange(targetRow, catCol + 1).setValue(candCat);
      if (resolvedBatch && batchCol !== -1) sheet.getRange(targetRow, batchCol + 1).setValue(resolvedBatch);
      if (resolvedCollege && collegeCol !== -1) sheet.getRange(targetRow, collegeCol + 1).setValue(resolvedCollege);
      if (resolvedDept && deptCol !== -1) sheet.getRange(targetRow, deptCol + 1).setValue(resolvedDept);
      if (resolvedPhone && phoneCol !== -1) sheet.getRange(targetRow, phoneCol + 1).setValue(resolvedPhone);
      if (resolvedAddr && addrCol !== -1) sheet.getRange(targetRow, addrCol + 1).setValue(resolvedAddr);
      if (resolvedPhoto && photoCol !== -1) sheet.getRange(targetRow, photoCol + 1).setValue(resolvedPhoto);
      if (resolvedStart && startCol !== -1) sheet.getRange(targetRow, startCol + 1).setValue(resolvedStart);
      if (resolvedEnd && endCol !== -1) sheet.getRange(targetRow, endCol + 1).setValue(resolvedEnd);
      if (statusCol !== -1 && status) sheet.getRange(targetRow, statusCol + 1).setValue(currentStatus);
      if (handoverCol !== -1) sheet.getRange(targetRow, handoverCol + 1).setValue(currentStatus.toLowerCase().includes('handed') ? todayDate : 'Pending Handover');
      if (handedOverBy && handedByCol !== -1) sheet.getRange(targetRow, handedByCol + 1).setValue(handedOverBy);
      if (receivedBy && recvByCol !== -1) sheet.getRange(targetRow, recvByCol + 1).setValue(receivedBy);
      if (condCol !== -1 && condition) sheet.getRange(targetRow, condCol + 1).setValue(condition);
      if (remCol !== -1 && remarks) sheet.getRange(targetRow, remCol + 1).setValue(remarks);
      if (isReturnedStatus && returnDateCol !== -1) {
        sheet.getRange(targetRow, returnDateCol + 1).setValue(todayDate);
      }
      if (updatedCol !== -1) sheet.getRange(targetRow, updatedCol + 1).setValue(nowStr);
    } else {
      const newRow = new Array(headers.length).fill("");
      if (tagCol !== -1) newRow[tagCol] = resolvedTag;
      if (barcodeCol !== -1) newRow[barcodeCol] = resolvedBarcode;
      if (regCol !== -1) newRow[regCol] = cleanRegId;
      if (regNoCol !== -1) newRow[regNoCol] = staffIdOrReg;
      if (nameCol !== -1) newRow[nameCol] = resolvedName;
      if (catCol !== -1) newRow[catCol] = candCat;
      if (batchCol !== -1) newRow[batchCol] = resolvedBatch;
      if (collegeCol !== -1) newRow[collegeCol] = resolvedCollege;
      if (deptCol !== -1) newRow[deptCol] = resolvedDept;
      if (phoneCol !== -1) newRow[phoneCol] = resolvedPhone;
      if (addrCol !== -1) newRow[addrCol] = resolvedAddr;
      if (photoCol !== -1) newRow[photoCol] = resolvedPhoto;
      if (startCol !== -1) newRow[startCol] = resolvedStart;
      if (endCol !== -1) newRow[endCol] = resolvedEnd;
      if (statusCol !== -1) newRow[statusCol] = currentStatus;
      if (assignDateCol !== -1) newRow[assignDateCol] = resolvedStart || todayDate;
      if (handoverCol !== -1) newRow[handoverCol] = currentStatus.toLowerCase().includes('handed') ? todayDate : 'Pending Handover';
      if (handedByCol !== -1) newRow[handedByCol] = handedOverBy || "Admin";
      if (isReturnedStatus && returnDateCol !== -1) newRow[returnDateCol] = todayDate;
      if (recvDateCol !== -1) newRow[recvDateCol] = isReturnedStatus ? todayDate : "--";
      if (recvByCol !== -1) newRow[recvByCol] = receivedBy || (isReturnedStatus ? "Admin" : "");
      if (condCol !== -1) newRow[condCol] = condition || "Good";
      if (remCol !== -1) newRow[remCol] = remarks || "";
      if (updatedCol !== -1) newRow[updatedCol] = nowStr;
      sheet.appendRow(newRow);
    }
    SpreadsheetApp.flush();
  } catch (err) {
    Logger.log("syncRfidDataManagementEntry_ error: " + err.toString());
  }
}

function isGsvInternshipActiveOrUpcoming_(startDate, endDate) {
  if (!endDate) return true;
  try {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    let endObj = null;
    if (endDate instanceof Date) {
      endObj = new Date(endDate.getTime());
    } else {
      const str = String(endDate).trim();
      const dmy = str.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})/);
      if (dmy) {
        endObj = new Date(parseInt(dmy[3], 10), parseInt(dmy[2], 10) - 1, parseInt(dmy[1], 10), 23, 59, 59);
      } else {
        const ymd = str.match(/^(\d{4})[\/\-](\d{1,2})[\/\-](\d{1,2})/);
        if (ymd) {
          endObj = new Date(parseInt(ymd[1], 10), parseInt(ymd[2], 10) - 1, parseInt(ymd[3], 10), 23, 59, 59);
        } else {
          const p = new Date(str);
          if (!isNaN(p.getTime())) endObj = p;
        }
      }
    }
    if (endObj && endObj < today) {
      return false; // Completed / past end date
    }
  } catch (eDate) {}
  return true;
}

function getRfidDataManagementList(batchFilter, statusFilter, search) {
  try {
    const sheet = initRfidDataManagementSheet_();
    let data = sheet.getDataRange().getValues();
    let headers = data[0];

    // Auto-seed if empty or has very few initial records
    if (data.length <= 1 || data.length <= 3) {
      seedRfidDataManagementFromRegistrations_();
      data = sheet.getDataRange().getValues();
      headers = data[0];
    }

    const regCol = headers.indexOf('StudentRegistrationID');
    const tagCol = headers.indexOf('RFID_TagID');
    const barcodeCol = headers.indexOf('Barcode');
    const regNoCol = headers.indexOf('RegisterNumber');
    const nameCol = headers.indexOf('StudentName');
    const catCol = headers.indexOf('Category');
    const batchCol = headers.indexOf('Batch');
    const collegeCol = headers.indexOf('CollegeName');
    const deptCol = headers.indexOf('Department');
    const phoneCol = headers.indexOf('PhoneNumber');
    const addrCol = headers.indexOf('Address');
    const photoCol = headers.indexOf('PhotoUrl');
    const startCol = headers.indexOf('InternshipStartDate');
    const endCol = headers.indexOf('InternshipEndDate');
    const statusCol = headers.indexOf('Status');
    const assignDateCol = headers.indexOf('AssignedDate');
    const handoverCol = headers.indexOf('HandoverDate');
    const handedByCol = headers.indexOf('HandedOverBy');
    const recvDateCol = headers.indexOf('PhysicalReceivedDate');
    const returnDateCol = headers.indexOf('ReturnedDate');
    const recvByCol = headers.indexOf('ReceivedBy');
    const condCol = headers.indexOf('CardCondition');
    const remCol = headers.indexOf('Remarks');
    const updatedCol = headers.indexOf('LastUpdated');

    const cleanBatch = String(batchFilter || 'all').trim().toLowerCase();
    const cleanStatus = String(statusFilter || 'all').trim().toLowerCase();
    const cleanSearch = String(search || '').trim().toLowerCase();

    const knownFacultyMap = {
      'GSV/2026/112/VH8C': { name: 'Prof. PRAVEENA V', staffId: '51131', college: 'Velammal engineering college', dept: 'Electronics And Communication Engineering', batch: 'Faculty Batch 1', tag: '0007507511', designation: 'Associate Professor', experience: '10 Years', domain: 'VLSI & Embedded Systems', degree: 'M.E. / Ph.D.', phone: '9600628105', photoUrl: 'https://lh3.googleusercontent.com/d/1TaiL74Nfsg8EnroLNO5CZwhTd7NPSC7Q' },
      'GSV/2026/112/EQT4': { name: 'Prof. MANIMEGALAI M', staffId: '300581', college: 'velammal engineering college', dept: 'Electronics And Communication Engineering', batch: 'Faculty Batch 1', tag: '0007508828', designation: 'Associate Professor', experience: '12 Years', domain: 'Signal Processing & VLSI', degree: 'M.E. / Ph.D.', phone: '9444123456', photoUrl: 'https://lh3.googleusercontent.com/d/1u7QHaWwbfucJ0gXxIEyYFq17etETKemw' },
      'GSV/2026/112/QYCG': { name: 'Prof. ARUL THILAGAVATHI', staffId: '300573', college: 'Velammal engineering college', dept: 'Electronics And Communication Engineering', batch: 'Faculty Batch 1', tag: '0007515488', designation: 'Associate Professor', experience: '14 Years', domain: 'Wireless Networks & IoT', degree: 'Ph.D.', phone: '8438353511', photoUrl: 'https://lh3.googleusercontent.com/d/1avdjP1RxXMPgg-kGLGX4LUX36LYjMK6w' },
      'GSV/2026/112/JDBI': { name: 'Prof. RAMYA T', staffId: '300579', college: 'velammal engineering college', dept: 'Electronics And Communication Engineering', batch: 'Faculty Batch 1', tag: '0007518344', designation: 'Assistant Professor', experience: '8 Years', domain: 'Embedded Systems & Robotics', degree: 'M.E.', phone: '9791135843', photoUrl: 'https://lh3.googleusercontent.com/d/19c56EjHbPcOzSaulpBlSFHEhUEYtZeyN' },
      'GSV/2026/112/GONJ': { name: 'Prof. SUSANNA P', staffId: '300576', college: 'velammal engineering college', dept: 'Electronics And Communication Engineering', batch: 'Faculty Batch 1', tag: '0007518656', designation: 'Assistant Professor', experience: '9 Years', domain: 'Communication Systems & Image Processing', degree: 'M.E.', phone: '9003091021', photoUrl: 'https://lh3.googleusercontent.com/d/104Kj6rc1lwSTm918Dx8NfDJTovG37KFX' }
    };
    const knownFacultyByTag = {
      '0007507511': knownFacultyMap['GSV/2026/112/VH8C'],
      '0007508828': knownFacultyMap['GSV/2026/112/EQT4'],
      '0007515488': knownFacultyMap['GSV/2026/112/QYCG'],
      '0007518344': knownFacultyMap['GSV/2026/112/JDBI'],
      '0007518656': knownFacultyMap['GSV/2026/112/GONJ']
    };

    // Pre-index candidate records across sheets in memory
    const candMap = {};
    const candByTag = {};
    const indexSheet = (sName, defaultCat) => {
      try {
        const sh = getSheet(sName);
        if (!sh) return;
        const rows = getSheetDataAsObjects(sh) || [];
        rows.forEach(r => {
          const rid = String(r.RegistrationID || r.registrationId || r.RegID || '').trim().toUpperCase();
          if (rid) {
            if (!candMap[rid]) {
              if (defaultCat && !r.CandidateType) r.CandidateType = defaultCat;
              candMap[rid] = r;
            }
          }
          const t = standardizeRfidFormat(r.RFID_TagID || r.rfidTag || r.Last_RFID_TagID || '');
          if (t && !candByTag[t]) {
            if (defaultCat && !r.CandidateType) r.CandidateType = defaultCat;
            candByTag[t] = r;
          }
        });
      } catch(eSh) {}
    };

    indexSheet(SHEET_NAMES.REGISTRATIONS, 'Student');
    indexSheet(SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations', 'Faculty');
    indexSheet(SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations', 'Employee');
    indexSheet(SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations', 'Apprentice');
    indexSheet('Closed and Opt-out', 'Student');

    // Also index all students from getAllStudents() so batches, photos, and academic details are never missing
    try {
      const allStuds = (typeof getAllStudents === 'function') ? getAllStudents() : [];
      allStuds.forEach(s => {
        const rid = String(s.RegistrationID || s.registrationId || s.RegID || '').trim().toUpperCase();
        if (rid) {
          if (!candMap[rid]) {
            candMap[rid] = s;
          } else {
            if (!candMap[rid].Batch && (s.Batch || s.batch)) candMap[rid].Batch = s.Batch || s.batch;
            if (!candMap[rid].batch && (s.Batch || s.batch)) candMap[rid].batch = s.Batch || s.batch;
            if (!candMap[rid].ProfilePhotoUrl && (s.ProfilePhotoUrl || s.photoUrl)) candMap[rid].ProfilePhotoUrl = s.ProfilePhotoUrl || s.photoUrl;
            if (!candMap[rid].CollegeName && (s.CollegeName || s.college)) candMap[rid].CollegeName = s.CollegeName || s.college;
            if (!candMap[rid].Department && (s.Department || s.department)) candMap[rid].Department = s.Department || s.department;
          }
        }
        const t = standardizeRfidFormat(s.rfidTag || s.RFID_TagID || s.Last_RFID_TagID || '');
        if (t) {
          if (!candByTag[t]) {
            candByTag[t] = s;
          } else {
            if (!candByTag[t].Batch && (s.Batch || s.batch)) candByTag[t].Batch = s.Batch || s.batch;
            if (!candByTag[t].batch && (s.Batch || s.batch)) candByTag[t].batch = s.Batch || s.batch;
            if (!candByTag[t].ProfilePhotoUrl && (s.ProfilePhotoUrl || s.photoUrl)) candByTag[t].ProfilePhotoUrl = s.ProfilePhotoUrl || s.photoUrl;
          }
        }
      });
    } catch(eAll) {}

    // Map by unique key (RegistrationID or TagID) to deduplicate and keep latest record
    const dedupedMap = {};
    const allBatchesSet = new Set();
    let sheetHasChanges = false;

    for (let i = 1; i < data.length; i++) {
      const row = data[i];
      const rId = String(row[regCol] || '').trim();
      const rawTagId = String(row[tagCol] || '').trim();
      const tagId = rawTagId ? standardizeRfidFormat(rawTagId) : '';
      if (!rId && !tagId) continue;

      const rIdUpper = rId.toUpperCase();
      const key = rIdUpper || tagId;

      let rowBatch = String(row[batchCol] || '').trim();
      let rowStatus = String(row[statusCol] || 'In Use').trim();
      let rowName = String(row[nameCol] || '').trim();
      let rowCollege = String(row[collegeCol] || '').trim();
      let rowRegNo = String(row[regNoCol] || '').trim();
      let rowDept = String(row[deptCol] || '').trim();
      let rowPhone = phoneCol !== -1 ? String(row[phoneCol] || '').trim() : '';
      let rowAddr = addrCol !== -1 ? String(row[addrCol] || '').trim() : '';
      let rowPhoto = photoCol !== -1 ? String(row[photoCol] || '').trim() : '';
      let rowStart = (startCol !== -1 && row[startCol]) ? formatDateDMY(row[startCol]) : '';
      let rowEnd = (endCol !== -1 && row[endCol]) ? formatDateDMY(row[endCol]) : '';
      let rowBarcode = barcodeCol !== -1 ? String(row[barcodeCol] || '').trim() : '';

      const cand = candMap[rIdUpper] || candByTag[tagId] || {};
      const kf = knownFacultyMap[rIdUpper] || knownFacultyByTag[tagId];
      const isFac = (cand.CandidateType === 'Faculty') || ['GSV/2026/112/VH8C','GSV/2026/112/EQT4','GSV/2026/112/QYCG','GSV/2026/112/JDBI','GSV/2026/112/GONJ'].includes(rIdUpper) || rIdUpper.includes('/FAC/');

      // 1. Resolve Name
      if (kf) {
        rowName = kf.name;
      } else if (cand && (cand.FirstName || cand.FullName)) {
        rowName = (typeof getStudentFullName_ === 'function') ? getStudentFullName_(cand) : (cand.FullName || cand.FirstName);
      }
      if (isFac) {
        rowName = rowName.replace(/^(?:mr\.|ms\.|mrs\.|dr\.|prof\.|mr|ms|mrs|dr|prof)\s+/i, '').trim();
        if (!rowName.startsWith('Prof.') && !rowName.startsWith('Dr.')) rowName = 'Prof. ' + rowName;
      }

      // 2. Resolve Batch (Crucial: never display bare 'Batch')
      if (kf) {
        rowBatch = kf.batch;
      } else {
        const resolvedCandBatch = cand.Batch || cand.batch || '';
        if (resolvedCandBatch && resolvedCandBatch.toLowerCase() !== 'batch' && resolvedCandBatch.toLowerCase() !== 'unassigned') {
          rowBatch = resolvedCandBatch;
        } else if (!rowBatch || rowBatch.toLowerCase() === 'batch' || rowBatch.toLowerCase() === 'unassigned') {
          rowBatch = isFac ? 'Faculty Batch 1' : (resolvedCandBatch || 'Unassigned');
        }
      }
      if (rowBatch && rowBatch.toLowerCase() !== 'all' && rowBatch.toLowerCase() !== 'unassigned') {
        allBatchesSet.add(rowBatch);
      }

      // 3. Resolve Register Number / Staff ID
      if (kf) {
        rowRegNo = kf.staffId;
      } else if (!rowRegNo || rowRegNo === '--') {
        rowRegNo = (isFac ? (cand.FacultyStaffId || cand.StaffId) : null) || (cand.CandidateType === 'Employee' ? (cand.EmployeeId || cand.StaffId) : null) || cand.RegisterNumber || cand.RegNo || '--';
      }

      // 4. Resolve College & Department
      if (kf) {
        rowCollege = kf.college;
        rowDept = kf.dept;
      } else {
        if (!rowCollege || rowCollege === '--') rowCollege = cand.CollegeName || cand.College || '--';
        if (!rowDept || rowDept === '--') rowDept = cand.Department || cand.Dept || '--';
      }

      // 5. Resolve Contact, Address, Photo, Dates, Barcode
      if (!rowPhone || rowPhone === '--') rowPhone = cand.MobileNumber || cand.Mobile || cand.PhoneNumber || cand.Phone || cand.ContactNumber || '--';
      if (!rowAddr || rowAddr === '--') rowAddr = cand.Address || cand.ResidentialAddress || cand.address || '--';
      if (!rowPhoto) rowPhoto = cand.ProfilePhotoUrl || cand.PhotoUrl || cand.Photo || cand.PassportPhoto || '';
      if (!rowStart) rowStart = cand.InternshipStartDate ? formatDateDMY(cand.InternshipStartDate) : '';
      if (!rowEnd) rowEnd = cand.InternshipEndDate ? formatDateDMY(cand.InternshipEndDate) : '';
      if (!rowBarcode) rowBarcode = tagId || rIdUpper;

      // 6. Resolve Status (Faculty cards are Assigned, not yet handed over)
      if (isFac && (rowStatus.toLowerCase() === 'handed over' || rowStatus.toLowerCase() === 'in use')) {
        rowStatus = 'Assigned';
      }

      // 7. Live sync back to in-memory row (batch-saved once at end for maximum speed)
      try {
        if (nameCol !== -1 && String(row[nameCol] || '') !== rowName) { row[nameCol] = rowName; sheetHasChanges = true; }
        if (batchCol !== -1 && String(row[batchCol] || '') !== rowBatch) { row[batchCol] = rowBatch; sheetHasChanges = true; }
        if (regNoCol !== -1 && String(row[regNoCol] || '') !== rowRegNo) { row[regNoCol] = rowRegNo; sheetHasChanges = true; }
        if (collegeCol !== -1 && String(row[collegeCol] || '') !== rowCollege) { row[collegeCol] = rowCollege; sheetHasChanges = true; }
        if (deptCol !== -1 && String(row[deptCol] || '') !== rowDept) { row[deptCol] = rowDept; sheetHasChanges = true; }
        if (statusCol !== -1 && String(row[statusCol] || '') !== rowStatus) { row[statusCol] = rowStatus; sheetHasChanges = true; }
        if (phoneCol !== -1 && String(row[phoneCol] || '') !== rowPhone) { row[phoneCol] = rowPhone; sheetHasChanges = true; }
        if (addrCol !== -1 && String(row[addrCol] || '') !== rowAddr) { row[addrCol] = rowAddr; sheetHasChanges = true; }
        if (photoCol !== -1 && String(row[photoCol] || '') !== rowPhoto && rowPhoto) { row[photoCol] = rowPhoto; sheetHasChanges = true; }
        if (startCol !== -1 && String(row[startCol] || '') !== rowStart && rowStart) { row[startCol] = rowStart; sheetHasChanges = true; }
        if (endCol !== -1 && String(row[endCol] || '') !== rowEnd && rowEnd) { row[endCol] = rowEnd; sheetHasChanges = true; }
        if (barcodeCol !== -1 && String(row[barcodeCol] || '') !== rowBarcode) { row[barcodeCol] = rowBarcode; sheetHasChanges = true; }
        if (catCol !== -1 && (!row[catCol] || row[catCol] === '')) { row[catCol] = isFac ? 'Faculty' : (cand.CandidateType || 'Student'); sheetHasChanges = true; }
      } catch(eUp) {}

      const assignedDateVal = row[assignDateCol] ? formatDateDMY(row[assignDateCol]) : (cand.ApprovalDate ? formatDateDMY(cand.ApprovalDate) : (rowStart || ''));
      const isHariharan = (rIdUpper === 'GSV/2026/97/4H8E');
      const hasCardTag = !!tagId && tagId !== '--';
      const isCardHandedOver = (isHariharan || cand.RFID_HandoverStatus === 'Handed Over' || rowStatus.toLowerCase() === 'handed over');
      const handoverVal = hasCardTag ? (isCardHandedOver ? (cand.RfidHandoverDate ? formatDateDMY(cand.RfidHandoverDate) : assignedDateVal) : 'Pending Handover (Desk Collection)') : '--';
      const handedByVal = hasCardTag ? (isCardHandedOver ? 'Admin' : '--') : '--';
      const physicalRecvVal = (cand.RFID_PhysicalStatus === 'Received' || rowStatus.toLowerCase().includes('return')) ? (cand.RfidReceivedDate ? formatDateDMY(cand.RfidReceivedDate) : (row[returnDateCol] ? formatDateDMY(row[returnDateCol]) : 'Received')) : '--';

      const item = {
        rfidTag: tagId,
        barcode: rowBarcode || tagId,
        registrationId: rIdUpper,
        registerNo: rowRegNo,
        studentName: rowName,
        category: isFac ? 'Faculty' : (cand.CandidateType || 'Student'),
        batch: rowBatch || 'Unassigned',
        collegeName: rowCollege,
        department: rowDept,
        designation: String(kf ? kf.designation : (cand.Designation || (isFac ? 'Associate Professor' : '--'))).trim(),
        experience: String(kf ? kf.experience : (cand.TeachingExperience || cand.facultyExperience || cand.Experience || '--')).trim(),
        domain: String(kf ? kf.domain : (cand.facultyDomain || cand.InterestedArea || cand.Domain || cand.ProjectTitle || '--')).trim(),
        semester: String(cand.Semester || cand.semester || cand.Sem || cand.sem || row[headers.indexOf('Semester')] || '--').trim(),
        year: String(cand.Year || cand.year || cand.YearOfStudy || cand.yearOfStudy || row[headers.indexOf('Year')] || '--').trim(),
        educationType: String(kf ? kf.degree : (cand.EducationType || cand.educationType || cand.Degree || cand.degree || '--')).trim(),
        approvalStatus: String(cand.ApplicationStatus || cand.Status || 'Approved').trim(),
        phone: (kf && kf.phone && (!rowPhone || rowPhone === '--')) ? kf.phone : rowPhone,
        email: String(cand.GmailID || cand.Email || cand.email || '--').trim(),
        address: rowAddr,
        photoUrl: formatDriveUrlToDirectImage_(rowPhoto) || (kf ? kf.photoUrl : '') || (cand ? formatDriveUrlToDirectImage_(cand.PhotoUrl || cand.ProfilePhotoUrl || cand.photoUrl) : ''),
        startDate: rowStart,
        endDate: rowEnd,
        internshipStartDate: rowStart,
        internshipEndDate: rowEnd,
        status: rowStatus,
        assignedDate: assignedDateVal,
        handoverDate: handoverVal,
        handedOverBy: handedByVal,
        physicalReceivedDate: physicalRecvVal,
        returnedDate: row[returnDateCol] ? formatDateDMY(row[returnDateCol]) : '',
        receivedBy: String(row[recvByCol] || '').trim(),
        cardCondition: String(row[condCol] || 'Good').trim(),
        remarks: String(row[remCol] || '').trim(),
        lastUpdated: row[updatedCol] ? String(row[updatedCol]) : ''
      };

      dedupedMap[key] = item;
    }

    if (sheetHasChanges) {
      try {
        sheet.getRange(1, 1, data.length, data[0].length).setValues(data);
        SpreadsheetApp.flush();
      } catch(eFl) {
        Logger.log('Error batch updating RFID sheet: ' + eFl);
      }
    }

    const allItems = Object.values(dedupedMap);
    let list = [];
    let counts = { total: 0, inUse: 0, returned: 0, pendingReturn: 0, lost: 0 };

    allItems.forEach(item => {
      const candApprStatus = String(item.approvalStatus || item.status || '').toLowerCase();
      // STRICT RULE: Pending students must NEVER appear anywhere in RFID management
      if (['opt-out', 'optout', 'deleted', 'closed', 'closed and opt-out', 'inactive', 'rejected', 'pending'].includes(candApprStatus) || candApprStatus.includes('pending')) return;

      counts.total++;
      const stLow = (item.status || '').toLowerCase();
      if (stLow.includes('return') || stLow.includes('revoke') || stLow.includes('pool') || stLow === 'surrendered') {
        counts.returned++;
      } else if (stLow.includes('handed') || stLow.includes('in use') || stLow === 'assigned') {
        counts.inUse++;
      } else if (stLow.includes('pending')) {
        counts.pendingReturn++;
      } else if (stLow.includes('lost') || stLow.includes('damage') || stLow.includes('replace')) {
        counts.lost++;
      }

      if (cleanBatch !== 'all' && (item.batch || '').toLowerCase() !== cleanBatch) return;
      if (cleanStatus !== 'all') {
        if (cleanStatus === 'approved') {
          if (candApprStatus !== 'approved' && candApprStatus !== 'active') return;
          if (!isGsvInternshipActiveOrUpcoming_(item.internshipStartDate, item.internshipEndDate)) return;
        }
        if (cleanStatus === 'completed' && candApprStatus !== 'completed') return;
        if (cleanStatus === 'in_use' && !stLow.includes('in use') && !stLow.includes('handed') && stLow !== 'assigned') return;
        if (cleanStatus === 'returned' && !stLow.includes('return') && !stLow.includes('revoke') && !stLow.includes('pool') && stLow !== 'surrendered') return;
        if (cleanStatus === 'pending' && !stLow.includes('pending')) return;
        if (cleanStatus === 'lost' && !stLow.includes('lost') && !stLow.includes('damage') && !stLow.includes('replace')) return;
      }
      if (cleanSearch) {
        const text = (item.registrationId + ' ' + item.rfidTag + ' ' + item.studentName + ' ' + item.collegeName + ' ' + item.registerNo + ' ' + item.department + ' ' + item.batch + ' ' + item.phone).toLowerCase();
        if (!text.includes(cleanSearch)) return;
      }

      list.push(item);
    });

    function parseDateToTimeSafe_(d) {
      if (!d) return 0;
      if (d instanceof Date) return d.getTime();
      var s = String(d).trim();
      if (!s || s === '--') return 0;
      var parts = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})/);
      if (parts) {
        return new Date(parseInt(parts[3], 10), parseInt(parts[2], 10) - 1, parseInt(parts[1], 10)).getTime();
      }
      var t = new Date(s).getTime();
      return isNaN(t) ? 0 : t;
    }

    // Seniority sorting: Approved students newest first; Completed students by newest completion/end date (Descending)
    list.sort((a, b) => {
      const stA = String(a.approvalStatus || a.status || '').toLowerCase();
      const stB = String(b.approvalStatus || b.status || '').toLowerCase();
      const isCompA = stA === 'completed';
      const isCompB = stB === 'completed';

      if (!isCompA && isCompB) return -1;
      if (isCompA && !isCompB) return 1;

      if (!isCompA && !isCompB) {
        const tA = parseDateToTimeSafe_(a.assignedDate || a.appliedDate || a.lastUpdated || 0);
        const tB = parseDateToTimeSafe_(b.assignedDate || b.appliedDate || b.lastUpdated || 0);
        return tB - tA;
      } else {
        const eA = parseDateToTimeSafe_(a.completionDate || a.endDate || a.internshipEndDate || a.internshipEnd || a.lastUpdated || 0);
        const eB = parseDateToTimeSafe_(b.completionDate || b.endDate || b.internshipEndDate || b.internshipEnd || b.lastUpdated || 0);
        return eB - eA; // Newest completed first (Descending)
      }
    });

    return {
      status: 'success',
      list: list,
      counts: counts,
      batches: Array.from(allBatchesSet).sort()
    };
  } catch (err) {
    return { status: 'error', message: err.toString() };
  }
}

function seedRfidDataManagementFromRegistrations_() {
  try {
    const students = getAllStudents();
    const inv = getRfidInventory();

    const seededMap = {};

    // 1. Seed from currently assigned inventory items
    if (inv && Array.isArray(inv)) {
      inv.forEach(item => {
        if (item.status === 'Assigned' && item.assignedToId) {
          const regUpper = String(item.assignedToId).trim().toUpperCase();
          const stdTag = standardizeRfidFormat(item.tagId);
          seededMap[regUpper] = {
            tag: stdTag,
            regId: item.assignedToId,
            status: item.handoverStatus === 'Handed Over' ? 'Handed Over' : 'Assigned',
            handedOverBy: 'Admin',
            receivedBy: '',
            condition: 'Good',
            remarks: item.handoverStatus === 'Handed Over' ? 'Card physically handed over to intern' : 'Card assigned from inventory (Pending Handover)'
          };
        }
      });
    }

    // 2. Seed from all students who have assigned or historical RFID cards
    if (students && Array.isArray(students)) {
      students.forEach(s => {
        const regId = String(s.registrationId || s.RegistrationID || '').trim();
        const regUpper = regId.toUpperCase();
        const rawTag = s.rfidTag || s.RFID_TagID || s.Last_RFID_TagID || '';
        if (!regUpper) return;

        if (rawTag) {
          const stdTag = standardizeRfidFormat(rawTag);
          const isReturned = (String(s.rfidPhysicalStatus || '').toLowerCase() === 'received') || 
                             (String(s.rfidHandoverStatus || '').toLowerCase() === 'returned') ||
                             (String(s.hardCopyStatus || '').toLowerCase() === 'submitted');
          const isHandedOver = (String(s.rfidPhysicalStatus || '').toLowerCase() === 'issued') ||
                               (String(s.rfidHandoverStatus || '').toLowerCase() === 'handed over');

          let status = 'Assigned';
          let remarks = 'Card assigned (Pending Handover)';
          if (isReturned) {
            status = 'Returned';
            remarks = 'Card returned to Admin; clearance completed';
          } else if (isHandedOver) {
            status = 'Handed Over';
            remarks = 'Card physically handed over to intern';
          }

          seededMap[regUpper] = {
            tag: stdTag,
            regId: regId,
            status: status,
            handedOverBy: 'Admin',
            receivedBy: isReturned ? 'Admin' : '',
            condition: 'Good',
            remarks: remarks
          };
        }
      });
    }

    // Write all entries to RFID_Data_Management sheet
    Object.values(seededMap).forEach(entry => {
      syncRfidDataManagementEntry_(
        entry.tag,
        entry.regId,
        entry.status,
        entry.handedOverBy,
        entry.receivedBy,
        entry.condition,
        entry.remarks
      );
    });
  } catch (err) {
    Logger.log('seedRfidDataManagementFromRegistrations_ error: ' + err.toString());
  }
}

function saveRfidDataManagementRecord(record) {
  try {
    if (!record || (!record.registrationId && !record.rfidTag)) {
      return { status: 'error', message: 'Missing record details' };
    }
    syncRfidDataManagementEntry_(
      record.rfidTag,
      record.registrationId,
      record.status,
      record.handedOverBy,
      record.receivedBy,
      record.cardCondition,
      record.remarks
    );
    return { status: 'success', message: 'RFID record saved successfully' };
  } catch (err) {
    return { status: 'error', message: err.toString() };
  }
}

function replaceRfidCard(payload) {
  try {
    if (!payload || !payload.registrationId || !payload.newTagId) {
      return { status: 'error', message: 'Registration ID and New RFID Tag ID are required.' };
    }

    const regId = String(payload.registrationId).trim().toUpperCase();
    const oldTag = payload.oldTagId ? standardizeRfidFormat(payload.oldTagId) : '';
    const newTag = standardizeRfidFormat(payload.newTagId);
    const reason = String(payload.reason || 'Damaged / Lost Card Replacement').trim();
    const condition = String(payload.condition || 'Damaged').trim();
    const handedOverBy = String(payload.handedOverBy || 'Admin').trim();
    const todayDate = Utilities.formatDate(new Date(), "GMT+5:30", "dd/MM/yyyy");
    const nowStr = Utilities.formatDate(new Date(), "GMT+5:30", "dd/MM/yyyy HH:mm");

    if (!newTag || newTag.length < 5) {
      return { status: 'error', message: 'Invalid new RFID Tag ID. Please provide a valid 10-digit RFID card number.' };
    }

    // 1. Concurrency Check: Verify newTag is not already assigned to another candidate
    const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);
    if (invSheet) {
      const invData = getSheetDataAsObjects(invSheet) || [];
      const tagInUse = invData.find(row => {
        const t = standardizeRfidFormat(row.RFID_TagID || row.TagID || '');
        const st = String(row.Status || row.status || '').toLowerCase();
        const aTo = String(row.AssignedTo || row.assignedTo || row.AssignedToID || row.assignedToId || '').toUpperCase();
        return t === newTag && (st === 'assigned' || st === 'in use') && aTo !== regId;
      });
      if (tagInUse) {
        return { 
          status: 'error', 
          message: `Tag ${newTag} is already assigned to active candidate ${tagInUse.AssignedTo || tagInUse.assignedTo}! Please select an available card.` 
        };
      }
    }

    // 2. Update Student Profile in Registrations
    updateStudentProfile({
      registrationId: regId,
      RFID_TagID: newTag,
      Last_RFID_TagID: oldTag,
      RFID_HandoverStatus: 'Handed Over',
      RFID_PhysicalStatus: 'Issued'
    });

    // Also append replacement audit entry into Remarks in Registrations
    try {
      const regSh = getSheet(SHEET_NAMES.REGISTRATIONS);
      if (regSh) {
        const regValues = regSh.getDataRange().getValues();
        const rHeaders = regValues[0];
        const rIdCol = rHeaders.indexOf('RegistrationID');
        const remCol = rHeaders.indexOf('Remarks');
        const tagCol = rHeaders.indexOf('RFID_TagID');
        for (let r = 1; r < regValues.length; r++) {
          if (String(regValues[r][rIdCol] || '').trim().toUpperCase() === regId) {
            if (tagCol !== -1) regSh.getRange(r + 1, tagCol + 1).setValue(newTag);
            if (remCol !== -1) {
              const prevRem = String(regValues[r][remCol] || '').trim();
              const replNote = `[RFID REPLACED: Old ${oldTag || 'N/A'} -> New ${newTag} on ${todayDate}. Reason: ${reason}]`;
              regSh.getRange(r + 1, remCol + 1).setValue(prevRem ? (prevRem + ' | ' + replNote) : replNote);
            }
            break;
          }
        }
      }
    } catch(eRegUp) {
      Logger.log("replaceRfidCard reg update error: " + eRegUp);
    }

    // 3. Update RFID Inventory Sheet
    if (invSheet) {
      const invValues = invSheet.getDataRange().getValues();
      const iHeaders = invValues[0];
      const iTagCol = iHeaders.indexOf('RFID_TagID');
      const iStatusCol = iHeaders.indexOf('Status');
      const iAssignedCol = iHeaders.indexOf('AssignedTo');
      const iRemCol = iHeaders.indexOf('Remarks');
      const iUpdCol = iHeaders.indexOf('LastUpdated');

      // Update old tag row as Replaced / Damaged / Lost
      if (oldTag && iTagCol !== -1) {
        for (let r = 1; r < invValues.length; r++) {
          const t = standardizeRfidFormat(invValues[r][iTagCol]);
          if (t === oldTag) {
            if (iStatusCol !== -1) invSheet.getRange(r + 1, iStatusCol + 1).setValue(condition === 'Lost' ? 'Lost' : 'Damaged');
            if (iAssignedCol !== -1) invSheet.getRange(r + 1, iAssignedCol + 1).setValue(regId);
            if (iRemCol !== -1) invSheet.getRange(r + 1, iRemCol + 1).setValue(`Card replaced by ${newTag} on ${todayDate} (${reason})`);
            if (iUpdCol !== -1) invSheet.getRange(r + 1, iUpdCol + 1).setValue(new Date());
            break;
          }
        }
      }

      // Mark new tag row as Assigned
      if (newTag && iTagCol !== -1) {
        let newTagRow = -1;
        for (let r = 1; r < invValues.length; r++) {
          const t = standardizeRfidFormat(invValues[r][iTagCol]);
          if (t === newTag) {
            newTagRow = r + 1;
            break;
          }
        }
        if (newTagRow > 0) {
          if (iStatusCol !== -1) invSheet.getRange(newTagRow, iStatusCol + 1).setValue('Assigned');
          if (iAssignedCol !== -1) invSheet.getRange(newTagRow, iAssignedCol + 1).setValue(regId);
          if (iRemCol !== -1) invSheet.getRange(newTagRow, iRemCol + 1).setValue(`Issued as replacement for ${oldTag || 'N/A'} on ${todayDate}`);
          if (iUpdCol !== -1) invSheet.getRange(newTagRow, iUpdCol + 1).setValue(new Date());
        }
      }
    }

    // 4. Update RFID Data Management Sheet
    if (oldTag) {
      syncRfidDataManagementEntry_(
        oldTag,
        regId,
        'Replaced',
        handedOverBy,
        'Admin',
        condition,
        `Replaced with new card ${newTag}. Reason: ${reason}`
      );
    }

    syncRfidDataManagementEntry_(
      newTag,
      regId,
      'Assigned',
      handedOverBy,
      '',
      'Good',
      `Replacement card for ${oldTag || 'previous card'}`
    );

    // 5. Activity log
    logActivity('RFID Replace', 'Admin', `RFID Card for ${regId} replaced: ${oldTag || 'N/A'} -> ${newTag} (${reason})`);

    return {
      status: 'success',
      message: `RFID Card successfully replaced!\nOld Card: ${oldTag || 'N/A'}\nNew Card: ${newTag}\nCandidate: ${regId}`,
      oldTag: oldTag,
      newTag: newTag
    };
  } catch(err) {
    Logger.log("replaceRfidCard error: " + err.toString());
    return { status: 'error', message: err.toString() };
  }
}

function exportRfidDataManagementCsv() {
  try {
    const res = getRfidDataManagementList('all', 'all', '');
    if (res.status !== 'success' || !res.list) {
      return { status: 'error', message: res.message || 'Failed to fetch RFID records for export.' };
    }

    const exportHeaders = [
      'S.No',
      'RFID Tag ID',
      'Barcode Number',
      'Student Registration ID',
      'Register Number / Staff ID',
      'Student / Candidate Name',
      'Category',
      'Batch',
      'College Name',
      'Department',
      'Phone Number',
      'Address',
      'Profile Photo URL',
      'Internship Start Date',
      'Internship End Date',
      'RFID Card Status',
      'Assigned Date',
      'Handover Date',
      'Handed Over By',
      'Physical Received Date',
      'Returned Date',
      'Received By',
      'Card Condition',
      'Remarks',
      'Last Updated'
    ];

    let csv = exportHeaders.map(h => `"${h.replace(/"/g, '""')}"`).join(',') + '\r\n';

    res.list.forEach((item, idx) => {
      const row = [
        idx + 1,
        item.rfidTag ? ("'" + item.rfidTag) : '', // Apostrophe prefix ensures Excel does not truncate leading zeros
        item.barcode || item.rfidTag || '',
        item.registrationId || '',
        item.registerNo || '',
        item.studentName || '',
        item.category || 'Student',
        item.batch || 'Unassigned',
        item.collegeName || '',
        item.department || '',
        item.phone || '',
        item.address || '',
        item.photoUrl || '',
        item.startDate || '',
        item.endDate || '',
        item.status || 'Assigned',
        item.assignedDate || '',
        item.handoverDate || '',
        item.handedOverBy || 'Admin',
        item.physicalReceivedDate || '--',
        item.returnedDate || '',
        item.receivedBy || '',
        item.cardCondition || 'Good',
        item.remarks || '',
        item.lastUpdated || ''
      ];

      const cleanRow = row.map(val => {
        let v = String(val === null || val === undefined ? '' : val).replace(/"/g, '""');
        return `"${v}"`;
      });

      csv += cleanRow.join(',') + '\r\n';
    });

    // Prepend UTF-8 BOM so Excel opens Tamil & unicode characters flawlessly
    const finalCsv = '\uFEFF' + csv;

    return { 
      status: 'success', 
      csv: finalCsv, 
      fileName: 'RFID_Student_Data_Management_' + Utilities.formatDate(new Date(), "GMT+5:30", "yyyyMMdd_HHmm") + '.csv' 
    };
  } catch (err) {
    return { status: 'error', message: err.toString() };
  }
}


// COMPONENT & HARDWARE MATERIAL HANDOVER CLEARANCE REPORT ENGINE

// ============================================================================

function getStudentComponentHandoverData(registrationId) {

  try {

    if (!registrationId) return { status: 'error', message: 'Missing Registration ID' };

    const regId = String(registrationId).trim().toUpperCase();



    const fullResp = getStudentFullData(regId);

    if (!fullResp || fullResp.status !== 'success' || !fullResp.studentData) {

      return { status: 'error', message: `Student ${regId} not found` };

    }

    const s = fullResp.studentData;



    const compSheet = getSheet(SHEET_NAMES.COMPONENTS_ISSUED);

    let items = [];

    if (compSheet) {

      const cData = getSheetDataAsObjects(compSheet);

      items = cData.filter(c => {

        const studentCol = String(c.InchargeStudentID || c.StudentID || '').trim().toUpperCase();

        return (studentCol === regId);

      }).map((c, idx) => ({

        sNo: idx + 1,

        issueId: c.IssueID || '',

        itemName: c.ItemName || '',

        specification: c.Specification || '',

        quantity: c.Quantity || 1,

        issuedDate: c.IssuedDate ? formatDateDMY(c.IssuedDate) : '',

        returnDate: c.ReturnDate ? formatDateDMY(c.ReturnDate) : '',

        status: String(c.Status || 'Issued').trim(),

        remarks: c.Remarks || ''

      }));

    }



    let hcDetails = {};

    if (s.HardCopyDetails) {

      try { hcDetails = JSON.parse(s.HardCopyDetails); } catch(e) {}

    }

    const isHardCopySubmitted = (String(s.HardCopyStatus || s.HardCopy || '').toLowerCase() === 'submitted');



    const totalIssued = items.length;

    const returnedItems = items.filter(it => it.status.toLowerCase() === 'returned');

    const pendingItems = items.filter(it => it.status.toLowerCase() !== 'returned');



    const rfidTag = s.RFID_TagID || s.RFID || '';

    const hasRfid = Boolean(rfidTag && rfidTag !== 'UNASSIGNED');

    const isRfidReturned = hcDetails.rfidCard === true || String(s.RFID_PhysicalStatus || '').toLowerCase() === 'received' || !hasRfid;

    const isReportSubmitted = hcDetails.diary === true || isHardCopySubmitted;



    return {

      status: 'success',

      student: {

        registrationId: regId,

        studentName: getStudentFullName_(s),

        registerNumber: s.RegisterNumber || s.RegNo || '--',

        batch: s.Batch || '--',

        collegeName: s.CollegeName || s.College || '--',

        department: s.Department || '--',

        projectTitle: s.ProjectTitle || s.Project || 'Industrial Project',

        startDate: s.InternshipStartDate ? formatDateDMY(s.InternshipStartDate) : '--',

        endDate: s.InternshipEndDate ? formatDateDMY(s.InternshipEndDate) : '--',

        durationDays: s.DurationDays || 30,

        rfidTag: rfidTag,

        rfidStatus: isRfidReturned ? 'Returned' : (hasRfid ? 'In Possession / Active' : 'Not Issued'),

        projectReportSubmitted: isReportSubmitted ? 'Submitted' : 'Pending',

        hardCopyStatus: isHardCopySubmitted ? 'Submitted' : 'Pending'

      },

      components: items,

      summary: {

        totalIssued: totalIssued,

        totalReturned: returnedItems.length,

        totalPending: pendingItems.length,

        isAllHardwareCleared: (pendingItems.length === 0),

        isRfidCleared: isRfidReturned,

        isAllCleared: (pendingItems.length === 0 && isRfidReturned && isReportSubmitted)

      }

    };

  } catch (err) {

    return { status: 'error', message: err.toString() };

  }

}



function generateComponentHandoverReportDoc(registrationId, options) {

  try {

    const dataResp = getStudentComponentHandoverData(registrationId);

    if (!dataResp || dataResp.status !== 'success') return dataResp;



    const s = dataResp.student;

    const comps = dataResp.components;

    const sum = dataResp.summary;



    const folder = getSystemFolder('documents') || DriveApp.getRootFolder();

    const title = `MATERIAL_CLEARANCE_${s.registrationId.replace(/[^A-Za-z0-9_-]/g, '_')}`;

    const doc = DocumentApp.create(title);

    const body = doc.getBody();



    body.setPageWidth(595.28);

    body.setPageHeight(841.89);

    body.setMarginTop(36);

    body.setMarginBottom(36);

    body.setMarginLeft(40);

    body.setMarginRight(40);



    const headerTbl = body.appendTable();

    headerTbl.setBorderWidth(0);

    const hRow = headerTbl.appendTableRow();

    const hCell1 = hRow.appendTableCell();

    const hCell2 = hRow.appendTableCell();

    hCell1.setWidth(100);

    hCell2.setWidth(415);

    [hCell1, hCell2].forEach(c => { c.setPaddingTop(0); c.setPaddingBottom(4); c.setPaddingLeft(0); c.setPaddingRight(0); });



    try {

      const logoBlob = getCompanyShieldLogoBlob_();

      if (logoBlob) {

        const img = hCell1.appendParagraph('').appendInlineImage(logoBlob);

        img.setWidth(85);

        img.setHeight(85);

      }

    } catch(e) {}



    const pTitle = hCell2.appendParagraph('G.S.V. ELECTRICAL ENTERPRISES');

    pTitle.setFontFamily('Times New Roman').setFontSize(18).setBold(true).setForegroundColor('#0f172a');

    const pSub = hCell2.appendParagraph('INTERNSHIP PROJECT HARDWARE & MATERIAL HANDOVER CLEARANCE RECORD');

    pSub.setFontFamily('Times New Roman').setFontSize(11).setBold(true).setForegroundColor('#0284c7');

    const pAddr = hCell2.appendParagraph('Registered Office: Chennai, Tamil Nadu, India | Quality & Training Directorate');

    pAddr.setFontFamily('Times New Roman').setFontSize(9).setItalic(true).setForegroundColor('#475569');



    body.appendHorizontalRule();



    const todayStr = Utilities.formatDate(new Date(), "GMT+5:30", "dd/MM/yyyy");

    const pMeta = body.appendParagraph(`Document Ref: GSV/MCR/${s.registrationId}    |    Date of Verification: ${todayStr}`);

    pMeta.setFontFamily('Times New Roman').setFontSize(9.5).setBold(true).setForegroundColor('#334155').setSpacingAfter(8);



    const sTable = body.appendTable([

      ['Intern Full Name:', s.studentName, 'GSV Registration ID:', s.registrationId],

      ['Register Number:', s.registerNumber, 'Batch Name:', s.batch],

      ['Institution / College:', s.collegeName, 'Department:', s.department],

      ['Project Title:', s.projectTitle, 'Internship Tenure:', `${s.durationDays} Days (${s.startDate} to ${s.endDate})`]

    ]);

    sTable.setBorderColor('#cbd5e1');

    sTable.setBorderWidth(0.5);

    for (let r = 0; r < 4; r++) {

      const row = sTable.getRow(r);

      row.getCell(0).setWidth(120).setBackgroundColor('#f8fafc').editAsText().setBold(true).setFontSize(9).setFontFamily('Times New Roman');

      row.getCell(1).setWidth(145).editAsText().setFontSize(9).setFontFamily('Times New Roman');

      row.getCell(2).setWidth(120).setBackgroundColor('#f8fafc').editAsText().setBold(true).setFontSize(9).setFontFamily('Times New Roman');

      row.getCell(3).setWidth(130).editAsText().setFontSize(9).setFontFamily('Times New Roman');

    }



    const pSec1 = body.appendParagraph('\n1. PROJECT HARDWARE COMPONENTS & KITS INVENTORY:');

    pSec1.setFontFamily('Times New Roman').setFontSize(11).setBold(true).setForegroundColor('#0f172a');



    let compRows = [

      ['S.No', 'Component / Kit Name', 'Specification', 'Qty', 'Issued Date', 'Return Date', 'Status', 'Staff Sign']

    ];

    if (comps.length > 0) {

      comps.forEach((c, i) => {

        compRows.push([

          String(i + 1),

          c.itemName || '--',

          c.specification || '--',

          String(c.quantity || 1),

          c.issuedDate || '--',

          c.returnDate || (c.status.toLowerCase() === 'returned' ? todayStr : '--'),

          c.status || 'Issued',

          c.status.toLowerCase() === 'returned' ? 'VERIFIED' : 'PENDING'

        ]);

      });

    } else {

      compRows.push(['--', 'NIL HARDWARE ISSUED', 'Student completed software/simulation domain without hardware loans.', '0', '--', '--', 'NIL DUES', 'VERIFIED']);

    }



    const cTable = body.appendTable(compRows);

    cTable.setBorderColor('#cbd5e1').setBorderWidth(0.5);

    const cHead = cTable.getRow(0);

    for (let j = 0; j < 8; j++) {

      cHead.getCell(j).setBackgroundColor('#1e293b').editAsText().setBold(true).setFontColor('#ffffff').setFontSize(8.5).setFontFamily('Times New Roman');

    }

    const widths = [30, 130, 110, 30, 55, 55, 55, 50];

    for (let r = 0; r < compRows.length; r++) {

      const row = cTable.getRow(r);

      for (let j = 0; j < 8; j++) {

        row.getCell(j).setWidth(widths[j]).setPaddingTop(3).setPaddingBottom(3);

        if (r > 0) {

          row.getCell(j).editAsText().setFontSize(8.5).setFontFamily('Times New Roman');

          if (j === 6) {

            const stText = compRows[r][j].toLowerCase();

            if (stText === 'returned' || stText === 'nil dues') {

              row.getCell(j).editAsText().setForegroundColor('#15803d').setBold(true);

            } else {

              row.getCell(j).editAsText().setForegroundColor('#b91c1c').setBold(true);

            }

          }

        }

      }

    }



    const pSec2 = body.appendParagraph('\n2. ACADEMIC SUBMISSIONS & ACCESS CARD CLEARANCE GATE:');

    pSec2.setFontFamily('Times New Roman').setFontSize(11).setBold(true).setForegroundColor('#0f172a');



    const acTable = body.appendTable([

      ['Item Description', 'Submission Requirement', 'Current Status', 'Verification Verdict'],

      ['Project Final Report', 'Comprehensive hard copy report with guide approval', s.projectReportSubmitted, s.projectReportSubmitted === 'Submitted' ? 'CLEARED' : 'PENDING'],

      ['Student Daily Diary', '30-Day completed Form-5 internship diary', s.projectReportSubmitted, s.projectReportSubmitted === 'Submitted' ? 'CLEARED' : 'PENDING'],

      ['Consolidated Attendance Record', 'Certified 30-Day Form-4 punch log', s.hardCopyStatus, s.hardCopyStatus === 'Submitted' ? 'CLEARED' : 'PENDING'],

      ['College ID Card Copy', 'Physical verified copy of institutional ID', 'Submitted & Verified', 'CLEARED'],

      ['Physical RFID Access Card', `Hardware RFID Tag (${s.rfidTag || 'None'}) return`, s.rfidStatus, sum.isRfidCleared ? 'CLEARED' : 'PENDING']

    ]);

    acTable.setBorderColor('#cbd5e1').setBorderWidth(0.5);

    const acHead = acTable.getRow(0);

    for (let j = 0; j < 4; j++) {

      acHead.getCell(j).setBackgroundColor('#1e293b').editAsText().setBold(true).setFontColor('#ffffff').setFontSize(8.5).setFontFamily('Times New Roman');

    }

    const acWidths = [150, 185, 90, 90];

    for (let r = 0; r < 6; r++) {

      const row = acTable.getRow(r);

      for (let j = 0; j < 4; j++) {

        row.getCell(j).setWidth(acWidths[j]).setPaddingTop(3).setPaddingBottom(3);

        if (r > 0) {

          row.getCell(j).editAsText().setFontSize(8.5).setFontFamily('Times New Roman');

          if (j === 3) {

            const verdict = row.getCell(j).getText();

            if (verdict === 'CLEARED') row.getCell(j).editAsText().setForegroundColor('#15803d').setBold(true);

            else row.getCell(j).editAsText().setForegroundColor('#b91c1c').setBold(true);

          }

        }

      }

    }



    const pVerdict = body.appendParagraph(`\nFINAL CLEARANCE VERDICT: ${sum.isAllCleared ? 'APPROVED - ALL MATERIALS & COMPONENTS SURRENDERED IN GOOD CONDITION' : 'PROVISIONAL / PENDING ITEMS OUTSTANDING'}`);

    pVerdict.setFontFamily('Times New Roman').setFontSize(10).setBold(true).setSpacingAfter(15);

    if (sum.isAllCleared) {

      pVerdict.setForegroundColor('#15803d');

    } else {

      pVerdict.setForegroundColor('#b91c1c');

    }



    const sigTable = body.appendTable([

      ['\n\n___________________________\nLab In-Charge / Store Keeper\nGSV Electrical Enterprises',

       '\n\n___________________________\nProject Lead & Technical Mentor\nEngineering Directorate',

       '\n\n___________________________\nAuthorized Signatory & Seal\nChief Training Officer']

    ]);

    sigTable.setBorderWidth(0);

    for (let j = 0; j < 3; j++) {

      sigTable.getRow(0).getCell(j).setWidth(171).setPaddingTop(10).setPaddingBottom(0).editAsText().setFontSize(9).setFontFamily('Times New Roman');

    }



    doc.saveAndClose();



    const pdfBlob = doc.getAs('application/pdf');

    pdfBlob.setName(`GSV_Material_Handover_Record_${s.registrationId.replace(/[^A-Za-z0-9_-]/g, '_')}.pdf`);

    const pdfFile = folder.createFile(pdfBlob);

    pdfFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);



    try {

      DriveApp.getFileById(doc.getId()).setTrashed(true);

    } catch(e) {}



    const pdfBase64 = Utilities.base64Encode(pdfBlob.getBytes());



    return {

      status: 'success',

      docUrl: pdfFile.getUrl(),

      fileId: pdfFile.getId(),

      pdfBase64: pdfBase64,

      fileName: pdfBlob.getName()

    };

  } catch (err) {

    return { status: 'error', message: err.toString() };

  }

}



function exportComponentHandoverReportCsv(batchFilter) {

  try {

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (!regSheet) return { status: 'error', message: 'Registrations sheet not found' };



    const compSheet = getSheet(SHEET_NAMES.COMPONENTS_ISSUED);

    const compData = compSheet ? getSheetDataAsObjects(compSheet) : [];



    const regData = getSheetDataAsObjects(regSheet);

    const cleanBatch = String(batchFilter || 'all').trim().toLowerCase();



    let rows = [

      [

        'Registration ID', 'Student Name', 'Register Number', 'Batch', 'College Name', 

        'Department', 'Project Title', 'Total Components Issued', 'Total Returned', 

        'Total Pending', 'Pending Component Names', 'Project Report Submitted', 

        'RFID Card Status', 'Overall Material Clearance Status'

      ]

    ];



    regData.forEach(s => {

      const regId = s.RegistrationID || '';

      if (!regId) return;

      const bName = s.Batch || '';

      if (cleanBatch !== 'all' && bName.toLowerCase() !== cleanBatch) return;



      const studentComps = compData.filter(c => String(c.InchargeStudentID || c.StudentID || '').trim().toUpperCase() === regId.toUpperCase());

      const totalIssued = studentComps.length;

      const returnedComps = studentComps.filter(c => String(c.Status || '').trim().toLowerCase() === 'returned');

      const pendingComps = studentComps.filter(c => String(c.Status || '').trim().toLowerCase() !== 'returned');

      const pendingNames = pendingComps.map(c => `${c.ItemName} (x${c.Quantity || 1})`).join('; ');



      let hcDetails = {};

      if (s.HardCopyDetails) {

        try { hcDetails = JSON.parse(s.HardCopyDetails); } catch(e) {}

      }

      const isHardCopy = (String(s.HardCopyStatus || s.HardCopy || '').toLowerCase() === 'submitted');

      const isReportSubmitted = (hcDetails.diary === true || isHardCopy);



      const rfidTag = s.RFID_TagID || s.RFID || '';

      const isRfidReturned = hcDetails.rfidCard === true || String(s.RFID_PhysicalStatus || '').toLowerCase() === 'received' || !rfidTag;

      const rfidStatus = isRfidReturned ? 'Returned' : (rfidTag ? 'In Possession' : 'Not Issued');



      const isAllCleared = (pendingComps.length === 0 && isRfidReturned && isReportSubmitted);



      rows.push([

        regId,

        getStudentFullName_(s),

        s.RegisterNumber || s.RegNo || '',

        bName,

        s.CollegeName || s.College || '',

        s.Department || '',

        s.ProjectTitle || s.Project || '',

        String(totalIssued),

        String(returnedComps.length),

        String(pendingComps.length),

        pendingNames,

        isReportSubmitted ? 'Submitted' : 'Pending',

        rfidStatus,

        isAllCleared ? 'CLEARED' : 'PENDING'

      ]);

    });



    let csv = '';

    rows.forEach(r => {

      const cleanRow = r.map(val => `"${String(val || '').replace(/"/g, '""')}"`);

      csv += cleanRow.join(',') + '\r\n';

    });



    return {

      status: 'success',

      csv: csv,

      fileName: 'Component_Material_Handover_Report_' + Utilities.formatDate(new Date(), "GMT+5:30", "yyyyMMdd_HHmm") + '.csv'

    };

  } catch (err) {

    return { status: 'error', message: err.toString() };

  }

}



// ADMIN CERTIFICATE DATA EXPORT & PUBLISH FUNCTIONS

// ============================================================================

function getCertificateExportData(filters) {

  try {

    filters = filters || {};

    const batchFilter = String(filters.batch || 'all').trim();

    const statusFilter = String(filters.status || 'all').trim().toLowerCase();

    const searchFilter = String(filters.search || '').trim().toLowerCase();

    const fromMonth = filters.fromMonth ? String(filters.fromMonth) : '';

    const toMonth = filters.toMonth ? String(filters.toMonth) : '';

    const fromDateStr = filters.fromDate ? String(filters.fromDate) : '';

    const toDateStr = filters.toDate ? String(filters.toDate) : '';



    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (!regSheet) return { status: 'error', message: 'Registrations sheet not found' };



    const regData = regSheet.getDataRange().getValues();

    if (regData.length < 2) return { status: 'success', data: [], count: 0, summary: { total: 0, issued: 0, notIssued: 0, pending: 0 } };



    const header = regData[0];

    const col = {};

    header.forEach((h, i) => {

      if (h) col[String(h).trim().toLowerCase().replace(/[\s_]/g, '')] = i;

    });



    // Load unified bulk attendance engine for 100% synchronized real attendance stats

    const attEngine = calculateBulkStudentAttendanceMap_();



    // Load student diary map for diary status / counts

    const diarySheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    const diaryMap = {};

    if (diarySheet) {

      const dData = diarySheet.getDataRange().getValues();

      if (dData.length > 1) {

        const dHeader = dData[0];

        const dRegCol = dHeader.indexOf("StudentRegistrationID") !== -1 ? dHeader.indexOf("StudentRegistrationID") : dHeader.indexOf("RegistrationID");

        for (let j = 1; j < dData.length; j++) {

          const rId = String(dData[j][dRegCol] || '').trim().toUpperCase();

          if (rId) {

            diaryMap[rId] = (diaryMap[rId] || 0) + 1;

          }

        }

      }

    }



    // Also load certificate data sheet for cross-referencing cert numbers and PDF links

    const certSheet = getSheet(SHEET_NAMES.CERTIFICATE_DATA);

    const certMap = {};

    if (certSheet) {

      const cData = certSheet.getDataRange().getValues();

      if (cData.length > 1) {

        const cHeader = cData[0];

        const cRegCol = cHeader.indexOf("StudentRegistrationID");

        const cNumCol = cHeader.indexOf("CertificateNumber");

        const cDateCol = cHeader.indexOf("IssuedDate");

        const cStatCol = cHeader.indexOf("Status");

        const cPdfCol = cHeader.indexOf("CertificatePdfId");

        const cdHcCol = cHeader.indexOf("HardCopyIssued");

        const cdHcDateCol = cHeader.indexOf("HardCopyIssuedDate");

        

        for (let j = 1; j < cData.length; j++) {

          const rId = String(cData[j][cRegCol] || '').trim().toUpperCase();

          if (rId) {

            certMap[rId] = {

              certNumber: String(cData[j][cNumCol] || ''),

              issuedDate: cData[j][cDateCol],

              status: String(cData[j][cStatCol] || 'Valid'),

              pdfId: String(cData[j][cPdfCol] || ''),

              hardCopyIssued: cdHcCol !== -1 ? String(cData[j][cdHcCol] || '') : '',

              hardCopyIssuedDate: cdHcDateCol !== -1 ? cData[j][cdHcDateCol] : ''

            };

          }

        }

      }

    }



    const rows = [];

    let totalCount = 0;

    let issuedCount = 0;

    let notIssuedCount = 0;

    let pendingCount = 0;



    for (let i = 1; i < regData.length; i++) {

      const r = regData[i];

      const regId = String(r[col['registrationid']] || r[col['registernumber']] || r[col['registerno']] || '').trim();

      if (!regId) continue;



      const regNo = String(r[col['registernumber']] || r[col['registerno']] || '').trim();

      const regIdUpper = regId.toUpperCase();

      const certInfo = certMap[regIdUpper] || (regNo ? certMap[regNo.toUpperCase()] : {}) || {};



      const firstName = String(r[col['firstname']] || '').trim();

      const middleName = String(r[col['middlename']] || '').trim();

      const lastName = String(r[col['lastname']] || '').trim();

      const fullName = [firstName, middleName, lastName].filter(Boolean).join(' ').trim() || String(r[col['name']] || 'N/A');

      const college = String(r[col['collegename']] || r[col['college']] || '').trim();

      const collegeDistrict = String(r[col['collegedistrict']] || r[col['district']] || '').trim();

      const rawDept = String(r[col['department']] || r[col['dept']] || '').trim();

      const department = expandDepartmentFullName(rawDept);



      const eduType = String(r[col['educationtype']] || '').trim();

      const year = String(r[col['year']] || '').trim();

      const semester = String(r[col['semester']] || '').trim();

      const track = String(r[col['internshiptrack']] || r[col['track']] || r[col['interestedarea']] || '').trim();

      let batch = String(r[col['batch']] || '').trim();

      if (!batch || batch.toLowerCase() === 'n/a' || batch === '') {

        const certMatch = (certInfo.certNumber || '').match(/GSV\/(\d{1,3})\//i);

        if (certMatch) {

          batch = 'Batch ' + certMatch[1];

        } else {

          batch = 'Unassigned';

        }

      }



      const startDateRaw = r[col['internshipstartdate']] || r[col['startdate']];

      const endDateRaw = r[col['internshipenddate']] || r[col['enddate']];

      const startDate = formatDate(startDateRaw);

      const endDate = formatDate(endDateRaw);

      const duration = r[col['durationdays']] || r[col['duration']] || 0;



      const certLinkFromReg = String(r[col['certificatelink']] || '').trim();

      const certDateFromReg = r[col['certificateissueddate']];

      const certNumber = certInfo.certNumber || String(r[col['certificatenumber']] || '');



      let certificateLink = certLinkFromReg;

      if (!certificateLink && certInfo.pdfId) {

        certificateLink = `https://drive.google.com/file/d/${certInfo.pdfId}/view`;

      }



      // Determine Issued Status

      const isIssued = Boolean(certNumber || certLinkFromReg || (certInfo.status === 'Valid' && certInfo.certNumber));

      const isDraftAdmin = (certInfo.status === 'Admin_Only_Draft' || certInfo.status === 'Admin_Only');

      

      let statusLabel = 'Not Issued';

      if (isIssued && !isDraftAdmin) {

        statusLabel = 'Issued';

        issuedCount++;

      } else if (isDraftAdmin) {

        statusLabel = 'Admin Draft (Unpublished)';

        pendingCount++;

      } else {

        notIssuedCount++;

      }

      totalCount++;



      // Internship & Hard Copy Status

      const rawAppStatus = String(r[col['applicationstatus']] || r[col['status']] || '').trim();
      const rawAppStatusLow = rawAppStatus.toLowerCase();
      // STRICT RULE: Pending students must NEVER appear in Certificate exports or lists
      if (rawAppStatusLow.includes('pending') || rawAppStatusLow.includes('opt-out') || rawAppStatusLow.includes('rejected')) {
        continue;
      }

      const isCompletedStudent = rawAppStatus.toLowerCase() === 'completed';

      const studentInternshipStatus = isCompletedStudent ? 'Completed' : (rawAppStatus || 'Incomplete');

      const studentHardCopyStatus = String(r[col['hardcopystatus']] || r[col['hardcopy']] || 'Not Submitted').trim();

      const certHardCopyStatus = String(r[col['certificatehardcopystatus']] || certInfo.hardCopyIssued || 'Pending').trim();

      const certHardCopyDate = r[col['certificatehardcopydate']] || certInfo.hardCopyIssuedDate || '';



      // Apply Filters with flexible normalization (e.g. 'batch 26' vs 'Batch 26' vs '26')

      const normBatch = (b) => String(b || '').toLowerCase().replace(/^batch\s*[-_]?/i, '').trim();

      if (batchFilter !== 'all' && batchFilter !== '') {

        const targetNorm = normBatch(batchFilter);

        const curNorm = normBatch(batch);

        const matchDirect = (batch.toLowerCase() === batchFilter.toLowerCase());

        const matchNorm = (curNorm && targetNorm && curNorm === targetNorm);

        if (!matchDirect && !matchNorm) {

          continue;

        }

      }



      if (statusFilter === 'issued' && statusLabel !== 'Issued') continue;

      if (statusFilter === 'not_issued' && statusLabel !== 'Not Issued') continue;

      if (statusFilter === 'pending' && statusLabel !== 'Admin Draft (Unpublished)' && statusLabel !== 'Pending') continue;

      if (statusFilter === 'completed' && !isCompletedStudent) continue;

      if (statusFilter === 'incomplete' && isCompletedStudent) continue;

      if (statusFilter === 'hardcopy_submitted' && studentHardCopyStatus.toLowerCase() !== 'submitted') continue;

      if (statusFilter === 'hardcopy_pending' && studentHardCopyStatus.toLowerCase() === 'submitted') continue;

      if (statusFilter === 'cert_hardcopy_issued' && certHardCopyStatus.toLowerCase() !== 'issued') continue;

      if (statusFilter === 'cert_hardcopy_pending' && certHardCopyStatus.toLowerCase() === 'issued') continue;



      // Date Range Filtering (based on Start Date or Issued Date)

      if (fromDateStr || toDateStr || fromMonth || toMonth) {

        const checkDateVal = startDateRaw || certDateFromReg || certInfo.issuedDate;

        if (checkDateVal) {

          const cDate = new Date(checkDateVal);

          if (!isNaN(cDate.getTime())) {

            const cIso = cDate.toISOString().slice(0, 10);

            const cMonthIso = cIso.slice(0, 7);

            if (fromDateStr && cIso < fromDateStr) continue;

            if (toDateStr && cIso > toDateStr) continue;

            if (fromMonth && cMonthIso < fromMonth) continue;

            if (toMonth && cMonthIso > toMonth) continue;

          }

        }

      }



      // Search keyword filter

      if (searchFilter) {

        const blob = `${fullName} ${regNo} ${regId} ${college} ${department} ${certNumber} ${batch}`.toLowerCase();

        if (!blob.includes(searchFilter)) continue;

      }



      rows.push({

        sNo: rows.length + 1,

        certificateNo: certNumber || 'N/A',

        registrationId: regId,

        registerNumber: regNo || 'N/A',

        studentName: fullName,

        collegeName: college || 'N/A',

        collegeDistrict: collegeDistrict || 'N/A',

        department: department || 'N/A',

        educationType: eduType || 'N/A',

        yearSemester: (year && semester) ? `${year} / ${semester}` : (year || semester || 'N/A'),

        internshipTrack: track || 'N/A',

        startDate: startDate || 'N/A',

        endDate: endDate || 'N/A',

        durationDays: duration || 0,

        attendedDays: (() => {

          const realAtt = attEngine._calculateForStudent({

            RegistrationID: regId,

            StartDate: startDateRaw,

            EndDate: endDateRaw,

            DurationDays: duration

          });

          return realAtt.attendedDays;

        })(),

        absentDays: (() => {

          const realAtt = attEngine._calculateForStudent({

            RegistrationID: regId,

            StartDate: startDateRaw,

            EndDate: endDateRaw,

            DurationDays: duration

          });

          return realAtt.absentDays;

        })(),

        attendancePercentage: (() => {

          const realAtt = attEngine._calculateForStudent({

            RegistrationID: regId,

            StartDate: startDateRaw,

            EndDate: endDateRaw,

            DurationDays: duration

          });

          return realAtt.percentage;

        })(),

        diaryCount: diaryMap[regIdUpper] || 0,

        diaryStatus: (diaryMap[regIdUpper] && diaryMap[regIdUpper] > 0) ? `${diaryMap[regIdUpper]} Entries` : 'Pending',

        isCompleted: isCompletedStudent,

        issuedDate: certInfo.issuedDate ? formatDate(certInfo.issuedDate) : (certDateFromReg ? formatDate(certDateFromReg) : 'N/A'),

        certificateStatus: statusLabel,

        certificateLink: certificateLink,

        batch: batch,

        internshipStatus: studentInternshipStatus,

        hardCopyStatus: studentHardCopyStatus || 'Not Submitted',

        hardCopyChecklist: (() => {

          const rawHd = (col['hardcopydetails'] !== undefined && r[col['hardcopydetails']]) ? r[col['hardcopydetails']] : null;

          if (rawHd) {

            try { return typeof rawHd === 'string' ? JSON.parse(rawHd) : rawHd; } catch(e) {}

          }

          return null;

        })(),

        certHardCopyStatus: certHardCopyStatus || 'Pending',

        certHardCopyDate: certHardCopyDate ? formatDate(certHardCopyDate) : ''

      });

    }



    // STRICT SORTING: Descending Order by Certificate Number

    // Latest issued certificate numbers appear at the very top, followed by unissued / pending records

    rows.sort((a, b) => {

      const hasA = (a.certificateNo && a.certificateNo !== 'N/A');

      const hasB = (b.certificateNo && b.certificateNo !== 'N/A');



      if (hasA && !hasB) return -1;

      if (!hasA && hasB) return 1;



      if (hasA && hasB) {

        // Extract sequence number from certificate string (e.g. GSV/25/PC/219/027 -> 27)

        const getSeq = (str) => {

          const match = String(str).match(/(\d+)(?!.*\d)/);

          return match ? parseInt(match[1], 10) : 0;

        };

        const seqA = getSeq(a.certificateNo);

        const seqB = getSeq(b.certificateNo);

        if (seqA !== seqB) {

          return seqB - seqA; // Descending: latest certificate number first

        }

        return String(b.certificateNo).localeCompare(String(a.certificateNo));

      }



      // If neither has a certificate number, maintain original order

      return 0;

    });



    // Re-index serial numbers

    rows.forEach((r, idx) => {

      r.sNo = idx + 1;

    });



    // Calculate summary metrics directly from the filtered rows

    const filteredTotal = rows.length;

    const filteredIssued = rows.filter(r => r.certificateStatus === 'Issued').length;

    const filteredPending = rows.filter(r => (r.certificateStatus || '').includes('Draft') || (r.certificateStatus || '').includes('Pending')).length;

    const filteredNotIssued = rows.filter(r => r.certificateStatus === 'Not Issued').length;



    return {

      status: 'success',

      data: rows,

      count: filteredTotal,

      summary: {

        total: filteredTotal,

        issued: filteredIssued,

        notIssued: filteredNotIssued,

        pending: filteredPending

      }

    };

  } catch (err) {

    Logger.log("Error in getCertificateExportData: " + err.toString());

    return { status: 'error', message: err.toString() };

  }

}



function publishCertificateToStudent(registrationId) {

  try {

    if (!registrationId) return { status: 'error', message: 'Missing Registration ID' };

    const regId = String(registrationId).trim().toUpperCase();



    // 1. Update Certificate Data sheet status to Valid

    const certSheet = getSheet(SHEET_NAMES.CERTIFICATE_DATA);

    let driveLink = '';

    let certNum = '';

    if (certSheet) {

      const cData = certSheet.getDataRange().getValues();

      const cHeader = cData[0];

      const cRegCol = cHeader.indexOf("StudentRegistrationID");

      const cStatCol = cHeader.indexOf("Status");

      const cPdfCol = cHeader.indexOf("CertificatePdfId");

      const cNumCol = cHeader.indexOf("CertificateNumber");



      if (cRegCol !== -1 && cStatCol !== -1) {

        for (let j = 1; j < cData.length; j++) {

          if (String(cData[j][cRegCol]).toUpperCase() === regId) {

            certSheet.getRange(j + 1, cStatCol + 1).setValue('Valid');

            certNum = String(cData[j][cNumCol] || '');

            const pdfId = String(cData[j][cPdfCol] || '');

            if (pdfId) {

              try {

                const f = DriveApp.getFileById(pdfId);

                driveLink = f.getUrl();

              } catch (e) {

                driveLink = `https://drive.google.com/file/d/${pdfId}/view`;

              }

            }

            break;

          }

        }

      }

    }



    // 2. Update Internship Registrations with CertificateLink and CertificateIssuedDate

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (regSheet) {

      const rData = regSheet.getDataRange().getValues();

      const rHeader = rData[0];

      const rRegCol = rHeader.indexOf("RegistrationID");

      const certLinkCol = rHeader.indexOf("CertificateLink");

      const certDateCol = rHeader.indexOf("CertificateIssuedDate");



      if (rRegCol !== -1) {

        for (let i = 1; i < rData.length; i++) {

          if (String(rData[i][rRegCol]).toUpperCase() === regId) {

            if (certLinkCol !== -1 && driveLink) regSheet.getRange(i + 1, certLinkCol + 1).setValue(driveLink);

            if (certDateCol !== -1) regSheet.getRange(i + 1, certDateCol + 1).setValue(new Date());

            break;

          }

        }

      }

    }



    return {

      status: 'success',

      message: `Certificate for ${registrationId} published successfully to Student Portal!`,

      driveLink: driveLink,

      certNumber: certNum

    };

  } catch (err) {

    Logger.log("Error in publishCertificateToStudent: " + err.toString());

    return { status: 'error', message: err.toString() };

  }

}



/**

 * Revokes / Deletes an existing certificate record so it can be cleanly regenerated without conflicts.

 * Clears Certificate Data sheet, Registrations sheet columns, and trashes Drive PDF.

 */

function revokeOrDeleteStudentCertificate(registrationId) {

  try {

    if (!registrationId) return { status: 'error', message: 'Missing Registration ID' };

    const regId = String(registrationId).trim().toUpperCase();



    let certNum = '';

    let pdfId = '';



    // 1. Delete matching row from Certificate Data sheet

    const certSheet = getSheet(SHEET_NAMES.CERTIFICATE_DATA);

    if (certSheet) {

      const cData = certSheet.getDataRange().getValues();

      if (cData.length > 1) {

        const cHeader = cData[0];

        const cRegCol = cHeader.indexOf("StudentRegistrationID");

        const cNumCol = cHeader.indexOf("CertificateNumber");

        const cPdfCol = cHeader.indexOf("CertificatePdfId");



        for (let j = cData.length - 1; j >= 1; j--) {

          if (String(cData[j][cRegCol] || '').trim().toUpperCase() === regId) {

            certNum = String(cData[j][cNumCol] || '');

            pdfId = String(cData[j][cPdfCol] || '');

            certSheet.deleteRow(j + 1);

          }

        }

      }

    }



    // 2. Trash Drive PDF file if found

    if (pdfId) {

      try {

        DriveApp.getFileById(pdfId).setTrashed(true);

        Logger.log(`Trashed certificate PDF ${pdfId} for student ${regId}`);

      } catch (e) {

        Logger.log(`Could not trash PDF ${pdfId}: ${e.toString()}`);

      }

    }



    // 3. Clear from Internship Registrations sheet

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (regSheet) {

      const rData = regSheet.getDataRange().getValues();

      if (rData.length > 1) {

        const rHeader = rData[0];

        const rRegCol = rHeader.indexOf("RegistrationID");

        const certLinkCol = rHeader.indexOf("CertificateLink");

        const certDateCol = rHeader.indexOf("CertificateIssuedDate");

        const certNumCol = rHeader.indexOf("CertificateNumber");



        for (let i = 1; i < rData.length; i++) {

          if (String(rData[i][rRegCol] || '').trim().toUpperCase() === regId) {

            if (certLinkCol !== -1) regSheet.getRange(i + 1, certLinkCol + 1).setValue('');

            if (certDateCol !== -1) regSheet.getRange(i + 1, certDateCol + 1).setValue('');

            if (certNumCol !== -1) regSheet.getRange(i + 1, certNumCol + 1).setValue('');

            break;

          }

        }

      }

    }



    SpreadsheetApp.flush();



    return {

      status: 'success',

      message: `Certificate record ${certNum ? '(' + certNum + ') ' : ''}for ${regId} has been revoked and deleted. It can now be regenerated cleanly.`

    };

  } catch (err) {

    Logger.log("Error in revokeOrDeleteStudentCertificate: " + err.toString());

    return { status: 'error', message: err.toString() };

  }

}



/**

 * Updates physical hard copy submission status for a student.

 */

function updateStudentHardCopyStatus(registrationId, status) {

  try {

    if (!registrationId) return { status: 'error', message: 'Missing Registration ID' };

    const regId = String(registrationId).trim().toUpperCase();

    const hardCopyVal = String(status || 'Submitted').trim();



    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (!regSheet) return { status: 'error', message: 'Registrations sheet not found' };



    const rData = regSheet.getDataRange().getValues();

    const rHeader = rData[0];

    const rRegCol = rHeader.indexOf("RegistrationID");

    let hcCol = rHeader.indexOf("HardCopyStatus");

    if (hcCol === -1) hcCol = rHeader.indexOf("HardCopy");

    if (hcCol === -1) {

      hcCol = rHeader.length;

      regSheet.getRange(1, hcCol + 1).setValue("HardCopyStatus");

    }



    for (let i = 1; i < rData.length; i++) {

      if (String(rData[i][rRegCol] || '').trim().toUpperCase() === regId) {

        regSheet.getRange(i + 1, hcCol + 1).setValue(hardCopyVal);

        SpreadsheetApp.flush();

        return { status: 'success', message: `Hard copy status updated to '${hardCopyVal}' for ${regId}` };

      }

    }

    return { status: 'error', message: `Student ${regId} not found` };

  } catch (err) {

    return { status: 'error', message: err.toString() };

  }

}



/**

 * Centralized updater for Certificate Hard Copy Issued Status.

 * Synchronizes across Registrations sheet, Certificate Data sheet, and Closed/Opt-out sheet.

 */

function updateCertificateHardCopyStatus(registrationId, status, issuedDate) {

  try {

    if (!registrationId) return { status: 'error', message: 'Missing Registration ID' };

    const regId = String(registrationId).trim().toUpperCase();

    const hardCopyVal = String(status || 'Issued').trim();

    const isIssued = (hardCopyVal.toLowerCase() === 'issued');

    const dateVal = issuedDate ? new Date(issuedDate) : (isIssued ? new Date() : '');



    let foundInReg = false;



    // 1. Update Internship Registrations

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (regSheet) {

      const rData = regSheet.getDataRange().getValues();

      const rHeader = rData[0];

      const rRegCol = rHeader.indexOf("RegistrationID");

      let certHcCol = rHeader.indexOf("CertificateHardCopyStatus");

      if (certHcCol === -1) {

        certHcCol = rHeader.length;

        regSheet.getRange(1, certHcCol + 1).setValue("CertificateHardCopyStatus");

      }

      let certHcDateCol = rHeader.indexOf("CertificateHardCopyDate");

      if (certHcDateCol === -1) {

        certHcDateCol = rHeader.length + (certHcCol === rHeader.length ? 1 : 0);

        regSheet.getRange(1, certHcDateCol + 1).setValue("CertificateHardCopyDate");

      }



      if (rRegCol !== -1) {

        for (let i = 1; i < rData.length; i++) {

          if (String(rData[i][rRegCol] || '').trim().toUpperCase() === regId) {

            regSheet.getRange(i + 1, certHcCol + 1).setValue(hardCopyVal);

            regSheet.getRange(i + 1, certHcDateCol + 1).setValue(dateVal);

            foundInReg = true;

            break;

          }

        }

      }

    }



    // 2. Also check Closed and Opt-out sheet

    try {

      const closedSheet = getSheet('Closed and Opt-out');

      if (closedSheet) {

        const cData = closedSheet.getDataRange().getValues();

        const cHeader = cData[0];

        const cRegCol = cHeader.indexOf("RegistrationID");

        let certHcCol = cHeader.indexOf("CertificateHardCopyStatus");

        if (certHcCol === -1) {

          certHcCol = cHeader.length;

          closedSheet.getRange(1, certHcCol + 1).setValue("CertificateHardCopyStatus");

        }

        let certHcDateCol = cHeader.indexOf("CertificateHardCopyDate");

        if (certHcDateCol === -1) {

          certHcDateCol = cHeader.length + (certHcCol === cHeader.length ? 1 : 0);

          closedSheet.getRange(1, certHcDateCol + 1).setValue("CertificateHardCopyDate");

        }

        if (cRegCol !== -1) {

          for (let i = 1; i < cData.length; i++) {

            if (String(cData[i][cRegCol] || '').trim().toUpperCase() === regId) {

              closedSheet.getRange(i + 1, certHcCol + 1).setValue(hardCopyVal);

              closedSheet.getRange(i + 1, certHcDateCol + 1).setValue(dateVal);

              foundInReg = true;

              break;

            }

          }

        }

      }

    } catch(cErr) {}



    // 3. Update Certificate Data sheet if present

    try {

      const certSheet = getSheet(SHEET_NAMES.CERTIFICATE_DATA);

      if (certSheet) {

        const cdData = certSheet.getDataRange().getValues();

        const cdHeader = cdData[0];

        const cdRegCol = cdHeader.indexOf("StudentRegistrationID");

        let cdHcCol = cdHeader.indexOf("HardCopyIssued");

        if (cdHcCol === -1) {

          cdHcCol = cdHeader.length;

          certSheet.getRange(1, cdHcCol + 1).setValue("HardCopyIssued");

        }

        let cdHcDateCol = cdHeader.indexOf("HardCopyIssuedDate");

        if (cdHcDateCol === -1) {

          cdHcDateCol = cdHeader.length + (cdHcCol === cdHeader.length ? 1 : 0);

          certSheet.getRange(1, cdHcDateCol + 1).setValue("HardCopyIssuedDate");

        }

        if (cdRegCol !== -1) {

          for (let j = 1; j < cdData.length; j++) {

            if (String(cdData[j][cdRegCol] || '').trim().toUpperCase() === regId) {

              certSheet.getRange(j + 1, cdHcCol + 1).setValue(hardCopyVal);

              certSheet.getRange(j + 1, cdHcDateCol + 1).setValue(dateVal);

              break;

            }

          }

        }

      }

    } catch(cdErr) {}



    SpreadsheetApp.flush();

    if (typeof logActivity === 'function') {

      logActivity('Certificate Hard Copy', regId, `Certificate Hard Copy status marked as '${hardCopyVal}'`);

    }



    const fmtDate = dateVal instanceof Date ? Utilities.formatDate(dateVal, "GMT+5:30", "dd/MM/yyyy") : '';

    return {

      status: 'success',

      registrationId: regId,

      hardCopyStatus: hardCopyVal,

      date: fmtDate,

      message: `Certificate Hard Copy for ${regId} successfully marked as '${hardCopyVal}'`

    };

  } catch (err) {

    Logger.log("Error in updateCertificateHardCopyStatus: " + err);

    return { status: 'error', message: err.toString() };

  }

}



/**

 * Generates and returns a single certificate as base64 for instant browser download.

 */

function exportCertificatePdfBase64(registrationId, options) {

  try {

    options = options || {};

    const regId = String(registrationId).trim().toUpperCase();

    const templateChoice = options.template || options.certTemplate || (options.includePhoto !== false ? 'T2' : 'T1');

    const sendEmailOption = options.sendEmail === true || options.sendEmail === 'true';

    const isPreview = options.isPreview === true || options.isPreview === 'true';



    const res = generateDocumentAndMail('completionCertificate', regId, sendEmailOption, true, {

      certTemplate: templateChoice,

      forceNew: (options.forceNew !== undefined) ? (options.forceNew === true || options.forceNew === 'true') : true,

      viewExisting: options.viewExisting === true || options.viewExisting === 'true',

      includePhoto: options.includePhoto !== false && options.includePhoto !== 'no_photo',

      includeSeal: options.includeSeal !== false && options.includeSeal !== 'no_seal',

      includeSignature: options.includeSignature !== false && options.includeSignature !== 'none',

      includePhysicalSeal: options.includePhysicalSeal === true || options.includePhysicalSeal === 'true',

      includePhysicalSig: options.includePhysicalSig === true || options.includePhysicalSig === 'true',

      includePhysicalSealSig: options.includePhysicalSealSig === true || options.includePhysicalSealSig === 'true' || options.signature === 'physical',

      includeDigitalSign: options.includeDigitalSign !== false && options.includeDigitalSign !== 'false' && options.signature !== 'none',

      includeVerificationQR: options.includeVerificationQR !== false && options.includeVerificationQR !== 'false',

      addVerificationWatermark: options.addVerificationWatermark === true || options.addVerificationWatermark === 'true',

      includeNote: options.includeNote === true || options.includeNote === 'true',

      sigWidth: options.sigWidth,

      sigHeight: options.sigHeight,

      sealWidth: options.sealWidth,

      sealHeight: options.sealHeight,

      qrWidth: options.qrWidth,

      qrHeight: options.qrHeight,

      barcodeWidth: options.barcodeWidth,

      barcodeHeight: options.barcodeHeight,

      manualAttendedDays: options.manualAttendedDays || '',

      sendEmail: sendEmailOption,

      isPreview: isPreview,

      bodyFontSize: options.bodyFontSize,

      lineSpacing: options.lineSpacing,

      alignment: options.alignment,

      signatoryFontSize: options.signatoryFontSize

    });



    if (!res || res.status !== 'success') {

      return res || { status: 'error', message: 'Failed to generate certificate PDF.' };

    }



    const file = DriveApp.getFileById(res.fileId);

    const blob = file.getBlob();

    const base64 = Utilities.base64Encode(blob.getBytes());

    const fileName = file.getName();



    return {

      status: 'success',

      base64: base64,

      fileName: fileName,

      certNumber: res.certNumber || '',

      attendedDays: res.attendedDays || '',

      studentName: res.studentName || '',

      collegeName: res.collegeName || '',

      batch: res.batch || '',

      driveLink: res.driveLink || '',

      previewUrl: res.driveLink || res.url || ''

    };

  } catch (err) {

    Logger.log("Error in exportCertificatePdfBase64: " + err.toString());

    return { status: 'error', message: err.toString() };

  }

}



/**

 * Logs Certificate Export History in Script Properties or History log.

 */

function logCertificateExportHistory(exportedBy, count, studentSummary, batchName) {

  try {

    const props = PropertiesService.getScriptProperties();

    let history = [];

    const histStr = props.getProperty('CERT_EXPORT_HISTORY');

    if (histStr) {

      try { history = JSON.parse(histStr); } catch(e) {}

    }

    if (!Array.isArray(history)) history = [];



    const entry = {

      timestamp: new Date().toISOString(),

      formattedDate: new Date().toLocaleString(),

      exportedBy: exportedBy || 'Administrator',

      count: count || 1,

      batch: batchName || 'Multiple / Filtered',

      students: studentSummary || ''

    };



    history.unshift(entry);

    if (history.length > 50) history = history.slice(0, 50); // Keep last 50

    props.setProperty('CERT_EXPORT_HISTORY', JSON.stringify(history));

    return { status: 'success', entry: entry };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



function getCertificateExportHistory() {

  try {

    const props = PropertiesService.getScriptProperties();

    const histStr = props.getProperty('CERT_EXPORT_HISTORY');

    const history = histStr ? JSON.parse(histStr) : [];

    return { status: 'success', data: history };

  } catch (e) {

    return { status: 'error', data: [], message: e.toString() };

  }

}



/**

 * Student Profile Update Request Handler (e.g. for Gender, Contact details).

 */

function submitStudentProfileUpdateRequest(registrationId, fields) {

  try {

    if (!registrationId || !fields) return { status: 'error', message: 'Missing parameters.' };

    const regId = String(registrationId).trim().toUpperCase();



    const srSheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

    if (!srSheet) return { status: 'error', message: 'Student requests sheet not found.' };



    const studentResp = getStudentFullData(regId);

    const stu = (studentResp && studentResp.studentData) ? studentResp.studentData : {};

    const stuName = getStudentFullName_(stu);



    const reason = `Profile Change Request: Gender: ${fields.gender || 'Unchanged'}, Mobile: ${fields.mobile || 'Unchanged'}, Notes: ${fields.reason || 'Requested by student'}`;



    const headers = srSheet.getRange("1:1").getValues()[0];

    const rowObj = {

      RequestID: 'REQ-PROF-' + new Date().getTime(),

      RegistrationID: regId,

      StudentName: stuName,

      Batch: stu.Batch || '',

      RequestType: 'Profile Update',

      Section: 'Profile',

      Reason: reason,

      RequestedChanges: JSON.stringify(fields),

      Status: 'Pending',

      Timestamp: new Date()

    };



    const row = headers.map(h => rowObj[h] !== undefined ? rowObj[h] : '');

    appendRow(SHEET_NAMES.STUDENT_REQUESTS, row);



    return {

      status: 'success',

      message: 'Your profile update request has been submitted for Administrator review.'

    };

  } catch(e) {

    return { status: 'error', message: e.toString() };

  }

}



