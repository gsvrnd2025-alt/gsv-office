// Note: getStudentTasks and getStudentProjects are already defined with robust column mapping around line 4300.

// Removing duplicates here to prevent overwriting correct logic.



// DUPLICATE REMOVED: getStudentAttendance is defined at ~line 6183 with full calendar support

// (summary, indicators, internship dates, RFID). Do NOT redefine here.



// DUPLICATE REMOVED: getStudentCertificate is defined at ~line 6688 with full document lookup.

// Do NOT redefine here.



/**

 * Deep-cleans an object so it is safe to serialize and return to the client via google.script.run.

 * Converts: Date objects → ISO strings, NaN → null, undefined → null, Infinity → null,

 * Google Sheets formula errors (#N/A, #REF!, #VALUE!, etc.) → null.

 */

function sanitizeForJson(val, depth) {

  if (depth === undefined) depth = 0;

  if (depth > 10) return null; // Prevent runaway recursion

  if (val === null || val === undefined) return null;

  if (val instanceof Date) {

    return isNaN(val.getTime()) ? null : val.toISOString();

  }

  if (typeof val === 'number') {

    if (isNaN(val) || !isFinite(val)) return null;

    return val;

  }

  if (typeof val === 'string') {

    // Convert Google Sheets formula errors to null

    if (/^#(N\/A|REF!|VALUE!|DIV\/0!|NAME\?|NUM!|NULL!)/.test(val.trim())) return null;

    return val;

  }

  if (typeof val === 'boolean') return val;

  if (Array.isArray(val)) {

    return val.map(function(item) { return sanitizeForJson(item, depth + 1); });

  }

  if (typeof val === 'object') {

    var clean = {};

    for (var key in val) {

      if (Object.prototype.hasOwnProperty.call(val, key)) {

        clean[key] = sanitizeForJson(val[key], depth + 1);

      }

    }

    return clean;

  }

  return val;

}



function getStudentComprehensiveProfile(regId) {

  try {

    // 1. Details

    const detailsResp = getStudentFullData(regId);

    if (detailsResp.status !== 'success') {

      return { status: 'error', message: detailsResp.message };

    }

    const d = detailsResp.studentData;



    // Helper to find key in object case-insensitively and space-insensitively

    const findValue = (obj, keyPart) => {

      const normalizedPart = keyPart.toLowerCase().replace(/\s+/g, '').replace(/url$/g, '');

      const actualKey = Object.keys(obj).find(k => {

        const normalizedKey = k.toLowerCase().replace(/\s+/g, '').replace(/url$/g, '');

        return normalizedKey === normalizedPart || normalizedKey.includes(normalizedPart);

      });

      return actualKey ? obj[actualKey] : null;

    };



    // Helper to parse dates safely and avoid NaN issues

    const parseSafeDate = (val) => {

      if (!val || val === 'N/A' || String(val).trim() === '') return null;

      const d = new Date(val);

      return isNaN(d.getTime()) ? null : d;

    };



    // Calculate grace period variables

    const today = new Date();

    today.setHours(0, 0, 0, 0);

    const rawEndDate = d["InternshipEndDate"] || d["EndDate"];

    const endDate = parseSafeDate(rawEndDate);

    

    let graceExpired = false;

    let inDefaultGracePeriod = false;

    let hasPendingExtension = false;



    if (endDate) {

      const gracePeriodEndDate = new Date(endDate);

      gracePeriodEndDate.setHours(0, 0, 0, 0);

      gracePeriodEndDate.setDate(gracePeriodEndDate.getDate() + 15); // 15 days default grace period

      

      const parsedEnd = new Date(endDate);

      parsedEnd.setHours(0, 0, 0, 0);

      

      if (today > gracePeriodEndDate) {

        const gpAreas = getApprovedGracePeriodAreas(regId);

        if (gpAreas.length === 0) {

          graceExpired = true;

        }

      } else if (today > parsedEnd && today <= gracePeriodEndDate) {

        inDefaultGracePeriod = true;

      }

    }

    

    if (graceExpired) {

      const otpSheet = getSheet(SHEET_NAMES.ATTENDANCE_OTP);

      if (otpSheet) {

        const otpData = getSheetDataAsObjects(otpSheet);

        const pendingReq = otpData.find(r => 

          String(r.RegistrationID || "").trim().toLowerCase() === String(regId).toLowerCase() &&

          String(r.Status || "").trim() === 'Pending' &&

          String(r.ActionType || "").trim() === 'GracePeriod'

        );

        if (pendingReq) {

          hasPendingExtension = true;

        }

      }

    }



    const isPermitted = !graceExpired;



    // Resolve profile photo URL with automatic self-healing sync from approved requests

    let studentPhotoUrl = d["ProfilePhotoUrl"] || d["PhotoUrl"] || d["Photo"] || d["ProfilePhoto"] || d["photoUrl"] || '';

    if (!studentPhotoUrl) {

      try {

        const reqSheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

        if (reqSheet) {

          const rData = reqSheet.getDataRange().getValues();

          if (rData.length > 1) {

            const rHeaders = rData[0].map(h => String(h || '').trim());

            const rRegCol = rHeaders.findIndex(h => ['registrationid', 'studentregistrationid', 'regid'].includes(h.toLowerCase().replace(/[^a-z0-9]/g, '')));

            const rTypeCol = rHeaders.findIndex(h => ['requesttype', 'type'].includes(h.toLowerCase().replace(/[^a-z0-9]/g, '')));

            const rStatCol = rHeaders.findIndex(h => ['status'].includes(h.toLowerCase().replace(/[^a-z0-9]/g, '')));

            const rAttachCol = rHeaders.findIndex(h => ['attachmenturl', 'attachment', 'photourl'].includes(h.toLowerCase().replace(/[^a-z0-9]/g, '')));

            if (rRegCol !== -1 && rTypeCol !== -1 && rStatCol !== -1 && rAttachCol !== -1) {

              for (let i = rData.length - 1; i >= 1; i--) {

                const rowReg = String(rData[i][rRegCol] || '').trim().toUpperCase();

                const rowType = String(rData[i][rTypeCol] || '').toLowerCase();

                const rowStat = String(rData[i][rStatCol] || '').toLowerCase();

                const rowUrl = String(rData[i][rAttachCol] || '').trim();

                if (rowReg === String(regId).trim().toUpperCase() &&

                    (rowType.includes('photo') || rowType.includes('profile')) &&

                    rowStat === 'approved' && rowUrl) {

                  studentPhotoUrl = rowUrl;

                  // Persist back to student sheet so future reads are instant

                  try {

                    const closedSheet = getSheet('Closed and Opt-out');

                    if (closedSheet) {

                      const cData = closedSheet.getDataRange().getValues();

                      const cHeaders = cData[0].map(h => String(h || '').trim().toLowerCase().replace(/[^a-z0-9]/g, ''));

                      const cRegCol = cHeaders.indexOf('registrationid');

                      let cPhotoCol = cHeaders.indexOf('profilephotourl');

                      if (cPhotoCol === -1) cPhotoCol = cHeaders.indexOf('photourl');

                      if (cRegCol !== -1) {

                        for (let cr = 1; cr < cData.length; cr++) {

                          if (String(cData[cr][cRegCol] || '').trim().toUpperCase() === rowReg) {

                            if (cPhotoCol === -1) {

                              cPhotoCol = cHeaders.length;

                              closedSheet.getRange(1, cPhotoCol + 1).setValue('ProfilePhotoUrl');

                            }

                            closedSheet.getRange(cr + 1, cPhotoCol + 1).setValue(rowUrl);

                            break;

                          }

                        }

                      }

                    }

                  } catch(pe) {}

                  break;

                }

              }

            }

          }

        }

      } catch(e) {}

    }



    // Parse Remarks if structured tags exist
    const remStr = String(d["Remarks"] || d["remarks"] || '');
    let parsedEmpCompany = '', parsedEmpId = '', parsedEmpDesig = '', parsedEmpExp = '', parsedEmpGst = '';
    let parsedFacInst = '', parsedFacStaffId = '', parsedFacDomain = '', parsedFacExp = '';
    if (remStr.includes('[EMPLOYEE]')) {
      const mComp = remStr.match(/Company:\s*([^,(]+)/i);
      if (mComp) parsedEmpCompany = mComp[1].trim();
      const mGst = remStr.match(/GST:\s*([^),]+)/i);
      if (mGst) parsedEmpGst = mGst[1].trim();
      const mEmpId = remStr.match(/EmpID:\s*([^,]+)/i);
      if (mEmpId) parsedEmpId = mEmpId[1].trim();
      const mDesig = remStr.match(/Desig:\s*([^,]+)/i);
      if (mDesig) parsedEmpDesig = mDesig[1].trim();
      const mExp = remStr.match(/Exp:\s*([^,.]+)/i);
      if (mExp) parsedEmpExp = mExp[1].trim();
    }
    if (remStr.includes('[FACULTY]')) {
      const mInst = remStr.match(/Institution:\s*([^,]+)/i);
      if (mInst) parsedFacInst = mInst[1].trim();
      const mStaff = remStr.match(/Staff ID:\s*([^,]+)/i);
      if (mStaff) parsedFacStaffId = mStaff[1].trim();
      const mDom = remStr.match(/Domain:\s*([^,]+)/i);
      if (mDom) parsedFacDomain = mDom[1].trim();
      const mExp = remStr.match(/Exp:\s*([^,.]+)/i);
      if (mExp) parsedFacExp = mExp[1].trim();
    }

    // Map to frontend-friendly keys
    const details = {
      candidateType: getCandidateCategory_(d),
      candidateCategory: getCandidateCategory_(d),
      companyName: parsedEmpCompany || d["CompanyName"] || d["Company"] || d["CollegeName"] || '',
      designation: parsedEmpDesig || d["Designation"] || d["companyDesignation"] || d["FacultyDesignation"] || d["Department"] || '',
      domain: d["Domain"] || d["companyDomain"] || d["facultyDomain"] || parsedFacDomain || d["InterestedArea"] || '',
      experience: parsedEmpExp || parsedFacExp || d["Experience"] || d["companyExperience"] || d["facultyExperience"] || d["TeachingExperience"] || d["IndustryExperience"] || '',
      employeeId: parsedEmpId || d["EmployeeId"] || d["companyEmployeeId"] || d["RegisterNumber"] || '',
      facultyStaffId: parsedFacStaffId || d["FacultyStaffId"] || d["StaffId"] || d["RegisterNumber"] || '',
      facultyDomain: parsedFacDomain || d["facultyDomain"] || d["Domain"] || d["InterestedArea"] || '',
      facultyExperience: parsedFacExp || d["facultyExperience"] || d["TeachingExperience"] || d["Experience"] || '',
      gstin: parsedEmpGst || d["GSTIN"] || d["CompanyGst"] || d["CompanyRegNumber"] || d["CollegeCode"] || '',
      remarks: remStr,

      registrationId: d["RegistrationID"] || d["registrationId"] || regId,

      name: getStudentFullName_(d),

      firstName: d["FirstName"] || '',

      middleName: d["MiddleName"] || '',

      lastName: d["LastName"] || '',

      email: d["GmailID"] || d["gmailId"],

      mobile: d["MobileNumber"] || d["mobile"],

      batch: d["Batch"] || d["batch"],

      college: d["CollegeName"] || d["college"],

      department: d["Department"] || d["department"],

      year: d["Year"] || d["year"],

      registerNumber: d["RegisterNumber"] || d["registerNumber"],

      addressLine: d["Address"] || d["address"],

      district: d["District"] || d["district"],

      pincode: d["Pincode"] || d["pincode"],

      approvalDate: formatDateISO(d["ApprovalDate"] || d["approvalDate"] || (['approved', 'completed', 'active', 'internship completed', 'internship period ended'].includes(String(d["ApplicationStatus"] || d["Status"] || '').toLowerCase()) ? (d["Timestamp"] || new Date()) : '')),
      ApprovalDate: formatDateISO(d["ApprovalDate"] || d["approvalDate"] || (['approved', 'completed', 'active', 'internship completed', 'internship period ended'].includes(String(d["ApplicationStatus"] || d["Status"] || '').toLowerCase()) ? (d["Timestamp"] || new Date()) : '')),
      isCompleted: (['completed', 'internship completed', 'internship period ended', 'closed', 'past'].includes(String(d["ApplicationStatus"] || d["Status"] || '').toLowerCase())),
      isApproved: (['approved', 'active', 'assigned', 'completed', 'internship completed', 'internship period ended', 'closed', 'past'].includes(String(d["ApplicationStatus"] || d["Status"] || '').toLowerCase())),
      appliedDate: formatDateISO(d["Timestamp"]),

      status: String(d["ApplicationStatus"] || d["Status"] || d["status"] || "").toLowerCase(),

      startDate: formatDateISO(d["InternshipStartDate"]),

      endDate: formatDateISO(d["InternshipEndDate"]),

      InternshipStartDate: formatDateISO(d["InternshipStartDate"]),

      InternshipEndDate: formatDateISO(d["InternshipEndDate"]),

      educationType: d["EducationType"],

      semester: d["Semester"],

      durationDays: d["DurationDays"],

      lastLogin: formatDateISO(d["LastLogin"]),

      lastActivity: formatDateISO(d["LastChatCheck"]),

      hardCopyStatus: d["HardCopyStatus"] || d["HardCopy"] || 'Pending',

      hardCopyDetails: d["HardCopyDetails"] || '',

      profilePhotoUrl: studentPhotoUrl,

      email: d["GmailID"] || d["EmailID"] || d["email"] || d["Gmail_ID"] || '',

      gmailId: d["GmailID"] || '',

      dob: formatDateISO(d["DateofBirth"]),

      cgpa: d["GPA"],

      collegeDistrict: d["CollegeDistrict"],

      collegeCode: d["CollegeCode"],

      interestedArea: d["InterestedArea"],

      internshipMode: d["InternshipMode"] || d["internshipMode"] || d["Mode"] || 'Offline',

      isOnline: String(d["InternshipMode"] || d["internshipMode"] || d["Mode"] || '').toLowerCase().trim() === 'online',

      isPreTenure: !!(parseSafeDate(d["InternshipStartDate"] || d["StartDate"]) && today < parseSafeDate(d["InternshipStartDate"] || d["StartDate"])),

      graceExpired: graceExpired,

      hasPendingExtension: hasPendingExtension,

      inDefaultGracePeriod: inDefaultGracePeriod,

      documents: {

        bonafide: !!findValue(d, "Bonafide"),

        declaration: !!findValue(d, "Declaration"),

        collegeId: !!(findValue(d, "CollegeId") || findValue(d, "IDCard") || findValue(d, "College ID")),

        other: !!findValue(d, "Other")

      },

      permissions: {

        attendance: isPermitted && (inDefaultGracePeriod || (d["AttendanceAccess"] !== false && d["AttendanceAccess"] !== 'FALSE' && String(d["AttendanceAccess"]).trim().toUpperCase() !== 'FALSE') || getApprovedGracePeriodAreas(regId).includes('attendance')),

        diary: isPermitted && (inDefaultGracePeriod || (d["DiaryAccess"] !== false && d["DiaryAccess"] !== 'FALSE' && String(d["DiaryAccess"]).trim().toUpperCase() !== 'FALSE') || getApprovedGracePeriodAreas(regId).includes('diary')),

        tasks: isPermitted && (inDefaultGracePeriod || getApprovedGracePeriodAreas(regId).includes('tasks')),

        projects: isPermitted && (inDefaultGracePeriod || getApprovedGracePeriodAreas(regId).includes('projects'))

      },

      rfidTag: (() => {

        let t = d["RFID_TagID"] || d["RFID"] || d["Rfid"] || '';

        if (!t) {

          try {

            const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);

            if (invSheet) {

              const rows = getSheetDataAsObjects(invSheet) || [];

              const found = rows.find(r => String(r.AssignedTo || r.assignedTo || r.AssignedToID || r.assignedToId || '').trim().toUpperCase() === String(regId).trim().toUpperCase());

              if (found) t = standardizeRfidFormat(String(found.RFID_TagID || found.TagID || found.tagId || '').trim());

            }

          } catch(e) {}

        }

        return t;

      })(),

      rfidPhysicalStatus: d["RFID_PhysicalStatus"] || d["PhysicalStatus"] || '',

      rfidHandoverStatus: d["RFID_HandoverStatus"] || d["HandoverStatus"] || '',

      slotTiming: (() => {

        try {

          const bId = String(d["Batch"] || d["batch"] || '');

          const s = getSlotTiming(bId, getTodayStr(), regId);

          return s ? `${s.start} - ${s.end}` : '09:00 AM - 05:00 PM';

        } catch(e) { return '09:00 AM - 05:00 PM'; }

      })(),

      RFID_TagID: d["RFID_TagID"] || d["RFID"] || d["Rfid"] || '',

      RFID_PhysicalStatus: d["RFID_PhysicalStatus"] || d["PhysicalStatus"] || '',

      RFID_HandoverStatus: d["RFID_HandoverStatus"] || d["HandoverStatus"] || '',

      certificateIssued: !['pending', 'submitted', 'rejected'].includes(String(d["ApplicationStatus"] || d["Status"] || '').toLowerCase()) && !!( (d["CertificateLink"] && String(d["CertificateLink"]).trim().startsWith('http')) || (d["CertificateIssuedDate"] && String(d["CertificateIssuedDate"]).trim() !== '0' && String(d["CertificateIssuedDate"]).trim() !== '-') ),

      certificateHardCopyStatus: d["CertificateHardCopyStatus"] || (d["CertificateIssued"] === 'Issued' ? 'Issued' : 'Pending'),

      certificateHardCopyDate: d["CertificateHardCopyDate"] ? formatDateISO(d["CertificateHardCopyDate"]) : ''

    };



    // Internship Status Logic Update
    if (endDate && today > endDate) {
      if (details.certificateIssued) {
        details.status = "internship completed";
        details.isCompleted = true;
        details.isApproved = true;
      } else if (today > gracePeriodEndDate) {
        details.status = "Incomplete";
        details.internshipStatus = "Incomplete";
        details.isCompleted = false;
        details.isApproved = true;
      } else {
        // Within 15-day grace period
        details.status = "approved";
        details.isCompleted = false;
        details.isApproved = true;
      }
    }



    // 9. Deadline Warning Logic

    let deadlineWarning = null;

    if (endDate && (endDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24) <= 7) {

      // Find pending items

      const pendingItems = [];

    }



    // Calculate Duration Days if missing or ensure precise inclusive count

    if (details.InternshipStartDate && details.InternshipEndDate) {

      const start = parseSafeDate(details.InternshipStartDate);

      const end = parseSafeDate(details.InternshipEndDate);

      if (start && end) {

        start.setHours(0, 0, 0, 0);

        end.setHours(0, 0, 0, 0);

        const diffTime = end - start;

        const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24)) + 1; // Inclusive count

        details.durationDays = diffDays > 0 ? diffDays : 0;

      } else {

        details.durationDays = 0;

      }

    }



    // 2. Tasks - Robustly ensure it's an array
    const isCandidatePending = String(details.status || '').toLowerCase() === 'pending';

    const tasksRaw = isCandidatePending ? [] : getStudentTasks(regId);

    const tasks = Array.isArray(tasksRaw) ? tasksRaw : (tasksRaw && tasksRaw.tasks ? tasksRaw.tasks : []);



    // 3. Projects - Robustly ensure it's an array

    const projectsRaw = isCandidatePending ? [] : getStudentProjects(regId);

    const projects = Array.isArray(projectsRaw) ? projectsRaw : (projectsRaw && projectsRaw.projects ? projectsRaw.projects : []);



    // 4. Attendance

    let attendance = [];

    let attStats = null;

    if (!isCandidatePending) {
      const attResp = getStudentAttendance(regId);
      if (attResp && attResp.status === 'success') {
        attendance = attResp.attendanceRecords || [];
        attStats = attResp.summary;
      }
    }



    // 5. Diary

    let diary = { status: 'error', diary: {} };
    if (!isCandidatePending) {
      const diaryResp = getStudentDashboardDiaryData(regId);
      if (diaryResp && diaryResp.status === 'success') {
        diary = diaryResp;
      }
    }



    // Deadline Warning Refinement

    if (endDate && today <= endDate) {

      const daysLeft = Math.ceil((endDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));

      if (daysLeft <= 7) {

        const pending = [];

        // Use lowercase 'status' to match getStudentTasks/Projects objects

        if (tasks.some(t => t.status !== 'Completed' && t.status !== 'Approved')) pending.push("Tasks");

        if (projects.some(p => p.status !== 'Completed' && p.status !== 'Approved')) pending.push("Projects");

        if (attStats && attStats.absentCounter > 0) pending.push("Attendance");



        if (pending.length > 0) {

          deadlineWarning = {

            daysRemaining: daysLeft,

            sections: pending,

            message: `Pending Work - Deadline Approaching`

          };

        }

      }

    }

    details.deadlineWarning = deadlineWarning;



    // 6. Certificate

    const certResp = getStudentCertificate(regId);

    let certificate = null;

    if (certResp && certResp.status === 'success') {

      let pdfId = null;

      if (certResp.certificateLink) {

        const match = certResp.certificateLink.match(/id=([^&]+)/);

        if (match) pdfId = match[1];

      }



      certificate = {

        CertificateNumber: certResp.certificateNumber,

        IssuedDate: certResp.issuedDate,

        CertificatePdfId: pdfId,

        Status: 'Issued',

        Link: certResp.certificateLink,

        HardCopyStatus: d["CertificateHardCopyStatus"] || (d["CertificateIssued"] === 'Issued' ? 'Issued' : 'Pending'),

        HardCopyDate: d["CertificateHardCopyDate"] ? formatDateISO(d["CertificateHardCopyDate"]) : ''

      };

    }



    // 7. Notifications

    const notifResp = getStudentNotifications(regId);

    const notifications = (notifResp && notifResp.status === 'success') ? notifResp.notifications : [];



    // 8. Attendance Requests

    const attReqResp = getStudentAttendanceRequests(regId);

    const attendanceRequests = (attReqResp && attReqResp.status === 'success') ? attReqResp.requests : [];



    // 9. Files

    const filesResp = getStudentFiles(regId);

    const files = (filesResp && filesResp.status === 'success') ? filesResp.files : [];



    // 10. Consolidated Summary for Student & Admin

    const diaryEntryCount = diary && diary.diary ? Object.keys(diary.diary).length : 0;

    let expectedDiaryDays = 0;

    const sD = parseSafeDate(details.InternshipStartDate);

    const eD = parseSafeDate(details.InternshipEndDate);

    if (sD && eD) {

      sD.setHours(0, 0, 0, 0);

      eD.setHours(0, 0, 0, 0);

      const tD = new Date(); tD.setHours(0, 0, 0, 0);

      const effectiveEnd = eD < tD ? eD : tD;

      let cur = new Date(sD);

      let safety = 0;

      while (cur <= effectiveEnd && safety < 10000) {

        if (cur.getDay() !== 0) expectedDiaryDays++; // Exclude Sundays

        cur.setDate(cur.getDate() + 1);

        safety++;

      }

    }



    const tasksCompleted = tasks.filter(t => t.status === 'Completed' || t.status === 'Approved').length;

    const projectsCompleted = projects.filter(p => p.status === 'Completed' || p.status === 'Approved').length;



    const consolidatedSummary = {

      attendance: {

        totalWorkingDays: attStats ? attStats.totalWorkingDays : 0,

        present: attStats ? attStats.presentCounter : 0,

        absent: attStats ? attStats.absentCounter : 0,

        late: attStats ? attStats.lateCounter : 0,

        wfh: attStats ? attStats.wfhCounter : 0,

        od: attStats ? attStats.odCounter : 0,

        medical: attStats ? attStats.medicalCounter : 0,

        percentage: attStats ? attStats.percentage : 0

      },

      diary: {

        totalEntries: diaryEntryCount,

        expectedEntries: expectedDiaryDays,

        missingEntries: Math.max(0, expectedDiaryDays - diaryEntryCount),

        percentage: expectedDiaryDays > 0 ? ((diaryEntryCount / expectedDiaryDays) * 100).toFixed(1) : 0

      },

      tasks: {

        total: tasks.length,

        completed: tasksCompleted,

        pending: tasks.length - tasksCompleted

      },

      projects: {

        total: projects.length,

        completed: projectsCompleted,

        pending: projects.length - projectsCompleted

      },

      internship: {

        startDate: details.InternshipStartDate,

        endDate: details.InternshipEndDate,

        durationDays: details.durationDays || 0,

        daysRemaining: (() => {

          const end = parseSafeDate(details.endDate || details.InternshipEndDate);

          if (!end) return 0;

          return Math.max(0, Math.ceil((end.getTime() - new Date().getTime()) / (1000 * 60 * 60 * 24)));

        })(),

        isActive: details.status === 'approved' || details.status === 'active' || details.status === 'assigned',

        overallHealthScore: 0 // Calculated below

      }

    };



    // Calculate overall health score (0-100)

    const attScore = parseFloat(consolidatedSummary.attendance.percentage) || 0;

    const diaryScore = parseFloat(consolidatedSummary.diary.percentage) || 0;

    const taskScore = consolidatedSummary.tasks.total > 0 ? (tasksCompleted / consolidatedSummary.tasks.total * 100) : 100;

    const projScore = consolidatedSummary.projects.total > 0 ? (projectsCompleted / consolidatedSummary.projects.total * 100) : 100;

    consolidatedSummary.internship.overallHealthScore = Math.round((attScore * 0.35 + diaryScore * 0.25 + taskScore * 0.2 + projScore * 0.2));



    let hcChecklistResp = null;

    try {

      hcChecklistResp = getStudentHardCopyChecklist(regId);

      if (hcChecklistResp && hcChecklistResp.status === 'success') {

        details.hardCopyChecklist = hcChecklistResp.checklist;

        details.hardCopyStatus = hcChecklistResp.overallStatus;

        details.hardCopySubmittedCount = hcChecklistResp.submittedCount;

      }

    } catch(hcErr) {}



    details.isCompleted = details.isCompleted || (details.status === 'internship completed' || details.status === 'completed');
    details.isApproved = details.isApproved || (details.status !== 'pending');

    const finalResponse = {

      status: 'success',

      details: details,
      isCompleted: details.isCompleted,
      isApproved: details.isApproved,

      hardCopyChecklist: hcChecklistResp,

      tasks: tasks,

      projects: projects,

      attendance: attendance,

      attStats: attStats,

      diary: diary,

      certificate: certificate,

      notifications: notifications,

      attendanceRequests: attendanceRequests,

      files: files,

      summary: (filesResp && filesResp.status === 'success') ? filesResp.summary : null,

      consolidatedSummary: consolidatedSummary,

      todaySlot: getSlotTiming(details.batch, getTodayStr()),

      issuedComponents: getStudentIssuedComponents(regId)

    };



    Logger.log(`COMPREHENSIVE_LOAD: Student: ${regId} | Tasks: ${tasks.length} | Projects: ${projects.length}`);

    return sanitizeForJson(finalResponse);



  } catch (e) {

    const errorDetails = "Error: " + e.toString() + " | Stack: " + (e.stack || "No stack") + " | Line: " + (e.lineNumber || "No line");

    Logger.log("Error in getStudentComprehensiveProfile: " + errorDetails);

    return { status: 'error', message: errorDetails };

  }

}



function getRecentDiaryEntries_(regId, limit) {

  try {

    const sheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    if (!sheet) return [];



    const data = getSheetDataAsObjects(sheet);

    // Flexible RegID check

    const entries = data.filter(r => {

      const rId = r.RegID || r.RegistrationID || r.StudentRegistrationID;

      return String(rId).trim().toLowerCase() === String(regId).trim().toLowerCase();

    });



    // Sort DESC

    entries.sort((a, b) => new Date(b.Date) - new Date(a.Date));

    return entries.slice(0, limit);

  } catch (e) {

    Logger.log("Error in getRecentDiaryEntries_: " + e.toString());

    return [];

  }

}



// =================================================================================

// END OF CONSOLIDATED BACKEND FUNCTIONS

