/**

 * Formats a Google Drive URL or File ID into a direct public link.

 */

function formatDriveImageDirectUrl(url) {

  if (!url || typeof url !== 'string') return '';

  url = url.trim();

  if (url.startsWith('data:image')) return url;

  if (url.includes('lh3.googleusercontent.com/d/')) return url;

  

  let fileId = '';

  const m1 = url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);

  const m2 = url.match(/[?&]id=([a-zA-Z0-9_-]+)/);

  const m3 = url.match(/\/d\/([a-zA-Z0-9_-]+)/);

  if (m1) fileId = m1[1];

  else if (m2) fileId = m2[1];

  else if (m3) fileId = m3[1];

  else if (/^[a-zA-Z0-9_-]{25,}$/.test(url)) fileId = url;

  

  if (fileId) {

    return 'https://lh3.googleusercontent.com/d/' + fileId;

  }

  return url;

}



function formatDriveImageDirectUrl_(url) {

  return formatDriveImageDirectUrl(url);

}



/**

 * Robustly fetches a student profile photo Blob from Base64 Data URI, Google Drive, or Direct URL.

 */

function getStudentPhotoBlob_(rawPhoto, options) {

  if (!rawPhoto) return null;

  const str = String(rawPhoto).trim();

  if (!str) return null;



  // 1. Base64 Data URL (e.g. from canvas crop upload)

  if (str.startsWith('data:image/') || str.startsWith('data:;base64,')) {

    try {

      const parts = str.split(',');

      if (parts.length >= 2) {

        const meta = parts[0];

        const base64Data = parts[1];

        const mimeMatch = meta.match(/data:([^;]+)/);

        const mime = mimeMatch ? mimeMatch[1] : 'image/jpeg';

        const decodedBytes = Utilities.base64Decode(base64Data);

        return Utilities.newBlob(decodedBytes, mime, 'student_photo.jpg');

      }

    } catch(b64Err) {

      Logger.log("getStudentPhotoBlob_ base64 error: " + b64Err.toString());

    }

  }



  let resultBlob = null;

  // 2. Try extracting Google Drive file ID

  const driveIdMatch = str.match(/[-\w]{25,}/);

  if (driveIdMatch) {

    try {

      const file = DriveApp.getFileById(driveIdMatch[0]);

      if (file && !file.isTrashed()) {

        const blob = file.getBlob();

        if (blob && (blob.getContentType().startsWith('image/') || blob.getBytes().length > 0)) {

          resultBlob = blob;

        }

      }

    } catch (e) {

      Logger.log("getStudentPhotoBlob_ DriveApp.getFileById error: " + e.toString());

    }

  }



  // 3. Direct HTTP / Thumbnail fetch

  if (!resultBlob) {

    try {

      let url = str;

      if (driveIdMatch) {

        url = 'https://drive.google.com/uc?export=download&id=' + driveIdMatch[0];

      }

      if (url.startsWith('http://') || url.startsWith('https://')) {

        const resp = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true });

        if (resp.getResponseCode() === 200) {

          const b = resp.getBlob();

          if (b && b.getBytes().length > 0) {

            resultBlob = b;

          }

        }

      }

    } catch (e) {

      Logger.log("getStudentPhotoBlob_ UrlFetchApp error: " + e.toString());

    }

  }



  if (resultBlob) {

    if (options && options.rawBlob === true) {

      return resultBlob;

    }

    try {

      if (typeof formatStudentPhotoWithBorder_ === 'function') {

        return formatStudentPhotoWithBorder_(resultBlob);

      }

    } catch (e) {

      Logger.log("getStudentPhotoBlob_ formatStudentPhotoWithBorder_ error: " + e.toString());

    }

    return resultBlob;

  }



  return null;

}

/**
 * Standardizes photo blob with verified content type and format.
 */
// Real photo processing handled by PhotoProcessor.js



/**

 * Formats Application Form (Form-1) Photo Box (3.0 cm width x 4.5 cm height -> 85pt x 128pt):

 * - If includePhoto is true and photoBlob is available: clears the placeholder text and inserts centered student photo.

 * - If includePhoto is false or photoBlob is null: preserves the standard clean "PHOTO \n 3.0 × 4.5 cm" bordered box.

 */

function formatApplicationFormPhotoBox_(body, photoBlob, includePhoto) {

  if (!body) return;

  try {

    const tables = body.getTables();

    let photoCell = null;



    for (let t = 0; t < tables.length; t++) {

      const table = tables[t];

      if (table.getNumRows() > 0) {

        for (let r = 0; r < table.getNumRows(); r++) {

          const row = table.getRow(r);

          for (let c = 0; c < row.getNumCells(); c++) {

            const cell = row.getCell(c);

            const txt = cell.getText().trim();

            if (/PHOTO/i.test(txt) && (/3\s*x\s*3/i.test(txt) || /3\s*x\s*4\.5/i.test(txt) || /3\.0\s*x\s*4\.5/i.test(txt) || /cm/i.test(txt) || txt === 'PHOTO')) {

              photoCell = cell;

              break;

            }

          }

          if (photoCell) break;

        }

      }

      if (photoCell) break;

    }



    if (!photoCell) {

      const found = body.findText('3\\s*x\\s*3\\s*cm') || body.findText('3\\.?0?\\s*x\\s*4\\.?5?\\s*cm') || body.findText('\\bPHOTO\\b');

      if (found) {

        let p = found.getElement();

        while (p && p.getParent()) {

          if (p.getType() === DocumentApp.ElementType.TABLE_CELL) {

            photoCell = p.asTableCell();

            break;

          }

          p = p.getParent();

        }

      }

    }



    if (photoCell) {

      // Hide outer Table 0 border so it does not box the extended transparent seal canvas

      try {

        const pTable = photoCell.getParent().getParent().asTable();

        pTable.setBorderWidth(0);

        pTable.setBorderColor('#ffffff');

      } catch(tblErr) {

        Logger.log("Hide photo table border error: " + tblErr);

      }



      // Constrain photoCell width strictly so that right edge in PDF <= 518.0pt (within 519.8pt table border)

      photoCell.clear();

      photoCell.setVerticalAlignment(DocumentApp.VerticalAlignment.TOP);

      photoCell.setPaddingTop(0);

      photoCell.setPaddingBottom(0);

      photoCell.setPaddingLeft(0);

      photoCell.setPaddingRight(0);

      photoCell.setWidth(84);

      if (!photoBlob && includePhoto) {
        try {
          const defaultB64 = (typeof FACULTY_SAMPLE_PHOTO_B64 !== 'undefined' && FACULTY_SAMPLE_PHOTO_B64) ? FACULTY_SAMPLE_PHOTO_B64 : STUDENT_SAMPLE_PHOTO_B64;
          photoBlob = Utilities.newBlob(Utilities.base64Decode(defaultB64), 'image/jpeg', 'sample_photo.jpg');
        } catch(e) {}
      }

      if (includePhoto && photoBlob) {

        let sealedPhoto = photoBlob;

        try {

          if (typeof formatStudentPhotoForAppFormWithSeal_ === 'function') {

            sealedPhoto = formatStudentPhotoForAppFormWithSeal_(photoBlob) || photoBlob;

          }

        } catch(spErr) {

          Logger.log("formatStudentPhotoForAppFormWithSeal_ error: " + spErr);

        }



        // Remove placeholder Table 0

        try {

          const pTable = photoCell.getParent().getParent().asTable();

          pTable.removeFromParent();

        } catch(tblErr) {

          Logger.log("Remove photo table error: " + tblErr);

        }



        // Insert Photo & Seal using PositionedImage:

        // Top Layer Seal (+1X extra size) stamped on top of Photo (increased size)

        // Geometry: width 168pt (PDF 126.0pt), height 186pt (PDF 139.5pt)

        // X offset: 310 (PDF 388.0 to 514.0 pt -> strictly <= 519.8 pt right margin line with 5.8pt buffer!)

        // Y offset: 22 (PDF 183.7 to 323.2 pt -> lowered position, 24.8pt safe gap before Student Application Details heading!)

        try {

          const p0 = body.getParagraphs()[0];

          const posImg = p0.addPositionedImage(sealedPhoto);

          posImg.setWidth(168);

          posImg.setHeight(186);

          posImg.setLeftOffset(310);

          posImg.setTopOffset(22);

          posImg.setLayout(DocumentApp.PositionedLayout.WRAP_TEXT);

// posSeal removed per user request: photo already contains official corner seal
        } catch(posErr) {

          Logger.log("addPositionedImage 2X error: " + posErr);

        }

      } else {

        const p1 = photoCell.appendParagraph('PHOTO');

        p1.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

        p1.setBold(true);

        p1.setFontSize(10);

        p1.setFontFamily('Arial');

        p1.setSpacingBefore(6);

        p1.setSpacingAfter(2);

        p1.setLineSpacing(1.0);



        const p2 = photoCell.appendParagraph('3.0 × 4.5 cm');

        p2.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

        p2.setBold(false);

        p2.setFontSize(8.5);

        p2.setFontFamily('Arial');

        p2.setForegroundColor('#475569');

        p2.setSpacingBefore(0);

        p2.setSpacingAfter(6);

        p2.setLineSpacing(1.0);

      }

    }

  } catch (err) {

    Logger.log("formatApplicationFormPhotoBox_ error: " + err);

  }

}



/**

 * Formats Certificate Template 1

 */

function formatCertificateTemplate1_(body, studentData, options, certNumber, issuedDateFormatted, sigBlob, sealBlob, qrBlob) {

  if (!body) return;

  try {

    options = options || {};



    // 1. Clean photo placeholders (Template 1 has no photo)

    const photoTags = ['PHOTO', 'Photo', 'photo', 'StudentPhoto', 'studentphoto', 'PROFILE_PHOTO', 'ProfilePhoto', 'profile_photo', 'STUDENT_PHOTO', 'student_photo', 'PASSPORT_PHOTO', 'PassportPhoto'];

    photoTags.forEach(tag => {

      const escaped = tag.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');

      try {

        body.replaceText('\\{\\{\\s*' + escaped + '\\s*\\}\\}', '');

        body.replaceText('\\{\\s*' + escaped + '\\s*\\}', '');

      } catch(e) {}

    });



    // 2. Format CN and DATE Line into 2-Column Borderless Table

    // Left: CN:{{CertificateNumber}} (Arial Black, 13pt, Bold, #000000)

    // Right: DATE : {{IssuedDate}} (Arial Black, 13pt, Bold, #000000, Flush Right)

    const allParas = body.getParagraphs();

    let cnPara = null;

    for (let i = 0; i < allParas.length; i++) {

      const p = allParas[i];

      const pText = p.getText() || '';

      if (/CN\s*:/i.test(pText) && /DATE/i.test(pText)) {

        cnPara = p;

        break;

      }

    }



    if (cnPara) {

      try {

        const cnText = cnPara.getText() || '';

        let cnPart = (certNumber && String(certNumber).trim() !== '') ? ('CN:' + String(certNumber).trim()) : 'CN:{{CertificateNumber}}';

        let datePart = (issuedDateFormatted && String(issuedDateFormatted).trim() !== '') ? ('DATE : ' + String(issuedDateFormatted).trim()) : 'DATE : {{IssuedDate}}';



        if (!certNumber || !issuedDateFormatted) {

          const dateMatch = cnText.match(/DATE\s*:\s*(\S+.*)/i);

          const cnMatch = cnText.match(/(CN\s*:\s*[^\t\n\r]+?)(?:\s{2,}|\t+|DATE)/i);

          if (cnMatch && cnMatch[1]) cnPart = cnMatch[1].trim();

          if (dateMatch) datePart = dateMatch[0].trim();

        }

        cnPart = String(cnPart).replace(/\bVV\//gi, 'GSV/');



        const cnIdx = body.getChildIndex(cnPara);

        const cnTable = body.insertTable(cnIdx);

        cnTable.setBorderWidth(0);

        try { cnTable.setBorderColor('#ffffff'); } catch(e) {}



        const row = (cnTable.getNumRows() > 0) ? cnTable.getRow(0) : cnTable.appendTableRow();

        const cellCn = (row.getNumCells() > 0) ? row.getCell(0) : row.appendTableCell();

        const cellDate = (row.getNumCells() > 1) ? row.getCell(1) : row.appendTableCell();



        cellCn.setWidth(248);

        cellDate.setWidth(248);



        [cellCn, cellDate].forEach(c => {

          try {

            c.setPaddingTop(0);

            c.setPaddingBottom(2);

            c.setPaddingLeft(0);

            c.setPaddingRight(0);

          } catch(e) {}

        });



        const pCn = (cellCn.getNumChildren() > 0) ? cellCn.getChild(0).asParagraph() : cellCn.appendParagraph(' ');

        pCn.setText(cnPart);

        pCn.setAlignment(DocumentApp.HorizontalAlignment.LEFT);

        pCn.setSpacingBefore(4);

        pCn.setSpacingAfter(4);

        pCn.setLineSpacing(1.0);

        try {

          const lenCn = pCn.getText().length;

          if (lenCn > 0) {

            const tCn = pCn.editAsText();

            tCn.setFontFamily(0, lenCn - 1, 'Arial Black');

            tCn.setFontSize(0, lenCn - 1, 13.5);

            tCn.setBold(0, lenCn - 1, true);

            tCn.setForegroundColor(0, lenCn - 1, '#000000');

          }

        } catch(e) {}



        const pDate = (cellDate.getNumChildren() > 0) ? cellDate.getChild(0).asParagraph() : cellDate.appendParagraph(' ');

        pDate.setText(datePart);

        pDate.setAlignment(DocumentApp.HorizontalAlignment.RIGHT);

        pDate.setSpacingBefore(4);

        pDate.setSpacingAfter(4);

        pDate.setLineSpacing(1.0);

        try {

          const lenDate = pDate.getText().length;

          if (lenDate > 0) {

            const tDate = pDate.editAsText();

            tDate.setFontFamily(0, lenDate - 1, 'Arial Black');

            tDate.setFontSize(0, lenDate - 1, 13.5);

            tDate.setBold(0, lenDate - 1, true);

            tDate.setForegroundColor(0, lenDate - 1, '#000000');

          }

        } catch(e) {}



        cnPara.removeFromParent();

      } catch(cnErr) {

        Logger.log('formatCertificateTemplate1_ CN error: ' + cnErr);

      }

    }



    // 3. Keep Original Title Intact (Impact font preserved as in source template)



    // 4. Uniform Body Paragraph Indentation:

    // Strip random tabs and ensure Para 1 ("This is to certify"), Para 2 ("During the Tenure"), Para 3 ("Her performance") all start evenly from the exact same point!

    const parasAfter = body.getParagraphs();

    let bodyPara = null;

    let duringPara = null;

    let perfPara = null;

    for (let i = 0; i < parasAfter.length; i++) {

      const txt = parasAfter[i].getText() || '';

      if (!bodyPara && /This is to certify/i.test(txt)) {

        bodyPara = parasAfter[i];

      } else if (!duringPara && /During/i.test(txt) && !/performance|conduct/i.test(txt)) {

        duringPara = parasAfter[i];

      } else if (!perfPara && /conduct|performance/i.test(txt)) {

        perfPara = parasAfter[i];

      }

    }



    formatCertificateBodyExact_(body, studentData, options);



    // Footer is cleanly handled by formatCertificateT2Footer_ for all certificate documents.



  } catch (err) {

    Logger.log('formatCertificateTemplate1_ error: ' + err);

  }

}



var __lastT2PhotoDebug = {};



function formatCertificateTemplate2Photo_(body, photoBlob, includePhoto, certNumber, issuedDateFormatted, studentData, options) {

  if (!body) return;

  __lastT2PhotoDebug = {

    includePhoto: !!includePhoto,

    photoBlobNull: !photoBlob,

    photoBlobType: photoBlob ? photoBlob.getContentType() : 'none',

    photoBlobSize: photoBlob ? photoBlob.getBytes().length : 0

  };

  try {

    options = options || {};

    const photoTags = ['PHOTO', 'Photo', 'photo', 'StudentPhoto', 'studentphoto', 'PROFILE_PHOTO', 'ProfilePhoto', 'profile_photo', 'STUDENT_PHOTO', 'student_photo', 'PASSPORT_PHOTO', 'PassportPhoto'];

    

    // 1. Always strip any photo placeholder text tags from the document body to prevent line breaks

    photoTags.forEach(tag => {

      const escaped = tag.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');

      try {

        body.replaceText('\\{\\{\\s*' + escaped + '\\s*\\}\\}', '');

        body.replaceText('\\{\\s*' + escaped + '\\s*\\}', '');

      } catch(e) {}

    });



    // Clean up any double periods from template replacements (e.g. "training. .")

    try {

      body.replaceText('\\.\\s*\\.', '.');

    } catch(e) {}



    // 2. Normalize CN and DATE line into a 2-column borderless table

    // Left: CN : {{CertificateNumber}} (flush left corner, Bold, Deep Black #000000, 13pt)

    // Right: DATE : {{IssuedDate}} (flush right corner, Bold, Deep Black #000000, 13pt)

    const allParas = body.getParagraphs();

    let cnPara = null;

    for (let i = 0; i < allParas.length; i++) {

      const p = allParas[i];

      const pText = p.getText() || '';

      if (/CN\s*:/i.test(pText) && /DATE/i.test(pText)) {

        cnPara = p;

        break;

      }

    }



    if (cnPara) {

      try {

        const cnText = cnPara.getText() || '';

        let cnPart = (certNumber && String(certNumber).trim() !== '') ? ('CN : ' + String(certNumber).trim()) : 'CN : {{CertificateNumber}}';

        let datePart = (issuedDateFormatted && String(issuedDateFormatted).trim() !== '') ? ('DATE : ' + String(issuedDateFormatted).trim()) : 'DATE : {{IssuedDate}}';



        if (!certNumber || !issuedDateFormatted) {

          const dateMatch = cnText.match(/DATE\s*:\s*(\S+.*)/i);

          const cnMatch = cnText.match(/(CN\s*:\s*[^\t\n\r]+?)(?:\s{2,}|\t+|DATE)/i);

          if (cnMatch && cnMatch[1]) cnPart = cnMatch[1].trim();

          if (dateMatch) datePart = dateMatch[0].trim();

        }

        cnPart = String(cnPart).replace(/\bVV\//gi, 'GSV/');



        const cnIdx = body.getChildIndex(cnPara);

        const cnTable = body.insertTable(cnIdx);

        cnTable.setBorderWidth(0);

        try { cnTable.setBorderColor('#ffffff'); } catch(e) {}



        const cnRow = (cnTable.getNumRows() > 0) ? cnTable.getRow(0) : cnTable.appendTableRow();

        const cellCn = (cnRow.getNumCells() > 0) ? cnRow.getCell(0) : cnRow.appendTableCell();

        const cellDate = (cnRow.getNumCells() > 1) ? cnRow.getCell(1) : cnRow.appendTableCell();



        cellCn.setWidth(248);

        cellDate.setWidth(248);



        cellCn.setPaddingTop(0);

        cellCn.setPaddingBottom(0);

        cellCn.setPaddingLeft(0);

        cellCn.setPaddingRight(0);



        cellDate.setPaddingTop(0);

        cellDate.setPaddingBottom(0);

        cellDate.setPaddingLeft(0);

        cellDate.setPaddingRight(0);



        const pCn = (cellCn.getNumChildren() > 0) ? cellCn.getChild(0).asParagraph() : cellCn.appendParagraph(' ');

        pCn.setText(cnPart);

        pCn.setAlignment(DocumentApp.HorizontalAlignment.LEFT);

        pCn.setSpacingBefore(4);

        pCn.setSpacingAfter(4);

        pCn.setLineSpacing(1.0);

        try {

          const tCn = pCn.editAsText();

          const lenCn = pCn.getText().length;

          if (lenCn > 0) {

            tCn.setFontFamily(0, lenCn - 1, 'Arial Black');

            tCn.setFontSize(0, lenCn - 1, 13.5);

            tCn.setBold(0, lenCn - 1, true);

            tCn.setForegroundColor(0, lenCn - 1, '#000000');

          }

        } catch(e) {}



        const pDate = (cellDate.getNumChildren() > 0) ? cellDate.getChild(0).asParagraph() : cellDate.appendParagraph(' ');

        pDate.setText(datePart);

        pDate.setAlignment(DocumentApp.HorizontalAlignment.RIGHT);

        pDate.setSpacingBefore(4);

        pDate.setSpacingAfter(4);

        pDate.setLineSpacing(1.0);

        try {

          const tDate = pDate.editAsText();

          const lenDate = pDate.getText().length;

          if (lenDate > 0) {

            tDate.setFontFamily(0, lenDate - 1, 'Arial Black');

            tDate.setFontSize(0, lenDate - 1, 13.5);

            tDate.setBold(0, lenDate - 1, true);

            tDate.setForegroundColor(0, lenDate - 1, '#000000');

          }

        } catch(e) {}



        cnPara.removeFromParent();

      } catch(cnErr) {

        Logger.log('Error formatting CN and DATE line: ' + cnErr);

      }

    }



    // 3. Locate Certificate Title paragraph ("Internship Training Certificate")

    let targetPara = null;

    let targetParaIdx = -1;

    for (let i = 0; i < allParas.length; i++) {

      const txt = allParas[i].getText() || '';

      if (/INTERNSHIP\s*TRAINING\s*CERTIFICATE|INTERNSHIP\s*CERTIFICATE|CERTIFICATE\s*OF\s*COMPLETION|COMPLETION\s*CERTIFICATE/i.test(txt)) {

        targetPara = allParas[i];

        targetParaIdx = i;

        break;

      }

    }

    if (!targetPara) {

      for (let i = 0; i < allParas.length; i++) {

        const txt = allParas[i].getText() || '';

        if (/CERTIFICATE/i.test(txt)) {

          targetPara = allParas[i];

          targetParaIdx = i;

          break;

        }

      }

    }



    // Keep Title paragraph centered, completely clean and free of positioned images

    if (targetPara) {

      try {

        const titlePosImgs = targetPara.getPositionedImages();

        for (let pi = 0; pi < titlePosImgs.length; pi++) {

          try { titlePosImgs[pi].removeFromParent(); } catch(e) {}

        }

      } catch(e) {}

      targetPara.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

      targetPara.setSpacingBefore(10);

      targetPara.setSpacingAfter(8);

      targetPara.setLineSpacing(1.0);

      try {

        const tTitle = targetPara.editAsText();

        tTitle.setFontFamily('UnifrakturMaguntia');

        tTitle.setFontSize(22);

        tTitle.setBold(true);

        tTitle.setUnderline(true);

        tTitle.setForegroundColor('#000000');

      } catch(e) {}

    }



    // 4. Locate Certification Body Paragraphs

    let bodyPara = null;

    let duringPara = null;

    let perfPara = null;

    for (let i = 0; i < allParas.length; i++) {

      const txt = allParas[i].getText() || '';

      if (!bodyPara && /This is to certify/i.test(txt)) {

        bodyPara = allParas[i];

      } else if (!duringPara && /During/i.test(txt) && !/performance|conduct/i.test(txt)) {

        duringPara = allParas[i];

      } else if (!perfPara && /conduct|performance/i.test(txt)) {

        perfPara = allParas[i];

      }

    }

    if (!bodyPara && targetParaIdx >= 0) {

      for (let i = targetParaIdx + 1; i < allParas.length; i++) {

        const txt = (allParas[i].getText() || '').trim();

        if (txt.length > 0) {

          bodyPara = allParas[i];

          break;

        }

      }

    }



    // Remove any stray empty paragraphs between title and certification body

    if (targetPara && bodyPara) {

      try {

        const tIdx = body.getChildIndex(targetPara);

        let bIdx = body.getChildIndex(bodyPara);

        while (bIdx > tIdx + 1) {

          body.getChild(tIdx + 1).removeFromParent();

          bIdx = body.getChildIndex(bodyPara);

        }

      } catch(e) {}

    }



    // 5. Layout with Dedicated Photo Space & Centered Certificate Title
    if (!photoBlob && includePhoto) {
      try {
        const candCat = (typeof getCandidateCategory_ === 'function') ? getCandidateCategory_(studentData) : '';
        const defaultB64 = (candCat === 'Faculty' || candCat === 'Employee') ? FACULTY_SAMPLE_PHOTO_B64 : STUDENT_SAMPLE_PHOTO_B64;
        if (defaultB64) {
          photoBlob = Utilities.newBlob(Utilities.base64Decode(defaultB64), 'image/jpeg', 'sample_photo.jpg');
        }
      } catch(e) {}
    }

    if (includePhoto && photoBlob && targetPara) {

      try {

        // Clear any residual positioned images from targetPara and bodyPara

        try {

          const titlePosImgs = targetPara.getPositionedImages();

          for (let pi = 0; pi < titlePosImgs.length; pi++) {

            try { titlePosImgs[pi].removeFromParent(); } catch(e) {}

          }

        } catch(e) {}

        if (bodyPara) {

          try {

            const bodyPosImgs = bodyPara.getPositionedImages();

            for (let bi = 0; bi < bodyPosImgs.length; bi++) {

              try { bodyPosImgs[bi].removeFromParent(); } catch(e) {}

            }

          } catch(e) {}

        }



        // Format photo with auto-crop top black bar and clean #222222 border

        let borderedPhoto = (typeof formatStudentPhotoWithBorder_ === 'function')

          ? formatStudentPhotoWithBorder_(photoBlob)

          : photoBlob;



        try {

          const ct = borderedPhoto.getContentType();

          if (!ct || !ct.startsWith('image/')) {

            borderedPhoto = Utilities.newBlob(borderedPhoto.getBytes(), 'image/png', 'student_photo.png');

          }

        } catch(e) {}



        // Get index of targetPara (the Certificate Title)

        const titleIdx = body.getChildIndex(targetPara);



        // Insert 3-column borderless table at titleIdx:

        // Column 0 (Left, 75pt): Dedicated student photo space (photo ~71pt x 85pt)

        // Column 1 (Center, 346pt): Dedicated Certificate Title space (centered)

        // Column 2 (Right, 75pt): Balancing spacer so title is mathematically centered on the page

        const titleTable = body.insertTable(titleIdx);

        titleTable.setBorderWidth(0);

        try { titleTable.setBorderColor('#ffffff'); } catch(e) {}



        const row = (titleTable.getNumRows() > 0) ? titleTable.getRow(0) : titleTable.appendTableRow();

        const photoCell = (row.getNumCells() > 0) ? row.getCell(0) : row.appendTableCell();

        const titleCell = (row.getNumCells() > 1) ? row.getCell(1) : row.appendTableCell();

        const spacerCell = (row.getNumCells() > 2) ? row.getCell(2) : row.appendTableCell();



        photoCell.setWidth(75);

        titleCell.setWidth(346);

        spacerCell.setWidth(75);



        try { photoCell.setVerticalAlignment(DocumentApp.VerticalAlignment.TOP); } catch(e) {}

        try { titleCell.setVerticalAlignment(DocumentApp.VerticalAlignment.MIDDLE); } catch(e) {}

        try { spacerCell.setVerticalAlignment(DocumentApp.VerticalAlignment.TOP); } catch(e) {}



        try {

          photoCell.setPaddingTop(0);

          photoCell.setPaddingBottom(0);

          photoCell.setPaddingLeft(0);

          photoCell.setPaddingRight(0);



          titleCell.setPaddingTop(0);

          titleCell.setPaddingBottom(0);

          titleCell.setPaddingLeft(0);

          titleCell.setPaddingRight(0);



          spacerCell.setPaddingTop(0);

          spacerCell.setPaddingBottom(0);

          spacerCell.setPaddingLeft(0);

          spacerCell.setPaddingRight(0);

        } catch(e) {}



        // --- LEFT CELL: Framed Student Photo ---
        photoCell.clear();
        photoCell.setVerticalAlignment(DocumentApp.VerticalAlignment.TOP);
        photoCell.setPaddingTop(0);
        photoCell.setPaddingBottom(0);
        photoCell.setPaddingLeft(0);
        photoCell.setPaddingRight(0);

        // Direct photo placement without nested table to eliminate dark outer frame
        const pPhoto = (photoCell.getNumChildren() > 0) ? photoCell.getChild(0).asParagraph() : photoCell.appendParagraph('');
        pPhoto.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
        pPhoto.setSpacingBefore(0);
        pPhoto.setSpacingAfter(0);
        pPhoto.setLineSpacing(1.0);
        pPhoto.setFontSize(1);

        const img = pPhoto.appendInlineImage(borderedPhoto);

        // Slightly enlarged student photo size as requested by user (prominent, high clarity)

        let pw = 68;

        let ph = 86;

        try {

          const origW = img.getWidth();

          const origH = img.getHeight();

          if (origW > 0 && origH > 0) {

            const ratio = origW / origH;

            ph = 86;

            pw = Math.round(ph * ratio);

            if (pw > 68) {

              pw = 68;

              ph = Math.round(pw / ratio);

            }

          }

        } catch(e) {}

        img.setWidth(pw);

        img.setHeight(ph);



        // --- CENTER CELL: Certificate Title ---

        const pTitle = (titleCell.getNumChildren() > 0) ? titleCell.getChild(0).asParagraph() : titleCell.appendParagraph('Internship Training Certificate');

        pTitle.setText('Internship Training Certificate');

        pTitle.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

        pTitle.setSpacingBefore(0);

        pTitle.setSpacingAfter(0);

        pTitle.setLineSpacing(1.0);

        try {

          const tTitle = pTitle.editAsText();

          tTitle.setFontFamily('UnifrakturMaguntia');

          tTitle.setFontSize(22);

          tTitle.setBold(true);

          tTitle.setUnderline(true);

          tTitle.setForegroundColor('#000000');

        } catch(e) {}



        // --- RIGHT CELL: Empty Balancing Spacer ---

        const pSpacer = (spacerCell.getNumChildren() > 0) ? spacerCell.getChild(0).asParagraph() : spacerCell.appendParagraph(' ');

        pSpacer.setText(' ');

        pSpacer.setFontSize(1);

        pSpacer.setSpacingBefore(0);

        pSpacer.setSpacingAfter(0);

        pSpacer.setLineSpacing(1.0);



        // Remove original targetPara now that title is inside titleCell

        targetPara.removeFromParent();



      } catch(tableErr) {

        __lastT2PhotoDebug.tableErr = tableErr.toString();

        Logger.log('formatCertificateTemplate2Photo_ titleTable error: ' + tableErr);

      }

    }



    // 6. Certification Body Paragraphs: Exact 12.5pt Times New Roman, bold entities, justified (professional format)

    formatCertificateBodyExact_(body, studentData, options);

  } catch (err) {

    __lastT2PhotoDebug.formatErr = err.toString();

    Logger.log('formatCertificateTemplate2Photo_ error: ' + err);

  }

}









function getExistingDocFileId(registrationId, docType) {

  const rec = getExistingGeneratedDocRecord_(registrationId, docType);

  if (rec && rec.fileId) {

    return { fileId: rec.fileId, url: rec.url || rec.driveLink };

  }

  return null;

}







/**

 * Recursively removes all dark/colored background highlights from tables, cells, paragraphs, and text runs.

 * This guarantees zero black-box artifacts in Certificate Template 2 and Application Form templates.

 */

function cleanDocFormattingRecursively_(element) {

  if (!element) return;

  try {

    const type = element.getType();

    if (type === DocumentApp.ElementType.TABLE) {

      const table = element.asTable();

      for (let r = 0; r < table.getNumRows(); r++) {

        const row = table.getRow(r);

        for (let c = 0; c < row.getNumCells(); c++) {

          const cell = row.getCell(c);

          try { cell.setBackgroundColor(null); } catch (e) {}

          cleanDocFormattingRecursively_(cell);

        }

      }

    } else if (type === DocumentApp.ElementType.TABLE_CELL) {

      const cell = element.asTableCell();

      try { cell.setBackgroundColor(null); } catch (e) {}

      for (let i = 0; i < cell.getNumChildren(); i++) {

        cleanDocFormattingRecursively_(cell.getChild(i));

      }

    } else if (type === DocumentApp.ElementType.PARAGRAPH) {

      const p = element.asParagraph();

      try { p.editAsText().setBackgroundColor(null); } catch(e){}

      for (let i = 0; i < p.getNumChildren(); i++) {

        cleanDocFormattingRecursively_(p.getChild(i));

      }

    } else if (type === DocumentApp.ElementType.TEXT) {

      const t = element.asText();

      try { t.setBackgroundColor(null); } catch (e) {}

    } else if (type === DocumentApp.ElementType.BODY_SECTION || type === DocumentApp.ElementType.HEADER_SECTION || type === DocumentApp.ElementType.FOOTER_SECTION) {

      const sec = element;

      for (let i = 0; i < sec.getNumChildren(); i++) {

        cleanDocFormattingRecursively_(sec.getChild(i));

      }

    }

  } catch (err) {

    Logger.log("cleanDocFormattingRecursively_ error: " + err);

  }

}



