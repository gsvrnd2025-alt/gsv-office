function getAllStudents_Legacy() {

  try {

    cleanOptOutStudents();

    updateExpiredApprovedStudentsStatus();

    const sheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    const mainData = getSheetDataAsObjects(sheet) || [];

    

    let closedData = [];

    const closedSheet = getSheet('Closed and Opt-out');

    if (closedSheet) {

      closedData = getSheetDataAsObjects(closedSheet) || [];

    }

    

    const data = [...mainData, ...closedData];

    if (data.length === 0) return [];



    // Check if students have uploaded documents by checking the FILE_MANAGER and GENERATED_DOCUMENTS

    const fileSheet = getSheet(SHEET_NAMES.FILE_MANAGER);

    const fileData = getSheetDataAsObjects(fileSheet) || [];

    const studentsWithFiles = new Set();

    const projectDocCounts = {};



    fileData.forEach(f => {

      const rid = String(f.StudentRegistrationID || f.RegistrationID || "").trim().toUpperCase();

      if (!rid) return;

      studentsWithFiles.add(rid);

      projectDocCounts[rid] = (projectDocCounts[rid] || 0) + 1;

    });



    const genDocSheet = getSheet(SHEET_NAMES.GENERATED_DOCUMENTS);

    const genDocData = getSheetDataAsObjects(genDocSheet) || [];

    const seenPdfIds = {};

    genDocData.forEach(d => {

      const rid = String(d.StudentRegistrationID || "").trim().toUpperCase();

      if (!rid) return;

      studentsWithFiles.add(rid);

      const pdfId = d.PdfFileId || d.pdfFileId;

      if (pdfId) {

        const key = rid + "_" + pdfId;

        if (!seenPdfIds[key]) {

          seenPdfIds[key] = true;

          projectDocCounts[rid] = (projectDocCounts[rid] || 0) + 1;

        }

      }

    });



    // Bulk check for task completion

    const taskSheet = getSheet(SHEET_NAMES.TASKS);

    const allTasks = getSheetDataAsObjects(taskSheet) || [];

    const taskStatusMap = {};

    allTasks.forEach(t => {

      const rid = String(t.StudentRegistrationID || "").trim().toUpperCase();

      if (!rid) return;

      if (!taskStatusMap[rid]) taskStatusMap[rid] = { total: 0, completed: 0 };

      taskStatusMap[rid].total++;

      const s = String(t.Status || "").toLowerCase();

      if (s === 'completed' || s === 'approved' || s === 'done') taskStatusMap[rid].completed++;

    });



    // Bulk check for project completion

    const projectSheet = getSheet(SHEET_NAMES.PROJECTS);

    const allProjects = getSheetDataAsObjects(projectSheet) || [];

    const projectStatusMap = {};

    allProjects.forEach(p => {

      const rid = String(p.StudentRegistrationID || "").trim().toUpperCase();

      if (!rid) return;

      const s = String(p.Status || "").toLowerCase();

      if (s !== 'completed' && s !== 'approved' && s !== 'active') {

        projectStatusMap[rid] = true; // Has pending/incomplete projects

      }

    });



    // Bulk check for attendance records

    const attendanceSheet = getSheet(SHEET_NAMES.ATTENDANCE);

    const allAttendance = getSheetDataAsObjects(attendanceSheet) || [];

    const attendanceByStudent = {};

    const attendanceCountMap = {};

    allAttendance.forEach(a => {

      const rid = String(a.StudentRegistrationID || "").trim().toUpperCase();

      if (!rid) return;

      if (!attendanceByStudent[rid]) attendanceByStudent[rid] = [];

      attendanceByStudent[rid].push(a);

      attendanceCountMap[rid] = (attendanceCountMap[rid] || 0) + 1;

    });



    // Bulk check for approved OTP requests (OD, WFH, Leave)

    const otpSheet = getSheet(SHEET_NAMES.ATTENDANCE_OTP);

    const allOtp = getSheetDataAsObjects(otpSheet) || [];

    const otpByStudent = {};

    allOtp.forEach(o => {

      const rid = String(o.RegistrationID || "").trim().toUpperCase();

      if (!rid) return;

      if (!otpByStudent[rid]) otpByStudent[rid] = [];

      otpByStudent[rid].push(o);

    });



    // Bulk check for project names/titles

    const projectNames = {};

    allProjects.forEach(p => {

      const rid = String(p.StudentRegistrationID || "").trim().toUpperCase();

      if (!rid) return;

      if (!projectNames[rid]) {

        let title = String(p.Title || p.ProjectTitle || p.ProjectName || '').trim();

        if (title.toUpperCase() === 'N/A') {

          title = '';

        }

        projectNames[rid] = title;

      }

    });



    // Bulk check for diary count

    const diarySheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    const allDiary = getSheetDataAsObjects(diarySheet) || [];

    const diaryCountMap = {};

    allDiary.forEach(d => {

      const rid = String(d.StudentRegistrationID || "").trim().toUpperCase();

      if (!rid) return;

      diaryCountMap[rid] = (diaryCountMap[rid] || 0) + 1;

    });



    // Bulk check for certificates

    const certSheet = getSheet(SHEET_NAMES.CERTIFICATE_DATA);

    const allCerts = getSheetDataAsObjects(certSheet) || [];

    const certNumberMap = {};

    allCerts.forEach(c => {

      const rid = String(c.StudentRegistrationID || "").trim().toUpperCase();

      if (!rid) return;

      if (c.CertificateNumber) {

        certNumberMap[rid] = String(c.CertificateNumber).trim();

      }

    });



    const mapped = data.map(s => {

      let name = getStudentFullName_(s);



      const regIdUpper = String(s.RegistrationID || "").trim().toUpperCase();



      // Compute verified attended days according to official business logic

      let verifiedAttendedDays = 0;

      

      const parseToISO_ = (val) => {

        if (!val) return null;

        if (val instanceof Date) return Utilities.formatDate(val, "GMT+5:30", "yyyy-MM-dd");

        let str = String(val).trim();

        if (/^\d{4}-\d{2}-\d{2}/.test(str)) return str.substring(0, 10);

        if (/^\d{1,2}[\/\-\.]\d{1,2}[\/\-\.]\d{4}/.test(str)) {

          let p = str.split(/[\/\-\.]/);

          return p[2] + '-' + p[1].padStart(2, '0') + '-' + p[0].padStart(2, '0');

        }

        let d = new Date(val);

        if (!isNaN(d.getTime())) return Utilities.formatDate(d, "GMT+5:30", "yyyy-MM-dd");

        return null;

      };



      const startISO = parseToISO_(s.InternshipStartDate);

      const endISO = parseToISO_(s.InternshipEndDate);



      if (startISO && endISO) {

        const attendedDates = new Set();

        const sd = new Date(startISO + "T00:00:00");

        const ed = new Date(endISO + "T23:59:59.999");



        // 1. Weekly offs (Sundays) within duration are counted as Attended / Present

        let cur = new Date(sd);

        let safety = 0;

        while (cur <= ed && safety < 1000) {

          safety++;

          if (cur.getDay() === 0) {

            attendedDates.add(parseToISO_(cur));

          }

          cur.setDate(cur.getDate() + 1);

        }



        // 2. Attendance log entries (Present, Late, Early, OD, WFH, Medical Leave)

        const sAtt = attendanceByStudent[regIdUpper] || [];

        sAtt.forEach(a => {

          const sStatus = String(a.Status || "").trim().toLowerCase();

          const appStatus = String(a.ApprovalStatus || "").trim().toUpperCase();

          if (appStatus === 'DENIED' || sStatus === 'denied') return;



          if (sStatus.includes('present') || sStatus.includes('late') || sStatus.includes('early') ||

              sStatus === 'od' || sStatus === 'wfh' || sStatus.includes('medical') || sStatus.includes('ml')) {

            const dISO = parseToISO_(a.Date);

            if (dISO && dISO >= startISO && dISO <= endISO) {

              attendedDates.add(dISO);

            }

          }

        });



        // 3. Approved OTP Requests (OD, WFH, Medical Leave)

        const sOtp = otpByStudent[regIdUpper] || [];

        sOtp.forEach(o => {

          if (String(o.Status || "").toLowerCase() === 'approved') {

            const dISO = parseToISO_(o.TargetDate);

            if (dISO && dISO >= startISO && dISO <= endISO) {

              attendedDates.add(dISO);

            }

          }

        });



        verifiedAttendedDays = attendedDates.size;

      }



      if (verifiedAttendedDays === 0) {

        verifiedAttendedDays = parseInt(s.DurationDays) || 30;

      }



      return {

        registrationId: s.RegistrationID,

        name: name,

        firstName: s.FirstName || '',

        middleName: s.MiddleName || '',

        lastName: s.LastName || '',

        gmail: s.GmailID,

        batch: s.Batch || '',

        college: s.CollegeName || '',

        department: s.Department || '',

        mobile: s.MobileNumber || s.Mobile || s.PhoneNumber || s.Phone || s.ContactNumber || s.MobileNo || '',

        phone: s.MobileNumber || s.Mobile || s.PhoneNumber || s.Phone || s.ContactNumber || s.MobileNo || '',

        registerNumber: s.RegisterNumber || '',

        year: s.Year || '',

        semester: s.Semester || '',

        gender: s.Gender || '',

        appliedDate: s.Timestamp ? formatDateISO(s.Timestamp) : '',

        InternshipStartDate: s.InternshipStartDate || '',

        InternshipEndDate: s.InternshipEndDate || '',

        status: s.ApplicationStatus || s.Status || 'Pending',

        applicationStatus: s.ApplicationStatus || '',

        actualStatus: s.Status || '',

        internshipStart: s.InternshipStartDate ? formatDateSafe(s.InternshipStartDate) : '',

        rawInternshipStart: s.InternshipStartDate || '',

        internshipEnd: s.InternshipEndDate ? formatDateSafe(s.InternshipEndDate) : '',

        rawInternshipEnd: s.InternshipEndDate || '',

        profilePhotoUrl: s.ProfilePhotoUrl || '',

        rfidTag: s.RFID_TagID || '',

        projectName: projectNames[regIdUpper] || '',

        interestedArea: s.InterestedArea || '',

        hasDocuments: studentsWithFiles.has(regIdUpper),

        allMandatoryDone: !!((s.BonafideUrl || '').trim() && (s.DeclarationUrl || '').trim() && (s.CollegeIdUrl || '').trim()),

        projectDocCount: projectDocCounts[regIdUpper] || 0,

        attendanceAccess: (s.AttendanceAccess !== false && s.AttendanceAccess !== 'FALSE' && String(s.AttendanceAccess).trim().toUpperCase() !== 'FALSE'),

        diaryAccess: (s.DiaryAccess !== false && s.DiaryAccess !== 'FALSE' && String(s.DiaryAccess).trim().toUpperCase() !== 'FALSE'),

        isTaskPending: taskStatusMap[regIdUpper] ? (taskStatusMap[regIdUpper].completed < taskStatusMap[regIdUpper].total) : false,

        isProjectPending: !!projectStatusMap[regIdUpper],

        attendanceCount: attendanceCountMap[regIdUpper] || 0,

        diaryCount: diaryCountMap[regIdUpper] || 0,

        attendedDays: verifiedAttendedDays,

        durationDaysVal: verifiedAttendedDays,

        durationDays: parseInt(s.DurationDays, 10) || 30,

        certificateNumber: certNumberMap[regIdUpper] || s.CertificateNumber || '',

        certificateIssued: !['pending', 'submitted', 'rejected'].includes(String(s.ApplicationStatus || s.Status || '').toLowerCase()) && !!( (s.CertificateLink && String(s.CertificateLink).trim().startsWith('http')) || (s.CertificateIssuedDate && String(s.CertificateIssuedDate).trim() !== '0' && String(s.CertificateIssuedDate).trim() !== '-' && certNumberMap[regIdUpper]) ),

        certificateLink: s.CertificateLink || ''

      };

    });



    // Sort mapped students: primary by status priority, secondary by date descending

    mapped.sort((a, b) => {

      const pa = getStatusPriority(a.applicationStatus || a.status || '');

      const pb = getStatusPriority(b.applicationStatus || b.status || '');

      if (pa !== pb) return pa - pb;

      

      const da = a.appliedDate ? new Date(a.appliedDate) : (a.InternshipStartDate ? new Date(a.InternshipStartDate) : new Date(0));

      const db = b.appliedDate ? new Date(b.appliedDate) : (b.InternshipStartDate ? new Date(b.InternshipStartDate) : new Date(0));

      return db - da;

    });



    return mapped;

  } catch (e) {

    Logger.log("Error in getAllStudents: " + e.message);

    return [];

  }

}



function cleanCorruptRows() {

  const sheets = [SHEET_NAMES.REGISTRATIONS, 'Closed and Opt-out'];

  sheets.forEach(sheetName => {

    try {

      const sheet = getSheet(sheetName);

      if (!sheet) return;

      const data = sheet.getDataRange().getValues();

      if (data.length <= 1) return;

      

      const headers = data[0];

      const regIdIdx = headers.indexOf("RegistrationID");

      const firstNameIdx = headers.indexOf("FirstName");

      const statusIdx = headers.indexOf("ApplicationStatus");

      

      let deletedCount = 0;

      for (let i = data.length - 1; i >= 1; i--) {

        const row = data[i];

        const regId = regIdIdx !== -1 ? String(row[regIdIdx] || '').trim() : '';

        const firstName = firstNameIdx !== -1 ? String(row[firstNameIdx] || '').trim() : '';

        const status = statusIdx !== -1 ? String(row[statusIdx] || '').trim() : '';

        

        const isUndefinedRegId = !regId || regId.toLowerCase() === 'undefined';

        const isDefaultName = !firstName || firstName.toLowerCase() === 'student';

        const isRowEmpty = row.every(val => !val || String(val).trim() === '');

        

        if (isRowEmpty) {

          sheet.deleteRow(i + 1);

          deletedCount++;

          continue;

        }

        

        // Delete if registration ID is undefined/empty or if default name with no registration details

        if (isUndefinedRegId || (isDefaultName && !regId)) {

          sheet.deleteRow(i + 1);

          deletedCount++;

        }

      }

      

      if (deletedCount > 0) {

        executionCache.delete(sheetName);

        Logger.log(`Cleaned up ${deletedCount} corrupt/undefined rows from ${sheetName}`);

      }

    } catch (e) {

      Logger.log(`Error cleaning corrupt rows in ${sheetName}: ` + e.toString());

    }

  });

}



function clearStudentRelatedRecords(regId) {

  const rId = String(regId || "").trim().toUpperCase();

  if (!rId) return;



  const sheetsToClear = [

    { name: SHEET_NAMES.ATTENDANCE, colName: "StudentRegistrationID" },

    { name: SHEET_NAMES.TASKS, colName: "StudentRegistrationID" },

    { name: SHEET_NAMES.PROJECTS, colName: "StudentRegistrationID" },

    { name: SHEET_NAMES.STUDENT_DIARY, colName: "StudentRegistrationID" },

    { name: SHEET_NAMES.GENERATED_DOCUMENTS, colName: "StudentRegistrationID" },

    { name: SHEET_NAMES.FILE_MANAGER, colName: "StudentRegistrationID" },

    { name: SHEET_NAMES.STUDENT_REQUESTS, colName: "RegistrationID" },

    { name: SHEET_NAMES.ATTENDANCE_REQUESTS, colName: "RegistrationID" }

  ];



  sheetsToClear.forEach(sConfig => {

    try {

      const sheet = getSheet(sConfig.name);

      if (sheet) {

        const data = sheet.getDataRange().getValues();

        if (data.length > 1) {

          const headers = data[0];

          const colIdx = headers.indexOf(sConfig.colName);

          if (colIdx !== -1) {

            let deletedCount = 0;

            for (let i = data.length - 1; i >= 1; i--) {

              if (String(data[i][colIdx]).trim().toUpperCase() === rId) {

                sheet.deleteRow(i + 1);

                deletedCount++;

              }

            }

            if (deletedCount > 0) {

              executionCache.delete(sConfig.name);

              Logger.log(`Cleared ${deletedCount} rows for ${rId} from ${sConfig.name}`);

            }

          }

        }

      }

    } catch (e) {

      Logger.log(`Error clearing ${sConfig.name} for ${rId}: ` + e.toString());

    }

  });

}



function cleanOptOutStudents() {

  const debugLog = [];

  debugLog.push(["Timestamp", "Message"]);

  

  const logDebug = (msg) => {

    debugLog.push([new Date().toISOString(), msg]);

    Logger.log(msg);

  };



  try {

    logDebug("Starting cleanOptOutStudents");

    const ss = getSpreadsheet();

    logDebug("Spreadsheet opened. ID: " + ss.getId() + " Name: " + ss.getName());

    

    // First, run general corrupt/undefined rows clean

    cleanCorruptRows();

    

    // 1. Clean Registrations Sheet - Delete opted-out or invalid rows

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (regSheet) {

      logDebug("Registrations sheet found: " + regSheet.getName());

      const regData = regSheet.getDataRange().getValues();

      logDebug("Registrations total rows: " + regData.length);

      if (regData.length > 1) {

        const headers = regData[0];

        const regIdIdx = headers.indexOf("RegistrationID");

        const statusIdx = headers.indexOf("ApplicationStatus");

        logDebug("Headers: " + JSON.stringify(headers));

        logDebug("regIdIdx: " + regIdIdx + ", statusIdx: " + statusIdx);

        

        let deletedFromReg = 0;

        // Loop backwards to preserve indices

        for (let i = regData.length - 1; i >= 1; i--) {

          const regId = regIdIdx !== -1 ? regData[i][regIdIdx] : null;

          const status = statusIdx !== -1 ? String(regData[i][statusIdx] || '').trim().toLowerCase() : '';

          const isOptOut = (status === 'opt-out' || status === 'optout');

          const isUndefinedRegId = !regId || String(regId).trim() === '' || String(regId).toLowerCase() === 'undefined';

          const isRowEmpty = regData[i].every(val => !val || String(val).trim() === '');

          

          if (isRowEmpty) continue;

          

          if (isOptOut || isUndefinedRegId) {

            logDebug(`Deleting row ${i+1}: RegId='${regId}', Status='${status}', isOptOut=${isOptOut}, isUndefinedRegId=${isUndefinedRegId}`);

            if (regId && String(regId).toLowerCase() !== 'undefined' && String(regId).trim() !== '') {

              // Ensure they are archived in 'Closed and Opt-out' if they were Opt-out and not already archived

              if (isOptOut) {

                try {

                  const closedSheetObj = getSheet('Closed and Opt-out');

                  let alreadyArchived = false;

                  if (closedSheetObj) {

                    const closedData = closedSheetObj.getDataRange().getValues();

                    if (closedData.length > 1) {

                      const closedRegIdCol = closedData[0].indexOf("RegistrationID");

                      if (closedRegIdCol !== -1) {

                        alreadyArchived = closedData.some(row => String(row[closedRegIdCol]).trim() === String(regId).trim());

                      }

                    }

                  }

                  

                  if (!alreadyArchived) {

                    // Copy to closed sheet

                    let rowValues = [...regData[i]];

                    // Make sure status is stored correctly

                    if (statusIdx !== -1) rowValues[statusIdx] = "Opt-out";

                    const mainStatusCol2 = headers.indexOf("Status");

                    if (mainStatusCol2 !== -1) rowValues[mainStatusCol2] = "Opt-out";

                    

                    // Clear document links and RFID tag ID in the archived row values

                    const docColsToClear = [

                      "ApplicationPdfId", "OfferLetterPdfId", "JoiningLetterPdfId", 

                      "ProfilePhotoUrl", "CertificateLink", "BonafideUrl", 

                      "DeclarationUrl", "CollegeIdUrl", "OtherUrl", "RFID_TagID"

                    ];

                    docColsToClear.forEach(colName => {

                      const colIdx = headers.indexOf(colName);

                      if (colIdx !== -1 && colIdx < rowValues.length) {

                        rowValues[colIdx] = "";

                      }

                    });

                    

                    let targetClosedSheet = closedSheetObj;

                    if (!targetClosedSheet) {

                      const ss = SpreadsheetApp.getActiveSpreadsheet();

                      targetClosedSheet = ss.insertSheet('Closed and Opt-out');

                      targetClosedSheet.appendRow(headers);

                    }

                    targetClosedSheet.appendRow(rowValues);

                    logDebug(`Archived opted-out student ${regId} to Closed and Opt-out sheet.`);

                  }

                } catch (archiveErr) {

                  logDebug("Error archiving opted-out student: " + archiveErr.toString());

                }

              }

              

              try { adminDeleteFolder(regId); } catch (e) { logDebug("Error deleting folders for " + regId + ": " + e); }

              try { clearStudentRelatedRecords(regId); } catch (e) { logDebug("Error clearing related records for " + regId + ": " + e); }

            }

            regSheet.deleteRow(i + 1);

            deletedFromReg++;

          }

        }

        if (deletedFromReg > 0) {

          executionCache.delete(SHEET_NAMES.REGISTRATIONS);

          logDebug(`Cleaned up ${deletedFromReg} opted-out/invalid rows from Registrations sheet.`);

        }

      }

    } else {

      logDebug("Registrations sheet NOT found!");

    }

    

    // 2. Clean Closed and Opt-out Sheet - ONLY delete undefined registration IDs, NOT actual Opt-out rows!

    const closedSheet = getSheet('Closed and Opt-out');

    if (closedSheet) {

      logDebug("Closed sheet found: " + closedSheet.getName());

      const closedData = closedSheet.getDataRange().getValues();

      logDebug("Closed total rows: " + closedData.length);

      if (closedData.length > 1) {

        const headers = closedData[0];

        const regIdIdx = headers.indexOf("RegistrationID");

        const statusIdx = headers.indexOf("ApplicationStatus");

        logDebug("Headers: " + JSON.stringify(headers));

        logDebug("regIdIdx: " + regIdIdx + ", statusIdx: " + statusIdx);

        

        let deletedFromClosed = 0;

        // Loop backwards to preserve indices

        for (let i = closedData.length - 1; i >= 1; i--) {

          const regId = regIdIdx !== -1 ? closedData[i][regIdIdx] : null;

          const isUndefinedRegId = !regId || String(regId).trim() === '' || String(regId).toLowerCase() === 'undefined';

          const isRowEmpty = closedData[i].every(val => !val || String(val).trim() === '');

          

          if (isRowEmpty) continue;

          

          if (isUndefinedRegId) {

            logDebug(`Deleting closed row ${i+1}: RegId='${regId}', isUndefinedRegId=${isUndefinedRegId}`);

            closedSheet.deleteRow(i + 1);

            deletedFromClosed++;

          }

        }

        if (deletedFromClosed > 0) {

          executionCache.delete('Closed and Opt-out');

          logDebug(`Cleaned up ${deletedFromClosed} invalid rows from Closed and Opt-out sheet.`);

        }

      }

    } else {

      logDebug("Closed sheet NOT found!");

    }

    

    // Sync sheets

    syncStudentCategoriesToSheets();

    logDebug("Sync completed successfully.");

    

  } catch (e) {

    logDebug("Error: " + e.toString());

  }



  // Write debug log to a sheet named "Cleanup Debug Log"

  try {

    const ss = getSpreadsheet();

    let debugSheet = ss.getSheetByName("Cleanup Debug Log");

    if (!debugSheet) {

      debugSheet = ss.insertSheet("Cleanup Debug Log");

    } else {

      debugSheet.clearContents();

      debugSheet.clearFormats();

    }

    debugSheet.getRange(1, 1, debugLog.length, debugLog[0].length).setValues(debugLog);

    debugSheet.getRange(1, 1, 1, debugLog[0].length).setBackground('#f3f4f6').setFontWeight('bold');

    debugSheet.autoResizeColumns(1, debugLog[0].length);

  } catch(e) {

    Logger.log("Failed to write debug sheet: " + e.toString());

  }

}



