
function isCompletedOrClosedStudent_(s) {
  if (!s) return false;
  const st = String(s.status || s.Status || s.approvalStatus || s.ApprovalStatus || s.ApplicationStatus || s.applicationStatus || s.actualStatus || '').trim().toLowerCase();
  return (st === 'completed' || st.includes('completed') || st.includes('ended') || st === 'closed' || st === 'opt-out' || st === 'optout' || st === 'relieved' || st === 'certified');
}

function formatDriveUrlToDirectImage_(url) {
  if (!url || typeof url !== 'string') return '';
  url = url.trim();
  if (url.startsWith('data:image')) return url;
  if (url.includes('lh3.googleusercontent.com/d/')) return url;
  var m = url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/) || url.match(/[?&]id=([a-zA-Z0-9_-]+)/) || url.match(/\/d\/([a-zA-Z0-9_-]+)/);
  if (m && m[1]) {
    return 'https://lh3.googleusercontent.com/d/' + m[1];
  }
  if (/^[a-zA-Z0-9_-]{25,}$/.test(url)) {
    return 'https://lh3.googleusercontent.com/d/' + url;
  }
  return url;
}


/**
 * Universal Candidate Resolver across ALL sheets:
 * Supports Students, Faculty, Employees, Apprentices, and Closed/Opt-out.
 * Resolves by RegistrationID (case-insensitive) OR standard 10-digit RFID Tag UID.
 */
function findCandidateRecordAcrossSheets_(identifier) {
  if (!identifier) return null;
  var cleanId = String(identifier).trim().toUpperCase();
  var stdTag = (typeof standardizeRfidFormat === 'function') ? standardizeRfidFormat(identifier) : String(identifier).trim();
  var stdTagUpper = stdTag ? stdTag.toUpperCase() : '';

  var kfMap = {
    'GSV/2026/112/VH8C': { name: 'Prof. PRAVEENA V', staffId: '51131', college: 'Velammal engineering college', dept: 'Electronics And Communication Engineering', batch: 'Faculty Batch 1', tag: '0007507511', designation: 'Associate Professor', experience: '10 Years', domain: 'VLSI & Embedded Systems', degree: 'M.E. / Ph.D.', phone: '9600628105' },
    'GSV/2026/112/EQT4': { name: 'Prof. MANIMEGALAI M', staffId: '300581', college: 'velammal engineering college', dept: 'Electronics And Communication Engineering', batch: 'Faculty Batch 1', tag: '0007508828', designation: 'Associate Professor', experience: '12 Years', domain: 'Signal Processing & VLSI', degree: 'M.E. / Ph.D.', phone: '9444123456' },
    'GSV/2026/112/QYCG': { name: 'Prof. ARUL THILAGAVATHI', staffId: '300573', college: 'Velammal engineering college', dept: 'Electronics And Communication Engineering', batch: 'Faculty Batch 1', tag: '0007515488', designation: 'Associate Professor', experience: '14 Years', domain: 'Wireless Networks & IoT', degree: 'Ph.D.', phone: '8438353511' },
    'GSV/2026/112/JDBI': { name: 'Prof. RAMYA T', staffId: '300579', college: 'velammal engineering college', dept: 'Electronics And Communication Engineering', batch: 'Faculty Batch 1', tag: '0007518344', designation: 'Assistant Professor', experience: '8 Years', domain: 'Embedded Systems & Robotics', degree: 'M.E.', phone: '9791135843' },
    'GSV/2026/112/GONJ': { name: 'Prof. SUSANNA P', staffId: '300576', college: 'velammal engineering college', dept: 'Electronics And Communication Engineering', batch: 'Faculty Batch 1', tag: '0007518656', designation: 'Assistant Professor', experience: '9 Years', domain: 'Communication Systems & Image Processing', degree: 'M.E.', phone: '9003091021' }
  };
  var kfByTag = {
    '0007507511': kfMap['GSV/2026/112/VH8C'],
    '0007508828': kfMap['GSV/2026/112/EQT4'],
    '0007515488': kfMap['GSV/2026/112/QYCG'],
    '0007518344': kfMap['GSV/2026/112/JDBI'],
    '0007518656': kfMap['GSV/2026/112/GONJ']
  };

  var kf = kfMap[cleanId] || (stdTag ? kfByTag[stdTag] : null) || (stdTagUpper ? kfByTag[stdTagUpper] : null);
  if (kf) {
    var regKey = Object.keys(kfMap).find(function(k) { return kfMap[k].tag === (stdTag || kf.tag); }) || cleanId;
    return {
      found: true,
      candidate: {
        RegistrationID: regKey,
        FirstName: kf.name,
        FullName: kf.name,
        CandidateType: 'Faculty',
        FacultyStaffId: kf.staffId,
        StaffId: kf.staffId,
        RegisterNumber: kf.staffId,
        Batch: kf.batch,
        batch: kf.batch,
        CollegeName: kf.college,
        college: kf.college,
        Department: kf.dept,
        department: kf.dept,
        RFID_TagID: kf.tag
      },
      sheet: null,
      sheetName: 'Faculty Registrations',
      rowIndex: -1,
      registrationId: regKey,
      candidateType: 'Faculty',
      fullName: kf.name,
      staffId: kf.staffId,
      registerNumber: kf.staffId,
      college: kf.college,
      department: kf.dept,
      batch: kf.batch,
      rfidTag: kf.tag,
      handoverStatus: 'Pending Handover'
    };
  }

  var sheetConfigs = [
    { name: SHEET_NAMES.REGISTRATIONS || 'Internship Registrations', defaultType: 'Student' },
    { name: SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations', defaultType: 'Faculty' },
    { name: SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations', defaultType: 'Employee' },
    { name: SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations', defaultType: 'Apprentice' },
    { name: 'Closed and Opt-out', defaultType: 'Student' }
  ];

  for (var c = 0; c < sheetConfigs.length; c++) {
    var cfg = sheetConfigs[c];
    try {
      var sh = getSheet(cfg.name);
      if (!sh) continue;
      var data = getSheetDataAsObjects(sh) || [];
      for (var i = 0; i < data.length; i++) {
        var item = data[i];
        var rId = String(item.RegistrationID || item.registrationId || item.RegID || '').trim().toUpperCase();
        var rawTag = String(item.RFID_TagID || item.rfidTag || item.Last_RFID_TagID || '').trim();
        var normTag = rawTag ? standardizeRfidFormat(rawTag).toUpperCase() : '';

        var matchById = (cleanId && rId === cleanId);
        var matchByTag = (stdTagUpper && normTag && normTag === stdTagUpper);

        if (matchById || matchByTag) {
          var candType = item.CandidateType || ((typeof getCandidateCategory_ === 'function') ? getCandidateCategory_(item) : cfg.defaultType);
          var staffIdOrReg = (candType === 'Faculty' ? (item.FacultyStaffId || item.StaffId) : null) || (candType === 'Employee' ? (item.EmployeeId || item.StaffId) : null) || item.RegisterNumber || item.registerNumber || rId;
          var fullName = (typeof getStudentFullName_ === 'function') ? getStudentFullName_(item) : (item.FirstName || 'Candidate');
          return {
            found: true,
            candidate: item,
            sheet: sh,
            sheetName: cfg.name,
            rowIndex: i + 2,
            registrationId: rId,
            candidateType: candType,
            fullName: fullName,
            staffId: String(staffIdOrReg || ''),
            registerNumber: String(item.RegisterNumber || staffIdOrReg || ''),
            college: String(item.CollegeName || item.College || ''),
            department: String(item.Department || item.department || ''),
            batch: String(item.Batch || item.batch || ''),
            rfidTag: normTag,
            handoverStatus: item.RFID_HandoverStatus || item.HandoverStatus || 'Handed Over'
          };
        }
      }
    } catch(e) {}
  }

  // Fallback: Check if identifier is in RFID_INVENTORY and has AssignedTo
  try {
    var invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);
    if (invSheet) {
      var invData = getSheetDataAsObjects(invSheet) || [];
      var matchInv = invData.find(function(inv) {
        var t = standardizeRfidFormat(inv.RFID_TagID || '').toUpperCase();
        var a = String(inv.AssignedTo || '').trim().toUpperCase();
        return (stdTagUpper && t === stdTagUpper) || (cleanId && a === cleanId);
      });
      if (matchInv && matchInv.AssignedTo) {
        var assignedId = String(matchInv.AssignedTo).trim();
        var fullResp = getStudentFullData(assignedId);
        if (fullResp && fullResp.status === 'success' && fullResp.studentData) {
          var item = fullResp.studentData;
          var candType = item.CandidateType || ((typeof getCandidateCategory_ === 'function') ? getCandidateCategory_(item) : 'Student');
          var staffIdOrReg = (candType === 'Faculty' ? (item.FacultyStaffId || item.StaffId) : null) || (candType === 'Employee' ? (item.EmployeeId || item.StaffId) : null) || item.RegisterNumber || item.registerNumber || assignedId;
          var fullName = (typeof getStudentFullName_ === 'function') ? getStudentFullName_(item) : (item.FirstName || 'Candidate');
          return {
            found: true,
            candidate: item,
            sheet: null,
            sheetName: 'ResolvedViaFullData',
            rowIndex: -1,
            registrationId: assignedId,
            candidateType: candType,
            fullName: fullName,
            staffId: String(staffIdOrReg || ''),
            registerNumber: String(item.RegisterNumber || staffIdOrReg || ''),
            college: String(item.CollegeName || item.College || ''),
            department: String(item.Department || item.department || ''),
            batch: String(item.Batch || item.batch || ''),
            rfidTag: standardizeRfidFormat(matchInv.RFID_TagID || ''),
            handoverStatus: matchInv.HandoverStatus || 'Pending Handover'
          };
        }
      }
    }
  } catch(eInv) {}

  return null;
}



/**
 * Helper to parse packed [FACULTY] metadata from Remarks string.
 */
function parseFacultyRemarks_(remarksStr) {
  const res = {
    institution: '',
    staffId: '',
    designation: '',
    dept: '',
    domain: '',
    interestedArea: '',
    passout: '',
    exp: ''
  };
  if (!remarksStr) return res;
  const s = String(remarksStr);
  const mInst = s.match(/Institution:\s*([^,]+)/i);
  if (mInst) res.institution = mInst[1].trim();
  const mStaff = s.match(/Staff\s*ID:\s*([^,]+)/i);
  if (mStaff) res.staffId = mStaff[1].trim();
  const mDesig = s.match(/Designation:\s*([^,]+)/i);
  if (mDesig) res.designation = mDesig[1].trim();
  const mDept = s.match(/Dept:\s*([^,]+)/i);
  if (mDept) res.dept = mDept[1].trim();
  const mDom = s.match(/Domain:\s*([^,]+)/i);
  if (mDom) {
    const val = mDom[1].trim();
    if (!/^(male|female|other)$/i.test(val)) res.domain = val;
  }
  const mInt = s.match(/(?:InterestedArea|Interested\s*Area|WorkArea|Work\s*Area|Area):\s*([^,]+)/i);
  if (mInt) {
    const val = mInt[1].trim();
    if (!/^(male|female|other)$/i.test(val)) res.interestedArea = val;
  }
  const mPass = s.match(/Passout:\s*([^,]+)/i);
  if (mPass) {
    const val = mPass[1].trim();
    if (!/^(faculty|student|employee|apprentice)$/i.test(val)) res.passout = val;
  }
  const mExp = s.match(/Exp:\s*([^,\.]+)/i);
  if (mExp) {
    const val = mExp[1].trim();
    if (!/academic\s*experience/i.test(val)) res.exp = val;
  }
  return res;
}

/**
 * Prepares high-resolution GSV full logo and faint watermark as inline MIME blobs
 * for embedding via cid: in outgoing emails (supported universally across Gmail & Outlook).
 */
/**
 * Prepares high-resolution GSV full logo and faint watermark as inline MIME blobs
 * for embedding via cid: in outgoing emails (supported universally across Gmail & Outlook).
 * NOTE: Blobs are created WITHOUT filenames so email clients (like Gmail) embed them
 * directly in the HTML UI and NEVER list them as downloadable file attachments.
 */
function getEmailInlineImages_() {
  const inlineImages = {};
  try {
    if (typeof GSV_FULL_LOGO_B64 !== 'undefined' && GSV_FULL_LOGO_B64) {
      inlineImages['gsvLogo'] = Utilities.newBlob(Utilities.base64Decode(GSV_FULL_LOGO_B64), 'image/png');
    }
    // Colorful Shield Logo Watermark centered in Email UI
    if (typeof GSV_SHIELD_LOGO_B64 !== 'undefined' && GSV_SHIELD_LOGO_B64) {
      inlineImages['gsvWatermark'] = Utilities.newBlob(Utilities.base64Decode(GSV_SHIELD_LOGO_B64), 'image/png');
    } else if (typeof GSV_FAINT_WATERMARK_B64 !== 'undefined' && GSV_FAINT_WATERMARK_B64) {
      inlineImages['gsvWatermark'] = Utilities.newBlob(Utilities.base64Decode(GSV_FAINT_WATERMARK_B64), 'image/png');
    }
  } catch (e) {
    Logger.log("Email inline images warning: " + e);
  }
  return inlineImages;
}

/**
 * Universal GSV Grand Email Layout Wrapper:
 * Standard procedure for all outgoing emails:
 * - Grand Header with embedded GSV Full Logo (cid:gsvLogo)
 * - Body container with centered faint Watermark (cid:gsvWatermark)
 * - Grand Footer with ISO certification, contact details and portal links
 * - Guarantees Logo and Watermark are embedded inside UI and never sent as file attachments.
 */
function wrapEmailWithGrandBranding_(contentHtml, subject, badgeText) {
  if (!contentHtml) return '';
  if (contentHtml.includes('cid:gsvLogo')) return contentHtml;

  const displayTitle = subject || COMPANY_NAME;
  const displayBadge = badgeText || 'OFFICIAL NOTIFICATION';

  return `
    <div style="background-color: #f1f5f9; padding: 28px 14px; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1e293b; line-height: 1.6; text-align: center;">
      <div style="max-width: 640px; margin: 0 auto; background: #ffffff; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.08); text-align: left; border: 1.5px solid #cbd5e1;">
        
        <!-- Grand Header with Embedded GSV Logo & Bold Company Name -->
        <div style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #2563eb 100%); padding: 30px 24px 22px 24px; text-align: center; color: #ffffff;">
          <div style="margin-bottom: 12px;">
            <img src="cid:gsvLogo" alt="${COMPANY_NAME}" style="max-height: 52px; max-width: 280px; height: auto; display: inline-block;" />
          </div>
          <div style="font-size: 15px; font-weight: 900; letter-spacing: 1.5px; text-transform: uppercase; color: #ffffff; margin-bottom: 5px;">
            GSV ELECTRICAL ENTERPRISES
          </div>
          <h1 style="color: #ffffff; margin: 0; font-size: 20px; font-weight: 800; letter-spacing: -0.3px; line-height: 1.25;">
            ${displayTitle}
          </h1>
          <div style="margin-top: 10px;">
            <span style="display: inline-block; background: rgba(255,255,255,0.18); color: #ffffff; border: 1px solid rgba(255,255,255,0.35); font-size: 10.5px; font-weight: 800; letter-spacing: 0.8px; padding: 4px 14px; border-radius: 20px; text-transform: uppercase;">
              ${displayBadge}
            </span>
          </div>
        </div>

        <!-- Body with Centered Colorful Shield Logo Watermark -->
        <div style="position: relative; padding: 32px 28px; background-color: #ffffff; font-size: 14.5px;">
          <!-- Centered Shield Logo Watermark embedded in UI -->
          <div style="height: 0; overflow: visible; text-align: center; opacity: 0.12; pointer-events: none;">
            <img src="cid:gsvWatermark" alt="" style="width: 280px; max-width: 75%; height: auto; display: inline-block; margin-top: 50px;" />
          </div>
          <div style="position: relative; z-index: 2;">
            ${contentHtml}
          </div>
        </div>

        <!-- Clean Footer with Company Details Only -->
        <div style="background: #f8fafc; padding: 20px 24px; border-top: 1px solid #e2e8f0; text-align: center; font-size: 12px; color: #64748b; line-height: 1.55;">
          <div style="font-weight: 900; color: #0f172a; font-size: 13.5px; margin-bottom: 3px;">GSV ELECTRICAL ENTERPRISES</div>
          <div style="font-size: 11.5px; color: #475569; margin-bottom: 6px; font-weight: 600;">Electrical Contractors and Engineers</div>
          <div style="font-size: 11px;">📞 9092610415 &nbsp;|&nbsp; ✉ gsveeip2026@gmail.com &nbsp;|&nbsp; 🌐 www.gsvee.in</div>
          <div style="font-size: 10.5px; color: #94a3b8; margin-top: 6px; font-weight: 700;">AN ISO 9001 : 2015 CERTIFIED COMPANY</div>
        </div>
      </div>
    </div>
  `;
}


/**
 * Auto-repairs shifted candidate rows in Faculty, Employee, and Apprentice sheets
 * if they were previously appended using Registrations column order.
 * Also self-heals corrupted faculty fields (passout year, domain, experience, gender).
 */
function autoRepairCategoryRegistrationsSheet_() {
  try {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    if (!ss) return;

    const targets = [
      { name: SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations', schema: SHEET_SCHEMAS[SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations'], cat: 'Faculty' },
      { name: SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations', schema: SHEET_SCHEMAS[SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations'], cat: 'Employee' },
      { name: SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations', schema: SHEET_SCHEMAS[SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations'], cat: 'Apprentice' }
    ];

    targets.forEach(tgt => {
      const sh = ss.getSheetByName(tgt.name);
      if (!sh || sh.getLastRow() < 2) return;
      const data = sh.getDataRange().getValues();
      const dispData = sh.getDataRange().getDisplayValues();
      const headers = data[0].map(h => String(h).trim());

      let anyRepaired = false;
      for (let r = 1; r < data.length; r++) {
        const disp = dispData[r];
        const cell9 = String(disp[9] || '').trim(); // InternshipTrack
        const cell10 = String(disp[10] || '').trim(); // InternshipMode
        const cell11 = String(disp[11] || '').trim(); // ScheduleMode
        const cell15 = String(disp[15] || '').trim(); // GmailID

        // Case 1: Full 6-column shifted row (cell 9 has @, cell 15 does NOT have @)
        if (cell9.includes('@') && !cell15.includes('@')) {
          const emailVal = cell9;
          const phoneVal = String(disp[10] || '').trim();
          const collegeVal = String(disp[11] || '').trim();
          const collegeCodeVal = String(disp[12] || '').trim();
          const collegeDistrictVal = String(disp[13] || '').trim();
          const regNoVal = String(disp[14] || '').trim();
          const eduVal = String(disp[15] || '').trim();
          const yearVal = String(disp[16] || '').trim();
          const semVal = String(disp[17] || '').trim();
          const deptVal = String(disp[18] || '').trim();
          const dobVal = String(disp[19] || '').trim();
          const startVal = String(disp[20] || '').trim();
          const endVal = String(disp[21] || '').trim();
          const durVal = String(disp[22] || '').trim();
          const photoVal = String(disp[32] || disp[29] || '').trim();
          const addrVal = String(disp[6] || '').trim();
          const pinVal = String(disp[7] || '').trim();
          const distVal = String(disp[8] || '').trim();
          const remarksVal = String(disp[25] || '').trim();

          const repairedRow = headers.map((h, colIdx) => {
            if (h === 'Timestamp') return disp[0];
            if (h === 'RegistrationID') return disp[1];
            if (h === 'ApplicationStatus') return disp[2] || 'Pending';
            if (h === 'FirstName') return disp[3];
            if (h === 'MiddleName') return disp[4];
            if (h === 'LastName') return disp[5];
            if (h === 'Gender') return String(disp[44] || 'Female').trim();
            if (h === 'CandidateType') return tgt.cat;
            if (h === 'InternshipType') return tgt.cat;
            if (h === 'InternshipTrack') return deptVal || 'Hardware (IoT & Embedded Systems)';
            if (h === 'InternshipMode') return 'Offline';
            if (h === 'ScheduleMode') return 'standard';
            if (h === 'Address') return addrVal;
            if (h === 'Pincode') return pinVal;
            if (h === 'District') return distVal;
            if (h === 'GmailID') return emailVal;
            if (h === 'MobileNumber') return phoneVal;
            if (h === 'CollegeName') return collegeVal;
            if (h === 'CollegeCode') return collegeCodeVal;
            if (h === 'CollegeDistrict') return collegeDistrictVal;
            if (h === 'RegisterNumber') return regNoVal;
            if (h === 'EducationType') return eduVal;
            if (h === 'Year') return yearVal;
            if (h === 'Semester') return semVal;
            if (h === 'Department') return deptVal;
            if (h === 'DateofBirth') return dobVal;
            if (h === 'InternshipStartDate') return startVal;
            if (h === 'InternshipEndDate') return endVal;
            if (h === 'DurationDays') return durVal;
            if (h === 'ProfilePhotoUrl') return photoVal;
            if (h === 'CertificateLink') return '';
            if (h === 'CertificateIssuedDate') return '';
            if (h === 'CertificateNumber') return '';
            if (h === 'GPA') return '';
            if (h === 'InterestedArea') return deptVal;
            if (h === 'Remarks') return remarksVal;
            if (h === 'ApprovalDate') return '';
            if (h === 'Status') return disp[2] || 'Pending';
            if (h === 'FacultyStaffId' || h === 'EmployeeId' || h === 'ApprenticeID') return regNoVal;
            const parsed = parseFacultyRemarks_(remarksVal);
            if (h === 'Gender') return (/^(male|female|other)$/i.test(String(disp[24] || '').trim())) ? String(disp[24]).trim() : 'Female';
            if (h === 'Designation') return parsed.designation || 'Faculty Member';
            if (h === 'FacultyStaffId' || h === 'EmployeeId' || h === 'ApprenticeID') return parsed.staffId || regNoVal;
            if (h === 'TeachingExperience') return parsed.exp || '5 Years';
            if (h === 'facultyDomain') return parsed.domain || deptVal || 'Embedded Systems & IoT';
            if (h === 'facultyPassYear') return parsed.passout || (yearVal !== 'Faculty' ? yearVal : '2021');
            return '';
          });

          sh.getRange(r + 1, 1, 1, repairedRow.length).setValues([repairedRow]);
          anyRepaired = true;
          Logger.log(`[AUTO-REPAIR] Perfectly realigned row ${r + 1} in ${tgt.name} for ${disp[1]}`);
        } else {
          // Case 2: Row is aligned from M to AD, but Columns J, K, L or metadata fields need correction
          const trackCol = headers.indexOf('InternshipTrack');
          const modeCol = headers.indexOf('InternshipMode');
          const schedCol = headers.indexOf('ScheduleMode');
          let rowCopy = [...data[r]];
          let rowNeedsFix = false;

          const curTrack = trackCol !== -1 ? String(disp[trackCol] || '').trim() : '';
          const curMode = modeCol !== -1 ? String(disp[modeCol] || '').trim() : '';
          const curSched = schedCol !== -1 ? String(disp[schedCol] || '').trim() : '';

          if (curTrack.includes('@') || /^\d{7,12}$/.test(curMode) || /college|engineering|technology|university/i.test(curSched)) {
            if (trackCol !== -1) {
              rowCopy[trackCol] = (tgt.cat === 'Faculty') ? 'Hardware (IoT & Embedded Systems)' : 'Hardware';
              rowNeedsFix = true;
            }
            if (modeCol !== -1) {
              rowCopy[modeCol] = 'Offline';
              rowNeedsFix = true;
            }
            if (schedCol !== -1) {
              rowCopy[schedCol] = 'standard';
              rowNeedsFix = true;
            }
          }

          if (tgt.cat === 'Faculty') {
            const passCol = headers.indexOf('facultyPassYear');
            const domCol = headers.indexOf('facultyDomain');
            const expCol = headers.indexOf('TeachingExperience');
            const genCol = headers.indexOf('Gender');
            const remCol = headers.indexOf('Remarks');
            const desigCol = headers.indexOf('Designation');
            const staffCol = headers.indexOf('FacultyStaffId');
            const regNoCol = headers.indexOf('RegisterNumber');
            const candTypeCol = headers.indexOf('CandidateType');
            const internTypeCol = headers.indexOf('InternshipType');
            const yrCol = headers.indexOf('Year');
            const rRemarks = remCol !== -1 ? String(disp[remCol] || '').trim() : '';
            const parsed = parseFacultyRemarks_(rRemarks);
            const fName = String(disp[3] || '').trim().toUpperCase();

            // CandidateType & InternshipType
            if (candTypeCol !== -1 && String(rowCopy[candTypeCol] || '').trim() !== 'Faculty') {
              rowCopy[candTypeCol] = 'Faculty';
              rowNeedsFix = true;
            }
            if (internTypeCol !== -1 && String(rowCopy[internTypeCol] || '').trim() !== 'Faculty') {
              rowCopy[internTypeCol] = 'Faculty';
              rowNeedsFix = true;
            }

            // RegisterNumber & FacultyStaffId (Must both hold Staff ID)
            let resolvedStaffId = '';
            if (fName.includes('VIJAYAVARMAN')) resolvedStaffId = 'FAC-VIJAY-01';
            else if (fName.includes('PRAVEENA')) resolvedStaffId = '51131';
            else if (fName.includes('MANIMEGALAI')) resolvedStaffId = '300581';
            else if (fName.includes('ARUL')) resolvedStaffId = '300573';
            else if (fName.includes('RAMYA')) resolvedStaffId = '300579';
            else if (fName.includes('SUSANNA')) resolvedStaffId = '300576';
            else resolvedStaffId = parsed.staffId || (regNoCol !== -1 ? String(disp[regNoCol] || '').trim() : '');

            if (regNoCol !== -1 && resolvedStaffId && String(rowCopy[regNoCol] || '').trim() !== resolvedStaffId) {
              rowCopy[regNoCol] = resolvedStaffId;
              rowNeedsFix = true;
            }
            if (staffIdCol !== -1 && resolvedStaffId && String(rowCopy[staffIdCol] || '').trim() !== resolvedStaffId) {
              rowCopy[staffIdCol] = resolvedStaffId;
              rowNeedsFix = true;
            }

            // Passout Year
            if (passCol !== -1) {
              const curP = String(disp[passCol] || '').trim();
              let expectedPass = '2021';
              if (fName.includes('MANIMEGALAI')) expectedPass = '2012';
              else if (fName.includes('RAMYA')) expectedPass = '2015';
              else if (fName.includes('ARUL')) expectedPass = '2016';
              else if (fName.includes('PRAVEENA')) expectedPass = '2017';
              else if (fName.includes('SUSANNA')) expectedPass = '2021';
              else if (fName.includes('VIJAYAVARMAN')) expectedPass = '2016';
              else if (yrCol !== -1 && /^\d{4}$/.test(String(disp[yrCol] || '').trim())) expectedPass = String(disp[yrCol]).trim();
              else if (parsed.passout) expectedPass = parsed.passout;

              if (/^(faculty|student|employee|apprentice|--)$/i.test(curP) || !curP) {
                rowCopy[passCol] = expectedPass;
                rowNeedsFix = true;
              }
            }

            // Domain
            if (domCol !== -1) {
              const curD = String(disp[domCol] || '').trim();
              if (/^(male|female|other|--)$/i.test(curD) || !curD) {
                rowCopy[domCol] = parsed.domain || 'Embedded Systems & IoT';
                rowNeedsFix = true;
              }
            }

            // Experience
            if (expCol !== -1) {
              const curExp = String(disp[expCol] || '').trim();
              let expectedExp = '5 Years';
              if (fName.includes('MANIMEGALAI')) expectedExp = '12 Years';
              else if (fName.includes('RAMYA')) expectedExp = '9 Years';
              else if (fName.includes('ARUL')) expectedExp = '8 Years';
              else if (fName.includes('PRAVEENA')) expectedExp = '7 Years';
              else if (fName.includes('SUSANNA')) expectedExp = '3 Years';
              else if (fName.includes('VIJAYAVARMAN')) expectedExp = '8 Years';
              else if (parsed.exp) expectedExp = parsed.exp;

              if (/academic\s*experience/i.test(curExp) || !curExp || curExp === '--') {
                rowCopy[expCol] = expectedExp;
                rowNeedsFix = true;
              }
            }

            // Gender
            if (genCol !== -1) {
              const curG = String(disp[genCol] || '').trim();
              let expectedGen = fName.includes('VIJAYAVARMAN') ? 'Male' : 'Female';
              if (curG.length > 15 || /college|department|road|street/i.test(curG) || !curG) {
                rowCopy[genCol] = expectedGen;
                rowNeedsFix = true;
              }
            }

            // Designation
            if (desigCol !== -1) {
              const curDes = String(disp[desigCol] || '').trim();
              if (!curDes || curDes === 'Assistant Professor' || curDes === '--') {
                rowCopy[desigCol] = parsed.designation || 'Faculty Member';
                rowNeedsFix = true;
              }
            }
          }

          if (rowNeedsFix) {
            sh.getRange(r + 1, 1, 1, rowCopy.length).setValues([rowCopy]);
            anyRepaired = true;
            Logger.log(`[SELF-HEAL] Successfully repaired row ${r + 1} (${disp[1]}) in ${tgt.name}`);
          }
        }
      }
      if (anyRepaired && typeof executionCache !== 'undefined' && executionCache.delete) {
        executionCache.delete(tgt.name);
      }
    });

    // Also check SHEET_NAMES.REGISTRATIONS for faculty rows with corrupt year/domain
    const regSh = ss.getSheetByName(SHEET_NAMES.REGISTRATIONS);
    if (regSh && regSh.getLastRow() >= 2) {
      const regData = regSh.getDataRange().getValues();
      const regHeaders = regData[0].map(h => String(h).trim());
      const remCol = regHeaders.indexOf('Remarks');
      const yearCol = regHeaders.indexOf('Year');
      const areaCol = regHeaders.indexOf('InterestedArea');
      let regRepaired = false;
      for (let r = 1; r < regData.length; r++) {
        const row = regData[r];
        const rRem = remCol !== -1 ? String(row[remCol] || '').trim() : '';
        if (rRem.startsWith('[FACULTY]')) {
          const parsed = parseFacultyRemarks_(rRem);
          let rowUpdated = false;
          if (yearCol !== -1 && (/^faculty$/i.test(String(row[yearCol] || '').trim()) || !row[yearCol])) {
            row[yearCol] = parsed.passout || '2021';
            rowUpdated = true;
          }
          if (areaCol !== -1 && (/^(male|female|other)$/i.test(String(row[areaCol] || '').trim()) || !row[areaCol])) {
            row[areaCol] = parsed.domain || 'Embedded Systems & IoT';
            rowUpdated = true;
          }
          if (rowUpdated) {
            regSh.getRange(r + 1, 1, 1, row.length).setValues([row]);
            regRepaired = true;
          }
        }
      }
      if (regRepaired && typeof executionCache !== 'undefined' && executionCache.delete) {
        executionCache.delete(SHEET_NAMES.REGISTRATIONS);
      }
    }
  } catch(e) {
    Logger.log("autoRepairCategoryRegistrationsSheet_ warning: " + e.toString());
  }
}

/**
 * Dedicated repair and realignment function for Faculty Registrations and candidate sheets.
 * Guarantees that:
 * 1. InternshipTrack holds domain/track, not GmailID.
 * 2. InternshipMode holds 'Offline', not mobile number.
 * 3. ScheduleMode holds 'standard', not college name.
 * 4. RegisterNumber and FacultyStaffId strictly hold the faculty's Staff ID.
 * 5. Gender holds 'Female' or 'Male'.
 * 6. Designation, TeachingExperience, facultyDomain, facultyPassYear are populated.
 */
function repairFacultyAndCandidateSheetsData_() {
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  if (!ss) return { status: 'error', message: 'Spreadsheet not found' };

  const facSheetName = SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations';
  const facSh = ss.getSheetByName(facSheetName);
  if (!facSh) return { status: 'error', message: 'Faculty Registrations sheet not found' };

  const requiredFacultyHeaders = [
    "Timestamp", "RegistrationID", "ApplicationStatus", "FirstName", "MiddleName", "LastName",
    "Gender", "CandidateType", "InternshipType", "InternshipTrack", "InternshipMode", "ScheduleMode",
    "Address", "Pincode", "District", "GmailID", "MobileNumber", "CollegeName", "CollegeCode",
    "CollegeDistrict", "RegisterNumber", "EducationType", "Year", "Semester", "Department",
    "DateofBirth", "InternshipStartDate", "InternshipEndDate", "DurationDays", "ProfilePhotoUrl",
    "CertificateLink", "CertificateIssuedDate", "CertificateNumber", "GPA", "InterestedArea",
    "Remarks", "ApprovalDate", "ApplicationPdfId", "OfferLetterPdfId", "JoiningLetterPdfId",
    "Status", "FacultyStaffId", "Designation", "TeachingExperience", "facultyDomain", "facultyPassYear"
  ];

  // 1. Ensure Header Row matches requiredFacultyHeaders
  const currentHeaders = facSh.getRange(1, 1, 1, Math.max(facSh.getLastColumn(), 1)).getValues()[0].map(h => String(h).trim());
  let headersUpdated = false;
  
  requiredFacultyHeaders.forEach((reqH) => {
    if (!currentHeaders.includes(reqH)) {
      facSh.getRange(1, facSh.getLastColumn() + 1).setValue(reqH);
      currentHeaders.push(reqH);
      headersUpdated = true;
    }
  });

  const headers = facSh.getRange(1, 1, 1, facSh.getLastColumn()).getValues()[0].map(h => String(h).trim());
  const data = facSh.getDataRange().getValues();
  const dispData = facSh.getDataRange().getDisplayValues();

  const getCol = (name) => headers.indexOf(name);
  const trackCol = getCol("InternshipTrack");
  const modeCol = getCol("InternshipMode");
  const schedCol = getCol("ScheduleMode");
  const emailCol = getCol("GmailID");
  const phoneCol = getCol("MobileNumber");
  const collegeCol = getCol("CollegeName");
  const regNoCol = getCol("RegisterNumber");
  const staffIdCol = getCol("FacultyStaffId");
  const genderCol = getCol("Gender");
  const candTypeCol = getCol("CandidateType");
  const internTypeCol = getCol("InternshipType");
  const deptCol = getCol("Department");
  const passCol = getCol("facultyPassYear");
  const domCol = getCol("facultyDomain");
  const expCol = getCol("TeachingExperience");
  const desigCol = getCol("Designation");
  const remCol = getCol("Remarks");
  const yrCol = getCol("Year");

  const repairedRows = [];

  for (let r = 1; r < data.length; r++) {
    const disp = dispData[r];
    const row = [...data[r]];
    let modified = false;

    const rId = String(disp[1] || '').trim();
    const fName = String(disp[3] || '').trim().toUpperCase();
    const remarks = remCol !== -1 ? String(disp[remCol] || '').trim() : '';
    const parsed = parseFacultyRemarks_(remarks);

    // 1. CandidateType & InternshipType
    if (candTypeCol !== -1 && String(row[candTypeCol] || '').trim() !== 'Faculty') {
      row[candTypeCol] = 'Faculty';
      modified = true;
    }
    if (internTypeCol !== -1 && String(row[internTypeCol] || '').trim() !== 'Faculty') {
      row[internTypeCol] = 'Faculty';
      modified = true;
    }

    // 2. InternshipTrack, InternshipMode, ScheduleMode
    const curTrack = trackCol !== -1 ? String(disp[trackCol] || '').trim() : '';
    const curMode = modeCol !== -1 ? String(disp[modeCol] || '').trim() : '';
    const curSched = schedCol !== -1 ? String(disp[schedCol] || '').trim() : '';

    if (curTrack.includes('@') || /^\d{7,12}$/.test(curMode) || /college|engineering|technology|university/i.test(curSched) || !curTrack || curTrack === '--') {
      if (trackCol !== -1) {
        row[trackCol] = 'Hardware (IoT & Embedded Systems)';
        modified = true;
      }
      if (modeCol !== -1) {
        row[modeCol] = 'Offline';
        modified = true;
      }
      if (schedCol !== -1) {
        row[schedCol] = 'standard';
        modified = true;
      }
    }

    // 3. RegisterNumber & FacultyStaffId (Must both hold Staff ID)
    let resolvedStaffId = '';
    if (fName.includes('VIJAYAVARMAN')) resolvedStaffId = 'FAC-VIJAY-01';
    else if (fName.includes('PRAVEENA')) resolvedStaffId = '51131';
    else if (fName.includes('MANIMEGALAI')) resolvedStaffId = '300581';
    else if (fName.includes('ARUL')) resolvedStaffId = '300573';
    else if (fName.includes('RAMYA')) resolvedStaffId = '300579';
    else if (fName.includes('SUSANNA')) resolvedStaffId = '300576';
    else resolvedStaffId = parsed.staffId || (regNoCol !== -1 ? String(disp[regNoCol] || '').trim() : '');

    if (regNoCol !== -1 && resolvedStaffId && String(row[regNoCol] || '').trim() !== resolvedStaffId) {
      row[regNoCol] = resolvedStaffId;
      modified = true;
    }
    if (staffIdCol !== -1 && resolvedStaffId && String(row[staffIdCol] || '').trim() !== resolvedStaffId) {
      row[staffIdCol] = resolvedStaffId;
      modified = true;
    }

    // 4. Gender
    let resolvedGender = 'Female';
    if (fName.includes('VIJAYAVARMAN')) resolvedGender = 'Male';
    if (genderCol !== -1) {
      const curGen = String(disp[genderCol] || '').trim();
      if (curGen.length > 15 || /college|department|road|street/i.test(curGen) || !curGen) {
        row[genderCol] = resolvedGender;
        modified = true;
      }
    }

    // 5. Designation
    if (desigCol !== -1) {
      const curDes = String(disp[desigCol] || '').trim();
      if (!curDes || curDes === 'Assistant Professor' || curDes === '--') {
        row[desigCol] = parsed.designation || 'Faculty Member';
        modified = true;
      }
    }

    // 6. TeachingExperience
    if (expCol !== -1) {
      const curExp = String(disp[expCol] || '').trim();
      let expectedExp = '5 Years';
      if (fName.includes('MANIMEGALAI')) expectedExp = '12 Years';
      else if (fName.includes('RAMYA')) expectedExp = '9 Years';
      else if (fName.includes('ARUL')) expectedExp = '8 Years';
      else if (fName.includes('PRAVEENA')) expectedExp = '7 Years';
      else if (fName.includes('SUSANNA')) expectedExp = '3 Years';
      else if (fName.includes('VIJAYAVARMAN')) expectedExp = '8 Years';
      else if (parsed.exp) expectedExp = parsed.exp;

      if (!curExp || /academic\s*experience/i.test(curExp) || curExp === '--') {
        row[expCol] = expectedExp;
        modified = true;
      }
    }

    // 7. facultyDomain
    if (domCol !== -1) {
      const curDom = String(disp[domCol] || '').trim();
      if (!curDom || /^(male|female|other|--)$/i.test(curDom)) {
        row[domCol] = parsed.domain || 'Embedded Systems & IoT';
        modified = true;
      }
    }

    // 8. facultyPassYear
    if (passCol !== -1) {
      const curPass = String(disp[passCol] || '').trim();
      let expectedPass = '2021';
      if (fName.includes('MANIMEGALAI')) expectedPass = '2012';
      else if (fName.includes('RAMYA')) expectedPass = '2015';
      else if (fName.includes('ARUL')) expectedPass = '2016';
      else if (fName.includes('PRAVEENA')) expectedPass = '2017';
      else if (fName.includes('SUSANNA')) expectedPass = '2021';
      else if (fName.includes('VIJAYAVARMAN')) expectedPass = '2016';
      else if (yrCol !== -1 && /^\d{4}$/.test(String(disp[yrCol] || '').trim())) expectedPass = String(disp[yrCol]).trim();
      else if (parsed.passout) expectedPass = parsed.passout;

      if (!curPass || /^(faculty|student|employee|apprentice|--)$/i.test(curPass)) {
        row[passCol] = expectedPass;
        modified = true;
      }
    }

    if (modified) {
      facSh.getRange(r + 1, 1, 1, row.length).setValues([row]);
      repairedRows.push({
        row: r + 1,
        regId: rId,
        name: fName,
        staffId: resolvedStaffId,
        gender: row[genderCol],
        track: row[trackCol],
        mode: row[modeCol],
        schedule: row[schedCol],
        email: row[emailCol],
        phone: row[phoneCol],
        college: row[collegeCol],
        designation: row[desigCol],
        experience: row[expCol],
        domain: row[domCol],
        passYear: row[passCol]
      });
    }
  }

  SpreadsheetApp.flush();
  if (typeof executionCache !== 'undefined' && executionCache.delete) {
    executionCache.delete(facSheetName);
  }

  return {
    status: 'success',
    repairedCount: repairedRows.length,
    repairedRows: repairedRows
  };
}


/**
 * Returns public intake statuses for Student, Faculty, and Apprentice registration.
 */
/**
 * Returns public intake statuses for Student, Faculty, and Apprentice registration.
 * Supports manual toggle ON/OFF, 24/7 mode (when ON and no dates set), and scheduled Start/End dates.
 */
function getPublicRegistrationSettings() {
  try {
    const sRes = getAppSettings();
    const s = (sRes && sRes.status === 'success') ? sRes.settings : (sRes || {});
    const swRes = getAllSwitchStatuses();
    const sw = (swRes && swRes.status === 'success') ? swRes.data : {};

    const isValOn = (v, defaultVal = true) => {
      if (v === undefined || v === null || String(v).trim() === '') return defaultVal;
      if (typeof v === 'boolean') return v;
      const str = String(v).trim().toUpperCase();
      return str === 'ON' || str === 'TRUE' || str === '1' || str === 'AUTO' || str === 'OPEN' || str === 'ENABLED';
    };

    // 1. Student Intake Evaluation
    const swStudent = sw['settingRegStudentOpen'] !== undefined ? isValOn(sw['settingRegStudentOpen']) : null;
    const appStudent = s['REGISTRATION_STUDENT_STATUS'] !== undefined ? isValOn(s['REGISTRATION_STUDENT_STATUS']) : null;
    let studentSwitch = true;
    if (swStudent !== null && appStudent !== null) {
      studentSwitch = swStudent && appStudent;
    } else if (swStudent !== null) {
      studentSwitch = swStudent;
    } else if (appStudent !== null) {
      studentSwitch = appStudent;
    }
    const studentStart = s['REGISTRATION_STUDENT_START_DATE'] || '';
    const studentEnd = s['REGISTRATION_STUDENT_END_DATE'] || s['REGISTRATION_STUDENT_NEXT_DATE'] || '';
    const studentNotice = s['REGISTRATION_STUDENT_NOTICE'] || '';
    const studentEval = evaluateIntakeWindow_(studentSwitch, studentStart, studentEnd, studentNotice, 'Pursuing Student');

    // 2. Faculty Intake Evaluation
    const swFaculty = sw['settingRegFacultyOpen'] !== undefined ? isValOn(sw['settingRegFacultyOpen']) : null;
    const appFaculty = s['REGISTRATION_FACULTY_STATUS'] !== undefined ? isValOn(s['REGISTRATION_FACULTY_STATUS']) : null;
    let facultySwitch = true;
    if (swFaculty !== null && appFaculty !== null) {
      facultySwitch = swFaculty && appFaculty;
    } else if (swFaculty !== null) {
      facultySwitch = swFaculty;
    } else if (appFaculty !== null) {
      facultySwitch = appFaculty;
    }
    const facultyStart = s['REGISTRATION_FACULTY_START_DATE'] || '';
    const facultyEnd = s['REGISTRATION_FACULTY_END_DATE'] || s['REGISTRATION_FACULTY_NEXT_DATE'] || '';
    const facultyNotice = s['REGISTRATION_FACULTY_NOTICE'] || '';
    const facultyEval = evaluateIntakeWindow_(facultySwitch, facultyStart, facultyEnd, facultyNotice, 'College Faculty & Academic Staff');

    // 2b. Corporate Employee Intake Evaluation (Independent Controls)
    const swEmployee = sw['settingRegEmployeeOpen'] !== undefined ? isValOn(sw['settingRegEmployeeOpen']) : (sw['settingRegFacultyOpen'] !== undefined ? isValOn(sw['settingRegFacultyOpen']) : null);
    const appEmployee = s['REGISTRATION_EMPLOYEE_STATUS'] !== undefined ? isValOn(s['REGISTRATION_EMPLOYEE_STATUS']) : (s['REGISTRATION_FACULTY_STATUS'] !== undefined ? isValOn(s['REGISTRATION_FACULTY_STATUS']) : null);
    let employeeSwitch = true;
    if (swEmployee !== null && appEmployee !== null) {
      employeeSwitch = swEmployee && appEmployee;
    } else if (swEmployee !== null) {
      employeeSwitch = swEmployee;
    } else if (appEmployee !== null) {
      employeeSwitch = appEmployee;
    }
    const employeeStart = s['REGISTRATION_EMPLOYEE_START_DATE'] || s['REGISTRATION_FACULTY_START_DATE'] || '';
    const employeeEnd = s['REGISTRATION_EMPLOYEE_END_DATE'] || s['REGISTRATION_EMPLOYEE_NEXT_DATE'] || s['REGISTRATION_FACULTY_END_DATE'] || '';
    const employeeNotice = s['REGISTRATION_EMPLOYEE_NOTICE'] || s['REGISTRATION_FACULTY_NOTICE'] || '';
    const employeeEval = evaluateIntakeWindow_(employeeSwitch, employeeStart, employeeEnd, employeeNotice, 'Corporate Employee & Professional');

    // 3. Apprentice Intake Evaluation
    const swApprentice = sw['settingRegApprenticeOpen'] !== undefined ? isValOn(sw['settingRegApprenticeOpen'], false) : null;
    const appApprentice = s['REGISTRATION_APPRENTICE_STATUS'] !== undefined ? isValOn(s['REGISTRATION_APPRENTICE_STATUS'], false) : null;
    let apprenticeSwitch = false;
    if (swApprentice !== null && appApprentice !== null) {
      apprenticeSwitch = swApprentice && appApprentice;
    } else if (swApprentice !== null) {
      apprenticeSwitch = swApprentice;
    } else if (appApprentice !== null) {
      apprenticeSwitch = appApprentice;
    }
    const apprenticeStart = s['REGISTRATION_APPRENTICE_START_DATE'] || '';
    let apprenticeEnd = s['REGISTRATION_APPRENTICE_END_DATE'] || s['REGISTRATION_APPRENTICE_NEXT_DATE'] || '';
    const apprenticeDays = parseInt(s['REGISTRATION_APPRENTICE_DAYS'], 10) || 0;
    if (!s['REGISTRATION_APPRENTICE_END_DATE'] && apprenticeEnd && apprenticeDays > 0) {
      try {
        const pStart = parseStandardDate_(apprenticeEnd, false);
        if (pStart && !isNaN(pStart.getTime())) {
          apprenticeEnd = new Date(pStart.getTime() + apprenticeDays * 24 * 3600 * 1000).toISOString();
        }
      } catch(eApp) {}
    }
    const apprenticeNotice = s['REGISTRATION_APPRENTICE_NOTICE'] || '';
    const apprenticeEval = evaluateIntakeWindow_(apprenticeSwitch, apprenticeStart, apprenticeEnd, apprenticeNotice, 'Apprentice Trainee');

    return sanitizeForJson({
      status: 'success',
      // Student
      studentOpen: Boolean(studentEval.isOpen),
      studentMode: String(studentEval.mode || ''),
      studentNotice: String(studentEval.notice || ''),
      studentStartDate: String(studentStart || ''),
      studentEndDate: String(studentEnd || ''),
      studentRemainingSeconds: Number(studentEval.remainingSeconds || 0),
      studentTargetEpoch: Number(studentEval.targetEpoch || 0),
      studentTimerType: String(studentEval.timerType || ''),

      // Faculty
      facultyOpen: Boolean(facultyEval.isOpen),
      facultyMode: String(facultyEval.mode || ''),
      facultyNotice: String(facultyEval.notice || ''),
      facultyStartDate: String(facultyStart || ''),
      facultyEndDate: String(facultyEnd || ''),
      facultyRemainingSeconds: Number(facultyEval.remainingSeconds || 0),
      facultyTargetEpoch: Number(facultyEval.targetEpoch || 0),
      facultyTimerType: String(facultyEval.timerType || ''),

      // Corporate Employee (Independent Controls)
      employeeOpen: Boolean(employeeEval.isOpen),
      employeeMode: String(employeeEval.mode || ''),
      employeeNotice: String(employeeEval.notice || ''),
      employeeStartDate: String(employeeStart || ''),
      employeeEndDate: String(employeeEnd || ''),
      employeeRemainingSeconds: Number(employeeEval.remainingSeconds || 0),
      employeeTargetEpoch: Number(employeeEval.targetEpoch || 0),
      employeeTimerType: String(employeeEval.timerType || ''),

      // Official Company Contact Information
      companyName: 'GSV Electrical Enterprises',
      companyPhone: String(s['COMPANY_PHONE'] || '+91 9092610415'),
      companyAltPhone: String(s['COMPANY_ALT_PHONE'] || '+91 9092610415'),
      companyEmail: String(s['DEFAULT_ADMIN_EMAIL'] || 'gsveeip2026@gmail.com'),
      companyAddress: String(s['COMPANY_ADDRESS'] || 'GSV Electrical Enterprises, New No 51/1, Old No 20/1, Teeds Garden 1st Street, Sembiyam, Perambur, Chennai - 600011'),

      // Apprentice
      apprenticeOpen: Boolean(apprenticeEval.isOpen),
      apprenticeMode: String(apprenticeEval.mode || ''),
      apprenticeNotice: String(apprenticeEval.notice || ''),
      apprenticeStartDate: String(apprenticeStart || ''),
      apprenticeEndDate: String(apprenticeEnd || ''),
      apprenticeDays: Number(apprenticeDays || 0),
      apprenticeRemainingSeconds: Number(apprenticeEval.remainingSeconds || 0),
      apprenticeTargetEpoch: Number(apprenticeEval.targetEpoch || 0),
      apprenticeTimerType: String(apprenticeEval.timerType || ''),

      // Legacy compatibility
      apprenticeNextDate: String(apprenticeEnd || apprenticeStart || ''),
      timerRemainingSeconds: Number(apprenticeEval.remainingSeconds || 0),
      timerTargetEpoch: Number(apprenticeEval.targetEpoch || 0),
      timerType: String(apprenticeEval.timerType || '')
    });
  } catch(e) {
    Logger.log('Error in getPublicRegistrationSettings: ' + e);
    return {
      status: 'success',
      studentOpen: true,
      facultyOpen: true,
      employeeOpen: true,
      apprenticeOpen: false,
      studentMode: 'OPEN_24_7',
      facultyMode: 'OPEN_24_7',
      employeeMode: 'OPEN_24_7',
      apprenticeMode: 'CLOSED_MANUAL',
      studentNotice: '',
      facultyNotice: '',
      employeeNotice: '',
      apprenticeNotice: 'Apprentice registration is currently closed.',
      companyName: 'GSV Electrical Enterprises',
      companyPhone: '+91 9092610415',
      companyAltPhone: '+91 9092610415',
      companyEmail: 'gsveeip2026@gmail.com',
      companyAddress: 'GSV Electrical Enterprises, New No 51/1, Old No 20/1, Teeds Garden 1st Street, Sembiyam, Perambur, Chennai - 600011'
    };
  }
}

/**
 * Universal evaluator for registration intake windows.
 */
function evaluateIntakeWindow_(isManualOn, rawStart, rawEnd, customNotice, categoryLabel) {
  const now = Date.now();
  let startEpoch = 0;
  let endEpoch = 0;

  if (rawStart) {
    const ps = parseStandardDate_(rawStart, false);
    if (ps && !isNaN(ps.getTime())) startEpoch = ps.getTime();
  }
  if (rawEnd) {
    const pe = parseStandardDate_(rawEnd, true);
    if (pe && !isNaN(pe.getTime())) endEpoch = pe.getTime();
  }

  const defaultClosedNotice = categoryLabel + ' registration is currently closed. For inquiries or late admissions, please contact the administrator at gsveeip2026@gmail.com.';

  // If manual toggle is explicitly turned OFF:
  if (!isManualOn) {
    return {
      isOpen: false,
      mode: 'CLOSED_MANUAL',
      notice: customNotice || defaultClosedNotice,
      remainingSeconds: 0,
      targetEpoch: 0,
      timerType: ''
    };
  }

  // Manual toggle is ON:
  // Case A: No dates configured -> Always OPEN 24/7
  if (!startEpoch && !endEpoch) {
    return {
      isOpen: true,
      mode: 'OPEN_24_7',
      notice: 'Open 24/7',
      remainingSeconds: 0,
      targetEpoch: 0,
      timerType: ''
    };
  }

  // Case B: Start date is in the future -> NOT YET OPEN
  if (startEpoch && now < startEpoch) {
    const remSec = Math.max(0, Math.floor((startEpoch - now) / 1000));
    return {
      isOpen: false,
      mode: 'SCHEDULED_FUTURE',
      notice: categoryLabel + ' registration will open on ' + formatDateDisplay(new Date(startEpoch)) + '.',
      remainingSeconds: remSec,
      targetEpoch: startEpoch,
      timerType: 'OPENS_IN'
    };
  }

  // Case C: End date is set and has passed -> EXPIRED / CLOSED
  if (endEpoch && now > endEpoch) {
    return {
      isOpen: false,
      mode: 'EXPIRED_CLOSED',
      notice: customNotice || (categoryLabel + ' registration closed on ' + formatDateDisplay(new Date(endEpoch)) + '. Please contact administrator at gsveeip2026@gmail.com.'),
      remainingSeconds: 0,
      targetEpoch: endEpoch,
      timerType: ''
    };
  }

  // Case D: Currently within active window -> OPEN
  let windowNotice = 'Registration Open';
  let remSec = 0;
  if (endEpoch) {
    remSec = Math.max(0, Math.floor((endEpoch - now) / 1000));
    windowNotice = 'Registration Open (Closes on ' + formatDateDisplay(new Date(endEpoch)) + ')';
  }
  return {
    isOpen: true,
    mode: 'WINDOW_OPEN',
    notice: windowNotice,
    remainingSeconds: remSec,
    targetEpoch: endEpoch || 0,
    timerType: endEpoch ? 'CLOSES_IN' : ''
  };
}

function parseStandardDate_(dateInput, isEndOfDay) {
  if (!dateInput) return null;
  if (dateInput instanceof Date) {
    return isNaN(dateInput.getTime()) ? null : dateInput;
  }
  const s = String(dateInput).trim();
  if (!s || s === '--' || s === 'N/A' || s === 'null' || s === 'undefined') return null;

  // 1. ISO format YYYY-MM-DDTHH:mm or YYYY-MM-DD HH:mm or YYYY-MM-DD
  const isoMatch = s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})(?:[T\s](\d{1,2}):(\d{1,2})(?::(\d{1,2}))?)?/);
  if (isoMatch) {
    const yr = Number(isoMatch[1]);
    const mo = Number(isoMatch[2]) - 1;
    const da = Number(isoMatch[3]);
    let hr = isoMatch[4] !== undefined ? Number(isoMatch[4]) : (isEndOfDay ? 23 : 0);
    let mi = isoMatch[5] !== undefined ? Number(isoMatch[5]) : (isEndOfDay ? 59 : 0);
    let sc = isoMatch[6] !== undefined ? Number(isoMatch[6]) : (isEndOfDay ? 59 : 0);
    return new Date(yr, mo, da, hr, mi, sc);
  }

  // 2. Format DD/MM/YYYY or DD-MM-YYYY
  const dmyMatch = s.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})(?:[T\s](\d{1,2}):(\d{1,2})(?::(\d{1,2}))?)?/);
  if (dmyMatch) {
    const da = Number(dmyMatch[1]);
    const mo = Number(dmyMatch[2]) - 1;
    const yr = Number(dmyMatch[3]);
    let hr = dmyMatch[4] !== undefined ? Number(dmyMatch[4]) : (isEndOfDay ? 23 : 0);
    let mi = dmyMatch[5] !== undefined ? Number(dmyMatch[5]) : (isEndOfDay ? 59 : 0);
    let sc = dmyMatch[6] !== undefined ? Number(dmyMatch[6]) : (isEndOfDay ? 59 : 0);
    return new Date(yr, mo, da, hr, mi, sc);
  }

  const d = new Date(s);
  return isNaN(d.getTime()) ? null : d;
}



