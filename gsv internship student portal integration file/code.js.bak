              </tr>
            </table>
            <div style="margin-top: 12px; font-size: 12px; color: #64748b; background: #ffffff; border: 1px dashed #cbd5e1; border-radius: 6px; padding: 8px 10px;">
              <strong style="color:#d97706;">&#9888; Note:</strong> Your registered 10-digit mobile number functions as your primary password for Portal Login.
            </div>
          </div>

          <!-- Step Instructions -->
          <div style="background: #eff6ff; border-left: 4px solid #2563eb; padding: 14px 16px; border-radius: 0 8px 8px 0; margin-bottom: 24px; font-size: 12.5px; color: #1e40af; line-height: 1.55;">
            <strong>Portal Sign-In Instructions:</strong><br>
            1. Click the button below to navigate to the Portal Login page.<br>
            2. In the <strong>Portal Login (Student / Faculty / Apprentice)</strong> form, enter your Registration / Staff ID.<br>
            3. Enter your password (registered mobile number) and click <strong>Portal Login</strong>.<br>
            4. Access your Attendance Records, Daily Task Diary, Documents, and Progress Tracking.
          </div>

          <!-- Action Button -->
          <div style="text-align: center; margin-bottom: 24px;">
            <a href="` + loginPortalUrl + `" style="background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; padding: 13px 32px; text-decoration: none; border-radius: 8px; font-weight: 700; font-size: 13.5px; display: inline-block; box-shadow: 0 4px 12px rgba(37,99,235,0.25);">
              &rarr; Sign In to Portal Now
            </a>
          </div>

          <p style="font-size: 11.5px; color: #94a3b8; margin: 0; line-height: 1.5;">
            If you did not initiate this request or have questions, please reach out to the administrator at <a href="mailto:gsveeip2026@gmail.com" style="color: #2563eb; text-decoration: underline;">gsveeip2026@gmail.com</a>.
          </p>
        </div>

        <!-- Footer -->
        <div style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 14px 20px; text-align: center; font-size: 11px; color: #94a3b8;">
          &copy; ` + new Date().getFullYear() + ` GSV Electrical Enterprises. All rights reserved. &bull; Enterprise Internship Management System
        </div>
      </div>
    `;

    const sent = sendEmail(email, subject, "", htmlBody);

    // Mask email for privacy: a***b@domain.com
    let maskedEmail = email;
    try {
      const parts = email.split('@');
      if (parts[0].length > 3) {
        maskedEmail = parts[0].slice(0, 2) + '***' + parts[0].slice(-2) + '@' + parts[1];
      } else {
        maskedEmail = parts[0].slice(0, 1) + '***@' + parts[1];
      }
    } catch(mErr) {}

    if (sent) {
      logActivity('Account Recovery', regId, `Dispatched credentials to ` + email + ` (` + roleBadgeTitle + `)`);
      return {
        status: "success",
        candidateType: foundType,
        roleBadge: roleBadgeTitle,
        candidateName: candidateName,
        maskedEmail: maskedEmail,
        message: `Credentials sent successfully! Verified as ` + roleBadgeTitle + ` (` + candidateName + `). Login details dispatched to ` + maskedEmail + `.`
      };
    } else {
      return {
        status: "error",
        message: "Failed to dispatch email. Please verify mail service or contact administrator at gsveeip2026@gmail.com."
      };
    }

  } catch (e) {
    Logger.log("Error in recoverCandidateLoginDetails: " + e.message);
    return { status: "error", message: e.message };
  }
}

function recoverStudentLoginDetails(identifier) {
  return recoverCandidateLoginDetails(identifier);
}

function saveRegistrationIntakeSettings(settingsObj) {
  try {
    if (!settingsObj || typeof settingsObj !== 'object') {
      return { status: 'error', message: 'Invalid settings payload' };
    }
    return saveAppSettings(settingsObj);
  } catch(e) {
    return { status: 'error', message: e.message };
  }
}


