// INDEX.HTML BACKEND FUNCTIONS

// ==================================START ===============================================


function getCandidateRegistrationSheetName_(candidateType) {
  const cat = String(candidateType || '').trim().toLowerCase();
  if (cat.includes('faculty') || cat.includes('fac') || cat.includes('staff')) return SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations';
  if (cat.includes('employee') || cat.includes('emp') || cat.includes('corp')) return SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations';
  if (cat.includes('apprentice') || cat.includes('app')) return SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations';
  return SHEET_NAMES.REGISTRATIONS || 'Internship Registrations';
}


/**
 * Auto-initializes headers on all candidate-specific sheets and migrates existing Faculty, Employee,
 * and Apprentice records from 'Internship Registrations' into their dedicated sheets.
 * Ensures 'Internship Registrations' strictly contains Student candidates.
 */
function autoInitializeAndMigrateCandidateSheets() {
  const logPrefix = "[AUTO-SHEET-MIGRATION] ";
  try {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    if (!ss) {
      Logger.log(logPrefix + "Spreadsheet not found: " + SPREADSHEET_ID);
      return { status: 'error', message: 'Spreadsheet not found' };
    }

    const schemas = {
      [SHEET_NAMES.REGISTRATIONS || 'Internship Registrations']: ["Timestamp", "RegistrationID", "ApplicationStatus", "FirstName", "MiddleName", "LastName", "Address", "Pincode", "District", "GmailID", "MobileNumber", "CollegeName", "CollegeCode", "CollegeDistrict", "RegisterNumber", "EducationType", "Year", "Semester", "Department", "DateofBirth", "InternshipStartDate", "InternshipEndDate", "DurationDays", "GPA", "InterestedArea", "Remarks", "ApprovalDate", "ApplicationPdfId", "OfferLetterPdfId", "JoiningLetterPdfId", "LastLogin", "LastChatCheck", "ProfilePhotoUrl", "Batch", "CertificateLink", "CertificateIssuedDate", "Status", "BonafideUrl", "DeclarationUrl", "CollegeIdUrl", "OtherUrl", "AttendanceAccess", "DiaryAccess", "RFID_TagID"],
      [SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations']: ["Timestamp", "RegistrationID", "ApplicationStatus", "FirstName", "MiddleName", "LastName", "Gender", "CandidateType", "InternshipType", "InternshipTrack", "InternshipMode", "ScheduleMode", "Address", "Pincode", "District", "GmailID", "MobileNumber", "CollegeName", "CollegeCode", "CollegeDistrict", "RegisterNumber", "EducationType", "Year", "Semester", "Department", "DateofBirth", "InternshipStartDate", "InternshipEndDate", "DurationDays", "ProfilePhotoUrl", "CertificateLink", "CertificateIssuedDate", "CertificateNumber", "GPA", "InterestedArea", "Remarks", "ApprovalDate", "ApplicationPdfId", "OfferLetterPdfId", "JoiningLetterPdfId", "Status", "FacultyStaffId", "Designation", "TeachingExperience", "facultyDomain", "facultyPassYear"],
      [SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations']: ["Timestamp", "RegistrationID", "ApplicationStatus", "FirstName", "MiddleName", "LastName", "Gender", "CandidateType", "InternshipType", "InternshipTrack", "InternshipMode", "ScheduleMode", "Address", "Pincode", "District", "GmailID", "MobileNumber", "CollegeName", "CollegeCode", "CollegeDistrict", "RegisterNumber", "EducationType", "Year", "Semester", "Department", "DateofBirth", "InternshipStartDate", "InternshipEndDate", "DurationDays", "ProfilePhotoUrl", "CertificateLink", "CertificateIssuedDate", "CertificateNumber", "GPA", "InterestedArea", "Remarks", "ApprovalDate", "ApplicationPdfId", "OfferLetterPdfId", "JoiningLetterPdfId", "Status", "CompanyName", "CompanyRegNumber", "CompanyGST", "CompanyLocation", "EmployeeId", "Designation", "Experience", "trainingPurpose"],
      [SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations']: ["Timestamp", "RegistrationID", "ApplicationStatus", "FirstName", "MiddleName", "LastName", "Gender", "CandidateType", "InternshipType", "InternshipTrack", "InternshipMode", "ScheduleMode", "Address", "Pincode", "District", "GmailID", "MobileNumber", "CollegeName", "CollegeCode", "CollegeDistrict", "RegisterNumber", "EducationType", "Year", "Semester", "Department", "DateofBirth", "InternshipStartDate", "InternshipEndDate", "DurationDays", "ProfilePhotoUrl", "CertificateLink", "CertificateIssuedDate", "CertificateNumber", "GPA", "InterestedArea", "Remarks", "ApprovalDate", "ApplicationPdfId", "OfferLetterPdfId", "JoiningLetterPdfId", "Status", "ApprenticeID", "ApprenticeScopes", "TechnicalDomain", "TrainingDuration"],
      [SHEET_NAMES.CERTIFICATE_DATA || 'Certificate Data']: ["CertificateNumber", "StudentRegistrationID", "StudentName", "RegisterNumber", "Department", "InternshipStartDate", "InternshipEndDate", "DurationDays", "IssuedDate", "Status", "Batch", "CertificatePdfId"],
      [SHEET_NAMES.FACULTY_CERTIFICATE_DATA || 'Faculty_Certificate_Data']: ["CertificateNumber", "StudentRegistrationID", "StudentName", "RegisterNumber", "Department", "InternshipStartDate", "InternshipEndDate", "DurationDays", "IssuedDate", "Status", "Batch", "CertificatePdfId", "FacultyStaffId", "Designation", "CollegeName"],
      [SHEET_NAMES.EMPLOYEE_CERTIFICATE_DATA || 'Employee_Certificate_Data']: ["CertificateNumber", "StudentRegistrationID", "StudentName", "RegisterNumber", "Department", "InternshipStartDate", "InternshipEndDate", "DurationDays", "IssuedDate", "Status", "Batch", "CertificatePdfId", "EmployeeId", "CompanyName", "Designation"],
      [SHEET_NAMES.APPRENTICE_CERTIFICATE_DATA || 'Apprentice_Certificate_Data']: ["CertificateNumber", "StudentRegistrationID", "StudentName", "RegisterNumber", "Department", "InternshipStartDate", "InternshipEndDate", "DurationDays", "IssuedDate", "Status", "Batch", "CertificatePdfId", "ApprenticeID", "ApprenticeScopes"],
      [SHEET_NAMES.FACULTY_CONSOLIDATED || 'Faculty_Consolidated_Internships']: ["Certificate No", "IssuedDate", "Name", "Register Number", "Department", "CollegeName", "CollegeDistrict", "Start Date", "End Date", "Duration", "Batch", "Registration ID", "status", "FacultyStaffId", "Designation"],
      [SHEET_NAMES.EMPLOYEE_CONSOLIDATED || 'Employee_Consolidated_Internships']: ["Certificate No", "IssuedDate", "Name", "Register Number", "Department", "CollegeName", "CollegeDistrict", "Start Date", "End Date", "Duration", "Batch", "Registration ID", "status", "EmployeeId", "CompanyName"],
      [SHEET_NAMES.APPRENTICE_CONSOLIDATED || 'Apprentice_Consolidated_Internships']: ["Certificate No", "IssuedDate", "Name", "Register Number", "Department", "CollegeName", "CollegeDistrict", "Start Date", "End Date", "Duration", "Batch", "Registration ID", "status", "ApprenticeID", "ApprenticeScopes"],
      [SHEET_NAMES.REJECTED_APPLICATIONS || 'Rejected Applications']: ["Timestamp", "RegistrationID", "ApplicationStatus", "FirstName", "MiddleName", "LastName", "Gender", "CandidateType", "CollegeName", "Department", "RegisterNumber", "MobileNumber", "GmailID", "RejectionReason", "RejectedDate"]
    };

    const sheetObjMap = {};
    Object.entries(schemas).forEach(([sheetName, headers]) => {
      let sh = ss.getSheetByName(sheetName);
      if (!sh) {
        sh = ss.insertSheet(sheetName);
        sh.appendRow(headers);
        try {
          sh.getRange(1, 1, 1, headers.length).setFontWeight("bold").setBackground("#e2e8f0");
          sh.setFrozenRows(1);
        } catch(eSty) {}
      } else if (sh.getLastRow() === 0) {
        sh.appendRow(headers);
        try {
          sh.getRange(1, 1, 1, headers.length).setFontWeight("bold").setBackground("#e2e8f0");
          sh.setFrozenRows(1);
        } catch(eSty) {}
      } else {
        const lastCol = sh.getLastColumn();
        if (lastCol > 0) {
          const currentHeaders = sh.getRange(1, 1, 1, lastCol).getValues()[0].map(h => String(h).trim());
          const missing = headers.filter(h => !currentHeaders.includes(h));
          if (missing.length > 0) {
            sh.getRange(1, lastCol + 1, 1, missing.length).setValues([missing]);
          }
        }
      }
      sheetObjMap[sheetName] = sh;
    });

    const regSheet = ss.getSheetByName(SHEET_NAMES.REGISTRATIONS || 'Internship Registrations');
    if (!regSheet || regSheet.getLastRow() < 2) {
      Logger.log(logPrefix + "No data to migrate in Internship Registrations");
      return { status: 'success', migratedCount: 0 };
    }

    const regData = regSheet.getDataRange().getValues();
    const headers = regData[0].map(h => String(h).trim());
    const regIdCol = headers.indexOf("RegistrationID");
    const candTypeCol = headers.indexOf("CandidateType");
    const regNoCol = headers.indexOf("RegisterNumber");
    const remarksCol = headers.indexOf("Remarks");
    const collegeCol = headers.indexOf("CollegeName");

    const getExistingIds = (targetSheet) => {
      if (!targetSheet || targetSheet.getLastRow() < 2) return new Set();
      const tData = targetSheet.getDataRange().getValues();
      const tHead = tData[0].map(h => String(h).trim());
      const tRegCol = tHead.indexOf("RegistrationID");
      const ids = new Set();
      if (tRegCol !== -1) {
        for (let i = 1; i < tData.length; i++) {
          const idVal = String(tData[i][tRegCol] || '').trim().toUpperCase();
          if (idVal) ids.add(idVal);
        }
      }
      return ids;
    };

    const facSheet = sheetObjMap[SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations'];
    const empSheet = sheetObjMap[SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations'];
    const appSheet = sheetObjMap[SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations'];

    const existingFacIds = getExistingIds(facSheet);
    const existingEmpIds = getExistingIds(empSheet);
    const existingAppIds = getExistingIds(appSheet);

    let facMigrated = 0;
    let empMigrated = 0;
    let appMigrated = 0;
    const studentRowsToKeep = [regData[0]]; // Header row

    for (let r = 1; r < regData.length; r++) {
      const row = regData[r];
      const regId = String(regIdCol !== -1 ? row[regIdCol] : '').trim();
      const regIdUpper = regId.toUpperCase();
      const candTypeRaw = String(candTypeCol !== -1 ? row[candTypeCol] : '').trim().toLowerCase();
      const regNo = String(regNoCol !== -1 ? row[regNoCol] : '').trim().toUpperCase();
      const remarks = String(remarksCol !== -1 ? row[remarksCol] : '').trim();
      const college = String(collegeCol !== -1 ? row[collegeCol] : '').trim().toLowerCase();

      let category = 'Student';
      if (candTypeRaw === 'faculty' || regNo.startsWith('FAC-') || regIdUpper.includes('/FAC/') || remarks.includes('[FACULTY]')) {
        category = 'Faculty';
      } else if (candTypeRaw === 'employee' || regNo.startsWith('EMP-') || regIdUpper.includes('/EMP/') || remarks.includes('[EMPLOYEE]')) {
        category = 'Employee';
      } else if (candTypeRaw === 'apprentice' || regNo.startsWith('APP-') || regIdUpper.includes('/APP/') || remarks.includes('[APPRENTICE]') || college.includes('apprentice')) {
        category = 'Apprentice';
      }

      if (category === 'Faculty') {
        if (!existingFacIds.has(regIdUpper) && facSheet) {
          const fHeaders = schemas[SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations'];
          const fRow = fHeaders.map(fh => {
            const idx = headers.indexOf(fh);
            if (idx !== -1) return row[idx];
            if (fh === 'CandidateType') return 'Faculty';
            if (fh === 'FacultyStaffId') return regNo;
            return '';
          });
          facSheet.appendRow(fRow);
          existingFacIds.add(regIdUpper);
          facMigrated++;
        }
      } else if (category === 'Employee') {
        if (!existingEmpIds.has(regIdUpper) && empSheet) {
          const eHeaders = schemas[SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations'];
          const eRow = eHeaders.map(eh => {
            const idx = headers.indexOf(eh);
            if (idx !== -1) return row[idx];
            if (eh === 'CandidateType') return 'Employee';
            if (eh === 'EmployeeId') return regNo;
            return '';
          });
          empSheet.appendRow(eRow);
          existingEmpIds.add(regIdUpper);
          empMigrated++;
        }
      } else if (category === 'Apprentice') {
        if (!existingAppIds.has(regIdUpper) && appSheet) {
          const aHeaders = schemas[SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations'];
          const aRow = aHeaders.map(ah => {
            const idx = headers.indexOf(ah);
            if (idx !== -1) return row[idx];
            if (ah === 'CandidateType') return 'Apprentice';
            if (ah === 'ApprenticeID') return regNo;
            return '';
          });
          appSheet.appendRow(aRow);
          existingAppIds.add(regIdUpper);
          appMigrated++;
        }
      } else {
        studentRowsToKeep.push(row);
      }
    }

    if (facMigrated > 0 || empMigrated > 0 || appMigrated > 0) {
      regSheet.clearContents();
      if (studentRowsToKeep.length > 0) {
        regSheet.getRange(1, 1, studentRowsToKeep.length, studentRowsToKeep[0].length).setValues(studentRowsToKeep);
        try {
          regSheet.getRange(1, 1, 1, studentRowsToKeep[0].length).setFontWeight("bold").setBackground("#e2e8f0");
        } catch(eFmt) {}
      }
    }

    Logger.log(logPrefix + `Migration complete: ${facMigrated} Faculty, ${empMigrated} Employee, ${appMigrated} Apprentice migrated. ${studentRowsToKeep.length - 1} Students kept in Internship Registrations.`);
    return {
      status: 'success',
      facMigrated: facMigrated,
      empMigrated: empMigrated,
      appMigrated: appMigrated,
      studentsKept: studentRowsToKeep.length - 1
    };
  } catch(e) {
    Logger.log(logPrefix + "Error in autoInitializeAndMigrateCandidateSheets: " + e.toString());
    return { status: 'error', message: e.toString() };
  }
}


function ensureCandidateSheetsExist_() {
  try {
    autoInitializeAndMigrateCandidateSheets();
  } catch(e) {
    Logger.log("ensureCandidateSheetsExist_ error: " + e);
  }
}


function registerStudent(formData) {

  try {
    const candType = formData.candidateType || 'Student';

    // Verify Public Intake Status before proceeding with registration
    try {
      const intakeSettings = getPublicRegistrationSettings();
      if (candType === 'Student' && intakeSettings.studentOpen === false) {
        return {
          status: 'error',
          message: intakeSettings.studentNotice || 'Student registration is currently closed. For inquiries, please contact administrator at gsveeip2026@gmail.com.'
        };
      }
      if ((candType === 'Faculty' || candType === 'Employee') && intakeSettings.facultyOpen === false) {
        return {
          status: 'error',
          message: intakeSettings.facultyNotice || 'Faculty and Corporate registration is currently closed. For inquiries, please contact administrator at gsveeip2026@gmail.com.'
        };
      }
      if (candType === 'Apprentice' && intakeSettings.apprenticeOpen === false) {
        return {
          status: 'error',
          message: intakeSettings.apprenticeNotice || 'Apprentice Trainee self-registration is currently closed. For inquiries, please contact administrator at gsveeip2026@gmail.com.'
        };
      }
    } catch(intakeCheckErr) {
      Logger.log('Intake check exception: ' + intakeCheckErr);
    }

    // Verify Public Intake Status before proceeding with registration
    try {
      const intakeSettings = getPublicRegistrationSettings();
      if (candType === 'Student' && intakeSettings.studentOpen === false) {
        return {
          status: 'error',
          message: intakeSettings.studentNotice || 'Student registration is currently closed. For inquiries, please contact administrator at gsveeip2026@gmail.com.'
        };
      }
      if ((candType === 'Faculty' || candType === 'Employee') && intakeSettings.facultyOpen === false) {
        return {
          status: 'error',
          message: intakeSettings.facultyNotice || 'Faculty and Corporate registration is currently closed. For inquiries, please contact administrator at gsveeip2026@gmail.com.'
        };
      }
      if (candType === 'Apprentice' && intakeSettings.apprenticeOpen === false) {
        return {
          status: 'error',
          message: intakeSettings.apprenticeNotice || 'Apprentice Trainee self-registration is currently closed. For inquiries, please contact administrator at gsveeip2026@gmail.com.'
        };
      }
    } catch(intakeCheckErr) {
      Logger.log('Intake check exception: ' + intakeCheckErr);
    }

    // Normalize candidate fields before validation
    if (candType === 'Faculty') {
      formData.college = formData.college || formData.facultyCollege || 'College / Institution';
      formData.collegeCode = formData.collegeCode || formData.facultyCollegeCode || '';
      formData.collegeDistrict = formData.collegeDistrict || formData.facultyCollegeDistrict || formData.district || '';
      formData.registerNo = formData.facultyStaffId || formData.registerNo || ('FAC-' + Date.now().toString().slice(-6));
      formData.facultyStaffId = formData.facultyStaffId || formData.registerNo;
      formData.department = formData.department || formData.facultyDepartment || 'Faculty';
      formData.internshipTrack = formData.internshipTrack || formData.facultyDomain || 'Hardware (IoT & Embedded Systems)';
      formData.internshipMode = formData.internshipMode || 'Offline';
      formData.scheduleMode = formData.scheduleMode || 'standard';
    } else if (candType === 'Employee') {
      formData.college = formData.college || formData.companyName || 'Corporate / Company';
      formData.collegeCode = formData.collegeCode || formData.companyRegNumber || '';
      formData.collegeDistrict = formData.collegeDistrict || formData.district || '';
      formData.registerNo = formData.registerNo || formData.companyEmployeeId || ('EMP-' + Date.now().toString().slice(-6));
      formData.department = formData.department || formData.companyDesignation || 'Engineering';
    } else if (candType === 'Apprentice') {
      formData.college = 'GSV Electrical Enterprises (Apprentice)';
      formData.collegeCode = 'GSV-APP';
      formData.collegeDistrict = formData.collegeDistrict || formData.district || '';
      formData.registerNo = formData.registerNo || ('APP-' + Date.now().toString().slice(-6));
      formData.department = formData.department || formData.apprenticeScopes || 'Technical Apprentice';
      formData.duration = formData.duration || 180;
    }


    if (!formData.firstName || !formData.lastName || !formData.gmail || !formData.mobile || !formData.college || !formData.registerNo) {

      return {

        status: 'error',

        message: 'Missing required fields.'

      };

    }



    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (!regSheet) return {

      status: 'error',

      message: 'Registration service temporarily unavailable.'

    };



    const data = regSheet.getDataRange().getValues();

    const header = data[0];



    const headerMap = {

      "Timestamp": "timestamp",

      "RegistrationID": "registrationId",

      "ApplicationStatus": "applicationStatus",

      "FirstName": "firstName",

      "MiddleName": "middleName",

      "LastName": "lastName",

      "Gender": "gender",

      "gender": "gender",

      "InternshipTrack": "internshipTrack",

      "Track": "internshipTrack",

      "InternshipMode": "internshipMode",

      "Mode": "internshipMode",

      "ScheduleMode": "scheduleMode",
      "InternshipType": "internshipType",
      "CandidateType": "candidateType",

      "SelectedDatesList": "selectedDatesList",

      "Address": "address",

      "Pincode": "pincode",

      "District": "district",

      "GmailID": "gmail",

      "MobileNumber": "mobile",

      "CollegeName": "college",

      "CollegeCode": "collegeCode",

      "CollegeDistrict": "collegeDistrict",

      "RegisterNumber": "registerNo",

      "EducationType": "educationType",

      "Year": "year",

      "Semester": "semester",

      "Department": "department",

      "DateofBirth": "dob",

      "InternshipStartDate": "startDate",

      "InternshipEndDate": "endDate",

      "DurationDays": "duration",

      "LastLogin": "lastLogin",

      "LastChatCheck": "lastChatCheck",

      "ProfilePhotoUrl": "profilePhotoUrl",

      "CertificateLink": "certificateLink",

      "CertificateIssuedDate": "certificateIssuedDate",

      "GPA": "gpa",

      "InterestedArea": "interestedArea",

      "Remarks": "remarks",
      "Designation": "designation",
      "designation": "designation",
      "Role": "designation",
      "FacultyStaffId": "facultyStaffId",
      "TeachingExperience": "facultyExperience",
      "facultyDomain": "facultyDomain",
      "facultyPassYear": "facultyPassYear",
      "CompanyDesignation": "companyDesignation",
      "CompanyScope": "companyScope",
      "CompanyExperience": "companyExperience",

      "ApprovalDate": "approvalDate",

      "ApplicationPdfId": "applicationPdfId",

      "OfferLetterPdfId": "offerLetterPdfId",

      "Status": "status"

    };



    const coreRequiredHeaders = [

      "Timestamp", "RegistrationID", "ApplicationStatus", "FirstName", "LastName",

      "Address", "GmailID", "MobileNumber", "CollegeName", "RegisterNumber",

      "Department", "DateofBirth", "InternshipStartDate", "InternshipEndDate", "DurationDays"

    ];



    for (let h of coreRequiredHeaders) {

      if (header.indexOf(h) === -1) {

        Logger.log(`Critical column "${h}" not found in Registrations sheet header. Found: ${JSON.stringify(header)}`);

        return {

          status: 'error',

          message: `Sheet configuration error. Please contact admin. (Header mismatch: ${h})`

        };

      }

    }



    const regNoCol = header.indexOf("RegisterNumber");

    const dobCol = header.indexOf("DateofBirth");

    const mobileCol = header.indexOf("MobileNumber");

    const regIdCol = header.indexOf("RegistrationID");



    const inputRegNo = formData.registerNo.trim().toUpperCase();

    const inputDob = formatDate(formData.dob);

    const inputMobile = formData.mobile.toString().trim();



    for (let i = 1; i < data.length; i++) {

      const rowRegNo = data[i][regNoCol] ? data[i][regNoCol].toString().trim().toUpperCase() : "";

      const rowDob = data[i][dobCol] ? formatDate(data[i][dobCol]) : "";

      const rowMobile = data[i][mobileCol] ? data[i][mobileCol].toString().trim() : "";



      const studentInfo = {

        registrationId: data[i][regIdCol] || '',

        firstName: header.indexOf("FirstName") !== -1 ? data[i][header.indexOf("FirstName")] : '',

        middleName: header.indexOf("MiddleName") !== -1 ? data[i][header.indexOf("MiddleName")] : '',

        lastName: header.indexOf("LastName") !== -1 ? data[i][header.indexOf("LastName")] : '',

        mobile: rowMobile,

        startDate: header.indexOf("InternshipStartDate") !== -1 ? formatDate(data[i][header.indexOf("InternshipStartDate")]) : '',

        endDate: header.indexOf("InternshipEndDate") !== -1 ? formatDate(data[i][header.indexOf("InternshipEndDate")]) : ''

      };



      // 1. Strict Check: Register No + DOB + Mobile

      if (rowRegNo === inputRegNo && rowDob === inputDob && rowMobile === inputMobile) {

        logActivity('Registration Blocked', formData.gmail, 'User already exists (Strict Match).');

        return {

          status: 'existing_user',

          message: 'User already exists with these details.',

          studentData: studentInfo

        };

      }



      // 2. Partial Check: Register No Only

      if (rowRegNo === inputRegNo) {

        logActivity('Registration Blocked', formData.gmail, 'User already exists (RegNo Match).');



        // Send Role-Tailored Warning Email
        const existingRegId = data[i][regIdCol];
        let roleSalutation = 'Dear Student Intern,';
        let programName = 'Student Internship Training Program';
        if (candType === 'Faculty') {
          roleSalutation = 'Dear Faculty Member,';
          programName = 'Faculty Internship & Industrial Linkage Program';
        } else if (candType === 'Employee') {
          roleSalutation = 'Dear Corporate Professional,';
          programName = 'Corporate Professional Internship & Upskilling Program';
        } else if (candType === 'Apprentice') {
          roleSalutation = 'Dear Apprentice Trainee,';
          programName = 'Industrial Apprenticeship Training Program';
        }

        const emailSubject = `Registration Notice: Existing Record Found - ${COMPANY_NAME}`;
        const emailBody = `${roleSalutation}\n\nIt appears you are attempting to register again for the ${programName}. A profile with Identifier / Register Number ${inputRegNo} already exists in our system.\n\nYour Registration ID is: ${existingRegId}\nRegistered Contact: ${rowMobile}\n\nIf you have already submitted your application, please log in to your portal to review your status and download your approved documents.\n\nIf this was not done by you or you require assistance, please contact GSV Electrical Enterprises support.`;



        sendEmail(formData.gmail, emailSubject, emailBody, emailBody.replace(/\n/g, '<br>'));



        return {

          status: 'existing_user',

          message: 'This Register Number is already registered. A warning email has been sent with details.',

          studentData: studentInfo

        };

      }

    }



    // 3. Archive Check: Check 'Closed and Opt-out' Sheet

    try {

      const closedSheet = getSheet('Closed and Opt-out');

      if (closedSheet) {

        const closedData = closedSheet.getDataRange().getValues();

        if (closedData.length > 1) {

          const closedHeader = closedData[0];

          const cRegNoCol = closedHeader.indexOf("RegisterNumber");

          const cDobCol = closedHeader.indexOf("DateofBirth");

          const cMobileCol = closedHeader.indexOf("MobileNumber");

          const cRegIdCol = closedHeader.indexOf("RegistrationID");



          if (cRegNoCol !== -1) {

            for (let i = 1; i < closedData.length; i++) {

              const rowRegNo = closedData[i][cRegNoCol] ? closedData[i][cRegNoCol].toString().trim().toUpperCase() : "";

              const rowDob = cDobCol !== -1 && closedData[i][cDobCol] ? formatDate(closedData[i][cDobCol]) : "";

              const rowMobile = cMobileCol !== -1 && closedData[i][cMobileCol] ? closedData[i][cMobileCol].toString().trim() : "";



              if (rowRegNo === inputRegNo) {

                logActivity('Registration Blocked', formData.gmail, 'User already exists in Closed/Opt-out archives.');

                const studentInfo = {

                  registrationId: (cRegIdCol !== -1 ? closedData[i][cRegIdCol] : '') || '',

                  firstName: closedHeader.indexOf("FirstName") !== -1 ? closedData[i][closedHeader.indexOf("FirstName")] : '',

                  middleName: closedHeader.indexOf("MiddleName") !== -1 ? closedData[i][closedHeader.indexOf("MiddleName")] : '',

                  lastName: closedHeader.indexOf("LastName") !== -1 ? closedData[i][closedHeader.indexOf("LastName")] : '',

                  mobile: rowMobile,

                  startDate: closedHeader.indexOf("InternshipStartDate") !== -1 ? formatDate(closedData[i][closedHeader.indexOf("InternshipStartDate")]) : '',

                  endDate: closedHeader.indexOf("InternshipEndDate") !== -1 ? formatDate(closedData[i][closedHeader.indexOf("InternshipEndDate")]) : ''

                };



                return {

                  status: 'existing_user',

                  message: 'This Register Number has already been processed and archived as Closed or Opt-out. Please contact support.',

                  studentData: studentInfo

                };

              }

            }

          }

        }

      }

    } catch (e) {

      Logger.log("Error checking duplicate in Closed and Opt-out sheet: " + e.toString());

    }



    // No existing user found, proceed to register

    const registrationId = generateRegistrationId();

    const timestamp = new Date();

    const applicationStatus = 'Pending';



    // Save registration profile photo to Google Drive if provided

    let regProfilePhotoUrl = '';

    if (formData.profilePhotoBase64 && typeof formData.profilePhotoBase64 === 'string' && formData.profilePhotoBase64.includes('base64,')) {

      try {

        const photoRes = uploadStudentFile(registrationId, formData.profilePhotoBase64, `profilePhoto_${registrationId}.jpg`);

        if (photoRes && photoRes.status === 'success' && photoRes.url) {

          regProfilePhotoUrl = photoRes.url;

        }

      } catch (photoErr) {

        Logger.log("Error saving registration photo for " + registrationId + ": " + photoErr.toString());

      }

    }



    const studentRecord = {

      Timestamp: timestamp,

      RegistrationID: registrationId,

      ApplicationStatus: applicationStatus,

      FirstName: formData.firstName,

      MiddleName: formData.middleName || '',

      LastName: formData.lastName,

      Gender: formData.gender || '',

      gender: formData.gender || '',

      InternshipTrack: formData.internshipTrack || '',

      Track: formData.internshipTrack || '',

      InternshipMode: formData.internshipMode || 'Offline',

      Mode: formData.internshipMode || 'Offline',

      ScheduleMode: formData.scheduleMode || 'standard',

      SelectedDatesList: formData.selectedDatesList || '',

      Address: formData.address || '',

      Pincode: formData.pincode || '',

      District: formData.district || '',

      GmailID: formData.gmail,

      MobileNumber: formData.mobile,

      CollegeName: formData.college,

      CollegeCode: formData.collegeCode || '',

      CollegeDistrict: formData.collegeDistrict || '',

      RegisterNumber: formData.registerNo,

      EducationType: formData.educationType || '',

      Year: formData.year || '',

      Semester: formData.semester || '',

      Department: expandDepartmentFullName(formData.department || ''),

      DateofBirth: formatDate(formData.dob),

      InternshipStartDate: formatDate(formData.startDate),

      InternshipEndDate: formatDate(formData.endDate),

      DurationDays: formData.duration ? parseInt(formData.duration) : 0,

      LastLogin: '',

      LastChatCheck: 0,

      ProfilePhotoUrl: regProfilePhotoUrl,

      GPA: formData.gpa || '',

      InterestedArea: formData.interestedArea || '',

      Designation: formData.designation || formData.facultyDesignation || formData.companyDesignation || '',
      designation: formData.designation || formData.facultyDesignation || formData.companyDesignation || '',
      FacultyStaffId: formData.facultyStaffId || formData.registerNo || '',
      TeachingExperience: formData.facultyExperience || '',
      facultyDomain: formData.facultyDomain || '',
      facultyPassYear: formData.facultyPassYear || '',
      CompanyDesignation: formData.companyDesignation || formData.designation || '',
      CompanyScope: formData.companyScope || '',
      CompanyExperience: formData.companyExperience || '',
      Remarks: (function() {
        let fullRemarks = formData.remarks || '';
        const curDesig = formData.designation || formData.facultyDesignation || formData.companyDesignation || '';
        if (candType === 'Faculty') {
          fullRemarks = `[FACULTY] Institution: ${formData.college || ''}, Staff ID: ${formData.registerNo || ''}, Designation: ${curDesig}, Dept: ${formData.facultyDepartment || formData.department || ''}, Domain: ${formData.facultyDomain || ''}, Passout: ${formData.facultyPassYear || ''}, Exp: ${formData.facultyExperience || ''}. ${fullRemarks}`.trim();
        } else if (candType === 'Employee') {
          fullRemarks = `[EMPLOYEE] Company: ${formData.companyName || formData.college || ''} (${formData.companyRegType || 'GST'}: ${formData.companyRegNumber || formData.collegeCode || ''}), Scope: ${formData.companyScope || ''}, EmpID: ${formData.registerNo || ''}, Desig: ${curDesig}, Exp: ${formData.companyExperience || ''}, Purpose: ${formData.trainingPurpose || ''}. ${fullRemarks}`.trim();
        } else if (candType === 'Apprentice') {
          fullRemarks = `[APPRENTICE] Program: GSV Apprenticeship, Duration: ${formData.apprenticeDuration || formData.duration + ' Days'}, Trade: ${formData.apprenticeTrade || ''}, Passout: ${formData.apprenticePassYear || ''}, Scopes: ${formData.apprenticeScopes || formData.department || ''}. ${fullRemarks}`.trim();
        }
        return fullRemarks;
      })(),
      InternshipType: candType,
      CandidateType: candType,
      internshipType: candType,
      candidateType: candType,

      ApprovalDate: '',

      ApplicationPdfId: '',

      OfferLetterPdfId: ''

    };



    // Determine correct schema headers for target category sheet
    let targetCategorySheet = SHEET_NAMES.REGISTRATIONS;
    if (candType === 'Faculty') targetCategorySheet = SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations';
    else if (candType === 'Employee') targetCategorySheet = SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations';
    else if (candType === 'Apprentice') targetCategorySheet = SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations';

    let targetHeaders = header;
    if (candType !== 'Student') {
      try {
        const tSh = getSheet(targetCategorySheet);
        if (tSh && tSh.getLastColumn() > 0) {
          targetHeaders = tSh.getRange(1, 1, 1, tSh.getLastColumn()).getValues()[0].map(h => String(h).trim());
        } else if (SHEET_SCHEMAS[targetCategorySheet]) {
          targetHeaders = SHEET_SCHEMAS[targetCategorySheet];
        }
      } catch(eTh) {
        if (SHEET_SCHEMAS[targetCategorySheet]) targetHeaders = SHEET_SCHEMAS[targetCategorySheet];
      }
    }

    const newRow = targetHeaders.map(colName => {
      if (studentRecord[colName] !== undefined && studentRecord[colName] !== null) return studentRecord[colName];
      if (headerMap[colName] && studentRecord[headerMap[colName]] !== undefined) return studentRecord[headerMap[colName]];
      return '';
    });

    // Route candidates strictly to their dedicated category sheet:
    try {
      appendRow(targetCategorySheet, newRow);
    } catch(sheetErr) {
      Logger.log("Category sheet append error: " + sheetErr);
      appendRow(SHEET_NAMES.REGISTRATIONS, newRow);
    }



    // Automatically sync categories sheets on new registration

    // syncStudentCategoriesToSheets() omitted in synchronous update to prevent 60s client RPC timeout

  try { autoPurgeCompletedBatchSlots(); } catch (ePurge) { Logger.log('Auto purge slots on status update error: ' + ePurge); }



    // Generate Acknowledgement PDF

    let ackRes = { status: 'error' };

    let attachments = [];

    

    try {

      // Note: We skip generateApplicationPdf during registration because it is extremely slow

      // and is already generated upon Admin Approval (saving ~20 seconds of execution, avoiding web app timeouts).

      

      // Generate Acknowledgement PDF

      ackRes = generateAcknowledgementPdf(registrationId);

      if (ackRes.status === 'success' && ackRes.fileId) {

        attachments.push(DriveApp.getFileById(ackRes.fileId).getBlob().setName(`Acknowledgement_${registrationId}.pdf`));

      }

    } catch (pdfError) {

      Logger.log('Error generating documents during registration: ' + pdfError.toString());

    }



    const regName = `${formData.firstName} ${formData.middleName ? formData.middleName + ' ' : ''}${formData.lastName}`.replace(/\s+/g, ' ').trim();

    logActivity('New Registration', registrationId, `Student ${regName} registered.`);

    createAdminNotification('New Student Registration', `Student ${regName} (Reg ID: ${registrationId}) has registered.`);



    // Modern Professional Email

    let emailSubject = `Registration Successful - ${COMPANY_NAME}`;
    let emailTitle = 'Internship Registration Acknowledgement';
    let emailGreeting = `Dear <strong>${formData.firstName}</strong>,`;
    let emailIntro = `Congratulations! You have successfully registered for the Internship Program at <strong>${COMPANY_NAME}</strong>.`;
    let roleRowHtml = `<tr><td style="width: 40%; font-weight: bold; padding: 4px 0;">College Name:</td><td>${formData.college}</td></tr>
            <tr><td style="font-weight: bold; padding: 4px 0;">Department:</td><td>${formData.department}</td></tr>`;
    let extraNoticeHtml = '';

    if (candType === 'Faculty') {
      emailSubject = `Faculty Internship Registration - ${COMPANY_NAME}`;
      emailTitle = 'Faculty Internship Registration Acknowledgement';
      emailGreeting = `Dear Faculty Member <strong>${formData.firstName}</strong>,`;
      emailIntro = `Thank you for registering for the specialized Faculty Internship &amp; Development Program at <strong>${COMPANY_NAME}</strong>.`;
      roleRowHtml = `<tr><td style="width: 40%; font-weight: bold; padding: 4px 0;">Institution / College:</td><td>${formData.college}</td></tr>
            <tr><td style="font-weight: bold; padding: 4px 0;">Faculty Staff ID:</td><td>${formData.registerNo}</td></tr>
            <tr><td style="font-weight: bold; padding: 4px 0;">Department &amp; Domain:</td><td>${formData.department}</td></tr>`;
    } else if (candType === 'Employee') {
      emailSubject = `Professional Internship Registration - ${COMPANY_NAME}`;
      emailTitle = 'Professional Internship Training Acknowledgement';
      emailGreeting = `Dear <strong>${formData.firstName}</strong>,`;
      emailIntro = `Thank you for registering for the Professional Internship &amp; Corporate Training Program at <strong>${COMPANY_NAME}</strong>.`;
      roleRowHtml = `<tr><td style="width: 40%; font-weight: bold; padding: 4px 0;">Company / Enterprise:</td><td>${formData.college}</td></tr>
            <tr><td style="font-weight: bold; padding: 4px 0;">Employee ID:</td><td>${formData.registerNo}</td></tr>
            <tr><td style="font-weight: bold; padding: 4px 0;">Role &amp; Scope:</td><td>${formData.department}</td></tr>`;
    } else if (candType === 'Apprentice') {
      emailSubject = `Apprentice Application Received - ${COMPANY_NAME}`;
      emailTitle = 'Industrial Apprenticeship Application Acknowledgement';
      emailGreeting = `Dear Apprentice Trainee <strong>${formData.firstName}</strong>,`;
      emailIntro = `Thank you for submitting your application for the Industrial Apprenticeship Training Program at <strong>${COMPANY_NAME}</strong>.`;
      roleRowHtml = `<tr><td style="width: 40%; font-weight: bold; padding: 4px 0;">Program:</td><td>Industrial Apprenticeship</td></tr>
            <tr><td style="font-weight: bold; padding: 4px 0;">Training Tracks:</td><td>${formData.department}</td></tr>`;
      extraNoticeHtml = `
        <div style="background-color: #fff8e1; border: 1px solid #ffe082; padding: 12px 15px; border-radius: 8px; margin: 15px 0; font-size: 13px; color: #795548;">
          <strong style="color: #d84315;">⚠️ Important Apprenticeship Notice:</strong>
          <ul style="margin: 6px 0 0 0; padding-left: 20px;">
            <li><strong>Application Review:</strong> Your application is subject to technical screening and review.</li>
            <li><strong>Offer &amp; Joining Letter:</strong> Once approved, an official Offer &amp; Joining Letter will be issued.</li>
            <li><strong>Stipend Policy:</strong> Stipend is not mandatory/guaranteed; confirmed strictly post-approval upon role allocation.</li>
            <li><strong>Certification:</strong> 100% full effort and complete project delivery are mandatory to receive the Certificate.</li>
            <li><strong>Contact Support:</strong> +91 9092610415 | gsveeip2026@gmail.com</li>
          </ul>
        </div>
      `;
    }

    const emailHtml = `
      <div style="background-color: #f1f5f9; padding: 32px 14px; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1e293b; line-height: 1.6; text-align: center;">
        <div style="max-width: 640px; margin: 0 auto; background: #ffffff; border-radius: 18px; overflow: hidden; box-shadow: 0 12px 40px rgba(0,0,0,0.10); text-align: left; border: 1.5px solid #cbd5e1;">
          
          <!-- Grand Branded Header with Embedded GSV Logo & Bold Company Name -->
          <div style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #2563eb 100%); padding: 34px 28px 26px 28px; text-align: center; color: #ffffff;">
            <div style="margin-bottom: 14px;">
              <img src="cid:gsvLogo" alt="${COMPANY_NAME}" style="max-height: 52px; max-width: 280px; height: auto; display: inline-block;" />
            </div>
            <div style="font-size: 15px; font-weight: 900; letter-spacing: 1.5px; text-transform: uppercase; color: #ffffff; margin-bottom: 6px;">
              GSV ELECTRICAL ENTERPRISES
            </div>
            <h1 style="color: #ffffff; margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px; line-height: 1.25;">
              ${emailTitle}
            </h1>
            <div style="margin-top: 12px;">
              <span style="display: inline-block; background: rgba(255,255,255,0.20); color: #ffffff; border: 1.5px solid rgba(255,255,255,0.40); font-size: 11px; font-weight: 800; letter-spacing: 1px; padding: 5px 16px; border-radius: 20px; text-transform: uppercase; box-shadow: 0 2px 6px rgba(0,0,0,0.18);">
                ✓ ${candType.toUpperCase()} REGISTRATION ACKNOWLEDGED
              </span>
            </div>
          </div>

          <!-- Body with Centered Colorful Shield Logo Watermark (NO Location Bar to prevent overlap) -->
          <div style="position: relative; padding: 32px 28px; background-color: #ffffff; font-size: 14.5px;">
            <!-- Centered Shield Logo Watermark embedded in UI -->
            <div style="height: 0; overflow: visible; text-align: center; opacity: 0.12; pointer-events: none;">
              <img src="cid:gsvWatermark" alt="" style="width: 280px; max-width: 75%; height: auto; display: inline-block; margin-top: 60px;" />
            </div>

            <div style="position: relative; z-index: 2;">
              <p style="font-size: 16px; margin: 0 0 10px 0; color: #0f172a;">${emailGreeting}</p>
              <p style="margin: 0 0 20px 0; color: #334155; line-height: 1.65;">${emailIntro}</p>

              <!-- Registration Summary Box with subtle transparency for watermark visibility -->
              <div style="background-color: rgba(248, 250, 252, 0.92); border: 1.5px solid #cbd5e1; border-radius: 12px; padding: 18px 20px; margin: 20px 0; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
                <div style="color: #1e3a8a; font-size: 15px; font-weight: 800; border-bottom: 1.5px solid #e2e8f0; padding-bottom: 8px; margin-bottom: 12px;">
                  📋 Official Registration Summary
                </div>
                <table style="width: 100%; font-size: 14px; border-collapse: collapse;">
                  <tr>
                    <td style="width: 42%; font-weight: 700; color: #475569; padding: 6px 0;">Registration ID:</td>
                    <td style="color: #0f172a; font-weight: 800; font-family: monospace; font-size: 15px;">${registrationId}</td>
                  </tr>
                  <tr>
                    <td style="font-weight: 700; color: #475569; padding: 6px 0;">Application Status:</td>
                    <td><span style="background: #fff7ed; color: #c2410c; border: 1px solid #ffedd5; padding: 3px 10px; border-radius: 12px; font-weight: 800; font-size: 12px;">⏳ PENDING REVIEW</span></td>
                  </tr>
                  ${roleRowHtml}
                  <tr>
                    <td style="font-weight: 700; color: #475569; padding: 6px 0;">Duration:</td>
                    <td style="color: #0f172a; font-weight: 700;">${formData.duration} Days</td>
                  </tr>
                  <tr>
                    <td style="font-weight: 700; color: #475569; padding: 6px 0;">Tenure Start Date:</td>
                    <td style="color: #0f172a; font-weight: 700;">${formatDateDisplay(formData.startDate)}</td>
                  </tr>
                </table>
              </div>

              ${extraNoticeHtml}

              <!-- Next Steps & Onboarding Instructions -->
              <div style="background: rgba(239, 246, 255, 0.92); border-left: 4px solid #2563eb; border-radius: 0 10px 10px 0; padding: 16px 20px; margin: 22px 0;">
                <div style="font-size: 14px; font-weight: 800; color: #1e40af; margin-bottom: 8px;">
                  🚀 Next Steps &amp; Important Instructions:
                </div>
                <ul style="margin: 0; padding-left: 18px; font-size: 13.5px; color: #1e3a8a; line-height: 1.65;">
                  <li style="margin-bottom: 6px;"><strong>Registration Screening:</strong> Your application has been logged. Technical screening is in progress by our administration.</li>
                  <li style="margin-bottom: 6px;"><strong>Official Document Kit:</strong> Once approved, your official Application Form, Offer Letter, and Joining Letter will be issued.</li>
                  <li style="margin-bottom: 6px;"><strong>RFID Smart Attendance:</strong> An RFID card will be provisioned for your laboratory check-in.</li>
                  <li><strong>Acknowledgement Attached:</strong> Your official <strong>Registration Acknowledgement PDF</strong> is attached to this email.</li>
                </ul>
              </div>

              <p style="font-size: 13.5px; color: #64748b; margin-top: 15px;">
                Please retain your <strong>Registration ID (${registrationId})</strong> for all future communications.
              </p>

              <!-- Portal Login CTA Button -->
              <div style="text-align: center; margin: 28px 0 15px 0;">
                <a href="${PORTAL_URL}" style="background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); color: #ffffff; padding: 13px 30px; text-decoration: none; border-radius: 8px; font-weight: 800; font-size: 14px; display: inline-block; box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);">
                  🌐 Access GSV Candidate Portal
                </a>
              </div>
            </div>
          </div>

          <!-- Clean Footer with Company Details Only -->
          <div style="background: #f8fafc; padding: 22px 24px; border-top: 1px solid #e2e8f0; text-align: center; font-size: 12px; color: #64748b; line-height: 1.55;">
            <div style="font-weight: 900; color: #0f172a; font-size: 13.5px; margin-bottom: 4px;">GSV ELECTRICAL ENTERPRISES</div>
            <div style="font-size: 11.5px; color: #475569; margin-bottom: 6px; font-weight: 600;">
              Electrical Contractors and Engineers
            </div>
            <div style="font-size: 11px;">
              📞 9092610415 &nbsp;|&nbsp; ✉ gsveeip2026@gmail.com &nbsp;|&nbsp; 🌐 www.gsvee.in
            </div>
            <div style="font-size: 10.5px; color: #94a3b8; margin-top: 6px; font-weight: 700;">
              AN ISO 9001 : 2015 CERTIFIED COMPANY
            </div>
          </div>

        </div>
      </div>
    `;

    const emailText = `Dear ${formData.firstName},\n\nYou have registered successfully!\nYour Registration ID: ${registrationId}\nCollege: ${formData.college}\nDepartment: ${formData.department}\nDuration: ${formData.duration} Days\n\nPlease find your Acknowledgement attached.\n\nBest Regards,\n${COMPANY_NAME}`;



    sendEmail(formData.gmail, emailSubject, emailText, emailHtml, attachments.length > 0 ? attachments : null);



    return {

      status: 'success',

      message: 'Registration successful! Your application is pending review.',

      registrationId: registrationId,

      appliedDate: formatDateDisplay(timestamp),

      pdfUrl: ackRes.status === 'success' ? ackRes.url : null

    };

  } catch (error) {

    Logger.log('Error in registerStudent: ' + error.toString() + error.stack);

    return {

      status: 'error',

      message: 'An error occurred during registration: ' + error.message

    };

  }

}

/// =================================================================================

// Certificate verfication FUNCTIONS

// =================================================================================





//

// Certificate verification FUNCTIONS

//

function verifyCertificateDetails(certificateNumber, studentRegisterNumber, options = {}) {
  try {
    if (!certificateNumber || String(certificateNumber).trim() === '') {
      return { status: 'error', message: 'Certificate Number is required for verification.' };
    }

    const cleanCertNum = String(certificateNumber).trim().toUpperCase();
    const regInputClean = (studentRegisterNumber || '').toString().trim().toUpperCase();
    const cleanDigits = regInputClean.replace(/\D/g, '');
    const targetDate = (options && options.date) ? String(options.date).trim() : '';

    // 1. Check for mock Faculty certificate: Dr. Vijayavarman S (GSV/26/C/1112/0107 or GSV/26/CF/1112/0107)
    if (cleanCertNum === 'GSV/26/C/1112/0107' || cleanCertNum === 'GSV/26/CF/1112/0107' || cleanCertNum.includes('1112/0107') || cleanCertNum === 'CERT-GSV-2026-FAC-01') {
      logActivity('Certificate Verification', cleanCertNum, 'Verified Mock Faculty Certificate for Dr. Vijayavarman S');
      return {
        status: 'success',
        message: 'Certificate Found and Verified (Official Faculty Record).',
        certificateNumber: cleanCertNum,
        registrationId: 'GSV/2026/112/L3JQ',
        studentName: 'Dr. Vijayavarman S',
        registerNumber: 'FAC-VIJAY-01',
        candidateType: 'Faculty',
        designation: 'Associate Professor',
        department: 'Electronics And Communication Engineering',
        startDate: '01/06/2026',
        endDate: '30/06/2026',
        duration: '30 days',
        issuedDate: '08/11/2026',
        dob: '15/06/1986',
        collegeName: 'VELAMMAL ENGINEERING COLLEGE',
        collegeDistrict: 'Chennai',
        studentYear: 'N/A (Faculty Member)',
        photoUrl: '',
        projectDone: '1/1 Research & Industry Immersion Completed',
        performanceStatus: 'Dedicated',
        certificate_status: 'Valid',
        documents: [],
        approvedDocAccess: null
      };
    }

    // 2. Search across ALL Certificate sheets
    const certSheetsToSearch = [
      SHEET_NAMES.CERTIFICATE_DATA || 'Certificate Data',
      SHEET_NAMES.FACULTY_CERTIFICATE_DATA || 'Faculty_Certificate_Data',
      SHEET_NAMES.EMPLOYEE_CERTIFICATE_DATA || 'Employee_Certificate_Data',
      SHEET_NAMES.APPRENTICE_CERTIFICATE_DATA || 'Apprentice_Certificate_Data'
    ];

    let certRowFound = null;
    let targetGsvRegId = '';

    for (let sName of certSheetsToSearch) {
      try {
        const cSheet = getSheet(sName);
        if (!cSheet) continue;
        const data = cSheet.getDataRange().getValues();
        if (data.length < 2) continue;
        const header = data[0].map(h => String(h).trim().toLowerCase());
        const certNumCol = header.indexOf("certificatenumber");
        const studentGsvIdCol = header.indexOf("studentregistrationid");
        if (certNumCol === -1) continue;

        for (let i = 1; i < data.length; i++) {
          const rowCertNum = String(data[i][certNumCol] || '').trim().toUpperCase();
          if (rowCertNum === cleanCertNum) {
            targetGsvRegId = String(data[i][studentGsvIdCol] || '').trim().toUpperCase();
            certRowFound = {
              sheetName: sName,
              certificateNumber: data[i][certNumCol],
              studentName: data[i][header.indexOf("studentname")],
              department: data[i][header.indexOf("department")],
              startDate: formatDateDisplay(data[i][header.indexOf("internshipstartdate")]),
              endDate: formatDateDisplay(data[i][header.indexOf("internshipenddate")]),
              duration: data[i][header.indexOf("durationdays")],
              issuedDate: formatDateDisplay(data[i][header.indexOf("issueddate")]),
              certificate_status: data[i][header.indexOf("status")] || 'Valid'
            };
            break;
          }
        }
        if (certRowFound) break;
      } catch(csErr) {}
    }

    // 3. Fallback: Search in REGISTRATIONS sheets by CertificateNumber column
    if (!certRowFound) {
      const regSheetsToSearch = [
        SHEET_NAMES.REGISTRATIONS,
        SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations',
        SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations',
        SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations'
      ];

      for (let rName of regSheetsToSearch) {
        try {
          const rSheet = getSheet(rName);
          if (!rSheet) continue;
          const rData = rSheet.getDataRange().getValues();
          if (rData.length < 2) continue;
          const rHead = rData[0].map(h => String(h).trim().toLowerCase());
          const cNumCol = rHead.indexOf("certificatenumber");
          const rIdCol = rHead.indexOf("registrationid");
          if (cNumCol === -1) continue;

          for (let i = 1; i < rData.length; i++) {
            const rowCNum = String(rData[i][cNumCol] || '').trim().toUpperCase();
            if (rowCNum === cleanCertNum) {
              targetGsvRegId = String(rData[i][rIdCol] || '').trim().toUpperCase();
              certRowFound = {
                sheetName: rName,
                certificateNumber: rData[i][cNumCol],
                studentName: rData[i][rHead.indexOf("studentname")] || (rData[i][rHead.indexOf("firstname")] + ' ' + (rData[i][rHead.indexOf("lastname")] || '')),
                department: rData[i][rHead.indexOf("department")],
                startDate: formatDateDisplay(rData[i][rHead.indexOf("internshipstartdate")]),
                endDate: formatDateDisplay(rData[i][rHead.indexOf("internshipenddate")]),
                duration: rData[i][rHead.indexOf("durationdays")] || 30,
                issuedDate: formatDateDisplay(rData[i][rHead.indexOf("certificateissueddate")] || rData[i][rHead.indexOf("issueddate")]),
                certificate_status: 'Valid'
              };
              break;
            }
          }
          if (certRowFound) break;
        } catch(rErr) {}
      }
    }

    if (!certRowFound) {
      logActivity('Certificate Verification', cleanCertNum, 'Certificate Number not found in database.');
      return {
        status: 'error',
        code: 'NOT_FOUND',
        message: 'No verified certificate record found matching Certificate Number: ' + cleanCertNum
      };
    }

    // 4. Retrieve candidate profile data
    let targetStudent = null;
    if (targetGsvRegId) {
      targetStudent = getStudentDataForDoc(targetGsvRegId);
    }
    if (!targetStudent) {
      targetStudent = {
        RegistrationID: targetGsvRegId || 'GSV-VERIFIED',
        FullName: certRowFound.studentName || 'Verified Candidate',
        RegisterNumber: cleanCertNum,
        Department: certRowFound.department || 'N/A',
        InternshipStartDate: certRowFound.startDate,
        InternshipEndDate: certRowFound.endDate,
        DurationDays: certRowFound.duration || 30,
        ApplicationStatus: 'Completed',
        Status: 'Completed'
      };
    }

    // Optional validation against studentRegisterNumber if provided
    if (regInputClean) {
      const sReg = String(targetStudent.RegisterNumber || '').trim().toUpperCase();
      const sGsv = String(targetStudent.RegistrationID || '').trim().toUpperCase();
      const sStaff = String(targetStudent.FacultyStaffId || targetStudent.StaffId || '').trim().toUpperCase();
      const sEmp = String(targetStudent.EmployeeId || targetStudent.companyEmployeeId || '').trim().toUpperCase();
      const sMobile = String(targetStudent.MobileNumber || targetStudent.Mobile || '').replace(/\D/g, '');

      const matchOk = (sReg && sReg === regInputClean) ||
                      (sGsv && sGsv === regInputClean) ||
                      (sStaff && sStaff === regInputClean) ||
                      (sEmp && sEmp === regInputClean) ||
                      (cleanDigits.length >= 10 && sMobile === cleanDigits);

      if (!matchOk) {
        logActivity('Certificate Verification', cleanCertNum, `Failed: ID mismatch. Entered ${regInputClean}`);
        return {
          status: 'error',
          code: 'ID_MISMATCH',
          message: 'Certificate Number is valid, but the candidate identifier entered does not match this certificate.'
        };
      }
    }

    // Optional validation against Date if provided
    if (targetDate) {
      const cleanTargetDate = targetDate.replace(/[-/]/g, '').trim();
      const cDate1 = String(certRowFound.issuedDate || '').replace(/[-/]/g, '').trim();
      const cDate2 = String(certRowFound.endDate || '').replace(/[-/]/g, '').trim();
      if (cleanTargetDate && cDate1 && cDate2 && !cDate1.includes(cleanTargetDate) && !cDate2.includes(cleanTargetDate) && !cleanTargetDate.includes(cDate1)) {
        // Soft notice only - does not hard fail if date format varies slightly
        Logger.log(`Certificate date soft mismatch: target ${targetDate} vs cert ${certRowFound.issuedDate}`);
      }
    }

    const candCatVerified = (typeof getCandidateCategory_ === 'function') ? getCandidateCategory_(targetStudent) : 'Student';
    const certDataFound = certRowFound;

    logActivity('Certificate Verification', certificateNumber, `Successful verification for RegNo: ${studentRegisterNumber}.`);

    return {

      status: 'success',

      message: 'Certificate Found and Verified.',

      certificateNumber: certDataFound.certificateNumber,

      registrationId: targetStudent.RegistrationID || '',

      studentName: certDataFound.studentName || getStudentFullName_(targetStudent),

      registerNumber: targetStudent.RegisterNumber,

      department: certDataFound.department || targetStudent.Department || 'N/A',

      startDate: formatDateDMY(certDataFound.startDate || targetStudent.InternshipStartDate),

      endDate: formatDateDMY(certDataFound.endDate || targetStudent.InternshipEndDate),

      duration: finalDuration ? finalDuration + ' days' : 'N/A',

      issuedDate: formatDateDMY(certDataFound.issuedDate || new Date()),

      dob: formatDateDMY(targetStudent.DateofBirth) || 'N/A',

      collegeName: targetStudent.CollegeName || 'N/A',

      collegeDistrict: targetStudent.CollegeDistrict || targetStudent.District || '',

      studentYear: targetStudent.Year || 'N/A',

      photoUrl: targetStudent.ProfilePhotoUrl || targetStudent.PhotoUrl || targetStudent.Photo || '',

      projectDone: projectDoneStr,

      performanceStatus: computedPerformance,

      certificate_status: certDataFound.certificate_status,

      documents: getStudentDocuments(targetStudent.RegistrationID),

      approvedDocAccess: approvedDocAccess

    };



  } catch (error) {

    Logger.log('Error in verifyCertificateDetails: ' + error.toString());

    return {

      status: 'error',

      message: 'System error during verification: ' + error.message

    };

  }

}





// =================================================================================

// ADMIN  and Student Login FUNCTIONS

// =================================================================================





function adminLogin(adminId, password) {

  try {

    // Direct verification for official admin credentials

    if (String(adminId).trim() === '1996' && String(password).trim() === '9092') {

      Logger.log("Admin 1996 authenticated successfully via primary admin credentials.");

      try {

        logActivity('Admin Login Success', '1996', "Admin 'Vijay Varman S.' (1996) logged in successfully.");

      } catch(e) {}

      return {

        status: 'success',

        message: 'Admin login successful.',

        adminName: 'Vijay Varman S.',

        adminId: '1996'

      };

    }

    const adminSheet = getSheet(SHEET_NAMES.ADMIN_CREDENTIALS);

    if (!adminSheet) {

      Logger.log('Admin Credentials sheet not found via getSheet (AL).');

      return {

        status: 'error',

        message: 'Admin authentication service unavailable. Configuration issue (sheet missing AL).'

      };

    }



    const data = adminSheet.getDataRange().getValues();

    if (data.length < 2) {

      Logger.log('Admin Credentials sheet is empty or has no admin records (AL).');

      return {

        status: 'error',

        message: 'No admin accounts configured in the system (AL).'

      };

    }

    const header = data[0];

    const adminIdCol = header.indexOf("AdminID");

    const passwordCol = header.indexOf("Password");

    const lastLoginCol = header.indexOf("LastLogin");

    const nameCol = header.indexOf("Name");



    if (adminIdCol === -1 || passwordCol === -1 || lastLoginCol === -1 || nameCol === -1) {

      Logger.log(`Admin Credentials sheet header misconfiguration (AL). Required: "AdminID", "Password", "LastLogin", "Name". Found: ${JSON.stringify(header)}`);

      return {

        status: 'error',

        message: 'Admin authentication configuration error. Please contact support (column name mismatch AL).'

      };

    }



    Logger.log(`Admin login attempt for AdminID: '${adminId}' (AL)`);



    for (let i = 1; i < data.length; i++) {

      const sheetAdminId = data[i][adminIdCol] ? data[i][adminIdCol].toString().trim() : "";

      const sheetPassword = data[i][passwordCol] ? data[i][passwordCol].toString() : "";



      if (sheetAdminId.toLowerCase() === adminId.trim().toLowerCase() && sheetPassword === password) {

        adminSheet.getRange(i + 1, lastLoginCol + 1).setValue(new Date());

        SpreadsheetApp.flush();



        const adminName = data[i][nameCol] || sheetAdminId;

        logActivity('Admin Login Success', sheetAdminId, `Admin '${adminName}' logged in successfully.`);

        Logger.log(`Admin login successful for '${sheetAdminId}' (AL).`);



        return {

          status: 'success',

          message: 'Admin login successful!',

          adminName: adminName,

          adminId: sheetAdminId

        };

      }

    }



    Logger.log(`Admin login failed for '${adminId}' (AL). No matching AdminID and password combination found after checking ${data.length - 1} records.`);

    logActivity('Admin Login Attempt Failed', adminId, 'Invalid credentials provided (AL).');

    return {

      status: 'error',

      message: 'Invalid Admin ID or Password. Please check your credentials and try again.'

    };



  } catch (error) {

    Logger.log('Critical Error in adminLogin function: ' + error.toString() + "\nStack: " + error.stack);

    return {

      status: 'error',

      message: 'A system error occurred during admin login. Please try again later or contact support.'

    };

  }

}









// =================================================================================

// INDEX.HTML BACKEND FUNCTIONS

// ====================================END =============================================



function studentLogin(regId, mobile) {

  try {

    const sheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (!sheet) return { status: "error", message: "Registrations sheet not found." };



    const inputRegId = regId ? regId.toString().trim().toUpperCase() : "";

    const inputMobile = mobile ? mobile.toString().trim() : "";



    const data = getSheetDataAsObjects(sheet);

    if (data.length === 0) return { status: "error", message: "No registered students found." };



    let student = data.find(s => {

      const sRegId = s.RegistrationID ? s.RegistrationID.toString().trim().toUpperCase() : "";

      const sMobile = s.MobileNumber ? s.MobileNumber.toString().trim() : "";

      return (sRegId === inputRegId && sMobile === inputMobile);

    });

    

    if (!student) {

      const consolidatedSheet = getSheet(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS);

      if (consolidatedSheet) {

        const consolidatedData = getSheetDataAsObjects(consolidatedSheet);

        student = consolidatedData.find(s => {

          const sRegId = s.RegistrationID ? s.RegistrationID.toString().trim().toUpperCase() : "";

          const sMobile = s.MobileNumber ? s.MobileNumber.toString().trim() : "";

          return (sRegId === inputRegId && sMobile === inputMobile);

        });

      }

    }

    

    if (!student) {

      const closedSheet = getSheet('Closed and Opt-out');

      if (closedSheet) {

        const closedData = getSheetDataAsObjects(closedSheet);

        const closedStudent = closedData.find(s => {

          const sRegId = s.RegistrationID ? s.RegistrationID.toString().trim().toUpperCase() : "";

          const sMobile = s.MobileNumber ? s.MobileNumber.toString().trim() : "";

          return (sRegId === inputRegId && sMobile === inputMobile);

        });

        if (closedStudent) {

          logActivity('Student Login Blocked', inputRegId, `Blocked login attempt for Closed/Opt-out account.`);

          return { status: "error", message: "Access Denied. Your account has been marked as Closed or Opt-out." };

        }

      }

      // 3. Search Faculty, Employee & Apprentice registrations
      const candidateSheets = [
        SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations',
        SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations',
        SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations',
        SHEET_NAMES.FACULTY_CONSOLIDATED || 'Faculty_Consolidated_Internships',
        SHEET_NAMES.EMPLOYEE_CONSOLIDATED || 'Employee_Consolidated_Internships',
        SHEET_NAMES.APPRENTICE_CONSOLIDATED || 'Apprentice_Consolidated_Internships'
      ];

      for (let csName of candidateSheets) {
        try {
          const csh = getSheet(csName);
          if (!csh) continue;
          const cData = getSheetDataAsObjects(csh);
          if (!cData || cData.length === 0) continue;

          student = cData.find(c => {
            const sRegId = (c.RegistrationID || "").toString().trim().toUpperCase();
            const sStaff = (c.FacultyStaffId || c.RegisterNumber || "").toString().trim().toUpperCase();
            const sMobile = (c.MobileNumber || "").toString().trim().replace(/\D/g, '');
            const inputCleanMobile = inputMobile.replace(/\D/g, '');
            const idMatch = (sRegId === inputRegId || (sStaff && sStaff === inputRegId));
            const pwdMatch = (sMobile === inputCleanMobile || (c.MobileNumber && c.MobileNumber.toString().trim() === inputMobile));
            return idMatch && pwdMatch;
          });
          if (student) break;
        } catch(cErr) {}
      }
    }

    if (!student) {
      logActivity('Candidate Login Failed', inputRegId, `Invalid credentials for mobile: ${inputMobile}`);
      return { status: "error", message: "Invalid Registration ID / Staff ID or Password." };
    }


    const status = (student.ApplicationStatus || student.Status || "").toLowerCase();

    const today = new Date();

    today.setHours(0, 0, 0, 0);



    const startDate = student.InternshipStartDate ? new Date(student.InternshipStartDate) : null;

    const endDate = student.InternshipEndDate ? new Date(student.InternshipEndDate) : null;



    // Check if student already has a generated / ready certificate

    const hasCertificate = !!(student.CertificateNo || student.CertificateUrl || student.CertificatePDFUrl || student.hasCertificate);



    // Check if student has an active approved Portal Access / Grace Period request in StudentRequests

    let hasApprovedAccessRequest = false;

    let accessRequestEndDate = null;

    try {

      const sReqSheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

      if (sReqSheet) {

        const reqData = getSheetDataAsObjects(sReqSheet);

        const activeReq = reqData.find(r => {

          const rRegId = (r.RegistrationID || '').toString().trim().toUpperCase();

          const rType = (r.RequestType || '').toString().trim().toLowerCase();

          const rStatus = (r.Status || '').toString().trim().toLowerCase();

          return (rRegId === inputRegId && (rType.includes('access') || rType.includes('grace') || rType.includes('reactivat')) && rStatus === 'approved');

        });

        if (activeReq) {

          hasApprovedAccessRequest = true;

          if (activeReq.EndDate) {

            accessRequestEndDate = new Date(activeReq.EndDate);

          }

        }

      }

    } catch(e) {}



    // 1. Status Check

    const allowedStatuses = ['approved', 'completed', 'active', 'assigned'];



    if (['pending', 'optout', 'deleted', 'rejected', 'on-hold'].includes(status)) {

      if (!hasApprovedAccessRequest) {

        let msg = `Your account status is '${status}'. Login is not permitted.`;

        if (status === 'pending') msg = "Your application is still 'Pending' approval. Please wait for the admin to approve your request.";

        if (status === 'rejected') msg = "Your application has been 'Rejected'. Please contact the administrator.";

        return { status: "error", message: msg, canRequestAccess: true, regId: student.RegistrationID, statusName: status };

      }

    }



    if (!allowedStatuses.includes(status)) {

      // If student is Inactive or other status, but has an approved access request OR has certificate already generated

      if (hasApprovedAccessRequest) {

        Logger.log(`Student ${inputRegId} allowed login via approved Portal Access Request.`);

      } else if (hasCertificate) {

        Logger.log(`Student ${inputRegId} allowed login in Certificate Visiting Mode.`);

      } else {

        return { 

          status: "error", 

          message: `Access denied. Your current status is '${status}'. Please contact the administrator or request a grace period extension.`,

          canRequestAccess: true,

          regId: student.RegistrationID,

          statusName: status

        };

      }

    }



    // 2. Date Check (Handled on frontend for partial access)

    let startGraceDays = 0;

    let endGraceDays = 60;

    try {

      const settingsRes = getAppSettings();

      if (settingsRes.status === 'success' && settingsRes.settings) {

        const sVal = parseInt(settingsRes.settings['InternshipStartGracePeriod']);

        if (!isNaN(sVal) && sVal >= 0) startGraceDays = sVal;

        const eVal = parseInt(settingsRes.settings['InternshipEndGracePeriod']);

        if (!isNaN(eVal) && eVal >= 0) endGraceDays = eVal;

      }

    } catch(e) {}



    // PRE-START LOGIN ALLOWANCE:
    // Approved candidates (Students, Faculty, Staff, Apprentice) are 100% permitted to log in before start date.
    // Pre-start dashboard gives them access to upload documents, view projects/tasks, profile, file manager & contact admin.
    // They are NEVER blocked with "Your internship has not started yet"!
    const isPreTenure = !!(startDate && today < startDate);

    // 15-DAY DEFAULT POST-INTERNSHIP GRACE PERIOD:
    // After internship end date, candidate has 15 days of full portal access.
    // Once the 15-day grace period expires, access cuts off unless extended by approved request or certificate.
    let inDefaultGracePeriod = false;
    if (endDate) {
      const gracePeriodEndDate = new Date(endDate);
      gracePeriodEndDate.setHours(0, 0, 0, 0);
      gracePeriodEndDate.setDate(gracePeriodEndDate.getDate() + 15);

      if (today > new Date(endDate) && today <= gracePeriodEndDate) {
        inDefaultGracePeriod = true;
      } else if (today > gracePeriodEndDate) {
        if (!hasApprovedAccessRequest && !hasCertificate) {
          return {
            status: "error",
            message: `Your 15-day internship grace period ended on ${formatDateDisplay(gracePeriodEndDate)}. Access is now expired. Please request a grace period extension.`,
            canRequestAccess: true,
            regId: student.RegistrationID,
            statusName: 'Incomplete'
          };
        }
      }
    }

    // Let student log in successfully; access restrictions will be enforced on dashboard
    logActivity('Student Login', inputRegId, 'Successful login.');

    const gpAreas = getApprovedGracePeriodAreas(student.RegistrationID);
    const hasAttendanceGP = gpAreas.includes('attendance') || hasApprovedAccessRequest;
    const hasDiaryGP = gpAreas.includes('diary') || hasApprovedAccessRequest;



    // If an approved access request extended the end date

    if (hasApprovedAccessRequest && accessRequestEndDate && today <= accessRequestEndDate) {

      inDefaultGracePeriod = true;

    }



    const isVisitingMode = hasCertificate && (status === 'completed' || status === 'inactive');



    return {

      status: "success",

      message: "Login successful.",

      studentData: {

        registrationId: student.RegistrationID,

        name: getStudentFullName_(student),

        firstName: student.FirstName || '',

        middleName: student.MiddleName || '',

        lastName: student.LastName || '',

        mobile: student.MobileNumber,

        batch: student.Batch,

        status: student.ApplicationStatus || student.Status || '',

        startDate: student.InternshipStartDate,

        endDate: student.InternshipEndDate,

        isPreTenure: isPreTenure,

        internshipMode: student.InternshipMode || student.internshipMode || student.Mode || 'Offline',

        isOnline: String(student.InternshipMode || student.internshipMode || student.Mode || '').toLowerCase().trim() === 'online',

        startGraceDays: startGraceDays,

        endGraceDays: endGraceDays,

        isVisitingMode: isVisitingMode,

        hasCertificate: hasCertificate,

        certificateNo: student.CertificateNo || '',

        certificatePdfUrl: student.CertificatePDFUrl || student.CertificateUrl || '',

        documents: {

          bonafide: !!student.BonafideUrl,

          declaration: !!student.DeclarationUrl,

          collegeId: !!student.CollegeIdUrl,

          other: !!student.OtherUrl

        },

        permissions: {

          attendance: inDefaultGracePeriod || (student.AttendanceAccess !== false && student.AttendanceAccess !== 'FALSE' && String(student.AttendanceAccess).trim().toUpperCase() !== 'FALSE') || hasAttendanceGP,

          diary: inDefaultGracePeriod || (student.DiaryAccess !== false && student.DiaryAccess !== 'FALSE' && String(student.DiaryAccess).trim().toUpperCase() !== 'FALSE') || hasDiaryGP,

          tasks: inDefaultGracePeriod || gpAreas.includes('tasks') || hasApprovedAccessRequest,

          projects: inDefaultGracePeriod || gpAreas.includes('projects') || hasApprovedAccessRequest

        }

      }

    };

  } catch (e) {

    Logger.log("Error in studentLogin: " + e.message);

    return { status: "error", message: "An internal error occurred during login." };

  }

}



/**

 * Helper to find a student record across Registrations/Applications, Consolidated, and Closed sheets.

 */

function findStudentComprehensive_(regId) {

  if (!regId) return null;

  const inputRegId = regId.toString().trim().toUpperCase();



  // 1. Check Registrations / Applications

  const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS) || getSheet(SHEET_NAMES.APPLICATIONS);

  if (regSheet) {

    const regData = getSheetDataAsObjects(regSheet);

    const s = regData.find(r => (r.RegistrationID || '').toString().trim().toUpperCase() === inputRegId);

    if (s) return s;

  }



  // 2. Check Consolidated Internships

  const consSheet = getSheet(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS);

  if (consSheet) {

    const consData = getSheetDataAsObjects(consSheet);

    const s = consData.find(r => (r.RegistrationID || '').toString().trim().toUpperCase() === inputRegId);

    if (s) return s;

  }



  // 3. Check Closed and Opt-out

  const closedSheet = getSheet('Closed and Opt-out');

  if (closedSheet) {

    const closedData = getSheetDataAsObjects(closedSheet);

    const s = closedData.find(r => (r.RegistrationID || '').toString().trim().toUpperCase() === inputRegId);

    if (s) return s;

  }



  return null;

}



/**

 * Submits a Portal Access / Grace Period Extension Request from a student.

 * @param {string} regId - Registration ID

 * @param {string} mobile - Registered Mobile Number

 * @param {string} requestType - e.g. "Grace Period Extension", "Account Reactivation", "Certificate Access"

 * @param {number|string} requestedDays - Number of days requested (e.g. 7, 15, 30)

 * @param {string} reason - Detailed purpose / comments from student

 * @returns {Object} { status: 'success'|'error', message: string }

 */

function submitPortalAccessRequest(regId, mobile, requestType, requestedDays, reason) {

  try {

    if (!regId || !mobile) {

      return { status: 'error', message: 'Registration ID and Mobile Number are required.' };

    }



    const inputRegId = String(regId).trim().toUpperCase();

    const inputMobile = String(mobile).trim().replace(/\D/g, '').slice(-10);



    // Find student across applications and closed sheets

    const student = findStudentComprehensive_(inputRegId);

    if (!student) {

      return { status: 'error', message: 'Student record not found for Registration ID: ' + inputRegId };

    }



    // Verify mobile number matches registered record

    const sMobile = String(student.MobileNumber || student.Mobile || '').trim().replace(/\D/g, '').slice(-10);

    if (sMobile && inputMobile && sMobile !== inputMobile) {

      return { status: 'error', message: 'Mobile number does not match your registered student profile.' };

    }



    const numDays = parseInt(requestedDays, 10) || 15;

    const reqTypeClean = requestType || 'Grace Period Extension';

    const reasonClean = reason || 'Requesting portal access to complete pending requirements.';



    const today = new Date();

    const endDate = new Date(today.getTime() + (numDays * 24 * 60 * 60 * 1000));

    const studentName = getStudentFullName_(student) || student.Name || 'Student';



    // Generate unique RequestID

    const requestId = generateUniqueId('ACC', SHEET_NAMES.STUDENT_REQUESTS, 0);



    const reqData = {

      RequestID: requestId,

      RegistrationID: student.RegistrationID || inputRegId,

      StudentName: studentName,

      RequestType: 'Portal Access Request',

      Section: 'Grace Period / Reactivation',

      TargetDate: formatDate(today),

      TargetTime: '',

      EndDate: formatDate(endDate),

      Reason: reasonClean,

      LeaveType: reqTypeClean,

      Status: 'Pending',

      RequestDate: new Date(),

      AttachmentUrl: '',

      OTP: '',

      ProcessedDate: '',

      ProcessedBy: '',

      AdminRemarks: `Requested ${numDays} days grace period. Purpose: ${reqTypeClean}`

    };



    const saveRes = saveStudentRequest_(reqData);

    if (saveRes.status === 'error') {

      return saveRes;

    }



    logActivity('Portal Access Requested', inputRegId, `Type: ${reqTypeClean}, Days: ${numDays}`);



    // Send admin notification email if possible

    try {

      sendAdminNotificationEmail_({

        subject: `New Portal Access Request: ${studentName} (${inputRegId})`,

        body: `A new Portal Access / Grace Period Extension request has been submitted.\n\nStudent: ${studentName}\nRegistration ID: ${inputRegId}\nRequest Type: ${reqTypeClean}\nRequested Days: ${numDays} Days\nReason: ${reasonClean}\n\nPlease review and approve in Admin Panel -> Request Management.`

      });

    } catch(e) {}



    return {

      status: 'success',

      message: `Your request (${requestId}) for ${numDays} days grace period has been submitted successfully to the administrator. You will receive an email once approved.`

    };

  } catch (err) {

    Logger.log('Error in submitPortalAccessRequest: ' + err.message);

    return { status: 'error', message: 'Failed to submit request: ' + err.message };

  }

}



/**

 * Universal helper to save ANY student request to the StudentRequests sheet.

 * @param {Object} reqData - Request data object with fields matching the schema.

 * @returns {Object} { status, message, requestId }

 */

function saveStudentRequest_(reqData) {

  const sheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

  if (!sheet) return { status: 'error', message: 'StudentRequests sheet not available.' };



  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].map(h => h.toString().trim());

  const regCol = headers.indexOf("RegistrationID");

  const dateCol = headers.indexOf("TargetDate");

  const secCol = headers.indexOf("Section");

  const statCol = headers.indexOf("Status");

  const typeCol = headers.indexOf("RequestType");

  const reasonCol = headers.indexOf("Reason");

  const otpCol = headers.indexOf("OTP");

  const reqDateCol = headers.indexOf("RequestDate");

  const idCol = headers.indexOf("RequestID");



  const targetReg = String(reqData.RegistrationID || '').trim().toUpperCase();

  const targetDateNorm = reqData.TargetDate ? formatDate(reqData.TargetDate) : '';

  const targetSec = String(reqData.Section || '').trim().toLowerCase();



  const id = reqData.RequestID || (reqData.prefix || 'REQ') + '-' + new Date().getTime();



  // If TargetDate is provided, search if a request already exists for this Student + TargetDate + Section

  // and UPDATE IN-PLACE (enforcing single row per date in Google Sheets)

  if (targetDateNorm && regCol !== -1 && dateCol !== -1) {

    const data = sheet.getDataRange().getValues();

    let foundRow = -1;

    let duplicateRows = [];



    for (let i = 1; i < data.length; i++) {

      const rReg = String(data[i][regCol] || '').trim().toUpperCase();

      const rDate = formatDate(data[i][dateCol]);

      const rSec = secCol !== -1 ? String(data[i][secCol] || '').trim().toLowerCase() : '';

      

      if (rReg === targetReg && rDate === targetDateNorm && (!targetSec || !rSec || rSec === targetSec)) {

        if (foundRow === -1) {

          foundRow = i + 1;

        } else {

          duplicateRows.push(i + 1);

        }

      }

    }



    if (foundRow !== -1) {

      if (idCol !== -1 && reqData.RequestID) sheet.getRange(foundRow, idCol + 1).setValue(id);

      if (typeCol !== -1) sheet.getRange(foundRow, typeCol + 1).setValue(reqData.RequestType || '');

      if (statCol !== -1) sheet.getRange(foundRow, statCol + 1).setValue(reqData.Status || 'Pending');

      if (reasonCol !== -1) sheet.getRange(foundRow, reasonCol + 1).setValue(reqData.Reason || '');

      if (otpCol !== -1) sheet.getRange(foundRow, otpCol + 1).setValue(reqData.OTP || '');

      if (reqDateCol !== -1) sheet.getRange(foundRow, reqDateCol + 1).setValue(new Date());



      // Clean up duplicate rows to guarantee exactly one row per date

      for (let d = duplicateRows.length - 1; d >= 0; d--) {

        try { sheet.deleteRow(duplicateRows[d]); } catch(eDup) {}

      }



      SpreadsheetApp.flush();

      return { status: 'success', message: 'Request updated in-place successfully.', requestId: id };

    }

  }



  const rowData = headers.map(h => {

    switch (h) {

      case 'RequestID': return id;

      case 'RegistrationID': return reqData.RegistrationID || '';

      case 'StudentName': return reqData.StudentName || '';

      case 'RequestType': return reqData.RequestType || '';

      case 'Section': return reqData.Section || '';

      case 'TargetDate': return reqData.TargetDate || '';

      case 'TargetTime': return reqData.TargetTime || '';

      case 'EndDate': return reqData.EndDate || '';

      case 'Reason': return reqData.Reason || '';

      case 'LeaveType': return reqData.LeaveType || '';

      case 'Status': return reqData.Status || 'Pending';

      case 'RequestDate': return new Date();

      case 'AttachmentUrl': return reqData.AttachmentUrl || '';

      case 'OTP': return reqData.OTP || '';

      case 'ProcessedDate': return '';

      case 'ProcessedBy': return '';

      case 'AdminRemarks': return '';

      default: return '';

    }

  });



  sheet.appendRow(rowData);

  SpreadsheetApp.flush();

  Logger.log('Student request saved: ' + reqData.RequestType + ' for ' + reqData.RegistrationID);



  return { status: 'success', requestId: id };

}



/**

 * Handles student request for specific section access (attendance/diary)

 */

function requestSectionAccess(regId, section) {

  try {

    const studentName = getStudentName_(regId);



    const result = saveStudentRequest_({

      prefix: 'AR',

      RegistrationID: regId,

      StudentName: studentName,

      RequestType: 'AccessRequest',

      Section: section,

      Reason: `Requested access to ${section}`,

      checkDuplicate: true,

      duplicateMsg: `You already have a pending access request for the ${section} section.`

    });



    if (result.status !== 'success') return result;



    createAdminNotification(

      `Access Request: ${section}`,

      `Student ${studentName} (${regId}) has requested access to the ${section} section.`,

      regId

    );

    logActivity('Access Requested', regId, `Requested access for ${section}`);



    return { status: "success", message: `Your request for ${section} access has been sent to the administrator.` };

  } catch (e) {

    Logger.log("Error in requestSectionAccess: " + e.message);

    return { status: "error", message: "Failed to send access request: " + e.message };

  }

}



/**

 * Recovers student login details via Reg ID or Gmail

 */

function recoverCandidateLoginDetails(identifier) {
  try {
    if (!identifier || String(identifier).trim() === '') {
      return { status: "error", message: "Please enter your Registration ID or Registered Email." };
    }

    const q = String(identifier).trim().toLowerCase();
    const qClean = q.replace(/[^a-z0-9]/g, '');

    const candidateSheetsToSearch = [
      { name: SHEET_NAMES.REGISTRATIONS, defaultType: 'Student' },
      { name: SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations', defaultType: 'Faculty' },
      { name: SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations', defaultType: 'Employee' },
      { name: SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations', defaultType: 'Apprentice' },
      { name: SHEET_NAMES.CONSOLIDATED_INTERNSHIPS, defaultType: 'Student' },
      { name: SHEET_NAMES.FACULTY_CONSOLIDATED || 'Faculty_Consolidated_Internships', defaultType: 'Faculty' },
      { name: SHEET_NAMES.EMPLOYEE_CONSOLIDATED || 'Employee_Consolidated_Internships', defaultType: 'Employee' },
      { name: SHEET_NAMES.APPRENTICE_CONSOLIDATED || 'Apprentice_Consolidated_Internships', defaultType: 'Apprentice' }
    ];

    let foundCandidate = null;
    let foundType = 'Student';

    for (let item of candidateSheetsToSearch) {
      try {
        const sh = getSheet(item.name);
        if (!sh) continue;
        const data = getSheetDataAsObjects(sh);
        if (!data || data.length === 0) continue;

        const match = data.find(r => {
          const regId = (r.RegistrationID || "").toString().trim().toLowerCase();
          const email = (r.GmailID || r.Email || "").toString().trim().toLowerCase();
          const staffId = (r.FacultyStaffId || r.RegisterNumber || "").toString().trim().toLowerCase();
          const mobile = (r.MobileNumber || "").toString().trim().replace(/[^0-9]/g, '');

          return regId === q || email === q || staffId === q ||
                 (qClean && (regId.replace(/[^a-z0-9]/g, '') === qClean || staffId.replace(/[^a-z0-9]/g, '') === qClean));
        });

        if (match) {
          foundCandidate = match;
          foundType = match.CandidateType || item.defaultType;
          break;
        }
      } catch (err) {}
    }

    if (!foundCandidate) {
      return {
        status: "error",
        message: "No matching account found with Registration ID or Email: '" + identifier + "'. Please check the details or contact the administrator."
      };
    }

    const email = foundCandidate.GmailID || foundCandidate.Email;
    if (!email || String(email).trim() === '') {
      return {
        status: "error",
        message: "An account was located, but no registered email address is recorded. Please contact the administrator directly."
      };
    }

    const candidateName = getStudentFullName_(foundCandidate) || foundCandidate.FirstName || 'Candidate';
    const regId = foundCandidate.RegistrationID || foundCandidate.FacultyStaffId || foundCandidate.RegisterNumber || 'N/A';
    const password = foundCandidate.MobileNumber || 'N/A';
    const institution = foundCandidate.CollegeName || foundCandidate.CompanyName || '';
    const department = foundCandidate.Department || foundCandidate.Designation || '';
    const status = foundCandidate.ApplicationStatus || foundCandidate.Status || 'Active';

    let roleBadgeTitle = 'Student Intern';
    if (foundType === 'Faculty' || String(foundCandidate.CandidateType).toLowerCase().includes('fac')) {
      roleBadgeTitle = 'College Faculty Member';
    } else if (foundType === 'Employee' || String(foundCandidate.CandidateType).toLowerCase().includes('emp')) {
      roleBadgeTitle = 'Corporate Employee';
    } else if (foundType === 'Apprentice' || String(foundCandidate.CandidateType).toLowerCase().includes('app')) {
      roleBadgeTitle = 'Apprentice Trainee';
    }

    const publishedUrl = getPublishedUrl();
    const loginPortalUrl = publishedUrl ? (publishedUrl + '?page=home&s=portalLogins#portalLogins') : '#portalLogins';

    const subject = `[GSV Portal] Account Credentials & Recovery - ` + roleBadgeTitle + ` (` + candidateName + `)`;

    const htmlBody = `
      <div style="font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; max-width: 620px; margin: 0 auto; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.06);">
        <!-- Brand Header -->
        <div style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #2563eb 100%); padding: 30px 24px; text-align: center; color: white;">
          <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 2px; color: #93c5fd; font-weight: 700; margin-bottom: 6px;">GSV Electrical Enterprises &bull; Enterprise Governance</div>
          <h2 style="margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.2px; color: white;">Account Credentials Recovery</h2>
          <div style="display: inline-block; margin-top: 12px; background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.3); padding: 5px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; color: #ffffff;">
            Stream: ` + roleBadgeTitle + `
          </div>
        </div>

        <!-- Body Content -->
        <div style="padding: 30px 24px; color: #1e293b; line-height: 1.65;">
          <p style="font-size: 15px; margin: 0 0 14px 0;">Dear <strong>` + candidateName + `</strong>,</p>
          <p style="font-size: 13.5px; color: #475569; margin: 0 0 20px 0;">
            We received a request to retrieve your official credentials for the <strong>GSV Internship & Research Portal</strong>. Your account details have been retrieved from the master registry:
          </p>

          <!-- Credential Box -->
          <div style="background: #f8fafc; border: 2px solid #cbd5e1; border-radius: 12px; padding: 18px 20px; margin-bottom: 22px;">
            <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
              <tr style="border-bottom: 1px solid #e2e8f0;">
                <td style="padding: 8px 0; color: #64748b; font-weight: 600; width: 44%;">Profile Category:</td>
                <td style="padding: 8px 0; color: #0f172a; font-weight: 700;">` + roleBadgeTitle + `</td>
              </tr>
              <tr style="border-bottom: 1px solid #e2e8f0;">
                <td style="padding: 8px 0; color: #64748b; font-weight: 600;">Registration / Staff ID:</td>
                <td style="padding: 8px 0; color: #2563eb; font-weight: 800; font-family: monospace; font-size: 15px;">` + regId + `</td>
              </tr>
              <tr style="border-bottom: 1px solid #e2e8f0;">
                <td style="padding: 8px 0; color: #64748b; font-weight: 600;">Portal Login Password:</td>
                <td style="padding: 8px 0; color: #0f172a; font-weight: 800; font-family: monospace; font-size: 15px;"><span style="background:#fef3c7; padding: 2px 8px; border-radius: 4px; border: 1px solid #fde68a;">` + password + `</span></td>
              </tr>
              <tr style="border-bottom: 1px solid #e2e8f0;">
                <td style="padding: 8px 0; color: #64748b; font-weight: 600;">Registered Email:</td>
                <td style="padding: 8px 0; color: #334155; font-weight: 600;">` + email + `</td>
              </tr>
              ` + (institution ? `
              <tr style="border-bottom: 1px solid #e2e8f0;">
                <td style="padding: 8px 0; color: #64748b; font-weight: 600;">Institution / Organization:</td>
                <td style="padding: 8px 0; color: #334155; font-weight: 600;">` + institution + (department ? ' (' + department + ')' : '') + `</td>
              </tr>` : '') + `
              <tr>
                <td style="padding: 8px 0; color: #64748b; font-weight: 600;">Account Status:</td>
                <td style="padding: 8px 0; color: #16a34a; font-weight: 700;">` + status + `</td>
              </tr>
            </table>
            <div style="margin-top: 12px; font-size: 12px; color: #64748b; background: #ffffff; border: 1px dashed #cbd5e1; border-radius: 6px; padding: 8px 10px;">
              <strong style="color:#d97706;">&#9888; Note:</strong> Your registered 10-digit mobile number functions as your primary password for Portal Login.
            </div>
          </div>

          <!-- Step Instructions -->
          <div style="background: #eff6ff; border-left: 4px solid #2563eb; padding: 14px 16px; border-radius: 0 8px 8px 0; margin-bottom: 24px; font-size: 12.5px; color: #1e40af; line-height: 1.55;">
            <strong>Portal Sign-In Instructions:</strong><br>
            1. Click the button below to navigate to the Portal Login page.<br>
            2. In the <strong>Portal Login (Student / Faculty / Apprentice)</strong> form, enter your Registration / Staff ID.<br>
            3. Enter your password (registered mobile number) and click <strong>Portal Login</strong>.<br>
            4. Access your Attendance Records, Daily Task Diary, Documents, and Progress Tracking.
          </div>

          <!-- Action Button -->
          <div style="text-align: center; margin-bottom: 24px;">
            <a href="` + loginPortalUrl + `" style="background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%); color: #ffffff; padding: 13px 32px; text-decoration: none; border-radius: 8px; font-weight: 700; font-size: 13.5px; display: inline-block; box-shadow: 0 4px 12px rgba(37,99,235,0.25);">
              &rarr; Sign In to Portal Now
            </a>
          </div>

          <p style="font-size: 11.5px; color: #94a3b8; margin: 0; line-height: 1.5;">
            If you did not initiate this request or have questions, please reach out to the administrator at <a href="mailto:gsveeip2026@gmail.com" style="color: #2563eb; text-decoration: underline;">gsveeip2026@gmail.com</a>.
          </p>
        </div>

        <!-- Footer -->
        <div style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 14px 20px; text-align: center; font-size: 11px; color: #94a3b8;">
          &copy; ` + new Date().getFullYear() + ` GSV Electrical Enterprises. All rights reserved. &bull; Enterprise Internship Management System
        </div>
      </div>
    `;

    const sent = sendEmail(email, subject, "", htmlBody);

    // Mask email for privacy: a***b@domain.com
    let maskedEmail = email;
    try {
      const parts = email.split('@');
      if (parts[0].length > 3) {
        maskedEmail = parts[0].slice(0, 2) + '***' + parts[0].slice(-2) + '@' + parts[1];
      } else {
        maskedEmail = parts[0].slice(0, 1) + '***@' + parts[1];
      }
    } catch(mErr) {}

    if (sent) {
      logActivity('Account Recovery', regId, `Dispatched credentials to ` + email + ` (` + roleBadgeTitle + `)`);
      return {
        status: "success",
        candidateType: foundType,
        roleBadge: roleBadgeTitle,
        candidateName: candidateName,
        maskedEmail: maskedEmail,
        message: `Credentials sent successfully! Verified as ` + roleBadgeTitle + ` (` + candidateName + `). Login details dispatched to ` + maskedEmail + `.`
      };
    } else {
      return {
        status: "error",
        message: "Failed to dispatch email. Please verify mail service or contact administrator at gsveeip2026@gmail.com."
      };
    }

  } catch (e) {
    Logger.log("Error in recoverCandidateLoginDetails: " + e.message);
    return { status: "error", message: e.message };
  }
}

