/**

 * Retrieves all switch statuses from the Switch_Status sheet

 */

function getAllSwitchStatuses() {

  try {

    const sheet = getSheet(SHEET_NAMES.SWITCH_STATUS);

    if (!sheet) return { status: 'error', message: 'Sheet not found' };



    const data = sheet.getDataRange().getValues();

    const result = {};

    for (let i = 1; i < data.length; i++) {

      const key = String(data[i][0]).trim();

      if (key) {

        result[key] = data[i][1];

      }

    }

    return { status: 'success', data: result };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Helper to check if a switch is ON

 */

function isSwitchOn(key) {

  const status = getAllSwitchStatuses();

  if (status.status === 'success' && status.data[key] !== undefined) {

    const s = String(status.data[key] || '').toUpperCase();

    return (s === 'ON' || s === 'TRUE' || s === '1' || s === 'AUTO');

  }



  // Legacy Fallback for continuity

  const settings = getAppSettings().settings || {};

  const mapping = {

    'settingCertificateTriggerMode': 'CertificateTriggerMode',

    'settingDefaultSlotEnabled': 'DefaultSlotAssignment',

    'rfidAutomationToggle': 'RFID_Automation_Mode',

    'settingIncludePhotoInAppForm': 'includePhotoInApplicationForm',

    'settingIncludePhotoInCertificate': 'includePhotoInCertificate',

    'includePhotoInApplicationForm': 'includePhotoInApplicationForm',

    'includePhotoInCertificate': 'includePhotoInCertificate'

  };

  const legacyKey = mapping[key] || key;

  if (legacyKey && settings[legacyKey] !== undefined) {

    const v = String(settings[legacyKey]).toUpperCase();

    return (v === 'AUTO' || v === 'TRUE' || v === 'ON' || v === '1');

  }



  return false;

}



/**

 * Saves or updates a switch status in the Switch_Status sheet

 */

function saveSwitchStatus(key, state) {

  try {

    const sheet = getSheet(SHEET_NAMES.SWITCH_STATUS);

    const lock = LockService.getScriptLock();

    lock.waitLock(10000);



    const data = sheet.getDataRange().getValues();

    let rowIndex = -1;

    for (let i = 1; i < data.length; i++) {

      if (String(data[i][0]).trim() === key) {

        rowIndex = i + 1;

        break;

      }

    }



    const timestamp = new Date().toISOString();

    if (rowIndex !== -1) {

      sheet.getRange(rowIndex, 2, 1, 2).setValues([[state, timestamp]]);

    } else {

      sheet.appendRow([key, state, timestamp]);

    }



    lock.releaseLock();

    // Also log this change

    logActivity('Switch Change', 'Admin', `Switch ${key} set to ${state}`);



    // ⭐️ SYNC: Ensure AppSettings stays in sync for crucial automation & document modes

    const isStateOn = (String(state).toUpperCase() === 'ON' || String(state).toUpperCase() === 'TRUE' || state === true);

    if (key === 'settingRegApprenticeOpen') {
      try {
        saveAppSettings({ 'REGISTRATION_APPRENTICE_STATUS': (isStateOn ? 'OPEN' : 'CLOSED') });
      } catch (err) { Logger.log("Sync Error for settingRegApprenticeOpen: " + err); }
    } else if (key === 'settingRegFacultyOpen') {
      try {
        saveAppSettings({ 'REGISTRATION_FACULTY_STATUS': (isStateOn ? 'OPEN' : 'CLOSED') });
      } catch (err) { Logger.log("Sync Error for settingRegFacultyOpen: " + err); }
    } else if (key === 'settingRegStudentOpen') {
      try {
        saveAppSettings({ 'REGISTRATION_STUDENT_STATUS': (isStateOn ? 'OPEN' : 'CLOSED') });
      } catch (err) { Logger.log("Sync Error for settingRegStudentOpen: " + err); }
    } else if (key === 'rfidAutomationToggle') {

      try {

        saveAppSettings({ 'RFID_Automation_Mode': (state === 'ON' ? 'Auto' : 'Manual') });

      } catch (err) { Logger.log("Sync Error: " + err); }

    } else if (key === 'settingDefaultSlotEnabled') {

      try {

        saveAppSettings({ 'DefaultSlotAssignment': (state === 'ON' ? 'Auto' : 'Manual') });

      } catch (err) { Logger.log("Sync Error: " + err); }

    } else if (key === 'settingCertificateTriggerMode') {

      try {

        saveAppSettings({ 'CertificateTriggerMode': (state === 'ON' ? 'Auto' : 'Manual') });

      } catch (err) { Logger.log("Sync Error: " + err); }

    } else if (key === 'settingIncludePhotoInAppForm' || key === 'includePhotoInApplicationForm') {

      try {

        saveAppSettings({ 'includePhotoInApplicationForm': isStateOn });

      } catch (err) { Logger.log("Sync Error: " + err); }

    } else if (key === 'settingIncludePhotoInCertificate' || key === 'includePhotoInCertificate') {

      try {

        saveAppSettings({ 'includePhotoInCertificate': isStateOn });

      } catch (err) { Logger.log("Sync Error: " + err); }

    }



    return { status: 'success', message: 'Switch status saved' };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



