/**

 * Submits a document access request from the public Index page.

 */

function submitPublicDocumentAccessRequest(payload) {

  try {

    const sheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

    if (!sheet) return { status: 'error', message: 'Database initialization error.' };



    const requestId = 'DOC-ACC-' + Date.now().toString(36).toUpperCase();

    const headers = sheet.getDataRange().getValues()[0].map(h => String(h).trim());



    // ["RequestID", "RegistrationID", "StudentName", "RequestType", "Section", "TargetDate", "EndDate", "Reason", "LeaveType", "Status", "RequestDate", "AttachmentUrl", "OTP", "ProcessedDate", "ProcessedBy", "AdminRemarks"]

    const row = new Array(headers.length).fill('');

    row[headers.indexOf("RequestID")] = requestId;

    row[headers.indexOf("RegistrationID")] = payload.registerNumber;

    row[headers.indexOf("StudentName")] = payload.studentName;

    row[headers.indexOf("RequestType")] = 'DocumentAccess';

    row[headers.indexOf("Section")] = 'Public';

    row[headers.indexOf("Reason")] = JSON.stringify(payload.requestedDocs);

    row[headers.indexOf("Status")] = 'Pending';

    row[headers.indexOf("RequestDate")] = new Date().toISOString();



    // Use AdminRemarks to store requestor info

    const adminRemarksIdx = headers.indexOf("AdminRemarks");

    if (adminRemarksIdx !== -1) {

      row[adminRemarksIdx] = payload.requestorName + ' (' + payload.requestorEmail + ') - ' + payload.purpose;

    }



    // Store certificate number in AttachmentUrl for reference

    const attachIdx = headers.indexOf("AttachmentUrl");

    if (attachIdx !== -1) row[attachIdx] = payload.certificateNumber;



    // Store email in OTP field for easy lookup if needed

    const otpIdx = headers.indexOf("OTP");

    if (otpIdx !== -1) row[otpIdx] = payload.requestorEmail;



    sheet.appendRow(row);

    logActivity('Public Doc Request', requestId, `Requested by ${payload.requestorName} for ${payload.studentName}`);



    return { status: 'success', message: 'Request submitted successfully.' };

  } catch (e) {

    Logger.log('Error in submitPublicDocumentAccessRequest: ' + e.toString());

    return { status: 'error', message: e.message };

  }

}



/**

 * Fetches document access requests for the Admin panel.

 */

function getPublicDocumentAccessRequests(statusFilter) {

  try {

    const sheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

    if (!sheet) return [];



    const data = getSheetDataAsObjects(sheet);

    const requests = data

      .filter(r => r.RequestType === 'DocumentAccess')

      .map(r => {

        let requestedDocs = [];

        try {

          if (typeof r.Reason === 'string' && r.Reason.startsWith('[')) {

            requestedDocs = JSON.parse(r.Reason);

          } else {

            requestedDocs = r.Reason;

          }

        } catch (e) {

          requestedDocs = r.Reason;

        }



        const remarks = String(r.AdminRemarks || '');

        const requestorParts = remarks.split(' (');

        const purposeParts = remarks.split(') - ');



        return {

          id: r.RequestID,

          studentName: r.StudentName,

          registerNumber: r.RegistrationID,

          certificateNumber: r.AttachmentUrl,

          requestorName: requestorParts[0] || 'Unknown',

          requestorEmail: r.OTP || (requestorParts[1] ? requestorParts[1].split(')')[0] : ''),

          purpose: purposeParts[1] || '',

          requestedDocs: requestedDocs,

          requestedOn: r.RequestDate,

          status: r.Status,

          processedOn: r.ProcessedDate,

          expiresOn: r.EndDate

        };

      });



    if (statusFilter && statusFilter !== 'All') {

      return requests.filter(r => r.status === statusFilter);

    }

    return requests;

  } catch (e) {

    Logger.log('Error in getPublicDocumentAccessRequests: ' + e.toString());

    return [];

  }

}



/**

 * Processes a public document access request (Approve/Reject).

 */

function processPublicDocumentAccessRequest(payload) {

  try {

    const sheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

    if (!sheet) return { status: 'error', message: 'Database error.' };



    const data = sheet.getDataRange().getValues();

    const headers = data[0].map(h => String(h).trim());

    const idCol = headers.indexOf("RequestID");

    const statusCol = headers.indexOf("Status");

    const processedDateCol = headers.indexOf("ProcessedDate");

    const expiryCol = headers.indexOf("EndDate");



    if (idCol === -1 || statusCol === -1) return { status: 'error', message: 'Sheet structure error.' };



    for (let i = 1; i < data.length; i++) {

      if (String(data[i][idCol]) === String(payload.requestId)) {

        sheet.getRange(i + 1, statusCol + 1).setValue(payload.action);

        if (processedDateCol !== -1) sheet.getRange(i + 1, processedDateCol + 1).setValue(payload.processedOn || new Date().toISOString());

        if (payload.action === 'Approved' && payload.expiresOn && expiryCol !== -1) {

          sheet.getRange(i + 1, expiryCol + 1).setValue(payload.expiresOn);

        }



        logActivity('Admin Action', 'Public Doc Request', `${payload.action} request ${payload.requestId}`);

        return { status: 'success' };

      }

    }

    return { status: 'error', message: 'Request not found.' };

  } catch (e) {

    Logger.log('Error in processPublicDocumentAccessRequest: ' + e.toString());

    return { status: 'error', message: e.message };

  }

}



/**

 * Uncrashable Mathematical Code 128 (Type B) Barcode Formatter

 * Physically squishes horizontal dimension by ~45% compared to Code 39

 * Allowing extreme vertical height boosts natively through pure typing.

 */

function generateNativelyCompactCode128(text) {

  let sum = 104; // Start B Index

  let encoded = String.fromCharCode(204); // Start B Char (Ì)



  for (let i = 0; i < text.length; i++) {

    let charCode = text.charCodeAt(i);

    if (charCode >= 32 && charCode <= 126) {

      sum += (charCode - 32) * (i + 1);

      encoded += text[i];

    }

  }



  let check = sum % 103;

  let checkStr = "";

  if (check < 95) {

    checkStr = String.fromCharCode(check + 32);

  } else {

    checkStr = String.fromCharCode(check + 100);

  }



  return encoded + checkStr + String.fromCharCode(206); // Append Stop Char (Î)

}



/**

 * UTILITY: Standardize RFID Tag format to 10-digit decimal (Printed Card Number format)

 * Converts Hex strings (even if they look like digits) to decimal card numbers.

 * Hex 5000408657 -> Decimal 0004228695

 */

function standardizeRfidFormat(tag) {

  if (!tag) return "";

  let s = String(tag).trim();



  // Basic validation: if too short, just return as is (to avoid breaking short codes if any)

  if (s.length < 4) return s;



  // Handle RDM6300 HEX formats (usually 12 chars: Start[1] + Data[10] + Checksum[2] + End[1], 

  // but often provided as 10 or 12 hex chars).

  // Consistent with GSV Electrical Enterprises hardware which uses the middle hex segment.

  const isHex = /[A-Fa-f]/.test(s);

  if (isHex && (s.length === 10 || s.length === 12)) {

    try {

      // For 12 char hex: 02 (Start) + 10 Hex Data + Checksum + 03 (End)

      // We take the data portion. If 12 chars, we strip start/end/checksum or take middle.

      // Usually the 10-digit decimal printed on the card is the hex data segment.

      let hexData = s;

      if (s.length === 12) hexData = s.substring(2, 10); // Take data segment

      else if (s.length === 10) hexData = s.substring(4, 10); // Take specific data segment



      const decimal = parseInt(hexData, 16);

      if (!isNaN(decimal)) {

        return decimal.toString().padStart(10, '0');

      }

    } catch (e) {

      Logger.log("Hex conversion error: " + e.toString());

    }

  }



  // If numeric (including long decimal values), ensure 10-digit padding

  const n = parseInt(s, 10);

  if (!isNaN(n) && !/[a-zA-Z]/.test(s)) {

    return n.toString().padStart(10, '0');

  }



  return s;

}



/**

 * ONE-TIME MIGRATION: Converts all existing RFID tags in Sheets to the new standardized decimal format

 */

function runRfidFormatMigration() {

  const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);

  const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);



  if (!invSheet || !regSheet) return;

  Logger.log("Starting RFID Format Migration...");



  // 1. Update Inventory

  const invValues = invSheet.getDataRange().getValues();

  const invHeaders = invValues[0];

  const tagColIdx = invHeaders.indexOf("RFID_TagID");



  for (let i = 1; i < invValues.length; i++) {

    const oldTag = String(invValues[i][tagColIdx] || "").trim();

    const newTag = standardizeRfidFormat(oldTag);

    if (oldTag && oldTag !== newTag) {

      Logger.log(`Inventory Update: ${oldTag} -> ${newTag}`);

      invSheet.getRange(i + 1, tagColIdx + 1).setValue(newTag);

    }

  }



  // 2. Update Registrations

  const regValues = regSheet.getDataRange().getValues();

  const regHeaders = regValues[0];

  const rfidColIdx = regHeaders.indexOf("RFID_TagID");



  for (let i = 1; i < regValues.length; i++) {

    const oldTag = String(regValues[i][rfidColIdx] || "").trim();

    const newTag = standardizeRfidFormat(oldTag);

    if (oldTag && oldTag !== newTag) {

      Logger.log(`Registration Update: ${oldTag} -> ${newTag}`);

      regSheet.getRange(i + 1, rfidColIdx + 1).setValue(newTag);

    }

  }



  Logger.log("RFID Format Migration Complete.");

}



/**

 * UTILITY: Formats a date to India Standard Time (IST) string: dd/MM/yyyy HH:mm:ss

 */

function formatDateTimeIndia(dateInput) {

  if (!dateInput) return '';

  try {

    const date = (dateInput instanceof Date) ? dateInput : new Date(dateInput);

    if (isNaN(date.getTime())) return String(dateInput);

    // India is GMT+5:30

    return Utilities.formatDate(date, "GMT+5:30", "dd/MM/yyyy HH:mm:ss");

  } catch (e) {

    return String(dateInput);

  }

}



/**

 * Checks for approved checkout permission in student_requests

 */

function checkCheckoutPermission(regId, date) {

  return checkCheckoutPermissionDetail(regId, date).allowed;

}



function checkCheckoutPermissionDetail(regId, date) {

  try {

    const sheetsToCheck = [

      getSheet(SHEET_NAMES.STUDENT_REQUESTS),

      getSheet(SHEET_NAMES.ATTENDANCE_REQUESTS),

      getSheet(SHEET_NAMES.ATTENDANCE_OTP)

    ];



    let validReq = null;



    for (const sheet of sheetsToCheck) {

      if (!sheet) continue;

      const data = getSheetDataAsObjects(sheet);

      const headers = (sheet.getLastRow() > 0) ? sheet.getDataRange().getValues()[0] : [];

      const typeKey = headers.indexOf("RequestType") !== -1 ? "RequestType" : (headers.indexOf("Type") !== -1 ? "Type" : "ActionType");



      validReq = data.find(r => {

        const rDate = r.TargetDate || r.Date;

        const matchesIdAndDate = String(r.RegistrationID || '').toUpperCase() === String(regId).toUpperCase() &&

          (r.Status === 'Approved' || r.Status === 'Active') &&

          formatDate(rDate) === date;



        if (!matchesIdAndDate) return false;



        const type = String(r[typeKey] || '').toLowerCase();

        const isOutType = type.includes('out') || type.includes('leave') || type.includes('exit');

        if (!isOutType) return false;



        if (r.TargetTime) {

          const now = new Date();

          const [reqH, reqM] = String(r.TargetTime).split(':').map(Number);

          if (!isNaN(reqH)) {

            const reqDate = new Date();

            reqDate.setHours(reqH, reqM || 0, 0, 0);

            return now >= reqDate;

          }

        }

        return isOutType;

      });



      if (validReq) break;

    }



    return {

      allowed: !!validReq,

      targetTime: validReq ? validReq.TargetTime : null

    };

  } catch (e) {

    Logger.log("Error in checkCheckoutPermissionDetail: " + e.message);

    return { allowed: false };

  }

}

function getAttendanceOverview() {

  try {

    const sheet = getSheet(SHEET_NAMES.ATTENDANCE);

    if (!sheet) return [];



    // Use the optimized data fetcher which now returns standardized date strings and numeric timestamps

    const data = getSheetDataAsObjects(sheet);



    // Sort by Date descending, then Timestamp descending

    data.sort((a, b) => {

      const db = String(b.Date || '');

      const da = String(a.Date || '');

      if (db !== da) return db.localeCompare(da);

      return (b.Timestamp || 0) - (a.Timestamp || 0);

    });



    const recent = data.slice(0, 50); // Show more for overview



    return recent.map(r => ({

      name: r.StudentName || 'Unknown',

      regId: r.StudentRegistrationID || 'N/A',

      batch: r.WorkArea || 'General',

      inTime: r.InTime || '--:--',

      outTime: r.OutTime || '--:--',

      status: r.Status || 'N/A',

      date: r.Date

    }));

  } catch (e) {

    Logger.log('Error in getAttendanceOverview: ' + e.toString());

    return [];

  }

}



/**

 * Generates a watermarked PDF of the student's own application form for preview.

 * Includes a diagonal watermark "STUDENTS COPY" with student details.

 */

function getStudentApplicationFormPdf(registrationId) {

  try {

    const studentData = getStudentDataForDoc(registrationId);

    if (!studentData) return { status: 'error', message: 'Student data not found.' };



    const existingDoc = getExistingDocFileId(registrationId, 'applicationForm');

    if (existingDoc && existingDoc.fileId) {

      try {

        const file = DriveApp.getFileById(existingDoc.fileId);

        const base64 = Utilities.base64Encode(file.getBlob().getBytes());

        return {

          status: 'success',

          data: base64,

          url: existingDoc.url,

          driveLink: existingDoc.url,

          fileId: existingDoc.fileId,

          fileName: `ApplicationForm_${registrationId}.pdf`

        };

      } catch(e) {

        Logger.log('Could not fetch existing app form blob: ' + e.toString());

      }

    }



    const genRes = generateDocumentAndMail('applicationForm', registrationId, false, false, { isPreview: false, forceNew: false });

    if (genRes.status === 'success' && genRes.fileId) {

      const file = DriveApp.getFileById(genRes.fileId);

      const base64 = Utilities.base64Encode(file.getBlob().getBytes());

      return {

        status: 'success',

        data: base64,

        url: genRes.driveLink || genRes.url,

        driveLink: genRes.driveLink || genRes.url,

        fileId: genRes.fileId,

        fileName: `ApplicationForm_${registrationId}.pdf`

      };

    }

    return genRes;

  } catch (e) {

    Logger.log("Error in getStudentApplicationFormPdf: " + e);

    return { status: 'error', message: e.toString() };

  }

}





// =================================================================================

// DOCUMENT APPROVAL SYSTEM HELPER FUNCTIONS

// =================================================================================



/**

 * Checks if a student is approved to generate a specific document type.

 */

function checkDocumentApproval(regId, docType) {

  try {

    const sheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

    if (!sheet) return { status: 'error', message: 'Request sheet not found' };



    const data = sheet.getDataRange().getValues();

    const headers = data[0];

    const regIdx = headers.indexOf('RegistrationID');

    const typeIdx = headers.indexOf('RequestType');

    const reasonIdx = headers.indexOf('Reason'); // Using Reason to store docType

    const statusIdx = headers.indexOf('Status');



    if (regIdx === -1 || typeIdx === -1 || reasonIdx === -1 || statusIdx === -1) {

      return { status: 'error', message: 'Sheet schema mismatch' };

    }



    // Normalize docType for lookup

    const searchType = String(docType).trim();



    // Search for latest request of type DOCUMENT_APPROVAL for this regId and docType

    for (let i = data.length - 1; i >= 1; i--) {

      if (String(data[i][regIdx]).trim() === regId &&

        String(data[i][typeIdx]).trim() === 'DOCUMENT_APPROVAL' &&

        String(data[i][reasonIdx]).trim() === searchType) {

        return { status: String(data[i][statusIdx]).trim(), requestId: i + 1 };

      }

    }

    return { status: 'None' };

  } catch (e) {

    Logger.log("Error in checkDocumentApproval: " + e.toString());

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Initiates a document approval request. Sends email to Admin with OTP.

 */

function requestDocumentApproval(docType, regId) {

  try {

    const student = getStudentDataForDoc(regId);

    if (!student) return { status: 'error', message: 'Student not found.' };



    // Safety check for Certificate Eligibility

    if (docType === 'COMPLETION_CERTIFICATE' || docType === 'internshipCertificate') {

      const appStatus = (student.ApplicationStatus || student.Status || '').toLowerCase();

      if (appStatus !== 'completed') {

        // Additional check: Does the end date pass?

        const endDate = student.InternshipEndDate ? new Date(student.InternshipEndDate) : null;

        const now = new Date();

        if (!endDate || now < endDate) {

          return { status: 'error', message: 'Your internship period has not ended yet. Certificates can only be requested after completion.' };

        }

        return { status: 'error', message: 'Your internship is not yet marked as Completed by Admin. Please complete your tasks first.' };

      }

    }



    const otp = Math.floor(100000 + Math.random() * 900000).toString();

    const requestId = 'DOC_' + Math.random().toString(36).substr(2, 9).toUpperCase();

    const timestamp = formatDateTimeIndia(new Date());



    const sheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

    if (!sheet) return { status: 'error', message: 'Request system unavailable.' };



    const headers = sheet.getDataRange().getValues()[0];

    const nr = headers.map(h => {

      if (h === 'RequestID') return requestId;

      if (h === 'RegistrationID') return regId;

      if (h === 'StudentName') return student.FullName;

      if (h === 'RequestType') return 'DOCUMENT_APPROVAL';

      if (h === 'Reason') return docType;

      if (h === 'Status') return 'Awaiting OTP';

      if (h === 'RequestDate') return timestamp;

      if (h === 'OTP') return otp;

      return '';

    });

    sheet.appendRow(nr);



    // Send email to Admin

    const subject = `[ACTION REQUIRED] Document Approval: ${docType} - ${student.FullName}`;

    const emailBody = `

      <div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; border: 1px solid #eee; padding: 20px; border-radius: 10px;">

        <h2 style="color: #1a73e8; border-bottom: 2px solid #1a73e8; padding-bottom: 10px;">Document Generation Request</h2>

        <p>Hello Admin,</p>

        <p>A student has requested approval to generate an official document from the Smart Document Generator.</p>

        

        <table style="width: 100%; border-collapse: collapse; margin: 20px 0;">

          <tr><td style="padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;">Student Name:</td><td style="padding: 8px; border-bottom: 1px solid #eee;">${student.FullName}</td></tr>

          <tr><td style="padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;">Reg ID:</td><td style="padding: 8px; border-bottom: 1px solid #eee;">${regId}</td></tr>

          <tr><td style="padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;">Batch:</td><td style="padding: 8px; border-bottom: 1px solid #eee;">${student.Batch || 'N/A'}</td></tr>

          <tr><td style="padding: 8px; border-bottom: 1px solid #eee; font-weight: bold;">Document:</td><td style="padding: 8px; border-bottom: 1px solid #eee; color: #d93025;">${docType}</td></tr>

        </table>



        <div style="background: #fdf2f2; padding: 20px; text-align: center; border-radius: 10px; border: 1px solid #f5c6cb;">

          <p style="margin-bottom: 10px; font-weight: bold; color: #721c24;">ADMIN APPROVAL OTP</p>

          <div style="font-size: 32px; font-weight: bold; color: #d93025; letter-spacing: 5px;">${otp}</div>

          <p style="margin-top: 10px; font-size: 12px; color: #721c24;">Share this OTP with the student to grant them access to this document.</p>

        </div>

        

        <p style="margin-top: 20px; font-size: 12px; color: #777;">This is an automated request from the GSV Interns Portal.</p>

      </div>

    `;



    try {

      sendEmail(ADMIN_EMAIL_ID, subject, '', emailBody);

    } catch (err) {

      Logger.log("Mail failed: " + err.message);

    }



    logActivity('Document Request', regId, `Requested approval for ${docType}`);



    return { status: 'success', message: 'Approval request sent. Please contact Admin for the 6-digit access OTP.' };

  } catch (e) {

    Logger.log("Error in requestDocumentApproval: " + e.toString());

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Verifies the OTP for document approval.

 */

function verifyDocumentApprovalOtp(registrationId, docType, otp) {

  try {

    const sheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

    if (!sheet) return { status: 'error', message: 'System error.' };



    const data = sheet.getDataRange().getValues();

    const headers = data[0];

    const regIdx = headers.indexOf('RegistrationID');

    const typeIdx = headers.indexOf('RequestType');

    const reasonIdx = headers.indexOf('Reason');

    const otpIdx = headers.indexOf('OTP');

    const statusIdx = headers.indexOf('Status');

    const procDateIdx = headers.indexOf('ProcessedDate');



    for (let i = data.length - 1; i >= 1; i--) {

      if (String(data[i][regIdx]).trim() === String(registrationId).trim() &&

        String(data[i][typeIdx]).trim() === 'DOCUMENT_APPROVAL' &&

        String(data[i][reasonIdx]).trim() === String(docType).trim() &&

        String(data[i][statusIdx]).trim() === 'Awaiting OTP') {



        if (String(data[i][otpIdx]).trim() === String(otp).trim()) {

          sheet.getRange(i + 1, statusIdx + 1).setValue('Approved');

          if (procDateIdx !== -1) sheet.getRange(i + 1, procDateIdx + 1).setValue(formatDateTimeIndia(new Date()));



          logActivity('Document Approved', registrationId, `Access granted for ${docType} via OTP`);

          return { status: 'success', message: 'Document Access Granted! You can now generate the ' + docType + '.' };

        } else {

          return { status: 'error', message: 'Invalid OTP. Please ensure you enter the correct code shared by the Admin.' };

        }

      }

    }

    return { status: 'error', message: 'No active approval request found for this document.' };

  } catch (e) {

    Logger.log("Error in verifyDocumentApprovalOtp: " + e.toString());

    return { status: 'error', message: e.toString() };

  }

}



/**

 * BACKGROUND MONITOR: Checks if devices are still online every 45 minutes.

 * Threshold: 45 Minutes (industrial heartbeat logic).

 */

function checkDeviceOnlineStatus() {

  try {

    const sheet = getSheet(SHEET_NAMES.RFID_ONLINE_STATUS);

    if (!sheet) return;



    const data = sheet.getDataRange().getValues();

    const headers = data[0];

    const statusIdx = headers.indexOf('Status');

    const lastSeenIdx = headers.indexOf('LastSeen');



    const now = new Date().getTime();

    const threshold = 45 * 60 * 1000; // 45 Minutes in milliseconds



    for (let i = 1; i < data.length; i++) {

      const lastSeenStr = data[i][lastSeenIdx];

      if (!lastSeenStr) continue;



      const lastSeen = new Date(lastSeenStr).getTime();

      const currentStatus = String(data[i][statusIdx]).toUpperCase();



      let newStatus = currentStatus;

      if (now - lastSeen > threshold) {

        newStatus = 'OFFLINE';

      } else {

        newStatus = 'ONLINE';

      }



      if (newStatus !== currentStatus) {

        sheet.getRange(i + 1, statusIdx + 1).setValue(newStatus);

      }

    }

    Logger.log("Background Task: Device Status Check Completed.");

  } catch (e) {

    Logger.log("Error in checkDeviceOnlineStatus: " + e.toString());

  }

}



/**

 * SETUP TRIGGER: Call this ONCE from the Apps Script editor to set up the 45-min timer.

 */

function setupStatusTrigger() {

  // Delete existing triggers for this function to avoid duplicates

  const triggers = ScriptApp.getProjectTriggers();

  for (let i = 0; i < triggers.length; i++) {

    if (triggers[i].getHandlerFunction() === 'checkDeviceOnlineStatus') {

      ScriptApp.deleteTrigger(triggers[i]);

    }

  }



  // Create new 45-minute trigger

  ScriptApp.newTrigger('checkDeviceOnlineStatus')

    .timeBased()

    .everyMinutes(45)

    .create();



  Logger.log("Success: 45-minute Device Status Trigger has been installed.");

}



/**

 * Periodic Status Check (Run every 45 mins)

 * Marks devices as OFFLINE if not seen for more than 45 minutes.

 */

function checkDeviceOnlineStatus() {

  try {

    const sheet = getSheet(SHEET_NAMES.RFID_ONLINE_STATUS);

    if (!sheet) return;



    const data = getSheetDataAsObjects(sheet);

    const now = new Date();

    const range = sheet.getDataRange().getValues();

    const headers = range[0];

    const statusIdx = headers.indexOf('Status');

    const lastSeenIdx = headers.indexOf('LastSeen');



    data.forEach((device, index) => {

      const lastSeen = device.LastSeen ? new Date(device.LastSeen) : new Date(0);

      const diffMins = (now - lastSeen) / (1000 * 60);



      if (diffMins > 45 && device.Status === 'ONLINE') {

        sheet.getRange(index + 2, statusIdx + 1).setValue('OFFLINE');

        logDeviceEvent(device.MAC_ID, 'Status Change', 'Device marked OFFLINE (timeout)');

      }

    });

  } catch (e) {

    Logger.log("checkDeviceOnlineStatus error: " + e.toString());

  }

}



function setupStatusTrigger() {

  const triggers = ScriptApp.getProjectTriggers();

  triggers.forEach(t => { if (t.getHandlerFunction() === 'checkDeviceOnlineStatus') ScriptApp.deleteTrigger(t); });

  ScriptApp.newTrigger('checkDeviceOnlineStatus').timeBased().everyMinutes(45).create();

}





/**

 * Robust Table-based layout for Application Form.

 * Ensures perfect alignment of Student Details vs Parent/Guardian fields.

 */

function modernizeApplicationFormLayout(body, studentData) {

  try {

    const name = (studentData.FullName || '').toUpperCase();

    const college = (studentData.CollegeName || '').toUpperCase();

    const dept = (studentData.Department || '').toUpperCase();

    const year = (studentData.Year || '1').toString();

    const district = (studentData.CollegeDistrict || studentData.District || '').toUpperCase();



    // 1. HEADER ALIGNMENT (STUDENT VS PARENT)

    const headerAnchor = body.findText('{{STUDENT_NAME}}') || body.findText('{{FullName}}') || body.findText('{STUDENT_NAME}');

    if (headerAnchor) {

      const p = headerAnchor.getElement().getParent().asParagraph();

      const container = p.getParent();

      const index = container.getChildIndex(p);



      const table = container.insertTable(index);

      table.setBorderWidth(0);



      const rows = [

        [name, 'Parent/Guardian Name: ________________'],

        [college, 'Parent/Guardian Signature: ____________'],

        [dept, ''],

        [`${year} YEAR`, 'Date: ____/____/________'],

        [district, 'Place: ________________']

      ];



      rows.forEach(rowInfo => {

        const row = table.appendTableRow();

        const c1 = row.appendTableCell(rowInfo[0]);

        const c2 = row.appendTableCell(rowInfo[1]);

        

        c1.setPaddingTop(2).setPaddingBottom(2).setPaddingLeft(0);

        c2.setPaddingTop(2).setPaddingBottom(2).setPaddingRight(0);

        

        const p1 = c1.getChild(0).asParagraph();

        const p2 = c2.getChild(0).asParagraph();

        

        p1.setFontSize(10).setBold(true).setUnderline(false).setSpacingAfter(0);

        p2.setFontSize(10).setAlignment(DocumentApp.HorizontalAlignment.LEFT).setSpacingAfter(0);

      });



      // Remove the old lines (identified as the 5 lines starting from anchor)

      for (let i = 0; i < 5; i++) {

        const target = container.getChild(index + 1);

        if (target) container.removeChild(target);

      }

    }



    // 2. SIGNATURE ALIGNMENT (BOTTOM)

    const sigAnchor = body.findText('Student Signature');

    if (sigAnchor) {

      const p = sigAnchor.getElement().getParent().asParagraph();

      const container = p.getParent();

      const index = container.getChildIndex(p);

      

      // Usually there are underlines above labels. Try to find them.

      let startIndex = index;

      if (index > 0) {

        const prev = container.getChild(index - 1).asParagraph();

        if (prev && prev.getText().includes('____')) startIndex = index - 1;

      }



      const table = container.insertTable(startIndex);

      table.setBorderWidth(0);

      

      // Row 1: Underlines

      const r1 = table.appendTableRow();

      r1.appendTableCell('________________________').getChild(0).asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER);

      r1.appendTableCell('________________________').getChild(0).asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER);

      

      // Row 2: Labels

      const r2 = table.appendTableRow();

      r2.appendTableCell('Student Signature').getChild(0).asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER).setBold(true);

      r2.appendTableCell('Parent / Guardian Signature').getChild(0).asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER).setBold(true);

      

      // Row 3: Name

      const r3 = table.appendTableRow();

      r3.appendTableCell(`{ ${name} }`).getChild(0).asParagraph().setAlignment(DocumentApp.HorizontalAlignment.CENTER).setFontSize(10);

      r3.appendTableCell('').getChild(0).asParagraph();



      // Clean up old signature lines (Underline, Label, Name - 3 lines)

      for (let i = 0; i < 4; i++) {

        const target = container.getChild(startIndex + 1);

        if (target) container.removeChild(target);

      }

    }

  } catch (e) {

    Logger.log("Error modernizing application form: " + e.toString());

  }

}



/**

 * Automatically categorizes and synchronizes students into separate sheets:

 * 1. Approved (Approved, Active, Completed, Assigned)

 * 2. Pending (Pending, Submitted, and any blank status)

 * 3. Rejected_Optout_Closed (Rejected, Opt-out, Optout, Closed)

 */

function syncStudentCategoriesToSheets() {

  try {

    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);

    const regSheet = ss.getSheetByName(SHEET_NAMES.REGISTRATIONS);

    if (!regSheet) return { status: 'error', message: 'Registrations sheet not found.' };



    const data = regSheet.getDataRange().getValues();

    if (data.length <= 1) return { status: 'success', message: 'No data to sync.' };



    const headers = data[0];

    const statusCol = headers.indexOf("ApplicationStatus");

    if (statusCol === -1) return { status: 'error', message: 'ApplicationStatus column not found.' };



    const approvedData = [headers];

    const pendingData = [headers];

    const rejectedOptoutClosedData = [headers];



    for (let i = 1; i < data.length; i++) {

      const row = data[i];

      const status = String(row[statusCol] || '').trim().toLowerCase();



      if (status === 'approved' || status === 'active' || status === 'completed' || status === 'assigned') {

        approvedData.push(row);

      } else if (status === 'rejected' || status === 'opt-out' || status === 'optout' || status === 'closed') {

        rejectedOptoutClosedData.push(row);

      } else {

        // Includes 'pending', 'submitted', and blank/empty

        pendingData.push(row);

      }

    }



    // Also include Closed and Opt-out students from the archive sheet into the Rejected_Optout_Closed sheet

    try {

      const closedSheet = ss.getSheetByName('Closed and Opt-out');

      if (closedSheet) {

        const closedValues = closedSheet.getDataRange().getValues();

        for (let i = 1; i < closedValues.length; i++) {

          rejectedOptoutClosedData.push(closedValues[i]);

        }

      }

    } catch (e) {

      Logger.log('Error reading Closed and Opt-out sheet in syncStudentCategoriesToSheets: ' + e.toString());

    }



    const writeToCategorySheet = (sheetName, rows) => {

      let sheet = ss.getSheetByName(sheetName);

      if (!sheet) {

        sheet = ss.insertSheet(sheetName);

      } else {

        sheet.clearContents();

        sheet.clearFormats();

      }

      if (rows.length > 0) {

        sheet.getRange(1, 1, rows.length, rows[0].length).setValues(rows);

        // Style the headers beautifully

        sheet.getRange(1, 1, 1, rows[0].length)

          .setBackground('#4361ee')

          .setFontColor('#ffffff')

          .setFontWeight('bold');

        sheet.setFrozenRows(1);

      }

    };



    writeToCategorySheet("Approved", approvedData);

    writeToCategorySheet("Pending", pendingData);

    writeToCategorySheet("Rejected_Optout_Closed", rejectedOptoutClosedData);



    return { status: 'success', message: 'Synchronized student categories.' };

  } catch (e) {

    Logger.log('Error synchronizing student categories: ' + e.message);

    return { status: 'error', message: e.message };

  }

}



/**

 * Handle POST requests from the Flutter mobile app and external clients

 */

function doPost(e) {

  try {

    const postData = JSON.parse(e.postData.contents);

    const action = postData.action;

    let result = { status: 'error', message: 'Unknown action: ' + action };



    if (action === 'studentLogin') {

      result = studentLogin(postData.regId, postData.mobile);

      if (result.status === 'success') {

        const profile = getStudentComprehensiveProfile(postData.regId);

        result.studentData = profile;

      }

    } else if (action === 'adminLogin') {

      result = adminLogin(postData.adminId, postData.password);

    } else if (action === 'getStudentComprehensiveData') {

      result = getStudentComprehensiveProfile(postData.regId);

    } else if (action === 'getAdminComprehensiveData') {

      result = getAdminComprehensiveData();

    } else if (action === 'studentCheckin') {

      result = recordWebCheckin(postData.regId);

    } else if (action === 'studentCheckout') {

      result = recordWebCheckout(postData.regId);

    } else if (action === 'saveDiary') {

      result = saveDiaryEntry(postData.regId, postData.date, postData.content);

    } else if (action === 'broadcastNotice') {

      result = createNoticeCircular({

        type: 'Notice',

        title: postData.title,

        content: postData.content,

        priority: postData.priority || 'Normal',

        targetAudience: 'All'

      });

    } else if (action === 'updateStudentStatus') {

      result = updateApplicationStatus(postData.regId, postData.status);

    } else if (action === 'executeFunction' || postData.functionName) {
      const fnName = postData.functionName || postData.func || action;
      const fnArgs = postData.arguments || postData.args || [];
      if (typeof this[fnName] === 'function') {
        result = this[fnName].apply(this, fnArgs);
      } else if (typeof globalThis[fnName] === 'function') {
        result = globalThis[fnName].apply(globalThis, fnArgs);
      } else {
        result = { status: 'error', message: 'Function ' + fnName + ' not found in Apps Script' };
      }
    }



    return ContentService.createTextOutput(JSON.stringify(result))

      .setMimeType(ContentService.MimeType.JSON);

  } catch (err) {

    return ContentService.createTextOutput(JSON.stringify({ status: 'error', message: err.toString() }))

      .setMimeType(ContentService.MimeType.JSON);

  }

}





/**

 * Fetches all members of the batch assigned to the given student.

 */

function getMyBatchMembers(regId) {

  try {

    const studentRes = getStudentFullData(regId);

    if (studentRes.status === 'error') {

      return studentRes;

    }

    const student = studentRes.studentData;

    const batchName = student.Batch || '';

    if (!batchName) {

      return { status: 'error', message: 'No batch assigned to this student.' };

    }



    // Look up the batch details

    const batchSheet = getSheet(SHEET_NAMES.BATCHES);

    let supervisor = 'N/A';

    let project = 'N/A';

    if (batchSheet) {

      const batches = getSheetDataAsObjects(batchSheet);

      const batchObj = batches.find(b => String(b.BatchName || '').trim().toLowerCase() === String(batchName).trim().toLowerCase());

      if (batchObj) {

        supervisor = batchObj.Mentor || batchObj.Supervisor || batchObj['Industrial Supervisor'] || 'N/A';

        project = batchObj.Project || 'N/A';

      }

    }



    // Get all students in this batch

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (!regSheet) {

      return { status: 'error', message: 'Registrations sheet not found.' };

    }

    const allStudents = getSheetDataAsObjects(regSheet);

    

    // Filter by batch name

    const members = allStudents

      .filter(s => String(s.Batch || '').trim().toLowerCase() === String(batchName).trim().toLowerCase())

      .map(s => {

        // Handle names (combine First, Middle, Last)

        const nameParts = [s.FirstName, s.MiddleName, s.LastName].filter(Boolean);

        const fullName = nameParts.length > 0 ? nameParts.join(' ') : (s.Name || 'Unknown');

        

        return {

          registrationId: s.RegistrationID,

          name: fullName,

          email: s.GmailID || s.Email,

          phone: s.MobileNumber || s.Phone,

          college: s.CollegeName || s.College,

          department: s.Department,

          startDate: s.InternshipStartDate ? formatDateDisplay(s.InternshipStartDate) : 'N/A',

          endDate: s.InternshipEndDate ? formatDateDisplay(s.InternshipEndDate) : 'N/A'

        };

      });



    return {

      status: 'success',

      batchName: batchName,

      supervisor: supervisor,

      project: project,

      members: members

    };

  } catch (e) {

    Logger.log('Error in getMyBatchMembers: ' + e.toString());

    return { status: 'error', message: e.message };

  }

}



function checkAndCloseBatchSlots(batchId) {

  try {

    if (!batchId) return;

    const normBid = String(batchId).trim().replace(/\s+/g, '').toUpperCase();

    if (!normBid) return;



    // 1. Get all students of this batch

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (!regSheet) return;

    const regData = getSheetDataAsObjects(regSheet);

    

    // Filter students belonging to this batch

    const batchStudents = regData.filter(s => {

      const sBatch = String(s.Batch || '').trim().replace(/\s+/g, '').toUpperCase();

      const sRegId = String(s.RegistrationID || '').trim();

      const status = String(s.ApplicationStatus || s.Status || '').trim().toLowerCase();

      // Only check approved/active students

      return sRegId && sBatch === normBid && (status === 'approved' || status === 'active' || status === 'assigned');

    });



    if (batchStudents.length === 0) return;



    // 2. Get all generated certificates

    const docSheet = getSheet(SHEET_NAMES.GENERATED_DOCUMENTS);

    if (!docSheet) return;

    const docData = getSheetDataAsObjects(docSheet);

    

    // Set of students who have generated certificates

    const certifiedStudents = new Set();

    docData.forEach(d => {

      const type = String(d.DocType || '').trim();

      if (type === 'internshipCertificate' || type === 'completionCertificate') {

        const sRegId = String(d.StudentRegistrationID || '').trim().toUpperCase();

        if (sRegId) certifiedStudents.add(sRegId);

      }

    });



    // Check if every student in the batch has a certificate

    const allCertified = batchStudents.every(s => certifiedStudents.has(String(s.RegistrationID).trim().toUpperCase()));

    if (!allCertified) {

      Logger.log(`Batch ${batchId}: Not all students are certified yet.`);

      return;

    }



    Logger.log(`Batch ${batchId}: All students are certified. Closing active configurations.`);



    // 3. Deactivate modern slot settings

    const settingsSheet = getSheet(SHEET_NAMES.SLOT_SETTINGS);

    if (settingsSheet) {

      const headers = settingsSheet.getRange("1:1").getValues()[0];

      const typeCol = headers.indexOf("type") + 1;

      const appForCol = headers.indexOf("applicable_for") + 1;

      const batchCol = headers.indexOf("batch") + 1;

      const appTargetCol = headers.indexOf("applicable_target") + 1;

      const enabledCol = headers.indexOf("enabled") + 1;

      const rfidCol = headers.indexOf("rfid_enabled") + 1;

      

      const sData = settingsSheet.getDataRange().getValues();

      for (let i = 1; i < sData.length; i++) {

        const type = String(sData[i][typeCol - 1]).toUpperCase();

        const appFor = String(sData[i][appForCol - 1]).toLowerCase();

        const batch = String(sData[i][batchCol - 1]).trim().replace(/\s+/g, '').toUpperCase();

        const appTarget = String(sData[i][appTargetCol - 1]).trim().replace(/\s+/g, '').toUpperCase();

        

        let isMatch = false;

        if (type === 'BATCH' && (batch === normBid || appTarget === normBid)) {

          isMatch = true;

        } else if (type === 'SPECIAL' && appFor === 'batch' && (batch === normBid || appTarget === normBid)) {

          isMatch = true;

        }



        if (isMatch) {

          if (enabledCol > 0) settingsSheet.getRange(i + 1, enabledCol).setValue(false);

          if (rfidCol > 0) settingsSheet.getRange(i + 1, rfidCol).setValue(false);

        }

      }

      executionCache.delete(SHEET_NAMES.SLOT_SETTINGS);

    }



    // 4. Deactivate legacy Slots (Batch slots)

    const slotsSheet = getSheet(SHEET_NAMES.SLOTS);

    if (slotsSheet) {

      const headers = slotsSheet.getRange("1:1").getValues()[0];

      const batchIdCol = headers.indexOf("BatchID") + 1;

      const statusCol = headers.indexOf("Status") + 1;

      if (batchIdCol > 0 && statusCol > 0) {

        const sData = slotsSheet.getDataRange().getValues();

        for (let i = 1; i < sData.length; i++) {

          const rawBid = String(sData[i][batchIdCol - 1]);

          const resolvedName = resolveBatchNameToName(rawBid);

          const normResolved = String(resolvedName || rawBid).trim().replace(/\s+/g, '').toUpperCase();

          if (normResolved === normBid) {

            slotsSheet.getRange(i + 1, statusCol).setValue('Inactive');

          }

        }

      }

      executionCache.delete(SHEET_NAMES.SLOTS);

    }



    // 5. Deactivate legacy Exceptions

    const excSheet = getSheet(SHEET_NAMES.SLOT_EXCEPTIONS);

    if (excSheet) {

      const headers = excSheet.getRange("1:1").getValues()[0];

      const batchIdCol = headers.indexOf("BatchID") + 1;

      const statusCol = headers.indexOf("Status") + 1;

      if (batchIdCol > 0 && statusCol > 0) {

        const eData = excSheet.getDataRange().getValues();

        for (let i = 1; i < eData.length; i++) {

          const rawBid = String(eData[i][batchIdCol - 1]);

          const resolvedName = resolveBatchNameToName(rawBid);

          const normResolved = String(resolvedName || rawBid).trim().replace(/\s+/g, '').toUpperCase();

          if (normResolved === normBid) {

            excSheet.getRange(i + 1, statusCol).setValue('Inactive');

          }

        }

      }

      executionCache.delete(SHEET_NAMES.SLOT_EXCEPTIONS);

    }



    logActivity('Slots Closed', `All configurations disabled for batch ${batchId} as all students have certificates.`);

  } catch (e) {

    Logger.log("Error in checkAndCloseBatchSlots: " + e.toString());

  }

}



function determineCheckinStatus(slot, checkinMins) {

  if (!slot || !slot.start) return 'Present';

  const startMins = timeToMinutes(slot.start);

  const graceLate = parseInt(slot.graceLate || 0);



  if (checkinMins <= startMins) {

    return checkinMins < startMins ? 'Early Present' : 'Present';

  } else if (checkinMins <= startMins + graceLate) {

    return 'Late with Present';

  } else {

    return 'Late';

  }

}



function applyApprovedRequest(regId, date, type, targetTime, period, reason) {

  try {

    const attSheet = getSheet(SHEET_NAMES.ATTENDANCE);

    if (!attSheet) return;

    const attData = attSheet.getDataRange().getValues();

    const attHeaders = attData[0];

    const regCol = attHeaders.indexOf("StudentRegistrationID");

    const dateCol = attHeaders.indexOf("Date");

    const statusCol = attHeaders.indexOf("Status");

    const inCol = attHeaders.indexOf("InTime");

    const outCol = attHeaders.indexOf("OutTime");

    const remarksCol = attHeaders.indexOf("Remarks");

    const modeCol = attHeaders.indexOf("EntryMode");

    const srcCol = attHeaders.indexOf("checkin_source");

    const timestampCol = attHeaders.indexOf("Timestamp");

    const lateFlagCol = attHeaders.indexOf("late_flag");

    const appCol = attHeaders.indexOf("ApprovalStatus");



    const zone = Session.getScriptTimeZone() || 'Asia/Kolkata';

    const nowStr = Utilities.formatDate(new Date(), zone, "hh:mm a");

    const tTime = targetTime || nowStr;

    const targetIso = formatDateISO(date) || String(date).trim();

    const targetRid = String(regId).trim().toUpperCase();



    // Find if student has a record for this date and purge duplicates (1 row per date)

    let foundRowIdx = -1;

    let duplicateAttRows = [];

    for (let i = 1; i < attData.length; i++) {

      const rowRegId = String(attData[i][regCol] || '').trim().toUpperCase();

      const rowIso = formatDateISO(attData[i][dateCol]) || String(attData[i][dateCol] || '').trim();



      if (rowRegId === targetRid && (rowIso === targetIso || String(attData[i][dateCol]).trim() === String(date).trim())) {

        if (foundRowIdx === -1) {

          foundRowIdx = i + 1;

        } else {

          duplicateAttRows.push(i + 1);

        }

      }

    }



    for (let d = duplicateAttRows.length - 1; d >= 0; d--) {

      try { attSheet.deleteRow(duplicateAttRows[d]); } catch(eD) {}

    }



    const typeLower = String(type || '').toLowerCase();

    const studentInfo = getStudentFullData(regId);

    const studentName = (studentInfo.status === 'success') ? getStudentFullName_(studentInfo.studentData) : 'Unknown';

    const workArea = (studentInfo.status === 'success') ? (studentInfo.studentData.InterestedArea || 'General') : 'General';



    if (typeLower.includes('exit') || typeLower.includes('check-out')) {

      if (foundRowIdx !== -1) {

        if (outCol !== -1) attSheet.getRange(foundRowIdx, outCol + 1).setValue(tTime || '05:00 PM');

        if (appCol !== -1) attSheet.getRange(foundRowIdx, appCol + 1).setValue('Approved');

        if (remarksCol !== -1) {

          const oldRemarks = attSheet.getRange(foundRowIdx, remarksCol + 1).getValue();

          attSheet.getRange(foundRowIdx, remarksCol + 1).setValue((oldRemarks ? oldRemarks + '; ' : '') + 'Approved Early Checkout');

        }

      } else {

        const newRow = attHeaders.map(h => {

          if (h === 'AttendanceID') return "ATT_" + Date.now();

          if (h === 'StudentRegistrationID') return regId;

          if (h === 'StudentName') return studentName;

          if (h === 'Date') return targetIso;

          if (h === 'Status') return 'Present';

          if (h === 'ApprovalStatus') return 'Approved';

          if (h === 'InTime') return '09:00 AM';

          if (h === 'OutTime') return tTime || '05:00 PM';

          if (h === 'EntryMode') return 'Manual';

          if (h === 'checkin_source') return 'ADMIN_APPROVAL';

          if (h === 'late_flag') return false;

          if (h === 'WorkArea') return workArea;

          if (h === 'Remarks') return 'Approved Early Checkout';

          if (h === 'Timestamp') return new Date();

          return '';

        });

        attSheet.appendRow(newRow);

      }

    } else if (typeLower.includes('wfh')) {

      if (foundRowIdx !== -1) {

        if (statusCol !== -1) attSheet.getRange(foundRowIdx, statusCol + 1).setValue('WFH');

        if (appCol !== -1) attSheet.getRange(foundRowIdx, appCol + 1).setValue('Approved');

        if (inCol !== -1) attSheet.getRange(foundRowIdx, inCol + 1).setValue('09:00 AM');

        if (outCol !== -1) attSheet.getRange(foundRowIdx, outCol + 1).setValue('05:00 PM');

        if (remarksCol !== -1) attSheet.getRange(foundRowIdx, remarksCol + 1).setValue('Approved WFH');

      } else {

        const newRow = attHeaders.map(h => {

          if (h === 'AttendanceID') return "ATT_" + Date.now();

          if (h === 'StudentRegistrationID') return regId;

          if (h === 'StudentName') return studentName;

          if (h === 'Date') return targetIso;

          if (h === 'Status') return 'WFH';

          if (h === 'ApprovalStatus') return 'Approved';

          if (h === 'InTime') return '09:00 AM';

          if (h === 'OutTime') return '05:00 PM';

          if (h === 'EntryMode') return 'WFH';

          if (h === 'checkin_source') return 'ADMIN_APPROVAL';

          if (h === 'WorkArea') return workArea;

          if (h === 'Remarks') return 'Approved WFH';

          if (h === 'Timestamp') return new Date();

          return '';

        });

        attSheet.appendRow(newRow);

      }

    } else if (typeLower.includes('od') || typeLower.includes('on duty')) {

      if (foundRowIdx !== -1) {

        if (statusCol !== -1) attSheet.getRange(foundRowIdx, statusCol + 1).setValue('OD');

        if (appCol !== -1) attSheet.getRange(foundRowIdx, appCol + 1).setValue('Approved');

        if (inCol !== -1) attSheet.getRange(foundRowIdx, inCol + 1).setValue('09:00 AM');

        if (outCol !== -1) attSheet.getRange(foundRowIdx, outCol + 1).setValue('05:00 PM');

        if (remarksCol !== -1) attSheet.getRange(foundRowIdx, remarksCol + 1).setValue('Approved On-Duty');

      } else {

        const newRow = attHeaders.map(h => {

          if (h === 'AttendanceID') return "ATT_" + Date.now();

          if (h === 'StudentRegistrationID') return regId;

          if (h === 'StudentName') return studentName;

          if (h === 'Date') return targetIso;

          if (h === 'Status') return 'OD';

          if (h === 'ApprovalStatus') return 'Approved';

          if (h === 'InTime') return '09:00 AM';

          if (h === 'OutTime') return '05:00 PM';

          if (h === 'EntryMode') return 'OD';

          if (h === 'checkin_source') return 'ADMIN_APPROVAL';

          if (h === 'WorkArea') return workArea;

          if (h === 'Remarks') return 'Approved On-Duty';

          if (h === 'Timestamp') return new Date();

          return '';

        });

        attSheet.appendRow(newRow);

      }

    } else {

      // General Attendance Correction / Manual Punch / Slot Correction

      const finalStatus = 'Present';

      if (foundRowIdx !== -1) {

        if (statusCol !== -1) attSheet.getRange(foundRowIdx, statusCol + 1).setValue(finalStatus);

        if (appCol !== -1) attSheet.getRange(foundRowIdx, appCol + 1).setValue('Approved');

        if (inCol !== -1) attSheet.getRange(foundRowIdx, inCol + 1).setValue(tTime || '09:00 AM');

        if (outCol !== -1 && !attSheet.getRange(foundRowIdx, outCol + 1).getValue()) {

          attSheet.getRange(foundRowIdx, outCol + 1).setValue('05:00 PM');

        }

        if (lateFlagCol !== -1) attSheet.getRange(foundRowIdx, lateFlagCol + 1).setValue(false);

        if (remarksCol !== -1) attSheet.getRange(foundRowIdx, remarksCol + 1).setValue('Approved Attendance Correction');

        if (srcCol !== -1) attSheet.getRange(foundRowIdx, srcCol + 1).setValue('ADMIN_APPROVAL');

      } else {

        const newRow = attHeaders.map(h => {

          if (h === 'AttendanceID') return "ATT_" + Date.now();

          if (h === 'StudentRegistrationID') return regId;

          if (h === 'StudentName') return studentName;

          if (h === 'Date') return targetIso;

          if (h === 'Status') return finalStatus;

          if (h === 'ApprovalStatus') return 'Approved';

          if (h === 'InTime') return tTime || '09:00 AM';

          if (h === 'OutTime') return '05:00 PM';

          if (h === 'EntryMode') return 'Manual';

          if (h === 'checkin_source') return 'ADMIN_APPROVAL';

          if (h === 'late_flag') return false;

          if (h === 'WorkArea') return workArea;

          if (h === 'Remarks') return 'Approved Attendance Correction';

          if (h === 'Timestamp') return new Date();

          return '';

        });

        attSheet.appendRow(newRow);

      }

    }



    // Also sync ATTENDANCE_OTP status to 'Approved'

    try {

      const otpSheet = getSheet(SHEET_NAMES.ATTENDANCE_OTP);

      if (otpSheet) {

        const otpData = otpSheet.getDataRange().getValues();

        const otpHeaders = otpData[0];

        const oRegCol = otpHeaders.indexOf("RegistrationID");

        const oDateCol = otpHeaders.indexOf("TargetDate") !== -1 ? otpHeaders.indexOf("TargetDate") : otpHeaders.indexOf("Date");

        const oStatusCol = otpHeaders.indexOf("Status");

        const oOtpCol = otpHeaders.indexOf("OTP");

        if (oRegCol !== -1 && oDateCol !== -1 && oStatusCol !== -1) {

          for (let oi = 1; oi < otpData.length; oi++) {

            const rReg = String(otpData[oi][oRegCol] || '').trim().toUpperCase();

            const rIso = formatDateISO(otpData[oi][oDateCol]) || String(otpData[oi][oDateCol] || '').trim();

            if (rReg === targetRid && (rIso === targetIso || String(otpData[oi][oDateCol]).trim() === String(date).trim())) {

              otpSheet.getRange(oi + 1, oStatusCol + 1).setValue('Approved');

              if (oOtpCol !== -1) otpSheet.getRange(oi + 1, oOtpCol + 1).setValue('');

            }

          }

        }

      }

    } catch(eOtp) {

      Logger.log("Error syncing ATTENDANCE_OTP in applyApprovedRequest: " + eOtp.toString());

    }



    SpreadsheetApp.flush();

  } catch (e) {

    Logger.log("Error in applyApprovedRequest: " + e.toString());

  }

}



/**

 * Calculates student attended days according to official guidelines:

 * - Weekly Offs (Sundays) are counted as Present / Attended.

 * - Present, Late with Present, OD, ML (Medical Leave), WFH, Early Exit are counted as Present.

 * - Missed check-in/out past 12 midnight are marked as Absent.

 * - Admin-denied records are masked as Absent (never displayed as "Denied").

 */

/**

 * Calculates student attended days according to official guidelines:

 * - Weekly Offs (Sundays) are counted as Present / Attended.

 * - Present, Late with Present, Late, OD, ML (Medical Leave), WFH, Early Exit, Admin Approved are counted as Present.

 * - Missed check-in/out without approval are marked as Absent.

 * - Admin-denied records are masked as Absent.

 * - Fully captures: Day No, Date, Day Name, In Time, Out Time, Entry Mode (RFID / Portal Check-in / Manual), Attendance Status, Credit, Remarks/Correction details, Batch Project Title, and Assigned Tasks.

 */

function calculateStudentAttendedDays_(registrationId, studentData) {

  try {

    if (!studentData) {

      const sResp = getStudentFullData(registrationId);

      if (sResp.status === 'success') studentData = sResp.studentData;

      else return { totalWorkingDays: 0, durationDays: 0, attendedDays: 0, absentDays: 0, dayLogs: [] };

    }



    const attendanceSheet = getSheet(SHEET_NAMES.ATTENDANCE);

    const otpSheet = getSheet(SHEET_NAMES.ATTENDANCE_OTP);

    const tasksSheet = getSheet(SHEET_NAMES.TASKS);

    const projectsSheet = getSheet(SHEET_NAMES.PROJECTS);

    const batchesSheet = getSheet(SHEET_NAMES.BATCHES);



    const toISODateStr_ = (val) => {

      if (!val) return null;

      if (val instanceof Date) return Utilities.formatDate(val, "GMT+5:30", "yyyy-MM-dd");

      let s = String(val).trim();

      if (/^\d{4}-\d{2}-\d{2}/.test(s)) return s.substring(0, 10);

      if (/^\d{1,2}[\/\-\.]\d{1,2}[\/\-\.]\d{4}/.test(s)) {

        let p = s.split(/[\/\-\.]/);

        return p[2] + '-' + p[1].padStart(2, '0') + '-' + p[0].padStart(2, '0');

      }

      let d = new Date(val);

      if (!isNaN(d.getTime())) return Utilities.formatDate(d, "GMT+5:30", "yyyy-MM-dd");

      return null;

    };



    const startISO = toISODateStr_(studentData.InternshipStartDate || studentData.StartDate);

    const endISO = toISODateStr_(studentData.InternshipEndDate || studentData.EndDate);

    const defDays = parseInt(studentData.DurationDays || 30, 10);



    // Retrieve Project Title and Tasks Assigned for the student

    let projectTitle = studentData.ProjectTitle || studentData.ProjectName || studentData.InterestedArea || '';

    if (!projectTitle && projectsSheet) {

      const pData = getSheetDataAsObjects(projectsSheet);

      const studentProject = pData.find(p => String(p.StudentRegistrationID || p.RegistrationID || '').trim().toUpperCase() === String(registrationId || '').trim().toUpperCase());

      if (studentProject) {

        projectTitle = studentProject.ProjectTitle || studentProject.ProjectName || studentProject.Title || '';

      }

    }

    if (!projectTitle && studentData.Batch && batchesSheet) {

      const bData = getSheetDataAsObjects(batchesSheet);

      const batchObj = bData.find(b => String(b.BatchName || b.BatchID || '').trim().toLowerCase() === String(studentData.Batch).trim().toLowerCase());

      if (batchObj) {

        projectTitle = batchObj.ProjectTitle || batchObj.ProjectName || batchObj.WorkArea || batchObj.SkillLearned || '';

      }

    }

    if (!projectTitle) projectTitle = 'General Electrical & Automation Project';



    // Retrieve Tasks Summary

    let totalTasksAssigned = 0;

    let totalTasksCompleted = 0;

    let taskNames = [];

    if (tasksSheet) {

      const tData = getSheetDataAsObjects(tasksSheet);

      const studentTasks = tData.filter(t => String(t.StudentRegistrationID || t.RegistrationID || '').trim().toUpperCase() === String(registrationId || '').trim().toUpperCase());

      totalTasksAssigned = studentTasks.length;

      studentTasks.forEach(t => {

        const s = String(t.Status || '').toLowerCase();

        if (s === 'completed' || s === 'approved' || s === 'done') totalTasksCompleted++;

        if (t.TaskTitle || t.Title || t.TaskName) taskNames.push(t.TaskTitle || t.Title || t.TaskName);

      });

    }



    if (!startISO || !endISO) {

      return {

        totalWorkingDays: defDays,

        durationDays: defDays,

        attendedDays: defDays,

        absentDays: 0,

        percentage: 100,

        projectTitle: projectTitle,

        batchName: studentData.Batch || 'N/A',

        tasksSummary: totalTasksAssigned > 0 ? `${totalTasksAssigned} Tasks (${totalTasksCompleted} Completed)` : 'Standard Internship Curriculum',

        dayLogs: []

      };

    }



    let attendanceData = [];

    if (attendanceSheet) {

      attendanceData = getSheetDataAsObjects(attendanceSheet).filter(r => String(r.StudentRegistrationID || '').trim().toUpperCase() === String(registrationId || '').trim().toUpperCase());

    }

    let requestsData = [];

    if (otpSheet) {

      requestsData = getSheetDataAsObjects(otpSheet).filter(r => String(r.RegistrationID || '').trim().toUpperCase() === String(registrationId || '').trim().toUpperCase());

    }



    let sParts = String(startISO).substring(0, 10).split('-');

    let current = new Date(parseInt(sParts[0], 10), parseInt(sParts[1], 10) - 1, parseInt(sParts[2], 10), 0, 0, 0, 0);

    let eParts = String(endISO).substring(0, 10).split('-');

    let end = new Date(parseInt(eParts[0], 10), parseInt(eParts[1], 10) - 1, parseInt(eParts[2], 10), 23, 59, 59, 999);

    let totalWorkingDays = 0;

    let attendedDays = 0;

    let absentDays = 0;

    let sundaysCount = 0;

    let presentCount = 0;

    let lateCount = 0;

    let lateWithPresentCount = 0;

    let odCount = 0;

    let mlCount = 0;

    let wfhCount = 0;



    // Auto-heal inverted dates (e.g. start > end)

    if (current > end) {

      end = new Date(current.getFullYear(), current.getMonth(), current.getDate() + defDays - 1, 23, 59, 59, 999);

    }



    let dayLogs = [];

    let dayIndex = 1;

    let safety = 0;



    while (current <= end && safety < 10000) {

      safety++;

      const dISO = toISODateStr_(current);

      const isSunday = current.getDay() === 0;



      // Filter out admin-denied records (masked as Absent on student report)

      let dayAtt = attendanceData.filter(r => toISODateStr_(r.Date) === dISO && String(r.Status || '').toUpperCase() !== 'DENIED' && String(r.ApprovalStatus || '').toUpperCase() !== 'DENIED');

      let attRecord = dayAtt.find(r => r.OutTime && r.OutTime !== '' && r.OutTime !== 'N/A') || dayAtt[0];



      let dayReq = requestsData.filter(r => {

        return toISODateStr_(r.TargetDate) === dISO && String(r.Status || '').toLowerCase() === 'approved';

      });

      let approvedReq = dayReq[0];



      let isAttended = false;
      let displayStatus = 'Absent';
      let inTime = attRecord && attRecord.InTime ? attRecord.InTime : '-';
      let outTime = attRecord && attRecord.OutTime ? attRecord.OutTime : '-';
      let entryMode = '-';
      let remarks = '-';

      // Status-Aware Logic: Check candidate status & future dates
      const candStatus_ = String((studentData && (studentData.ApplicationStatus || studentData.Status)) || '').trim().toLowerCase();
      const isCandPending_ = (candStatus_ === 'pending' || candStatus_ === '');
      const isCandCompleted_ = (candStatus_ === 'completed');
      const todayISO_ = Utilities.formatDate(new Date(), "GMT+5:30", "yyyy-MM-dd");
      const isInternshipNotStarted_ = (startISO && startISO > todayISO_ && !isCandCompleted_);
      const isFuture_ = (dISO > todayISO_);
      const isToday_ = (dISO === todayISO_);

      if (isCandPending_) {
        displayStatus = 'Pending Approval';
        isAttended = false;
        entryMode = 'Pending Approval';
        remarks = 'Attendance Inactive (Pending Approval)';
        inTime = '--:--';
        outTime = '--:--';
      } else if (isInternshipNotStarted_ || (isFuture_ && !isCandCompleted_)) {
        isAttended = false;
        inTime = '--:--';
        outTime = '--:--';
        if (isSunday) {
          displayStatus = 'Weekly Off (Upcoming)';
          entryMode = 'System (Weekly Off)';
          remarks = 'Upcoming Scheduled Weekly Off';
        } else {
          displayStatus = 'Upcoming';
          entryMode = 'Scheduled Slot';
          remarks = isInternshipNotStarted_ ? 'Upcoming (Internship Not Started)' : 'Upcoming Scheduled Day';
        }
      } else if (attRecord) {
        const s = String(attRecord.Status || '').trim();
        const sLower = s.toLowerCase();
        if (sLower.includes('present') || sLower.includes('late') || sLower.includes('early') || sLower === 'od' || sLower === 'wfh' || sLower.includes('medical') || sLower.includes('ml')) {
          isAttended = true;
          displayStatus = s;
          if (sLower === 'late with present') lateWithPresentCount++;
          else if (sLower.includes('late')) lateCount++;
          else if (sLower === 'od') odCount++;
          else if (sLower === 'wfh') wfhCount++;
          else if (sLower.includes('medical') || sLower.includes('ml')) mlCount++;
          else presentCount++;

          // Entry Mode Detection
          if (attRecord.EntryMode && String(attRecord.EntryMode).trim() !== '') {
            entryMode = String(attRecord.EntryMode).trim();
          } else if (attRecord.checkin_source) {
            entryMode = attRecord.checkin_source === 'ADMIN_APPROVAL' ? 'Admin Approved' : String(attRecord.checkin_source);
          } else if (attRecord.Remarks && String(attRecord.Remarks).toUpperCase().includes('RFID')) {
            entryMode = 'RFID Punch';
          } else if (attRecord.Remarks && String(attRecord.Remarks).toUpperCase().includes('APPROVED')) {
            entryMode = 'Admin Approved';
          } else if (inTime && inTime !== '-') {
            entryMode = 'Portal Check-in';
          } else {
            entryMode = 'Manual Log';
          }

          remarks = attRecord.Remarks ? String(attRecord.Remarks).trim() : 'Regular Check-in/Out Recorded';
        } else {
          displayStatus = 'Absent';
          absentDays++;
          entryMode = '-';
          remarks = 'No valid check-in recorded / Absent';
        }
      } else if (approvedReq) {
        const rawAction = approvedReq.ActionType || approvedReq.LeaveType || 'Approved Leave';
        const isDiaryCorr = String(rawAction).toLowerCase().includes('diarycorrection') || String(rawAction).toLowerCase().includes('correction');
        const leaveType = isDiaryCorr ? 'Diary Correction' : rawAction;
        isAttended = true;
        displayStatus = isDiaryCorr ? 'Present' : `${leaveType} (Present)`;
        entryMode = isDiaryCorr ? 'Admin Approved (Diary Correction)' : `Admin Approved (${leaveType})`;
        remarks = `Approved Request: ${approvedReq.Reason || approvedReq.AdminComment || 'Regularized by Admin'}`;
        if (inTime === '-' || !inTime || inTime === '--:--') inTime = '09:30 AM';
        if (outTime === '-' || !outTime || outTime === '--:--') outTime = '05:30 PM';
        if (leaveType === 'WFH') wfhCount++;
        else if (leaveType === 'OD') odCount++;
        else if (leaveType.includes('Medical') || leaveType.includes('ML')) mlCount++;
        else presentCount++;
      } else if (isSunday) {
        // Only past/today Sundays during active internship are counted as Weekly Off (Present)
        sundaysCount++;
        isAttended = true;
        displayStatus = 'Weekly Off (Present)';
        entryMode = 'System (Weekly Off)';
        remarks = 'Weekly Off / Official Holiday';
      } else if (isToday_) {
        displayStatus = 'Upcoming';
        isAttended = false;
        entryMode = 'Scheduled Slot';
        remarks = 'Scheduled Slot (Awaiting Punch)';
        inTime = '--:--';
        outTime = '--:--';
      } else {
        displayStatus = 'Absent';
        absentDays++;
        entryMode = '-';
        remarks = 'Absent / Missed Punch';
      }



      if (isAttended) {

        attendedDays++;

        if (inTime === '-' || !inTime || inTime === '--:--') inTime = '09:30 AM';

        if (outTime === '-' || !outTime || outTime === '--:--') outTime = '05:30 PM';

      }

      totalWorkingDays++;



      dayLogs.push({

        dayNumber: `Day ${dayIndex}`,

        daySequence: dayIndex,

        date: formatDate(current),

        dateISO: dISO,

        dayName: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][current.getDay()],

        inTime: inTime,

        outTime: outTime,

        entryMode: entryMode,

        status: displayStatus,

        credit: isAttended ? 'Attended (1)' : 'Absent (0)',

        remarks: remarks,

        isAttended: isAttended,

        isSunday: isSunday

      });



      dayIndex++;

      current.setDate(current.getDate() + 1);

    }



    return {

      totalWorkingDays: totalWorkingDays,

      durationDays: totalWorkingDays,

      attendedDays: attendedDays,

      absentDays: absentDays,

      presentCount: presentCount,

      lateCount: lateCount,

      lateWithPresentCount: lateWithPresentCount,

      sundaysCount: sundaysCount,

      odCount: odCount,

      mlCount: mlCount,

      wfhCount: wfhCount,

      percentage: (function() {
        const candSt = String((studentData && (studentData.ApplicationStatus || studentData.Status)) || '').trim().toLowerCase();
        if (candSt === 'pending' || candSt === '') return 0;
        const elapsed = attendedDays + absentDays;
        return elapsed > 0 ? Math.round((attendedDays / elapsed) * 100) : 100;
      })(),
      isPending: (function() {
        const candSt = String((studentData && (studentData.ApplicationStatus || studentData.Status)) || '').trim().toLowerCase();
        return (candSt === 'pending' || candSt === '');
      })(),

      projectTitle: projectTitle,

      batchName: studentData.Batch || 'N/A',

      tasksSummary: totalTasksAssigned > 0 ? `${totalTasksAssigned} Tasks Assigned (${totalTasksCompleted} Completed)` : 'Standard Internship Curriculum Tasks',

      dayLogs: dayLogs

    };

  } catch (err) {

    Logger.log('calculateStudentAttendedDays_ error: ' + err);

    return { totalWorkingDays: 0, durationDays: 0, attendedDays: 0, absentDays: 0, dayLogs: [] };

  }

}



/**

 * Returns comprehensive student attendance calendar data with rich cell metadata,

 * day index, diary submission status, slot timing vs actual, and overall stats.

 */

function getAttendanceCalendarData(regId) {

  try {

    if (!regId) return { status: 'error', message: 'Registration ID required' };

    const studentResp = getStudentFullData(regId);

    if (studentResp.status !== 'success' || !studentResp.studentData) {

      return { status: 'error', message: 'Student not found: ' + regId };

    }

    const s = studentResp.studentData;



    const toISODateStr_ = (val) => {

      if (!val) return null;

      if (val instanceof Date) return Utilities.formatDate(val, "GMT+5:30", "yyyy-MM-dd");

      let str = String(val).trim();

      if (/^\d{4}-\d{2}-\d{2}/.test(str)) return str.substring(0, 10);

      if (/^\d{1,2}[\/\-\.]\d{1,2}[\/\-\.]\d{4}/.test(str)) {

        let p = str.split(/[\/\-\.]/);

        return p[2] + '-' + p[1].padStart(2, '0') + '-' + p[0].padStart(2, '0');

      }

      let d = new Date(val);

      if (!isNaN(d.getTime())) return Utilities.formatDate(d, "GMT+5:30", "yyyy-MM-dd");

      return null;

    };



    // Use unified attendance engine (Single Source of Truth)

    const attStats = calculateStudentAttendedDays_(regId, s);



    // Fetch Student Diary entries for this student to know which days diary is submitted

    const diaryMap = {};

    try {

      const dSheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

      if (dSheet) {

        const dData = getSheetDataAsObjects(dSheet);

        dData.filter(r => String(r.StudentRegistrationID || r.RegistrationID || r.RegID || '').trim().toUpperCase() === String(regId).trim().toUpperCase()).forEach(r => {

          const dtISO = toISODateStr_(r.Date);

          if (dtISO) diaryMap[dtISO] = { submitted: true, status: r.Status || 'Submitted', hours: r.HoursSpent || 8 };

        });

      }

    } catch(dErr) {

      Logger.log("Diary lookup in getAttendanceCalendarData warning: " + dErr);

    }



    // Fetch slot timings

    const batchId = s.Batch || '';

    const todayStr = getTodayStr ? getTodayStr() : Utilities.formatDate(new Date(), "GMT+5:30", "yyyy-MM-dd");

    let slotInfo = { start: '09:30 AM', end: '05:30 PM', earlyBefore: '04:30 PM', type: 'SYSTEM' };

    try {

      if (typeof getSlotTiming === 'function') {

        slotInfo = getSlotTiming(batchId, todayStr, regId);

      }

    } catch(slErr) {

      Logger.log("Slot timing lookup warning: " + slErr);

    }



    // Build structured attendance dictionary keyed by ISO date "YYYY-MM-DD"

    const attendanceMap = {};

    (attStats.dayLogs || []).forEach(log => {

      const dISO = log.dateISO;

      const diary = diaryMap[dISO] || { submitted: false, status: log.isSunday ? 'Weekly Off' : 'Not Submitted' };

      attendanceMap[dISO] = {

        daySequence: log.daySequence,

        dayNumber: log.dayNumber,

        dayName: log.dayName,

        status: log.status,

        inTime: log.inTime,

        outTime: log.outTime,

        entryMode: log.entryMode,

        credit: log.credit,

        remarks: log.remarks,

        isAttended: log.isAttended,

        isSunday: log.isSunday,

        adminComment: log.remarks && log.remarks.toLowerCase().includes('admin') ? log.remarks : '',

        diarySubmitted: diary.submitted,

        diaryStatus: diary.status,

        slotStart: slotInfo.start || '09:30 AM',

        slotEnd: slotInfo.end || '05:30 PM'

      };

    });



    const startISO = toISODateStr_(s.InternshipStartDate || s.StartDate);

    const endISO = toISODateStr_(s.InternshipEndDate || s.EndDate);



    return {

      status: 'success',

      internStart: startISO,

      internEnd: endISO,

      studentData: {

        registrationId: s.RegistrationID,

        name: getStudentFullName_(s),

        registerNumber: s.RegisterNumber || s.RegNo || s.StaffID || s.staffId || s.FacultyStaffId || s['Staff ID'] || '--',
        staffId: s.StaffID || s.staffId || s.FacultyStaffId || s['Staff ID'] || '',
        tagId: s.RFID_TagID || s.RFID || s.Rfid || invMap[regIdUpper] || '',
        college: s.CollegeName || s.College || '--',
        department: s.Department || s.Dept || '--',
        batch: s.Batch || 'Unassigned',

        phone: s.MobileNumber || s.Mobile || s.PhoneNumber || s.Phone || s.ContactNumber || s.MobileNo || '--',

        project: attStats.projectTitle || s.ProjectTitle || s.ProjectName || s.Domain || s.FieldWork || 'Field Work / Core',

        photoUrl: s.ProfilePhotoUrl || s.PhotoUrl || s.Photo || '',

        applicationStatus: s.ApplicationStatus || s.Status || 'Active'

      },

      stats: {

        totalWorkingDays: attStats.totalWorkingDays,

        durationDays: attStats.durationDays,

        attendedDays: attStats.attendedDays,

        absentDays: attStats.absentDays,

        presentCount: attStats.presentCount,

        lateCount: attStats.lateCount + (attStats.lateWithPresentCount || 0),

        wfhCount: attStats.wfhCount,

        odCount: attStats.odCount,

        mlCount: attStats.mlCount,

        sundaysCount: attStats.sundaysCount,

        percentage: attStats.percentage,

        pendingDays: Math.max(0, attStats.totalWorkingDays - attStats.attendedDays)

      },

      attendance: attendanceMap

    };

  } catch(e) {

    Logger.log("getAttendanceCalendarData error: " + e.toString());

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Backfills a student's approved profile photo across core database sheets.

 */

function backfillStudentProfilePhoto_(regId, photoUrl) {

  if (!regId || !photoUrl) return;

  const targetId = String(regId).trim().toUpperCase();

  const sheetsToUpdate = [SHEET_NAMES.REGISTRATIONS, 'Closed and Opt-out', SHEET_NAMES.CONSOLIDATED_INTERNSHIPS, SHEET_NAMES.CERTIFICATE_DATA];

  sheetsToUpdate.forEach(sheetName => {

    try {

      const sh = getSheet(sheetName);

      if (!sh) return;

      const data = sh.getDataRange().getValues();

      if (data.length < 2) return;

      const headers = data[0].map(h => String(h || '').trim());

      const regCol = headers.findIndex(h => {

        const clean = h.toLowerCase().replace(/[^a-z0-9]/g, '');

        return ['registrationid', 'studentregistrationid', 'regid', 'regno', 'registerno', 'registernumber', 'studentregid'].includes(clean);

      });

      if (regCol === -1) return;

      let photoCol = headers.findIndex(h => {

        const clean = h.toLowerCase().replace(/[^a-z0-9]/g, '');

        return ['profilephotourl', 'photourl', 'profilephoto', 'photo', 'passportphoto', 'passportsizephoto', 'passportphotourl', 'studentphoto'].includes(clean);

      });

      for (let r = 1; r < data.length; r++) {

        if (String(data[r][regCol] || '').trim().toUpperCase() === targetId) {

          const currentVal = photoCol !== -1 ? String(data[r][photoCol] || '').trim() : '';

          if (!currentVal || currentVal === '--' || currentVal === '-') {

            if (photoCol === -1) {

              photoCol = headers.length;

              sh.getRange(1, photoCol + 1).setValue('ProfilePhotoUrl');

            }

            sh.getRange(r + 1, photoCol + 1).setValue(photoUrl);

          }

          break;

        }

      }

    } catch(e) {

      Logger.log("backfillStudentProfilePhoto_ error in " + sheetName + ": " + e);

    }

  });

}



/**

 * Retrieves comprehensive array of all student records for Universal Search,

 * Executive Dashboards, and Management modules.

 */

function getAllStudents() {

  try {

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);
    const mainData = regSheet ? (getSheetDataAsObjects(regSheet) || []) : [];

    // Also include candidate-specific sheets (Faculty, Employee, Apprentice)
    let facultyData = [];
    let employeeData = [];
    let apprenticeData = [];
    try {
      const facSheet = getSheet(SHEET_NAMES.FACULTY_REGISTRATIONS || 'Faculty Registrations');
      if (facSheet) facultyData = getSheetDataAsObjects(facSheet) || [];
    } catch(fErr) {}
    try {
      const empSheet = getSheet(SHEET_NAMES.EMPLOYEE_REGISTRATIONS || 'Employee Registrations');
      if (empSheet) employeeData = getSheetDataAsObjects(empSheet) || [];
    } catch(eErr) {}
    try {
      const appSheet = getSheet(SHEET_NAMES.APPRENTICE_REGISTRATIONS || 'Apprentice Registrations');
      if (appSheet) apprenticeData = getSheetDataAsObjects(appSheet) || [];
    } catch(aErr) {}

    // Also include completed and opt-out students
    let closedData = [];
    try {
      const closedSheet = getSheet('Closed and Opt-out');
      if (closedSheet) {
        closedData = getSheetDataAsObjects(closedSheet) || [];
      }
    } catch(cErr) {}



    // Deduplicate: main registrations take priority

    const seenRegs = new Set();

    let data = [];

    mainData.forEach(s => {

      const rid = String(s.RegistrationID || s.RegistrationId || s.RegID || '').trim().toUpperCase();

      if (rid) seenRegs.add(rid);

      data.push(s);

    });

    facultyData.forEach(s => {
      const rid = String(s.RegistrationID || s.RegistrationId || s.RegID || '').trim().toUpperCase();
      if (rid && !seenRegs.has(rid)) { seenRegs.add(rid); s.CandidateType = 'Faculty'; data.push(s); }
    });
    employeeData.forEach(s => {
      const rid = String(s.RegistrationID || s.RegistrationId || s.RegID || '').trim().toUpperCase();
      if (rid && !seenRegs.has(rid)) { seenRegs.add(rid); s.CandidateType = 'Employee'; data.push(s); }
    });
    apprenticeData.forEach(s => {
      const rid = String(s.RegistrationID || s.RegistrationId || s.RegID || '').trim().toUpperCase();
      if (rid && !seenRegs.has(rid)) { seenRegs.add(rid); s.CandidateType = 'Apprentice'; data.push(s); }
    });
    closedData.forEach(s => {
      const rid = String(s.RegistrationID || s.RegistrationId || s.RegID || '').trim().toUpperCase();
      if (rid && !seenRegs.has(rid)) {
        seenRegs.add(rid);
        data.push(s);
      }
    });

    // Filter out permanently deleted candidates
    const delSet = getDeletedCandidateSet_();
    if (delSet.size > 0) {
      data = data.filter(s => {
        const rid = String(s.RegistrationID || s.registrationId || s.RegistrationId || s.RegID || s.regId || s['Registration ID'] || (s.details && (s.details.registrationId || s.details.RegistrationID)) || '').trim().toUpperCase();
        if (rid && delSet.has(rid)) return false;
        return true;
      });
    }
    // Ensure Faculty Mock candidate is present for document generator testing & selection (only if not deleted)
    if (delSet.has('GSV/2026/FAC/001')) seenRegs.add('GSV/2026/FAC/001');
    if (!seenRegs.has('GSV/2026/FAC/001')) {
      seenRegs.add('GSV/2026/FAC/001');
      data.unshift({
        RegistrationID: 'GSV/2026/FAC/001',
        RegistrationId: 'GSV/2026/FAC/001',
        FullName: 'Dr. K. Senthil Nathan',
        FirstName: 'Senthil Nathan',
        LastName: 'K',
        Gender: 'Male',
        CollegeName: 'VELAMMAL ENGINEERING COLLEGE',
        CollegeCode: '1112',
        CollegeDistrict: 'Chennai',
        RegisterNumber: 'FAC-ECE-1042',
        FacultyStaffId: 'FAC-ECE-1042',
        EducationType: 'Ph.D. / M.E. (VLSI Design)',
        Department: 'Electronics and Communication Engineering',
        Designation: 'Associate Professor',
        facultyDomain: 'Embedded Systems, IoT & Industrial Automation',
        facultyPassYear: '2012',
        facultyExperience: '12 Years',
        TeachingExperience: '12 Years',
        DateofBirth: '15/06/1986',
        MobileNumber: '9840123456',
        GmailID: 'senthil.nathan.faculty@velammal.edu.in',
        Address: 'Plot No. 42, Staff Quarters, Velammal Campus, Ambattur Redhills Road',
        Pincode: '600066',
        District: 'Chennai',
        InternshipStartDate: '01/06/2026',
        InternshipEndDate: '30/06/2026',
        DurationDays: '30',
        Batch: '',
        CandidateType: 'Faculty',
        InternshipType: 'Faculty',
        ApplicationStatus: 'Approved',
        Status: 'Approved',
        ProjectTitle: '',
        SkillLearned: 'Applied Electronics, IoT & Embedded Systems'
      });
    }



    // Build map of approved profile photo changes from STUDENT_REQUESTS

    const approvedPhotoMap = {};

    try {

      const reqSheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

      if (reqSheet) {

        const reqData = getSheetDataAsObjects(reqSheet) || [];

        reqData.forEach(r => {

          const rType = String(r.RequestType || r.Type || '').toLowerCase();

          const rStatus = String(r.Status || '').toLowerCase();

          const rRegId = String(r.RegistrationID || r.StudentRegistrationID || '').trim().toUpperCase();

          const rAttach = String(r.AttachmentUrl || r.PhotoUrl || r.Attachment || '').trim();

          if (rRegId && rAttach && (rType.includes('photo') || rType.includes('picture')) && rStatus === 'approved') {

            approvedPhotoMap[rRegId] = rAttach;

          }

        });

      }

    } catch(eReq) {

      Logger.log("Error querying approved photos from STUDENT_REQUESTS: " + eReq);

    }

    

    const formatDateStr = (val) => {

      if (!val) return '';

      if (val instanceof Date) return Utilities.formatDate(val, "GMT+5:30", "dd/MM/yyyy");

      let str = String(val).trim();

      if (/^\d{4}-\d{2}-\d{2}/.test(str)) {

        let p = str.substring(0, 10).split('-');

        return p[2] + '/' + p[1] + '/' + p[0];

      }

      return str;

    };



    // Load unified bulk attendance engine for 100% synchronized real attendance stats

    let attEngine = null;

    try {

      attEngine = calculateBulkStudentAttendanceMap_();

    } catch(aeErr) {

      Logger.log("Error initializing attEngine in getAllStudents: " + aeErr);

    }



    // Cross-reference RFID inventory so all views (Manage Students, Dossier, Export) have 100% sync

    const invMap = {};

    const invPhysMap = {};

    const invHandMap = {};

    try {

      const invSheet = getSheet(SHEET_NAMES.RFID_INVENTORY);

      if (invSheet) {

        const invRows = getSheetDataAsObjects(invSheet) || [];

        invRows.forEach(inv => {

          const aId = String(inv.AssignedTo || inv.assignedTo || inv.AssignedToID || inv.assignedToId || '').trim().toUpperCase();

          const rawTag = String(inv.RFID_TagID || inv.TagID || inv.tagId || '').trim();

          const tId = standardizeRfidFormat(rawTag);

          if (aId && tId) {

            invMap[aId] = tId;

            const phys = String(inv.PhysicalStatus || inv.physicalStatus || '').trim();

            const hand = String(inv.HandoverStatus || inv.handoverStatus || '').trim();

            if (phys) invPhysMap[aId] = phys;

            if (hand) invHandMap[aId] = hand;

          }

        });

      }

    } catch (invErr) {

      Logger.log("Error mapping RFID inventory in getAllStudents: " + invErr);

    }



    return data.map(s => {

      const regId = String(s.RegistrationID || s.RegistrationId || s.RegID || '').trim();

      const regIdUpper = regId.toUpperCase();

      const fullName = getStudentFullName_(s);

      let photoUrl = s.ProfilePhotoUrl || s.PhotoUrl || s.Photo || s.PassportPhoto || '';

      if ((!photoUrl || photoUrl === '--' || photoUrl === '-') && approvedPhotoMap[regIdUpper]) {

        photoUrl = approvedPhotoMap[regIdUpper];

        // Self-heal/backfill to sheets in background

        try {

          backfillStudentProfilePhoto_(regId, photoUrl);

        } catch(bfErr) {}

      }



      const startStr = formatDateStr(s.InternshipStartDate || s.StartDate);

      const endStr = formatDateStr(s.InternshipEndDate || s.EndDate);

      const status = s.ApplicationStatus || s.Status || 'Active';

      const duration = s.DurationDays || s.Duration || 30;

      

      // Portal Access Check

      const attAccessVal = s.AttendanceAccess;

      const isAccessUnlocked = (attAccessVal === undefined || attAccessVal === null || attAccessVal === '' || 

        (attAccessVal !== false && attAccessVal !== 'FALSE' && String(attAccessVal).trim().toUpperCase() !== 'FALSE' && 

         String(attAccessVal).trim().toUpperCase() !== 'LOCKED' && String(attAccessVal).trim().toUpperCase() !== 'REVOKED'));



      // Determine if there is any pending / incomplete item

      let pendingStatus = '';

      const statusLower = String(status).toLowerCase();

      if (statusLower === 'pending' || statusLower === 'awaiting') {

        pendingStatus = 'Pending Approval';

      } else if (!s.Batch || s.Batch === 'Unassigned' || s.Batch === '--' || s.Batch === '') {

        pendingStatus = 'Unassigned Batch';

      } else if (!s.InternshipStartDate || !s.InternshipEndDate) {

        pendingStatus = 'Dates Incomplete';

      } else if (!s.RegisterNumber || s.RegisterNumber === '--' || s.RegisterNumber === '') {

        pendingStatus = 'Reg No Missing';

      } else if (statusLower === 'inactive') {

        pendingStatus = 'Inactive';

      }



      let realAtt = { attendedDays: 0, absentDays: 0, percentage: 0, totalWorkingDays: 0 };

      try {

        if (attEngine && typeof attEngine._calculateForStudent === 'function') {

          realAtt = attEngine._calculateForStudent(s);

        }

      } catch(attErr) {

        Logger.log("Error calculating attendance for student " + regId + ": " + attErr);

      }

      const cCatResolved = getCandidateCategory_(s);
      return {
        candidateType: cCatResolved,
        category: cCatResolved,
        candidateCategory: cCatResolved,
        registrationId: regId,

        attendedDays: realAtt.attendedDays,

        absentDays: realAtt.absentDays,

        attendancePercentage: realAtt.percentage,

        percentage: realAtt.percentage,

        totalWorkingDays: realAtt.totalWorkingDays,

        name: fullName,

        firstName: s.FirstName || '',

        middleName: s.MiddleName || '',

        lastName: s.LastName || '',

        gmail: s.GmailID || s.Email || '',

        gender: s.Gender || '',

        registerNumber: s.RegisterNumber || s.RegNo || '--',

        college: s.CollegeName || s.College || '--',

        department: s.Department || s.Dept || '--',

        batch: s.Batch || 'Unassigned',

        phone: s.MobileNumber || s.Mobile || s.PhoneNumber || s.Phone || s.ContactNumber || s.MobileNo || '--',

        mobile: s.MobileNumber || s.Mobile || s.PhoneNumber || s.Phone || s.ContactNumber || s.MobileNo || '--',

        project: s.ProjectTitle || s.ProjectName || s.Domain || s.FieldWork || 'Field Work / Core',

        photoUrl: photoUrl,

        profilePhotoUrl: photoUrl,

        status: status,

        applicationStatus: status,

        actualStatus: s.Status || status,

        startDate: startStr,

        endDate: endStr,

        internshipStart: startStr,

        internshipEnd: endStr,

        durationDays: duration,

        duration: duration,

        attendanceAccess: isAccessUnlocked,

        portalAccess: isAccessUnlocked ? 'Unlocked' : 'Locked',

        rfidTag: s.RFID_TagID || s.RFID || s.Rfid || invMap[regIdUpper] || '',

        rfidPhysicalStatus: s.RFID_PhysicalStatus || s.PhysicalStatus || invPhysMap[regIdUpper] || '',

        rfidHandoverStatus: s.RFID_HandoverStatus || s.HandoverStatus || invHandMap[regIdUpper] || '',

        RFID_TagID: s.RFID_TagID || s.RFID || s.Rfid || invMap[regIdUpper] || '',

        RFID_PhysicalStatus: s.RFID_PhysicalStatus || s.PhysicalStatus || invPhysMap[regIdUpper] || '',

        RFID_HandoverStatus: s.RFID_HandoverStatus || s.HandoverStatus || invHandMap[regIdUpper] || '',

        pendingStatus: pendingStatus,

        hasDocuments: !!(s.BonafideUrl || s.DeclarationUrl || s.CollegeIdUrl || s.OtherUrl || s.ApplicationPdfId || s.OfferLetterPdfId),

        allMandatoryDone: !(pendingStatus && pendingStatus.includes('Incomplete')),

        certificateNumber: s.CertificateNumber || '',

        certificateIssued: !['pending', 'submitted', 'rejected'].includes(String(s.ApplicationStatus || s.Status || '').toLowerCase()) && !!( (s.CertificateLink && String(s.CertificateLink).trim().startsWith('http')) || (s.CertificateIssuedDate && String(s.CertificateIssuedDate).trim() !== '0' && String(s.CertificateIssuedDate).trim() !== '-') ),

        certificateLink: s.CertificateLink || '',

        appliedDate: formatDateStr(s.Timestamp),

        timestamp: formatDateStr(s.Timestamp),

        registrationDate: formatDateStr(s.Timestamp),

        approvalDate: formatDateStr(s.ApprovalDate),

        certificateIssuedDate: formatDateStr(s.CertificateIssuedDate),

        issuedDate: formatDateStr(s.CertificateIssuedDate),

        applicationPdfUrl: s.ApplicationPdfId ? (String(s.ApplicationPdfId).startsWith('http') ? s.ApplicationPdfId : 'https://drive.google.com/file/d/' + s.ApplicationPdfId + '/view') : '',

        offerLetterPdfUrl: s.OfferLetterPdfId ? (String(s.OfferLetterPdfId).startsWith('http') ? s.OfferLetterPdfId : 'https://drive.google.com/file/d/' + s.OfferLetterPdfId + '/view') : '',

        joiningLetterPdfUrl: s.JoiningLetterPdfId ? (String(s.JoiningLetterPdfId).startsWith('http') ? s.JoiningLetterPdfId : 'https://drive.google.com/file/d/' + s.JoiningLetterPdfId + '/view') : '',

        hardCopyStatus: s.HardCopyStatus || s.HardCopy || 'Pending',

        hardCopyDetails: s.HardCopyDetails || '',

        details: s,

        facultyStaffId: s.FacultyStaffId || s.StaffId || (cCatResolved === 'Faculty' ? (s.RegisterNumber || '') : ''),

        StaffId: s.FacultyStaffId || s.StaffId || (cCatResolved === 'Faculty' ? (s.RegisterNumber || '') : ''),

        designation: s.Designation || s.designation || (cCatResolved === 'Faculty' ? 'Assistant Professor' : ''),

        facultyDomain: (() => {
          let dom = String(s.facultyDomain || s.Domain || s.Specialization || s.SpecializationDomain || '').trim();
          if (/^(male|female|other|--)$/i.test(dom)) dom = '';
          return dom || (cCatResolved === 'Faculty' ? 'Embedded Systems & IoT' : '');
        })(),

        domain: (() => {
          let dom = String(s.facultyDomain || s.Domain || s.Specialization || s.SpecializationDomain || s.ProjectTitle || '').trim();
          if (/^(male|female|other|--)$/i.test(dom)) dom = '';
          return dom || (cCatResolved === 'Faculty' ? 'Embedded Systems & IoT' : '');
        })(),

        facultyExperience: (() => {
          let exp = String(s.TeachingExperience || s.TeachingWorkExperience || s.facultyExperience || s.Experience || '').trim();
          if (exp && /^\d+$/.test(exp) && parseInt(exp) < 100) exp = exp + ' Years';
          if (!exp && cCatResolved === 'Faculty') {
            if (s.Year && /^\d+$/.test(String(s.Year).trim()) && parseInt(s.Year) < 100) exp = String(s.Year).trim() + ' Years';
            else exp = '5 Years';
          }
          return exp;
        })(),

        teachingExperience: s.TeachingExperience || s.TeachingWorkExperience || s.facultyExperience || s.Experience || (cCatResolved === 'Faculty' ? '5 Years' : ''),

        interestedArea: s.InterestedArea || s.interestedArea || (cCatResolved === 'Faculty' ? 'R&D (IoT & Electronics)' : ''),

        educationType: s.EducationType || s.educationType || s.EducationalQualification || s.HighestQualification || s.Degree || '',

        year: s.Year || s.year || '',

        semester: s.Semester || s.semester || '',

        address: s.Address || s.ResidentialAddress || '',

        residentialAddress: s.ResidentialAddress || s.Address || '',

        district: s.District || '',

        pincode: s.Pincode || '',

        collegeDistrict: s.CollegeDistrict || s.District || '',

        collegeCode: s.CollegeCode || ''

      };

    });

  } catch (err) {

        Logger.log("getAllStudents error: " + err);
    return [];

  }

}



/**

 * Toggles a student's portal access between Unlocked (true) and Locked (false).

 * Writes directly to SHEET_NAMES.REGISTRATIONS and SHEET_NAMES.CONSOLIDATED_INTERNSHIPS.

 */

function toggleStudentPortalAccess(regId, newStatus) {

  try {

    regId = String(regId || '').trim();

    if (!regId) return { status: 'error', message: 'Missing Registration ID' };



    const lockStateStr = (newStatus === true || newStatus === 'true' || newStatus === 'Unlocked') ? 'TRUE' : 'LOCKED';

    const isUnlocked = (lockStateStr === 'TRUE');



    const updateInSheet = (sheetName) => {

      const sheet = getSheet(sheetName);

      if (!sheet) return false;

      const data = sheet.getDataRange().getValues();

      if (data.length < 2) return false;

      const headers = data[0].map(h => String(h).trim());

      const regIdCol = headers.indexOf('RegistrationID');

      let attAccessCol = headers.indexOf('AttendanceAccess');

      let diaryAccessCol = headers.indexOf('DiaryAccess');

      

      if (regIdCol === -1) return false;

      

      if (attAccessCol === -1) {

        sheet.getRange(1, headers.length + 1).setValue('AttendanceAccess');

        attAccessCol = headers.length;

      }

      if (diaryAccessCol === -1) {

        sheet.getRange(1, headers.length + 2).setValue('DiaryAccess');

        diaryAccessCol = headers.length + 1;

      }



      for (let r = 1; r < data.length; r++) {

        if (String(data[r][regIdCol]).trim() === regId) {

          sheet.getRange(r + 1, attAccessCol + 1).setValue(lockStateStr);

          if (diaryAccessCol !== -1) {

            sheet.getRange(r + 1, diaryAccessCol + 1).setValue(lockStateStr);

          }

          return true;

        }

      }

      return false;

    };



    updateInSheet(SHEET_NAMES.REGISTRATIONS);

    updateInSheet(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS);



    if (typeof executionCache !== 'undefined' && executionCache) {

      executionCache.delete(SHEET_NAMES.REGISTRATIONS);

      executionCache.delete(SHEET_NAMES.CONSOLIDATED_INTERNSHIPS);

    }



    return {

      status: 'success',

      isUnlocked: isUnlocked,

      portalAccess: isUnlocked ? 'Unlocked' : 'Locked',

      message: `Student portal access is now ${isUnlocked ? 'Unlocked' : 'Locked'}`

    };

  } catch (err) {

    Logger.log('toggleStudentPortalAccess error: ' + err);

    return { status: 'error', message: err.message };

  }

}



/**

 * Updates granular student portal permissions for Dossier tab.

 */

function updateStudentPermissions(regId, perms) {

  try {

    regId = String(regId || '').trim();

    if (!regId) return { status: 'error', message: 'Missing Registration ID' };

    

    const attState = perms && perms.attendance ? 'TRUE' : 'LOCKED';

    const diaryState = perms && perms.diary ? 'TRUE' : 'LOCKED';



    const sheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (sheet) {

      const data = sheet.getDataRange().getValues();

      const headers = data[0].map(h => String(h).trim());

      const regIdCol = headers.indexOf('RegistrationID');

      const attAccessCol = headers.indexOf('AttendanceAccess');

      const diaryAccessCol = headers.indexOf('DiaryAccess');

      

      if (regIdCol !== -1) {

        for (let r = 1; r < data.length; r++) {

          if (String(data[r][regIdCol]).trim() === regId) {

            if (attAccessCol !== -1) sheet.getRange(r + 1, attAccessCol + 1).setValue(attState);

            if (diaryAccessCol !== -1) sheet.getRange(r + 1, diaryAccessCol + 1).setValue(diaryState);

            break;

          }

        }

      }

    }

    return { status: 'success', message: 'Permissions updated successfully' };

  } catch (err) {

    return { status: 'error', message: err.message };

  }

}



/**

 * Generates an official Consolidated Attendance PDF Report (Form-4) for a student.

 * Seamlessly handles single regId string or options object { regId, batchName, startDate, endDate }.

 */


/**
 * Applies centered GSV logo watermark to all pages of Consolidated Attendance Form-4.
 */
function applyConsolidatedAttendanceWatermark_(doc, body, titleP, attTable, sigTable, wmLogs = []) {
  try {
    wmLogs.push("wm_start");
    const watermarkBlob = getGsvWatermarkBlob();
    if (!watermarkBlob) {
      wmLogs.push("no watermarkBlob");
      return;
    }
    wmLogs.push("got blob size=" + watermarkBlob.getBytes().length);

    try {
      let hdr = doc.getHeader();
      wmLogs.push("getHeader: " + (hdr ? "exists" : "null"));
      if (!hdr) hdr = doc.addHeader();
      wmLogs.push("addHeader: " + (hdr ? "success" : "null"));
      if (hdr) {
        const hp = hdr.appendParagraph('');
        hp.setSpacingBefore(0).setSpacingAfter(0);
        wmLogs.push("appendParagraph success");
        const pos = hp.addPositionedImage(watermarkBlob);
        wmLogs.push("addPositionedImage success id=" + pos.getId());
        pos.setWidth(340);
        pos.setHeight(187);
        pos.setLeftOffset(98);
        pos.setTopOffset(290);
        pos.setLayout(DocumentApp.PositionedLayout.ABOVE_TEXT);
        wmLogs.push("layout set success");
      }
    } catch(eHdr) {
      wmLogs.push("eHdr error: " + eHdr.toString());
      Logger.log("Form-4 Header watermark error: " + eHdr.toString());
    }

    // Ensure trailing empty paragraph in body takes 1pt so it never creates a blank trailing page
    if (body) {
      try {
        const nChildren = body.getNumChildren();
        if (nChildren > 0) {
          const lastEl = body.getChild(nChildren - 1);
          if (lastEl.getType() === DocumentApp.ElementType.PARAGRAPH) {
            const lastP = lastEl.asParagraph();
            if (lastP.getText().trim() === '') {
              lastP.setFontSize(1).setSpacingBefore(0).setSpacingAfter(0);
            }
          }
        }
      } catch(eTail) {
        wmLogs.push("eTail error: " + eTail.toString());
      }
    }
  } catch(err) {
    wmLogs.push("general error: " + err.toString());
  }
}

function generateConsolidatedAttendancePDF(target) {

  try {

    let regId = '';

    let options = {};

    if (typeof target === 'string') {

      regId = target.trim();

    } else if (target && typeof target === 'object') {

      options = target;

      regId = target.regId || target.registrationId || target.RegistrationID || '';

    }



    if (!regId) return { status: 'error', message: 'Student Registration ID is required.' };



    const studentInfo = getStudentFullData(regId);

    if (studentInfo.status !== 'success') return { status: 'error', message: 'Student data not found.' };



    const d = studentInfo.studentData;

    const name = getStudentFullName_(d);

    const attStats = calculateStudentAttendedDays_(regId, d);



    const docName = `Consolidated_Attendance_${regId}_${Date.now()}`;

    const doc = DocumentApp.create(docName);

    const body = doc.getBody();



    body.setMarginTop(20);

    body.setMarginBottom(20);

    body.setMarginLeft(26);

    body.setMarginRight(26);



    const mkStyle = (size, bold, color, align) => {

      const s = {};

      s[DocumentApp.Attribute.FONT_FAMILY] = 'Arial';

      s[DocumentApp.Attribute.FONT_SIZE] = size;

      s[DocumentApp.Attribute.BOLD] = !!bold;

      s[DocumentApp.Attribute.FOREGROUND_COLOR] = color || '#000000';

      s[DocumentApp.Attribute.HORIZONTAL_ALIGNMENT] = align || DocumentApp.HorizontalAlignment.LEFT;

      return s;

    };



    // Header Branding

    try {

      const logoBlob = getGsvFullLogoBlob();

      if (logoBlob) {

        const logoImg = body.appendImage(logoBlob);

        logoImg.setWidth(220);

        logoImg.setHeight(88);

        const pLogo = logoImg.getParent().asParagraph();

        pLogo.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

        pLogo.setSpacingAfter(4);

      }

    } catch(logoErr) {

      body.appendParagraph(COMPANY_NAME).setAttributes(mkStyle(16, true, '#0f172a', DocumentApp.HorizontalAlignment.CENTER));

    }

    body.appendParagraph('GSV Electrical Enterprises').setAttributes(mkStyle(18, true, '#ea580c', DocumentApp.HorizontalAlignment.CENTER));

    body.appendParagraph('ELECTRICAL AND ELECTRONICS PRODUCTS').setAttributes(mkStyle(11, true, '#1e293b', DocumentApp.HorizontalAlignment.CENTER));

    body.appendParagraph('AN ISO 9001 : 2015 CERTIFIED COMPANY | GSTIN: 33BJNPV0469B1Z5').setAttributes(mkStyle(8.5, true, '#475569', DocumentApp.HorizontalAlignment.CENTER));

    body.appendParagraph('New No 51/1 Old No 20 /1 Teeds garden 1st Street Sembiyam, Perambur, Chennai - 600011').setAttributes(mkStyle(8, false, '#64748b', DocumentApp.HorizontalAlignment.CENTER));

    body.appendParagraph('📞 ' + COMPANY_CONTACT + '  |  ✉ ' + COMPANY_EMAIL + '  |  🌐 ' + COMPANY_WEBSITE).setAttributes(mkStyle(8, false, '#64748b', DocumentApp.HorizontalAlignment.CENTER));

    

    const candCatAtt = getCandidateCategory_(d);
    let attFormTitle = 'CONSOLIDATED INTERNSHIP ATTENDANCE RECORD (FORM-4)';
    if (candCatAtt === 'Faculty') attFormTitle = 'CONSOLIDATED FACULTY INTERNSHIP ATTENDANCE RECORD (FORM-4)';
    else if (candCatAtt === 'Employee') attFormTitle = 'CONSOLIDATED EMPLOYEE TRAINING ATTENDANCE RECORD (FORM-4)';
    else if (candCatAtt === 'Apprentice') attFormTitle = 'CONSOLIDATED APPRENTICE TRAINING ATTENDANCE RECORD (FORM-4)';
    const titleP = body.appendParagraph(attFormTitle);

    titleP.setAttributes(mkStyle(11.5, true, '#1d4ed8', DocumentApp.HorizontalAlignment.CENTER));

    titleP.setSpacingBefore(4);

    titleP.setSpacingAfter(6);



    // Candidate & Project Metadata Table
    let metaTableData = [];
    if (candCatAtt === 'Faculty') {
      const fStaffId = d.FacultyStaffId || d.StaffId || d.EmployeeId || d.RegisterNumber || 'N/A';
      metaTableData = [
        ['Faculty Name', name, 'Registration ID', regId],
        ['College Name', d.CollegeName || 'N/A', 'Employee ID', fStaffId],
        ['Department', d.Department || 'N/A', 'Batch Name', d.Batch || ''],
        ['Project / Domain', attStats.projectTitle || d.facultyDomain || d.InterestedArea || 'Applied Electronics, IoT & Embedded Systems', 'Assigned Tasks', attStats.tasksSummary || 'Faculty Research & Practical Immersion'],
        ['Internship Period', `${formatDate(d.InternshipStartDate)} to ${formatDate(d.InternshipEndDate)}`, 'Scheduled Duration', `${attStats.durationDays || d.DurationDays || 30} Days`],
        ['Total Attended Days', `${attStats.attendedDays} Days (Including Weekly Offs)`, 'Attendance Rate', `${attStats.percentage}% (${attStats.attendedDays}/${attStats.totalWorkingDays} Days)`]
      ];
    } else if (candCatAtt === 'Employee') {
      const eEmpId = d.EmployeeId || d.companyEmployeeId || d.RegisterNumber || 'N/A';
      const compOrg = d.CompanyName || d.Company || d.CollegeName || 'Corporate Organization';
      metaTableData = [
        ['Employee Name', name, 'Registration ID', regId],
        ['Company Name', compOrg, 'Employee ID', eEmpId],
        ['Department / Division', d.Department || d.Designation || 'Engineering', 'Batch Name', d.Batch || ''],
        ['Training Program', attStats.projectTitle || d.trainingPurpose || 'Corporate Technical Upskilling', 'Assigned Tasks', attStats.tasksSummary || 'Industrial Automation & Embedded Systems'],
        ['Training Period', `${formatDate(d.InternshipStartDate)} to ${formatDate(d.InternshipEndDate)}`, 'Scheduled Duration', `${attStats.durationDays || d.DurationDays || 30} Days`],
        ['Total Attended Days', `${attStats.attendedDays} Days (Including Weekly Offs)`, 'Attendance Rate', `${attStats.percentage}% (${attStats.attendedDays}/${attStats.totalWorkingDays} Days)`]
      ];
    } else if (candCatAtt === 'Apprentice') {
      const aAppId = d.ApprenticeID || d.RegisterNumber || 'N/A';
      metaTableData = [
        ['Apprentice Name', name, 'Registration ID', regId],
        ['Training Organization', 'GSV Electrical Enterprises', 'Apprentice ID', aAppId],
        ['Trade / Discipline', d.Department || d.ApprenticeScopes || 'Technical Apprentice', 'Batch Name', d.Batch || ''],
        ['Apprenticeship Scope', attStats.projectTitle || 'Industrial Apprenticeship Training', 'Assigned Tasks', attStats.tasksSummary || 'Practical Workshop Training'],
        ['Training Period', `${formatDate(d.InternshipStartDate)} to ${formatDate(d.InternshipEndDate)}`, 'Scheduled Duration', `${attStats.durationDays || d.DurationDays || 180} Days`],
        ['Total Attended Days', `${attStats.attendedDays} Days (Including Weekly Offs)`, 'Attendance Rate', `${attStats.percentage}% (${attStats.attendedDays}/${attStats.totalWorkingDays} Days)`]
      ];
    } else {
      metaTableData = [
        ['Student Name', name, 'Registration ID', regId],
        ['College Name', d.CollegeName || 'N/A', 'Register Number', d.RegisterNumber || 'N/A'],
        ['Department', d.Department || 'N/A', 'Batch Name', d.Batch || ''],
        ['Project Title', attStats.projectTitle || '', 'Assigned Tasks', attStats.tasksSummary || 'Standard Curriculum'],
        ['Internship Period', `${formatDate(d.InternshipStartDate)} to ${formatDate(d.InternshipEndDate)}`, 'Scheduled Duration', `${attStats.durationDays || d.DurationDays || 30} Days`],
        ['Total Attended Days', `${attStats.attendedDays} Days (Including Weekly Offs)`, 'Attendance Rate', `${attStats.percentage}% (${attStats.attendedDays}/${attStats.totalWorkingDays} Days)`]
      ];
    }



    const metaTable = body.appendTable(metaTableData);

    metaTable.setBorderColor('#cbd5e1');

    for (let r = 0; r < metaTable.getNumRows(); r++) {

      const row = metaTable.getRow(r);

      for (let c = 0; c < row.getNumCells(); c++) {

        const cell = row.getCell(c);

        cell.setPaddingTop(2).setPaddingBottom(2).setPaddingLeft(4).setPaddingRight(4);

        const p = cell.getChild(0).asParagraph();

        p.setFontSize(8.5);

        if (c === 0 || c === 2) {

          cell.setBackgroundColor('#f8fafc');

          p.setBold(true).setForegroundColor('#334155');

        } else {

          p.setBold(c === 1 && r === 0).setForegroundColor('#0f172a');

        }

      }

    }



    // Summary Statistics Cards

    const summaryTitle = body.appendParagraph('ATTENDANCE SUMMARY STATISTICS:');

    summaryTitle.setAttributes(mkStyle(9.5, true, '#0f172a'));

    summaryTitle.setSpacingBefore(8);

    summaryTitle.setSpacingAfter(4);



    const statsTableData = [

      ['Total Duration', 'Attended Days', 'Absent Days', 'Present (On-Time)', 'Late / Grace', 'WFH / OD / Medical', 'Sundays (Weekly Off)'],

      [

        `${attStats.totalWorkingDays} Days`,

        `${attStats.attendedDays} Days`,

        `${attStats.absentDays} Days`,

        `${attStats.presentCount} Days`,

        `${attStats.lateCount + attStats.lateWithPresentCount} Days`,

        `${attStats.wfhCount + attStats.odCount + attStats.mlCount} Days`,

        `${attStats.sundaysCount} Days`

      ]

    ];



    const statsTable = body.appendTable(statsTableData);

    statsTable.setBorderColor('#cbd5e1');

    for (let c = 0; c < 7; c++) {

      const hCell = statsTable.getRow(0).getCell(c);

      hCell.setBackgroundColor('#e2e8f0');

      hCell.setPaddingTop(2).setPaddingBottom(2).setPaddingLeft(2).setPaddingRight(2);

      const hp = hCell.getChild(0).asParagraph();

      hp.setFontSize(7.5).setBold(true).setAlignment(DocumentApp.HorizontalAlignment.CENTER).setForegroundColor('#1e293b');



      const vCell = statsTable.getRow(1).getCell(c);

      vCell.setBackgroundColor('#ffffff');

      vCell.setPaddingTop(2).setPaddingBottom(2).setPaddingLeft(2).setPaddingRight(2);

      const vp = vCell.getChild(0).asParagraph();

      vp.setFontSize(8).setBold(true).setAlignment(DocumentApp.HorizontalAlignment.CENTER).setForegroundColor(c === 1 ? '#15803d' : (c === 2 ? '#b91c1c' : '#0f172a'));

    }



    // Filter logs if custom range or date options provided

    let logsToRender = attStats.dayLogs || [];

    if (options.startDate && options.endDate) {

      const sDateISO = options.startDate;

      const eDateISO = options.endDate;

      logsToRender = logsToRender.filter(log => log.dateISO >= sDateISO && log.dateISO <= eDateISO);

    }



    // Day-by-Day Table

    const rangeSub = (options.startDate && options.endDate) ? ` (${formatDate(options.startDate)} to ${formatDate(options.endDate)})` : '';

    const logTitle = body.appendParagraph('DAY-BY-DAY ATTENDANCE LOG' + rangeSub + ':');

    logTitle.setAttributes(mkStyle(9.5, true, '#0f172a'));

    logTitle.setSpacingBefore(8);

    logTitle.setSpacingAfter(4);



    const tableData = [

      ['Day No', 'Date', 'Day', 'In Time', 'Out Time', 'Entry Mode', 'Attendance Status', 'Credit', 'Remarks / Details']

    ];



    logsToRender.forEach(log => {

      tableData.push([

        String(log.dayNumber),

        log.date,

        log.dayName,

        log.inTime,

        log.outTime,

        log.entryMode || '-',

        log.status,

        log.credit,

        log.remarks || '-'

      ]);

    });



    const attTable = body.appendTable(tableData);

    attTable.setBorderColor('#cbd5e1');

    

    // Style header row

    const headRow = attTable.getRow(0);

    for (let c = 0; c < headRow.getNumCells(); c++) {

      const cell = headRow.getCell(c);

      cell.setBackgroundColor('#1e3a8a');

      cell.setPaddingTop(1.5).setPaddingBottom(1.5).setPaddingLeft(2.5).setPaddingRight(2.5);

      const p = cell.getChild(0).asParagraph();

      p.setFontSize(7.5).setBold(true).setForegroundColor('#ffffff').setAlignment(DocumentApp.HorizontalAlignment.CENTER);

    }



    // Style data rows

    for (let r = 1; r < attTable.getNumRows(); r++) {

      const row = attTable.getRow(r);

      const isSun = attStats.dayLogs[r - 1] && attStats.dayLogs[r - 1].isSunday;

      const isAtt = attStats.dayLogs[r - 1] && attStats.dayLogs[r - 1].isAttended;

      const rowBg = isSun ? '#f8fafc' : (r % 2 === 0 ? '#f1f5f9' : '#ffffff');



      for (let c = 0; c < row.getNumCells(); c++) {

        const cell = row.getCell(c);

        cell.setBackgroundColor(rowBg);

        cell.setPaddingTop(2).setPaddingBottom(2).setPaddingLeft(3).setPaddingRight(3);

        const p = cell.getChild(0).asParagraph();

        p.setFontSize(7.2).setForegroundColor('#1e293b');



        if (c === 0 || c === 1 || c === 2 || c === 3 || c === 4 || c === 7) {

          p.setAlignment(DocumentApp.HorizontalAlignment.CENTER);

        } else {

          p.setAlignment(DocumentApp.HorizontalAlignment.LEFT);

        }



        if (c === 6) { // Attendance Status

          p.setBold(true);

          if (isSun) p.setForegroundColor('#2563eb');

          else if (isAtt) p.setForegroundColor('#15803d');

          else p.setForegroundColor('#dc2626');

        } else if (c === 7) { // Credit

          p.setBold(true);

          p.setForegroundColor(isAtt ? '#15803d' : '#dc2626');

        }

      }

    }



    // Signatures / Footer

    const sigP = body.appendParagraph('');

    sigP.setSpacingBefore(6);



    const sigTable = body.appendTable([

      ['\n___________________________\nIndustrial Supervisor / Mentor\nGSV Electrical Enterprises', '\n___________________________\nAuthorized Signatory & Seal\nGSV Electrical Enterprises']

    ]);

    sigTable.setBorderWidth(0);

    sigTable.getRow(0).getCell(0).getChild(0).asParagraph().setFontSize(8.5).setAlignment(DocumentApp.HorizontalAlignment.LEFT).setForegroundColor('#334155');

    sigTable.getRow(0).getCell(1).getChild(0).asParagraph().setFontSize(8.5).setAlignment(DocumentApp.HorizontalAlignment.RIGHT).setForegroundColor('#334155');



    // Apply centered GSV watermark on all pages of Form-4
    const wmLogs = []; applyConsolidatedAttendanceWatermark_(doc, body, titleP, attTable, sigTable, wmLogs);

    // Save and export PDF

    doc.saveAndClose();

    const pdfBlob = DriveApp.getFileById(doc.getId()).getAs(MimeType.PDF);

    const tempFolderId = getSystemFolderId('generated');

    const targetFolder = DriveApp.getFolderById(tempFolderId);

    const finalPdf = targetFolder.createFile(pdfBlob).setName(`Consolidated_Attendance_${regId}.pdf`);

    DriveApp.getFileById(doc.getId()).setTrashed(true);



    // Trash old file if exists (Prevents duplicates in Drive)

    try {

      const oldDoc = getExistingDocFileId(regId, 'attendanceDocument');

      if (oldDoc && oldDoc.fileId && oldDoc.fileId !== finalPdf.getId()) {

        try {

          DriveApp.getFileById(oldDoc.fileId).setTrashed(true);

          Logger.log(`Trashed old attendanceDocument PDF: ${oldDoc.fileId}`);

        } catch (trErr) {

          Logger.log(`Could not trash old attendanceDocument: ${trErr.toString()}`);

        }

      }

    } catch(delErr) {

      Logger.log(`Error checking old attendance doc: ${delErr.toString()}`);

    }



    // Log/Update in generated documents

    const docSheet = getSheet(SHEET_NAMES.GENERATED_DOCUMENTS);

    if (docSheet) {

      const docData = docSheet.getDataRange().getValues();

      const regColIdx = docData[0].indexOf("StudentRegistrationID");

      const typeColIdx = docData[0].indexOf("DocType");

      let existingDocRow = -1;

      if (regColIdx !== -1 && typeColIdx !== -1) {

        for (let i = 1; i < docData.length; i++) {

          if (String(docData[i][regColIdx]).toUpperCase() === regId.toUpperCase() && docData[i][typeColIdx] === 'attendanceDocument') {

            existingDocRow = i + 1;

            break;

          }

        }

      }

      if (existingDocRow !== -1) {

        const docHeaders = docSheet.getRange("1:1").getValues()[0];

        docSheet.getRange(existingDocRow, docHeaders.indexOf("DocUrl") + 1).setValue(finalPdf.getUrl());

        docSheet.getRange(existingDocRow, docHeaders.indexOf("PdfFileId") + 1).setValue(finalPdf.getId());

        docSheet.getRange(existingDocRow, docHeaders.indexOf("GeneratedDate") + 1).setValue(new Date());

      } else {

        const headers = docSheet.getRange(1, 1, 1, docSheet.getLastColumn()).getValues()[0].map(h => h.toString().trim());

        const docId = 'ATT_DOC_' + Date.now();

        const newRow = headers.map(h => {

          if (h === 'DocumentID') return docId;

          if (h === 'StudentRegistrationID') return regId;

          if (h === 'DocType') return 'attendanceDocument';

          if (h === 'ReferenceNumber') return 'REF-ATT-' + regId;

          if (h === 'DocUrl') return finalPdf.getUrl();

          if (h === 'PdfFileId') return finalPdf.getId();

          if (h === 'GeneratedDate') return new Date();

          if (h === 'SentViaEmail') return 'No';

          return '';

        });

        docSheet.appendRow(newRow);

      }

    }



    return {

      status: 'success',

      wmLogs: wmLogs,

      message: 'Consolidated attendance document generated successfully.',

      url: finalPdf.getUrl(),

      driveLink: finalPdf.getUrl(),

      fileId: finalPdf.getId(),

      attStats: attStats

    };

  } catch (e) {

    Logger.log('generateConsolidatedAttendancePDF error: ' + e.toString());

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Enhanced Official Notice Generator & Email Dispatcher.

 * Supports:

 * - disciplinaryWarning (7-day deadline before record erasure)

 * - certDelayNotice (Certificate printing delay with soft copy attachment)

 * - pendingDocsNotice (Missing docs upload prompt)

 * - incompleteAttendanceNotice (Incomplete attendance / diary logs prompt)

 */

function sendStudentOfficialNotice(regId, noticeType, customReason, deadlineDays, opts) {

  try {

    noticeType = noticeType || 'disciplinaryWarning';

    deadlineDays = parseInt(deadlineDays || 7, 10);

    opts = opts || {};



    const studentInfo = getStudentFullData(regId);

    if (studentInfo.status !== 'success') {

      return { status: 'error', message: 'Student data not found.' };

    }



    const d = studentInfo.studentData;

    let name = getStudentFullName_(d);

    if (!name || name === 'N/A') name = 'Student (' + regId + ')';

    const email = d.GmailID || d.gmail || d.Email || d.email;



    if (!email) {

      return { status: 'error', message: 'Student email address missing.' };

    }



    const zone = Session.getScriptTimeZone() || 'Asia/Kolkata';

    const todayStr = Utilities.formatDate(new Date(), zone, 'dd MMMM yyyy');

    const deadlineDate = new Date();

    deadlineDate.setDate(deadlineDate.getDate() + deadlineDays);

    const deadlineStr = Utilities.formatDate(deadlineDate, zone, 'dd MMMM yyyy');



    const fmtDate_ = (raw) => {

      if (!raw) return null;

      try { return Utilities.formatDate(new Date(raw), zone, 'dd MMMM yyyy'); }

      catch(e) { return String(raw); }

    };



    const college = d.CollegeName || d.college || d.Institution || 'N/A';

    const phone = d.MobileNumber || d.mobile || d.phone || 'N/A';

    const regNo = d.RegisterNumber || d.registerNumber || d.rollNo || d.RollNo || 'N/A';

    

    // Department & Year

    const deptRaw = d.Department || d.department || d.branch || d.Branch || 'Engineering & Technology';

    const yearRaw = d.Year || d.YearOfStudy || d.year || d.AcademicYear || '';

    let department = deptRaw;

    if (yearRaw && yearRaw !== 'N/A' && yearRaw !== '(N/A)' && !department.includes(yearRaw)) {

      department = `${department} (${yearRaw})`;

    }



    // Batch

    let batch = d.Batch || d.batch || d.BatchName || d.batchName || '';

    if (!batch || batch === 'N/A' || batch.toLowerCase() === 'unassigned') {

      batch = 'General Batch (Technical Operations)';

    }



    // Project Area / Domain

    let projectArea = d.InterestedArea || d.interestedArea || d.WorkArea || d.workArea || d.Domain || d.domain || 'Engineering & Technology';

    if (!projectArea || projectArea === 'N/A') projectArea = 'Power Electronics, IoT & Embedded Systems';



    // Project Title

    let projectTitle = d.ProjectTitle || d.ProjectName || d.Title || d.projectName || d.project || '';

    if (!projectTitle || projectTitle === 'N/A' || projectTitle.toLowerCase() === 'field work / core' || projectTitle.toLowerCase() === 'unassigned') {

      projectTitle = 'Applied Technical R&D & Core Engineering Deliverables';

    }



    // Duration & Dates

    const durationNum = d.DurationDays || d.Duration || d.duration || '30';

    const duration = (String(durationNum).toLowerCase().includes('day') ? durationNum : (durationNum + ' Days'));



    const startRaw = d.InternshipStartDate || d.internshipStartDate || d.internshipStart || d.StartDate || d.startDate || d.ApprovalDate || d.approvalDate || d.JoiningDate || d.timestamp || d.Timestamp;

    const endRaw = d.InternshipEndDate || d.internshipEndDate || d.internshipEnd || d.EndDate || d.endDate;



    let startDateStr = fmtDate_(startRaw);

    let endDateStr = fmtDate_(endRaw);



    if (startDateStr && !endDateStr) {

      try {

        const sDateObj = new Date(startRaw);

        const dDays = parseInt(durationNum, 10) || 30;

        const eDateObj = new Date(sDateObj.getTime() + dDays * 24 * 60 * 60 * 1000);

        endDateStr = fmtDate_(eDateObj);

      } catch(e) {}

    }



    let periodStr = '';

    if (startDateStr && endDateStr) {

      periodStr = `${startDateStr} to ${endDateStr}`;

    } else if (startDateStr) {

      periodStr = `From ${startDateStr} (${duration})`;

    } else {

      periodStr = `Academic Internship Tenure (${duration})`;

    }



    const wrnRef = 'NOT-' + regId + '-' + Date.now().toString().slice(-4);



    let noticeHeading = '⚠️ OFFICIAL DISCIPLINARY & PERFORMANCE WARNING NOTICE';

    let emailSubject = `Official Warning Notice: Internship Performance — ${COMPANY_NAME}`;

    let noticeBodyText = '';

    let actionCallout = '';

    let headerColor = '#b71c1c';

    let softCopyBlob = null;



    // Resolve Missing Documents List

    let pendingDocsList = (opts && Array.isArray(opts.pendingDocsList) && opts.pendingDocsList.length > 0) ? opts.pendingDocsList : [];

    if (pendingDocsList.length === 0 && noticeType === 'pendingDocsNotice') {

      pendingDocsList = ['College ID / Bonafide Certificate', 'Signed Application Form', 'Project Report & Daily Task Logs'];

    }



    const docInstructions = {

      'College ID Card': 'Upload clear scanned front/back copy of your College Student Identity Card.',

      'Bonafide Certificate': 'Upload official Bonafide / Study Certificate issued by your College / Department HOD.',

      'Signed Application Form': 'Download, sign, and upload your official Internship Application Form.',

      'Passport Photo': 'Upload formal passport-size digital photograph for identity and certificate records.',

      'Project Report': 'Submit complete Project Documentation, implementation reports, and source file archive.',

      'Completion Report': 'Upload detailed Internship Completion Summary Report signed by project guide.',

      'Attendance Log (Form-4)': 'Regularize and submit all daily attendance check-in/out timestamps on the portal.',

      'Diary Log (Form-5)': 'Fill and complete all daily technical diary entries for supervisory verification.',

      'NOC / Permission Letter': 'Upload No Objection Certificate (NOC) / Internship Permission from Principal/HOD.'

    };



    if (noticeType === 'projectTaskIncompleteNotice') {

      noticeHeading = '💻 OFFICIAL NOTICE: INCOMPLETE PROJECT DELIVERABLES & TASK LOGS';

      emailSubject = `Urgent: Pending Project Deliverables & Practical Output Submission — ${COMPANY_NAME}`;

      headerColor = '#c2410c';

      noticeBodyText = `This is an official notice regarding the incomplete status of your assigned Project and Daily Task Deliverables at ${COMPANY_NAME}.\n\nOur technical evaluation indicates that you have not uploaded or submitted the required project source files, demonstration reports, and daily task implementation outputs in the Student Portal / File Manager.\n\nPlease be informed that successful completion and practical demonstration of your assigned project are mandatory requirements for internship certification. Your Internship Certificate cannot and will not be issued until all project tasks and practical deliverables are submitted, verified, and approved by the technical evaluation committee.\n\nYou are given a strict final deadline of **${deadlineDays} days (on or before ${deadlineStr})** to upload and submit all completed project deliverables.`;

      actionCallout = `💻 <strong>Action Required:</strong> Submit all missing project source codes, reports, and task documentation on the Student Portal before <strong>${deadlineStr}</strong> to avoid certificate withholding or cancellation.`;

      

      if (opts && opts.attachProjectReport) {

        try {

          const ptDocName = `Project_Task_Report_${regId}_${Date.now()}`;

          const ptDoc = DocumentApp.create(ptDocName);

          const ptBody = ptDoc.getBody();

          ptBody.appendParagraph(COMPANY_NAME).setAttributes(mkStyle(16, true, headerColor, DocumentApp.HorizontalAlignment.CENTER));

          ptBody.appendParagraph('OFFICIAL INTERNSHIP PROJECT & TASK PERFORMANCE REPORT').setAttributes(mkStyle(11, true, '#1e293b', DocumentApp.HorizontalAlignment.CENTER));

          ptBody.appendParagraph(`Student: ${name} (${regId}) | Register No: ${regNo}`).setAttributes(mkStyle(9.5, false, '#475569', DocumentApp.HorizontalAlignment.CENTER));

          ptBody.appendParagraph(`Assigned Project: ${projectTitle}`).setAttributes(mkStyle(10, true, '#c2410c', DocumentApp.HorizontalAlignment.CENTER));

          ptDoc.saveAndClose();

          const ptBlob = DriveApp.getFileById(ptDoc.getId()).getAs(MimeType.PDF).setName(`Project_Task_Report_${regId}.pdf`);

          DriveApp.getFileById(ptDoc.getId()).setTrashed(true);

          softCopyBlob = ptBlob;

        } catch(ptErr) { Logger.log('Project Task PDF attach error: ' + ptErr); }

      }



    } else if (noticeType === 'inactiveNotice') {

      noticeHeading = '⛔ OFFICIAL NOTICE: INACTIVE INTERN STATUS & REACTIVATION PROTOCOL';

      emailSubject = `Official Notice: Inactive Internship Status & Reactivation Request — ${COMPANY_NAME}`;

      headerColor = '#475569';

      noticeBodyText = `This is an official administrative notice informing you that your internship profile has been placed in INACTIVE / ON-HOLD status at ${COMPANY_NAME}. Records indicate that your scheduled internship period has concluded or remained inactive without completion and submission of mandatory deliverables.\n\nTo resume your internship and complete your pending work under a special grace extension period, you are required to submit a formal Reactivation Request through your Student Portal or obtain administrative approval.\n\nPlease log in to your Student Portal on or before **${deadlineStr}** to initiate your reactivation request. If no reactivation request is received within this grace deadline, your registration will be archived permanently and all past logs forfeited.`;

      actionCallout = `⛔ <strong>Reactivation Required:</strong> Log in to the Student Portal and click <strong>"Request Reactivation"</strong> or contact the Internship Administration before <strong>${deadlineStr}</strong> to reactivate your account and complete your remaining tasks.`;



    } else if (noticeType === 'certDelayNotice') {

      noticeHeading = '🎓 OFFICIAL NOTICE: CERTIFICATE HARD-COPY PROCESSING & DISPATCH';

      emailSubject = `Official Notice: Internship Certificate Processing Status — ${COMPANY_NAME}`;

      headerColor = '#1e40af';

      noticeBodyText = `This is an official administrative notice informing you that your Internship Completion Certificate is currently queued in batch printing and dispatch processing at ${COMPANY_NAME}.\n\nYour internship records and completed tenure have been verified. Once printing and administrative seals are finalized, your hard-copy certificate will be dispatched or handed over as per standard procedure.\n\nPlease refer to this official notice letter and attached digital certificate for any interim college or administrative submission requirements.`;

      actionCallout = `ℹ️ <strong>Status Reference:</strong> Your physical hard-copy certificate will be dispatched upon printing completion. You may submit this official notice letter and verified soft-copy certificate for college verification if required.`;

      

      if (!opts || opts.attachCertSoftCopy !== false) {

        try {

          const certRes = generateDocumentAndMail('internshipCertificate', regId, false, true, { isPreview: false });

          if (certRes && certRes.fileId) {

            softCopyBlob = DriveApp.getFileById(certRes.fileId).getBlob().setName(`Internship_Certificate_SoftCopy_${regId}.pdf`);

          }

        } catch(cErr) { Logger.log('Certificate attach error: ' + cErr); }

      }



    } else if (noticeType === 'pendingDocsNotice') {

      noticeHeading = '📎 OFFICIAL NOTICE: PENDING ONBOARDING DOCUMENTS SUBMISSION';

      emailSubject = `Urgent: Pending Verification & Onboarding Documents Submission — ${COMPANY_NAME}`;

      headerColor = '#b45309';

      noticeBodyText = `You are hereby officially notified that mandatory verification and onboarding documents remain pending for your internship registration profile at ${COMPANY_NAME}.\n\nTo maintain your accredited intern status and ensure smooth issuance of your final credentials, you are required to review the pending documents list below, log in to your Student Portal, and upload clear scanned copies within ${deadlineDays} days (on or before ${deadlineStr}).`;

      actionCallout = `📎 <strong>Upload Required:</strong> Log in to the Student Portal and complete your document uploads before <strong>${deadlineStr}</strong> to prevent administrative hold on certificate release.`;



    } else if (noticeType === 'incompleteAttendanceNotice') {

      noticeHeading = '⏰ OFFICIAL NOTICE: ATTENDANCE & DIARY ENTRIES RECTIFICATION';

      emailSubject = `Official Notice: Incomplete Attendance & Daily Diary Logs — ${COMPANY_NAME}`;

      headerColor = '#d97706';

      noticeBodyText = `Our administrative attendance audit indicates that your daily attendance records (Form-4) or Student Work Diary entries (Form-5) contain pending, missing, or irregular log entries at ${COMPANY_NAME}.\n\nRegular daily attendance check-in/out and authenticated work diary entries are strictly required for internship tenure validation. You are granted a grace period of ${deadlineDays} days (until ${deadlineStr}) to regularize all missed daily logs in the Student Portal before final evaluation and certificate release.`;

      actionCallout = `⏰ <strong>Rectification Required:</strong> Complete all pending daily attendance and diary entries before <strong>${deadlineStr}</strong>.`;



      if (opts && opts.attachAttPDF) {

        try {

          const attRes = generateConsolidatedAttendancePDF(regId);

          if (attRes && attRes.fileId) {

            const attBlob = DriveApp.getFileById(attRes.fileId).getBlob().setName(`Consolidated_Attendance_Form4_${regId}.pdf`);

            if (!softCopyBlob) softCopyBlob = attBlob;

            else d._extraAttachBlob = attBlob;

          }

        } catch(attErr) { Logger.log('Attendance PDF attach error: ' + attErr); }

      }



      if (opts && opts.attachDiaryPDF) {

        try {

          const diaryRes = generateStudentDiaryPDF_V2({ regId: regId, mode: 'consolidated' });

          if (diaryRes && diaryRes.fileId) {

            const diaryBlob = DriveApp.getFileById(diaryRes.fileId).getBlob().setName(`Student_Diary_Form5_${regId}.pdf`);

            if (!softCopyBlob) softCopyBlob = diaryBlob;

            else if (!d._extraAttachBlob) d._extraAttachBlob = diaryBlob;

            else d._extraAttachBlob2 = diaryBlob;

          }

        } catch(diaryErr) { Logger.log('Diary PDF attach error: ' + diaryErr); }

      }



    } else {

      noticeHeading = '⚠️ OFFICIAL DISCIPLINARY & PERFORMANCE WARNING NOTICE';

      emailSubject = `Official Disciplinary Warning: Internship Completion & Performance — ${COMPANY_NAME}`;

      headerColor = '#b71c1c';

      noticeBodyText = `This is an official Disciplinary Warning Notice regarding your internship performance at ${COMPANY_NAME}. It has been observed that you have delayed or neglected the completion of your assigned project/tasks and attendance requirements.\n\nPlease be strictly advised that project delivery and attendance compliance are mandatory requirements. Even if your college reopens or scheduled duration expires, you must obtain permission and complete your tasks.\n\nYou are given a strict final deadline of **${deadlineDays} days (on or before ${deadlineStr})** to complete and submit all pending work. Failure to do so will result in immediate termination, invalidation of all worked days, and complete erasure of records.`;

      actionCallout = `🚨 <strong>Final Warning:</strong> You must complete all pending project tasks and documentation by <strong>${deadlineStr}</strong>. Non-compliance will lead to permanent forfeiture of your Internship Certificate.`;

    }



    if (customReason) {

      noticeBodyText += `\n\n**Specific Observations:**\n${customReason}`;

    }



    // ── Generate Notice PDF Document ───────────────────────────────────────────

    const docName = `Notice_${noticeType}_${regId}_${Date.now()}`;

    const doc = DocumentApp.create(docName);

    const body = doc.getBody();



    body.setMarginTop(28.35);

    body.setMarginBottom(28.35);

    body.setMarginLeft(45);

    body.setMarginRight(45);



    const sanitizeHexColor_ = (col) => {

      if (!col || typeof col !== 'string') return '#000000';

      let c = col.trim();

      if (/^#[0-9a-fA-F]{3}$/.test(c)) {

        return '#' + c[1] + c[1] + c[2] + c[2] + c[3] + c[3];

      }

      if (/^#[0-9a-fA-F]{6}$/.test(c)) {

        return c;

      }

      return '#000000';

    };



    const mkStyle = (size, bold, color, align) => {

      const s = {};

      s[DocumentApp.Attribute.FONT_FAMILY] = 'Arial';

      s[DocumentApp.Attribute.FONT_SIZE] = size;

      s[DocumentApp.Attribute.BOLD] = !!bold;

      s[DocumentApp.Attribute.FOREGROUND_COLOR] = sanitizeHexColor_(color);

      s[DocumentApp.Attribute.HORIZONTAL_ALIGNMENT] = align || DocumentApp.HorizontalAlignment.LEFT;

      return s;

    };



    body.appendParagraph(COMPANY_NAME).setAttributes(mkStyle(18, true, headerColor, DocumentApp.HorizontalAlignment.CENTER));

    body.appendParagraph('Internship Management & Technical R&D Operations').setAttributes(mkStyle(9, false, '#64748b', DocumentApp.HorizontalAlignment.CENTER));

    body.appendParagraph('📞 9092610415  |  ✉ gsveeip2026@gmail.com  |  🌐 www.gsvee.in').setAttributes(mkStyle(8.5, true, '#1e293b', DocumentApp.HorizontalAlignment.CENTER));

    body.appendParagraph(`Ref: ${wrnRef}  |  Date: ${todayStr}  |  Location: Tamil Nadu, India`).setAttributes(mkStyle(8.5, false, '#475569', DocumentApp.HorizontalAlignment.CENTER));

    body.appendParagraph('').setAttributes(mkStyle(6, false, '#000000'));



    body.appendParagraph(noticeHeading).setAttributes(mkStyle(12, true, headerColor, DocumentApp.HorizontalAlignment.CENTER));

    body.appendParagraph('').setAttributes(mkStyle(4, false, '#000000'));



    // Meta Table in Doc

    const tblData = [

      ['Student Name', name, 'Registration ID', regId],

      ['College Name', college, 'Register Number', regNo],

      ['Department & Year', department, 'Batch Name', batch],

      ['Project Title', projectTitle, 'Domain / Track', projectArea],

      ['Internship Period', periodStr, 'Duration', duration],

      ['Notice Date', todayStr, 'Grace Deadline', deadlineStr]

    ];



    const docTable = body.appendTable(tblData);

    docTable.setBorderWidth(0.5);

    docTable.setBorderColor('#cbd5e1');

    for (let r = 0; r < docTable.getNumRows(); r++) {

      const row = docTable.getRow(r);

      for (let c = 0; c < row.getNumCells(); c++) {

        const cell = row.getCell(c);

        cell.setPaddingTop(3.5);

        cell.setPaddingBottom(3.5);

        cell.setPaddingLeft(6);

        cell.setPaddingRight(6);

        const isHeaderCell = (c === 0 || c === 2);

        if (isHeaderCell) {

          cell.setBackgroundColor('#f8fafc');

          cell.editAsText().setAttributes(mkStyle(9, true, '#475569'));

        } else {

          cell.editAsText().setAttributes(mkStyle(9, false, '#0f172a'));

        }

      }

    }



    body.appendParagraph('').setAttributes(mkStyle(6, false, '#000000'));

    body.appendParagraph(`Dear ${name},`).setAttributes(mkStyle(10.5, true, '#0f172a'));

    body.appendParagraph(noticeBodyText.replace(/\*\*/g, '')).setAttributes(mkStyle(10, false, '#334155'));



    // If pending documents exist, append to Doc

    if (pendingDocsList.length > 0) {

      body.appendParagraph('').setAttributes(mkStyle(4, false, '#000000'));

      body.appendParagraph('MANDATORY MISSING / PENDING VERIFICATION DOCUMENTS:').setAttributes(mkStyle(10.5, true, '#b45309'));

      pendingDocsList.forEach(pDoc => {

        const guide = docInstructions[pDoc] || 'Upload signed / scanned PDF via Student Portal.';

        body.appendListItem(`${pDoc}: ${guide}`).setAttributes(mkStyle(9.5, false, '#78350f'));

      });

      body.appendParagraph(`Deadline for Document Submission: ${deadlineStr}`).setAttributes(mkStyle(9.5, true, '#b45309'));

    }



    body.appendParagraph('').setAttributes(mkStyle(6, false, '#000000'));

    body.appendParagraph('Authorized Signatory:').setAttributes(mkStyle(9.5, false, '#64748b'));

    body.appendParagraph('Chief Technical Officer — ' + COMPANY_NAME).setAttributes(mkStyle(10, true, headerColor));



    doc.saveAndClose();



    const pdfBlob = DriveApp.getFileById(doc.getId()).getAs(MimeType.PDF);

    const tempFolderId = getSystemFolderId('generated');

    const tempFolder = DriveApp.getFolderById(tempFolderId);

    const finalPdf = tempFolder.createFile(pdfBlob).setName(`Notice_${regId}.pdf`);

    DriveApp.getFileById(doc.getId()).setTrashed(true);



    // ── Email HTML Generation ─────────────────────────────────────────────────

    const attachments = [finalPdf.getBlob()];

    if (softCopyBlob) attachments.push(softCopyBlob);

    if (d && d._extraAttachBlob) attachments.push(d._extraAttachBlob);

    if (d && d._extraAttachBlob2) attachments.push(d._extraAttachBlob2);



    let pendingDocsEmailHtml = '';

    if (pendingDocsList.length > 0) {

      const itemsHtml = pendingDocsList.map(doc => {

        const guide = docInstructions[doc] || 'Upload signed / scanned PDF via Student Portal > File Manager.';

        return `<li style="margin-bottom: 6px;"><strong style="color: #9a3412;">${doc}</strong>: <span style="color: #78350f;">${guide}</span></li>`;

      }).join('');



      pendingDocsEmailHtml = `

        <div style="margin: 20px 0; background: #fffbeb; border: 1.5px solid #f59e0b; border-radius: 8px; padding: 16px 20px; box-shadow: 0 2px 8px rgba(245,158,11,0.12); text-align: left;">

          <div style="font-size: 13px; font-weight: 800; color: #b45309; display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">

            <span style="font-size: 16px;">📎</span> <span>MANDATORY MISSING / PENDING VERIFICATION DOCUMENTS</span>

          </div>

          <p style="margin: 0 0 10px 0; font-size: 12px; color: #92400e; font-weight: 600;">

            The administrative evaluation has marked the following document(s) and operational records as <strong>PENDING / MISSING</strong> from your profile:

          </p>

          <ul style="margin: 0 0 12px 0; padding-left: 22px; font-size: 12px; color: #78350f; line-height: 1.7;">

            ${itemsHtml}

          </ul>

          <div style="padding-top: 8px; border-top: 1px dashed #fcd34d; font-size: 11.5px; color: #92400e; font-weight: 600;">

            ⏰ <strong>Submission Deadline:</strong> All marked documents must be uploaded via the <strong>Student Portal &gt; File Manager / Documents</strong> on or before <strong style="color: #b45309; text-decoration: underline;">${deadlineStr}</strong>. Non-submission before the deadline will place an administrative hold on certificate clearance.

          </div>

        </div>

      `;

    }



    const emailHtmlBody = `
      <div style="background-color: #f1f5f9; padding: 32px 14px; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1e293b; line-height: 1.6; text-align: center;">
        <div style="max-width: 640px; margin: 0 auto; background: #ffffff; border-radius: 18px; overflow: hidden; box-shadow: 0 12px 40px rgba(185,28,28,0.14); text-align: left; border: 1.5px solid #fecaca;">
          
          <!-- Grand Crimson Red Header with Logo -->
          <div style="background: linear-gradient(135deg, #7f1d1d 0%, #b91c1c 45%, #dc2626 100%); padding: 32px 28px 24px 28px; text-align: center; color: #ffffff;">
            <div style="margin-bottom: 14px;">
              <img src="cid:gsvLogo" alt="${COMPANY_NAME}" style="max-height: 50px; max-width: 280px; height: auto; display: inline-block;" />
            </div>
            <div style="font-size: 11.5px; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; color: #fee2e2; margin-bottom: 5px;">
              ⚡ Official Operations &amp; Disciplinary Compliance
            </div>
            <h1 style="color: #ffffff; margin: 0; font-size: 23px; font-weight: 800; letter-spacing: -0.3px; line-height: 1.25;">
              Official Warning Notice
            </h1>
            <div style="margin-top: 12px;">
              <span style="display: inline-block; background: rgba(0,0,0,0.25); color: #ffffff; border: 1.5px solid rgba(255,255,255,0.40); font-size: 10.5px; font-weight: 800; letter-spacing: 1px; padding: 5px 16px; border-radius: 20px; text-transform: uppercase; box-shadow: 0 2px 6px rgba(0,0,0,0.18);">
                ⚠️ ${noticeHeading}
              </span>
            </div>
          </div>

          <!-- Ref & Meta Header Bar -->
          <div style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 10px 24px; display: flex; justify-content: space-between; align-items: center; font-size: 11.5px; color: #64748b;">
            <span>📍 Location: <strong>Tamil Nadu, India</strong></span>
            <span>Ref: <strong style="color: #0f172a; font-family: monospace;">${wrnRef}</strong></span>
          </div>

          <!-- Body with Watermark -->
          <div style="position: relative; padding: 32px 28px; background-color: #ffffff; font-size: 14.5px;">
            <!-- Centered Faint Watermark -->
            <div style="height: 0; overflow: visible; text-align: center; opacity: 0.12; pointer-events: none;">
      <img src="cid:gsvWatermark" alt="" style="width: 280px; max-width: 75%; height: auto; display: inline-block; margin-top: 50px;" />
    </div>

            <div style="position: relative; z-index: 2;">
              <p style="font-size: 16px; margin: 0 0 12px 0;">Dear <strong>${name}</strong>,</p>
              
              <!-- Red Alert Box -->
              <div style="background: #fff1f2; border: 2px solid #fda4af; border-radius: 12px; padding: 18px 20px; margin-bottom: 22px; box-shadow: 0 4px 14px rgba(220,38,38,0.08);">
                <div style="font-size: 13px; font-weight: 800; color: #991b1b; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px;">
                  ⚠️ Compliance &amp; Operational Alert
                </div>
                <div style="font-size: 13.5px; color: #881337; line-height: 1.65; white-space: pre-line;">
                  ${noticeBodyText.replace(/\*\*/g, '')}
                </div>
                <div style="margin-top: 14px; padding-top: 10px; border-top: 1px dashed #fecdd3; font-size: 13px; color: #991b1b; font-weight: 700;">
                  ${actionCallout}
                </div>
              </div>

              <!-- Student Internship Details Pod -->
              <div style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 18px 20px; margin-bottom: 22px;">
                <div style="font-size: 12.5px; font-weight: 800; color: #1e293b; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 12px; border-bottom: 1px solid #cbd5e1; padding-bottom: 6px;">
                  📋 Student &amp; Internship Record Summary
                </div>
                <table style="width: 100%; font-size: 13.5px; border-collapse: collapse; color: #334155;">
                  <tr>
                    <td style="width: 44%; padding: 5px 0; font-weight: 700; color: #64748b;">Registration ID:</td>
                    <td style="padding: 5px 0;"><code style="font-weight: 800; color: #1e40af; background: #e0f2fe; padding: 2px 6px; border-radius: 4px;">${regId}</code></td>
                  </tr>
                  <tr>
                    <td style="padding: 5px 0; font-weight: 700; color: #64748b;">College Name:</td>
                    <td style="padding: 5px 0; font-weight: 800; color: #0f172a;">${college}</td>
                  </tr>
                  <tr>
                    <td style="padding: 5px 0; font-weight: 700; color: #64748b;">Register Number:</td>
                    <td style="padding: 5px 0; font-weight: 800; color: #0f172a;">${regNo}</td>
                  </tr>
                  <tr>
                    <td style="padding: 5px 0; font-weight: 700; color: #64748b;">Department:</td>
                    <td style="padding: 5px 0; font-weight: 800; color: #0f172a;">${department}</td>
                  </tr>
                  <tr>
                    <td style="padding: 5px 0; font-weight: 700; color: #64748b;">Batch Name:</td>
                    <td style="padding: 5px 0; font-weight: 800; color: #0f172a;">${batch}</td>
                  </tr>
                  <tr>
                    <td style="padding: 5px 0; font-weight: 700; color: #64748b;">Project Title:</td>
                    <td style="padding: 5px 0; font-weight: 800; color: #c2410c;">${projectTitle}</td>
                  </tr>
                  <tr>
                    <td style="padding: 5px 0; font-weight: 700; color: #64748b;">Domain / Track:</td>
                    <td style="padding: 5px 0; font-weight: 800; color: #0f172a;">${projectArea}</td>
                  </tr>
                  <tr>
                    <td style="padding: 5px 0; font-weight: 700; color: #64748b;">Internship Period:</td>
                    <td style="padding: 5px 0; font-weight: 800; color: #0f172a;">${periodStr}</td>
                  </tr>
                  <tr>
                    <td style="padding: 5px 0; font-weight: 700; color: #64748b;">Grace Rectification Deadline:</td>
                    <td style="padding: 5px 0; font-weight: 800; color: #b91c1c; font-size: 14px;">${deadlineStr}</td>
                  </tr>
                </table>
              </div>

              ${pendingDocsEmailHtml}

              <!-- Direct CTA Action Button -->
              <div style="margin: 25px 0 20px 0; text-align: center;">
                <a href="${PORTAL_URL}" style="background: linear-gradient(135deg, #991b1b 0%, #b91c1c 50%, #dc2626 100%); color: #ffffff; padding: 12px 28px; text-decoration: none; border-radius: 8px; font-weight: 800; font-size: 14px; display: inline-block; box-shadow: 0 4px 14px rgba(220,38,38,0.30); letter-spacing: 0.3px;">
                  Access Student Portal &amp; Resolve Records &rarr;
                </a>
              </div>

              <div style="margin-top: 24px; font-size: 12.5px; color: #334155; border-top: 1px solid #f1f5f9; padding-top: 15px;">
                <p style="margin: 0; font-style: italic; color: #64748b;">Authorized Signatory,</p>
                <p style="margin: 3px 0 0 0; font-weight: 800; color: #991b1b;">Chief Technical Officer &amp; Operations Head</p>
                <p style="margin: 0; color: #475569; font-weight: 700;">${COMPANY_NAME}</p>
              </div>

            </div>
          </div>

          <!-- Clean Footer with Company Details Only -->
          <div style="background: #f8fafc; padding: 20px 28px; border-top: 1px solid #e2e8f0; text-align: center; font-size: 12px; color: #64748b; line-height: 1.55;">
            <div style="font-weight: 900; color: #0f172a; font-size: 13.5px; margin-bottom: 4px;">GSV ELECTRICAL ENTERPRISES</div>
            <div style="font-size: 11.5px; color: #475569; margin-bottom: 6px; font-weight: 600;">Electrical Contractors and Engineers</div>
            <div style="font-size: 11px;">📞 9092610415 &nbsp;|&nbsp; ✉ gsveeip2026@gmail.com &nbsp;|&nbsp; 🌐 www.gsvee.in</div>
            <div style="font-size: 10.5px; color: #94a3b8; margin-top: 6px; font-weight: 700;">AN ISO 9001 : 2015 CERTIFIED COMPANY</div>
          </div>

        </div>
      </div>
    `;

    MailApp.sendEmail({
      to: email,
      subject: emailSubject,
      htmlBody: emailHtmlBody,
      attachments: attachments,
      inlineImages: getEmailInlineImages_(),
      name: COMPANY_NAME + ' Official Operations'
    });



    logActivity('Official Notice Dispatched', regId, `Dispatched ${noticeType} to ${email} (Deadline: ${deadlineStr})`);



    const docSheet = getSheet(SHEET_NAMES.GENERATED_DOCUMENTS);

    if (docSheet) {

      const headers = docSheet.getDataRange().getValues()[0];

      const newRow = headers.map(h => {

        if (h === 'DocumentID') return 'NOT_' + Date.now();

        if (h === 'RegistrationID' || h === 'StudentRegistrationID') return regId;

        if (h === 'StudentName') return name;

        if (h === 'DocumentType') return `OfficialNotice_${noticeType}`;

        if (h === 'FileID') return finalPdf.getId();

        if (h === 'DriveLink' || h === 'Url') return finalPdf.getUrl();

        if (h === 'GeneratedDate' || h === 'Timestamp') return new Date();

        if (h === 'SentViaEmail') return 'Yes';

        return '';

      });

      docSheet.appendRow(newRow);

    }



    return {

      status: 'success',

      message: `Official Notice (${noticeType}) dispatched successfully.`,

      url: finalPdf.getUrl(),

      driveLink: finalPdf.getUrl()

    };

  } catch (e) {

    Logger.log('sendStudentOfficialNotice error: ' + e.toString());

    return { status: 'error', message: e.toString() };

  }

}





// Aliases for backward compatibility

function sendStudentWarning(regId, customReason) {

  return sendStudentOfficialNotice(regId, 'disciplinaryWarning', customReason, 7);

}



function sendBatchWarning(regIds, customReason) {

  return sendBatchStudentNotices(regIds, 'disciplinaryWarning', customReason, 7);

}



function sendBatchStudentNotices(regIds, noticeType, customReason, deadlineDays, opts) {

  try {

    if (!Array.isArray(regIds) || regIds.length === 0) {

      return { status: 'error', message: 'No students selected.' };

    }



    opts = opts || {};

    let successCount = 0;

    let errors = [];



    for (let i = 0; i < regIds.length; i++) {

      const res = sendStudentOfficialNotice(regIds[i], noticeType, customReason, deadlineDays, opts);

      if (res.status === 'success') {

        successCount++;

      } else {

        errors.push(regIds[i] + ': ' + res.message);

      }

    }



    if (errors.length > 0) {

      return {

        status: successCount > 0 ? 'success' : 'error',

        message: `Notices dispatched to ${successCount} student(s). Issues with: ${errors.join(', ')}`

      };

    }



    return {

      status: 'success',

      message: `Successfully dispatched Official Notices to ${successCount} student(s).`

    };

  } catch (e) {

    return { status: 'error', message: 'Error in batch notice: ' + e.toString() };

  }

}



/**

 * In-memory fallback certificate PDF generator ensuring a soft-copy certificate blob

 * is 100% guaranteed to be created and attached to notice emails even if Drive template copy fails.

 */

function generateDynamicCertificateDocBlob_(regId, d, certOpts) {

  try {

    certOpts = certOpts || {};

    const isT1 = (certOpts.certTemplate === 'T1' || certOpts.certTemplate === 't1');

    const name = getStudentFullName_(d);

    const college = d.CollegeName || d.college || 'COLLEGE / INSTITUTION OF TECHNOLOGY';

    const regNo = d.RegisterNumber || d.registerNumber || 'N/A';

    const dept = d.Department || d.department || 'ENGINEERING & TECHNOLOGY';

    const year = d.Year || d.year || '4th year';

    const projectTitle = d.SkillLearned || d['Skill Learned'] || d.skillLearned || d.ProjectTitle || d.ProjectName || d.projectName || d.InterestedArea || 'Internship Technical Project';

    const duration = (d.DurationDays || d.duration || '30') + ' days';

    

    const zone = Session.getScriptTimeZone() || 'Asia/Kolkata';

    const fmtDate = (raw) => {

      if (!raw) return 'N/A';

      try { return Utilities.formatDate(new Date(raw), zone, 'dd/MM/yyyy'); }

      catch(e) { return String(raw); }

    };

    const startDate = fmtDate(d.InternshipStartDate);

    const endDate = fmtDate(d.InternshipEndDate);

    

    let issueDateStr = Utilities.formatDate(new Date(), zone, 'dd/MM/yyyy');

    if (certOpts.customDocDate) {

      try { issueDateStr = Utilities.formatDate(new Date(certOpts.customDocDate), zone, 'dd/MM/yyyy'); }

      catch(e) {}

    }

    

    const certNo = d.CertificateNumber || ('GSV/26/C/' + (String(regNo).slice(-4) || '1133') + '/' + (String(regId).slice(-4) || '0085'));

    const attendedDaysVal = certOpts.manualAttendedDays || d.attendedDays || '30';



    const genderStr = String(d.Gender || d.gender || '').trim().toLowerCase();

    const isFemale = (genderStr === 'female' || genderStr === 'f' || genderStr === 'woman');

    const pronounPoss = isFemale ? 'her' : 'his';

    const salutation = isFemale ? 'Ms.' : 'Mr.';



    const doc = DocumentApp.create(`Temp_Certificate_${regId}_${Date.now()}`);

    const body = doc.getBody();

    body.setMarginTop(30);

    body.setMarginBottom(30);

    body.setMarginLeft(40);

    body.setMarginRight(40);



    const styleHeading = (size, bold, color, align, font) => {

      const s = {};

      s[DocumentApp.Attribute.FONT_FAMILY] = font || 'Times New Roman';

      s[DocumentApp.Attribute.FONT_SIZE] = size;

      s[DocumentApp.Attribute.BOLD] = !!bold;

      s[DocumentApp.Attribute.FOREGROUND_COLOR] = color || '#000000';

      s[DocumentApp.Attribute.HORIZONTAL_ALIGNMENT] = align || DocumentApp.HorizontalAlignment.CENTER;

      return s;

    };



    // Top ISO Header

    body.appendParagraph('Vijay Varman.S .DEEE,BE\nChief Engineer cum Proprietor\t\t\t\t\t\t\t\t\t\t9092610415\nGSTIN:33BJNPV0469B1Z5 | AN ISO 9001 : 2015 Certified Company')

        .setAttributes(styleHeading(9, false, '#000000', DocumentApp.HorizontalAlignment.LEFT, 'Arial'));



    // Company Title

    body.appendParagraph(COMPANY_NAME)

        .setAttributes(styleHeading(22, true, '#800000', DocumentApp.HorizontalAlignment.CENTER, 'Times New Roman'));

    body.appendParagraph(COMPANY_TAGLINE)

        .setAttributes(styleHeading(11, true, '#1f2937', DocumentApp.HorizontalAlignment.CENTER, 'Times New Roman'));

    body.appendParagraph(COMPANY_ADDRESS + '\nEmail: ' + COMPANY_EMAIL + ' | Web: ' + COMPANY_WEBSITE)

        .setAttributes(styleHeading(8.5, false, '#000000', DocumentApp.HorizontalAlignment.CENTER, 'Times New Roman'));

    body.appendParagraph('═══════════════════════════════════════════════════════════════════════════')

        .setAttributes(styleHeading(8, false, '#000000', DocumentApp.HorizontalAlignment.CENTER, 'Arial'));



    // Cert No & Date Bar

    body.appendParagraph(`${certNo}\t\t\t\t\t\t\t\t\t\tDATE : ${issueDateStr}`)

        .setAttributes(styleHeading(11, true, '#000000', DocumentApp.HorizontalAlignment.LEFT, 'Times New Roman'));

    body.appendParagraph('').setAttributes(styleHeading(4, false, '#000000'));



    // Title

    body.appendParagraph('Internship Training Certificate')

        .setAttributes(styleHeading(16, true, '#000000', DocumentApp.HorizontalAlignment.CENTER, 'Times New Roman'))

        .setUnderline(true);

    body.appendParagraph('').setAttributes(styleHeading(8, false, '#000000'));



    // Body Paragraph

    let certText = '';
    const candTypeCert = String(d.InternshipType || d.CandidateType || (d.CollegeName && String(d.CollegeName).toLowerCase().includes('apprentice') ? 'Apprentice' : '')).toLowerCase();

    if (isT1) {
      if (candTypeCert.includes('faculty')) {
        certText = `This is to certify that ${name} Register Number : ${regNo}, Faculty of ${year} ${dept} at ${college}, successfully completed ${pronounPoss} Internship Training program in GSV Electrical Enterprises (Electrical and Electronics Products), Chennai for a tenure of ${duration} (Attended ${attendedDaysVal} days) (${startDate} to ${endDate}).\n\nDuring the Tenure of ${pronounPoss} internship program with us, learned ${projectTitle}. ${pronounPoss.toUpperCase()} performance and conduct during ${pronounPoss} training were SATISFACTORY.`;
      } else if (candTypeCert.includes('employee')) {
        certText = `This is to certify that ${name} Register Number : ${regNo}, Employee of ${year} ${dept} at ${college}, successfully completed ${pronounPoss} Internship Training program in GSV Electrical Enterprises (Electrical and Electronics Products), Chennai for a tenure of ${duration} (Attended ${attendedDaysVal} days) (${startDate} to ${endDate}).\n\nDuring the Tenure of ${pronounPoss} internship program with us, learned ${projectTitle}. ${pronounPoss.toUpperCase()} performance and conduct during ${pronounPoss} training were SATISFACTORY.`;
      } else if (candTypeCert.includes('apprentice')) {
        certText = `This is to certify that ${name} Register Number : ${regNo}, Apprentice of ${year} ${dept} at ${college}, successfully completed ${pronounPoss} Internship Training program in GSV Electrical Enterprises (Electrical and Electronics Products), Chennai for a tenure of ${duration} (Attended ${attendedDaysVal} days) (${startDate} to ${endDate}).\n\nDuring the Tenure of ${pronounPoss} internship program with us, learned ${projectTitle}. ${pronounPoss.toUpperCase()} performance and conduct during ${pronounPoss} training were SATISFACTORY.`;
      } else {
        certText = `This is to certify that ${salutation} ${name} (Reg. No: ${regNo}), a student of ${college} studying in ${dept} (${year}), has successfully completed ${duration} internship training from ${startDate} to ${endDate} at GSV Electrical Enterprises (Electrical and Electronics Products) on the project titled "${projectTitle}".\n\nDuring this period, ${pronounPoss} performance was found to be SATISFACTORY.`;
      }
    } else {
      // TEMPLATE 2 - Image 1 exact wording for ALL categories
      let roleDesc = `a pursuing Student of ${year} ${dept} at ${college}`;
      let progName = 'Internship Training Program';
      if (candTypeCert.includes('faculty')) {
        roleDesc = `Faculty of ${year} ${dept} at ${college}`;
        progName = 'Faculty Internship Training Program';
      } else if (candTypeCert.includes('employee')) {
        roleDesc = `Corporate Professional of ${year} ${dept} at ${college}`;
        progName = 'Corporate Upskilling & Internship Training Program';
      } else if (candTypeCert.includes('apprentice')) {
        roleDesc = `Apprentice Trainee in ${dept}`;
        progName = 'Industrial Apprenticeship Training Program';
      }

      let p2Skill = (projectTitle && !['applied electronics, iot & embedded systems', 'iot based electrical parameters data acquisition', 'n/a', '--'].includes(projectTitle.toLowerCase()))
        ? `in ${projectTitle} .`
        : `.`;

      certText = `This is to certify that ${name} Register Number : ${regNo}, ${roleDesc}, successfully completed the ${progName} at G.S.V Electrical Enterprises, Chennai, during the period from ${startDate} to ${endDate}, completing ${attendedDaysVal} days of training.\n\nDuring the internship, ${pronounSubj} gained practical knowledge and hands-on experience ${p2Skill}\n\n${pronounPossCap} performance and conduct during his training were punctual, inquisitive and hardworking with involvement.`;
    }

    body.appendParagraph(certText).setAttributes(styleHeading(11.5, false, '#000000', DocumentApp.HorizontalAlignment.JUSTIFY, 'Times New Roman'));

    body.appendParagraph('').setAttributes(styleHeading(14, false, '#000000'));



    // Footer: Signatures & Seal

    const footerTable = body.appendTable([

      [

        `Digitally Signed\nPortal: ${COMPANY_NAME} Internship Portal\nAdmin: ${COMPANY_CHIEF_ENGINEER}\nDate: ${issueDateStr}`,

        `${COMPANY_NAME}\nELECTRICAL\nSEAL`,

        `SCAN TO VERIFY\nReg ID: ${regId}\n${COMPANY_WEBSITE}/verify`

      ]

    ]);

    footerTable.setBorderWidth(0);



    doc.saveAndClose();



    const pdfBlob = DriveApp.getFileById(doc.getId()).getAs(MimeType.PDF);

    pdfBlob.setName(`Internship_Certificate_SoftCopy_${regId}.pdf`);

    DriveApp.getFileById(doc.getId()).setTrashed(true);



    return pdfBlob;

  } catch(e) {

    Logger.log('generateDynamicCertificateDocBlob_ error: ' + e.toString());

    return null;

  }

}







/**

 * Retrieves Warning Notice Dispatch History.

 */

function getWarningNoticeHistory() {

  try {

    const docSheet = getSheet(SHEET_NAMES.GENERATED_DOCUMENTS);

    if (!docSheet) return { status: 'success', history: [] };



    const docData = getSheetDataAsObjects(docSheet) || [];

    

    // Notice doc types to include

    const noticeDocTypes = [

      'disciplinaryWarning', 

      'certDelayNotice', 

      'pendingDocsNotice', 

      'incompleteAttendanceNotice', 

      'projectTaskIncompleteNotice', 

      'inactiveNotice',

      'warningNotice'

    ];



    const warningDocs = docData.filter(d => {

      const t = String(d.DocType || '').trim();

      const r = String(d.ReferenceNumber || '').trim();

      const docId = String(d.DocumentID || '').trim();

      return noticeDocTypes.includes(t) || t.toLowerCase().includes('notice') || t.toLowerCase().includes('warning') || r.startsWith('NOT-') || docId.startsWith('NOT_');

    });



    // Fetch registration data map for student details

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    const studentMap = {};

    if (regSheet) {

      const regData = getSheetDataAsObjects(regSheet) || [];

      regData.forEach(s => {

        const id = String(s.RegistrationID || s.registrationId || '').trim().toUpperCase();

        if (id) studentMap[id] = s;

      });

    }



    const zone = Session.getScriptTimeZone() || 'Asia/Kolkata';



    const history = warningDocs.map(doc => {

      const rId = String(doc.StudentRegistrationID || doc.RegistrationID || '').trim().toUpperCase();

      const s = studentMap[rId] || {};

      const fName = s.FirstName || s.firstName || '';

      const mName = s.MiddleName || s.middleName || '';

      const lName = s.LastName || s.lastName || '';

      const name = s.Name || s.name || (fName + ' ' + mName + ' ' + lName).trim() || 'Student ' + rId;

      

      const docType = String(doc.DocType || 'disciplinaryWarning').trim();

      let attachedDocs = ['📄 Official Notice Letter'];

      if (docType === 'certDelayNotice') {

        attachedDocs.push('🎓 Soft-Copy Certificate');

      } else if (docType === 'incompleteAttendanceNotice') {

        attachedDocs.push('📋 Form-4 Attendance');

        attachedDocs.push('📖 Form-5 Student Diary');

      }



      let dateFormatted = '';

      try {

        if (doc.GeneratedDate) {

          dateFormatted = Utilities.formatDate(new Date(doc.GeneratedDate), zone, 'dd MMM yyyy, hh:mm a');

        }

      } catch(e) { dateFormatted = String(doc.GeneratedDate || ''); }



      return {

        documentId: doc.DocumentID || '',

        registrationId: rId,

        studentName: name,

        registerNumber: s.RegisterNumber || s.registerNumber || 'N/A',

        email: s.GmailID || s.gmail || s.email || s.Email || '',

        mobile: s.MobileNumber || s.mobile || s.phoneNumber || '',

        collegeName: s.CollegeName || s.college || 'N/A',

        department: s.Department || s.department || 'N/A',

        year: s.Year || s.year || s.yearOfStudy || 'N/A',

        batch: s.Batch || s.batch || 'N/A',

        projectName: s.ProjectName || s.projectName || s.ProjectTitle || s.project || s.interestedArea || 'Internship Deliverables',

        interestedArea: s.InterestedArea || s.interestedArea || s.department || s.Department || 'Engineering',

        startDate: s.InternshipStartDate || s.internshipStartDate || '',

        endDate: s.InternshipEndDate || s.internshipEndDate || '',

        duration: (s.DurationDays || s.Duration || s.duration || '30') + ' Days',

        noticeType: docType,

        referenceNumber: doc.ReferenceNumber || '',

        pdfUrl: doc.DocUrl || '',

        pdfFileId: doc.PdfFileId || '',

        generatedDate: doc.GeneratedDate || new Date(),

        formattedDate: dateFormatted,

        sentViaEmail: doc.SentViaEmail || 'Yes',

        attachedDocs: attachedDocs,

        customReason: doc.Remarks || doc.Observations || doc.CustomReason || '',

        deadlineDays: doc.DeadlineDays || '7',

        certNumber: s.CertificateNumber || s.certificateNumber || s.certNumber || '',

        certLink: s.CertificateLink || s.certificateLink || '',

        studentRaw: s

      };

    });



    // Sort newest first

    history.sort((a, b) => new Date(b.generatedDate) - new Date(a.generatedDate));



    return {

      status: 'success',

      history: history

    };

  } catch (e) {

    Logger.log('getWarningNoticeHistory error: ' + e.toString());

    return { status: 'error', message: e.toString(), history: [] };

  }

}



/**

 * Fast endpoint to load all students specifically for Warning Notice Dispatcher.

 * Efficiently merges registration records and certificate status without heavy loops.

 */

/**

 * Fast endpoint to load all students specifically for Warning Notice Dispatcher.

 * Efficiently merges registration records and certificate status without heavy loops.

 */

function getWarningNoticeStudents() {

  try {

    const regSheet = getSheet(SHEET_NAMES.REGISTRATIONS);

    if (!regSheet) return { status: 'error', message: 'Registrations sheet not found.' };

    

    const regData = getSheetDataAsObjects(regSheet) || [];

    

    let closedData = [];

    try {

      const closedSheet = getSheet('Closed and Opt-out');

      if (closedSheet) closedData = getSheetDataAsObjects(closedSheet) || [];

    } catch(e) {}

    

    const combinedData = [...regData, ...closedData];

    

    // Quick Certificate Map

    const certMap = {};

    try {

      const certSheet = getSheet(SHEET_NAMES.CERTIFICATE_DATA);

      if (certSheet) {

        const cValues = certSheet.getDataRange().getValues();

        if (cValues.length > 1) {

          const headers = cValues[0];

          const rCol = headers.indexOf("StudentRegistrationID");

          const nCol = headers.indexOf("CertificateNumber");

          const pCol = headers.indexOf("CertificatePdfId");

          if (rCol !== -1) {

            for (let i = 1; i < cValues.length; i++) {

              const rId = String(cValues[i][rCol] || '').trim().toUpperCase();

              if (rId) {

                const cNum = nCol !== -1 ? String(cValues[i][nCol] || '').trim() : '';

                const pId = pCol !== -1 ? String(cValues[i][pCol] || '').trim() : '';

                certMap[rId] = {

                  certNumber: cNum,

                  pdfId: pId,

                  pdfUrl: pId ? `https://drive.google.com/file/d/${pId}/view` : '',

                  hasCert: !!(cNum || pId)

                };

              }

            }

          }

        }

      }

    } catch(e) {}



    const getFieldVal_ = (obj, ...keys) => {

      if (!obj) return '';

      for (const k of keys) {

        if (obj[k] !== undefined && obj[k] !== null) {

          const v = String(obj[k]).trim();

          if (v !== '' && v !== 'N/A' && v !== '--' && v !== '-' && !/^#(N\/A|REF!|VALUE!)/.test(v)) return v;

        }

      }

      const norm = (s) => String(s || '').replace(/[\s_]+/g, '').toLowerCase();

      for (const k of keys) {

        const nk = norm(k);

        for (const p in obj) {

          if (norm(p) === nk && obj[p] !== undefined && obj[p] !== null) {

            const v = String(obj[p]).trim();

            if (v !== '' && v !== 'N/A' && v !== '--' && v !== '-' && !/^#(N\/A|REF!|VALUE!)/.test(v)) return v;

          }

        }

      }

      return '';

    };



    const students = combinedData.map(d => {

      const regId = getFieldVal_(d, 'RegistrationID', 'registrationId', 'RegID', 'regId', 'ID', 'id');

      const cInfo = certMap[String(regId).trim().toUpperCase()] || {};

      const certLink = getFieldVal_(d, 'CertificateLink', 'certificateLink', 'CertLink') || cInfo.pdfUrl || '';

      const certNum = getFieldVal_(d, 'CertificateNumber', 'certificateNumber', 'certNumber', 'CertificateNo') || cInfo.certNumber || '';

      const hasCert = !!(certLink || certNum || cInfo.hasCert);

      

      const fName = getFieldVal_(d, 'FirstName', 'firstName', 'First Name');

      const mName = getFieldVal_(d, 'MiddleName', 'middleName', 'Middle Name');

      const lName = getFieldVal_(d, 'LastName', 'lastName', 'Last Name');

      const combinedName = [fName, mName, lName].filter(Boolean).join(' ').trim();

      const fullName = combinedName || getFieldVal_(d, 'Name', 'name', 'FullName', 'Full Name', 'StudentName', 'Student Name') || 'Student';

      

      return {

        registrationId: regId,

        name: fullName,

        firstName: fName,

        middleName: mName,

        lastName: lName,

        registerNumber: getFieldVal_(d, 'RegisterNumber', 'registerNumber', 'Register Number', 'RegNo', 'regNo', 'RollNo', 'rollNo', 'RegisterNo'),

        college: getFieldVal_(d, 'CollegeName', 'College Name', 'college', 'College', 'collegeName', 'Institution', 'institution'),

        department: getFieldVal_(d, 'Department', 'department', 'Dept', 'dept', 'Branch', 'branch'),

        year: getFieldVal_(d, 'Year', 'year', 'YearOfStudy', 'Year Of Study', 'Year of Study'),

        batch: getFieldVal_(d, 'Batch', 'batch', 'BatchName', 'Batch Name') || 'Unassigned',

        gmail: getFieldVal_(d, 'GmailID', 'Gmail ID', 'gmail', 'Gmail', 'email', 'Email', 'EmailID', 'Email ID', 'EmailAddress', 'Email Address'),

        mobile: getFieldVal_(d, 'MobileNumber', 'Mobile Number', 'mobile', 'Mobile', 'phone', 'Phone', 'PhoneNumber', 'Phone Number', 'ContactNumber', 'Contact Number', 'MobileNo', 'Mobile No'),

        projectName: getFieldVal_(d, 'ProjectTitle', 'Project Title', 'ProjectName', 'Project Name', 'projectName', 'InterestedArea', 'Interested Area', 'interestedArea', 'Title', 'title', 'WorkArea', 'Domain', 'SkillLearned'),

        interestedArea: getFieldVal_(d, 'InterestedArea', 'Interested Area', 'interestedArea', 'WorkArea', 'Domain', 'SkillLearned'),

        duration: getFieldVal_(d, 'DurationDays', 'Duration Days', 'Duration', 'duration', 'Duration (Days)') || '30',

        internshipStartDate: getFieldVal_(d, 'InternshipStartDate', 'Internship Start Date', 'internshipStartDate', 'StartDate', 'Start Date', 'startDate', 'Start', 'start', 'internshipStart', 'InternshipStart'),

        internshipEndDate: getFieldVal_(d, 'InternshipEndDate', 'Internship End Date', 'internshipEndDate', 'EndDate', 'End Date', 'endDate', 'End', 'end', 'internshipEnd', 'InternshipEnd'),

        status: getFieldVal_(d, 'ApplicationStatus', 'Application Status', 'status', 'Status', 'actualStatus') || 'Approved',

        applicationStatus: getFieldVal_(d, 'ApplicationStatus', 'Application Status', 'status', 'Status', 'actualStatus') || 'Approved',

        certificateIssued: hasCert,

        certificateNumber: certNum,

        certificateLink: certLink,

        photoUrl: getFieldVal_(d, 'ProfilePhotoUrl', 'Profile Photo', 'photoUrl', 'Photo', 'PhotoUrl', 'PassportPhoto'),

        appliedDate: getFieldVal_(d, 'Timestamp', 'appliedDate', 'AppliedDate', 'Date', 'date')

      };

    });



    const batchSet = new Set();

    students.forEach(s => {

      if (s.batch && s.batch !== 'Unassigned' && s.batch !== 'No Batch' && s.batch !== 'all') {

        batchSet.add(s.batch.trim());

      }

    });



    const batches = Array.from(batchSet).sort();



    return {

      status: 'success',

      students: students,

      batches: batches

    };

  } catch (err) {

    Logger.log('getWarningNoticeStudents error: ' + err.toString());

    return { status: 'error', message: 'Failed to load warning notice students: ' + err.toString() };

  }

}



/**

 * Returns HTML preview for Notice modal before sending.

 */

function previewStudentNotice(regId, noticeType, customReason, deadlineDays) {

  try {

    noticeType = noticeType || 'disciplinaryWarning';

    deadlineDays = parseInt(deadlineDays || 7, 10);



    const studentInfo = getStudentFullData(regId);

    if (studentInfo.status !== 'success') return { status: 'error', message: 'Student data not found' };



    const d = studentInfo.studentData;

    const name = getStudentFullName_(d);

    const zone = Session.getScriptTimeZone() || 'Asia/Kolkata';

    const todayStr = Utilities.formatDate(new Date(), zone, 'dd MMMM yyyy');

    const deadlineDate = new Date();

    deadlineDate.setDate(deadlineDate.getDate() + deadlineDays);

    const deadlineStr = Utilities.formatDate(deadlineDate, zone, 'dd MMMM yyyy');



    let noticeHeading = '⚠ OFFICIAL WARNING NOTICE';

    let headerColor = '#b71c1c';

    let bodyText = `This is an official Disciplinary Warning Notice regarding your internship performance at ${COMPANY_NAME}. It has been observed that you have delayed or neglected the completion of your assigned project/tasks. You have ${deadlineDays} days (until ${deadlineStr}) to complete all pending requirements.`;



    if (noticeType === 'certDelayNotice') {

      noticeHeading = '🎓 OFFICIAL NOTICE: CERTIFICATE HARD-COPY PROCESSING & COLLEGE REFERENCE';

      headerColor = '#1e40af';

      bodyText = `Your physical hard-copy certificate is currently in the printing queue. Your verified soft-copy certificate is attached for immediate submission to your College / University HOD.`;

    } else if (noticeType === 'pendingDocsNotice') {

      noticeHeading = '📎 OFFICIAL NOTICE: PENDING ONBOARDING DOCUMENTS';

      headerColor = '#b45309';

      bodyText = `Please log in to your student portal and upload all pending documents within ${deadlineDays} days (by ${deadlineStr}) to avoid a hold on your certificate.`;

    } else if (noticeType === 'incompleteAttendanceNotice') {

      noticeHeading = '⏰ OFFICIAL NOTICE: ATTENDANCE & DIARY ENTRIES RECTIFICATION';

      headerColor = '#d97706';

      bodyText = `Our records show pending attendance or daily diary logs. You have ${deadlineDays} days (by ${deadlineStr}) to regularize your missed logs.`;

    }



    if (customReason) bodyText += `<br><br><strong>Additional Details:</strong> ${customReason}`;



    const previewHtml = `

      <div style="font-family: Arial, sans-serif; padding: 20px; background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; max-width: 750px; margin: auto;">

        <div style="text-align:center; border-bottom: 2px solid ${headerColor}; padding-bottom: 10px; margin-bottom: 15px;">

          <h2 style="color:${headerColor}; margin:0; text-transform:uppercase;">${COMPANY_NAME}</h2>

          <p style="margin:3px 0; color:#64748b; font-size:12px;">Internship Portal &amp; Technical Operations</p>

        </div>

        <div style="text-align:center; margin-bottom: 15px;">

          <span style="background:${headerColor}; color:#fff; font-weight:bold; font-size:11px; padding:4px 12px; border-radius:4px; text-transform:uppercase;">

            ${noticeHeading}

          </span>

        </div>

        <table style="width:100%; font-size:12px; margin-bottom:15px; border-collapse:collapse;" border="1" cellpadding="6">

          <tr style="background:#f8fafc;"><td><strong>Student Name:</strong> ${name}</td><td><strong>Reg ID:</strong> ${regId}</td></tr>

          <tr><td><strong>College:</strong> ${d.CollegeName || 'N/A'}</td><td><strong>Department:</strong> ${d.Department || 'N/A'}</td></tr>

          <tr style="background:#f8fafc;"><td><strong>Internship Period:</strong> ${formatDate(d.InternshipStartDate)} to ${formatDate(d.InternshipEndDate)}</td><td><strong>Deadline:</strong> ${deadlineStr}</td></tr>

        </table>

        <div style="font-size:13px; color:#334155; line-height:1.6; margin-bottom:20px;">

          ${bodyText}

        </div>

        <div style="border-top:1px solid #e2e8f0; padding-top:12px; font-size:12px; color:#475569;">

          <strong>Authorized Signatory:</strong><br>

          ${COMPANY_CHIEF_ENGINEER} .DEEE, BE, MBA<br>

          <span style="color:${headerColor}; font-weight:bold;">${COMPANY_NAME}</span>

        </div>

      </div>

    `;



    return { status: 'success', previewHtml: previewHtml, studentData: d };

  } catch (e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Generates a complete bundle of documents for a student:

 * - attendanceDocument (Consolidated Attendance)

 * - studentDiary (Form-5)

 * - internshipCertificate

 * - applicationForm

 * - projectCompletion / taskCompletion

 */

function generateCompleteStudentProfileBundle(regId, selectedDocTypes, sendMail, opts) {

  try {

    opts = opts || {};

    selectedDocTypes = selectedDocTypes || ['attendanceDocument', 'studentDiary', 'internshipCertificate', 'applicationForm', 'projectCompletion', 'studentCV', 'offerLetter'];

    const results = {};

    const attachments = [];



    const studentInfo = getStudentFullData(regId);

    if (studentInfo.status !== 'success') return { status: 'error', message: 'Student not found.' };

    const d = studentInfo.studentData;



    selectedDocTypes.forEach(docType => {

      try {

        const isExistingRequested = (opts.docVersions && opts.docVersions[docType] === 'existing');

        if (isExistingRequested) {

          const existing = getExistingGeneratedDocRecord_(regId, docType);

          if (existing && existing.fileId) {

            results[docType] = existing;

            try {

              attachments.push(DriveApp.getFileById(existing.fileId).getBlob());

            } catch(attErr) {

              Logger.log("Existing file attachment error: " + attErr);

            }

            return;

          }

        }



        if (docType === 'attendanceDocument' || docType === 'consolidatedAttendance') {

          const res = generateConsolidatedAttendancePDF(regId);

          results['attendanceDocument'] = res;

          if (res.fileId) attachments.push(DriveApp.getFileById(res.fileId).getBlob());

        } else if (docType === 'studentDiary') {

          const res = generateStudentDiaryPDF_V2({ regId: regId, mode: 'consolidated' });

          results['studentDiary'] = res;

          if (res.fileId) attachments.push(DriveApp.getFileById(res.fileId).getBlob());

        } else {

          const docOpts = Object.assign({}, opts);

          docOpts.forceNew = !isExistingRequested;

          const res = generateDocumentAndMail(docType, regId, false, true, docOpts);

          results[docType] = res;

          if (res.fileId) attachments.push(DriveApp.getFileById(res.fileId).getBlob());

        }

      } catch (docErr) {

        results[docType] = { status: 'error', message: docErr.toString() };

      }

    });



    if (sendMail && d.GmailID && attachments.length > 0) {

      const subject = `Your Complete Internship Documents Bundle — ${COMPANY_NAME}`;

      const emailHtml = `

        <div style="font-family: Arial, sans-serif; max-width:600px; margin:auto; padding:20px; border:1px solid #e2e8f0; border-radius:10px;">

          <div style="text-align:center; border-bottom:2px solid #2563eb; padding-bottom:12px; margin-bottom:15px;">

            <h2 style="color:#1e3a8a; margin:0;">${COMPANY_NAME}</h2>

            <p style="color:#2563eb; font-weight:bold; margin:4px 0;">Complete Student Documents Bundle</p>

          </div>

          <p>Dear <strong>${getStudentFullName_(d)}</strong>,</p>

          <p>Please find attached your complete set of official Internship Documents generated for Registration ID <strong>${regId}</strong>.</p>

          <ul style="color:#334155; font-size:13px; line-height:1.6;">

            ${selectedDocTypes.map(t => `<li><strong>${t}</strong>: Processed &amp; Attached</li>`).join('')}

          </ul>

          <p style="font-size:13px; color:#475569;">You can also access and download these files directly from your Student Portal.</p>

          <div style="text-align:center; margin:20px 0;">

            <a href="${PORTAL_URL}" style="background:#2563eb; color:white; padding:10px 22px; text-decoration:none; border-radius:6px; font-weight:bold; font-size:13px;">Login to Portal</a>

          </div>

          <p style="font-size:12px; color:#94a3b8; text-align:center; margin-top:20px;">Digitally generated by ${COMPANY_NAME} Internship Portal.</p>

        </div>

      `;



      sendEmail(d.GmailID, subject, '', emailHtml, attachments);

    }



    return {

      status: 'success',

      message: `Complete document bundle processed for ${getStudentFullName_(d)}.`,

      results: results

    };

  } catch (e) {

    Logger.log('generateCompleteStudentProfileBundle error: ' + e.toString());

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Processes and generates documents in batch for multiple selected students.

 * Supports individual document generation as well as complete bundle generation.

 * Accepts per-student overrides (such as manual attended days).

 */

function generateBatchStudentDocuments(regIds, docType, selectedBundleTypes, certTemplate, sendMail, studentOverrides) {

  try {

    if (!Array.isArray(regIds) || regIds.length === 0) {

      return { status: 'error', message: 'No students selected for batch generation.' };

    }



    // Deduplicate regIds to guarantee each student is processed only once

    regIds = Array.from(new Set(regIds.map(r => String(r || '').trim()).filter(Boolean)));

    if (regIds.length === 0) {

      return { status: 'error', message: 'No valid students selected for batch generation.' };

    }



    docType = docType || 'internshipCertificate';

    sendMail = (sendMail === true || sendMail === 'true');

    certTemplate = certTemplate || 'T2';

    selectedBundleTypes = selectedBundleTypes || ['attendanceDocument', 'studentDiary', 'internshipCertificate', 'applicationForm', 'projectCompletion', 'studentCV', 'offerLetter'];

    studentOverrides = studentOverrides || {};



    let successCount = 0;

    let failedCount = 0;

    const results = [];



    for (let i = 0; i < regIds.length; i++) {

      const regId = regIds[i];

      const customAttended = studentOverrides[regId] ? studentOverrides[regId].attendedDays : null;

      const opts = {

        certTemplate: certTemplate,

        manualAttendedDays: customAttended,

        includePhysicalSealSig: (studentOverrides && studentOverrides.includePhysicalSealSig !== undefined) ? studentOverrides.includePhysicalSealSig : false,

        includePhysicalSeal: (studentOverrides && studentOverrides.includePhysicalSeal !== undefined) ? studentOverrides.includePhysicalSeal : ((studentOverrides && studentOverrides.includePhysicalSealSig !== undefined) ? studentOverrides.includePhysicalSealSig : false),

        includePhysicalSig: (studentOverrides && studentOverrides.includePhysicalSig !== undefined) ? studentOverrides.includePhysicalSig : ((studentOverrides && studentOverrides.includePhysicalSealSig !== undefined) ? studentOverrides.includePhysicalSig : false),

        includeDigitalSign: (studentOverrides && studentOverrides.includeDigitalSign !== undefined) ? studentOverrides.includeDigitalSign : true,

        addVerificationWatermark: (studentOverrides && studentOverrides.addVerificationWatermark !== undefined) ? studentOverrides.addVerificationWatermark : false,

        includeNote: (studentOverrides && (studentOverrides.includeNote !== undefined ? studentOverrides.includeNote : studentOverrides.addVerificationWatermark)) || false,

        includeVerificationQR: (studentOverrides && studentOverrides.includeVerificationQR !== undefined) ? studentOverrides.includeVerificationQR : true,

        includePhotoInApplicationForm: (studentOverrides && studentOverrides.includePhotoInApplicationForm !== undefined) ? studentOverrides.includePhotoInApplicationForm : true,

        includePhotoInCertificate: (studentOverrides && studentOverrides.includePhotoInCertificate !== undefined) ? studentOverrides.includePhotoInCertificate : true,

        includePhoto: (studentOverrides && studentOverrides.includePhoto !== undefined) ? studentOverrides.includePhoto : true,

        docVersions: studentOverrides.docVersions || {},

        forceNew: (studentOverrides.forceNew !== undefined) ? studentOverrides.forceNew : true

      };



      try {

        if (docType === 'studentAllDocuments') {

          const res = generateCompleteStudentProfileBundle(regId, selectedBundleTypes, sendMail, opts);

          if (res.status === 'success') {

            successCount++;

            results.push({ regId: regId, status: 'success', bundleResults: res.results, message: 'Bundle generated successfully' });

          } else {

            failedCount++;

            results.push({ regId: regId, status: 'error', message: res.message });

          }

        } else if (docType === 'attendanceDocument') {

          const res = generateConsolidatedAttendancePDF(regId);

          if (res.status === 'success') {

            successCount++;

            results.push({ regId: regId, status: 'success', url: res.driveLink || res.url, message: res.message });

          } else {

            failedCount++;

            results.push({ regId: regId, status: 'error', message: res.message });

          }

        } else {

          const isCertificate = (docType === 'internshipCertificate' || docType === 'completionCertificate');

          const res = generateDocumentAndMail(docType, regId, sendMail, isCertificate, opts);

          if (res.status === 'success') {

            successCount++;

            results.push({ regId: regId, status: 'success', url: res.driveLink || res.url, message: res.message, certNumber: res.certNumber });

          } else {

            failedCount++;

            results.push({ regId: regId, status: 'error', message: res.message });

          }

        }

      } catch (err) {

        failedCount++;

        results.push({ regId: regId, status: 'error', message: err.toString() });

      }

    }



    return {

      status: 'success',

      message: `Batch generation complete. Successfully processed: ${successCount}, Failed: ${failedCount}.`,

      successCount: successCount,

      failedCount: failedCount,

      results: results

    };

  } catch (e) {

    Logger.log('generateBatchStudentDocuments error: ' + e.toString());

    return { status: 'error', message: 'Batch generation failed: ' + e.toString() };

  }

}



















// ══════════════════════════════════════════════════════════════════════

// COMPREHENSIVE STUDENT DATABASE & DOSSIER BACKEND ENGINE

// ══════════════════════════════════════════════════════════════════════



function getScriptUrl() {

  try {

    return ScriptApp.getService().getUrl();

  } catch (e) {

    return PORTAL_URL || '';

  }

}



function formatDateDMY(dateInput) {

  if (!dateInput || dateInput === '--' || dateInput === 'null' || dateInput === 'undefined') return '--';

  if (dateInput instanceof Date) {

    if (isNaN(dateInput.getTime())) return '--';

    const d = String(dateInput.getDate()).padStart(2, '0');

    const m = String(dateInput.getMonth() + 1).padStart(2, '0');

    const y = dateInput.getFullYear();

    return d + '/' + m + '/' + y;

  }

  if (typeof dateInput === 'string') {

    const s = dateInput.trim();

    if (!s || s === '--') return '--';

    if (/^\d{1,2}\/\d{1,2}\/\d{4}$/.test(s)) {

      const p = s.split('/');

      return p[0].padStart(2, '0') + '/' + p[1].padStart(2, '0') + '/' + p[2];

    }

    if (/^\d{4}-\d{1,2}-\d{1,2}/.test(s)) {

      const p = s.split('T')[0].split('-');

      if (p.length === 3) {

        return p[2].padStart(2, '0') + '/' + p[1].padStart(2, '0') + '/' + p[0];

      }

    }

    if (/^\d{1,2}-\d{1,2}-\d{4}$/.test(s)) {

      const p = s.split('-');

      return p[0].padStart(2, '0') + '/' + p[1].padStart(2, '0') + '/' + p[2];

    }

    try {

      const parsed = new Date(s);

      if (!isNaN(parsed.getTime()) && parsed.getFullYear() > 1900) {

        const d = String(parsed.getDate()).padStart(2, '0');

        const m = String(parsed.getMonth() + 1).padStart(2, '0');

        const y = parsed.getFullYear();

        return d + '/' + m + '/' + y;

      }

    } catch (e) {}

    return s;

  }

  try {

    const parsed = new Date(dateInput);

    if (!isNaN(parsed.getTime()) && parsed.getFullYear() > 1900) {

      const d = String(parsed.getDate()).padStart(2, '0');

      const m = String(parsed.getMonth() + 1).padStart(2, '0');

      const y = parsed.getFullYear();

      return d + '/' + m + '/' + y;

    }

  } catch (e) {}

  return String(dateInput);

}



function getStudentDatabaseRecords() {

  try {

    if (typeof executionCache !== 'undefined' && executionCache.clear) {

      executionCache.clear();

    }

    const rawData = getAllStudents();

    if (!rawData || !Array.isArray(rawData)) {

      return { status: 'error', message: 'Failed to fetch registered students' };

    }



    // Build quick certificate lookup map from CertificateData & GeneratedDocuments

    const certMap = {};

    try {

      const certSheet = getSheet(SHEET_NAMES.CERTIFICATE_DATA);

      if (certSheet) {

        const cData = certSheet.getDataRange().getValues();

        const cRegCol = cData[0].indexOf("StudentRegistrationID");

        const cNumCol = cData[0].indexOf("CertificateNumber");

        const cPdfCol = cData[0].indexOf("CertificatePdfId");

        const cDateCol = cData[0].indexOf("IssuedDate");

        if (cRegCol !== -1) {

          for (let i = 1; i < cData.length; i++) {

            const rId = String(cData[i][cRegCol] || '').trim().toUpperCase();

            if (rId) {

              const num = cNumCol !== -1 ? String(cData[i][cNumCol] || '').trim() : '';

              const pdfId = cPdfCol !== -1 ? String(cData[i][cPdfCol] || '').trim() : '';

              const dt = cDateCol !== -1 ? cData[i][cDateCol] : null;

              certMap[rId] = {

                certNumber: num,

                pdfId: pdfId,

                pdfUrl: pdfId ? `https://drive.google.com/file/d/${pdfId}/view` : '',

                issuedDate: dt ? formatDateDMY(dt) : '',

                hasCert: !!(num || pdfId)

              };

            }

          }

        }

      }

    } catch(e) {

      console.warn("Cert map lookup warning:", e.message);

    }



    const STATUS_PRIORITY = {

      'approved': 1,

      'active': 1,

      'assigned': 1,

      'pending': 2,

      'submitted': 2,

      'awaiting': 2,

      'incomplete': 3,

      'completed': 4,

      'internship completed': 4,

      'internship period ended': 4,

      'inactive': 5,

      'vacant': 6,

      'vacated': 6,

      'rejected': 7,

      'on-hold': 7,

      'approved with hold': 7,

      'closed': 8,

      'opt-out': 9,

      'optout': 9,

      'opt out': 9,

      'blacklisted': 10,

      'blocked': 10

    };



    const students = rawData.map((d, index) => {

      const regId = d.registrationId || d.RegistrationID || '';

      const cInfo = certMap[String(regId).trim().toUpperCase()] || {};

      const hasCert = !!(d.CertificateLink || cInfo.hasCert);

      return {

        _rowIndex: index,

        registrationId: regId,

        name: d.name || d.FullName || [d.FirstName, d.MiddleName, d.LastName].filter(Boolean).join(' ').trim() || d.Name || 'Student',

        registerNo: d.registerNumber || d.registerNo || d.RegisterNumber || '--',

        college: d.college || d.CollegeName || '--',

        department: d.department || d.Department || '--',

        batch: d.batch || d.Batch || 'Unassigned',

        rfidTag: d.rfidTag || d.RFID_TagID || '',

        status: d.status || d.applicationStatus || d.ApplicationStatus || 'Approved',

        appliedDate: d.appliedDate || d.AppliedDate || d.internshipStart || d.startDate || '',

        timestamp: d.timestamp || d.Timestamp || '',

        photoUrl: d.profilePhotoUrl || d.ProfilePhotoUrl || d.photoUrl || d.Photo || d.PhotoUrl || '',

        hasCertificate: hasCert,

        certificateNo: cInfo.certNumber || d.CertificateNumber || d.CertificateNo || '',

        certificatePdfUrl: cInfo.pdfUrl || d.CertificateLink || ''

      };

    });



    // Primary: Status Priority (Approved/Active first, Completed next, Inactive, Vacant, etc.)

    // Secondary: Descending order of registration (latest registered student at TOP)

    students.sort((a, b) => {

      const sa = String(a.status || '').toLowerCase().trim();

      const sb = String(b.status || '').toLowerCase().trim();

      const pa = STATUS_PRIORITY[sa] || 99;

      const pb = STATUS_PRIORITY[sb] || 99;

      if (pa !== pb) {

        return pa - pb;

      }



      // Secondary: Date / Timestamp descending

      const rawA = a.timestamp || a.appliedDate;

      const rawB = b.timestamp || b.appliedDate;

      const da = rawA ? new Date(rawA).getTime() : 0;

      const db = rawB ? new Date(rawB).getTime() : 0;

      if (!isNaN(da) && !isNaN(db) && da > 0 && db > 0 && da !== db) {

        return db - da; // Latest date first

      }



      // Numeric portion of Registration ID descending (e.g. VIP-2026-105 vs VIP-2026-001)

      const numA = parseInt(String(a.registrationId || '').replace(/\D/g, ''), 10);

      const numB = parseInt(String(b.registrationId || '').replace(/\D/g, ''), 10);

      if (!isNaN(numA) && !isNaN(numB) && numA !== numB) {

        return numB - numA; // Highest registration number first

      }



      // String ID descending

      const strA = String(a.registrationId || '');

      const strB = String(b.registrationId || '');

      if (strA && strB && strA !== strB) {

        return strB.localeCompare(strA, undefined, { numeric: true, sensitivity: 'base' });

      }



      // Fallback: original sheet row order descending (last added row first)

      return (b._rowIndex || 0) - (a._rowIndex || 0);

    });



    const batches = [...new Set(students.map(s => s.batch).filter(b => b && b !== 'Unassigned' && b !== 'No Batch' && b !== 'all'))];



    return { status: 'success', students: students, batches: batches };

  } catch (err) {

    return { status: 'error', message: 'Failed to fetch student database: ' + err.message };

  }

}



function getStudentDossierDetails(regId) {

  try {

    if (!regId) {

      return { status: 'error', message: 'Registration ID is required' };

    }



    // 1. Fetch Master Student Data

    const fullDataResp = getStudentFullData(regId);

    if (!fullDataResp || fullDataResp.status !== 'success' || !fullDataResp.studentData) {

      return { status: 'error', message: fullDataResp ? fullDataResp.message : 'Student profile not found' };

    }

    const d = fullDataResp.studentData;



    const constructedName = [d.FirstName, d.MiddleName, d.LastName].filter(Boolean).join(' ').trim();

    const name = d.Name || d.FullName || constructedName || d.StudentName || 'Student Profile';

    const registrationId = d.RegistrationID || d.RegistrationId || d.RegID || regId;

    const registerNo = d.RegisterNumber || d.RegisterNo || d.RegistrationNo || d.RollNo || '--';

    const college = d.CollegeName || d.College || d.Institution || '--';

    const collegeCode = d.CollegeCode || d.CollegeDistrict || '--';

    const collegeAddress = d.CollegeAddress || d.Address || '--';

    const collegeDistrict = d.CollegeDistrict || d.District || '--';

    const department = d.Department || d.Dept || d.Branch || '--';

    const fullDepartment = d.FullDepartment || d.DepartmentName || department;

    const semester = d.Semester || '--';

    const year = d.Year || '--';

    const educationType = d.EducationType || 'Engineering UG';

    const gpa = d.GPA || d.CGPA || '--';

    const fatherName = d.FatherName || d.GuardianName || d['Father Name'] || '--';

    const rawDob = d.DateofBirth || d.DOB || d.DateOfBirth || '--';

    const dob = formatDateDMY(rawDob);

    const gender = d.Gender || '--';

    const mobile = d.MobileNumber || d.Mobile || d.Phone || '--';

    const email = d.GmailID || d.Email || d.EmailID || '--';

    const address = d.Address || '--';

    const district = d.District || '--';

    const pincode = d.Pincode || '--';

    const batch = d.Batch || d.BatchName || 'Unassigned';

    const interestedArea = d.InterestedArea || d.Track || 'R&D (IoT & Electronics)';



    // Query Batch's SkillLearned from BATCHES sheet as highest priority

    let batchSkillLearned = '';

    if (batch && String(batch).trim() !== '' && String(batch).toLowerCase() !== 'unassigned') {

      try {

        const batchSheet = getSheet(SHEET_NAMES.BATCHES);

        if (batchSheet) {

          const bData = getSheetDataAsObjects(batchSheet);

          const foundBatch = bData.find(b => String(b.BatchName || b.BatchID || '').trim().toLowerCase() === String(batch).trim().toLowerCase());

          if (foundBatch) {

            batchSkillLearned = foundBatch.SkillLearned || foundBatch['Skill Learned'] || foundBatch.BatchTitle || foundBatch.Project || '';

          }

        }

        if (!batchSkillLearned) {

          batchSkillLearned = getCertificateContentForBatch(batch) || '';

        }

      } catch (e) {

        console.warn('Batch skill lookup warning:', e.message);

      }

    }

    const skillLearned = batchSkillLearned || d.SkillLearned || interestedArea || 'Applied Electronics, IoT & Embedded Systems';



    const rawStartDate = d.InternshipStartDate || d.StartDate || '--';

    const rawEndDate = d.InternshipEndDate || d.EndDate || '--';

    const startDate = formatDateDMY(rawStartDate);

    const endDate = formatDateDMY(rawEndDate);

    const durationDays = parseInt(d.DurationDays || d.Duration || '30', 10) || 30;

    const rfidTag = d.RFID_TagID || d.RFID_UID || d.RFID || '';

    const status = d.ApplicationStatus || d.Status || 'Active';

    const photoUrl = d.ProfilePhotoUrl || d.PhotoUrl || d.Photo || d.photoUrl || '';

    const approvalDate = formatDateDMY(d.ApprovalDate || '--');



    // Grace Period calculation

    let gracePeriodInfo = {

      isExpired: false,

      isGraceActive: false,

      daysElapsed: 0,

      statusLabel: 'Normal'

    };

    if (rawEndDate && rawEndDate !== '--') {

      let endD = new Date(rawEndDate);

      if (isNaN(endD.getTime()) && typeof rawEndDate === 'string' && /^\d{1,2}\/\d{1,2}\/\d{4}$/.test(rawEndDate)) {

        const p = rawEndDate.split('/');

        endD = new Date(parseInt(p[2], 10), parseInt(p[1], 10) - 1, parseInt(p[0], 10));

      }

      if (!isNaN(endD.getTime())) {

        const today = new Date();

        today.setHours(0, 0, 0, 0);

        endD.setHours(0, 0, 0, 0);

        if (today > endD) {

          const diffTime = Math.abs(today - endD);

          const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

          gracePeriodInfo.isExpired = true;

          gracePeriodInfo.daysElapsed = diffDays;

          gracePeriodInfo.statusLabel = diffDays <= 7 ? `Grace Period (${diffDays}d overdue)` : `Overdue (${diffDays}d past end date)`;

        }

      }

    }



    // Permissions

    const permissions = {

      attendance: d.AttendanceAccess !== 'Revoked' && d.AttendanceAccess !== 'false' && d.AttendanceAccess !== false,

      diary: d.DiaryAccess !== 'Revoked' && d.DiaryAccess !== 'false' && d.DiaryAccess !== false,

      fileManager: d.FileManagerAccess !== 'Revoked' && d.FileManagerAccess !== 'false' && d.FileManagerAccess !== false,

      leave: d.LeaveAccess !== 'Revoked' && d.LeaveAccess !== 'false' && d.LeaveAccess !== false,

      profile: d.ProfileAccess !== 'Revoked' && d.ProfileAccess !== 'false' && d.ProfileAccess !== false

    };



    // 2. Build 30-Day Attendance Grid Data using the unified attendance engine (Single Source of Truth)

    const attStats = calculateStudentAttendedDays_(registrationId, d);



    const attendanceLogs = (attStats.dayLogs || []).map(l => {

      let num = l.daySequence;

      if (!num && typeof l.dayNumber === 'string') {

        const parsed = parseInt(l.dayNumber.replace(/\D/g, ''), 10);

        if (!isNaN(parsed)) num = parsed;

      }

      return {

        dayNum: num || 1,

        date: formatDateDMY(l.dateISO || l.date),

        isoDate: l.dateISO || l.date,

        status: (l.status && String(l.status).toLowerCase().includes('diarycorrection')) ? 'Present' : (l.status || 'Absent'),

        inTime: (l.inTime && l.inTime !== '-' && l.inTime !== '--:--') ? l.inTime : (l.isAttended ? '09:30 AM' : '--:--'),

        outTime: (l.outTime && l.outTime !== '-' && l.outTime !== '--:--') ? l.outTime : (l.isAttended ? '05:30 PM' : '--:--'),

        mode: (l.entryMode && String(l.entryMode).toLowerCase().includes('diarycorrection')) ? 'Admin Approved (Diary Correction)' : (l.entryMode || 'Manual'),

        credit: l.credit || '',

        remarks: l.remarks || '',

        isAttended: !!l.isAttended,

        isSunday: !!l.isSunday

      };

    });



    // 3. Build 30-Day Student Diary Grid Data

    let diaryLogs = [];

    let filledDiaryCount = 0;

    let rawDiaryMap = {};



    try {

      const dSheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

      if (dSheet) {

        const dData = getSheetDataAsObjects(dSheet);

        dData.filter(r => String(r.RegistrationID || r.RegID || r.StudentRegistrationID || '').trim().toUpperCase() === String(registrationId).trim().toUpperCase()).forEach(r => {

          const dISO = toISODateStr_(r.Date);

          if (dISO) rawDiaryMap[dISO] = r;

          const dRaw = String(r.Date || '').trim();

          if (dRaw) rawDiaryMap[dRaw] = r;

          const dFormatted = formatDateDMY(r.Date);

          if (dFormatted) rawDiaryMap[dFormatted] = r;

        });

      }

    } catch (e) {

      console.warn('Diary lookup warning:', e.message);

    }



    let startD = new Date(rawStartDate && rawStartDate !== '--' ? rawStartDate : new Date());

    if (isNaN(startD.getTime())) {

      if (typeof rawStartDate === 'string' && /^\d{1,2}\/\d{1,2}\/\d{4}$/.test(rawStartDate)) {

        const p = rawStartDate.split('/');

        startD = new Date(parseInt(p[2], 10), parseInt(p[1], 10) - 1, parseInt(p[0], 10));

      } else {

        startD = new Date();

      }

    }



    for (let day = 1; day <= durationDays; day++) {

      let curD = new Date(startD);

      curD.setDate(curD.getDate() + (day - 1));

      let isoDate = toISODateStr_(curD) || curD.toISOString().split('T')[0];

      let dayName = curD.toLocaleDateString('en-US', { weekday: 'short' });

      let isSunday = curD.getDay() === 0;



      let record = rawDiaryMap[isoDate] || rawDiaryMap[formatDateDMY(isoDate)] || rawDiaryMap[formatDate(curD)];

      let dStatus = 'Not Submitted';

      let hours = 0;

      let content = '';

      let remarks = '';



      const todayISOStr = Utilities.formatDate(new Date(), "GMT+5:30", "yyyy-MM-dd");
      const isCandPending = (String(status || '').trim().toLowerCase() === 'pending' || !status);
      const isCandCompleted = (String(status || '').trim().toLowerCase() === 'completed');

      if (isCandPending) {
        dStatus = 'Pending Approval';
        hours = 0;
        content = '';
        remarks = 'Diary Inactive (Pending Approval)';
      } else if (isoDate > todayISOStr && !isCandCompleted) {
        dStatus = 'Upcoming';
        hours = 0;
        content = '';
        remarks = 'Upcoming Scheduled Day';
      } else if (isSunday) {

        dStatus = 'Weekly Off';

      } else if (record) {

        dStatus = record.Status || 'Submitted';

        hours = record.HoursSpent || record.Hours || 8;

        content = record.Content || record.WorkDone || record.Description || record.Task || '';

        remarks = record.SupervisorRemarks || record.Remarks || 'Reviewed & Approved';

        filledDiaryCount++;

      }



      diaryLogs.push({

        dayNum: day,

        date: formatDateDMY(isoDate),

        isoDate: isoDate,

        dayName: dayName,

        status: dStatus,

        hours: hours,

        content: content,

        remarks: remarks

      });

    }



    // 4. ROBUST CROSS-SHEET CERTIFICATE RESOLVER

    let certStatus = 'Pending';

    let certNumber = '';

    let certIssuedDate = '--';

    let certPdfUrl = '';



    // Check 1: CertificateData sheet

    try {

      const certSheet = getSheet(SHEET_NAMES.CERTIFICATE_DATA);

      if (certSheet) {

        const cData = certSheet.getDataRange().getValues();

        const cRegCol = cData[0].indexOf("StudentRegistrationID");

        const cNumCol = cData[0].indexOf("CertificateNumber");

        const cPdfCol = cData[0].indexOf("CertificatePdfId");

        const cDateCol = cData[0].indexOf("IssuedDate");

        if (cRegCol !== -1) {

          for (let i = cData.length - 1; i >= 1; i--) {

            if (String(cData[i][cRegCol] || '').trim().toUpperCase() === String(regId).trim().toUpperCase()) {

              if (cNumCol !== -1 && cData[i][cNumCol]) certNumber = String(cData[i][cNumCol]).trim();

              if (cPdfCol !== -1 && cData[i][cPdfCol]) {

                const pId = String(cData[i][cPdfCol]).trim();

                certPdfUrl = `https://drive.google.com/file/d/${pId}/view`;

              }

              if (cDateCol !== -1 && cData[i][cDateCol]) {

                const dt = cData[i][cDateCol];

                certIssuedDate = formatDateDMY(dt);

              }

              if (certNumber || certPdfUrl) {

                certStatus = 'Issued';

                break;

              }

            }

          }

        }

      }

    } catch (e) {

      console.warn('CertificateData lookup warning:', e.message);

    }



    // Check 2: GeneratedDocuments sheet

    let generatedDocsMap = {};

    try {

      const genDocSheet = getSheet(SHEET_NAMES.GENERATED_DOCUMENTS);

      if (genDocSheet) {

        const gData = genDocSheet.getDataRange().getValues();

        const gRegCol = gData[0].indexOf("StudentRegistrationID");

        const gTypeCol = gData[0].indexOf("DocType");

        const gUrlCol = gData[0].indexOf("DocUrl");

        const gPdfIdCol = gData[0].indexOf("PdfFileId");

        const gDateCol = gData[0].indexOf("GeneratedDate");

        if (gRegCol !== -1 && gTypeCol !== -1) {

          for (let i = gData.length - 1; i >= 1; i--) {

            if (String(gData[i][gRegCol] || '').trim().toUpperCase() === String(regId).trim().toUpperCase()) {

              const docType = String(gData[i][gTypeCol] || '').trim();

              const url = gUrlCol !== -1 ? String(gData[i][gUrlCol] || '').trim() : '';

              const pId = gPdfIdCol !== -1 ? String(gData[i][gPdfIdCol] || '').trim() : '';

              const gDate = gDateCol !== -1 ? gData[i][gDateCol] : null;

              if (docType && !generatedDocsMap[docType]) {

                generatedDocsMap[docType] = {

                  url: url || (pId ? `https://drive.google.com/file/d/${pId}/view` : ''),

                  pdfId: pId,

                  date: gDate ? formatDateDMY(gDate) : ''

                };

              }

            }

          }

        }

      }

    } catch (e) {

      console.warn('GeneratedDocuments lookup warning:', e.message);

    }



    // If Certificate was found in GeneratedDocuments

    const certDocGen = generatedDocsMap['internshipCertificate'] || generatedDocsMap['completionCertificate'] || generatedDocsMap['internshipCertificate_T2'];

    if (certDocGen && !certPdfUrl) {

      certPdfUrl = certDocGen.url;

      certStatus = 'Issued';

      if (certIssuedDate === '--' && certDocGen.date) certIssuedDate = certDocGen.date;

    }



    // Check 3: Master Registrations sheet

    if (d.CertificateLink) {

      certStatus = 'Issued';

      if (!certPdfUrl) certPdfUrl = d.CertificateLink;

      if (certIssuedDate === '--' && d.CertificateIssuedDate) {

        certIssuedDate = formatDateDMY(d.CertificateIssuedDate);

      }

    }

    if (!certNumber && (d.CertificateNo || d.CertificateNumber)) {

      certNumber = d.CertificateNo || d.CertificateNumber;

    }

    if (certStatus === 'Issued' && !certNumber) {

      certNumber = `GSV-CERT-${regId.split('/').pop()}`;

    }



    let certVerificationUrl = '';

    try {

      const baseAppUrl = getScriptUrl() || PORTAL_URL || '';

      if (certStatus === 'Issued' && baseAppUrl) {

        certVerificationUrl = `${baseAppUrl}?verify=${encodeURIComponent(registrationId)}`;

      }

    } catch (e) {

      certVerificationUrl = '';

    }



    // 5. Query Student Requests

    let studentRequests = [];

    try {

      const reqSheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

      if (reqSheet) {

        const reqData = getSheetDataAsObjects(reqSheet);

        studentRequests = reqData.filter(r => String(r.RegistrationID || '').trim().toUpperCase() === String(regId).trim().toUpperCase()).map(r => {

          return {

            requestId: r.RequestID || '',

            requestType: r.RequestType || 'General Request',

            section: r.Section || '',

            targetDate: r.TargetDate ? formatDateDMY(r.TargetDate) : '',

            reason: r.Reason || '',

            status: r.Status || 'Pending',

            requestDate: r.RequestDate ? formatDateDMY(r.RequestDate) : ''

          };

        });

      }

    } catch (e) {

      console.warn('Student requests lookup warning:', e.message);

    }



    // 6. Query Tasks & Projects Overview

    let taskStats = { total: 0, completed: 0, pending: 0 };

    let projectStats = { total: 0, completed: 0, pending: 0 };

    try {

      const taskSheet = getSheet(SHEET_NAMES.TASKS);

      if (taskSheet) {

        const tData = getSheetDataAsObjects(taskSheet);

        const sTasks = tData.filter(t => String(t.StudentRegistrationID || '').trim().toUpperCase() === String(regId).trim().toUpperCase());

        taskStats.total = sTasks.length;

        taskStats.completed = sTasks.filter(t => String(t.Status).toLowerCase() === 'completed' || String(t.Status).toLowerCase() === 'submitted').length;

        taskStats.pending = taskStats.total - taskStats.completed;

      }

      const projSheet = getSheet(SHEET_NAMES.PROJECTS);

      if (projSheet) {

        const pData = getSheetDataAsObjects(projSheet);

        const sProjs = pData.filter(p => String(p.StudentRegistrationID || '').trim().toUpperCase() === String(regId).trim().toUpperCase());

        projectStats.total = sProjs.length;

        projectStats.completed = sProjs.filter(p => String(p.Status).toLowerCase() === 'completed').length;

        projectStats.pending = projectStats.total - projectStats.completed;

      }

    } catch (e) {

      console.warn('Tasks/Projects lookup warning:', e.message);

    }



    // 7. Uploaded & Generated Documents

    const documents = {

      uploaded: {

        applicationPdf: d.ApplicationPdfId ? `https://drive.google.com/file/d/${d.ApplicationPdfId}/view` : '',

        joiningLetterPdf: d.JoiningLetterPdfId ? `https://drive.google.com/file/d/${d.JoiningLetterPdfId}/view` : '',

        bonafideUrl: d.BonafideUrl || '',

        declarationUrl: d.DeclarationUrl || '',

        collegeIdUrl: d.CollegeIdUrl || '',

        profilePhotoUrl: photoUrl

      },

      generated: {

        offerLetterUrl: (generatedDocsMap['offerLetter'] && generatedDocsMap['offerLetter'].url) || (d.OfferLetterPdfId ? `https://drive.google.com/file/d/${d.OfferLetterPdfId}/view` : (d.OfferLetterUrl || '')),

        attendanceForm4Url: (generatedDocsMap['attendanceDocument'] && generatedDocsMap['attendanceDocument'].url) || d.AttendanceForm4Url || '',

        studentDiaryForm5Url: (generatedDocsMap['studentDiaryForm5'] && generatedDocsMap['studentDiaryForm5'].url) || d.StudentDiaryForm5Url || '',

        certificateUrl: certPdfUrl

      }

    };



    // 8. Clearance Checklist & Material Due Analysis (For Certificate Clearance Gate)

    const rawHardCopy = String(d.HardCopyStatus || d.HardCopy || '').trim();

    const isHardCopySubmitted = (rawHardCopy.toLowerCase() === 'submitted');

    const hasActiveRfid = (rfidTag && String(rfidTag).trim() !== '' && String(rfidTag).toUpperCase() !== 'UNASSIGNED');

    const isRfidSurrendered = !hasActiveRfid;



    let componentsDueItems = [];

    try {

      const compSheet = getSheet(SHEET_NAMES.COMPONENTS_ISSUED);

      if (compSheet) {

        const compData = getSheetDataAsObjects(compSheet);

        componentsDueItems = compData.filter(c => {

          const sId = String(c.InchargeStudentID || '').trim().toUpperCase();

          const cStat = String(c.Status || '').trim().toLowerCase();

          return (sId === String(regId).trim().toUpperCase() && cStat !== 'returned');

        }).map(c => ({

          issueId: c.IssueID || '',

          itemName: c.ItemName || '',

          specification: c.Specification || '',

          quantity: c.Quantity || 1,

          issuedDate: c.IssuedDate ? formatDateDMY(c.IssuedDate) : '',

          status: c.Status || 'Issued'

        }));

      }

    } catch (eComp) {

      console.warn('Components due lookup warning:', eComp.message);

    }

    const componentsCleared = (componentsDueItems.length === 0);

    const isAllCleared = isHardCopySubmitted && isRfidSurrendered && componentsCleared;



    const clearance = {

      hardCopySubmitted: isHardCopySubmitted,

      hardCopyStatus: isHardCopySubmitted ? 'Submitted' : 'Pending',

      rfidSurrendered: isRfidSurrendered,

      rfidTag: hasActiveRfid ? rfidTag : '',

      componentsCleared: componentsCleared,

      componentsDueCount: componentsDueItems.length,

      componentsDueItems: componentsDueItems,

      isAllCleared: isAllCleared

    };



    return {

      status: 'success',

      profile: {

        name: name,

        registrationId: registrationId,

        registerNo: registerNo,

        fatherName: fatherName,

        dob: dob,

        gender: gender,

        mobile: mobile,

        email: email,

        address: address,

        district: district,

        pincode: pincode,

        college: college,

        collegeCode: collegeCode,

        collegeDistrict: collegeDistrict,

        collegeAddress: collegeAddress,

        department: department,

        fullDepartment: fullDepartment,

        semester: semester,

        year: year,

        educationType: educationType,

        gpa: gpa,

        batch: batch,

        interestedArea: interestedArea,

        skillLearned: skillLearned,

        startDate: startDate,

        endDate: endDate,

        durationDays: durationDays,

        rfidTag: rfidTag,

        status: status,

        hardCopyStatus: isHardCopySubmitted ? 'Submitted' : 'Pending',

        photoUrl: photoUrl,

        approvalDate: approvalDate,

        track: 'Industrial Intern',

        permissions: permissions,

        gracePeriod: gracePeriodInfo,

        tasks: taskStats,

        projects: projectStats

      },

      attendance: {

        totalWorkingDays: attStats.totalWorkingDays || durationDays,

        durationDays: attStats.durationDays || durationDays,

        presentDays: attStats.attendedDays,

        attendedDays: attStats.attendedDays,

        absentDays: attStats.absentDays,

        presentOnTime: attStats.presentCount,

        lateDays: (attStats.lateCount || 0) + (attStats.lateWithPresentCount || 0),

        wfhOdMedicalDays: (attStats.wfhCount || 0) + (attStats.odCount || 0) + (attStats.mlCount || 0),

        sundaysCount: attStats.sundaysCount || 0,

        rfidDays: (attStats.dayLogs || []).filter(l => (l.entryMode || '').toUpperCase().includes('RFID')).length,

        percentage: attStats.percentage,

        logs: attendanceLogs

      },

      diary: {

        totalDays: durationDays,

        filledDays: filledDiaryCount,

        logs: diaryLogs

      },

      certificate: {

        status: certStatus,

        certificateNo: certNumber || 'NOT GENERATED',

        issuedDate: certIssuedDate,

        verificationUrl: certVerificationUrl,

        pdfUrl: certPdfUrl

      },

      requests: studentRequests,

      documents: documents,

      clearance: clearance

    };

  } catch (err) {

    return { status: 'error', message: 'Error loading comprehensive student dossier: ' + err.message };

  }

}



function getStudentDossierData(regId) {

  return getStudentDossierDetails(regId);

}



function surrenderStudentRfid(registrationId) {

  try {

    if (!registrationId) return { status: 'error', message: 'Missing Registration ID' };

    const regId = String(registrationId).trim().toUpperCase();

    returnRfidToPool(regId);

    return { status: 'success', message: `RFID card surrendered and returned to inventory pool for ${regId}.` };

  } catch(e) {

    return { status: 'error', message: e.toString() };

  }

}



function clearStudentComponentsDue(registrationId) {

  try {

    if (!registrationId) return { status: 'error', message: 'Missing Registration ID' };

    const regId = String(registrationId).trim().toUpperCase();

    const sheet = getSheet(SHEET_NAMES.COMPONENTS_ISSUED);

    if (!sheet) return { status: 'success', message: 'Components sheet unavailable.', count: 0 };

    const data = sheet.getDataRange().getValues();

    if (data.length < 2) return { status: 'success', message: 'No component dues found.', count: 0 };

    const headers = data[0];

    const sIdCol = headers.indexOf('InchargeStudentID');

    const statusCol = headers.indexOf('Status');

    const retDateCol = headers.indexOf('ReturnDate');

    const remarksCol = headers.indexOf('Remarks');

    if (sIdCol === -1 || statusCol === -1) return { status: 'error', message: 'Invalid components sheet structure.' };



    let count = 0;

    const now = new Date();

    for (let i = 1; i < data.length; i++) {

      if (String(data[i][sIdCol] || '').trim().toUpperCase() === regId && String(data[i][statusCol] || '').toLowerCase() !== 'returned') {

        sheet.getRange(i + 1, statusCol + 1).setValue('Returned');

        if (retDateCol !== -1) sheet.getRange(i + 1, retDateCol + 1).setValue(now);

        if (remarksCol !== -1) {

          const prev = String(data[i][remarksCol] || '');

          sheet.getRange(i + 1, remarksCol + 1).setValue(prev ? (prev + ' | Cleared for Certificate') : 'Cleared for Certificate');

        }

        count++;

      }

    }

    SpreadsheetApp.flush();

    return { status: 'success', message: `Cleared ${count} issued component(s) for ${regId}.`, count: count };

  } catch(e) {

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Admin: Direct update of a single student's attendance record for a specific day.

 * Modifies or inserts the record in the Attendance sheet and clears execution caches.

 */

function adminUpdateSingleDayAttendance(regId, dateInput, status, inTime, outTime, mode, remarks) {

  try {

    if (!regId) return { status: 'error', message: 'Registration ID required' };

    if (!dateInput) return { status: 'error', message: 'Date required' };



    const attSheet = getSheet(SHEET_NAMES.ATTENDANCE);

    if (!attSheet) return { status: 'error', message: 'Attendance sheet unavailable' };



    const zone = Session.getScriptTimeZone() || 'Asia/Kolkata';

    const toISODateStr = (val) => {

      if (!val) return null;

      if (val instanceof Date) return Utilities.formatDate(val, zone, "yyyy-MM-dd");

      let s = String(val).trim();

      if (/^\d{4}-\d{2}-\d{2}/.test(s)) return s.substring(0, 10);

      if (/^\d{1,2}[\/\-\.]\d{1,2}[\/\-\.]\d{4}/.test(s)) {

        let p = s.split(/[\/\-\.]/);

        return p[2] + '-' + p[1].padStart(2, '0') + '-' + p[0].padStart(2, '0');

      }

      let d = new Date(val);

      if (!isNaN(d.getTime())) return Utilities.formatDate(d, zone, "yyyy-MM-dd");

      return null;

    };



    const targetISO = toISODateStr(dateInput);

    if (!targetISO) return { status: 'error', message: 'Invalid date format' };



    const attData = attSheet.getDataRange().getValues();

    const attHeaders = attData[0].map(h => String(h || '').trim());

    const regCol = attHeaders.indexOf("StudentRegistrationID");

    const dateCol = attHeaders.indexOf("Date");

    const statusCol = attHeaders.indexOf("Status");

    const inCol = attHeaders.indexOf("InTime");

    const outCol = attHeaders.indexOf("OutTime");

    const modeCol = attHeaders.indexOf("EntryMode");

    const remarksCol = attHeaders.indexOf("Remarks");

    const srcCol = attHeaders.indexOf("checkin_source");

    const appStatusCol = attHeaders.indexOf("ApprovalStatus");

    const tsCol = attHeaders.indexOf("Timestamp");

    const lateFlagCol = attHeaders.indexOf("late_flag");



    let foundRowIdx = -1;

    for (let i = 1; i < attData.length; i++) {

      const rowReg = String(attData[i][regCol] || '').trim().toUpperCase();

      const rowISO = toISODateStr(attData[i][dateCol]);

      if (rowReg === String(regId).trim().toUpperCase() && rowISO === targetISO) {

        foundRowIdx = i + 1;

        break;

      }

    }



    const cleanStatus = (status && String(status).toLowerCase().includes('diarycorrection')) ? 'Present' : (status || 'Present');

    const isAttended = cleanStatus.toLowerCase().includes('present') || cleanStatus.toLowerCase().includes('late') || cleanStatus.toLowerCase().includes('early') || cleanStatus.toLowerCase() === 'od' || cleanStatus.toLowerCase() === 'wfh';

    const cleanIn = (inTime && inTime !== '-' && inTime !== '--:--') ? inTime : (isAttended ? '09:30 AM' : '-');

    const cleanOut = (outTime && outTime !== '-' && outTime !== '--:--') ? outTime : (isAttended ? '05:30 PM' : '-');

    const cleanMode = mode || 'Admin Manual Edit';

    const cleanRemarks = remarks || 'Admin Day Adjustment';



    if (foundRowIdx !== -1) {

      if (statusCol !== -1) attSheet.getRange(foundRowIdx, statusCol + 1).setValue(cleanStatus);

      if (inCol !== -1) attSheet.getRange(foundRowIdx, inCol + 1).setValue(cleanIn);

      if (outCol !== -1) attSheet.getRange(foundRowIdx, outCol + 1).setValue(cleanOut);

      if (modeCol !== -1) attSheet.getRange(foundRowIdx, modeCol + 1).setValue(cleanMode);

      if (remarksCol !== -1) attSheet.getRange(foundRowIdx, remarksCol + 1).setValue(cleanRemarks);

      if (appStatusCol !== -1) attSheet.getRange(foundRowIdx, appStatusCol + 1).setValue('Approved');

      if (srcCol !== -1) attSheet.getRange(foundRowIdx, srcCol + 1).setValue('ADMIN_DAY_EDITOR');

      if (tsCol !== -1) attSheet.getRange(foundRowIdx, tsCol + 1).setValue(new Date());

      if (lateFlagCol !== -1) attSheet.getRange(foundRowIdx, lateFlagCol + 1).setValue(cleanStatus.toLowerCase().includes('late'));

    } else {

      const studentResp = getStudentFullData(regId);

      const studentName = (studentResp && studentResp.status === 'success' && studentResp.studentData) ? getStudentFullName_(studentResp.studentData) : 'Student';

      const workArea = (studentResp && studentResp.status === 'success' && studentResp.studentData) ? (studentResp.studentData.InterestedArea || 'General') : 'General';



      const newRow = attHeaders.map(h => {

        if (h === 'AttendanceID') return "ATT_" + Date.now();

        if (h === 'StudentRegistrationID') return regId;

        if (h === 'StudentName') return studentName;

        if (h === 'Date') return targetISO;

        if (h === 'Status') return cleanStatus;

        if (h === 'InTime') return cleanIn;

        if (h === 'OutTime') return cleanOut;

        if (h === 'EntryMode') return cleanMode;

        if (h === 'checkin_source') return 'ADMIN_DAY_EDITOR';

        if (h === 'ApprovalStatus') return 'Approved';

        if (h === 'late_flag') return cleanStatus.toLowerCase().includes('late');

        if (h === 'WorkArea') return workArea;

        if (h === 'Remarks') return cleanRemarks;

        if (h === 'Timestamp') return new Date();

        return '';

      });

      attSheet.appendRow(newRow);

    }



    SpreadsheetApp.flush();

    executionCache.clear();

    logActivity('Admin Attendance Edit', regId, `Updated day ${targetISO} to ${cleanStatus} (${cleanIn}-${cleanOut})`);



    return { status: 'success', message: `Attendance for ${formatDateDMY(targetISO)} updated successfully to ${cleanStatus}.` };

  } catch (err) {

    return { status: 'error', message: 'Error updating attendance record: ' + err.message };

  }

}



/**

 * Admin: Mass / Bulk Attendance Update for Multiple Selected Dates.

 */

function adminBulkUpdateAttendance(regId, dateArray, status, inTime, outTime, mode, remarks) {

  try {

    if (!regId) return { status: 'error', message: 'Registration ID required' };

    if (!Array.isArray(dateArray) || dateArray.length === 0) {

      return { status: 'error', message: 'No dates provided for bulk attendance update.' };

    }



    const attSheet = getSheet(SHEET_NAMES.ATTENDANCE);

    if (!attSheet) return { status: 'error', message: 'Attendance sheet unavailable' };



    const zone = Session.getScriptTimeZone() || 'Asia/Kolkata';

    const toISODateStr = (val) => {

      if (!val) return null;

      if (val instanceof Date) return Utilities.formatDate(val, zone, "yyyy-MM-dd");

      let s = String(val).trim();

      if (/^\d{4}-\d{2}-\d{2}/.test(s)) return s.substring(0, 10);

      if (/^\d{1,2}[\/\-\.]\d{1,2}[\/\-\.]\d{4}/.test(s)) {

        let p = s.split(/[\/\-\.]/);

        return p[2] + '-' + p[1].padStart(2, '0') + '-' + p[0].padStart(2, '0');

      }

      let d = new Date(val);

      if (!isNaN(d.getTime())) return Utilities.formatDate(d, zone, "yyyy-MM-dd");

      return null;

    };



    const targetDates = dateArray.map(d => toISODateStr(d)).filter(Boolean);

    if (targetDates.length === 0) {

      return { status: 'error', message: 'No valid dates parsed for bulk update.' };

    }

    const targetSet = new Set(targetDates);



    const attData = attSheet.getDataRange().getValues();

    const attHeaders = attData[0].map(h => String(h || '').trim());

    const regCol = attHeaders.indexOf("StudentRegistrationID");

    const dateCol = attHeaders.indexOf("Date");

    const statusCol = attHeaders.indexOf("Status");

    const inCol = attHeaders.indexOf("InTime");

    const outCol = attHeaders.indexOf("OutTime");

    const modeCol = attHeaders.indexOf("EntryMode");

    const remarksCol = attHeaders.indexOf("Remarks");

    const srcCol = attHeaders.indexOf("checkin_source");

    const appStatusCol = attHeaders.indexOf("ApprovalStatus");

    const tsCol = attHeaders.indexOf("Timestamp");

    const lateFlagCol = attHeaders.indexOf("late_flag");



    const cleanStatus = status || 'Present';

    const cleanIn = inTime || (cleanStatus === 'Present' ? '09:00 AM' : '-');

    const cleanOut = outTime || (cleanStatus === 'Present' ? '05:00 PM' : '-');

    const cleanMode = mode || 'Admin Bulk Edit';

    const cleanRemarks = remarks || `Bulk Marked as ${cleanStatus} by Admin`;



    const updatedDateSet = new Set();

    const upperReg = String(regId).trim().toUpperCase();



    // 1. Update existing rows in ATTENDANCE

    for (let i = 1; i < attData.length; i++) {

      const rowReg = String(attData[i][regCol] || '').trim().toUpperCase();

      const rowISO = toISODateStr(attData[i][dateCol]);

      if (rowReg === upperReg && targetSet.has(rowISO)) {

        const rowIdx = i + 1;

        if (statusCol !== -1) attSheet.getRange(rowIdx, statusCol + 1).setValue(cleanStatus);

        if (inCol !== -1) attSheet.getRange(rowIdx, inCol + 1).setValue(cleanIn);

        if (outCol !== -1) attSheet.getRange(rowIdx, outCol + 1).setValue(cleanOut);

        if (modeCol !== -1) attSheet.getRange(rowIdx, modeCol + 1).setValue(cleanMode);

        if (remarksCol !== -1) attSheet.getRange(rowIdx, remarksCol + 1).setValue(cleanRemarks);

        if (appStatusCol !== -1) attSheet.getRange(rowIdx, appStatusCol + 1).setValue('Approved');

        if (srcCol !== -1) attSheet.getRange(rowIdx, srcCol + 1).setValue('ADMIN_BULK_EDITOR');

        if (tsCol !== -1) attSheet.getRange(rowIdx, tsCol + 1).setValue(new Date());

        if (lateFlagCol !== -1) attSheet.getRange(rowIdx, lateFlagCol + 1).setValue(cleanStatus.toLowerCase().includes('late'));

        updatedDateSet.add(rowISO);

      }

    }



    // 2. Insert missing rows for any dates not already in the sheet

    const missingDates = targetDates.filter(d => !updatedDateSet.has(d));

    if (missingDates.length > 0) {

      let studentName = 'Student';

      let workArea = 'General';

      try {

        const studentResp = getStudentFullData(regId);

        if (studentResp && studentResp.status === 'success' && studentResp.studentData) {

          studentName = getStudentFullName_(studentResp.studentData) || 'Student';

          workArea = studentResp.studentData.InterestedArea || 'General';

        }

      } catch (snErr) {}



      const rowsToAppend = missingDates.map(mDate => {

        return attHeaders.map(h => {

          if (h === 'AttendanceID') return "ATT_" + Date.now() + "_" + Math.floor(Math.random() * 10000);

          if (h === 'StudentRegistrationID') return regId;

          if (h === 'StudentName') return studentName;

          if (h === 'Date') return mDate;

          if (h === 'Status') return cleanStatus;

          if (h === 'InTime') return cleanIn;

          if (h === 'OutTime') return cleanOut;

          if (h === 'WorkArea') return workArea;

          if (h === 'EntryMode') return cleanMode;

          if (h === 'Remarks') return cleanRemarks;

          if (h === 'ApprovalStatus') return 'Approved';

          if (h === 'checkin_source') return 'ADMIN_BULK_EDITOR';

          if (h === 'Timestamp') return new Date();

          if (h === 'late_flag') return cleanStatus.toLowerCase().includes('late');

          return '';

        });

      });



      if (rowsToAppend.length > 0) {

        const startRow = attSheet.getLastRow() + 1;

        attSheet.getRange(startRow, 1, rowsToAppend.length, attHeaders.length).setValues(rowsToAppend);

      }

    }



    SpreadsheetApp.flush();

    executionCache.clear();

    logActivity('Admin Bulk Attendance', regId, `Bulk marked ${targetDates.length} days as ${cleanStatus}`);



    return {

      status: 'success',

      message: `Successfully marked ${targetDates.length} day(s) as ${cleanStatus}!`,

      count: targetDates.length

    };

  } catch (e) {

    Logger.log('Error in adminBulkUpdateAttendance: ' + e.message);

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Admin: Mass / Bulk Diary Approval for a student's diary entries.

 */

function adminBulkApproveDiary(regId, dateArray) {

  try {

    if (!regId) return { status: 'error', message: 'Registration ID required' };

    const sheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    if (!sheet) return { status: 'error', message: 'StudentDiary sheet not found.' };



    const zone = Session.getScriptTimeZone() || 'Asia/Kolkata';

    const toISODateStr = (val) => {

      if (!val) return null;

      if (val instanceof Date) return Utilities.formatDate(val, zone, "yyyy-MM-dd");

      let s = String(val).trim();

      if (/^\d{4}-\d{2}-\d{2}/.test(s)) return s.substring(0, 10);

      if (/^\d{1,2}[\/\-\.]\d{1,2}[\/\-\.]\d{4}/.test(s)) {

        let p = s.split(/[\/\-\.]/);

        return p[2] + '-' + p[1].padStart(2, '0') + '-' + p[0].padStart(2, '0');

      }

      let d = new Date(val);

      if (!isNaN(d.getTime())) return Utilities.formatDate(d, zone, "yyyy-MM-dd");

      return null;

    };



    const targetDates = Array.isArray(dateArray) && dateArray.length > 0 ? dateArray.map(d => toISODateStr(d)).filter(Boolean) : null;

    const targetSet = targetDates ? new Set(targetDates) : null;



    const data = sheet.getDataRange().getValues();

    if (data.length < 2) return { status: 'success', message: 'No diary entries found to approve.', count: 0 };



    const headers = data[0].map(h => String(h || '').trim());

    const regCol = headers.indexOf("StudentRegistrationID");

    const dateCol = headers.indexOf("Date");

    const statusCol = headers.indexOf("Status");

    const upperReg = String(regId).trim().toUpperCase();



    let approvedCount = 0;

    for (let i = 1; i < data.length; i++) {

      const rowReg = String(data[i][regCol] || '').trim().toUpperCase();

      if (rowReg === upperReg) {

        const rowISO = toISODateStr(data[i][dateCol]);

        if (!targetSet || targetSet.has(rowISO)) {

          if (statusCol !== -1) {

            sheet.getRange(i + 1, statusCol + 1).setValue('Approved');

            approvedCount++;

          }

        }

      }

    }



    SpreadsheetApp.flush();

    executionCache.clear();

    logActivity('Admin Bulk Diary Approval', regId, `Approved ${approvedCount} diary entries.`);



    return {

      status: 'success',

      message: `Successfully approved ${approvedCount} diary entries!`,

      count: approvedCount

    };

  } catch (e) {

    Logger.log('Error in adminBulkApproveDiary: ' + e.message);

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Student: Submit Profile Photo Change Request to Admin (used when certificate has been issued).

 */

function submitStudentPhotoChangeRequest(regId, reason, base64Photo) {

  try {

    if (!regId) return { status: 'error', message: 'Missing Registration ID' };

    if (!base64Photo) return { status: 'error', message: 'Please select or crop a profile photo.' };

    const rId = String(regId).trim().toUpperCase();



    let studentName = 'Student';

    let studentDept = '';

    let regNum = '';

    let gmail = '';



    try {

      const studentResp = getStudentFullData(rId);

      const studentData = (studentResp && studentResp.studentData) || getStudentDataForDoc(rId) || {};

      studentName = getStudentFullName_(studentData) || studentData.FullName || studentData.Name || 'Student';

      studentDept = expandDepartmentFullName(studentData.Department || '');

      regNum = studentData.RegisterNumber || '';

      gmail = studentData.GmailID || studentData.Email || '';

    } catch (e) {}



    // 1. Upload proposed photo to student folder as a pending photo

    const contentType = base64Photo.substring(base64Photo.indexOf(":") + 1, base64Photo.indexOf(";"));

    const bytes = Utilities.base64Decode(base64Photo.split(",")[1]);

    const finalFileName = `${rId.replace(/\//g, '_')}_PendingPhoto_${Date.now()}.jpg`;

    const blob = Utilities.newBlob(bytes, contentType, finalFileName);



    const folder = getOrCreateStudentFolder(rId, 'mandatory') || DriveApp.getRootFolder();

    const file = folder.createFile(blob);

    try {

      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

    } catch(e) {}

    const fileUrl = file.getUrl();



    // 2. Append request to STUDENT_REQUESTS

    const reqSheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

    if (!reqSheet) return { status: 'error', message: 'Requests system temporarily unavailable.' };



    const newReq = {

      Timestamp: new Date(),

      RequestID: 'REQ-PHOTO-' + new Date().getTime().toString().slice(-6),

      RegistrationID: rId,

      StudentRegistrationID: rId,

      StudentName: studentName,

      Department: studentDept,

      RegisterNumber: regNum,

      RequestType: 'Profile Photo Change',

      Section: 'Profile',

      Reason: reason || 'Student requested profile photo change after certificate issuance.',

      Status: 'Pending',

      RequestDate: new Date(),

      AttachmentUrl: fileUrl,

      AdminRemarks: ''

    };



    appendObjectToSheet(reqSheet, newReq);

    logActivity('Photo Change Request', gmail || rId, 'Student submitted profile photo change request.');



    return {

      status: 'success',

      message: 'Profile photo change request submitted successfully to Admin! Once approved, your profile photo will be updated.'

    };

  } catch (err) {

    Logger.log("Error in submitStudentPhotoChangeRequest: " + err.toString());

    return { status: 'error', message: err.toString() };

  }

}



/**

 * Admin: Process Profile Photo Change Request (Approve / Reject).

 */

function processPhotoChangeApproval(requestId, action) {

  try {

    const reqSheet = getSheet(SHEET_NAMES.STUDENT_REQUESTS);

    if (!reqSheet) return { status: 'error', message: 'Requests sheet unavailable.' };



    const data = reqSheet.getDataRange().getValues();

    if (data.length < 2) return { status: 'error', message: 'No requests found.' };



    const headers = data[0].map(h => String(h || '').trim());

    const idCol = headers.indexOf('RequestID');

    const regCol = headers.indexOf('RegistrationID') !== -1 ? headers.indexOf('RegistrationID') : headers.indexOf('StudentRegistrationID');

    const nameCol = headers.indexOf('StudentName');

    const attachCol = headers.indexOf('AttachmentUrl');

    const statusCol = headers.indexOf('Status');

    const procCol = headers.indexOf('ProcessedDate');

    const remarkCol = headers.indexOf('AdminRemarks') !== -1 ? headers.indexOf('AdminRemarks') : headers.indexOf('AdminComment');



    let foundRow = -1;

    let targetRowData = null;

    for (let i = 1; i < data.length; i++) {

      if (String(data[i][idCol]) === String(requestId)) {

        foundRow = i + 1;

        targetRowData = data[i];

        break;

      }

    }



    if (foundRow === -1) {

      return { status: 'error', message: `Request ID ${requestId} not found.` };

    }



    const regId = String(targetRowData[regCol] || '').trim().toUpperCase();

    const studentName = targetRowData[nameCol] || 'Student';

    const photoUrl = targetRowData[attachCol] || '';



    if (action === 'Approve') {

      if (!photoUrl) {

        return { status: 'error', message: 'No photo attachment URL found for this request.' };

      }



      // Update ProfilePhotoUrl across all candidate student sheets: REGISTRATIONS, CONSOLIDATED_INTERNSHIPS, Closed and Opt-out, etc.

      const candidateSheetNames = [

        SHEET_NAMES.REGISTRATIONS,

        'Internship Registrations',

        'Registrations',

        SHEET_NAMES.CONSOLIDATED_INTERNSHIPS,

        'Consolidated Internships',

        'Consolidated_Internships',

        'Closed and Opt-out',

        'Closed & Opt-out',

        'Closed and Opt-Out',

        'Applications',

        SHEET_NAMES.CERTIFICATE_DATA,

        'Certificate Data'

      ];

      

      let updatedCount = 0;

      const seenSheets = new Set();

      

      candidateSheetNames.forEach(sheetName => {

        if (!sheetName || seenSheets.has(sheetName)) return;

        seenSheets.add(sheetName);

        const sh = getSheet(sheetName);

        if (!sh) return;

        try {

          const sData = sh.getDataRange().getValues();

          if (sData.length < 2) return;

          const sHeaders = sData[0].map(h => String(h || '').trim());

          

          // Fuzzy match registration column

          const sRegCol = sHeaders.findIndex(h => {

            const clean = h.toLowerCase().replace(/[^a-z0-9]/g, '');

            return ['registrationid', 'studentregistrationid', 'regid', 'regno', 'registerno', 'registernumber', 'studentregid'].includes(clean);

          });

          if (sRegCol === -1) return;



          // Fuzzy match photo column

          let photoCol = sHeaders.findIndex(h => {

            const clean = h.toLowerCase().replace(/[^a-z0-9]/g, '');

            return ['profilephotourl', 'photourl', 'profilephoto', 'photo', 'passportphoto', 'passportsizephoto', 'passportphotourl', 'studentphoto'].includes(clean);

          });



          // Check if student exists in this sheet

          let targetStudentRow = -1;

          for (let r = 1; r < sData.length; r++) {

            if (String(sData[r][sRegCol] || '').trim().toUpperCase() === regId) {

              targetStudentRow = r + 1;

              break;

            }

          }



          if (targetStudentRow !== -1) {

            // If photo column doesn't exist, create it in this sheet

            if (photoCol === -1) {

              photoCol = sHeaders.length;

              sh.getRange(1, photoCol + 1).setValue('ProfilePhotoUrl');

            }

            sh.getRange(targetStudentRow, photoCol + 1).setValue(photoUrl);

            updatedCount++;

          }

        } catch(e) {

          Logger.log(`Error updating photo in ${sheetName}: ` + e.toString());

        }

      });



      // Also sync to FILE_MANAGER sheet

      try {

        const fmSheet = getSheet(SHEET_NAMES.FILE_MANAGER);

        if (fmSheet) {

          let fileId = '';

          const match = photoUrl.match(/[-\w]{25,}/);

          if (match) fileId = match[0];

          if (!fileId) fileId = 'PHOTO_' + Date.now();

          fmSheet.appendRow([fileId, regId, `${regId.replace(/\//g, '_')}_ProfilePhoto.jpg`, photoUrl, 'Profile Photo', new Date(), '', 'Active']);

        }

      } catch(fmErr) {

        Logger.log('Error updating file manager on photo approval: ' + fmErr.toString());

      }



      // Update request status

      if (statusCol !== -1) reqSheet.getRange(foundRow, statusCol + 1).setValue('Approved');

      if (procCol !== -1) reqSheet.getRange(foundRow, procCol + 1).setValue(new Date());

      if (remarkCol !== -1) reqSheet.getRange(foundRow, remarkCol + 1).setValue('Approved by Admin');



      SpreadsheetApp.flush();

      executionCache.clear();



      createStudentNotification(regId, "Profile Photo Updated", "Your profile photo change request has been APPROVED by the Administrator. Your new photo is now active on your profile!");

      logActivity('Photo Change Approved', regId, `Request ${requestId} approved by Admin.`);



      return { status: 'success', message: `Profile photo for ${studentName} (${regId}) approved and updated successfully!` };

    } else {

      // Rejection

      if (statusCol !== -1) reqSheet.getRange(foundRow, statusCol + 1).setValue('Rejected');

      if (procCol !== -1) reqSheet.getRange(foundRow, procCol + 1).setValue(new Date());

      if (remarkCol !== -1) reqSheet.getRange(foundRow, remarkCol + 1).setValue('Rejected by Admin');



      SpreadsheetApp.flush();

      executionCache.clear();



      createStudentNotification(regId, "Profile Photo Request Rejected", "Your profile photo change request was rejected by Admin.");

      logActivity('Photo Change Rejected', regId, `Request ${requestId} rejected by Admin.`);



      return { status: 'success', message: `Profile photo request for ${studentName} (${regId}) rejected.` };

    }

  } catch (e) {

    Logger.log('Error in processPhotoChangeApproval: ' + e.toString());

    return { status: 'error', message: e.toString() };

  }

}



/**

 * Admin: Save comprehensive student master record directly from Dossier Edit Mode.

 */

function adminSaveDossierStudentMaster(profileData) {

  try {

    if (!profileData || !profileData.registrationId) {

      return { status: 'error', message: 'Registration ID is missing.' };

    }

    const res = updateStudentProfile(profileData);

    if (res && res.status === 'success') {

      executionCache.clear();

      return { status: 'success', message: 'Student profile updated successfully in master database.' };

    }

    return res || { status: 'error', message: 'Failed to update student profile.' };

  } catch (err) {

    return { status: 'error', message: 'Error saving profile: ' + err.message };

  }

}







/**

 * Admin API to save, edit, approve or reject a student's diary entry

 */

function saveAdminStudentDiaryEntry(regId, dateIso, content, hours, remarks, status) {

  var lock = null;

  try {

    const sheet = getSheet(SHEET_NAMES.STUDENT_DIARY);

    if (!sheet) return { status: 'error', message: 'StudentDiary sheet not found' };



    lock = LockService.getScriptLock();

    lock.waitLock(15000);



    const data = sheet.getDataRange().getValues();

    const headers = data[0];

    const regIdCol = headers.indexOf("StudentRegistrationID") !== -1 ? headers.indexOf("StudentRegistrationID") : headers.indexOf("RegistrationID");

    const dateCol = headers.indexOf("Date");

    const contentCol = headers.indexOf("Content");

    const statusCol = headers.indexOf("Status");

    const remarksCol = headers.indexOf("SupervisorRemarks") !== -1 ? headers.indexOf("SupervisorRemarks") : headers.indexOf("Remarks");

    const hoursCol = headers.indexOf("HoursSpent") !== -1 ? headers.indexOf("HoursSpent") : headers.indexOf("Hours");



    let targetDateStr = formatDateISO(dateIso);

    if (!targetDateStr && dateIso) {

      targetDateStr = String(dateIso).trim();

    }



    let foundRow = -1;



    for (let i = 1; i < data.length; i++) {

      const entryReg = String(data[i][regIdCol] || '').trim().toUpperCase();

      const rawEntryDate = data[i][dateCol];

      const entryDate = formatDateISO(rawEntryDate);

      if (entryReg === String(regId).trim().toUpperCase() && (entryDate === targetDateStr || String(rawEntryDate).trim() === targetDateStr)) {

        foundRow = i + 1;

        break;

      }

    }



    if (foundRow !== -1) {

      if (contentCol !== -1 && content !== undefined) sheet.getRange(foundRow, contentCol + 1).setValue(content);

      if (statusCol !== -1 && status !== undefined) sheet.getRange(foundRow, statusCol + 1).setValue(status);

      if (remarksCol !== -1 && remarks !== undefined) sheet.getRange(foundRow, remarksCol + 1).setValue(remarks);

      if (hoursCol !== -1 && hours !== undefined) sheet.getRange(foundRow, hoursCol + 1).setValue(hours);

    } else {

      // Append new row

      const newRow = new Array(headers.length).fill('');

      if (regIdCol !== -1) newRow[regIdCol] = regId;

      if (dateCol !== -1) newRow[dateCol] = targetDateStr;

      if (contentCol !== -1) newRow[contentCol] = content || '';

      if (statusCol !== -1) newRow[statusCol] = status || 'Approved';

      if (remarksCol !== -1) newRow[remarksCol] = remarks || '';

      if (hoursCol !== -1) newRow[hoursCol] = hours || 8;

      const timestampCol = headers.indexOf("Timestamp");

      if (timestampCol !== -1) newRow[timestampCol] = new Date();

      sheet.appendRow(newRow);

    }



    return { status: 'success', message: 'Diary entry updated successfully!' };

  } catch (e) {

    Logger.log("Error in saveAdminStudentDiaryEntry: " + e.toString());

    return { status: 'error', message: e.toString() };

  } finally {

    if (lock) {

      try { lock.releaseLock(); } catch(e) {}

    }

  }

}



function saveAdminDiaryEvaluation(regId, dateIso, content, hours, remarks, status) {

  return saveAdminStudentDiaryEntry(regId, dateIso, content, hours, remarks, status);

}



function debugDumpTemplateStructure(templateId) {

  try {

    const file = DriveApp.getFileById(templateId);

    const doc = DocumentApp.openById(templateId);

    const body = doc.getBody();

    const children = [];

    for (let i = 0; i < body.getNumChildren(); i++) {

      const el = body.getChild(i);

      const t = el.getType().toString();

      let text = '';

      try {

        if (typeof el.getText === 'function') text = el.getText();

      } catch(e) {}

      children.push({ type: t, text: text });

    }

    return { status: 'success', name: file.getName(), children: children };

  } catch(e) {

    return { status: 'error', message: e.toString() };

  }

}



function testPhotoDebug(regId) {

  try {

    const sData = getStudentDataForDoc(regId);

    let rawPhoto = sData ? (sData.ProfilePhotoUrl || sData.PhotoUrl || sData['Profile Photo'] || '') : '';

    let blobInfo = null;

    let templateTest = {};

    if (rawPhoto) {

      try {

        const b = getStudentPhotoBlob_(rawPhoto);

        blobInfo = b ? { contentType: b.getContentType(), size: b.getBytes().length } : 'blob is null';



        const templateId = '1CttkNmYwOGWIhXo61i_oquqxBEf7ZtXdBg7YeCza55E';

        templateTest.templateId = templateId;

        const templateFile = DriveApp.getFileById(templateId);

        const tempCopy = templateFile.makeCopy('DEBUG_TEST_' + regId);

        const doc = DocumentApp.openById(tempCopy.getId());

        const body = doc.getBody();



        try {

          formatCertificateTemplate2Photo_(body, b, true);

          templateTest.formatPhotoResult = 'success';

          templateTest.numTablesAfterPhoto = body.getTables().length;



          try {

            formatCertificateT2Footer_(body, true, 'Vijay Varman.S', '13/10/2026', null, null, null, regId, {});

            templateTest.formatFooterResult = 'success';

            templateTest.numTablesAfterFooter = body.getTables().length;

            templateTest.hasAuthSignatoryAfterFooter = (body.findText('Authorized Signatory') !== null);

          } catch(ftrErr) {

            templateTest.formatFooterError = ftrErr.toString();

          }



          templateTest.bodyText = body.getText();

        } catch(fmtErr) {

          templateTest.formatError = fmtErr.toString();

        }



        templateTest.lastT2PhotoDebug = (typeof __lastT2PhotoDebug !== 'undefined') ? __lastT2PhotoDebug : 'undefined';



        doc.saveAndClose();

        DriveApp.getFileById(tempCopy.getId()).setTrashed(true);

      } catch(errB) {

        blobInfo = 'err: ' + errB.toString();

      }

    }

    return {

      status: 'success',

      rawPhoto: rawPhoto,

      blobInfo: blobInfo,

      templateTest: templateTest

    };

  } catch(e) {

    return { status: 'error', message: e.toString() };

  }

}



